.env
**/.env
# WorkBuddy 项目数据（记忆、配置、skill 等，不入库）
.workbuddy/

# 忽略 Python Pickle 序列化文件 (LangGraph Checkpoints)
*.pckl
*.pkl

# 忽略 LangGraph 内部运行产生的临时 API 文件夹
.langgraph_api/

# 运行期产物目录（数据/报告/中间结果，统一由 agent 写入 tmp/）
tmp/

# 运行日志目录（multi-agent/log/，每轮运行的 supervisor/agent 关键事件，带时间戳）
log/

# Python 缓存 / 虚拟环境
__pycache__/
*.pyc
.venv/
