# 凭据（任何情况下不入库）
.env
**/.env

# 项目工具数据
.workbuddy/

# Python 缓存 / 虚拟环境
__pycache__/
*.pyc
.venv/
*.egg-info/

# LangGraph 序列化与内部运行目录
*.pckl
*.pkl
.langgraph_api/

# 运行产物：每次提交的 run 日志与中间文件
log/
tmp/

# Adaptive Runtime 实验产物（沙箱副本含 .env，绝不入库）
# experiments/

# 本地数据库（由运行过程生成）
memory/*.db-journal
memory/*.db-wal

# research_runtime 本地运行产物：每次实验都会改写，且报告内含机器绝对路径。
# 它们是可重建的运行时状态，不是可复现性证据；入库会造成噪音与路径泄漏。
# 若确需把某次实验作为证据固化：先脱敏绝对路径，再 git add -f 显式提交。
research_runtime/_data/

# ARR 1.0 per-run artifacts (machine-specific absolute paths, reproducible
# from the committed frozen datasets + the unified CLI). The frozen datasets
# under research_runtime/domains/projects/*/datasets/ ARE committed evidence.
experiments/arr_1_0*/
experiments/arr_0_2/
experiments/selftest/
experiments_arr_1_0_*.log

# ARR 1.0 PORTABLE EVIDENCE BUNDLES are committed (P0-3 fix): de-sensitised
# summaries + the canonical raw artifacts under raw/ so every artifact
# referenced by base_state.json is retrievable on GitHub. Force-include them.
!experiments/releases/
!experiments/releases/**
research_runtime/domains/projects/*/outputs/
research_runtime/domains/projects/*/reports/
arr_pytest.log
