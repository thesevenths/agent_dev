# 凭据（任何情况下不入库）
.env
**/.env

# 项目工具数据
.workbuddy/

# Python 缓存 / 虚拟环境
__pycache__/
*.pyc
.venv/
*.egg-info/

# LangGraph 序列化与内部运行目录
*.pckl
*.pkl
.langgraph_api/

# 运行产物：每次提交的 run 日志与中间文件
log/
tmp/

# Adaptive Runtime 实验产物（沙箱副本含 .env，绝不入库）
experiments/

# 本地数据库（由运行过程生成）
memory/*.db-journal
memory/*.db-wal
