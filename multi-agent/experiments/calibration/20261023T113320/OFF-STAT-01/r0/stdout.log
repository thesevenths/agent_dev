```python
import pandas as pd
df = pd.read_csv("offline_data/students.csv")
s = df["math_score"]
n = len(s)
mean = s.mean()
std = s.std(ddof=1)  # sample std
std_pop = s.std(ddof=0)
med = s.median()
q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
mn, mx = s.min(), s.max()
iqr = q3 - q1
lo = q1 - 1.5*iqr
hi = q3 + 1.5*iqr
out = s[(s < lo) | (s > hi)]
n_out = len(out)
ratio = n_out / n
print(n, mean, std, std_pop, med, q1, q3, mn, mx, iqr, lo, hi, n_out, ratio)
print(s.describe())
print("nulls:", s.isna().sum())
print("outliers:", out.tolist())
print("skew:", s.skew())

```
