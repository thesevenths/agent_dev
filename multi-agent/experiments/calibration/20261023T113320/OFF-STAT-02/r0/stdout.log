import pandas as pd, json

csv_path = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113320\OFF-STAT-02\r0\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113320\OFF-STAT-02\r0\_sandbox\tmp"
df = pd.read_csv(csv_path)

m, r = df['math_score'], df['reading_score']
n = len(df)

def stats(s):
    mean = s.mean()
    std_sample = s.std(ddof=1)
    std_pop = s.std(ddof=0)
    return dict(mean=float(mean), std_sample=float(std_sample), std_pop=float(std_pop),
                median=float(s.median()), cv_sample=float(std_sample/mean), cv_pop=float(std_pop/mean),
                min=int(s.min()), max=int(s.max()))

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": int(n),
    "n_math": int(m.notna().sum()),
    "n_reading": int(r.notna().sum()),
    "math_score": stats(m),
    "reading_score": stats(r),
    "pearson_r": float(m.corr(r)),
    "pearson_r_pop": float(m.corr(r, method='pearson')),
}
# which has larger dispersion by CV
res["larger_cv"] = "math_score" if res["math_score"]["cv_sample"] > res["reading_score"]["cv_sample"] else "reading_score"
res["cv_ratio"] = float(res["math_score"]["cv_sample"]/res["reading_score"]["cv_sample"])

with open(os.path.join(out_dir, "stats_results.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))

```
