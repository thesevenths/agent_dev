import pandas as pd, os

# locate the csv
cands = ["offline_data/students.csv", os.path.join("E:\\agent_dev\\multi-agent\\experiments\\calibration\\20261023T113948\\OFF-GRP-02\\r3\\_sandbox", "offline_data", "students.csv")]
path = None
for c in cands:
    if os.path.exists(c):
        path = c; break
print("using:", path)
df = pd.read_csv(path)
print(df.shape)
print(df['grade'].unique(), df['region'].unique())

grades = ['G10','G11','G12']
regions = ['A','B','C','D']
sub = df[df['grade'].isin(grades) & df['region'].isin(regions)]
print("rows in scope:", len(sub), "of", len(df))

g = sub.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean'])
g = g.reindex([(gr,rg) for gr in grades for rg in regions])
g = g.reset_index()
g['mean_reading_score'] = g['mean'].round(4)
out = g[['grade','region','count','mean_reading_score']]
print(out.to_string(index=False))

outdir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-GRP-02\r3\_sandbox\tmp"
os.makedirs(outdir, exist_ok=True)
outpath = os.path.join(outdir, "grade_region_crosstab.csv")
out.to_csv(outpath, index=False)
print("saved:", outpath)

hi = out.loc[out['mean_reading_score'].idxmax()]
lo = out.loc[out['mean_reading_score'].idxmin()]
print("max:", hi.tolist())
print("min:", lo.tolist())
print("overall mean:", round(sub['reading_score'].mean(),4), "n=", len(sub))
print("max-min gap:", round(hi['mean_reading_score']-lo['mean_reading_score'],4))
print("ratio:", round(hi['mean_reading_score']/lo['mean_reading_score'],4))

