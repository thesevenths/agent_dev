import pandas as pd, os

ct = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-GRP-02\r3\_sandbox\tmp\grade_region_crosstab.csv"
df = pd.read_csv(ct)
print(df)

hi = df.loc[df['mean_reading_score'].idxmax()]
lo = df.loc[df['mean_reading_score'].idxmin()]
gap = round(hi['mean_reading_score'] - lo['mean_reading_score'], 4)
ratio = round(hi['mean_reading_score'] / lo['mean_reading_score'], 4)
overall = round(df['mean_reading_score'].mul(df['count']).sum() / df['count'].sum(), 4)

rows = [
    {'metric': 'highest_mean_cell', 'grade': hi['grade'], 'region': hi['region'],
     'mean_reading_score': hi['mean_reading_score'], 'sample_size': int(hi['count'])},
    {'metric': 'lowest_mean_cell', 'grade': lo['grade'], 'region': lo['region'],
     'mean_reading_score': lo['mean_reading_score'], 'sample_size': int(lo['count'])},
    {'metric': 'mean_gap_high_minus_low', 'grade': f"{hi['grade']}x{hi['region']} vs {lo['grade']}x{lo['region']}",
     'region': '', 'mean_reading_score': gap, 'sample_size': ''},
    {'metric': 'mean_ratio_high_over_low', 'grade': f"{hi['grade']}x{hi['region']} / {lo['grade']}x{lo['region']}",
     'region': '', 'mean_reading_score': ratio, 'sample_size': ''},
    {'metric': 'overall_mean_all_cells', 'grade': 'ALL', 'region': 'ALL',
     'mean_reading_score': overall, 'sample_size': int(df['count'].sum())},
]
out = pd.DataFrame(rows)
outdir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-GRP-02\r3\_sandbox\tmp"
outpath = os.path.join(outdir, "extremes_summary.csv")
out.to_csv(outpath, index=False)
print(out.to_string(index=False))
print("saved:", outpath, os.path.getsize(outpath), "bytes")

