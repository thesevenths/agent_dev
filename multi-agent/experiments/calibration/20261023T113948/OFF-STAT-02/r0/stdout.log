import pandas as pd, json, os

df = pd.read_csv('offline_data/students.csv')
print(df.head())
print(df.shape)
print(df.dtypes)

out_dir = r'E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-STAT-02\r0\_sandbox\tmp'
os.makedirs(out_dir, exist_ok=True)

res = {}
for col in ['math_score', 'reading_score']:
    s = df[col].dropna()
    res[col] = {
        'n': int(s.count()),
        'mean': float(s.mean()),
        'std_sample': float(s.std(ddof=1)),
        'std_pop': float(s.std(ddof=0)),
        'median': float(s.median()),
        'min': float(s.min()),
        'max': float(s.max()),
    }
    res[col]['cv_sample'] = res[col]['std_sample'] / res[col]['mean']
    res[col]['cv_pop'] = res[col]['std_pop'] / res[col]['mean']

res['pearson_r'] = float(df['math_score'].corr(df['reading_score'], method='pearson'))
res['n_pairs'] = int(df[['math_score','reading_score']].dropna().shape[0])

with open(os.path.join(out_dir, 'stats_results.json'), 'w', encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))

```
