import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-STAT-02\r3\_sandbox"
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
print(df.head())
print(df.shape)
print(df.dtypes)
print("nulls:", df[['math_score','reading_score']].isna().sum().to_dict())

cols = ['math_score','reading_score']
stats = {}
for c in cols:
    s = df[c].dropna()
    stats[c] = {
        'n': int(s.count()),
        'mean': float(s.mean()),
        'std_sample': float(s.std(ddof=1)),
        'std_pop': float(s.std(ddof=0)),
        'median': float(s.median()),
        'min': float(s.min()),
        'max': float(s.max()),
        'cv_sample': float(s.std(ddof=1)/s.mean()),
        'cv_pop': float(s.std(ddof=0)/s.mean()),
    }
corr = float(df[cols].corr(method='pearson').iloc[0,1])
out = {'columns': stats, 'pearson_corr': corr, 'rows_total': int(len(df))}
print(json.dumps(out, indent=2, ensure_ascii=False))

outpath = os.path.join(base, "tmp", "step1_stats.json")
os.makedirs(os.path.dirname(outpath), exist_ok=True)
with open(outpath, 'w', encoding='utf-8') as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved:", outpath)

