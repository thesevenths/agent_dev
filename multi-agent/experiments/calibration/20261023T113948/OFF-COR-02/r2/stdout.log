import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-COR-02\r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
n = len(df)

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

out = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "method": "Pearson correlation (pandas .corr, default method='pearson')",
    "screen_vs_math": round(r_math, 6),
    "screen_vs_reading": round(r_read, 6),
    "as_of": "2026-10-23 11:46",
}
outp = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-COR-02\r2\_sandbox\tmp\step2_correlations.json"
with open(outp, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", outp)

