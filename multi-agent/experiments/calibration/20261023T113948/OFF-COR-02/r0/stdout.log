path = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-COR-02\r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
n = len(df)

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

# also p-values via scipy if available
try:
    from scipy import stats
    p_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"])[1]
    p_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"])[1]
except Exception as e:
    p_math = p_read = None
    print("scipy unavailable:", e)

out = {
    "as_of": "2026-10-23 11:46",
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "correlations": [
        {"pair": "screen_hours_per_day ~ math_score", "pearson_r": round(r_math, 6), "p_value": p_math, "n": n},
