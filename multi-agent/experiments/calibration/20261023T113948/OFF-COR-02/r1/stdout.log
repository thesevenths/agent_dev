```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-COR-02\r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

# duplicate check
print("duplicate student_id:", df['student_id'].duplicated().sum())

# group counts for >5 vs <=5
hi = df[df['screen_hours_per_day'] > 5]
lo = df[df['screen_hours_per_day'] <= 5]
print("n_hi:", len(hi), "n_lo:", len(lo))
print("hi math mean:", hi['math_score'].mean(), "lo math mean:", lo['math_score'].mean())
print("hi reading mean:", hi['reading_score'].mean(), "lo reading mean:", lo['reading_score'].mean())

# correlations
print("corr math:", df['screen_hours_per_day'].corr(df['math_score']))
print("corr reading:", df['screen_hours_per_day'].corr(df['reading_score']))
print("spearman math:", df['screen_hours_per_day'].corr(df['math_score'], method='spearman'))
print("spearman reading:", df['screen_hours_per_day'].corr(df['reading_score'], method='spearman'))

# exact group means for annotation
print("hi math mean exact:", round(hi['math_score'].mean(), 4))
print("lo math mean exact:", round(lo['math_score'].mean(), 4))
print("hi reading mean exact:", round(hi['reading_score'].mean(), 4))
print("lo reading mean exact:", round(lo['reading_score'].mean(), 4))
print("overall math mean:", df['math_score'].mean())
print("overall reading mean:", df['reading_score'].mean())
print("screen mean:", df['screen_hours_per_day'].mean())

```
