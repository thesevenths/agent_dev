```python
import pandas as pd, json

csv_path = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-STAT-01\r0\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-STAT-01\r0\_sandbox\tmp"

df = pd.read_csv(csv_path)
s = df['math_score']
n = len(s)
mean = s.mean()
std = s.std(ddof=1)  # sample std
median = s.median()
q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
mn, mx = s.min(), s.max()
iqr = q3 - q1
lo = q1 - 1.5*iqr
hi = q3 + 1.5*iqr
out_mask = (s < lo) | (s > hi)
out_low = int((s < lo).sum())
out_high = int((s > hi).sum())
out_n = int(out_mask.sum())
out_ratio = out_n / n

summary = pd.DataFrame({
    "metric": ["row_count","mean","std_sample_ddof1","median","q1","q3","min","max",
               "iqr","iqr_lower_bound","iqr_upper_bound","outlier_count","outlier_low","outlier_high","outlier_ratio"],
    "value": [n, mean, std, median, q1, q3, mn, mx, iqr, lo, hi, out_n, out_low, out_high, out_ratio],
})
out_csv = out_dir + r"\stats_summary.csv"
summary.to_csv(out_csv, index=False)
print(summary.to_string(index=False))
print("saved:", out_csv)
# outlier rows detail
print(df.loc[out_mask, ['student_id','grade','region','math_score']].to_string(index=False))

