```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-STAT-01\r1\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T113948\OFF-STAT-01\r1\_sandbox\tmp"

df = pd.read_csv(src)
s = df['math_score']
n = int(s.count())
mean = s.mean()
std = s.std(ddof=1)  # sample std
median = s.median()
q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
mn, mx = s.min(), s.max()
iqr = q3 - q1
lo = q1 - 1.5*iqr
hi = q3 + 1.5*iqr
out_low = int((s < lo).sum())
out_high = int((s > hi).sum())
out_total = out_low + out_high
ratio = out_total / n

rows = [
    ("sample_rows", n, "math_score 非空行数（样本量）"),
    ("mean", round(mean, 4), "算术平均"),
    ("std_sample", round(std, 4), "样本标准差 ddof=1"),
    ("median", median, "中位数 P50"),
    ("q1", q1, "P25（线性插值）"),
    ("q3", q3, "P75（线性插值）"),
    ("min", mn, "最小值"),
    ("max", mx, "最大值"),
    ("iqr", round(iqr, 4), "Q3 - Q1"),
    ("iqr_lower_fence", round(lo, 4), "Q1 - 1.5*IQR"),
    ("iqr_upper_fence", round(hi, 4), "Q3 + 1.5*IQR"),
    ("outliers_low", out_low, "math_score < 下界 的行数"),
    ("outliers_high", out_high, "math_score > 上界 的行数"),
    ("outliers_total", out_total, "低侧+高侧离群行数"),
    ("outlier_ratio", round(ratio, 6), "outliers_total / sample_rows"),
]
summary = pd.DataFrame(rows, columns=["metric", "value", "note"])
out_path = out_dir + r"\stats_summary.csv"
summary.to_csv(out_path, index=False, encoding="utf-8-sig")
print(summary.to_string(index=False))
print("saved:", out_path)

```
