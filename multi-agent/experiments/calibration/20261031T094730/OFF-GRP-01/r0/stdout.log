import pandas as pd, json, math

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-GRP-01\r0\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-GRP-01\r0\_sandbox\tmp"

df = pd.read_csv(path)
g = df.groupby("tutoring")["math_score"]
n0, n1 = int((df.tutoring==0).sum()), int((df.tutoring==1).sum())
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std()[0]), float(g.std()[1])  # sample std, ddof=1
diff = m1 - m0
pooled = math.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
d = diff / pooled

# t-test for reference
se = pooled * math.sqrt(1/n0 + 1/n1)
t = diff / se
from scipy import stats
p = 2 * stats.t.sf(abs(t), n0+n1-2)

res = {
  "source_file": "offline_data/students.csv",
  "rows_total": int(len(df)),
  "rows_used": int(len(df)),
  "missing_math_score": int(df.math_score.isna().sum()),
  "groups": {
    "0": {"n": n0, "mean": m0, "std": s0},
    "1": {"n": n1, "mean": m1, "std": s1},
  },
  "mean_diff_t1_minus_t0": diff,
  "pooled_std": pooled,
  "cohens_d": d,
  "t_stat": t,
  "p_value": p,
  "effect_size_label": "small" if abs(d)<0.5 else ("medium" if abs(d)<0.8 else "large"),
}
with open(out_dir + r"\group_stats.json", "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

# also a small CSV
pd.DataFrame([
    {"tutoring":0,"n":n0,"mean":m0,"std":s0},
    {"tutoring":1,"n":n1,"mean":m1,"std":s1},
    {"tutoring":"pooled","n":n0+n1,"mean":None,"std":pooled},
]).to_csv(out_dir + r"\group_stats.csv", index=False)

print(json.dumps(res, ensure_ascii=False, indent=2))

```
