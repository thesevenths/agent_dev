import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-GRP-01\r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

g = df.groupby('tutoring')['math_score'].agg(n='count', mean='mean', std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,'n']), int(g.loc[1,'n'])
m0, m1 = g.loc[0,'mean'], g.loc[1,'mean']
s0, s1 = g.loc[0,'std'], g.loc[1,'std']

mean_diff = m1 - m0
pooled_std = np.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
d = mean_diff / pooled_std

print(f"n0={n0} n1={n1}")
print(f"m0={m0:.6f} m1={m1:.6f}")
