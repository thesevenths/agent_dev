import pandas as pd, json, os

df = pd.read_csv('offline_data/students.csv')
out_dir = r'E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-GRP-03\r1\_sandbox\tmp'
os.makedirs(out_dir, exist_ok=True)

# check missing values
print(df[['study_hours_per_week','math_score']].isna().sum())

def grp(h):
    if h < 2.5: return 'low'
    elif h <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)
res = df.groupby('group').agg(
    n=('math_score','size'),
    mean_math=('math_score','mean'),
    std_math=('math_score','std'),
    min_h=('study_hours_per_week','min'),
    max_h=('study_hours_per_week','max'),
    mean_h=('study_hours_per_week','mean'),
).reindex(['low','mid','high'])
print(res)

gain = res.loc['high','mean_math'] - res.loc['low','mean_math']
print('gain', gain)

out = {
  'as_of': '2026-10-31 10:02',
  'source_file': 'offline_data/students.csv',
  'total_rows': int(len(df)),
  'rows_used': int(len(df.dropna(subset=['study_hours_per_week','math_score']))),
  'groups': {g: {k: (None if pd.isna(v) else (float(v) if isinstance(v,(int,float)) else v)) for k,v in row.items()} for g,row in res.iterrows()},
  'low_to_high_gain': float(gain),
  'gain_pct_of_low': float(gain / res.loc['low','mean_math'] * 100),
}
with open(os.path.join(out_dir,'group_stats.json'),'w',encoding='utf-8') as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
res.to_csv(os.path.join(out_dir,'group_stats.csv'))
print('saved')

```
