import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high (>5)", False: "low (<=5)"})

g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
)
print(g)

low = g.loc["low (<=5)"]; high = g.loc["high (>5)"]
out = {
    "source_file": "offline_data/students.csv",
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "n_total": len(df),
    "groups": {
        "low (<=5)": {
            "n": int(low["n"]),
            "mean_screen_hours_per_day": round(float(low["mean_screen"]), 4),
            "mean_math_score": round(float(low["mean_math"]), 4),
            "mean_reading_score": round(float(low["mean_reading"]), 4),
        },
        "high (>5)": {
            "n": int(high["n"]),
            "mean_screen_hours_per_day": round(float(high["mean_screen"]), 4),
            "mean_math_score": round(float(high["mean_math"]), 4),
            "mean_reading_score": round(float(high["mean_reading"]), 4),
        },
    },
    "mean_differences (high - low)": {
        "math_score": round(float(high["mean_math"] - low["mean_math"]), 4),
        "reading_score": round(float(high["mean_reading"] - low["mean_reading"]), 4),
    },
}
path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-COR-02\r3\_sandbox\tmp\step3_group_stats.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", os.path.abspath(path))

