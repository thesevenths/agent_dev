```python
import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day","math_score","reading_score"]
sub = df[cols]
n = len(sub)

r_math = sub["screen_hours_per_day"].corr(sub["math_score"], method="pearson")
r_read = sub["screen_hours_per_day"].corr(sub["reading_score"], method="pearson")

# p-values via scipy if available
try:
    from scipy import stats
    p_math = stats.pearsonr(sub["screen_hours_per_day"], sub["math_score"])[1]
    p_read = stats.pearsonr(sub["screen_hours_per_day"], sub["reading_score"])[1]
except Exception as e:
    p_math = p_read = None
    print("scipy unavailable:", e)

out = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "method": "Pearson correlation, all 400 rows, no missing values",
    "screen_hours_per_day_vs_math_score": {"r": round(r_math, 6), "p_value": p_math},
    "screen_hours_per_day_vs_reading_score": {"r": round(r_read, 6), "p_value": p_read},
}
path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-COR-02\r3\_sandbox\tmp\step2_correlations.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", os.path.abspath(path))

```
