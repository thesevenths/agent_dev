import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

# p-values via t-test
from scipy import stats
t_math = r_math * (n-2) / (1-r_math**2)**0.5
t_read = r_read * (n-2) / (1-r_read**2)**0.5
p_math = 2*stats.t.sf(abs(t_math), n-2)
p_read = 2*stats.t.sf(abs(t_read), n-2)

out = {
  "n": n,
  "pearson_screen_math": round(r_math, 6),
  "pearson_screen_reading": round(r_read, 6),
  "t_screen_math": round(t_math, 4),
  "t_screen_reading": round(t_read, 4),
  "p_screen_math": p_math,
  "p_screen_reading": p_read,
}
print(json.dumps(out, indent=2))

with open(r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-COR-02\r2\_sandbox\tmp\step2_correlations.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

