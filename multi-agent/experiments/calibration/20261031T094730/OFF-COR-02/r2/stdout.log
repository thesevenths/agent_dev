import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high(>5)", False: "low(<=5)"})

g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
    std_math=("math_score","std"),
    std_reading=("reading_score","std"),
)
print(g)

low = df[df["screen_hours_per_day"] <= 5]
high = df[df["screen_hours_per_day"] > 5]
diff_math = high["math_score"].mean() - low["math_score"].mean()
diff_read = high["reading_score"].mean() - low["reading_score"].mean()

out = {
  "threshold": 5.0,
  "groups": {
    "low(<=5)": {"n": int(len(low)), "mean_screen": round(low["screen_hours_per_day"].mean(),4),
                 "mean_math": round(low["math_score"].mean(),4), "mean_reading": round(low["reading_score"].mean(),4),
                 "std_math": round(low["math_score"].std(),4), "std_reading": round(low["reading_score"].std(),4)},
    "high(>5)": {"n": int(len(high)), "mean_screen": round(high["screen_hours_per_day"].mean(),4),
                 "mean_math": round(high["math_score"].mean(),4), "mean_reading": round(high["reading_score"].mean(),4),
                 "std_math": round(high["math_score"].std(),4), "std_reading": round(high["reading_score"].std(),4)},
  },
  "diff_high_minus_low": {
    "math": round(diff_math,4),
    "reading": round(diff_read,4),
  }
}
print(json.dumps(out, indent=2))
with open(r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-COR-02\r2\_sandbox\tmp\step3_group_stats.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

