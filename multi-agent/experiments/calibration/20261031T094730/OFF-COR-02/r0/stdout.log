import pandas as pd, json, math

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-COR-02\r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
res = []
for x, y in pairs:
    r = df[x].corr(df[y], method="pearson")
    # also compute p-value via t-statistic
    n = len(df)
    t = r * math.sqrt((n-2)/(1-r*r))
    # two-sided p-value using scipy if available
    try:
        from scipy import stats
        p = 2 * stats.t.sf(abs(t), df=n-2)
    except ImportError:
        p = None
    res.append({"x": x, "y": y, "pearson_r": round(float(r), 6), "n": int(n),
                "t_stat": round(float(t), 4), "p_value": (None if p is None else round(float(p), 8))})

print(json.dumps(res, indent=2))

out = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-COR-02\r0\_sandbox\tmp\step2_correlations.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump({"source_file": path, "n": int(len(df)), "correlations": res}, f, indent=2, ensure_ascii=False)
print("saved:", out)

