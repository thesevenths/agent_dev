```python
import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-COR-02\r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high(>5)", False: "low(<=5)"})
g = df.groupby("group").agg(
    n=("math_score", "size"),
    mean_screen=("screen_hours_per_day", "mean"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
    std_math=("math_score", "std"),
    std_reading=("reading_score", "std"),
)
g = g.reindex(["low(<=5)", "high(>5)"])
print(g.round(4))

low, high = g.loc["low(<=5)"], g.loc["high(>5)"]
diff = {
    "math_mean_diff_high_minus_low": round(float(high.mean_math - low.mean_math), 4),
    "reading_mean_diff_high_minus_low": round(float(high.mean_reading - low.mean_reading), 4),
    "screen_mean_diff_high_minus_low": round(float(high.mean_screen - low.mean_screen), 4),
}
print(json.dumps(diff, indent=2))

out = {
    "source_file": path,
    "split_rule": "high: screen_hours_per_day > 5; low: screen_hours_per_day <= 5",
    "total_n": int(len(df)),
    "groups": {
        "low(<=5)": {k: (None if pd.isna(v) else round(float(v), 4)) for k, v in low.items()},
        "high(>5)": {k: (None if pd.isna(v) else round(float(v), 4)) for k, v in high.items()},
    },
    "mean_diff_high_minus_low": diff,
}
outp = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-COR-02\r0\_sandbox\tmp\step3_group_stats.json"
with open(outp, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved:", outp)

```
