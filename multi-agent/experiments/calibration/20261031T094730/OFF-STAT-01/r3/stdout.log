```python
import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
print(df.shape)
print(df.dtypes)
print(df.head())
print("nulls:", df["math_score"].isna().sum())

s = df["math_score"].dropna()
q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
iqr = q3 - q1
lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
out = s[(s < lo) | (s > hi)]

res = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "total_rows": int(len(df)),
    "non_null_rows": int(len(s)),
    "null_rows": int(df["math_score"].isna().sum()),
    "mean": float(s.mean()),
    "std_sample": float(s.std(ddof=1)),
    "std_pop": float(s.std(ddof=0)),
    "median": float(s.median()),
    "q1": float(q1),
    "q3": float(q3),
    "iqr": float(iqr),
    "min": float(s.min()),
    "max": float(s.max()),
    "iqr_lower": float(lo),
    "iqr_upper": float(hi),
    "outlier_count": int(len(out)),
    "outlier_ratio": float(len(out)/len(s)),
    "outlier_values": out.tolist(),
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-01\r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
path = os.path.join(out_dir, "math_score_stats.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("saved:", path)

```
