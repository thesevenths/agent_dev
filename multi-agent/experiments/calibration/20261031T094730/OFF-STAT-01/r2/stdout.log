import pandas as pd, json, numpy as np

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-01\r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
print(df.head())
print(df.dtypes)
print("rows:", len(df))
print("nulls in math_score:", df['math_score'].isna().sum())

s = df['math_score'].dropna()
q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
iqr = q3 - q1
lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
out = s[(s < lo) | (s > hi)]

res = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "n_total_rows": int(len(df)),
    "n_valid": int(len(s)),
    "n_missing": int(df['math_score'].isna().sum()),
    "mean": float(s.mean()),
    "std_sample": float(s.std(ddof=1)),
    "std_pop": float(s.std(ddof=0)),
    "median": float(s.median()),
    "q1": float(q1),
    "q3": float(q3),
    "iqr": float(iqr),
    "min": float(s.min()),
    "max": float(s.max()),
    "iqr_lower_bound": float(lo),
    "iqr_upper_bound": float(hi),
    "n_outliers": int(len(out)),
    "outlier_ids": out.index.tolist(),
    "outlier_values": out.tolist(),
}
out_path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-01\r2\_sandbox\tmp\math_score_stats.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out_path)

