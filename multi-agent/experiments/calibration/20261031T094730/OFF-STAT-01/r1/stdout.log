import pandas as pd, json, os

csv_path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-01\r1\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-01\r1\_sandbox\tmp"

df = pd.read_csv(csv_path)
s = df['math_score'].dropna()
n = len(s)
q1, q3 = s.quantile(0.25), s.quantile(0.75)
iqr = q3 - q1
lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
out = df[(s < lo) | (s > hi)]

# 补充：分位数表（供报告表格用）
extra = {
    "p10": float(s.quantile(0.10)),
    "p90": float(s.quantile(0.90)),
    "skew": float(s.skew()),
    "outlier_rows": out.to_dict(orient="records"),
}
with open(os.path.join(out_dir, "math_score_stats.json"), "a", encoding="utf-8") as f:
    pass
stats = json.load(open(os.path.join(out_dir, "math_score_stats.json"), encoding="utf-8"))
stats.update(extra)
json.dump(stats, open(os.path.join(out_dir, "math_score_stats.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=2)
print(json.dumps(extra, ensure_ascii=False, indent=2))

