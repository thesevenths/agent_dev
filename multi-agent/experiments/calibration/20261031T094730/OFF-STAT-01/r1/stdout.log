import pandas as pd, json, os

csv_path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-01\r1\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-01\r1\_sandbox\tmp"

df = pd.read_csv(csv_path)
print(df.shape)
print(df.dtypes)
print(df.head())
print("nulls:", df['math_score'].isna().sum())

s = df['math_score'].dropna()
n = len(s)
mean = s.mean()
std = s.std(ddof=1)
median = s.median()
q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
iqr = q3 - q1
lo = q1 - 1.5*iqr
hi = q3 + 1.5*iqr
out_low = (s < lo).sum()
out_high = (s > hi).sum()
out_total = out_low + out_high

res = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "as_of": "2026-10-31 09:47",
    "n_rows_total": int(len(df)),
    "n_valid": int(n),
    "n_missing": int(df['math_score'].isna().sum()),
    "mean": float(mean),
    "std_sample": float(std),
    "std_population": float(s.std(ddof=0)),
    "median": float(median),
    "q1": float(q1),
    "q3": float(q3),
    "iqr": float(iqr),
    "min": float(s.min()),
    "max": float(s.max()),
    "iqr_lower_bound": float(lo),
    "iqr_upper_bound": float(hi),
    "outliers_low": int(out_low),
    "outliers_high": int(out_high),
    "outliers_total": int(out_total),
    "outlier_ratio": float(out_total / n),
}
with open(os.path.join(out_dir, "math_score_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

