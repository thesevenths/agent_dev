```python
import pandas as pd, json, os

csv_path = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-02\r3\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261031T094730\OFF-STAT-02\r3\_sandbox\tmp"

df = pd.read_csv(csv_path)
print(df.head())
print(df.dtypes)
print("rows:", len(df))
print("nulls:", df[['math_score','reading_score']].isna().sum().to_dict())

cols = ['math_score','reading_score']
res = {}
for c in cols:
    s = df[c].dropna()
    res[c] = {
        'n': int(s.count()),
        'mean': float(s.mean()),
        'std_sample': float(s.std(ddof=1)),
        'std_pop': float(s.std(ddof=0)),
        'median': float(s.median()),
        'min': float(s.min()),
        'max': float(s.max()),
    }
    res[c]['cv_sample'] = res[c]['std_sample']/res[c]['mean']
    res[c]['cv_pop'] = res[c]['std_pop']/res[c]['mean']

r = df[cols].corr(method='pearson').iloc[0,1]
res['pearson_r'] = float(r)
res['n_pairs'] = int(df[cols].dropna().shape[0])
res['source_file'] = 'offline_data/students.csv'

out_path = os.path.join(out_dir, 'stats_results.json')
with open(out_path,'w',encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out_path)

