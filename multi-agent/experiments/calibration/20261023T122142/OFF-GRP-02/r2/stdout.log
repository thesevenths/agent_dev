import pandas as pd

df = pd.read_csv("offline_data/students.csv")
print(df.shape)
print(df['grade'].unique(), df['region'].unique())
print(df['reading_score'].isna().sum())

g = df.groupby(['grade','region'])['reading_score'].agg(['count','mean'])
g = g.reindex([(gr, rg) for gr in ['G10','G11','G12'] for rg in ['A','B','C','D']])
print(g)
print("max:", g['mean'].idxmax(), g['mean'].max())
print("min:", g['mean'].idxmin(), g['mean'].min())
print("total rows:", len(df))
print("overall mean:", df['reading_score'].mean())
print("grade means:", df.groupby('grade')['reading_score'].mean())
print("region means:", df.groupby('region')['reading_score'].mean())

