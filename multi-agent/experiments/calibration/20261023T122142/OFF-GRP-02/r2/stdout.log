import pandas as pd

df = pd.read_csv("offline_data/students.csv")
g = df.groupby(['grade','region'])['reading_score'].agg(['count','mean'])
g = g.reindex([(gr, rg) for gr in ['G10','G11','G12'] for rg in ['A','B','C','D']])

max_cell = g['mean'].idxmax(); max_v = g.loc[max_cell,'mean']; max_n = int(g.loc[max_cell,'count'])
min_cell = g['mean'].idxmin(); min_v = g.loc[min_cell,'mean']; min_n = int(g.loc[min_cell,'count'])
diff = max_v - min_v
ratio = max_v / min_v

# grade / region marginal means
