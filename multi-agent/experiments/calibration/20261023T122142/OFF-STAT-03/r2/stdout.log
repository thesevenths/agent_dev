import pandas as pd

df = pd.read_csv('offline_data/students.csv')
print(len(df))
print(df['attendance_pct'].min(), df['attendance_pct'].max())
print(df['math_score'].isna().sum(), df['attendance_pct'].isna().sum())

# bins: [0,20), [20,40), ..., [80,100]
bins = list(range(0, 101, 20))
df['bin'] = pd.cut(df['attendance_pct'], bins=bins, right=True,
                   labels=['0-20','20-40','40-60','60-80','80-100'])
g = df.groupby('bin', observed=False).agg(
    row_count=('student_id','count'),
    mean_math=('math_score','mean'),
    min_att=('attendance_pct','min'),
    max_att=('attendance_pct','max')
)
print(g)
g.to_csv('E:/agent_dev/multi-agent/experiments/calibration/20261023T122142/OFF-STAT-03/r2/_sandbox/tmp/bin_stats.csv')
print('saved')

