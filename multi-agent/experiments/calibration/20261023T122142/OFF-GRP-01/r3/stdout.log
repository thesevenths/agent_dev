import pandas as pd, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-GRP-01\r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv("offline_data/students.csv")
print(df.shape, df["tutoring"].value_counts().to_dict(), df["math_score"].isna().sum())

g = df.groupby("tutoring")["math_score"].agg(n="count", mean="mean", std=lambda s: s.std(ddof=1))
n0, n1 = int(g.loc[0,"n"]), int(g.loc[1,"n"])
m0, m1 = g.loc[0,"mean"], g.loc[1,"mean"]
s0, s1 = g.loc[0,"std"], g.loc[1,"std"]
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled**0.5
diff = m1 - m0
d = diff / pooled_std
# also overall
overall = df["math_score"].agg(n="count", mean="mean", std=lambda s: s.std(ddof=1))

res = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "missing_math_score": int(df["math_score"].isna().sum()),
  "group_tutoring_0": {"n": n0, "mean": round(m0,4), "std_sample_ddof1": round(s0,4)},
  "group_tutoring_1": {"n": n1, "mean": round(m1,4), "std_sample_ddof1": round(s1,4)},
  "overall": {"n": int(overall["n"]), "mean": round(overall["mean"],4), "std_sample_ddof1": round(overall["std"],4)},
  "mean_diff_t1_minus_t0": round(diff,4),
  "pooled_variance": round(pooled,4),
  "pooled_std": round(pooled_std,4),
  "cohens_d": round(d,4),
  "effect_size_label": "small" if abs(d)<0.5 else ("medium" if abs(d)<0.8 else "large"),
  "notes": "std uses ddof=1 (sample std); pooled std = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); d = (mean1-mean0)/pooled_std; Cohen thresholds 0.2/0.5/0.8",
}
with open(os.path.join(out_dir, "group_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

