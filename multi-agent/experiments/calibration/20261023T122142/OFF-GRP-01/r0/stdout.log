import pandas as pd, json

src = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-GRP-01\r0\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-GRP-01\r0\_sandbox\tmp"

df = pd.read_csv(src)
g = df.groupby("tutoring")["math_score"]
n0, n1 = int((df.tutoring==0).sum()), int((df.tutoring==1).sum())
m0, m1 = df.loc[df.tutoring==0,"math_score"].mean(), df.loc[df.tutoring==1,"math_score"].mean()
s0, s1 = df.loc[df.tutoring==0,"math_score"].std(ddof=1), df.loc[df.tutoring==1,"math_score"].std(ddof=1)
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled**0.5
diff = m1 - m0
d = diff / pooled_std

res = {
  "source_file": "offline_data/students.csv",
  "n_total": int(len(df)),
  "n_tutoring_0": n0, "n_tutoring_1": n1,
  "mean_tutoring_0": m0, "mean_tutoring_1": m1,
  "std_tutoring_0": s0, "std_tutoring_1": s1,
  "pooled_variance": pooled, "pooled_std": pooled_std,
  "mean_diff_1_minus_0": diff,
  "cohens_d": d,
  "std_convention": "sample std (ddof=1)",
  "effect_size_rule": "Cohen 1988: |d|<0.2 small, 0.2-0.5 medium, 0.5-0.8 large, >0.8 very large",
}
with open(out_dir + r"\group_stats.json","w",encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

# also a small CSV
pd.DataFrame([
 {"group":"tutoring=0","n":n0,"mean":round(m0,4),"std":round(s0,4)},
 {"group":"tutoring=1","n":n1,"mean":round(m1,4),"std":round(s1,4)},
]).to_csv(out_dir + r"\group_stats.csv", index=False)

for k,v in res.items(): print(k, "=", v)

