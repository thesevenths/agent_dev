import pandas as pd, json

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-STAT-02\r1\_sandbox\offline_data\students.csv")
m, r = df['math_score'], df['reading_score']

def stats(s):
    return {
        "n": int(s.count()),
        "mean": float(s.mean()),
        "std_sample": float(s.std(ddof=1)),
        "std_pop": float(s.std(ddof=0)),
        "median": float(s.median()),
        "min": float(s.min()),
        "max": float(s.max()),
    }

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": int(len(df)),
    "n_missing_math": int(m.isna().sum()),
    "n_missing_reading": int(r.isna().sum()),
    "math_score": stats(m),
    "reading_score": stats(r),
    "pearson_r": float(m.corr(r, method='pearson')),
    "cv_math_sample": float(m.std(ddof=1)/m.mean()),
    "cv_reading_sample": float(r.std(ddof=1)/r.mean()),
    "cv_math_pop": float(m.std(ddof=0)/m.mean()),
    "cv_reading_pop": float(r.std(ddof=0)/r.mean()),
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-STAT-02\r1\_sandbox\tmp\stats_step1.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("saved:", out)

```
