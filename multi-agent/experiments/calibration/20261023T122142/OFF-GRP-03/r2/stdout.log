import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-GRP-03\r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

# boundary check: how many rows exactly at 2.5 or 4.5?
print("rows at 2.5:", (df['study_hours_per_week']==2.5).sum())
print("rows at 4.5:", (df['study_hours_per_week']==4.5).sum())

def grp(x):
    if x < 2.5: return 'low'
    elif x <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)
g = df.groupby('group').agg(n=('math_score','size'), mean_math=('math_score','mean'),
                            mean_hours=('study_hours_per_week','mean'),
                            min_h=('study_hours_per_week','min'), max_h=('study_hours_per_week','max'),
                            std_math=('math_score','std'))
print(g)
print("\ngain high-low:", g.loc['high','mean_math'] - g.loc['low','mean_math'])

```
