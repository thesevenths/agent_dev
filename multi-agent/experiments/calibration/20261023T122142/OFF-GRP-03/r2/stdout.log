import pandas as pd
import json

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-GRP-03\r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

def grp(x):
    if x < 2.5: return 'low'
    elif x <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)

stats = {}
for g in ['low','mid','high']:
    sub = df[df['group']==g]
    stats[g] = {
        'n': int(len(sub)),
        'mean_math': float(sub['math_score'].mean()),
        'std_math': float(sub['math_score'].std()),
        'min_math': int(sub['math_score'].min()),
        'max_math': int(sub['math_score'].max()),
        'mean_hours': float(sub['study_hours_per_week'].mean()),
        'min_hours': float(sub['study_hours_per_week'].min()),
        'max_hours': float(sub['study_hours_per_week'].max()),
    }

stats['gain_high_minus_low'] = stats['high']['mean_math'] - stats['low']['mean_math']
stats['gain_mid_minus_low'] = stats['mid']['mean_math'] - stats['low']['mean_math']
stats['gain_high_minus_mid'] = stats['high']['mean_math'] - stats['mid']['mean_math']
stats['total_n'] = int(len(df))

print(json.dumps(stats, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-GRP-03\r2\_sandbox\tmp\step2_group_stats.json"
with open(out, 'w', encoding='utf-8') as f:
    json.dump(stats, f, indent=2, ensure_ascii=False)
print("saved:", out)

