import pandas as pd, os, json

out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-GRP-03\r3\_sandbox\tmp"

df = pd.read_csv("offline_data/students.csv")

def grp(h):
    if h < 2.5: return "low"
    if h <= 4.5: return "mid"
    return "high"

df["group"] = df["study_hours_per_week"].apply(grp)

rows = []
for name in ["low","mid","high"]:
    sub = df[df["group"]==name]
    rows.append({
        "group": name,
        "n": int(len(sub)),
        "mean_math_score": round(float(sub["math_score"].mean()), 4),
        "std_math_score": round(float(sub["math_score"].std()), 4),
        "min_math_score": int(sub["math_score"].min()),
        "max_math_score": int(sub["math_score"].max()),
        "mean_study_hours": round(float(sub["study_hours_per_week"].mean()), 4),
        "min_study_hours": float(sub["study_hours_per_week"].min()),
        "max_study_hours": float(sub["study_hours_per_week"].max()),
    })

low = next(r for r in rows if r["group"]=="low")
high = next(r for r in rows if r["group"]=="high")
mid = next(r for r in rows if r["group"]=="mid")

result = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "grouping_rule": "low: study_hours_per_week < 2.5; mid: 2.5 <= study_hours_per_week <= 4.5; high: study_hours_per_week > 4.5",
    "groups": rows,
    "gain_low_to_high": round(high["mean_math_score"] - low["mean_math_score"], 4),
    "gain_low_to_mid": round(mid["mean_math_score"] - low["mean_math_score"], 4),
    "gain_mid_to_high": round(high["mean_math_score"] - mid["mean_math_score"], 4),
    "overall_mean_math_score": round(float(df["math_score"].mean()), 4),
}

out = os.path.join(out_dir, "step2_group_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print("saved:", out)
print(json.dumps(result, ensure_ascii=False, indent=2))

