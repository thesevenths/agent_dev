```python
import pandas as pd, os, json

out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-GRP-03\r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv("offline_data/students.csv")

def grp(h):
    if h < 2.5: return "low"
    if h <= 4.5: return "mid"
    return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(n=("math_score","size"),
                            mean_math=("math_score","mean"),
                            std_math=("math_score","std"),
                            min_h=("study_hours_per_week","min"),
                            max_h=("study_hours_per_week","max"))
print(g)

summary = {
  "file": "offline_data/students.csv",
  "rows": int(len(df)),
  "cols": list(df.columns),
  "missing": {k:int(v) for k,v in df.isna().sum().items()},
  "study_hours_per_week": {"dtype":"float64","min":0.6,"max":7.0,"mean":3.66725},
  "math_score": {"dtype":"int64","min":47,"max":100,"mean":77.2075},
  "groups": {k: {"n":int(r.n), "mean_math":round(r.mean_math,4), "std_math":round(r.std_math,4),
                 "h_min":float(r.min_h), "h_max":float(r.max_h)}
             for k,r in g.iterrows()},
  "gain_low_to_high": round(g.loc["high","mean_math"] - g.loc["low","mean_math"], 4),
}
out = os.path.join(out_dir, "step1_validation.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("saved:", out)
print(json.dumps(summary, ensure_ascii=False, indent=2))

