import pandas as pd, numpy as np, json, os

p = "offline_data/students.csv"
df = pd.read_csv(p)
out_dir = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-COR-02\r1\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

def grp(g):
    return {
        "n": int(len(g)),
        "screen_mean": float(g["screen_hours_per_day"].mean()),
        "math_mean": float(g["math_score"].mean()),
        "reading_mean": float(g["reading_score"].mean()),
    }

res = {
    "source_file": p,
    "n_total": n,
    "correlations": {
        "screen_vs_math": float(r_math),
        "screen_vs_reading": float(r_read),
        "method": "Pearson (pandas .corr, default)",
        "n": n,
    },
    "groups": {
        "screen_gt_5": grp(hi),
        "screen_le_5": grp(lo),
    },
    "mean_diffs": {
        "math_gt5_minus_le5": float(hi["math_score"].mean() - lo["math_score"].mean()),
        "reading_gt5_minus_le5": float(hi["reading_score"].mean() - lo["reading_score"].mean()),
        "screen_mean_gt5_minus_le5": float(hi["screen_hours_per_day"].mean() - lo["screen_hours_per_day"].mean()),
    },
}
path = os.path.join(out_dir, "step2_stats.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(path)
print(json.dumps(res, ensure_ascii=False, indent=2))

