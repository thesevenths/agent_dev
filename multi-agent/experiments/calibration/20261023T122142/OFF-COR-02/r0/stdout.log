import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-COR-02\r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

# duplicate check
print("duplicate student_id:", df['student_id'].duplicated().sum())

# correlations
print("corr screen~math:", df['screen_hours_per_day'].corr(df['math_score']))
print("corr screen~reading:", df['screen_hours_per_day'].corr(df['reading_score']))

# groups
hi = df[df['screen_hours_per_day'] > 5]
lo = df[df['screen_hours_per_day'] <= 5]
print("hi n:", len(hi), "lo n:", len(lo))
print("hi math mean:", hi['math_score'].mean(), "lo math mean:", lo['math_score'].mean())
print("hi reading mean:", hi['reading_score'].mean(), "lo reading mean:", lo['reading_score'].mean())
print("diff math (hi-lo):", hi['math_score'].mean() - lo['math_score'].mean())
print("diff reading (hi-lo):", hi['reading_score'].mean() - lo['reading_score'].mean())
print("hi screen mean:", hi['screen_hours_per_day'].mean(), "lo screen mean:", lo['screen_hours_per_day'].mean())

```
