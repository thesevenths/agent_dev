```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\multi-agent\experiments"  # placeholder, fix below
base = r"E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-STAT-01\r0\_sandbox"
tmp = os.path.join(base, "tmp")
os.makedirs(tmp, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
s = df["math_score"]

q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
iqr = q3 - q1
lo = q1 - 1.5 * iqr
hi = q3 + 1.5 * iqr
out_mask = (s < lo) | (s > hi)
n_out = int(out_mask.sum())

res = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "n_rows": int(len(df)),
    "n_missing": int(s.isna().sum()),
    "n_valid": int(s.notna().sum()),
    "mean": float(s.mean()),
    "std_sample": float(s.std(ddof=1)),
    "std_pop": float(s.std(ddof=0)),
    "median": float(s.median()),
    "q1": float(q1),
    "q3": float(q3),
    "iqr": float(iqr),
    "min": float(s.min()),
    "max": float(s.max()),
    "iqr_lower_fence": float(lo),
    "iqr_upper_fence": float(hi),
    "n_outliers": n_out,
    "outlier_pct": float(n_out / len(df) * 100),
    "outlier_rows": df.loc[out_mask, ["student_id", "math_score"]].to_dict(orient="records"),
    "as_of": "2026-10-23 12:21",
}
out_path = os.path.join(tmp, "math_score_stats.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out_path)

```
