with open(IN_PATH, "r", encoding="utf-8") as f:
    stats = json.load(f)

q1, q3, iqr, n_rows = stats["q1"], stats["q3"], stats["iqr"], stats["n_rows"]
lower_fence = q1 - 1.5 * iqr
upper_fence = q3 + 1.5 * iqr
n_outliers = stats["n_outliers"]
outlier_ratio = n_outliers / n_rows

res = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "n_rows": n_rows,
    "q1": q1,
    "q3": q3,
    "iqr": iqr,
