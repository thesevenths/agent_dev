```python
import pandas as pd, json

df = pd.read_csv('offline_data/students.csv')
s = df['math_score']
n = int(s.count())
mean = float(s.mean())
std = float(s.std(ddof=1))
median = float(s.median())
q1 = float(s.quantile(0.25))
q3 = float(s.quantile(0.75))
mn = int(s.min())
mx = int(s.max())
iqr = q3 - q1
lo = q1 - 1.5*iqr
hi = q3 + 1.5*iqr
out_mask = (s < lo) | (s > hi)
out_low = int((s < lo).sum())
out_high = int((s > hi).sum())
out_n = int(out_mask.sum())
out_ratio = out_n / n

out = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "as_of": "2026-10-23 12:22",
    "n": n,
    "mean": mean,
    "std_ddof1": std,
    "median": median,
    "q1": q1,
    "q3": q3,
    "min": mn,
    "max": mx,
    "iqr": iqr,
    "iqr_lower_fence": lo,
    "iqr_upper_fence": hi,
    "outliers_low": out_low,
    "outliers_high": out_high,
    "outliers_total": out_n,
    "outlier_ratio": out_ratio,
}
with open(r'E:\agent_dev\multi-agent\experiments\calibration\20261023T122142\OFF-STAT-01\r1\_sandbox\tmp\math_score_stats.json','w',encoding='utf-8') as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print(json.dumps(out, indent=2))
# also list outlier rows for reference
print(df.loc[out_mask, ['student_id','math_score']].to_string())

