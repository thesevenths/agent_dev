import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step3_nov_dec_multiplier.csv"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]
df['m'] = df['month'].str[5:7].astype(int)

rows = []
for y in ['2024', '2025']:
    d = df[df['year'] == y]
    nd = d[d['m'].isin([11, 12])]
    ot = d[~d['m'].isin([11, 12])]
    nd_tot, ot_tot = int(nd['units'].sum()), int(ot['units'].sum())
    nd_avg = nd_tot / 2
    ot_avg = ot_tot / 10
    rows.append({
        'year': y,
        'period': 'Nov-Dec' if False else 'Nov-Dec vs Jan-Oct',
        'nov_dec_units_total': nd_tot,
        'nov_dec_months': 2,
        'nov_dec_avg_monthly_units': round(nd_avg, 2),
        'jan_oct_units_total': ot_tot,
        'jan_oct_months': 10,
        'jan_oct_avg_monthly_units': round(ot_avg, 2),
        'amplification_multiplier': round(nd_avg / ot_avg, 4),
        'nov_dec_sample_rows': int(len(nd)),
        'jan_oct_sample_rows': int(len(ot)),
    })

res = pd.DataFrame(rows)
res.to_csv(out, index=False)
print(res.to_string(index=False))

# cross-check vs step2 file
s2 = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step2_nov_dec_amplification.csv")
print("\ncross-check vs step2:")
print(s2.to_string(index=False))
print("match:",
      all(res['nov_dec_units_total'] == s2['nov_dec_units_total']) and
      all(res['jan_oct_units_total'] == s2['other_months_units_total']) and
      all(abs(res['amplification_multiplier'] - s2['amplification_ratio']) < 1e-4))

