```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

print("unique months:", df['month'].nunique(), sorted(df['month'].unique())[:3], "...", sorted(df['month'].unique())[-3:])
print("regions:", sorted(df['region'].unique()))
print("product_lines:", sorted(df['product_line'].unique()))

# consistency checks
print("revenue == units*unit_price (max abs diff):", (df['revenue'] - df['units']*df['unit_price']).abs().max())
print("rows per month:", df.groupby('month').size().unique())

# quick aggregates for downstream
df['year'] = df['month'].str[:4]
print("\nAnnual revenue:\n", df.groupby('year')['revenue'].sum())
print("\nAnnual units:\n", df.groupby('year')['units'].sum())

# Nov-Dec vs other months amplification (units)
df['m'] = df['month'].str[5:7].astype(int)
for y in ['2024','2025']:
    d = df[df['year']==y]
    nd = d[d['m'].isin([11,12])]['units'].sum()
    ot = d[~d['m'].isin([11,12])]['units'].sum()
    nd_avg = nd/2
    ot_avg = ot/10
    print(y, "Nov-Dec total units:", nd, "other total:", ot, "monthly avg ND:", nd_avg, "monthly avg other:", ot_avg, "ratio:", nd_avg/ot_avg)

```
