src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]
df['m'] = df['month'].str[5:7].astype(int)

# Monthly revenue table
monthly = (df.groupby(['year', 'month'])
             .agg(revenue=('revenue', 'sum'), units=('units', 'sum'), rows=('revenue', 'size'))
             .reset_index())

# Annual totals
annual = (df.groupby('year')
             .agg(revenue=('revenue', 'sum'), units=('units', 'sum'), rows=('revenue', 'size'))
             .reset_index())
annual['yoy_growth_pct'] = annual['revenue'].pct_change() * 100

# Nov-Dec amplification (units)
amp_rows = []
for y in sorted(df['year'].unique()):
    d = df[df['year'] == y]
    nd = d[d['m'].isin([11, 12])]
    ot = d[~d['m'].isin([11, 12])]
    nd_total = nd['units'].sum(); ot_total = ot['units'].sum()
    nd_avg = nd_total / 2; ot_avg = ot_total / 10
    amp_rows.append({
        'year': y,
        'nov_dec_units_total': nd_total,
        'other_months_units_total': ot_total,
        'nov_dec_monthly_avg_units': nd_avg,
        'other_months_monthly_avg_units': ot_avg,
        'amplification_ratio': nd_avg / ot_avg,
        'nov_dec_rows': len(nd),
        'other_months_rows': len(ot),
    })
amp = pd.DataFrame(amp_rows)

# Save intermediate CSVs
monthly.to_csv(f"{out_dir}\\step2_monthly_revenue.csv", index=False, float_format='%.2f')
annual.to_csv(f"{out_dir}\\step2_annual_revenue_yoy.csv", index=False, float_format='%.4f')
amp.to_csv(f"{out_dir}\\step2_nov_dec_amplification.csv", index=False, float_format='%.6f')

print("=== monthly (first/last) ===")
print(monthly.head(3).to_string(index=False))
print(monthly.tail(3).to_string(index=False))
print("\n=== annual ===")
print(annual.to_string(index=False))
print("\n=== amplification ===")
print(amp.to_string(index=False))

# verify vs step1 pre-aggregates
print("\ncheck 2024 rev:", annual.loc[annual.year=='2024','revenue'].iloc[0], "2025 rev:", annual.loc[annual.year=='2025','revenue'].iloc[0])

```
