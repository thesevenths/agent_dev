import pandas as pd

df = pd.read_csv("offline_data/students.csv")

g = df.groupby(["grade", "region"], observed=True).agg(
    row_count=("reading_score", "size"),
    mean_reading_score=("reading_score", "mean"),
).reset_index()

# round for display but keep full precision in CSV
g["mean_reading_score"] = g["mean_reading_score"].round(4)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-GRP-02-r2\_sandbox\tmp\step2_crosstab.csv"
g.to_csv(out, index=False)
print(g.to_string(index=False))

max_row = g.loc[g["mean_reading_score"].idxmax()]
min_row = g.loc[g["mean_reading_score"].idxmin()]
print("\nMAX:", max_row.to_dict())
print("MIN:", min_row.to_dict())
print("diff:", max_row["mean_reading_score"] - min_row["mean_reading_score"])
print("saved:", out)

```
