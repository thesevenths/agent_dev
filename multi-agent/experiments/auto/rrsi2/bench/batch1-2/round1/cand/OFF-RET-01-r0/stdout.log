import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

result = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": list(df["week"].iloc[:30]), "mean": float(first.mean()), "std": float(first.std(ddof=1)), "n": 30},
    "last30": {"weeks": list(df["week"].iloc[30:]), "mean": float(last.mean()), "std": float(last.std(ddof=1)), "n": 30},
    "difference": {"mean_diff_last_minus_first": float(last.mean()-first.mean()), "std_diff_last_minus_first": float(last.std(ddof=1)-first.std(ddof=1))},
    "overall": {"mean": float(overall_mean), "std": float(overall_std), "threshold_mean_minus_2std": float(threshold),
                "n_below_threshold": int(len(below)), "weeks_below_threshold": list(below.index.map(lambda i: df["week"].iloc[i])),
                "values_below_threshold": {df["week"].iloc[i]: float(v) for i, v in below.items()}},
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-01-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out = os.path.join(out_dir, "retention_d7_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("SAVED:", out)

```
