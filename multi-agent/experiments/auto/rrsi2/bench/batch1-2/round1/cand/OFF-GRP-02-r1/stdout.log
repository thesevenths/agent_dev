```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-GRP-02-r1\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-GRP-02-r1\_sandbox\tmp\offline_data\grade_region_cross.csv"

df = pd.read_csv(src)
g = df.groupby(["grade","region"], observed=True).agg(
    row_count=("reading_score","size"),
    mean_reading_score=("reading_score","mean")
).reset_index()
g = g.set_index(["grade","region"]).reindex(
    pd.MultiIndex.from_product([["G10","G11","G12"],["A","B","C","D"]])
).reset_index()
g["mean_reading_score"] = g["mean_reading_score"].round(4)

# tie-break: larger sample size, then lexicographic (grade, region)
hi = g.sort_values(["mean_reading_score","row_count"], ascending=[False,False]).sort_index(kind="stable")
# do it properly:
hi = g.sort_values(["mean_reading_score","row_count"], ascending=[False,False]).iloc[0]
lo = g.sort_values(["mean_reading_score","row_count"], ascending=[True,False]).iloc[0]
print(g.to_string(index=False))
print("HI:", hi.tolist())
print("LO:", lo.tolist())
print("total rows:", len(df))

import os
os.makedirs(os.path.dirname(out), exist_ok=True)
g.to_csv(out, index=False)
print("saved:", out)

```
