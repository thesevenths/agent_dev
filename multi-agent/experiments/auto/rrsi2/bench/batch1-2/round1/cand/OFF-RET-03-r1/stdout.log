            "weeks": eq['week'].tolist(),
        },
    },
    "derived": {
        "arpu_ratio_high_over_low": float(high['arpu_usd'].mean() / low['arpu_usd'].mean()),
        "arpu_diff_high_minus_low": float(high['arpu_usd'].mean() - low['arpu_usd'].mean()),
        "cohort_share_high": float(high['cohort_size'].sum() / df['cohort_size'].sum()),
    },
}

out = os.path.join(tmp, "step2_results.json")
with open(out, "w", encoding="utf-8") as f:
