import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-03-r0\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

# sanity checks
print("week range:", df['week'].min(), "->", df['week'].max(), "unique:", df['week'].nunique())
print("retention_d7 range:", df['retention_d7'].min(), df['retention_d7'].max())
print("churn_rate range:", df['churn_rate'].min(), df['churn_rate'].max())
print("arpu_usd range:", df['arpu_usd'].min(), df['arpu_usd'].max())
print("cohort_size range:", df['cohort_size'].min(), df['cohort_size'].max())
print("dau <= cohort_size all:", (df['dau'] <= df['cohort_size']).all())
print("retention in [0,1]:", df['retention_d7'].between(0,1).all())
print("churn in [0,1]:", df['churn_rate'].between(0,1).all())
print("arpu > 0:", (df['arpu_usd'] > 0).all())
print("cohort_size > 0:", (df['cohort_size'] > 0).all())

# correlations
print("\ncorr retention_d7 vs arpu_usd (pearson):", df['retention_d7'].corr(df['arpu_usd']))
print("corr retention_d7 vs arpu_usd (spearman):", df['retention_d7'].corr(df['arpu_usd'], method='spearman'))
print("corr retention_d7 vs churn_rate (pearson):", df['retention_d7'].corr(df['churn_rate']))
print("corr retention_d7 vs churn_rate (spearman):", df['retention_d7'].corr(df['churn_rate'], method='spearman'))

# median split
med = df['retention_d7'].median()
print("\nmedian retention_d7:", med)
hi = df[df['retention_d7'] > med]
lo = df[df['retention_d7'] <= med]
print("hi rows:", len(hi), "lo rows:", len(lo))
print("hi arpu mean:", hi['arpu_usd'].mean(), "hi cohort sum:", hi['cohort_size'].sum())
print("lo arpu mean:", lo['arpu_usd'].mean(), "lo cohort sum:", lo['cohort_size'].sum())
print("hi retention mean:", hi['retention_d7'].mean(), "lo retention mean:", lo['retention_d7'].mean())
print("hi churn mean:", hi['churn_rate'].mean(), "lo churn mean:", lo['churn_rate'].mean())

# save cleaned copy
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-03-r0\_sandbox\tmp\app_metrics_clean.csv"
df.to_csv(out, index=False)
print("\nsaved clean copy to:", out)

