import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-TRD-03-r1\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

# Per-region totals (72 rows each)
reg = df.groupby('region')['revenue'].agg(['sum','count']).reset_index()
reg.columns = ['region','total_revenue','n_rows']

# Monthly revenue per region (3 rows per region-month)
rm = df.groupby(['region','month'])['revenue'].sum().reset_index()

# Peak month per region
peak = rm.loc[rm.groupby('region')['revenue'].idxmax()][['region','month','revenue']]
peak.columns = ['region','peak_month','peak_month_revenue']

out = reg.merge(peak, on='region')
out['revenue_share_pct'] = out['total_revenue'] / out['total_revenue'].sum() * 100
out['monthly_avg_revenue'] = out['total_revenue'] / 24  # 24 months per region
out['n_months'] = 24

# Overall totals for annotation
total_all = df['revenue'].sum()
print("Grand total:", total_all)
print(out.to_string(index=False))

# Top region
top = out.loc[out['total_revenue'].idxmax()]
print("\nTop region:", top['region'], "peak month:", top['peak_month'], top['peak_month_revenue'])

# Save intermediate results
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-TRD-03-r1\_sandbox\tmp"
out.to_csv(f"{outdir}\\step2_regional_aggregates.csv", index=False)
rm.to_csv(f"{outdir}\\step2_region_month_revenue.csv", index=False)
print("\nSaved.")

