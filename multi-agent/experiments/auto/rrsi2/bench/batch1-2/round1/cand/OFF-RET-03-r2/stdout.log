import pandas as pd, json
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-03-r2\_sandbox\tmp"
df = pd.read_csv(p)

# validation
assert df.shape == (60, 7)
assert df.isna().sum().sum() == 0
assert df.duplicated().sum() == 0
assert (df["cohort_size"] > 0).all() and (df["dau"] > 0).all()
assert df["retention_d7"].between(0,1).all() and df["churn_rate"].between(0,1).all()
assert (df["arpu_usd"] > 0).all()
# cleaned copy (identical, validated)
df.to_csv(out + r"\app_metrics_clean.csv", index=False)

# key stats for downstream
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]
stats = {
  "n_rows": len(df),
  "corr_ret_arpu": df["retention_d7"].corr(df["arpu_usd"]),
  "corr_ret_churn": df["retention_d7"].corr(df["churn_rate"]),
  "median_retention_d7": med,
  "hi_n": len(hi), "hi_arpu_mean": hi["arpu_usd"].mean(), "hi_cohort_sum": int(hi["cohort_size"].sum()),
  "lo_n": len(lo), "lo_arpu_mean": lo["arpu_usd"].mean(), "lo_cohort_sum": int(lo["cohort_size"].sum()),
  "arpu_mean_all": df["arpu_usd"].mean(),
  "retention_mean_all": df["retention_d7"].mean(),
  "churn_mean_all": df["churn_rate"].mean(),
  "cohort_sum_all": int(df["cohort_size"].sum()),
  "week_range": [df["week"].min(), df["week"].max()],
}
with open(out + r"\step1_stats.json", "w") as f:
    json.dump(stats, f, indent=2)
print(json.dumps(stats, indent=2))
print("saved:", out + r"\app_metrics_clean.csv")

