import pandas as pd

df = pd.read_csv("offline_data/students.csv")
ct = (df.groupby(["grade", "region"])
          .agg(n=("reading_score", "size"), mean_reading=("reading_score", "mean"))
          .reset_index())
ct["mean_reading"] = ct["mean_reading"].round(6)

imax = ct["mean_reading"].idxmax()
imin = ct["mean_reading"].idxmin()
print(ct.to_string(index=False))
print("max:", ct.loc[imax].to_dict())
