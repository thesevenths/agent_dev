import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-01-r2\_sandbox\offline_data\app_metrics.csv"
out  = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-01-r2\_sandbox\tmp\step2_stats.csv"

df = pd.read_csv(path)
r = df["retention_d7"]

first30 = r.iloc[:30]
last30  = r.iloc[30:]

overall_mean = r.mean()
overall_std  = r.std(ddof=1)
threshold    = overall_mean - 2 * overall_std
below = df[r < threshold]

stats = pd.DataFrame({
    "metric": [
        "first30_mean", "first30_std", "last30_mean", "last30_std",
        "diff_mean_last_minus_first", "diff_std_last_minus_first",
        "overall_mean", "overall_std", "threshold_mean_minus_2std",
        "weeks_below_threshold", "weeks_below_threshold_pct",
    ],
    "value": [
        first30.mean(), first30.std(ddof=1),
        last30.mean(), last30.std(ddof=1),
        last30.mean() - first30.mean(),
        last30.std(ddof=1) - first30.std(ddof=1),
        overall_mean, overall_std, threshold,
        len(below), len(below) / 60,
    ],
    "n": [30, 30, 30, 30, None, None, 60, 60, None, len(below), 60],
})
stats.to_csv(out, index=False)
print(stats.to_string(index=False))
print("\nweeks below threshold:")
print(below[["week", "retention_d7"]].to_string(index=False))
print("\nsaved:", out)

