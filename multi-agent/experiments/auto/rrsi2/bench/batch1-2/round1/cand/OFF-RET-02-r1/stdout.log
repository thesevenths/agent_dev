```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
sub["group"] = sub.week.apply(lambda w: "W30-W36" if w <= "W36" else "W37-W43")

# Per-week series with week-over-week deltas
per_week = sub[["week", "group"] + metrics].copy()
for m in metrics:
    per_week[f"{m}_wow_delta"] = per_week[m].diff()

# Group means
means = sub.groupby("group")[metrics].mean().reset_index()
means.columns = ["group"] + [f"mean_{c}" for c in metrics]

# Difference (after - before)
before = means[means.group == "W30-W36"].iloc[0]
after  = means[means.group == "W37-W43"].iloc[0]
diff_rows = []
for m in metrics:
    b, a = before[f"mean_{m}"], after[f"mean_{m}"]
    diff_rows.append({
        "metric": m,
        "mean_W30_W36": round(b, 6),
        "mean_W37_W43": round(a, 6),
        "abs_diff_after_minus_before": round(a - b, 6),
        "pct_change": round((a - b) / b * 100, 4),
        "n_before": 7, "n_after": 7,
    })
diff = pd.DataFrame(diff_rows)

print("=== Group means (raw) ===")
print(means.to_string(index=False))
print("\n=== Diffs ===")
print(diff.to_string(index=False))
print("\n=== Per-week ===")
print(per_week.to_string(index=False))

# Save intermediate CSVs
per_week.to_csv(f"{out_dir}\\step2_per_week_W30_W43.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
diff.to_csv(f"{out_dir}\\step2_group_diffs.csv", index=False)
print("\nSaved 3 CSVs to", out_dir)

```
