```python

import pandas as pd

df = pd.read_csv("offline_data/students.csv")
print(len(df), df.isna().sum().sum())

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group")["math_score"].agg(n="count", mean="mean", std="std", min="min", max="max")
print(g)

low = df[df.group=="low"]["math_score"].mean()
high = df[df.group=="high"]["math_score"].mean()
print("gain:", high-low, "ratio:", high/low)

out = g.reset_index()
out["math_score_mean"] = out["mean"].round(4)
out = out[["group","n","math_score_mean","std","min","max"]]
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-GRP-03-r1\_sandbox\tmp\group_stats.csv"
out.to_csv(out_path, index=False)
print(out)
print("saved:", out_path)

