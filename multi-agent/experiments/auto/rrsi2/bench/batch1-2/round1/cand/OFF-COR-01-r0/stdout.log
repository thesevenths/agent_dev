import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-COR-01-r0\_sandbox\offline_data\students.csv")
cols = ["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day"]
res = []
for c in cols:
    r, p = stats.pearsonr(df[c], df["math_score"])
    res.append((c, r, abs(r), p))
res.sort(key=lambda x: -x[2])
for x in res:
    print(x)
print(df[cols+["math_score"]].describe())
n = len(df)
print("n =", n)

```
