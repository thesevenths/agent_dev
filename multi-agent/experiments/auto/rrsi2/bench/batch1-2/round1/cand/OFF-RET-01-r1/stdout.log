import pandas as pd, json, os

df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
first30 = r.iloc[:30]
last30 = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

res = {
    "n_total": int(len(r)),
    "first30": {"weeks": [df['week'].iloc[0], df['week'].iloc[29]], "mean": float(first30.mean()), "std": float(first30.std(ddof=1)), "n": int(len(first30))},
    "last30": {"weeks": [df['week'].iloc[30], df['week'].iloc[59]], "mean": float(last30.mean()), "std": float(last30.std(ddof=1)), "n": int(len(last30))},
    "diff_mean": float(first30.mean() - last30.mean()),
    "overall_mean": float(overall_mean),
    "overall_std": float(overall_std),
    "threshold": float(threshold),
    "weeks_below_threshold": [df['week'].iloc[i] for i in below.index],
    "count_below": int(len(below)),
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-01-r1\_sandbox\tmp"
os.makedirs(out, exist_ok=True)
with open(os.path.join(out, "retention_d7_stats.json"), "w") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print(json.dumps(res, indent=2))

