for _, r in sub.iterrows():
    d = "" if prev is None else f"{r['retention_d7']-prev:+.4f}"
    lines.append(f"| {r['week']} | {r['retention_d7']} | {r['churn_rate']} | {r['arpu_usd']} | {d} |")
    prev = r['retention_d7']
