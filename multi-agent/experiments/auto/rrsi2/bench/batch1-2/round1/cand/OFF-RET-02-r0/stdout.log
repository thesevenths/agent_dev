import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
tmp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\cand\OFF-RET-02-r0\_sandbox\tmp"

df = pd.read_csv(src)
sub = df[df['week'].between('W30','W43')].copy().reset_index(drop=True)

metrics = ['retention_d7','churn_rate','arpu_usd']

# per-week table with segment labels and week-over-week deltas
sub['segment'] = sub['week'].apply(lambda w: 'W30-W36' if w <= 'W36' else 'W37-W43')
for m in metrics:
    sub[f'wow_delta_{m}'] = sub[m].diff()

# group means
pre = sub[sub['segment']=='W30-W36']
post = sub[sub['segment']=='W37-W43']
means = pd.DataFrame({
    'segment': ['W30-W36','W37-W43'],
    'n_rows': [len(pre), len(post)],
    'retention_d7_mean': [pre['retention_d7'].mean(), post['retention_d7'].mean()],
    'churn_rate_mean': [pre['churn_rate'].mean(), post['churn_rate'].mean()],
    'arpu_usd_mean': [pre['arpu_usd'].mean(), post['arpu_usd'].mean()],
})
means['delta_retention_d7'] = means['retention_d7_mean'].iloc[1]-means['retention_d7_mean'].iloc[0]
means['delta_churn_rate'] = means['churn_rate_mean'].iloc[1]-means['churn_rate_mean'].iloc[0]
means['delta_arpu_usd'] = means['arpu_usd_mean'].iloc[1]-means['arpu_usd_mean'].iloc[0]
means['pct_change_retention_d7'] = means['delta_retention_d7']/means['retention_d7_mean'].iloc[0]
means['pct_change_churn_rate'] = means['delta_churn_rate']/means['churn_rate_mean'].iloc[0]
means['pct_change_arpu_usd'] = means['delta_arpu_usd']/means['arpu_usd_mean'].iloc[0]

# breakpoint detection: largest single-week drop in retention_d7 within W30-W43
sub['ret_drop'] = sub['retention_d7'].diff()
bp_row = sub.loc[sub['ret_drop'].idxmin()]
breakpoint = {
    'breakpoint_week': bp_row['week'],
    'prev_week': sub.loc[bp_row.name-1,'week'],
    'retention_d7_prev': sub.loc[bp_row.name-1,'retention_d7'],
    'retention_d7_bp': bp_row['retention_d7'],
    'retention_d7_drop': bp_row['ret_drop'],
    'churn_rate_prev': sub.loc[bp_row.name-1,'churn_rate'],
    'churn_rate_bp': bp_row['churn_rate'],
    'churn_rate_jump': bp_row['churn_rate']-sub.loc[bp_row.name-1,'churn_rate'],
    'arpu_usd_prev': sub.loc[bp_row.name-1,'arpu_usd'],
    'arpu_usd_bp': bp_row['arpu_usd'],
    'arpu_usd_change': bp_row['arpu_usd']-sub.loc[bp_row.name-1,'arpu_usd'],
}

# save intermediate CSVs
perweek = sub[['week','segment','retention_d7','churn_rate','arpu_usd',
               'wow_delta_retention_d7','wow_delta_churn_rate','wow_delta_arpu_usd']]
perweek_path = rf"{tmp}\step2_perweek_W30_W43.csv"
perweek.to_csv(perweek_path, index=False, encoding='utf-8-sig')

means_path = rf"{tmp}\step2_group_means.csv"
means.to_csv(means_path, index=False, encoding='utf-8-sig')

bp = pd.DataFrame([breakpoint])
bp_path = rf"{tmp}\step2_breakpoint.csv"
bp.to_csv(bp_path, index=False, encoding='utf-8-sig')

print(perweek.to_string(index=False))
print()
print(means.to_string(index=False))
print()
print(bp.to_string(index=False))
print("\nsaved:", perweek_path, means_path, bp_path)

