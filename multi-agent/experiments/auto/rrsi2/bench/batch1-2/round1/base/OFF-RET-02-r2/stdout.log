import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-RET-02-r2\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
cols = ["retention_d7","churn_rate","arpu_usd"]

w30_36 = df[df.week.between("W30","W36")]
w37_43 = df[df.week.between("W37","W43")]
m1, m2 = w30_36[cols].mean(), w37_43[cols].mean()

print("W30-36 means:", m1.to_dict())
print("W37-43 means:", m2.to_dict())
print("diffs:", (m2-m1).to_dict())
print("rel %:", ((m2-m1)/m1*100).round(2).to_dict())

# per-week deltas W30-W43
sub = df[df.week.between("W30","W43")].copy()
sub["d_ret"] = sub.retention_d7.diff()
sub["d_churn"] = sub.churn_rate.diff()
sub["d_arpu"] = sub.arpu_usd.diff()
print(sub[["week","retention_d7","churn_rate","arpu_usd","d_ret","d_churn","d_arpu"]].to_string(index=False))

# W36->W37 deltas
w36, w37 = df[df.week=="W36"].iloc[0], df[df.week=="W37"].iloc[0]
print("\nW36->W37:", (w37[cols]-w36[cols]).to_dict())

# max single-week |delta| in W31-W43
print("\nmax |d_ret|:", sub.d_ret.abs().max(), "at", sub.loc[sub.d_ret.abs().idxmax(),"week"])
print("max |d_churn|:", sub.d_churn.abs().max(), "at", sub.loc[sub.d_churn.abs().idxmax(),"week"])
print("max |d_arpu|:", sub.d_arpu.abs().max(), "at", sub.loc[sub.d_arpu.abs().idxmax(),"week"])

# post-W37 persistence: W38-W43 vs W30-36 means
w38_43 = df[df.week.between("W38","W43")]
print("\nW38-43 means:", w38_43[cols].mean().round(6).to_dict())

