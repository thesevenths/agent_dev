import pandas as pd
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-GRP-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(p)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean'])
g = g.reindex(pd.MultiIndex.from_product([['G10','G11','G12'],['A','B','C','D']]))

def f(x): return f"{x:.2f}"

rows = []
for (gr, rg), r in g.iterrows():
    rows.append(f"| {gr} | {rg} | {int(r['count'])} | {f(r['mean'])} |")
table = "\n".join(rows)

# grade means
gm = df.groupby('grade')['reading_score'].agg(['count','mean'])
rm = df.groupby('region')['reading_score'].agg(['count','mean'])
print(gm); print(rm)

max_cell = g['mean'].idxmax(); min_cell = g['mean'].idxmin()
maxv, minv = g.loc[max_cell,'mean'], g.loc[min_cell,'mean']
maxn, minn = int(g.loc[max_cell,'count']), int(g.loc[min_cell,'count'])
diff = maxv - minv
ratio = maxv / minv
overall = df['reading_score'].mean()

report = f"""# 学生阅读成绩（reading_score）年级 × 地区交叉分析报告

- 报告生成时间：2026-10-23 15:39（本地时间）
