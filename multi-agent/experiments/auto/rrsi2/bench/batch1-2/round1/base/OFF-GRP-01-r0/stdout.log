import pandas as pd, json, math

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-GRP-01-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

g = df.groupby("tutoring")["math_score"].agg(n="count", mean="mean", std="std")  # std = sample std (ddof=1)
g0, g1 = g.loc[0], g.loc[1]
n0, n1 = int(g0["n"]), int(g1["n"])
m0, m1 = g0["mean"], g1["mean"]
s0, s1 = g0["std"], g1["std"]

mean_diff = m1 - m0
pooled_std = math.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
d = mean_diff / pooled_std

# Cohen's d thresholds
if abs(d) < 0.2: cls = "可忽略 (negligible, |d|<0.2)"
elif abs(d) < 0.5: cls = "小 (small, 0.2<=|d|<0.5)"
elif abs(d) < 0.8: cls = "中 (medium, 0.5<=|d|<0.8)"
else: cls = "大 (large, |d|>=0.8)"

