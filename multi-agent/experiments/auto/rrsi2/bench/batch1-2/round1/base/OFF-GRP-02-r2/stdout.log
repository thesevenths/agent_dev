import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-GRP-02-r2\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-GRP-02-r2\_sandbox\tmp\step2_crosstab_stats.csv"

df = pd.read_csv(src)
g = df.groupby(["grade","region"], observed=True)["reading_score"].agg(
    n="count", mean="mean"
).reset_index()
g["mean"] = g["mean"].round(4)
g = g.sort_values(["grade","region"]).reset_index(drop=True)
g.to_csv(out, index=False)
print(g.to_string(index=False))
print("total rows:", g["n"].sum())
mx = g.loc[g["mean"].idxmax()]
mn = g.loc[g["mean"].idxmin()]
print("MAX:", mx.to_dict())
print("MIN:", mn.to_dict())
print("diff:", round(mx["mean"]-mn["mean"],4))

```
