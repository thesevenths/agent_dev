```python
import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
print(df.shape)
print(df['month'].nunique(), df['region'].unique())

# per region
g = df.groupby('region')['revenue'].agg(['sum','count'])
total = df['revenue'].sum()
g['share'] = g['sum']/total*100
g['monthly_avg'] = g['sum']/df['month'].nunique()
print(g)
print('grand total', total)

# monthly per region
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
print(piv)

# peak month for top region
top = g['sum'].idxmax()
peak_month, peak_val = piv[top].idxmax(), piv[top].max()
print('top region', top, 'peak month', peak_month, peak_val)

# save intermediate results
out = g.reset_index()
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-TRD-03-r0\_sandbox\tmp\region_summary.csv', index=False)
piv.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-TRD-03-r0\_sandbox\tmp\region_monthly.csv')
print('saved')

```
