```python
import pandas as pd
import numpy as np

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(src)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# --- per-week table W30-W43 with group labels and week-over-week deltas ---
sub = df[df['week'].between('W30', 'W43')].copy()
sub['group'] = np.where(sub['week'].between('W30', 'W36'), 'W30-W36', 'W37-W43')
for c in metrics:
    sub[f'{c}_wow_delta'] = sub[c].diff()

# --- group means ---
means = sub.groupby('group')[metrics].mean()
n_rows = sub.groupby('group')['week'].count()
print(means)
print(n_rows)

# --- differences (W37-43 minus W30-36) ---
diff = means.loc['W37-W43'] - means.loc['W30-W36']
rel = diff / means.loc['W30-W36']
print(diff)
print(rel)

# --- breakpoint detection: largest |WoW delta| per metric within W30-W43 ---
bp = {}
for c in metrics:
    d = sub.set_index('week')[f'{c}_wow_delta']
    # direction-aware: for retention/arpu the "break" is the biggest drop; for churn the biggest jump
    if c == 'churn_rate':
        idx = d.idxmax()
    else:
        idx = d.idxmin()
    bp[c] = (idx, d[idx])
    print(c, "steepest WoW change at", idx, d[idx])

# --- mean shift per week: how much of the total window shift occurs at W36->W37 ---
# total shift = mean(W37-43) - mean(W30-36); single-week contribution = (value_W37 - value_W36)
for c in metrics:
    total = diff[c]
    single = sub.loc[sub['week']=='W37', c].iloc[0] - sub.loc[sub['week']=='W36', c].iloc[0]
    print(c, "total shift:", round(total,6), "W36->W37 single-week:", round(single,6), "share:", round(single/total,4))

# --- save intermediate CSVs ---
perweek_path = f"{out_dir}\\step2_perweek_breakpoint.csv"
sub.to_csv(perweek_path, index=False, encoding='utf-8-sig')

# summary csv
summary = pd.DataFrame({
    'metric': metrics,
    'mean_W30_W36': [means.loc['W30-W36', c] for c in metrics],
    'mean_W37_W43': [means.loc['W37-W43', c] for c in metrics],
    'diff_W37W43_minus_W30W36': [diff[c] for c in metrics],
    'rel_change_pct': [rel[c]*100 for c in metrics],
    'steepest_wow_week': [bp[c][0] for c in metrics],
    'steepest_wow_delta': [bp[c][1] for c in metrics],
})
summary_path = f"{out_dir}\\step2_group_means_summary.csv"
summary.to_csv(summary_path, index=False, encoding='utf-8-sig')

print("\nperweek:\n", sub.to_string(index=False))
print("\nsummary:\n", summary.to_string(index=False))
print("\nsaved:", perweek_path, summary_path)

```
