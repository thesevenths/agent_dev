import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
n = len(df)

r_math = df.screen_hours_per_day.corr(df.math_score)
r_read = df.screen_hours_per_day.corr(df.reading_score)

hi = df[df.screen_hours_per_day > 5]
lo = df[df.screen_hours_per_day <= 5]

res = {
  "n_total": n,
  "pearson_screen_math": r_math,
  "pearson_screen_reading": r_read,
  "group_hi": {
    "n": len(hi),
    "mean_math": hi.math_score.mean(),
    "mean_reading": hi.reading_score.mean(),
    "mean_screen": hi.screen_hours_per_day.mean(),
  },
  "group_lo": {
    "n": len(lo),
    "mean_math": lo.math_score.mean(),
    "mean_reading": lo.reading_score.mean(),
    "mean_screen": lo.screen_hours_per_day.mean(),
  },
}
res["diff_math_hi_minus_lo"] = res["group_hi"]["mean_math"] - res["group_lo"]["mean_math"]
res["diff_reading_hi_minus_lo"] = res["group_hi"]["mean_reading"] - res["group_lo"]["mean_reading"]

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round1\base\OFF-COR-02-r2\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, indent=2))

```
