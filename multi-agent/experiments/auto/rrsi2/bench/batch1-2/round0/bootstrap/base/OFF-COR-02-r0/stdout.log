import pandas as pd, json, os

path = "offline_data/students.csv"
df = pd.read_csv(path)
n = len(df)

corr_math = df["screen_hours_per_day"].corr(df["math_score"])
corr_read = df["screen_hours_per_day"].corr(df["reading_score"])

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

res = {
    "as_of": "2026-10-23 14:11",
    "source_file": "offline_data/students.csv",
    "n_total": n,
    "correlations": {
        "screen_hours_per_day_vs_math_score": round(corr_math, 6),
        "screen_hours_per_day_vs_reading_score": round(corr_read, 6),
        "method": "Pearson",
        "n_used": n,
    },
    "groups": {
        "screen>5": {
            "n": int(len(hi)),
            "mean_math_score": round(hi["math_score"].mean(), 4),
            "mean_reading_score": round(hi["reading_score"].mean(), 4),
            "mean_screen_hours_per_day": round(hi["screen_hours_per_day"].mean(), 4),
        },
        "screen<=5": {
            "n": int(len(lo)),
            "mean_math_score": round(lo["math_score"].mean(), 4),
            "mean_reading_score": round(lo["reading_score"].mean(), 4),
            "mean_screen_hours_per_day": round(lo["screen_hours_per_day"].mean(), 4),
        },
    },
    "mean_diff_hi_minus_lo": {
        "math_score": round(hi["math_score"].mean() - lo["math_score"].mean(), 4),
        "reading_score": round(hi["reading_score"].mean() - lo["reading_score"].mean(), 4),
    },
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi2\bench\batch1-2\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("saved:", out, os.path.getsize(out), "bytes")

```
