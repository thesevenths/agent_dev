    }
out["dup_student_id"] = int(df["student_id"].duplicated().sum())
out["screen_gt5"] = int((df["screen_hours_per_day"] > 5).sum())
out["screen_le5"] = int((df["screen_hours_per_day"] <= 5).sum())
import json
print(json.dumps(out, ensure_ascii=False, indent=2))
