import pandas as pd, numpy as np, json
df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"], method="pearson")
r_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")
# also spearman for reference
rs_math = df["screen_hours_per_day"].corr(df["math_score"], method="spearman")
rs_read = df["screen_hours_per_day"].corr(df["reading_score"], method="spearman")
out = {
  "n": n,
  "pearson_screen_math": float(r_math),
  "pearson_screen_reading": float(r_read),
  "spearman_screen_math": float(rs_math),
  "spearman_screen_reading": float(rs_read),
}
print(json.dumps(out, indent=2))
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved")

