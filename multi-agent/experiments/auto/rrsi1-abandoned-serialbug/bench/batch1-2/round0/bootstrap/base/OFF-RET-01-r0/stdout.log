import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

res = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": "W01-W30", "n": 30, "mean": float(first.mean()), "std": float(first.std(ddof=1))},
    "last30": {"weeks": "W31-W60", "n": 30, "mean": float(last.mean()), "std": float(last.std(ddof=1))},
    "diff_mean_last_minus_first": float(last.mean() - first.mean()),
    "overall": {"mean": float(overall_mean), "std": float(overall_std)},
    "threshold_mean_minus_2std": float(threshold),
    "weeks_below_threshold": int(len(below)),
    "weeks_below_threshold_list": below.index.tolist(),
    "values_below": below.tolist(),
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\tmp"
os.makedirs(out, exist_ok=True)
p = os.path.join(out, "retention_d7_stats.json")
with open(p, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", p)

