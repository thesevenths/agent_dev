import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"].astype(float)
print("rows:", len(df), "nulls:", r.isna().sum())

first30 = r.iloc[:30]
last30 = r.iloc[30:]

stats = {
    "first30_mean": first30.mean(),
    "first30_std": first30.std(ddof=1),
    "last30_mean": last30.mean(),
    "last30_std": last30.std(ddof=1),
    "diff_mean": last30.mean() - first30.mean(),
    "overall_mean": r.mean(),
    "overall_std": r.std(ddof=1),
}
threshold = stats["overall_mean"] - 2*stats["overall_std"]
below = r[r < threshold]
stats["threshold"] = threshold
stats["below_count"] = len(below)
stats["below_weeks"] = list(df.loc[below.index, "week"])

for k, v in stats.items():
    print(k, v)

out = pd.DataFrame([
    {"metric": "first30_mean", "value": stats["first30_mean"], "n": 30},
    {"metric": "first30_std", "value": stats["first30_std"], "n": 30},
    {"metric": "last30_mean", "value": stats["last30_mean"], "n": 30},
    {"metric": "last30_std", "value": stats["last30_std"], "n": 30},
    {"metric": "diff_mean_last_minus_first", "value": stats["diff_mean"], "n": 60},
    {"metric": "overall_mean", "value": stats["overall_mean"], "n": 60},
    {"metric": "overall_std", "value": stats["overall_std"], "n": 60},
    {"metric": "threshold_mean_minus_2std", "value": stats["threshold"], "n": 60},
    {"metric": "weeks_below_threshold", "value": stats["below_count"], "n": 60},
])
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round1\cand\OFF-RET-01-r1\_sandbox\tmp\retention_d7_stats.csv"
out.to_csv(out_path, index=False)
print("saved:", out_path)

```
