\cand\\OFF-QUA-03-r0\\_sandbox\\tmp"\nOFF = os.path.join(BASE, "offline_data")\nTOP3_CSV = os.path.join(OFF, "top3_anomalies.csv")\nRATIOS_CSV = os.path.join(OFF, "volume_anomaly_ratios.csv")\nOUT_MD = os.path.join(OFF, "volume_anomaly_report.md")\n\n\ndef read_csv(path):\n    with open(path, "r", encoding="utf-8-sig", newline="") as f:\n        return list(csv.DictReader(f))\n\n\ntop3 = read_csv(TOP3_CSV)\nratios = read_csv(RATIOS_CSV)\n\n# ---- derived stats from volume_anomaly_ratios.csv (150 rows, all with ratio > 1.0) ----\nn_ratios = len(ratios)\nratios_sorted = sorted(ratios, key=lambda r: float(r["volume_ratio"]), reverse=True)\ntop3_in_ratios = [r for r in ratios_sorted[:3]]\nassert [ (r["region"], r["product_line"], r["month"]) for r in top3_in_ratios ] == \\\n       [ (r["region"], r["product_line"], r["month"]) for r in top3 ], "top3 mismatch"\n\nn_above_15 = sum(1 for r in ratios if float(r["volume_ratio"]) >= 1.5)\nn_above_12 = sum(1 for r in ratios if float(r["volume_ratio"]) >= 1.2)\nn_above_10 = sum(1 for r in ratios if float(r["volume_ratio"]) >= 1.0)\nn_below_10 = sum(1 for r in ratios if float(r["volume_ratio"]) < 1.0)\nmax_ratio = float(ratios_sorted[0]["volume_ratio"])\nmin_ratio = float(ratios_sorted[-1]["volume_ratio"])\nmonths_2025_03 = sum(1 for r in ratios if r["month"] == "2025-03")\n\n# per-combo context: baseline mean & spike month values from ratios file\ndef combo_row(region, pl, month):\n    for r in ratios:\n        if r["region"] == region and r["product_line"] == pl and r["month"] == month:\n            return r\n    raise KeyError((region, pl, month))\n\n\nrows = []\nfor t in top3:\n    r = combo_row(t["region"], t["product_line"], t["month"])\n    rows.append((t, r))\n\n# ---- build report ----\nL = []\nL.append("# 区域×产品线单月销量放量异常分析报告")\nL.append("")\nL.append("AS_OF: 2026-10-23 13:41（报告生成时刻；数据为本地离线 CSV，非实时行情）")\nL.append("")\nL.append("## 1. 分析背景与方法")\nL.append("")\nL.append("本报告基于本地文件 `offline_data/regional_sales.csv`（月度「区域×产品线」销量明细，"\n         "含 `units`、`returns`、`revenue`、`unit_price` 等列）的派生结果，定位单月放量异常。"\n         "方法：对每个「区域×产品线」组合，计算其某月销量 `units` 相对该组合自身 24 个月均值"\n         "（`rolling_mean_24m`）的倍数 `volume_ratio = units / rolling_mean_24m`，取倍数最大的前三个组合，"\n         "并结合该月退货率 `returns / units` 判断放量更像真实需求还是渠道压货。"\n         "全部结论仅来自本地 CSV，未使用任何联网数据。")\nL.append("")\nL.append("## 2. 数据概览")\nL.append("")\nL.append(f"- 异常候选池：`volume_ratio > 1.0` 的「区域×产品线×月份」记录共 {n_ratios} 条"\n         f"（来源：offline_data/regional_sales.csv 的 units 与 rolling_mean_24m，"\n         f"按 区域×产品线×月份 聚合，样本行数 {n_ratios}）。")\nL.append(f"- 其中倍数 ≥ 1.5 的有 {n_above_15} 条，≥ 1.2 的有 {n_above_12} 条，"\n         f"≥ 1.0 的有 {n_above_10} 条，< 1.0 的有 {n_below_10} 条"\n         f"（来源：offline_data/regional_sales.csv 的 units 与 rolling_mean_24m，"\n         f"按 区域×产品线×月份 聚合，样本行数 {n_ratios}）。")\nL.append(f"- 全池最高倍数 {max_ratio:.4f}、最低倍数 {min_ratio:.4f}"\n         f"（来源：offline_data/regional_sales.csv 的 units 与 rolling_mean_24m，"\n         f"按 区域×产品线×月份 聚合，样本行数 {n_ratios}）。")\nL.append(f"- 2025-03 单月即贡献了 {months_2025_03} 条放量记录，是异常最集中的月份"\n         f"（来源：offline_data/regional_sales.csv 的 month 列，按 区域×产品线×月份 聚合，样本行数 {n_ratios}）。")\nL.append("")\nL.append("## 3. 倍数最大的前三个组合")\nL.append("")\nL.append("| 排名 | 区域 | 产品线 | 异常月份 | 当月销量 units | 24个月均值 | 放量倍数 | 当月退货数 returns | 当月退货率 |")\nL.append("|---|---|---|---|---|---|---|---|---|")\nfor i, (t, r) in enumerate(rows, 1):\n    rr = float(r["returns"]) / float(r["units"])\n    L.append(f"| {i} | {r[\'region\']} | {r[\'product_line\']} | {r[\'month\']} "\n             f"| {r[\'units\']} | {float(r[\'rolling_mean_24m\']):.1f} "\n             f"| {float(r[\'volume_ratio\']):.4f} | {r[\'returns\']} | {rr:.2%} |")\nL.append("")\nL.append("表格数字来源说明：")\nL.append("")\nfor i, (t, r) in enumerate(rows, 1):\n    rr = float(r["returns"]) / float(r["units"])\n    L.append(f"- 第 {i} 行（{r[\'region\']}×{r[\'product_line\']}，{r[\'month\']}）："\n             f"当月销量 {r[\'units\']} 件（来源：offline_data/regional_sales.csv 的 units，"\n             f"区域={r[\'region\']}、产品线={r[\'product_line\']}、月份={r[\'month\']} 的单行记录，样本行数 1）；"\n             f"24 个月均值 {float(r[\'rolling_mean_24m\']):.1f} 件（来源：offline_data/regional_sales.csv 的 units，"\n             f"按 区域×产品线 分组取 24 个月均值，样本行数 24）；"\n             f"放量倍数 {float(r[\'volume_ratio\']):.4f}（来源：由前述两行计算，units ÷ 24 个月均值）；"\n             f"当月退货率 {rr:.2%}（来源：offline_data/regional_sales.csv 的 returns 与 units，"\n             f"区域={r[\'region\']}、产品线={r[\'product_line\']}、月份={r[\'month\']} 的单行记录，样本行数 1）。")\nL.append("")\nL.append("## 4. 真实需求 vs 渠道压货判断")\nL.append("")\nL.append("判断依据：渠道压货（channel stuffing）的典型特征是销量激增的同时退货率显著抬升"\n         "（渠道退货冲销），而真实需求放量通常伴随正常或偏低的退货率。")\nL.append("")\nt1, r1 = rows[0]\nrr1 = float(r1["returns"]) / float(r1["units"])\nL.append(f"1. **E 区 × Accessory（2025-03）**：倍数 {float(r1[\'volume_ratio\']):.4f}，"\n         f"当月退货率 {rr1:.2%}。该退货率处于该组合正常量级（同池 Accessory 组合退货率普遍在 5% 上下，"\n         f"如 2025-11 N 区 Accessory 为 {float(combo_row(\'N\',\'Accessory\',\'2025-11\')[\'returns\'])/float(combo_row(\'N\',\'Accessory\',\'2025-11\')[\'units\']):.2%}），"\n         f"未见压货式退货抬升，且 2025-03 为多区域多产品线共同放量的月份，"\n         f"更像**真实需求（季节性/促销驱动）**而非渠道压货。")\nt2, r2 = rows[1]\nrr2 = float(r2["returns"]) / float(r2["units"])\nL.append(f"2. **E 区 × Service（2025-03）**：倍数 {float(r2[\'volume_ratio\']):.4f}，"\n         f"当月退货率仅 {rr2:.2%}，远低于实物产品线的退货水平，"\n         f"服务类业务本身退货率低，放量伴随极低退货，"\n         f"判断为**真实需求**（服务采购放量），无压货迹象。")\nt3, r3 = rows[2]\nrr3 = float(r3["returns"]) / float(r3["units"])\nL.append(f"3. **E 区 × Hardware（2025-03）**：倍数 {float(r3[\'volume_ratio\']):.4f}，"\n         f"但当月退货率高达 {rr3:.2%}，显著高于该组合其他月份（如 2025-12 E 区 Hardware 退货率 "\n         f"{float(combo_row(\'E\',\'Hardware\',\'2025-12\')[\'returns\'])/float(combo_row(\'E\',\'Hardware\',\'2025-12\')[\'units\']):.2%}、"\n         f"2025-11 E 区 Hardware 退货率 "\n         f"{float(combo_row(\'E\',\'Hardware\',\'2025-11\')[\'returns\'])/float(combo_row(\'E\',\'Hardware\',\'2025-11\')[\'units\']):.2%}），"\n         f"销量激增与退货率异常抬升同时出现，符合渠道先压货、后退货冲销的特征，"\n         f"判断该放量**更像渠道压货**，需重点核查 E 区 Hardware 的渠道库存与退货流向。")\nL.append("")\nL.append("## 5. 结论")\nL.append("")\nL.append("综合来看，2025-03 是全局放量最集中的月份，倍数最大的三个组合全部落在 E 区："\n         "E×Accessory（1.6457 倍，退货率 5.94%）与 E×Service（1.5524 倍，退货率 0.74%）"\n         "退货率正常或偏低，判断为真实需求驱动；而 E×Hardware（1.5489 倍，退货率 17.37%）"\n         "退货率异常抬升，判断更像渠道压货，建议对 E 区 Hardware 渠道进行专项审计。"\n         "（来源：offline_data/regional_sales.csv 的 units、returns、rolling_mean_24m，"\n         "按 区域×产品线×月份 聚合，样本行数 150；倍数与退货率均由前述两行计算。）")\nL.append("")\n\nwith open(OUT_MD, "w", encoding="utf-8") as f:\n    f.write("\\n".join(L))\n\nprint("WROTE:", OUT_MD)\nprint("bytes:", os.path.getsize(OUT_MD))\n'} with error:
