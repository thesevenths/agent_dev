    {"group": "screen_hours_per_day <= 5", "n": len(lo), "mean_math_score": round(lo_math,4), "mean_reading_score": round(lo_read,4)},
])
out_csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step2_group_stats.csv"
