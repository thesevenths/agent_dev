corr_math = df["screen_hours_per_day"].corr(df["math_score"])
corr_reading = df["screen_hours_per_day"].corr(df["reading_score"])

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

hi_math, hi_read = hi["math_score"].mean(), hi["reading_score"].mean()
