        "reading_score": round(hi_read - lo_read, 4)
    }
}

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

# also a CSV for group stats
g = pd.DataFrame([
