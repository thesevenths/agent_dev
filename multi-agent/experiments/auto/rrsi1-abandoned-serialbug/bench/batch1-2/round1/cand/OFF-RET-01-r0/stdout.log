import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
    "n_total": len(r),
    "first30": {"weeks": list(df["week"].iloc[:30]), "mean": first.mean(), "std": first.std(ddof=1)},
    "last30": {"weeks": list(df["week"].iloc[30:]), "mean": last.mean(), "std": last.std(ddof=1)},
    "diff_mean": last.mean() - first.mean(),
    "overall_mean": overall_mean,
    "overall_std": overall_std,
    "threshold": threshold,
    "below_count": int((r < threshold).sum()),
    "below_weeks": list(below["week"]),
    "below_values": {w: v for w, v in zip(below["week"], below["retention_d7"])},
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round1\cand\OFF-RET-01-r0\_sandbox\tmp\retention_d7_stats.json"
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

