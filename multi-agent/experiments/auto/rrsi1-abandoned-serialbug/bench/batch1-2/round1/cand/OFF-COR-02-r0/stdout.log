import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round1\cand\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

corr_math = df["screen_hours_per_day"].corr(df["math_score"], method="pearson")
corr_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

res = {
    "n_total": int(len(df)),
    "corr": {
        "screen_vs_math": corr_math,
        "screen_vs_reading": corr_read,
    },
    "groups": {
        "screen_gt_5": {
            "n": int(len(hi)),
            "mean_math": hi["math_score"].mean(),
            "mean_reading": hi["reading_score"].mean(),
            "mean_screen": hi["screen_hours_per_day"].mean(),
        },
        "screen_le_5": {
            "n": int(len(lo)),
            "mean_math": lo["math_score"].mean(),
            "mean_reading": lo["reading_score"].mean(),
            "mean_screen": lo["screen_hours_per_day"].mean(),
        },
    },
    "diff_gt5_minus_le5": {
        "math": hi["math_score"].mean() - lo["math_score"].mean(),
        "reading": hi["reading_score"].mean() - lo["reading_score"].mean(),
    },
}
print(json.dumps(res, indent=2, ensure_ascii=False))

