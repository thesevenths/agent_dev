import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round1\base\OFF-RET-01-r0\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
r = df["retention_d7"]

first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

results = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": "W01-W30", "n": int(len(first30)),
                "mean": float(first30.mean()), "std": float(first30.std(ddof=1))},
    "last30": {"weeks": "W31-W60", "n": int(len(last30)),
               "mean": float(last30.mean()), "std": float(last30.std(ddof=1))},
    "diff_mean_last30_minus_first30": float(last30.mean() - first30.mean()),
    "overall": {"n": int(len(r)), "mean": float(overall_mean), "std": float(overall_std)},
    "threshold_mean_minus_2std": float(threshold),
    "weeks_below_threshold": {
        "count": int(len(below)),
        "weeks": below["week"].tolist(),
        "values": below["retention_d7"].tolist(),
    },
}

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round1\base\OFF-RET-01-r0\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

print(json.dumps(results, ensure_ascii=False, indent=2))
print("\nSaved to:", out)

