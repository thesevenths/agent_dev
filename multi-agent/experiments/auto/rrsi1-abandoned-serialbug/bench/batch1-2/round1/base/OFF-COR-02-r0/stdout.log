import pandas as pd, json
from scipy import stats
df = pd.read_csv("offline_data/students.csv")
hi = df[df.screen_hours_per_day > 5]
lo = df[df.screen_hours_per_day <= 5]
n_hi, n_lo = len(hi), len(lo)
m_hi, m_lo = hi.math_score.mean(), lo.math_score.mean()
r_hi, r_lo = hi.reading_score.mean(), lo.reading_score.mean()
s_hi, s_lo = hi.screen_hours_per_day.mean(), lo.screen_hours_per_day.mean()
dm = m_hi - m_lo
dr = r_hi - r_lo
# t-tests
t_m, p_m = stats.ttest_ind(hi.math_score, lo.math_score)
t_r, p_r = stats.ttest_ind(hi.reading_score, lo.reading_score)
