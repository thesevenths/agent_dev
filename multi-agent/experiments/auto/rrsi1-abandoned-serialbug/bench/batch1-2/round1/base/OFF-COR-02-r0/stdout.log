  "group_hi": {"n": n_hi, "screen_mean": round(s_hi,4), "math_mean": round(m_hi,4), "reading_mean": round(r_hi,4)},
  "group_lo": {"n": n_lo, "screen_mean": round(s_lo,4), "math_mean": round(m_lo,4), "reading_mean": round(r_lo,4)},
  "diff_math_hi_minus_lo": round(dm,4),
  "diff_reading_hi_minus_lo": round(dr,4),
  "t_math": round(t_m,4), "p_math": float(f"{p_m:.3e}"),
