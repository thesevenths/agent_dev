import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df.screen_hours_per_day.corr(df.math_score, method="pearson")
r_read = df.screen_hours_per_day.corr(df.reading_score, method="pearson")
# significance via t-test
import math
def ttest(r, n):
    t = r*math.sqrt((n-2)/(1-r*r))
    return t
t_m = ttest(r_math, n); t_r = ttest(r_read, n)
from scipy import stats
p_m = 2*stats.t.sf(abs(t_m), n-2)
p_r = 2*stats.t.sf(abs(t_r), n-2)
res = {
  "n": n,
  "pearson_screen_math": round(r_math, 6),
  "pearson_screen_reading": round(r_read, 6),
  "t_screen_math": round(t_m, 4), "p_screen_math": float(f"{p_m:.3e}"),
  "t_screen_reading": round(t_r, 4), "p_screen_reading": float(f"{p_r:.3e}"),
  "as_of": "2026-10-23 13:37"
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi1\bench\batch1-2\round1\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(res)
print("saved:", out)

```
