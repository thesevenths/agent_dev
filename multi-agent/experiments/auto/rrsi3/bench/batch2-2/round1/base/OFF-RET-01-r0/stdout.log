import pandas as pd

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-01-r0\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-01-r0\_sandbox\tmp\step2_stats.csv"

df = pd.read_csv(csv)
first = df.iloc[:30]["retention_d7"]
last  = df.iloc[30:]["retention_d7"]
overall = df["retention_d7"]

m1, s1 = first.mean(), first.std(ddof=1)
m2, s2 = last.mean(), last.std(ddof=1)
mo, so = overall.mean(), overall.std(ddof=1)
threshold = mo - 2*so
below = df[overall < threshold]

rows = [
    ("first30_mean",   m1,  "W01-W30, n=30, ddof=1"),
    ("first30_std",    s1,  "W01-W30, n=30, ddof=1"),
    ("last30_mean",    m2,  "W31-W60, n=30, ddof=1"),
    ("last30_std",     s2,  "W31-W60, n=30, ddof=1"),
    ("mean_diff",      m2-m1, "last30_mean - first30_mean"),
    ("std_diff",       s2-s1, "last30_std - first30_std"),
    ("overall_mean",   mo,  "W01-W60, n=60, ddof=1"),
    ("overall_std",    so,  "W01-W60, n=60, ddof=1"),
    ("threshold_mean_minus_2std", threshold, "overall_mean - 2*overall_std"),
    ("weeks_below_threshold", len(below), "count of retention_d7 < threshold, n=60"),
]
res = pd.DataFrame(rows, columns=["metric","value","definition"])
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("\nweeks below threshold:")
print(below[["week","retention_d7"]].to_string(index=False))

