import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]
last = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
thr = overall_mean - 2*overall_std
below = df[r < thr]

res = {
    "n_total": len(r),
    "first30": {"weeks": "W01-W30", "n": len(first), "mean": first.mean(), "std": first.std(ddof=1), "min": first.min(), "max": first.max()},
    "last30": {"weeks": "W31-W60", "n": len(last), "mean": last.mean(), "std": last.std(ddof=1), "min": last.min(), "max": last.max()},
    "overall": {"n": len(r), "mean": overall_mean, "std": overall_std, "min": r.min(), "max": r.max()},
    "diff_mean_last_minus_first": last.mean() - first.mean(),
    "diff_std_last_minus_first": last.std(ddof=1) - first.std(ddof=1),
    "threshold_mean_minus_2std": thr,
    "weeks_below_threshold": len(below),
    "weeks_below_list": below["week"].tolist(),
    "weeks_below_values": below["retention_d7"].tolist(),
}
print(json.dumps(res, indent=2))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-01-r5\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("saved:", out)

# also a small CSV of the below-threshold weeks
below_out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-01-r5\_sandbox\tmp\step2_weeks_below_2sigma.csv"
below.to_csv(below_out, index=False)
print("saved:", below_out)

```
