```python
import pandas as pd, numpy as np, json, os

src = "offline_data/app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r2\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(src)
print(df.shape)
print(df.dtypes)
print("nulls:", df.isna().sum().sum())
print("dup weeks:", df['week'].duplicated().sum())

# validation: ranges
print("retention range:", df.retention_d7.min(), df.retention_d7.max())
print("churn range:", df.churn_rate.min(), df.churn_rate.max())
print("arpu range:", df.arpu_usd.min(), df.arpu_usd.max())
print("cohort_size range:", df.cohort_size.min(), df.cohort_size.max())

# cleaned copy (drop any rows with NaN in key cols - none expected)
key = ['week','cohort_size','retention_d7','churn_rate','arpu_usd']
clean = df[key].dropna().copy()
clean_path = os.path.join(out_dir, "app_metrics_clean.csv")
clean.to_csv(clean_path, index=False)
print("clean rows:", len(clean), "->", clean_path)

# core stats for downstream
med = clean.retention_d7.median()
hi = clean[clean.retention_d7 >= med]
lo = clean[clean.retention_d7 < med]
corr1 = clean.retention_d7.corr(clean.arpu_usd)
corr2 = clean.retention_d7.corr(clean.churn_rate)
corr1p = clean.retention_d7.corr(clean.arpu_usd, method='spearman')
corr2p = clean.retention_d7.corr(clean.churn_rate, method='spearman')

summary = dict(
    n_rows=len(clean),
    retention_median=float(med),
    corr_ret_arpu_pearson=float(corr1),
    corr_ret_churn_pearson=float(corr2),
    corr_ret_arpu_spearman=float(corr1p),
    corr_ret_churn_spearman=float(corr2p),
    hi_n=len(hi), hi_arpu_mean=float(hi.arpu_usd.mean()), hi_cohort_total=int(hi.cohort_size.sum()),
    lo_n=len(lo), lo_arpu_mean=float(lo.arpu_usd.mean()), lo_cohort_total=int(lo.cohort_size.sum()),
    overall_cohort_total=int(clean.cohort_size.sum()),
    overall_arpu_mean=float(clean.arpu_usd.mean()),
    overall_retention_mean=float(clean.retention_d7.mean()),
    overall_churn_mean=float(clean.churn_rate.mean()),
    arpu_diff=float(hi.arpu_usd.mean()-lo.arpu_usd.mean()),
)
with open(os.path.join(out_dir, "step1_summary.json"), "w") as f:
    json.dump(summary, f, indent=2)
print(json.dumps(summary, indent=2))

```
