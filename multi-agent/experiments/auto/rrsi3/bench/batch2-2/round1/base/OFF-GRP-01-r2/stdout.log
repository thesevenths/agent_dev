import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
g = df.groupby("tutoring")["math_score"].agg(n="count", mean="mean", std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,"n"]), int(g.loc[1,"n"])
m0, m1 = g.loc[0,"mean"], g.loc[1,"mean"]
s0, s1 = g.loc[0,"std"], g.loc[1,"std"]
mean_diff = m1 - m0
pooled_std = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
d = mean_diff / pooled_std
# classification
if abs(d) < 0.5: cls = "small"
elif abs(d) < 0.8: cls = "medium"
else: cls = "large"

res = {
  "as_of": "2026-10-25 05:38",
  "source_file": "offline_data/students.csv",
  "groups": {
    "tutoring_0": {"n": n0, "mean": round(m0,4), "std": round(s0,4)},
    "tutoring_1": {"n": n1, "mean": round(m1,4), "std": round(s1,4)}
  },
  "mean_diff_t1_minus_t0": round(mean_diff,4),
  "pooled_std": round(pooled_std,4),
  "cohens_d": round(d,4),
  "effect_size_class": cls,
  "std_ddof": 1
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-01-r2\_sandbox\tmp\step2_group_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

