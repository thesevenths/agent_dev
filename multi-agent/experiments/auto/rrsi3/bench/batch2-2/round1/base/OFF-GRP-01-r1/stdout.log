import pandas as pd, json

df = pd.read_csv('offline_data/students.csv')
g = df.groupby('tutoring')['math_score'].agg(n='count', mean='mean', std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,'n']), int(g.loc[1,'n'])
m0, m1 = g.loc[0,'mean'], g.loc[1,'mean']
s0, s1 = g.loc[0,'std'], g.loc[1,'std']
mean_diff = m1 - m0
pooled_std = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
d = mean_diff / pooled_std

def classify(d):
    a = abs(d)
    if a < 0.2: return '可忽略 (negligible, |d|<0.2)'
    if a < 0.5: return '小 (small, 0.2≤|d|<0.5)'
    if a < 0.8: return '中 (medium, 0.5≤|d|<0.8)'
    return '大 (large, |d|≥0.8)'

out = {
  "as_of": "2026-10-25 05:38",
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "groups": {
    "0": {"n": n0, "mean": m0, "std": s0},
    "1": {"n": n1, "mean": m1, "std": s1},
  },
  "mean_diff_t1_minus_t0": mean_diff,
  "pooled_std": pooled_std,
  "cohens_d": d,
  "effect_size_classification": classify(d),
  "notes": "std 为样本标准差 (ddof=1); pooled_std = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); d = (mean1-mean0)/pooled_std; 分类阈值: |d|<0.2 可忽略, <0.5 小, <0.8 中, >=0.8 大"
}
with open(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-01-r1\_sandbox\tmp\step2_group_stats.json','w',encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))

