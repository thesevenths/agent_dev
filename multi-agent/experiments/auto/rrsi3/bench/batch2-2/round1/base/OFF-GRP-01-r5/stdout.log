import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-01-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

t = df["tutoring"].value_counts().to_dict()
print("tutoring values:", t)
print("unique tutoring:", sorted(df["tutoring"].unique()))
print("math_score range:", df["math_score"].min(), df["math_score"].max())
print("dup student_id:", df["student_id"].duplicated().sum())

# quick group stats for downstream step
g = df.groupby("tutoring")["math_score"].agg(["count","mean","std"])
print(g)
pooled = ((g.loc[0,"std"]**2*(g.loc[0,"count"]-1) + g.loc[1,"std"]**2*(g.loc[1,"count"]-1)) / (g.loc[0,"count"]+g.loc[1,"count"]-2))**0.5
print("pooled std:", pooled, "diff:", g.loc[1,"mean"]-g.loc[0,"mean"], "d:", (g.loc[1,"mean"]-g.loc[0,"mean"])/pooled)

```
