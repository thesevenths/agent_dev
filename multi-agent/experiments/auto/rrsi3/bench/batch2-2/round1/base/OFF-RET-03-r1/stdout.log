import pandas as pd, numpy as np, os

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r1\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
n = len(df)

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
# also spearman for robustness
from scipy.stats import pearsonr, spearmanr
p_arpu, pv_arpu = pearsonr(df["retention_d7"], df["arpu_usd"])
p_churn, pv_churn = pearsonr(df["retention_d7"], df["churn_rate"])
s_arpu, sv_arpu = spearmanr(df["retention_d7"], df["arpu_usd"])
s_churn, sv_churn = spearmanr(df["retention_d7"], df["churn_rate"])

med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = []
rows.append(["pearson_retention_d7_vs_arpu_usd", round(p_arpu, 6), f"p={pv_arpu:.6g}, n={n}"])
rows.append(["pearson_retention_d7_vs_churn_rate", round(p_churn, 6), f"p={pv_churn:.6g}, n={n}"])
rows.append(["spearman_retention_d7_vs_arpu_usd", round(s_arpu, 6), f"p={sv_arpu:.6g}, n={n}"])
rows.append(["spearman_retention_d7_vs_churn_rate", round(s_churn, 6), f"p={sv_churn:.6g}, n={n}"])
rows.append(["retention_d7_median", round(med, 6), "split threshold"])
rows.append(["group_high_n", len(hi), "retention_d7 > median"])
rows.append(["group_high_arpu_usd_mean", round(hi["arpu_usd"].mean(), 6), f"n={len(hi)}"])
rows.append(["group_high_cohort_size_sum", int(hi["cohort_size"].sum()), f"n={len(hi)}"])
rows.append(["group_high_retention_d7_mean", round(hi["retention_d7"].mean(), 6), f"n={len(hi)}"])
rows.append(["group_high_churn_rate_mean", round(hi["churn_rate"].mean(), 6), f"n={len(hi)}"])
rows.append(["group_low_n", len(lo), "retention_d7 <= median"])
rows.append(["group_low_arpu_usd_mean", round(lo["arpu_usd"].mean(), 6), f"n={len(lo)}"])
rows.append(["group_low_cohort_size_sum", int(lo["cohort_size"].sum()), f"n={len(lo)}"])
rows.append(["group_low_retention_d7_mean", round(lo["retention_d7"].mean(), 6), f"n={len(lo)}"])
rows.append(["group_low_churn_rate_mean", round(lo["churn_rate"].mean(), 6), f"n={len(lo)}"])
rows.append(["arpu_diff_high_minus_low", round(hi["arpu_usd"].mean() - lo["arpu_usd"].mean(), 6), "derived"])
rows.append(["arpu_ratio_high_over_low", round(hi["arpu_usd"].mean() / lo["arpu_usd"].mean(), 6), "derived"])
rows.append(["churn_diff_high_minus_low", round(hi["churn_rate"].mean() - lo["churn_rate"].mean(), 6), "derived"])

res = pd.DataFrame(rows, columns=["metric", "value", "note"])
tmp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r1\_sandbox\tmp"
out_csv = os.path.join(tmp, "step2_correlations_group_stats.csv")
res.to_csv(out_csv, index=False)
print(res.to_string(index=False))
print("\nSaved:", out_csv)

