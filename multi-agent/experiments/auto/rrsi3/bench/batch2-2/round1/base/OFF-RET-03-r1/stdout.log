import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r1\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

out = {}
out["shape"] = list(df.shape)
out["columns"] = list(df.columns)
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}
out["missing"] = {c: int(df[c].isna().sum()) for c in df.columns}
out["duplicated_rows"] = int(df.duplicated().sum())
out["week_range"] = [df["week"].min(), df["week"].max()]
out["week_unique"] = int(df["week"].nunique())

for c in ["retention_d7", "churn_rate", "arpu_usd", "cohort_size"]:
    s = df[c]
    out[c] = {
        "min": float(s.min()), "max": float(s.max()),
        "mean": float(s.mean()), "median": float(s.median()),
        "std": float(s.std(ddof=1)),
    }

out["retention_d7_median"] = float(df["retention_d7"].median())
out["n_above_median"] = int((df["retention_d7"] > df["retention_d7"].median()).sum())
out["n_below_median"] = int((df["retention_d7"] < df["retention_d7"].median()).sum())
out["n_equal_median"] = int((df["retention_d7"] == df["retention_d7"].median()).sum())

# correlations
out["corr_retention_arpu"] = float(df["retention_d7"].corr(df["arpu_usd"]))
out["corr_retention_churn"] = float(df["retention_d7"].corr(df["churn_rate"]))
out["corr_method"] = "Pearson"

# group stats
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] < med]
out["group_high"] = {"n": int(len(hi)), "arpu_mean": float(hi["arpu_usd"].mean()), "cohort_total": int(hi["cohort_size"].sum())}
out["group_low"] = {"n": int(len(lo)), "arpu_mean": float(lo["arpu_usd"].mean()), "cohort_total": int(lo["cohort_size"].sum())}

import json
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r1\_sandbox\tmp\step1_validation.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", out_path)

```
