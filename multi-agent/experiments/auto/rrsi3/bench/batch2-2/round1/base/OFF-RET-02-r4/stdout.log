import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r4\_sandbox\tmp\step2_group_means.csv"

df = pd.read_csv(src)
w = df[df['week'].between('W30','W43')].copy()
w['group'] = w['week'].apply(lambda x: 'pre_W30-W36' if int(x[1:]) <= 36 else 'post_W37-W43')

metrics = ['retention_d7','churn_rate','arpu_usd']
per_week = w[['week','group'] + metrics].copy()

means = w.groupby('group')[metrics].mean().reset_index()
pre = means[means['group']=='pre_W30-W36'].iloc[0]
post = means[means['group']=='post_W37-W43'].iloc[0]

diff_rows = []
for m in metrics:
    d = post[m]-pre[m]
    diff_rows.append({
        'metric': m,
        'pre_mean_W30-W36': round(pre[m],6),
        'post_mean_W37-W43': round(post[m],6),
        'abs_diff_post_minus_pre': round(d,6),
        'pct_change': round(d/pre[m]*100,4),
    })
diff = pd.DataFrame(diff_rows)

# breakpoint detection: first week in W37-W43 where all three metrics deviate from pre-group mean
# simple rule: first week where retention_d7 < pre_mean - 0.02 AND churn_rate > pre_mean + 0.03
bp_week = None
for _, r in per_week.iterrows():
    if r['group']=='post_W37-W43':
        if r['retention_d7'] < pre['retention_d7']-0.02 and r['churn_rate'] > pre['churn_rate']+0.03:
            bp_week = r['week']; break
print("breakpoint week:", bp_week)

# combined output: per-week table + group means + diffs
with pd.ExcelWriter(out.replace('.csv','.xlsx')) as xw:
    pass  # not needed; use CSV instead

per_week.to_csv(out, index=False)
# append means and diff as extra sections in same CSV? Better: separate files.
means.to_csv(out.replace('step2_group_means.csv','step2_group_means_only.csv'), index=False)
diff.to_csv(out.replace('step2_group_means.csv','step2_diffs.csv'), index=False)

print(per_week.to_string(index=False))
print()
print(means.to_string(index=False))
print()
print(diff.to_string(index=False))
print("saved:", out)

