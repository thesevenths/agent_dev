import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
cols = ["retention_d7", "churn_rate", "arpu_usd"]

pre_w = [f"W{i:02d}" for i in range(30, 37)]
post_w = [f"W{i:02d}" for i in range(37, 44)]

pre = df[df["week"].isin(pre_w)].set_index("week").loc[pre_w]
post = df[df["week"].isin(post_w)].set_index("week").loc[post_w]

# per-week table
per = pd.concat([pre, post])[cols].copy()
per.insert(0, "window", ["pre"]*7 + ["post"]*7)
per.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r4\_sandbox\tmp\step2_per_week_values.csv")

# group means
means = pd.DataFrame({
    "W30-W36_mean_n7": pre[cols].mean(),
    "W37-W43_mean_n7": post[cols].mean(),
})
means["delta_post_minus_pre"] = means["W37-W43_mean_n7"] - means["W30-W36_mean_n7"]
means["delta_pct"] = means["delta_post_minus_pre"] / means["W30-W36_mean_n7"] * 100
means.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r4\_sandbox\tmp\step2_group_means.csv")

print(per.to_string())
print()
print(means.to_string())

# breakpoint: week-over-week change
wow = per[cols].diff()
print("\nweek-over-week change:")
print(wow.to_string())
print("\nmax |change| per metric (W37-W43 boundary region):")
for c in cols:
    print(c, "W36->W37:", round(wow.loc["W37", c], 4))

