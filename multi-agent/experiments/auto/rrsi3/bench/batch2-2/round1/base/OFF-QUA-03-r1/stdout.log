CSV = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-QUA-03-r1\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(CSV)
df['return_rate'] = df['returns'] / df['units']

# E region monthly totals for all 24 months
e = df[df['region']=='E'].groupby('month')['units'].sum()
print("E region monthly units (all 24m):")
print(e.to_string())
print("\nE region 24m mean:", e.mean())

# E region return rate by month
er = df[df['region']=='E'].groupby('month').agg(units=('units','sum'), returns=('returns','sum'))
er['rr'] = er['returns']/er['units']
print("\nE region monthly return rate:")
print(er.to_string())

# Check if 2025-03 is a one-month spike or part of a trend
# E region 2025-03 vs avg of other months
e_other = e.drop('2025-03').mean()
print(f"\nE region 2025-03: {e['2025-03']}, avg of other 23 months: {e_other:.1f}, ratio: {e['2025-03']/e_other:.3f}")

# Check other regions in 2025-03 for comparison
print("\nAll regions 2025-03 vs their 24m mean:")
for r in sorted(df['region'].unique()):
    sub = df[df['region']==r].groupby('month')['units'].sum()
    m = sub['2025-03']
    avg = sub.mean()
    print(f"  {r}: 2025-03={m:.0f}, 24m_mean={avg:.1f}, ratio={m/avg:.3f}")

# E/Hardware return rate in spike month: 17.37% vs 24m avg 3.92%
# This is a HUGE spike in return rate - classic channel stuffing signal
# But E/Accessory and E/Service have normal return rates
# Let's check: is the E/Hardware spike in returns consistent with channel stuffing?
# Channel stuffing: high sales + high returns (products come back)
# Real demand: high sales + normal/low returns

# Check E/Hardware returns in 2025-03 vs surrounding
sub = df[(df['region']=='E')&(df['product_line']=='Hardware')].sort_values('month').reset_index(drop=True)
print("\nE/Hardware returns detail around 2025-03:")
idx = sub.index[sub['month']=='2025-03'][0]
print(sub.iloc[max(0,idx-3):idx+4][['month','units','returns','return_rate']].to_string(index=False))

# Check if E region has a pattern of spikes in other months too
print("\nE region anomaly ratios by month (total units / 24m mean):")
e_mean = e.mean()
e_ratio = e / e_mean
print(e_ratio.sort_values(ascending=False).head(5).to_string())

