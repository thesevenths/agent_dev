import pandas as pd
CSV = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-QUA-03-r1\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(CSV)
print("shape:", df.shape)
print("regions:", sorted(df['region'].unique()))
print("product_lines:", sorted(df['product_line'].unique()))
print("months:", df['month'].nunique(), df['month'].min(), df['month'].max())
print("returns dtype:", df['returns'].dtype, "units dtype:", df['units'].dtype)
print("nulls:", df.isnull().sum().sum())

# returns rate = returns/units
df['return_rate'] = df['returns'] / df['units']

# For top 3 combos, show the anomaly month + surrounding months
top3 = [('E','Accessory','2025-03'), ('E','Service','2025-03'), ('E','Hardware','2025-03')]
for r,p,m in top3:
    sub = df[(df['region']==r)&(df['product_line']==p)].sort_values('month')
    idx = sub.index[sub['month']==m][0]
    window = sub.iloc[max(0,idx-3):idx+4]
    print(f"\n=== {r} / {p} around {m} ===")
    print(window[['month','units','return_rate']].to_string(index=False))

# Overall stats
print("\nOverall return rate by region-product (full 24m):")
agg = df.groupby(['region','product_line']).agg(units=('units','sum'), returns=('returns','sum'))
agg['rr'] = agg['returns']/agg['units']
print(agg.sort_values('rr', ascending=False).to_string())

# Check if E region has a general spike in 2025-03
print("\nE region total units by month 2025-01..2025-05:")
e = df[df['region']=='E'].groupby('month')['units'].sum()
print(e[e.index.between('2025-01','2025-05')].to_string())

# Compare 2025-03 vs 2025-04 for E
print("\nE region 2025-03 vs 2025-04 vs 2025-05 units by product:")
piv = df[df['region']=='E'].pivot_table(index='product_line', columns='month', values='units')
print(piv[['2025-02','2025-03','2025-04','2025-05']].to_string())

# return rate in spike month vs baseline for top3
print("\nTop3 spike-month return rate vs 24m avg return rate:")
for r,p,m in top3:
    sub = df[(df['region']==r)&(df['product_line']==p)].sort_values('month')
    row = sub[sub['month']==m].iloc[0]
    avg_rr = sub['returns'].sum()/sub['units'].sum()
    print(f"{r}/{p} {m}: spike_rr={row['return_rate']:.4f}, 24m_avg_rr={avg_rr:.4f}, spike_units={row['units']}, 24m_avg_units={sub['units'].mean():.1f}")

