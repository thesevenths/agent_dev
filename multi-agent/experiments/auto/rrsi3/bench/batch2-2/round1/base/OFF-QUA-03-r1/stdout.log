import pandas as pd
CSV = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-QUA-03-r1\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(CSV)
df['return_rate'] = df['returns'] / df['units']

top3 = [('E','Accessory','2025-03'), ('E','Service','2025-03'), ('E','Hardware','2025-03')]
for r,p,m in top3:
    sub = df[(df['region']==r)&(df['product_line']==p)].sort_values('month').reset_index(drop=True)
    idx = sub.index[sub['month']==m][0]
    window = sub.iloc[max(0,idx-3):idx+4]
    print(f"=== {r} / {p} around {m} ===")
    print(window[['month','units','return_rate']].to_string(index=False))

print("\nE region total units by month 2025-01..2025-05:")
e = df[df['region']=='E'].groupby('month')['units'].sum()
print(e[['2025-01','2025-02','2025-03','2025-04','2025-05']].to_string())

print("\nE region units by product, months 2025-02..2025-05:")
piv = df[df['region']=='E'].pivot_table(index='product_line', columns='month', values='units')
print(piv[['2025-02','2025-03','2025-04','2025-05']].to_string())

print("\nTop3 spike-month return rate vs 24m avg return rate:")
for r,p,m in top3:
    sub = df[(df['region']==r)&(df['product_line']==p)]
    row = sub[sub['month']==m].iloc[0]
    avg_rr = sub['returns'].sum()/sub['units'].sum()
    print(f"{r}/{p} {m}: spike_rr={row['return_rate']:.4f}, 24m_avg_rr={avg_rr:.4f}, spike_units={row['units']}, 24m_avg_units={sub['units'].mean():.1f}")

# Check S/Hardware 2025-11 (4th place) for context
print("\nS/Hardware around 2025-11:")
sub = df[(df['region']=='S')&(df['product_line']=='Hardware')].sort_values('month').reset_index(drop=True)
idx = sub.index[sub['month']=='2025-11'][0]
print(sub.iloc[max(0,idx-2):idx+3][['month','units','return_rate']].to_string(index=False))

# Overall return rate
print("\nOverall return rate (all data):", df['returns'].sum()/df['units'].sum())
print("Overall units sum:", df['units'].sum(), "returns sum:", df['returns'].sum())

```
