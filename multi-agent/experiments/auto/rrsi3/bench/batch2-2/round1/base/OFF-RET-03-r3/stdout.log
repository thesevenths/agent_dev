import pandas as pd, numpy as np, json

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r3\_sandbox\offline_data\app_metrics.csv")
n = len(df)

r1 = df["retention_d7"].corr(df["arpu_usd"])          # Pearson
r2 = df["retention_d7"].corr(df["churn_rate"])
spear1 = df["retention_d7"].corr(df["arpu_usd"], method="spearman")
spear2 = df["retention_d7"].corr(df["churn_rate"], method="spearman")

med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] < med]
eq = int((df["retention_d7"] == med).sum())

groups = pd.DataFrame([
    {"group": "high (retention_d7 > median)", "n": len(hi), "arpu_usd_mean": hi["arpu_usd"].mean(),
     "cohort_size_sum": int(hi["cohort_size"].sum()), "retention_d7_mean": hi["retention_d7"].mean(),
     "churn_rate_mean": hi["churn_rate"].mean()},
    {"group": "low (retention_d7 < median)", "n": len(lo), "arpu_usd_mean": lo["arpu_usd"].mean(),
     "cohort_size_sum": int(lo["cohort_size"].sum()), "retention_d7_mean": lo["retention_d7"].mean(),
     "churn_rate_mean": lo["churn_rate"].mean()},
])
arpu_diff = groups.loc[0,"arpu_usd_mean"] - groups.loc[1,"arpu_usd_mean"]
arpu_ratio = groups.loc[0,"arpu_usd_mean"] / groups.loc[1,"arpu_usd_mean"]

out = {
    "as_of": "2026-10-26 01:40",
    "source": "offline_data/app_metrics.csv",
    "n": n,
    "retention_d7_median": float(med),
    "rows_equal_to_median": eq,
    "pearson_retention_arpu": float(r1),
    "pearson_retention_churn": float(r2),
    "spearman_retention_arpu": float(spear1),
    "spearman_retention_churn": float(spear2),
    "groups": groups.to_dict(orient="records"),
    "arpu_diff_high_minus_low": float(arpu_diff),
    "arpu_ratio_high_over_low": float(arpu_ratio),
}
print(json.dumps(out, indent=2, ensure_ascii=False))

# save intermediate CSV
groups.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r3\_sandbox\tmp\step2_group_stats.csv", index=False)
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r3\_sandbox\tmp\step2_results.json", "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved")

