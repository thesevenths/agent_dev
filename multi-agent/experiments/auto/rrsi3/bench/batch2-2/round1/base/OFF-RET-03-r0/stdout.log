import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)

# Pearson correlations
r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# p-values via t-statistic
from scipy import stats
t_arpu = r_arpu * np.sqrt((n-2)/(1-r_arpu**2))
p_arpu = 2 * stats.t.sf(abs(t_arpu), n-2)
t_churn = r_churn * np.sqrt((n-2)/(1-r_churn**2))
p_churn = 2 * stats.t.sf(abs(t_churn), n-2)

# median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

print("n =", n)
print("median retention_d7 =", med)
print(f"r(retention_d7, arpu_usd) = {r_arpu:.6f}, t={t_arpu:.4f}, p={p_arpu:.6g}")
print(f"r(retention_d7, churn_rate) = {r_churn:.6f}, t={t_churn:.4f}, p={p_churn:.6g}")
print("hi group: n =", len(hi), "mean arpu =", hi["arpu_usd"].mean(), "sum cohort =", int(hi["cohort_size"].sum()),
      "retention range:", hi["retention_d7"].min(), hi["retention_d7"].max())
print("lo group: n =", len(lo), "mean arpu =", lo["arpu_usd"].mean(), "sum cohort =", int(lo["cohort_size"].sum()),
      "retention range:", lo["retention_d7"].min(), lo["retention_d7"].max())
print("arpu diff (hi-lo) =", hi["arpu_usd"].mean() - lo["arpu_usd"].mean())
print("arpu ratio hi/lo =", hi["arpu_usd"].mean() / lo["arpu_usd"].mean())
print("cohort share hi =", hi["cohort_size"].sum()/df["cohort_size"].sum())
# also mean churn per group for context
print("hi mean churn =", hi["churn_rate"].mean(), "lo mean churn =", lo["churn_rate"].mean())

# save intermediate results CSV
out = pd.DataFrame({
    "metric": [
        "n_rows",
        "retention_d7_median",
        "pearson_r_retention_arpu",
        "p_value_retention_arpu",
        "pearson_r_retention_churn",
        "p_value_retention_churn",
        "hi_group_n_weeks",
        "hi_group_mean_arpu_usd",
        "hi_group_sum_cohort_size",
        "hi_group_mean_churn_rate",
        "lo_group_n_weeks",
        "lo_group_mean_arpu_usd",
        "lo_group_sum_cohort_size",
        "lo_group_mean_churn_rate",
        "arpu_diff_hi_minus_lo",
        "arpu_ratio_hi_over_lo",
    ],
    "value": [
        n, med, r_arpu, p_arpu, r_churn, p_churn,
        len(hi), hi["arpu_usd"].mean(), int(hi["cohort_size"].sum()), hi["churn_rate"].mean(),
        len(lo), lo["arpu_usd"].mean(), int(lo["cohort_size"].sum()), lo["churn_rate"].mean(),
        hi["arpu_usd"].mean() - lo["arpu_usd"].mean(),
        hi["arpu_usd"].mean() / lo["arpu_usd"].mean(),
    ],
})
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r0\_sandbox\tmp\step2_results.csv"
out.to_csv(out_path, index=False)
print("saved:", out_path)

