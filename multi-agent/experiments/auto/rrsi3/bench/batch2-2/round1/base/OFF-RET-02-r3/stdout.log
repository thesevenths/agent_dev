import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
pre = df[df['week'].isin([f"W{i:02d}" for i in range(30,37)])].copy()   # W30-W36
post = df[df['week'].isin([f"W{i:02d}" for i in range(37,44)])].copy()  # W37-W43

print("pre rows:", len(pre), "post rows:", len(post))

# Group means
means = pd.DataFrame({
    'group': ['W30-W36 (pre)', 'W37-W43 (post)'],
    'n': [len(pre), len(post)],
    'retention_d7_mean': [pre['retention_d7'].mean(), post['retention_d7'].mean()],
    'churn_rate_mean': [pre['churn_rate'].mean(), post['churn_rate'].mean()],
    'arpu_usd_mean': [pre['arpu_usd'].mean(), post['arpu_usd'].mean()],
})
print(means.to_string(index=False))

# Differences
diff = pd.DataFrame({
    'metric': metrics,
    'pre_mean': [pre[m].mean() for m in metrics],
    'post_mean': [post[m].mean() for m in metrics],
    'abs_diff(post-pre)': [post[m].mean()-pre[m].mean() for m in metrics],
    'pct_change': [(post[m].mean()-pre[m].mean())/pre[m].mean()*100 for m in metrics],
})
print("\nDIFFS:\n", diff.to_string(index=False))

# Per-week table W30-W43 with week-over-week deltas
sub = df[df['week'].isin([f"W{i:02d}" for i in range(30,44)])].copy().reset_index(drop=True)
for m in metrics:
    sub[f'{m}_wow'] = sub[m].diff()
print("\nPER-WEEK:\n", sub.to_string(index=False))

# Locate breakpoint: for each metric, find week with largest |WoW change| in W31-W43
print("\nMAX |WoW| per metric (W31-W43):")
for m in metrics:
    s = sub.set_index('week')[f'{m}_wow'].dropna()
    print(m, "max abs at", s.abs().idxmax(), "value", s[s.abs().idxmax()])

# Save intermediate CSV
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r3\_sandbox\tmp"
sub.to_csv(rf"{out_dir}\step2_per_week_W30_W43.csv", index=False)
means.to_csv(rf"{out_dir}\step2_group_means.csv", index=False)
diff.to_csv(rf"{out_dir}\step2_diffs.csv", index=False)
print("\nSaved 3 CSVs to", out_dir)

```
