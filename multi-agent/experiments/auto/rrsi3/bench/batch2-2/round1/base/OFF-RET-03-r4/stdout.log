    "n": [len(df), len(high), len(low)],
    "retention_d7_median": [med, med, med],
    "arpu_usd_mean": [df["arpu_usd"].mean(), high["arpu_usd"].mean(), low["arpu_usd"].mean()],
    "cohort_size_sum": [df["cohort_size"].sum(), high["cohort_size"].sum(), low["cohort_size"].sum()],
})
stats["corr_retention_arpu"] = corr_arpu
