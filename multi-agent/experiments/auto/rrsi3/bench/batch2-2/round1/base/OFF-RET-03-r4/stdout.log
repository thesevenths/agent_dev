import pandas as pd
import numpy as np

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r4\_sandbox\tmp"
df = pd.read_csv(p)
n = len(df)

med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] < med]
eq = df[df["retention_d7"] == med]
print("median:", med, "hi:", len(hi), "lo:", len(lo), "eq:", len(eq))

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
print("pearson r retention~arpu:", r_arpu)
print("pearson r retention~churn:", r_churn)

# significance: t-test
def pearson_p(r, n):
    t = r*np.sqrt(n-2)/np.sqrt(1-r*r)
    from scipy import stats
    pval = 2*stats.t.sf(abs(t), n-2)
    return t, pval
