def pearson_p(r, n):
    t = r*np.sqrt(n-2)/np.sqrt(1-r*r)
    pval = 2*stats.t.sf(abs(t), n-2)
    return t, pval
print("t,p arpu:", pearson_p(r_arpu, n))
print("t,p churn:", pearson_p(r_churn, n))

