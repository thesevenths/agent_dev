import pandas as pd
df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day","math_score","reading_score"]
sub = df[cols].dropna()
n = len(sub)
r_math = sub["screen_hours_per_day"].corr(sub["math_score"])
r_read = sub["screen_hours_per_day"].corr(sub["reading_score"])
print("n =", n)
print("r(screen, math) =", r_math)
print("r(screen, reading) =", r_read)
# also spearman for robustness
from scipy import stats
print("spearman math:", stats.spearmanr(sub["screen_hours_per_day"], sub["math_score"]))
print("spearman reading:", stats.spearmanr(sub["screen_hours_per_day"], sub["reading_score"]))
# p-values
print("pearson p math:", stats.pearsonr(sub["screen_hours_per_day"], sub["math_score"]))
print("pearson p reading:", stats.pearsonr(sub["screen_hours_per_day"], sub["reading_score"]))

```
