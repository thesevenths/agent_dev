import pandas as pd
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True:"high(>5)", False:"low(<=5)"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    screen_mean=("screen_hours_per_day","mean"),
    math_mean=("math_score","mean"),
    reading_mean=("reading_score","mean"),
    math_std=("math_score","std"),
    reading_std=("reading_score","std"),
)
print(g)
hi = g.loc["high(>5)"]; lo = g.loc["low(<=5)"]
print("diff math (high-low) =", hi.math_mean - lo.math_mean)
print("diff reading (high-low) =", hi.reading_mean - lo.reading_mean)
# t-tests
from scipy import stats
hi_d = df[df.screen_hours_per_day>5]; lo_d = df[df.screen_hours_per_day<=5]
print("ttest math:", stats.ttest_ind(hi_d.math_score, lo_d.math_score))
print("ttest reading:", stats.ttest_ind(hi_d.reading_score, lo_d.reading_score))

```
