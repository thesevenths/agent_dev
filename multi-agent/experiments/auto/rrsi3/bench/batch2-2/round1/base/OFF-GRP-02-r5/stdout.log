import pandas as pd, os, json

# Re-derive from source CSV to confirm upstream numbers
src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(src)

g = df.groupby(["grade","region"], observed=True).agg(
    n=("reading_score","size"),
    mean_reading_score=("reading_score","mean"),
).reset_index()
g["mean_reading_score"] = g["mean_reading_score"].round(2)

# full grid
full = pd.MultiIndex.from_product([["G10","G11","G12"],["A","B","C","D"]], names=["grade","region"])
g = g.set_index(["grade","region"]).reindex(full).reset_index()
g["n"] = g["n"].fillna(0).astype(int)
g = g.sort_values(["grade","region"]).reset_index(drop=True)

# compare with upstream json
up = json.load(open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-02-r5\_sandbox\tmp\step1_validation_summary.json", encoding="utf-8"))
up_map = {(r["grade"], r["region"]): (r["n"], r["mean_reading"]) for r in up["crosstab"]}
mismatch = []
for _, r in g.iterrows():
    u = up_map[(r["grade"], r["region"])]
    if u[0] != r["n"] or abs(u[1]-r["mean_reading_score"]) > 1e-9:
        mismatch.append((r["grade"], r["region"], u, (r["n"], r["mean_reading_score"])))
print("mismatches vs upstream:", mismatch)
print("sum n:", g["n"].sum())

mx = g.loc[g["mean_reading_score"].idxmax()]
mn = g.loc[g["mean_reading_score"].idxmin()]
print("max:", mx["grade"], mx["region"], mx["n"], mx["mean_reading_score"])
print("min:", mn["grade"], mn["region"], mn["n"], mn["mean_reading_score"])
print("gap:", round(mx["mean_reading_score"]-mn["mean_reading_score"],2))

# save clean structured CSV
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-02-r5\_sandbox\tmp\students_cross_tab.csv"
g.to_csv(out, index=False)
print("saved:", os.path.abspath(out))
print(g.to_string(index=False))

