```python
import pandas as pd, os

path = "offline_data/students.csv"
df = pd.read_csv(path)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-02-r5\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

# cross-tab: count + mean reading_score
g = df.groupby(["grade","region"], observed=True).agg(
    n=("reading_score","size"),
    mean_reading=("reading_score","mean"),
    min_reading=("reading_score","min"),
    max_reading=("reading_score","max"),
).reset_index()
g["mean_reading"] = g["mean_reading"].round(2)

# full grid check
full = pd.MultiIndex.from_product([["G10","G11","G12"],["A","B","C","D"]], names=["grade","region"])
g = g.set_index(["grade","region"]).reindex(full).reset_index()
g["n"] = g["n"].fillna(0).astype(int)

# overall
overall_mean = df["reading_score"].mean()

max_row = g.loc[g["mean_reading"].idxmax()]
min_row = g.loc[g["mean_reading"].idxmin()]

summary = {
    "file": os.path.abspath(path),
    "shape": list(df.shape),
    "columns": list(df.columns),
    "missing": {c: int(df[c].isna().sum()) for c in ["grade","region","reading_score"]},
    "grade_values": sorted(df["grade"].unique().tolist()),
    "region_values": sorted(df["region"].unique().tolist()),
    "reading_score": {
        "dtype": str(df["reading_score"].dtype),
        "min": int(df["reading_score"].min()),
        "max": int(df["reading_score"].max()),
        "mean": round(float(df["reading_score"].mean()),4),
        "std": round(float(df["reading_score"].std()),4),
    },
    "overall_mean": round(float(overall_mean),4),
    "crosstab": g.to_dict(orient="records"),
    "max_cell": {"grade": max_row["grade"], "region": max_row["region"], "n": int(max_row["n"]), "mean": float(max_row["mean_reading"])},
    "min_cell": {"grade": min_row["grade"], "region": min_row["region"], "n": int(min_row["n"]), "mean": float(min_row["mean_reading"])},
    "max_minus_min": round(float(max_row["mean_reading"]-min_row["mean_reading"]),2),
}

out_path = os.path.join(out_dir, "step1_validation_summary.json")
with open(out_path,"w",encoding="utf-8") as f:
    import json
    json.dump(summary, f, ensure_ascii=False, indent=2)

print(g.to_string(index=False))
print("max:", summary["max_cell"])
print("min:", summary["min_cell"])
print("saved:", os.path.abspath(out_path))

```
