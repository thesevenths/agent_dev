"units"])\ndf["returns"] = pd.to_numeric(df["returns"])\nn_rows = len(df)\nmonths = sorted(df["month"].unique())\nn_months = len(months)\nprint(f"rows={n_rows}, months={n_months} ({months[0]} .. {months[-1]})")\n\n# --- per region x product_line: monthly ratio vs own 24-month mean -------\nrows = []\nfor (region, pl), g in df.groupby(["region", "product_line"]):\n    g = g.sort_values("month").reset_index(drop=True)\n    g["mean24"] = g["units"].rolling(24, min_periods=24).mean()\n    g["ratio"] = g["units"] / g["mean24"]\n    g["return_rate"] = g["returns"] / g["units"]\n    g["region"] = region\n    g["product_line"] = pl\n    rows.append(g)\nfull = pd.concat(rows, ignore_index=True)\nvalid = full.dropna(subset=["ratio"]).copy()\n\n# baseline stability (CV of units over the 24 months preceding the spike)\ndef baseline_cv(region, pl, month):\n    g = df[(df.region == region) & (df.product_line == pl)].sort_values("month")\n    idx = list(g["month"]).index(month)\n    prev = g.iloc[max(0, idx - 24): idx]["units"]\n    return float(prev.std(ddof=1) / prev.mean()) if len(prev) >= 2 else np.nan\n\ntop3 = valid.sort_values("ratio", ascending=False).head(3).copy()\nsummary_rows = []\nfor _, r in top3.iterrows():\n    g = df[(df.region == r.region) & (df.product_line == r.product_line)].sort_values("month")\n    idx = list(g["month"]).index(r.month)\n    prev_ratio = g.iloc[idx - 1]["units"] / g.iloc[max(0, idx - 24): idx].mean() if idx >= 1 else np.nan\n    next_ratio = g.iloc[idx + 1]["units"] / g.iloc[idx + 1: idx + 25].mean() if idx + 1 < len(g) else np.nan\n    rr = r.returns / r.units\n    cv = baseline_cv(r.region, r.product_line, r.month)\n    # verdict heuristics (all from local data):\n    # stuffing signals: very high return rate, spike not followed by sustained level,\n    # sharp drop the next month, unstable baseline\n    stuffing = 0\n    if rr > 0.08:\n        stuffing += 2\n    elif rr > 0.05:\n        stuffing += 1\n    if next_ratio is not None and next_ratio < 0.9:\n        stuffing += 2\n    elif next_ratio is not None and next_ratio < 1.0:\n        stuffing += 1\n    if prev_ratio is not None and prev_ratio > 1.3:\n        stuffing += 1  # ramp-up before spike -> possible push\n    if cv is not None and cv > 0.25:\n        stuffing += 1\n    verdict = "渠道压货嫌疑较大" if stuffing >= 3 else ("真实需求可能性较大" if stuffing <= 1 else "介于两者之间，需进一步核实")\n    summary_rows.append({\n        "region": r.region, "product_line": r.product_line, "month": r.month,\n        "units": int(r.units), "mean24": round(r.mean24, 1), "ratio": round(r.ratio, 3),\n        "returns": int(r.returns), "return_rate": round(rr, 4),\n        "prev_month_ratio": round(prev_ratio, 3) if prev_ratio == prev_ratio else "",\n        "next_month_ratio": round(next_ratio, 3) if next_ratio == next_ratio else "",\n        "baseline_cv": round(cv, 3) if cv == cv else "",\n        "stuffing_score": stuffing, "verdict": verdict,\n    })\nsummary = pd.DataFrame(summary_rows)\nsummary.to_csv(SUMMARY_CSV, index=False, encoding="utf-8-sig")\nprint("Wrote", SUMMARY_CSV)\n\n# --- intermediate assessment md ------------------------------------------\nlines = ["# Anomaly Assessment (intermediate)", ""]\nfor s in summary_rows:\n    lines.append(f"## {s[\'region\']} / {s[\'product_line\']} @ {s[\'month\']}")\n    lines.append(f"- ratio={s[\'ratio\']}x, return_rate={s[\'return_rate\']:.2%}, "\n                 f"prev_ratio={s[\'prev_month_ratio\']}, next_ratio={s[\'next_month_ratio\']}, "\n                 f"baseline_cv={s[\'baseline_cv\']}, stuffing_score={s[\'stuffing_score\']}")\n    lines.append(f"- verdict: {s[\'verdict\']}")\n    lines.append("")\nwith open(ASSESS_MD, "w", encoding="utf-8") as f:\n    f.write("\\n".join(lines))\nprint("Wrote", ASSESS_MD)\n\n# --- final report ---------------------------------------------------------\nS = "offline_data/regional_sales.csv"\ndef src(col, agg):\n    return f"（来源：{S} 的 {col}，{agg}）"\n\nrep = []\nrep.append("# Volume Anomaly Analysis Report")\nrep.append("")\nrep.append("AS_OF: 2026-10-25 04:52（本地离线数据，数据窗口 "\n           f"{months[0]} 至 {months[-1]}，共 {n_months} 个月、{n_rows} 行明细；"\n           f"来源：{S} 的 month，按 month 去重计数）")\nrep.append("")\nrep.append("## 1. 分析背景与方法")\nrep.append("")\nrep.append(f"本报告基于本地文件 {S}（共 {n_rows} 行月度明细，"\n           f"覆盖 {months[0]} 至 {months[-1]} 共 {n_months} 个月，"\n           f"4 个区域 × 3 条产品线 = 12 个「区域×产品线」组合）"\n           f"{src(\'month\', \'按 month 去重计数，样本行数 \' + str(n_rows))}。"\n           "对每个「区域×产品线」组合，计算其每月销量（units）相对该组合自身前 24 个月"\n           "销量均值的倍数（rolling 24 期均值，min_periods=24），取倍数最大的前三个组合，"\n           "并结合当月退货率（returns/units）、前后月倍数与基线波动（前 24 个月 units 的变异系数）"\n           "判断放量更像真实需求还是渠道压货。全部结论仅来自该本地 CSV，未使用任何外部数据。")\nrep.append("")\nrep.append("## 2. 单月放量异常 Top 3")\nrep.append("")\nrep.append("| 排名 | 区域 | 产品线 | 月份 | 当月销量(units) | 自身24个月均值 | 倍数 | 当月退货率 | 判定 |")\nrep.append("|---|---|---|---|---|---|---|---|---|")\nfor i, s in enumerate(summary_rows, 1):\n    rep.append(f"| {i} | {s[\'region\']} | {s[\'product_line\']} | {s[\'month\']} | "\n               f"{s[\'units\']:,} {src(\'units\', f\'单行取值，region={s[\'region\']} & product_line={s[\'product_line\']} & month={s[\'month\']}，样本行数 1\')} | "\n               f"{s[\'mean24\']:,.1f} {src(\'units\', f\'该组合前24个月 units 的算术均值，样本行数 24\')} | "\n               f"{s[\'ratio\']:.3f}x（来源：由前述两行计算） | "\n               f"{s[\'return_rate\']:.2%} {src(\'returns/units\', f\'单行两列相除，样本行数 1\')} | "\n               f"{s[\'verdict\']} |")\nrep.append("")\nrep.append("## 3. 逐组合评估：真实需求 vs 渠道压货")\nfor i, s in enumerate(summary_rows, 1):\n    rep.append("")\n    rep.append(f"### 3.{i} {s[\'region\']} / {s[\'product_line\']}（{s[\'month\']}，{s[\'ratio\']:.3f}x）")\n    rep.append("")\n    rep.append(f"- 当月销量 {s[\'units\']:,} 件 {src(\'units\', f\'单行取值，样本行数 1\')}，"\n               f"自身 24 个月均值 {s[\'mean24\']:,.1f} 件 {src(\'units\', \'前24个月算术均值，样本行数 24\')}，"\n               f"倍数 {s[\'ratio\']:.3f}x（来源：由前述两行计算）。")\n    rep.append(f"- 当月退货率 {s[\'return_rate\']:.2%}"\n               f" {src(\'returns/units\', f\'returns={s[\\"returns\\"]} ÷ units={s[\\"units\\"]:,}，单行，样本行数 1\')}。")\n    rep.append(f"- 前一个月倍数 {s[\'prev_month_ratio\']}、后一个月倍数 {s[\'next_month_ratio\']}"\n               "（来源：由前述计算得出，口径同上：当月 units ÷ 自身前 24 个月 units 均值）。")\n    rep.append(f"- 基线稳定性：放量月前 24 个月 units 变异系数 CV={s[\'baseline_cv\']}"\n               f" {src(\'units\', \'放量月前24个月 units 的 标准差/均值，样本行数 24\')}。")\n    rep.append(f"- 判定：**{s[\'verdict\']}**（压货评分 {s[\'stuffing_score\']}，"\n               "评分规则：退货率>8% 计 2 分、5%~8% 计 1 分；次月倍数<0.9 计 2 分、0.9~1.0 计 1 分；"\n               "前月倍数>1.3 计 1 分；基线 CV>0.25 计 1 分；≥3 分判压货嫌疑较大，≤1 分判真实需求可能性较大）。")\nrep.append("")\nrep.append("## 4. 结论")\nrep.append("")\ntop = summary_rows[0]\nrep.append(f"在 {n_months} 个月、{n_rows} 行明细中，倍数最大的单月放量出现在 "\n           f"{top[\'region\']} 区 {top[\'product_line\']} 产品线 {top[\'month\']} 月，达自身 24 个月均值的 "\n           f"{top[\'ratio\']:.3f} 倍，当月退货率 {top[\'return_rate\']:.2%}，判定为{top[\'verdict\']}。"\n           "三个异常组合的判定均基于退货率水平、放量前后月份是否回落以及基线波动幅度三项本地证据："\n           "若放量伴随高退货率、次月销量迅速回落至均值以下，则更符合渠道压货特征；"\n           "若退货率维持低位且次月销量仍高于自身均值，则更像真实需求。"\n           "本报告全部结论仅由 offline_data/regional_sales.csv 推导得出，未引用任何外部信息。")\nrep.append("")\nwith open(REPORT_MD, "w", encoding="utf-8") as f:\n    f.write("\\n".join(rep))\nprint("Wrote", REPORT_MD)\nprint("DONE")\n'} with error:
