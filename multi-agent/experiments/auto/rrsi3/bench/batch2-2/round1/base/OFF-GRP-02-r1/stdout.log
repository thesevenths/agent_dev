import pandas as pd

df = pd.read_csv("offline_data/students.csv")

# 校验
assert set(['grade','region','reading_score']).issubset(df.columns)
assert df['grade'].isna().sum()==0 and df['region'].isna().sum()==0 and df['reading_score'].isna().sum()==0
assert set(df['grade'].unique())=={'G10','G11','G12'}
assert set(df['region'].unique())=={'A','B','C','D'}

# 交叉分组
g = df.groupby(['grade','region'], observed=True).agg(
    n=('reading_score','size'),
    mean_reading=('reading_score','mean')
).reset_index()
g = g.sort_values(['grade','region'])
print(g.to_string(index=False))
print("\n总行数:", len(df))
print("reading_score 总体均值:", df['reading_score'].mean())
print("最高均值组合:", g.loc[g['mean_reading'].idxmax()].to_dict())
print("最低均值组合:", g.loc[g['mean_reading'].idxmin()].to_dict())

# 保存校验结果供下游步骤使用
out = {
    "file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "columns": list(df.columns),
    "required_columns_present": True,
    "missing_values": {c: int(df[c].isna().sum()) for c in df.columns},
    "grade_values": sorted(df['grade'].unique().tolist()),
    "region_values": sorted(df['region'].unique().tolist()),
    "reading_score": {
        "dtype": "int64",
        "min": int(df['reading_score'].min()),
        "max": int(df['reading_score'].max()),
        "mean": float(df['reading_score'].mean()),
    },
    "cross_tab": g.to_dict(orient='records'),
}
