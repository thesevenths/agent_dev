import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
print(df.shape, df['month'].nunique(), df['region'].unique())

# per-region aggregates
g = df.groupby('region')['revenue'].sum()
total = g.sum()
months = df['month'].nunique()
agg = pd.DataFrame({'total_revenue': g})
agg['share'] = agg['total_revenue'] / total
agg['monthly_avg'] = agg['total_revenue'] / months
agg['rows'] = df.groupby('region').size()
print(agg)
print('grand total:', total, 'months:', months)

# peak month per region
pm = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak = pm.loc[pm.groupby('region')['revenue'].idxmax()]
print(peak)

