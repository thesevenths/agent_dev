import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
means = sub.groupby("group")[metrics].mean().round(6)
counts = sub.groupby("group").size()
print(means)
print(counts)

# per-week deltas
sub["d_retention_d7"] = sub["retention_d7"].diff()
sub["d_churn_rate"] = sub["churn_rate"].diff()
sub["d_arpu_usd"] = sub["arpu_usd"].diff()
print(sub[["week","retention_d7","churn_rate","arpu_usd","d_retention_d7","d_churn_rate","d_arpu_usd"]].to_string(index=False))

# group differences
g1 = means.loc["W30-W36"]; g2 = means.loc["W37-W43"]
diff = (g2 - g1).round(6)
pct = ((g2 - g1) / g1 * 100).round(4)
print("diff (g2-g1):\n", diff)
print("pct change:\n", pct)

