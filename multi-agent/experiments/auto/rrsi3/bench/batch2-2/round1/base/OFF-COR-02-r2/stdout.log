  "groups": {}
}
for name, row in g.iterrows():
    out["groups"][name] = {
        "n": int(row["n"]),
        "screen_hours_per_day_mean": float(row["screen_mean"]),
        "math_score_mean": float(row["math_mean"]),
        "reading_score_mean": float(row["reading_mean"]),
    }
hi = out["groups"]["high(>5)"]; lo = out["groups"]["low(<=5)"]
