import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-COR-02-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
out = {}
for x,y in pairs:
    sub = df[[x,y]].dropna()
    r = sub[x].corr(sub[y], method="pearson")
    out[f"{x}_vs_{y}"] = {"pearson_r": r, "n": len(sub)}
    print(x, y, "r =", r, "n =", len(sub))

# also spearman for reference
for x,y in pairs:
    rs = df[x].corr(df[y], method="spearman")
    print("spearman", x, y, rs)

out["data_file"] = "offline_data/students.csv"
out["file_mtime"] = "2026-10-23 10:11"
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-COR-02-r2\_sandbox\tmp\step2_correlations.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

