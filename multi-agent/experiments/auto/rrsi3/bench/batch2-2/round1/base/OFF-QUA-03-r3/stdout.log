if \"sales\" in cl or \"qty\" in cl or \"volume\" in cl or \"units\" in cl or \"销量\" in c:\n        sales_col = c\n        break\nret_col = None\nfor c in df.columns:\n    cl = c.lower()\n    if \"return\" in cl or \"退货\" in c:\n        ret_col = c\n        break\nregion_col = None\nfor c in df.columns:\n    cl = c.lower()\n    if \"region\" in cl or \"area\" in cl or \"区域\" in c:\n        region_col = c\n        break\npline_col = None\nfor c in df.columns:\n    cl = c.lower()\n    if \"product\" in cl or \"line\" in cl or \"产品线\" in c:\n        pline_col = c\n        break\nprint(\"SALES COL:\", sales_col, \"| RETURN COL:\", ret_col,\n      \"| REGION COL:\", region_col, \"| PRODUCT COL:\", pline_col)\n\nprint(\"MONTH MIN:\", df[month_col].min(), \"| MONTH MAX:\", df[month_col].max())\nprint(\"UNIQUE REGIONS:\", sorted(df[region_col].unique().tolist()))\nprint(\"UNIQUE PRODUCT LINES:\", sorted(df[pline_col].unique().tolist()))\nprint(\"=== FIRST 5 ROWS ===\")\nprint(df.head(5).to_string())\n\n# ---- (c)(d) rolling 24-month mean & ratio ----\ndf = df.sort_values([region_col, pline_col, month_col])\ndf[\"mean24\"] = (\n    df.groupby([region_col, pline_col])[sales_col]\n    .transform(lambda s: s.rolling(24, min_periods=24).mean())\n)\ndf[\"ratio\"] = df[sales_col] / df[\"mean24\"]\n\n# ---- (e)(f) top-3 by ratio ----\ntop3 = df.dropna(subset=[\"ratio\"]).nlargest(3, \"ratio\")\ncols = [region_col, pline_col, month_col, sales_col, \"mean24\", \"ratio\"]\nif ret_col:\n    cols.append(ret_col)\ntop3_out = top3[cols].copy()\ntop3_out[\"ratio\"] = top3_out[\"ratio\"].round(4)\ntop3_out[\"mean24\"] = top3_out[\"mean24\"].round(4)\n\nos.makedirs(OUT_DIR, exist_ok=True)\ntop3_out.to_csv(OUT, index=False, encoding=\"utf-8-sig\")\n\nprint(\"=== TOP-3 ANOMALIES (region x product_line x month by ratio) ===\")\nprint(top3_out.to_string(index=False))\nprint(\"ARTIFACT SAVED TO:\", OUT)\n====TOP3==== \n﻿region,product_line,month,units,mean24,ratio,returns\nE,Service,2025-12,3654,