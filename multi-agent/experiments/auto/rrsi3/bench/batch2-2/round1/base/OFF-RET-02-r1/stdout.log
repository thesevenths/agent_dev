base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r1\_sandbox"
out = os.path.join(base, "tmp", "retention_breakpoint_report.md")

rows = []
with open(os.path.join(base, "tmp", "step2_group_means.csv"), encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if line.startswith("#"):
            break
        if line:
            rows.append(line)
per = pd.read_csv(pd.io.common.StringIO("\n".join(rows)))
s3 = pd.read_csv(os.path.join(base, "tmp", "step3_breakpoint_summary.csv"))

a = per[per.group == "A"]
b = per[per.group == "B"]
am = a[["retention_d7","churn_rate","arpu_usd"]].mean()
bm = b[["retention_d7","churn_rate","arpu_usd"]].mean()

# per-week table
lines = []
lines.append("# W30–W43 留存断点分析报告（retention_d7 / churn_rate / arpu_usd）\n")
lines.append("AS_OF: 2026-10-25 05:49（本地离线数据，无实时性要求）\n")
lines.append("## 1. 分析背景\n")
lines.append("本报告基于本地文件 `offline_data/app_metrics.csv`（60 行 × 7 列，无缺失值），"
             "对 W30–W43 共 14 个连续周的数据进行断点定位分析，比较 W30–W36（组 A）与 W37–W43（组 B）"
             "在 `retention_d7`、`churn_rate`、`arpu_usd` 三个指标上的均值差异，并量化断点前后的制度性变化（regime shift）。\n")
lines.append("## 2. 逐周数据明细（W30–W43）\n")
lines.append("| 周 | 组 | retention_d7 | churn_rate | arpu_usd |")
lines.append("|---|---|---|---|---|")
for _, r in per.iterrows():
    lines.append(f"| {r.week} | {r.group} | {r.retention_d7:.4f} | {r.churn_rate:.4f} | {r.arpu_usd:.3f} |")
lines.append("")
lines.append("（来源：offline_data/app_metrics.csv 的 retention_d7、churn_rate、arpu_usd，逐行原值，样本行数 14）\n")

lines.append("## 3. 分组均值对比（W30–W36 vs W37–W43）\n")
lines.append("| 指标 | 组 A 均值 (W30–W36) | 组 B 均值 (W37–W43) | 绝对差异 (B−A) | 相对变化 (B−A)/A |")
lines.append("|---|---|---|---|---|")
for m in ["retention_d7","churn_rate","arpu_usd"]:
    diff = bm[m]-am[m]
    rel = diff/am[m]*100
    lines.append(f"| {m} | {am[m]:.6f} | {bm[m]:.6f} | {diff:+.6f} | {rel:+.2f}% |")
lines.append("")
lines.append("（来源：offline_data/app_metrics.csv 的 retention_d7、churn_rate、arpu_usd，W30–W36 均值，样本行数 7；"
             "offline_data/app_metrics.csv 的 retention_d7、churn_rate、arpu_usd，W37–W43 均值，样本行数 7；"
             "绝对差异与相对变化（来源：由前述两行计算））\n")

lines.append("## 4. 断点定位\n")
lines.append("按相邻周最大单周变动定位各指标断点周：\n")
lines.append("| 指标 | 断点周 | 说明 |")
lines.append("|---|---|---|")
for _, r in s3.iterrows():
    lines.append(f"| {r.metric} | {r.breakpoint_week} | 相邻周最大单周变动所在周 |")
lines.append("")
lines.append("（来源：offline_data/app_metrics.csv 的 retention_d7、churn_rate、arpu_usd，相邻周差值，样本行数 14；断点周判定（来源：由前述两行计算））\n")

lines.append("## 5. 结论\n")
lines.append("综合三个指标的断点周与分组均值差异，**留存断点出现在 W36 → W37 之间**，即 W37 起进入新的劣化区间。"
             "具体表现为：W37 起 `retention_d7` 由 0.4037 降至 0.3831，`churn_rate` 由 0.1909 跳升至 0.2378，"
             "`arpu_usd` 由 5.061 降至 4.406（来源：offline_data/app_metrics.csv 的 retention_d7、churn_rate、arpu_usd，逐行原值，样本行数 14）。"
             "从分组均值看，W37–W43 相对 W30–W36：`retention_d7` 下降 12.54%（−0.051471），"
             "`churn_rate` 上升 42.75%（+0.072529），`arpu_usd` 下降 4.87%（−0.231）"
             "（来源：由前述两行计算）。"
             "其中 `churn_rate` 的相对变化幅度最大（+42.75%），是本次断点最显著的信号；"
             "`retention_d7` 与 `arpu_usd` 同步下行，表明 W37 起用户留存与变现能力同时承压，"
             "建议将 W37 作为根因排查（版本发布、运营策略、渠道结构变化等）的时间锚点。\n")

with open(out, "w", encoding="utf-8") as f:
    f.write("\n".join(lines))

print("saved:", out, os.path.getsize(out), "bytes")

```
