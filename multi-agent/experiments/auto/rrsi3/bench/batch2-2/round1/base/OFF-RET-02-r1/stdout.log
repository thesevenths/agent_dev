import pandas as pd

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r1\_sandbox\tmp\step2_group_means.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r1\_sandbox\tmp\step3_breakpoint_summary.csv"

# read per-week section (stop at comment line)
rows = []
with open(p, encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if line.startswith("#") or not line:
            break
        rows.append(line)
per = pd.read_csv(pd.io.common.StringIO("\n".join(rows)))
print(per.to_string(index=False))

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
# adjacent-week changes: week i -> i+1
per["next_week"] = per.week.shift(-1)
breakpoints = {}
for m in metrics:
    d = per[m].diff()
    # largest single-week drop (most negative) for retention/arpu; for churn largest jump (most positive)
    if m == "churn_rate":
        idx = d.idxmax()
    else:
        idx = d.idxmin()
    breakpoints[m] = (per.loc[idx, "next_week"], d.loc[idx])
    print(m, "largest single-week shift at", per.loc[idx, "next_week"], "=", round(d.loc[idx], 6))

# group means
a = per[per.group == "A"][metrics].mean()
b = per[per.group == "B"][metrics].mean()
print("\nA:", a.to_dict())
print("B:", b.to_dict())

# consensus breakpoint week
from collections import Counter
c = Counter(v[0] for v in breakpoints.values())
print("breakpoint votes:", c)

summary = pd.DataFrame({
    "metric": metrics,
    "group_A_mean": [round(a[m], 6) for m in metrics],
    "group_B_mean": [round(b[m], 6) for m in metrics],
    "abs_diff": [round(b[m]-a[m], 6) for m in metrics],
    "rel_diff_pct": [round((b[m]-a[m])/a[m]*100, 2) for m in metrics],
    "breakpoint_week": [breakpoints[m][0] for m in metrics],
})
summary.to_csv(out, index=False)
print("\n", summary.to_string(index=False))

