import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r1\_sandbox\tmp\app_metrics_w30_w43.csv"
df = pd.read_csv(src)

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
df["group"] = df["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

wow = {m: df.set_index("week")[m].diff() for m in metrics}
wow_df = pd.DataFrame(wow)
wow_df["week"] = df["week"].values
wow_df = wow_df[["week"] + metrics]

rel = wow_df.set_index("week").div(df.set_index("week")[metrics])
print("WoW absolute:")
print(wow_df.to_string(index=False))
print("\nWoW relative:")
print(rel.to_string())

g = df.groupby("group")[metrics].mean()
print("\nGroup means:")
print(g)

diff = g.loc["W37-W43"] - g.loc["W30-W36"]
rel_diff = diff / g.loc["W30-W36"]
summary = pd.DataFrame({"W30-W36_mean": g.loc["W30-W36"], "W37-W43_mean": g.loc["W37-W43"],
                        "abs_diff": diff, "rel_diff": rel_diff})
print("\nSummary:")
print(summary)

# breakpoint: largest |relative WoW| across all three metrics
rel.index = rel.index.astype(str)
score = rel.abs().max(axis=1)
print("\nBreakpoint score (max |rel WoW| across metrics):")
print(score.sort_values(ascending=False).head(5))
bp = score.idxmax()
print("breakpoint week:", bp)

