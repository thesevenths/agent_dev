import pandas as pd

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r1\_sandbox\tmp\step2_group_means.csv"

df = pd.read_csv(p)
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
assert len(sub) == 14, len(sub)

sub["group"] = sub.week.apply(lambda w: "A" if w <= "W36" else "B")
cols = ["week", "group", "retention_d7", "churn_rate", "arpu_usd"]
per_week = sub[cols]

means = sub.groupby("group")[["retention_d7", "churn_rate", "arpu_usd"]].mean().reset_index()
means.columns = ["group", "mean_retention_d7", "mean_churn_rate", "mean_arpu_usd"]
means["n_rows"] = sub.groupby("group").size().values
means["group"] = means["group"].map({"A": "A (W30-W36)", "B": "B (W37-W43)"})

# write per-week rows then summary rows to one CSV
with open(out, "w", encoding="utf-8") as f:
    per_week.to_csv(f, index=False)
    f.write("\n# SUMMARY: group means\n")
    means.to_csv(f, index=False)

print(per_week.to_string(index=False))
print()
print(means.to_string(index=False))

# also print diffs for downstream
a = sub[sub.group=="A"][["retention_d7","churn_rate","arpu_usd"]].mean()
b = sub[sub.group=="B"][["retention_d7","churn_rate","arpu_usd"]].mean()
print("\nDiff (B - A):")
print((b-a).to_string())
print("\nRel change (B-A)/A:")
print(((b-a)/a*100).round(2).to_string())

