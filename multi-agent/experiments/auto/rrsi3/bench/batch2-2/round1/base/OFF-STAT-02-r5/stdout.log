import pandas as pd, json

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-STAT-02-r5\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-STAT-02-r5\_sandbox\tmp"

df = pd.read_csv(csv_path)
m, r = df['math_score'], df['reading_score']
n = len(df)

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "n_valid_math": int(m.notna().sum()),
    "n_valid_reading": int(r.notna().sum()),
    "math_score": {
        "mean": float(m.mean()),
        "std_sample": float(m.std(ddof=1)),
        "std_population": float(m.std(ddof=0)),
        "median": float(m.median()),
        "min": int(m.min()), "max": int(m.max()),
        "cv_sample": float(m.std(ddof=1)/m.mean()),
        "cv_population": float(m.std(ddof=0)/m.mean()),
    },
    "reading_score": {
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_population": float(r.std(ddof=0)),
        "median": float(r.median()),
        "min": int(r.min()), "max": int(r.max()),
        "cv_sample": float(r.std(ddof=1)/r.mean()),
        "cv_population": float(r.std(ddof=0)/r.mean()),
    },
    "pearson_corr": float(m.corr(r, method='pearson')),
}
out = os.path.join(out_dir, "stats_results.json")
import os
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
