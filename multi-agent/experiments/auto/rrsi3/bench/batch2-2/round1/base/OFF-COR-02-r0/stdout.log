import pandas as pd, json
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(p)
n = len(df)
r_math = df.screen_hours_per_day.corr(df.math_score, method="pearson")
r_read = df.screen_hours_per_day.corr(df.reading_score, method="pearson")
# significance: t = r*sqrt((n-2)/(1-r^2))
import math
def pval(r, n):
    t = r*math.sqrt((n-2)/(1-r*r))
    return t
t_math = pval(r_math, n); t_read = pval(r_read, n)
out = {
  "as_of": "2026-10-25 04:27",
  "source_file": "offline_data/students.csv",
  "n": n,
  "method": "pearson",
  "screen_hours_per_day_vs_math_score": {"r": round(r_math,6), "t": round(t_math,4)},
  "screen_hours_per_day_vs_reading_score": {"r": round(r_read,6), "t": round(t_read,4)},
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json","w",encoding="utf-8") as f:
