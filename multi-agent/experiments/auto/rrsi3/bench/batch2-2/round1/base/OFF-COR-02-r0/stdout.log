```python
import pandas as pd, os, json
from scipy import stats

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-COR-02-r0\_sandbox"
path = os.path.join(base, "offline_data", "students.csv")
out_dir = os.path.join(base, "tmp")

df = pd.read_csv(path)
df["group"] = df["screen_hours_per_day"].apply(lambda x: "gt5" if x > 5 else "le5")

rows = []
for g in ["gt5", "le5"]:
    sub = df[df["group"] == g]
    rows.append({
        "group": g,
        "n": len(sub),
        "screen_hours_mean": sub["screen_hours_per_day"].mean(),
        "math_score_mean": sub["math_score"].mean(),
        "math_score_std": sub["math_score"].std(ddof=1),
        "reading_score_mean": sub["reading_score"].mean(),
        "reading_score_std": sub["reading_score"].std(ddof=1),
    })

g5 = df[df["group"]=="gt5"]; le5 = df[df["group"]=="le5"]
diff_math = g5["math_score"].mean() - le5["math_score"].mean()
diff_read = g5["reading_score"].mean() - le5["reading_score"].mean()

# t-tests for context
t_math, p_math = stats.ttest_ind(g5["math_score"], le5["math_score"])
t_read, p_read = stats.ttest_ind(g5["reading_score"], le5["reading_score"])

out = {
    "source": "offline_data/students.csv",
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "groups": rows,
    "mean_difference_gt5_minus_le5": {
        "math_score": diff_math, "reading_score": diff_read,
        "ttest_math": {"t": t_math, "p": p_math},
        "ttest_reading": {"t": t_read, "p": p_read},
    },
}
json_out = os.path.join(out_dir, "step3_group_stats.json")
with open(json_out, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

csv_rows = rows + [
    {"group": "diff_gt5_minus_le5", "n": None,
     "math_score_mean": diff_math, "reading_score_mean": diff_read},
]
csv_out = os.path.join(out_dir, "step3_group_stats.csv")
pd.DataFrame(csv_rows).to_csv(csv_out, index=False)

print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", json_out, csv_out)

```
