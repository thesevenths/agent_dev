```python
import pandas as pd, os, json
from scipy import stats

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-COR-02-r0\_sandbox"
path = os.path.join(base, "offline_data", "students.csv")
out_dir = os.path.join(base, "tmp")

df = pd.read_csv(path)
n = len(df)

res = {}
for col in ["math_score", "reading_score"]:
    r, p = stats.pearsonr(df["screen_hours_per_day"], df[col])
    res[col] = {"pearson_r": r, "p_value": p, "n": n}

# also spearman for robustness
for col in ["math_score", "reading_score"]:
    rho, p = stats.spearmanr(df["screen_hours_per_day"], df[col])
    res[col]["spearman_rho"] = rho
    res[col]["spearman_p"] = p

out = os.path.join(out_dir, "step2_correlations.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump({"source": "offline_data/students.csv", "n": n, "results": res}, f, ensure_ascii=False, indent=2)

# also a small CSV
rows = [{"pair": f"screen_hours_per_day vs {c}", "pearson_r": res[c]["pearson_r"],
         "p_value": res[c]["p_value"], "spearman_rho": res[c]["spearman_rho"],
         "spearman_p": res[c]["spearman_p"], "n": n} for c in ["math_score","reading_score"]]
csv_out = os.path.join(out_dir, "step2_correlations.csv")
pd.DataFrame(rows).to_csv(csv_out, index=False)

print(json.dumps(res, indent=2))
print("saved:", out, csv_out)

```
