import pandas as pd

path = "offline_data/regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-03-r5\_sandbox\tmp"

df = pd.read_csv(path)

# Per-region aggregates
g = df.groupby("region")["revenue"].agg(total="sum", n_rows="count")
g["n_months"] = df.groupby("region")["month"].nunique().first()
g["monthly_avg"] = g["total"] / g["n_months"]
grand = df["revenue"].sum()
g["share_pct"] = g["total"] / grand * 100
g = g.sort_values("total", ascending=False)
print(g)
print("grand total:", grand, "rows:", len(df))

# Peak month per region
pm = df.groupby(["region", "month"])["revenue"].sum().reset_index()
peak = pm.loc[pm.groupby("region")["revenue"].idxmax()]
print(peak)

# Overall top region & its peak month
top_region = g.index[0]
top_peak = peak[peak["region"] == top_region].iloc[0]
print("TOP:", top_region, top_peak["month"], top_peak["revenue"])

# Save intermediate CSV
g.round(2).to_csv(f"{out_dir}\\step2_regional_aggregates.csv", index_label="region")
peak.round(2).to_csv(f"{out_dir}\\step2_peak_months.csv", index=False)

# Also save a small summary json for step 3
import json
summary = {
    "grand_total": round(float(grand), 2),
    "n_rows": int(len(df)),
    "n_months": int(df["month"].nunique()),
    "regions": {r: {"total": round(float(v["total"]),2), "share_pct": round(float(v["share_pct"]),2),
                    "monthly_avg": round(float(v["monthly_avg"]),2), "n_rows": int(v["n_rows"]),
                    "n_months": int(v["n_months"])} for r, v in g.iterrows()},
    "peak_months": {r: {"month": m, "revenue": round(float(v),2)} for r, m, v in
                    zip(peak["region"], peak["month"], peak["revenue"])},
    "top_region": top_region,
    "top_region_peak_month": top_peak["month"],
    "top_region_peak_revenue": round(float(top_peak["revenue"]),2),
}
with open(f"{out_dir}\\step2_summary.json", "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("saved")

