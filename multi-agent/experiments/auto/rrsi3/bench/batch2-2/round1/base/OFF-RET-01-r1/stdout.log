import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
n = len(r)
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
thr = overall_mean - 2*overall_std
below = (r < thr).sum()
below_weeks = df.loc[r < thr, "week"].tolist()

res = {
  "source": "offline_data/app_metrics.csv",
  "column": "retention_d7",
  "n_total": n,
  "first30": {"weeks": "W01-W30", "mean": first.mean(), "std": first.std(ddof=1), "n": len(first)},
  "last30": {"weeks": "W31-W60", "mean": last.mean(), "std": last.std(ddof=1), "n": len(last)},
  "diff_mean": last.mean() - first.mean(),
  "diff_std": last.std(ddof=1) - first.std(ddof=1),
  "overall_mean": overall_mean,
  "overall_std": overall_std,
  "threshold": thr,
  "weeks_below_threshold": int(below),
  "weeks_below_list": below_weeks,
  "min": r.min(), "max": r.max(),
  "min_week": df.loc[r.idxmin(), "week"], "max_week": df.loc[r.idxmax(), "week"],
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-01-r1\_sandbox\tmp"
os.makedirs(out, exist_ok=True)
path = os.path.join(out, "retention_d7_stats.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", path)

```
