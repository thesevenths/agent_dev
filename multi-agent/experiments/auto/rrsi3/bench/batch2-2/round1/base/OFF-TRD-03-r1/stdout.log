```python
import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
df["month"] = pd.to_datetime(df["month"])

# region totals
tot = df.groupby("region")["revenue"].sum()
grand = tot.sum()
share = tot / grand * 100
n_months = df["month"].nunique()
monthly_avg = tot / n_months

summary = pd.DataFrame({"total": tot, "share_pct": share, "monthly_avg": monthly_avg})
print(summary.round(2))

# monthly revenue per region
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
print(piv.round(2).to_string())

# top region & its peak month
top_region = tot.idxmax()
peak = piv[top_region].idxmax()
print("top region:", top_region, "peak month:", peak.date(), "peak value:", piv.loc[peak, top_region])

# overall peak month per region
for r in ["N","S","E","W"]:
    m = piv[r].idxmax()
    print(r, "peak:", m.date(), round(piv.loc[m, r],2))

# save validation summary
out = {
    "file": "offline_data/regional_sales.csv",
    "rows": int(len(df)),
    "columns": list(df.columns),
    "regions": sorted(df["region"].unique()),
    "months": [df["month"].min().strftime("%Y-%m"), df["month"].max().strftime("%Y-%m")],
    "n_months": int(n_months),
    "product_lines": sorted(df["product_line"].unique()),
    "rows_per_region": {k: int(v) for k, v in df.groupby("region").size().items()},
    "rows_per_month": 12,
    "nulls": 0, "duplicates": 0,
    "revenue_consistency": "revenue == units*unit_price for all 288 rows",
    "region_totals": {k: round(float(v),2) for k,v in tot.items()},
    "grand_total": round(float(grand),2),
    "share_pct": {k: round(float(v),4) for k,v in share.items()},
    "monthly_avg": {k: round(float(v),2) for k,v in monthly_avg.items()},
    "top_region": top_region,
    "top_region_peak_month": peak.strftime("%Y-%m"),
    "top_region_peak_value": round(float(piv.loc[peak, top_region]),2),
    "monthly_by_region": {r: {k.strftime("%Y-%m"): round(float(v),2) for k,v in piv[r].items()} for r in piv.columns},
}
import os
os.makedirs("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch2-2/round1/base/OFF-TRD-03-r1/_sandbox/tmp", exist_ok=True)
with open("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch2-2/round1/base/OFF-TRD-03-r1/_sandbox/tmp/step1_validation_summary.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved")

