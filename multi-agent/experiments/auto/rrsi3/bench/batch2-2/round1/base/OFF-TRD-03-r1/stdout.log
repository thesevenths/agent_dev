```python
import pandas as pd, json

df = pd.read_csv('offline_data/regional_sales.csv')
total_all = df['revenue'].sum()

reg = df.groupby('region')['revenue'].agg(['sum','count'])
reg['share'] = reg['sum'] / total_all
reg['monthly_avg'] = reg['sum'] / 24

monthly = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak = monthly.loc[monthly.groupby('region')['revenue'].idxmax()]

result = {
    "as_of": "2026-10-26 02:19",
    "source": "offline_data/regional_sales.csv",
    "total_revenue_all_regions": round(total_all, 2),
    "months": 24,
    "regions": {}
}
for r in ['N','S','E','W']:
    row = reg.loc[r]
    pk = peak[peak['region']==r].iloc[0]
    result["regions"][r] = {
        "total_revenue": round(row['sum'],2),
        "rows": int(row['count']),
        "share": round(row['share'],6),
        "monthly_avg": round(row['monthly_avg'],2),
        "peak_month": pk['month'],
        "peak_month_revenue": round(pk['revenue'],2),
    }
top = max(result["regions"], key=lambda k: result["regions"][k]["total_revenue"])
result["top_region"] = top
result["top_region_peak_month"] = result["regions"][top]["peak_month"]

out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-03-r1\_sandbox\tmp\regional_aggregates.json'
with open(out,'w',encoding='utf-8') as f:
    json.dump(result,f,ensure_ascii=False,indent=2)
print(json.dumps(result,ensure_ascii=False,indent=2))
print('saved:', out)

```
