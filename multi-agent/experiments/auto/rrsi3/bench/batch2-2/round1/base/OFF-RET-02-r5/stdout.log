import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
sub = df[(df['week'] >= 'W30') & (df['week'] <= 'W43')].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if w <= 'W36' else 'W37-W43')

g = sub.groupby('group')[metrics].mean().round(6)
print(g)
before = g.loc['W30-W36']; after = g.loc['W37-W43']
print((after - before).round(6))
print(((after - before) / before * 100).round(4))

sub2 = sub.sort_values('week').reset_index(drop=True)
sub2['wow_ret'] = sub2['retention_d7'].diff().round(6)
sub2['wow_churn'] = sub2['churn_rate'].diff().round(6)
sub2['wow_arpu'] = sub2['arpu_usd'].diff().round(6)
print(sub2[['week','retention_d7','churn_rate','arpu_usd','wow_ret','wow_churn','wow_arpu']].to_string())

# ---- save intermediate CSV (single file, sections separated) ----
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r5\_sandbox\tmp\step2_group_means_breakpoint.csv"

weekly = sub2[['week','group','retention_d7','churn_rate','arpu_usd','wow_ret','wow_churn','wow_arpu']].copy()
weekly.to_csv(out, index=False, mode='w')

with open(out, 'a', encoding='utf-8') as f:
    f.write("\n# group_means\n")
    g.reset_index().to_csv(f, index=False)
    f.write("\n# diff_after_minus_before\n")
    pd.DataFrame({'diff': (after - before).round(6), 'rel_change_pct': ((after - before)/before*100).round(4)}).to_csv(f, index=False)

print("saved:", out)

