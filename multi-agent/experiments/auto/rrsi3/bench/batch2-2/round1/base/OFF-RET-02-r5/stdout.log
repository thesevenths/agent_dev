import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
w = df[df['week'].isin([f"W{i:02d}" for i in range(30, 44)])].copy()

pre = w[w['week'].isin([f"W{i:02d}" for i in range(30, 37)])]
post = w[w['week'].isin([f"W{i:02d}" for i in range(37, 44)])]

for col in ['retention_d7','churn_rate','arpu_usd']:
    a, b = pre[col].mean(), post[col].mean()
    print(f"{col}: pre={a:.6f} post={b:.6f} diff={b-a:+.6f} rel={(b-a)/a*100:+.2f}%")

print("\npre n =", len(pre), "post n =", len(post))
print("pre weeks:", list(pre['week']))
print("post weeks:", list(post['week']))

# W36 -> W37 single-step deltas
r36, r37 = w[w['week']=='W36'].iloc[0], w[w['week']=='W37'].iloc[0]
for col in ['retention_d7','churn_rate','arpu_usd']:
    print(f"W36->W37 {col}: {r36[col]:.4f} -> {r37[col]:.4f}  delta={r37[col]-r36[col]:+.4f}")

# max |delta| within pre window (W30-W36) for context
pre2 = pre.copy()
for col in ['retention_d7','churn_rate','arpu_usd']:
    d = pre2[col].diff().dropna()
    print(f"pre-window max |delta| {col}: {d.abs().max():.4f} at {d.abs().idxmax()}")

