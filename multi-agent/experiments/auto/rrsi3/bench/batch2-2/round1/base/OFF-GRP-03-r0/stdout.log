```python
import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
print("nulls:", df[['study_hours_per_week','math_score']].isna().sum().to_dict())
print("study_hours range:", df.study_hours_per_week.min(), df.study_hours_per_week.max())
print("boundary values:", sorted(df.study_hours_per_week.unique())[:10], "...")
print("values near 2.5/4.5:", df.study_hours_per_week.isin([2.5,4.5]).sum())

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df['group'] = df.study_hours_per_week.map(grp)
res = df.groupby('group').agg(n=('math_score','size'), mean_math=('math_score','mean'),
                              min_math=('math_score','min'), max_math=('math_score','max'),
                              std_math=('math_score','std'),
                              min_h=('study_hours_per_week','min'), max_h=('study_hours_per_week','max'))
print(res)
gain = res.loc['high','mean_math'] - res.loc['low','mean_math']
print("gain:", gain, "pct:", gain/res.loc['low','mean_math']*100)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-03-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
res.to_csv(os.path.join(out_dir, "group_stats.csv"))
summary = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "rows_used": int(len(df)),
  "nulls_excluded": 0,
  "groups": {g: {"n": int(r.n), "mean_math_score": round(r.mean_math,4),
                 "min_math_score": int(r.min_math), "max_math_score": int(r.max_math),
                 "std_math_score": round(r.std_math,4),
                 "min_study_hours": float(r.min_h), "max_study_hours": float(r.max_h)}
             for g, r in res.iterrows()},
  "low_to_high_gain": round(gain,4),
  "low_to_high_gain_pct": round(gain/res.loc['low','mean_math']*100,4),
  "as_of": "2026-10-26 00:52",
}
with open(os.path.join(out_dir,"group_stats.json"),"w",encoding="utf-8") as f:
    json.dump(summary,f,ensure_ascii=False,indent=2)
print("saved to", out_dir)

