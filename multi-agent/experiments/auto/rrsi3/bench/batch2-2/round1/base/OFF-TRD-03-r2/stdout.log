import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].nunique(), df['month'].min(), "->", df['month'].max())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dupes (month,region,product_line):", df.duplicated(subset=['month','region','product_line']).sum())
print("revenue negative/zero:", (df['revenue']<=0).sum())
print("revenue == units*unit_price (approx):", ((df['units']*df['unit_price'] - df['revenue']).abs() < 0.01).all())

# per region-month rows
print("rows per region:", df.groupby('region').size().to_dict())
print("rows per region-month:", df.groupby(['region','month']).size().unique())

out = {
  "file": os.path.abspath(path),
  "shape": list(df.shape),
  "columns": list(df.columns),
  "regions": sorted(df['region'].unique()),
  "n_months": int(df['month'].nunique()),
  "month_range": [df['month'].min(), df['month'].max()],
  "product_lines": sorted(df['product_line'].unique()),
  "null_cells": int(df.isna().sum().sum()),
  "duplicate_keys": int(df.duplicated(subset=['month','region','product_line']).sum()),
  "nonpositive_revenue": int((df['revenue']<=0).sum()),
  "revenue_equals_units_x_price": bool(((df['units']*df['unit_price'] - df['revenue']).abs() < 0.01).all()),
  "rows_per_region": df.groupby('region').size().to_dict(),
  "rows_per_region_month": int(df.groupby(['region','month']).size().unique()[0]),
  "total_revenue": float(df['revenue'].sum()),
}
os.makedirs("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch2-2/round1/base/OFF-TRD-03-r2/_sandbox/tmp", exist_ok=True)
with open("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch2-2/round1/base/OFF-TRD-03-r2/_sandbox/tmp/step1_validation.json","w") as f:
