import pandas as pd, json, os

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-03-r2\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-03-r2\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv)
n_months = df['month'].nunique()  # 24

# per-region aggregates
g = df.groupby('region')['revenue'].agg(total='sum', rows='count').reset_index()
grand = df['revenue'].sum()
g['share'] = g['total'] / grand
g['monthly_avg'] = g['total'] / n_months
g = g.sort_values('total', ascending=False).reset_index(drop=True)

# per-region monthly totals
rm = df.groupby(['region','month'])['revenue'].sum().reset_index()
top = g.iloc[0]
top_region = top['region']
peak = rm[rm['region']==top_region].sort_values('revenue', ascending=False).iloc[0]

# top-3 months for top region (context)
top3 = rm[rm['region']==top_region].sort_values('revenue', ascending=False).head(3)

# overall monthly totals (for context)
om = df.groupby('month')['revenue'].sum().reset_index().sort_values('revenue', ascending=False)

agg_out = {
  "source_csv": csv,
  "n_months": int(n_months),
  "grand_total_revenue": round(float(grand), 2),
  "regions": [
    {"region": r.region, "total_revenue": round(float(r.total),2),
     "share_of_grand": round(float(r.share),6),
     "monthly_avg_revenue": round(float(r.monthly_avg),2),
     "rows_used": int(r.rows)}
    for r in g.itertuples()
  ],
  "top_region": top_region,
  "top_region_peak_month": {"month": peak['month'], "revenue": round(float(peak['revenue']),2)},
  "top_region_top3_months": [{"month": r.month, "revenue": round(float(r.revenue),2)} for r in top3.itertuples()],
  "overall_top3_months": [{"month": r.month, "revenue": round(float(r.revenue),2)} for r in om.head(3).itertuples()],
}
with open(os.path.join(out_dir, "step2_regional_aggregates.json"), "w", encoding="utf-8") as f:
    json.dump(agg_out, f, indent=2, ensure_ascii=False)

# also save a CSV artifact
g.to_csv(os.path.join(out_dir, "step2_regional_aggregates.csv"), index=False, float_format="%.2f")
rm.to_csv(os.path.join(out_dir, "step2_region_month_revenue.csv"), index=False, float_format="%.2f")

print(json.dumps(agg_out, indent=2, ensure_ascii=False))
print("\n--- region-month table (top region) ---")
print(rm[rm['region']==top_region].to_string(index=False))

```
