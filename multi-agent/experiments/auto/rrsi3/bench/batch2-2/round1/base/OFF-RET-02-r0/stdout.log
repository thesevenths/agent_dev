```python
import pandas as pd

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_group_means.csv"

df = pd.read_csv(csv)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

perweek = sub[["week", "group"] + metrics].copy()
perweek["wow_ret"] = perweek["retention_d7"].diff()
perweek["wow_churn"] = perweek["churn_rate"].diff()
perweek["wow_arpu"] = perweek["arpu_usd"].diff()

means = sub.groupby("group")[metrics].mean().reset_index()
means.columns = ["group"] + [f"mean_{c}" for c in metrics]
m1 = means[means["group"] == "W30-W36"].iloc[0]
m2 = means[means["group"] == "W37-W43"].iloc[0]

diff = pd.DataFrame({
    "metric": metrics,
    "W30-W36_mean": [round(m1[f"mean_{c}"], 6) for c in metrics],
    "W37-W43_mean": [round(m2[f"mean_{c}"], 6) for c in metrics],
    "abs_diff_after_minus_before": [round(m2[f"mean_{c}"] - m1[f"mean_{c}"], 6) for c in metrics],
    "rel_diff_pct": [round((m2[f"mean_{c}"] - m1[f"mean_{c}"]) / m1[f"mean_{c}"] * 100, 4) for c in metrics],
})

# breakpoint: week with largest combined |WoW| change
perweek["wow_abs_sum"] = perweek[["wow_ret","wow_churn","wow_arpu"]].abs().sum(axis=1)
bp = perweek.loc[perweek["wow_abs_sum"].idxmax(), "week"]

with open(out, "w", encoding="utf-8") as f:
    f.write("# per_week\n")
    f.write(perweek.round(6).to_csv(index=False))
    f.write("\n# group_means\n")
    f.write(means.round(6).to_csv(index=False))
    f.write("\n# diff\n")
    f.write(diff.to_csv(index=False))
    f.write(f"\n# breakpoint_week\n{bp}\n")

print(perweek.round(6).to_string(index=False))
print()
print(means.round(6).to_string(index=False))
print()
print(diff.to_string(index=False))
print("\nbreakpoint week:", bp)
print("saved:", out)

