```python
import pandas as pd

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_group_means.csv"

df = pd.read_csv(csv)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

# per-week table
perweek = sub[["week", "group"] + metrics].copy()

# group means
means = sub.groupby("group")[metrics].mean().reset_index()
means.columns = ["group"] + [f"mean_{c}" for c in metrics]
m1 = means[means["group"] == "W30-W36"].iloc[0]
m2 = means[means["group"] == "W37-W43"].iloc[0]

diff = pd.DataFrame({
    "metric": metrics,
    "W30-W36_mean": [m1[f"mean_{c}"] for c in metrics],
    "W37-W43_mean": [m2[f"mean_{c}"] for c in metrics],
    "abs_diff_after_minus_before": [m2[f"mean_{c}"] - m1[f"mean_{c}"] for c in metrics],
    "rel_diff_pct": [(m2[f"mean_{c}"] - m1[f"mean_{c}"]) / m1[f"mean_{c}"] * 100 for c in metrics],
})

# breakpoint detection: first week in W37-W43 where all three metrics deviate from W30-W36 means
# simpler: week-over-week change magnitude
perweek["wow_ret"] = perweek["retention_d7"].diff()
perweek["wow_churn"] = perweek["churn_rate"].diff()
perweek["wow_arpu"] = perweek["arpu_usd"].diff()

with pd.ExcelWriter(out.replace(".csv", ".xlsx")) as xw:
    perweek.to_excel(xw, sheet_name="per_week", index=False)
    means.to_excel(xw, sheet_name="group_means", index=False)
    diff.to_excel(xw, sheet_name="diff", index=False)

perweek.to_csv(out, index=False)
print(perweek.to_string(index=False))
print()
print(means.to_string(index=False))
print()
print(diff.to_string(index=False))
print("\nsaved:", out)

