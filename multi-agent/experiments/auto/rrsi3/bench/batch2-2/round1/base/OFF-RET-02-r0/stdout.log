```python
import pandas as pd
import numpy as np

sub = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r0\_sandbox\tmp\app_metrics_W30_W43.csv")
sub["group"] = np.where(sub["week"].isin([f"W{i}" for i in range(30,37)]), "W30-W36", "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# Group means
means = sub.groupby("group")[metrics].mean()
print("GROUP MEANS:\n", means.to_string())

# Per-week deltas (W37 vs W36)
w36 = sub[sub.week=="W36"].iloc[0]
w37 = sub[sub.week=="W37"].iloc[0]
print("\nW36:", w36[metrics].to_dict())
print("W37:", w37[metrics].to_dict())

# Build results CSV
rows = []
for g in ["W30-W36", "W37-W43"]:
    m = means.loc[g]
    for met in metrics:
        rows.append({"group": g, "metric": met, "mean": round(m[met], 6), "n_weeks": 7})

# Deltas: W37-W43 mean minus W30-W36 mean
for met in metrics:
    d = means.loc["W37-W43", met] - means.loc["W30-W36", met]
    pct = d / means.loc["W30-W36", met] * 100
    rows.append({"group": "delta(W37-W43 - W30-W36)", "metric": met, "mean": round(d, 6), "n_weeks": round(pct, 4)})

# W37 vs W36 single-week jump
for met in metrics:
    d = w37[met] - w36[met]
    pct = d / w36[met] * 100
    rows.append({"group": "delta(W37 - W36)", "metric": met, "mean": round(d, 6), "n_weeks": round(pct, 4)})

res = pd.DataFrame(rows)
print("\nRESULTS:\n", res.to_string(index=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_group_means_breakpoint.csv"
res.to_csv(out, index=False)
print("\nSAVED:", out)

# Also save per-week table with group labels
sub.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_per_week_with_group.csv", index=False)
print("SAVED per-week:", r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_per_week_with_group.csv")

