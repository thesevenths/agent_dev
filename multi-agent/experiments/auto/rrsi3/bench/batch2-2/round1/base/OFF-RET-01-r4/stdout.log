import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]

first30 = df.iloc[:30]["retention_d7"]
last30 = df.iloc[30:]["retention_d7"]

f_mean, f_std = first30.mean(), first30.std(ddof=1)
l_mean, l_std = last30.mean(), last30.std(ddof=1)
o_mean, o_std = r.mean(), r.std(ddof=1)
diff = l_mean - f_mean
threshold = o_mean - 2*o_std
below = df[r < threshold]
count = len(below)

res = {
    "as_of": "2026-10-25 05:09",
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": 60,
    "first30": {"weeks": "W01-W30", "n": 30, "mean": f_mean, "std": f_std},
    "last30": {"weeks": "W31-W60", "n": 30, "mean": l_mean, "std": l_std},
    "diff_last_minus_first_mean": diff,
    "overall": {"n": 60, "mean": o_mean, "std": o_std},
    "threshold_mean_minus_2std": threshold,
    "weeks_below_threshold_count": count,
    "weeks_below_threshold": below["week"].tolist(),
    "weeks_below_threshold_values": below["retention_d7"].tolist(),
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-01-r4\_sandbox\tmp\step2_stats.json", "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

# also a small CSV for the report step
out = pd.DataFrame([
    {"metric": "first30_mean", "value": f_mean, "n": 30, "weeks": "W01-W30"},
    {"metric": "first30_std", "value": f_std, "n": 30, "weeks": "W01-W30"},
    {"metric": "last30_mean", "value": l_mean, "n": 30, "weeks": "W31-W60"},
    {"metric": "last30_std", "value": l_std, "n": 30, "weeks": "W31-W60"},
    {"metric": "diff_last30_mean_minus_first30_mean", "value": diff, "n": None, "weeks": "derived"},
    {"metric": "overall_mean", "value": o_mean, "n": 60, "weeks": "W01-W60"},
    {"metric": "overall_std", "value": o_std, "n": 60, "weeks": "W01-W60"},
