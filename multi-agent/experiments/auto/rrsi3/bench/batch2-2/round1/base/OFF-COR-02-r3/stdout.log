import pandas as pd, numpy as np
from pathlib import Path

csv_path = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-COR-02-r3\_sandbox\offline_data\students.csv")
df = pd.read_csv(csv_path)
n = len(df)
print("n =", n)

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
print("pearson screen~math:", r_math)
print("pearson screen~reading:", r_read)

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]
print("n_hi:", len(hi), "n_lo:", len(lo))
for name, g in [("hi(>5)", hi), ("lo(<=5)", lo)]:
    print(name, "math_mean:", g["math_score"].mean(), "read_mean:", g["reading_score"].mean(),
          "screen_mean:", g["screen_hours_per_day"].mean())

d_math = hi["math_score"].mean() - lo["math_score"].mean()
d_read = hi["reading_score"].mean() - lo["reading_score"].mean()
print("diff math (hi-lo):", d_math)
print("diff reading (hi-lo):", d_read)

# also overall means for reference
print("overall math mean:", df["math_score"].mean(), "overall reading mean:", df["reading_score"].mean())

