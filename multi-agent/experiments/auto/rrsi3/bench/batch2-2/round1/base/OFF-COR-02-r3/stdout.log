import pandas as pd
df = pd.read_csv("offline_data/students.csv")
s, m, r = df.screen_hours_per_day, df.math_score, df.reading_score
n = len(df)
r_sm = s.corr(m, method="pearson")
r_sr = s.corr(r, method="pearson")
r_mr = m.corr(r, method="pearson")
print(n, r_sm, r_sr, r_mr)
# significance
import math
def ttest(rho, n):
    t = rho*math.sqrt((n-2)/(1-rho**2))
    return t
print("t_sm", ttest(r_sm, n), "t_sr", ttest(r_sr, n))
from scipy import stats
print("p_sm", stats.t.sf(abs(ttest(r_sm,n)), n-2)*2)
print("p_sr", stats.t.sf(abs(ttest(r_sr,n)), n-2)*2)

