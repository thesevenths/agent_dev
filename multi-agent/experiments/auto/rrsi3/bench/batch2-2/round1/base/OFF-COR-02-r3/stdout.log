import pandas as pd, math
from scipy import stats
df = pd.read_csv("offline_data/students.csv")
s, m, r = df.screen_hours_per_day, df.math_score, df.reading_score
n = len(df)
r_sm = s.corr(m, method="pearson")
r_sr = s.corr(r, method="pearson")
r_mr = m.corr(r, method="pearson")
def ttest(rho, n): return rho*math.sqrt((n-2)/(1-rho**2))
t_sm, t_sr = ttest(r_sm,n), ttest(r_sr,n)
p_sm = stats.t.sf(abs(t_sm), n-2)*2
p_sr = stats.t.sf(abs(t_sr), n-2)*2
print(f"n={n}")
print(f"r_sm={r_sm:.6f} t={t_sm:.4f} p={p_sm:.3e}")
print(f"r_sr={r_sr:.6f} t={t_sr:.4f} p={p_sr:.3e}")
print(f"r_mr={r_mr:.6f}")

```
