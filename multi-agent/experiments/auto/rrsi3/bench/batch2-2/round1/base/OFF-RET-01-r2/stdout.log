import pandas as pd, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-01-r2\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(r"offline_data/app_metrics.csv")
r = df["retention_d7"]
n = len(r)
first = r.iloc[:30]
last = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
below = r[r < overall_mean - 2*overall_std]

res = {
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(n),
    "first30": {"weeks": "W01-W30", "n": 30, "mean": first.mean(), "std": first.std(ddof=1), "min": first.min(), "max": first.max()},
    "last30": {"weeks": "W31-W60", "n": 30, "mean": last.mean(), "std": last.std(ddof=1), "min": last.min(), "max": last.max()},
    "diff_mean_last_minus_first": last.mean() - first.mean(),
    "overall": {"mean": overall_mean, "std": overall_std, "threshold_mean_minus_2std": overall_mean - 2*overall_std},
    "weeks_below_mean_minus_2std": {"count": int(len(below)), "weeks": list(below.index), "values": {k: float(v) for k, v in below.items()}},
    "std_convention": "sample std (ddof=1)",
}
with open(os.path.join(out_dir, "retention_d7_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))

```
