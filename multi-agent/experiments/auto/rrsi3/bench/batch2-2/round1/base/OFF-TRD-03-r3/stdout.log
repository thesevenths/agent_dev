import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

out = {}
out["file"] = os.path.abspath(path)
out["columns"] = list(df.columns)
out["n_rows"] = int(len(df))
out["regions"] = sorted(df["region"].unique().tolist())
out["months"] = [df["month"].min(), df["month"].max()]
out["n_months"] = int(df["month"].nunique())
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["nulls"] = df.isna().sum().to_dict()
out["dupes"] = int(df.duplicated(subset=["month","region","product_line"]).sum())

# rows per region
out["rows_per_region"] = df.groupby("region")["revenue"].count().to_dict()

# revenue totals
tot = df.groupby("region")["revenue"].sum()
out["total_revenue"] = tot.to_dict()
out["grand_total"] = float(df["revenue"].sum())
out["share"] = (tot/out["grand_total"]*100).round(4).to_dict()
out["monthly_avg"] = (tot/out["n_months"]).round(2).to_dict()

# monthly by region
m = df.groupby(["region","month"])["revenue"].sum().unstack()
out["monthly_by_region"] = m.round(2).to_dict()
top_region = tot.idxmax()
peak = m.loc[top_region].idxmax()
out["top_region"] = top_region
out["top_region_total"] = float(tot[top_region])
out["peak_month"] = peak
out["peak_value"] = float(m.loc[top_region, peak])

# sanity: revenue vs units*unit_price
df["calc"] = df["units"]*df["unit_price"]
out["max_rev_diff"] = float((df["revenue"]-df["calc"]).abs().max())

os.makedirs(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-03-r3\_sandbox\tmp", exist_ok=True)
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-03-r3\_sandbox\tmp\step1_validation.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))

```
