import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-03-r3\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

n_months = df['month'].nunique()  # 24

# Regional aggregates
reg = df.groupby('region')['revenue'].agg(total='sum', rows='count').reset_index()
grand_total = reg['total'].sum()
reg['share_pct'] = reg['total'] / grand_total * 100
reg['monthly_avg'] = reg['total'] / n_months
reg = reg.sort_values('total', ascending=False).reset_index(drop=True)
print(reg.to_string(index=False))
print("grand total:", grand_total, "n_months:", n_months)

# Peak month per region
peak = df.groupby(['region','month'])['revenue'].sum().reset_index()
top = peak.loc[peak.groupby('region')['revenue'].idxmax()]
print("\nPeak months per region:")
print(top.to_string(index=False))

# Top region's monthly series (for report)
top_region = reg.iloc[0]['region']
top_monthly = df[df['region']==top_region].groupby('month')['revenue'].sum().sort_values()
print(f"\n{top_region} monthly revenue (sorted):")
print(top_monthly.to_string())

# Save intermediate CSV
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-03-r3\_sandbox\tmp\step2_regional_aggregates.csv"
reg.to_csv(out, index=False)
print("\nsaved:", out)

