import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
m, r = df["math_score"], df["reading_score"]
n = len(df)
res = {
    "n": n,
    "math": {"mean": m.mean(), "std": m.std(ddof=1), "std_pop": m.std(ddof=0), "median": m.median(), "cv": m.std(ddof=1)/m.mean()},
    "reading": {"mean": r.mean(), "std": r.std(ddof=1), "std_pop": r.std(ddof=0), "median": r.median(), "cv": r.std(ddof=1)/r.mean()},
    "pearson_r": m.corr(r),
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-STAT-02-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
path = os.path.join(out_dir, "stats_results.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print(json.dumps(res, indent=2))
print("saved:", path)

