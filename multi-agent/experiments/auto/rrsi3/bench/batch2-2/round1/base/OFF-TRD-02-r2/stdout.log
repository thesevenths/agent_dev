import pandas as pd, os

src = "offline_data/regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-TRD-02-r2\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(src)
print(df.shape, df.dtypes)
print(df['month'].min(), df['month'].max())
print(df['product_line'].unique())
print("nulls:", df.isna().sum().sum())

g = df.groupby('product_line').agg(
    total_units=('units','sum'),
    total_revenue=('revenue','sum'),
    rows=('revenue','size'),
    avg_unit_price=('unit_price','mean'),
    returns=('returns','sum'),
).reset_index()
g['avg_price_rev_over_units'] = g['total_revenue']/g['total_units']
g['revenue_share'] = g['total_revenue']/g['total_revenue'].sum()
g = g.sort_values('total_revenue', ascending=False)
print(g.to_string())
print("total revenue:", df['revenue'].sum(), "total units:", df['units'].sum())

out = os.path.join(out_dir, "product_line_summary.csv")
g.to_csv(out, index=False)
print("saved:", out)

```
