import pandas as pd, os, json
from scipy import stats

df = pd.read_csv("offline_data/students.csv")
n = len(df)

def pearson(x, y):
    r, p = stats.pearsonr(x, y)
    return r, p

results = {"n": n, "correlations": {}}
for col in ["math_score", "reading_score"]:
    r, p = pearson(df["screen_hours_per_day"], df[col])
    results["correlations"][col] = {
        "pearson_r": r, "p_value": p, "n": n,
