import pandas as pd
from scipy import stats
df = pd.read_csv("offline_data/students.csv")
sub = df[["screen_hours_per_day","math_score","reading_score"]]
n = len(sub)
r_m, p_m = stats.pearsonr(sub["screen_hours_per_day"], sub["math_score"])
r_r, p_r = stats.pearsonr(sub["screen_hours_per_day"], sub["reading_score"])
print("n =", n)
print("pearson screen~math: r=%.6f p=%.6g" % (r_m, p_m))
print("pearson screen~reading: r=%.6f p=%.6g" % (r_r, p_r))
# also pandas corr for cross-check
print(sub.corr().loc["screen_hours_per_day", ["math_score","reading_score"]])

```
