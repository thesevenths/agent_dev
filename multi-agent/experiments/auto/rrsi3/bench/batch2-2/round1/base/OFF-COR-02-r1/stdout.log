```python
import pandas as pd, os, json
from scipy.stats import ttest_ind

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high(>5)", False: "low(<=5)"})

rows = []
for g, sub in df.groupby("group", sort=False):
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "mean_screen_hours": float(sub["screen_hours_per_day"].mean()),
        "mean_math_score": float(sub["math_score"].mean()),
        "mean_reading_score": float(sub["reading_score"].mean()),
        "std_math_score": float(sub["math_score"].std(ddof=1)),
        "std_reading_score": float(sub["reading_score"].std(ddof=1)),
    })

low = df[df["screen_hours_per_day"] <= 5]
high = df[df["screen_hours_per_day"] > 5]

diffs = {
    "math_score": {
        "high_minus_low": float(high["math_score"].mean() - low["math_score"].mean()),
        "t_stat": float(ttest_ind(high["math_score"], low["math_score"]).statistic),
        "p_value": float(ttest_ind(high["math_score"], low["math_score"]).pvalue),
    },
    "reading_score": {
        "high_minus_low": float(high["reading_score"].mean() - low["reading_score"].mean()),
        "t_stat": float(ttest_ind(high["reading_score"], low["reading_score"]).statistic),
        "p_value": float(ttest_ind(high["reading_score"], low["reading_score"]).pvalue),
    },
}

result = {
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "total_n": int(len(df)),
    "groups": rows,
    "mean_differences_high_minus_low": diffs,
}

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-COR-02-r1\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out_json = os.path.join(out_dir, "step3_group_stats.json")
with open(out_json, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

out_csv = os.path.join(out_dir, "step3_group_stats.csv")
pd.DataFrame(rows).to_csv(out_csv, index=False)

print(json.dumps(result, ensure_ascii=False, indent=2))
print(out_json)
print(out_csv)

```
