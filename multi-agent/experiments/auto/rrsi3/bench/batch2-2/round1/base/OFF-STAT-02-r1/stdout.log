import pandas as pd
import numpy as np
import os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-STAT-02-r1\_sandbox"
csv_path = os.path.join(base, "offline_data", "students.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv_path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print(df.head())

for col in ["math_score", "reading_score"]:
    s = df[col].dropna()
    print(col, "n=", len(s), "missing=", df[col].isna().sum())

m = df["math_score"].dropna()
r = df["reading_score"].dropna()

stats = {}
for name, s in [("math_score", m), ("reading_score", r)]:
    mean = s.mean()
    std = s.std(ddof=1)
    std_pop = s.std(ddof=0)
    med = s.median()
    cv = std/mean
    stats[name] = dict(n=len(s), mean=mean, std=std, std_pop=std_pop, median=med, cv=cv,
                       min=s.min(), max=s.max())
    print(name, stats[name])

# Pearson correlation on complete pairs
pair = df[["math_score","reading_score"]].dropna()
corr = pair["math_score"].corr(pair["reading_score"])
print("pearson r =", corr, "n_pairs =", len(pair))

# save stats json for downstream step
import json
out = {
  "file": "offline_data/students.csv",
  "n_rows_total": int(len(df)),
  "n_pairs_complete": int(len(pair)),
  "math_score": {k: (float(v) if isinstance(v,(int,float,np.floating)) else v) for k,v in stats["math_score"].items()},
  "reading_score": {k: (float(v) if isinstance(v,(int,float,np.floating)) else v) for k,v in stats["reading_score"].items()},
  "pearson_r": float(corr),
}
out_path = os.path.join(out_dir, "stats_result.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved:", out_path)

