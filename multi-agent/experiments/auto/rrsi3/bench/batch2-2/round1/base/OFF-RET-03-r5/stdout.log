import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r5\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
n = len(df)

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
med = df["retention_d7"].median()

hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

res = {
    "n": n,
    "corr_retention_arpu": r_arpu,
    "corr_retention_churn": r_churn,
    "median_retention_d7": med,
    "high_group": {"n": len(hi), "mean_arpu_usd": hi["arpu_usd"].mean(), "sum_cohort_size": int(hi["cohort_size"].sum())},
    "low_group": {"n": len(lo), "mean_arpu_usd": lo["arpu_usd"].mean(), "sum_cohort_size": int(lo["cohort_size"].sum())},
}
print(json.dumps(res, indent=2))

# save intermediate CSV
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-RET-03-r5\_sandbox\tmp\step2_results.csv"
rows = [
