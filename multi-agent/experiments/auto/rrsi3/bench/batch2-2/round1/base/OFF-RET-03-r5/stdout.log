import pandas as pd, numpy as np

df = pd.read_csv('offline_data/app_metrics.csv')
n = len(df)
med = df['retention_d7'].median()
high = df[df['retention_d7'] > med]
low = df[df['retention_d7'] <= med]

# derived numbers
arpu_diff = high['arpu_usd'].mean() - low['arpu_usd'].mean()
arpu_ratio = high['arpu_usd'].mean() / low['arpu_usd'].mean()
churn_diff = high['churn_rate'].mean() - low['churn_rate'].mean()
cohort_diff = int(high['cohort_size'].sum() - low['cohort_size'].sum())
cohort_ratio = high['cohort_size'].sum() / low['cohort_size'].sum()

vals = dict(
    n=n, med=float(med),
    r_arpu=float(df['retention_d7'].corr(df['arpu_usd'])),
    r_churn=float(df['retention_d7'].corr(df['churn_rate'])),
    r_arpu_churn=float(df['arpu_usd'].corr(df['churn_rate'])),
    hi_n=len(high), lo_n=len(low),
    hi_arpu=float(high['arpu_usd'].mean()), lo_arpu=float(low['arpu_usd'].mean()),
    hi_cohort=int(high['cohort_size'].sum()), lo_cohort=int(low['cohort_size'].sum()),
    hi_churn=float(high['churn_rate'].mean()), lo_churn=float(low['churn_rate'].mean()),
    hi_ret=float(high['retention_d7'].mean()), lo_ret=float(low['retention_d7'].mean()),
    arpu_diff=float(arpu_diff), arpu_ratio=float(arpu_ratio),
    churn_diff=float(churn_diff), cohort_diff=int(cohort_diff), cohort_ratio=float(cohort_ratio),
    mean_arpu=float(df['arpu_usd'].mean()), mean_churn=float(df['churn_rate'].mean()),
    mean_ret=float(df['retention_d7'].mean()),
)
for k,v in vals.items(): print(k, v)

