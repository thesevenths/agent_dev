```python
import pandas as pd
df = pd.read_csv("offline_data/regional_sales.csv")
g = df.groupby('region')['revenue'].sum()
grand = g.sum()
monthly = df.groupby(['region','month'])['revenue'].sum().unstack().T
for r in ['N','S','E','W']:
    s = monthly[r].sort_values(ascending=False)
    print(r, [(m, round(v,2)) for m,v in s.head(3).items()])
om = df.groupby('month')['revenue'].sum().sort_values(ascending=False)
print("overall top3:", [(m, round(v,2)) for m,v in om.head(3).items()])
print("overall min month:", om.idxmin(), round(om.min(),2))
print("E-W gap:", round(g['E']-g['W'],2), "pct:", round((g['E']-g['W'])/g['W']*100,2))
print("E-S gap:", round(g['E']-g['S'],2))
print({r: round(g[r]/grand*100,2) for r in ['N','S','E','W']})

