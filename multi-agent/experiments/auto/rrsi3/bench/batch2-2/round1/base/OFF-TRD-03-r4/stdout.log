import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

info = {
    "file": os.path.abspath(path),
    "shape": list(df.shape),
    "columns": list(df.columns),
    "dtypes": {c: str(t) for c, t in df.dtypes.items()},
    "regions": sorted(df["region"].unique().tolist()),
    "months": [df["month"].min(), df["month"].max()],
    "n_months": int(df["month"].nunique()),
    "product_lines": sorted(df["product_line"].unique().tolist()),
    "nulls": int(df.isna().sum().sum()),
    "neg_revenue": int((df["revenue"] < 0).sum()),
    "rows_per_region": df.groupby("region").size().to_dict(),
    "rows_per_month": df.groupby("month").size().to_dict(),
    "revenue_total": float(df["revenue"].sum()),
}

# per-region aggregates
g = df.groupby("region")["revenue"].agg(["sum", "count"])
g["share"] = g["sum"] / g["sum"].sum()
g["monthly_avg"] = g["sum"] / info["n_months"]
info["region_agg"] = g.reset_index().to_dict("records")

# per-region monthly
pm = df.groupby(["region", "month"])["revenue"].sum().reset_index()
info["region_monthly"] = pm.to_dict("records")

top_region = g["sum"].idxmax()
top_row = pm[pm["region"] == top_region].sort_values("revenue", ascending=False).iloc[0]
info["top_region"] = top_region
info["top_region_peak"] = {"month": top_row["month"], "revenue": float(top_row["revenue"])}

# check for ties in peak month
ties = pm[(pm["region"] == top_region) & (pm["revenue"] == top_row["revenue"])]
info["peak_ties"] = len(ties)

out = os.path.join("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch2-2\\round1\\base\\OFF-TRD-03-r4\\_sandbox\\tmp", "step1_validation.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(info, f, ensure_ascii=False, indent=2)
print(json.dumps(info, ensure_ascii=False, indent=2))
print("SAVED:", out)

```
