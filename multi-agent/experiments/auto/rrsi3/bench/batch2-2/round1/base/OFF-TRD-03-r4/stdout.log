import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")

# Per-region aggregates
g = df.groupby('region')['revenue'].sum()
grand = g.sum()
monthly_avg = g / 24  # 24 months

# Monthly revenue per region to find peak month
monthly = df.groupby(['region','month'])['revenue'].sum().unstack()
peak = monthly.idxmax(axis=1)
peak_val = monthly.max(axis=1)

result = pd.DataFrame({
    'total_revenue': g,
    'share_of_grand_total': g/grand,
    'monthly_avg_revenue': monthly_avg,
    'peak_month': peak,
    'peak_month_revenue': peak_val,
})
