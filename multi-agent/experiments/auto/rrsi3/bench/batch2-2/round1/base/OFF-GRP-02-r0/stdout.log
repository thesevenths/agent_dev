import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\base\OFF-GRP-02-r0\_sandbox"
stats = pd.read_csv(os.path.join(base, "tmp", "offline_data", "grade_region_stats.csv"))
src = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))

# Verify each cell against raw data
sub = src[src["grade"].isin(["G10","G11","G12"]) & src["region"].isin(["A","B","C","D"])]
chk = sub.groupby(["grade","region"])["reading_score"].agg(n="count", mean="mean").reset_index()
merged = stats.merge(chk, on=["grade","region"])
merged["diff"] = (merged["mean"] - merged["mean_reading_score"]).abs()
print(merged[["grade","region","n","mean","mean_reading_score","diff"]].to_string(index=False))
print("max diff:", merged["diff"].max())
print("sum n:", stats["n"].sum(), "total rows:", len(src))

```
