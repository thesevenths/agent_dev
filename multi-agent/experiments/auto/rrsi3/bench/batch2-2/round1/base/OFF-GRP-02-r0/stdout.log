sub = df[df["grade"].isin(["G10","G11","G12"]) & df["region"].isin(["A","B","C","D"])]
g = sub.groupby(["grade","region"], observed=True)["reading_score"].agg(n="count", mean_reading_score="mean").reset_index()
g = g.set_index(["grade","region"]).reindex(pd.MultiIndex.from_product([["G10","G11","G12"],["A","B","C","D"]])).reset_index()
