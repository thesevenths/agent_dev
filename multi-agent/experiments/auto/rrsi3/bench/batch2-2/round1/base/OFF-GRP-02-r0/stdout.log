    best = m.min() if asc else m.max()
    cand = df[m==best].copy()
    cand = cand.sort_values(["n"], ascending=False, kind="stable")
    cand = cand.sort_values(["grade","region"], ascending=[True,True], kind="stable")
    return cand.iloc[0]
hi = pick(g, False)
lo = pick(g, True)
print("HIGHEST:", hi.tolist())
print("LOWEST:", lo.tolist())

out = os.path.join(base, "tmp", "offline_data", "grade_region_stats.csv")
