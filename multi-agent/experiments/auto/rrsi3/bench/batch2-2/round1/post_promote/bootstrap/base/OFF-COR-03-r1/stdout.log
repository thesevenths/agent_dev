```python
import pandas as pd
import numpy as np
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\post_promote\bootstrap\base\OFF-COR-03-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

preds = ["study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
y = "math_score"

# Pearson correlation matrix (math_score + predictors)
corr = df[[y] + preds].corr()
print("CORR MATRIX:\n", corr.to_string())

# p-values for correlations
for p in preds:
    r, pv = stats.pearsonr(df[y], df[p])
    print(f"corr({y},{p}) = {r:.4f}, p = {pv:.3e}")

# Simple OLS: y = a + b*x
rows = []
for p in preds:
    x = df[p].astype(float)
    r, pv, r2, se, intercept = stats.linregress(x, df[y])
    n = len(df)
    t = r * np.sqrt((n-2) / (1 - r**2))
    rows.append({
        "predictor": p,
        "pearson_r": round(r, 4),
        "p_value": pv,
        "slope_per_unit": round(r, 4),
        "intercept": round(intercept, 4),
        "r_squared": round(r2, 4),
        "t_stat": round(t, 3),
        "n": n,
    })
res = pd.DataFrame(rows)
print("\nREGRESSION RESULTS:\n", res.to_string(index=False))

# extra: per-unit effect in "typical" terms
print("\nExtra context:")
print("study_hours: slope * 1h =", res.iloc[0]["slope_per_unit"])
print("attendance: slope * 10pct =", res.iloc[1]["slope_per_unit"]*10)
print("screen: slope * 1h =", res.iloc[3]["slope_per_unit"])

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\post_promote\bootstrap\base\OFF-COR-03-r1\_sandbox\tmp\step2_correlation_regression.csv"
res.to_csv(out, index=False)
print("\nSaved:", out)

