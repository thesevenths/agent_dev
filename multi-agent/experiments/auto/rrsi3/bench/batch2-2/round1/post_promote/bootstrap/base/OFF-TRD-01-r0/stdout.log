```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\post_promote\bootstrap\base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\post_promote\bootstrap\base\OFF-TRD-01-r0\_sandbox\tmp\step3_novdec_amplification.csv"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]
df['month_num'] = df['month'].str[5:7].astype(int)
df['is_novdec'] = df['month_num'].isin([11, 12])

rows = []
for year in ['2024', '2025']:
    sub = df[df.year == year]
    nd = sub[sub.is_novdec]
    ot = sub[~sub.is_novdec]
    nd_total = nd['units'].sum()
    ot_total = ot['units'].sum()
    nd_avg = nd_total / 2          # 2 months
    ot_avg = ot_total / 10         # 10 months
    ratio = nd_avg / ot_avg
    rows.append({
        'year': year,
        'novdec_total_units': nd_total,
        'novdec_monthly_avg_units': nd_avg,
        'other_months_total_units': ot_total,
        'other_months_monthly_avg_units': ot_avg,
        'amplification_ratio': ratio,
        'novdec_row_count': len(nd),
        'other_months_row_count': len(ot),
    })

# overall (both years combined)
nd_all = df[df.is_novdec]
ot_all = df[~df.is_novdec]
nd_avg_all = nd_all['units'].sum() / 4   # 4 months (2 per year)
ot_avg_all = ot_all['units'].sum() / 20  # 20 months
rows.append({
    'year': 'overall',
    'novdec_total_units': nd_all['units'].sum(),
    'novdec_monthly_avg_units': nd_avg_all,
    'other_months_total_units': ot_all['units'].sum(),
    'other_months_monthly_avg_units': ot_avg_all,
    'amplification_ratio': nd_avg_all / ot_avg_all,
    'novdec_row_count': len(nd_all),
    'other_months_row_count': len(ot_all),
})

res = pd.DataFrame(rows)
res.to_csv(out, index=False, float_format='%.4f')
print(res.to_string(index=False))
print(f"\nSaved to: {out}")

