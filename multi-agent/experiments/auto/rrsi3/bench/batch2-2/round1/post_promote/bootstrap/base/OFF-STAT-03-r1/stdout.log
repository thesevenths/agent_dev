```python
import pandas as pd
df = pd.read_csv('offline_data/students.csv')
df['bin'] = pd.cut(df['attendance_pct'], bins=[0,20,40,60,80,100], right=True,
                   labels=['0-20','20-40','40-60','60-80','80-100'])
g = df.groupby('bin', observed=False).agg(row_count=('student_id','count'),
                                          mean_math=('math_score','mean'))
print(g['mean_math'].round(2))
print('diff 80-100 vs 60-80:', round(g.loc['80-100','mean_math']-g.loc['60-80','mean_math'],2))
print('diff 60-80 vs 40-60:', round(g.loc['60-80','mean_math']-g.loc['40-60','mean_math'],2))
print('overall mean:', round(df['math_score'].mean(),2))
print('attendance min/max:', df['attendance_pct'].min(), df['attendance_pct'].max())

