import pandas as pd

df = pd.read_csv('offline_data/students.csv')
print(len(df))
print(df['attendance_pct'].min(), df['attendance_pct'].max())

# bins: 0-20, 20-40, ..., 80-100 (right-inclusive)
df['bin'] = pd.cut(df['attendance_pct'], bins=[0,20,40,60,80,100], right=True,
                   labels=['0-20','20-40','40-60','60-80','80-100'])
g = df.groupby('bin', observed=False).agg(row_count=('student_id','count'),
                                          mean_math=('math_score','mean'))
print(g)
g.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\post_promote\bootstrap\base\OFF-STAT-03-r1\_sandbox\tmp\attendance_bin_stats.csv')
print(g.to_string())
# check no missing
print(df['attendance_pct'].isna().sum(), df['math_score'].isna().sum())

