import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

months = sorted(df['month'].unique())
print("n_months:", len(months), months[0], "->", months[-1])
print("regions:", sorted(df['region'].unique()))
print("product_lines:", sorted(df['product_line'].unique()))

# check completeness: 24 months x 4 regions x 3 lines = 288
combos = df.groupby(['month','region','product_line']).size()
print("combo count:", len(combos), "all size 1:", (combos==1).all())

# revenue vs units*unit_price consistency
calc = df['units']*df['unit_price']
diff = (calc - df['revenue']).abs()
print("max |units*unit_price - revenue|:", diff.max())

# quick sanity aggregates for downstream
df['year'] = df['month'].str[:4]
print(df.groupby('year')['revenue'].sum())
print(df.groupby('year')['units'].sum())
nd = df[df['month'].str[5:7].isin(['11','12'])].groupby('year')['units'].sum()
rest = df[~df['month'].str[5:7].isin(['11','12'])].groupby('year')['units'].sum()/10
print("Nov-Dec avg monthly units:", nd)
print("other months avg monthly units:", rest)
print("multiplier:", nd/rest)

```
