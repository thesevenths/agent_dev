import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step3_novdec_multiplier.csv"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]
df['mm'] = df['month'].str[5:7]
nd_mask = df['mm'].isin(['11','12'])

rows = []
for y in ['2024','2025']:
    sub = df[df['year']==y]
    nd = sub[nd_mask & (sub['year']==y)]
    rest = sub[~nd_mask & (sub['year']==y)]
    nd_units = nd['units'].sum(); nd_rev = nd['revenue'].sum(); nd_n = len(nd)
    rest_units = rest['units'].sum(); rest_rev = rest['revenue'].sum(); rest_n = len(rest)
    nd_avg = nd_units/2; rest_avg = rest_units/10
    rows.append(dict(year=y,
        novdec_units=nd_units, novdec_revenue=round(nd_rev,2), novdec_rows=nd_n,
        novdec_avg_monthly_units=round(nd_avg,1),
        other_units=rest_units, other_revenue=round(rest_rev,2), other_rows=rest_n,
        other_avg_monthly_units=round(rest_avg,1),
        units_multiplier=round(nd_avg/rest_avg,4),
        revenue_multiplier=round((nd_rev/2)/(rest_rev/10),4)))

res = pd.DataFrame(rows)
print(res.to_string(index=False))
res.to_csv(out, index=False)
print("saved:", out)

