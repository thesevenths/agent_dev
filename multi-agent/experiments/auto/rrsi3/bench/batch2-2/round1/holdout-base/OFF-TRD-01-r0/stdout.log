import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
df['year'] = df['month'].str[:4]
df['mm'] = df['month'].str[5:7].astype(int)
df['is_q4'] = df['mm'].isin([11, 12])

rows = []
for year in ['2024', '2025']:
    sub = df[df.year == year]
    q4 = sub[sub.is_q4]
    rest = sub[~sub.is_q4]
    q4_avg = q4['units'].sum() / 2   # 2 months
    rest_avg = rest['units'].sum() / 10  # 10 months
    mult = q4_avg / rest_avg
    rows.append({
        'year': year,
        'q4_units_total': int(q4['units'].sum()),
        'q4_rows': len(q4),
        'q4_avg_monthly_units': q4_avg,
        'rest_units_total': int(rest['units'].sum()),
        'rest_rows': len(rest),
        'rest_avg_monthly_units': rest_avg,
        'multiplier': mult,
    })

res = pd.DataFrame(rows)
print(res.to_string(index=False))

# also combined 2-year
q4_all = df[df.is_q4]['units'].sum() / 4
rest_all = df[~df.is_q4]['units'].sum() / 20
print(f"combined multiplier: {q4_all/rest_all:.4f}")

out_dir = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp'
res.to_csv(f'{out_dir}\\step3_novdec_multiplier.csv', index=False)
print('saved')

```
