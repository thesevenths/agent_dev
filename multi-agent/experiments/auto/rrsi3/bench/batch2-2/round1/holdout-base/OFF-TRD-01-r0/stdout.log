import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step2_annual_revenue.csv"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]

# Monthly revenue aggregation
monthly = df.groupby(['year','month'], as_index=False).agg(
    revenue=('revenue','sum'),
    units=('units','sum'),
    n_rows=('revenue','size'))

# Annual totals
annual = df.groupby('year', as_index=False).agg(
    annual_revenue=('revenue','sum'),
    annual_units=('units','sum'),
    n_rows=('revenue','size'))
annual['yoy_growth_pct'] = annual.set_index('year')['annual_revenue'].pct_change()*100

print(monthly.to_string(index=False))
print(annual.to_string(index=False))

# save intermediate results: monthly + annual in one CSV with a section marker
with open(out, 'w', encoding='utf-8') as f:
    f.write("section,year,month,revenue,units,n_rows,annual_revenue,annual_units,yoy_growth_pct\n")
    for _, r in monthly.iterrows():
        f.write(f"monthly,{r['year']},{r['month']},{r['revenue']:.2f},{r['units']},{r['n_rows']},,,\n")
    for _, r in annual.iterrows():
        yoy = f"{r['yoy_growth_pct']:.4f}" if pd.notna(r['yoy_growth_pct']) else ""
        f.write(f"annual,{r['year']},,{r['annual_revenue']:.2f},{r['annual_units']},{r['n_rows']},{r['annual_revenue']:.2f},{r['annual_units']},{yoy}\n")
print("saved:", out)

