import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
df['year'] = df['month'].str[:4]

# Monthly revenue
monthly = df.groupby('month')['revenue'].sum().reset_index()
monthly['year'] = monthly['month'].str[:4]

# Annual totals
annual = df.groupby('year')['revenue'].sum().reset_index()
annual.columns = ['year', 'total_revenue']
annual['rows'] = df.groupby('year').size().values

r2024 = annual.loc[annual.year=='2024','total_revenue'].iloc[0]
r2025 = annual.loc[annual.year=='2025','total_revenue'].iloc[0]
yoy = (r2025 - r2024) / r2024 * 100

print(annual)
print(f"YoY: {yoy:.4f}%")
print(monthly.to_string(index=False))

out_dir = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp'
monthly.to_csv(f'{out_dir}\\step2_monthly_revenue.csv', index=False)
annual.to_csv(f'{out_dir}\\step2_annual_revenue.csv', index=False)
print('saved')

```
