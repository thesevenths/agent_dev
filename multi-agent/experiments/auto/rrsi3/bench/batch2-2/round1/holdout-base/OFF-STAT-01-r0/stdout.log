import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import pandas as pd, numpy as np

df = pd.read_csv('offline_data/students.csv')
s = df['math_score']

fig, axes = plt.subplots(1, 2, figsize=(12, 4.5))
axes[0].hist(s, bins=20, color='#4C72B0', edgecolor='white')
axes[0].axvline(s.mean(), color='red', ls='--', label=f'mean={s.mean():.2f}')
axes[0].axvline(s.median(), color='green', ls='--', label=f'median={s.median():.1f}')
axes[0].set_title('math_score histogram (n=400)')
axes[0].set_xlabel('math_score'); axes[0].legend()

q1, q3 = s.quantile(0.25), s.quantile(0.75)
iqr = q3-q1
axes[1].boxplot(s, vert=False, patch_artist=True, boxprops=dict(facecolor='#4C72B0', alpha=0.5))
axes[1].axvline(q1-1.5*iqr, color='orange', ls=':', label=f'lower fence={q1-1.5*iqr:.3f}')
axes[1].axvline(q3+1.5*iqr, color='orange', ls=':', label=f'upper fence={q3+1.5*iqr:.3f}')
axes[1].set_title('math_score boxplot with IQR fences')
axes[1].set_ylabel('math_score'); axes[1].legend()
plt.tight_layout()
