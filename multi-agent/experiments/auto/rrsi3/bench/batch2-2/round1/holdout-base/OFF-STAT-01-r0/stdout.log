import pandas as pd, numpy as np, json

df = pd.read_csv('offline_data/students.csv')
s = df['math_score']
n = len(s)
mean = s.mean()
std = s.std(ddof=1)  # sample std
std_pop = s.std(ddof=0)
med = s.median()
q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
mn, mx = s.min(), s.max()
iqr = q3 - q1
lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
out = s[(s < lo) | (s > hi)]
n_out = len(out)
ratio = n_out / n
print(json.dumps(dict(n=n, mean=mean, std=std, std_pop=std_pop, med=med, q1=q1, q3=q3,
                      mn=mn, mx=mx, iqr=iqr, lo=lo, hi=hi, n_out=n_out, ratio=ratio), indent=2))
print(out.sort_values().tolist())
print(s.describe())

```
