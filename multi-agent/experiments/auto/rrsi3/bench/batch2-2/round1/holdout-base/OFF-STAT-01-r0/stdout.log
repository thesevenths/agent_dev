import pandas as pd, json
df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout-base\OFF-STAT-01-r0\_sandbox\offline_data\students.csv")
s = df['math_score']
q1, q3 = s.quantile(0.25), s.quantile(0.75)
iqr = q3 - q1
lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
out = df[(s < lo) | (s > hi)]
stats = dict(n=len(s), mean=s.mean(), std=s.std(ddof=1), std_pop=s.std(ddof=0),
             median=s.median(), q1=q1, q3=q3, iqr=iqr, lo=lo, hi=hi,
             mn=s.min(), mx=s.max(), n_out=len(out), pct_out=len(out)/len(s)*100)
print(json.dumps(stats, indent=2))
print(out[['student_id','grade','region','math_score']].to_string())
print(s.describe())
print(s.value_counts().sort_index().head(3))
print(s.value_counts().sort_index().tail(3))

```
