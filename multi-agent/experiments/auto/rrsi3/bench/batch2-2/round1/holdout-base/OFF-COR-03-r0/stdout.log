```python
import pandas as pd, numpy as np, json

df = pd.read_csv('offline_data/students.csv')
y = df['math_score']
preds = ['study_hours_per_week','attendance_pct','tutoring','screen_hours_per_day']

# Pearson correlations
corr = {p: float(np.corrcoef(df[p], y)[0,1]) for p in preds}

# Simple OLS slopes: slope = cov(x,y)/var(x)
results = []
for p in preds:
    x = df[p].astype(float)
    slope = float(np.cov(x, y, ddof=1)[0,1] / x.var(ddof=1))
    intercept = float(y.mean() - slope*x.mean())
    # r^2 = corr^2
    r = corr[p]
    results.append({'predictor': p, 'pearson_r': r, 'r_squared': r**2, 'ols_slope': slope, 'ols_intercept': intercept})

res = pd.DataFrame(results)
print(res.to_string(index=False))

out = {
    'as_of': '2026-10-26 02:57',
    'source_file': 'offline_data/students.csv',
    'n_rows': int(len(df)),
    'target': 'math_score',
    'results': results
}
