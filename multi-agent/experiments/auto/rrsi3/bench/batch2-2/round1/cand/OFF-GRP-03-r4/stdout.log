import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
df["group"] = pd.cut(df["study_hours_per_week"], bins=[-0.001, 2.5, 4.5, 100], labels=["Low","Mid","High"])
g = df.groupby("group", observed=True)["math_score"].agg(["count","mean","std","min","max"])
print(g)
print("boundary check: rows with hours==2.5:", (df.study_hours_per_week==2.5).sum(), "hours==4.5:", (df.study_hours_per_week==4.5).sum())
print("group sums:", g["count"].sum())

out = {
  "file": "offline_data/students.csv",
  "rows": int(len(df)), "cols": list(df.columns),
  "missing": {c:int(df[c].isna().sum()) for c in df.columns},
  "duplicates": int(df.duplicated().sum()),
  "study_hours_per_week": {"dtype":"float64","min":float(df.study_hours_per_week.min()),"max":float(df.study_hours_per_week.max())},
  "math_score": {"dtype":"int64","min":int(df.math_score.min()),"max":int(df.math_score.max())},
  "groups": {k:{"n":int(v["count"]),"mean":float(v["mean"]),"std":float(v["std"]),"min":int(v["min"]),"max":int(v["max"])} for k,v in g.iterrows()},
  "gain_low_to_high": float(g.loc["High","mean"]-g.loc["Low","mean"]),
  "boundary_rows_eq_2_5": int((df.study_hours_per_week==2.5).sum()),
  "boundary_rows_eq_4_5": int((df.study_hours_per_week==4.5).sum()),
}
os.makedirs(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-03-r4\_sandbox\tmp", exist_ok=True)
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-03-r4\_sandbox\tmp\step1_validation.json","w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print("saved step1_validation.json")

