import pandas as pd, json

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-01-r1\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-01-r1\_sandbox\tmp\group_stats.json"

df = pd.read_csv(src)
rows = []
for t in [0, 1]:
    s = df.loc[df['tutoring'] == t, 'math_score']
    rows.append({
        "tutoring": t,
        "n": int(s.count()),
        "mean": float(s.mean()),
        "std_sample": float(s.std(ddof=1)),
        "std_pop": float(s.std(ddof=0)),
        "min": float(s.min()),
        "max": float(s.max()),
    })

n0, n1 = rows[0]["n"], rows[1]["n"]
m0, m1 = rows[0]["mean"], rows[1]["mean"]
s0, s1 = rows[0]["std_sample"], rows[1]["std_sample"]
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2) ** 0.5
mean_diff = m1 - m0
d = mean_diff / pooled

result = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "missing_math_score": int(df['math_score'].isna().sum()),
    "groups": rows,
    "pooled_std": pooled,
    "mean_diff_t1_minus_t0": mean_diff,
    "cohens_d": d,
    "effect_label": "small" if abs(d) < 0.5 else ("medium" if abs(d) < 0.8 else "large"),
}
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
