```python
import pandas as pd, numpy as np, json

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-01-r1\_sandbox"
df = pd.read_csv(base + r"\offline_data\students.csv")

rows = []
for t, g in df.groupby("tutoring"):
    rows.append({"tutoring": int(t), "n": len(g),
                 "mean": g["math_score"].mean(),
                 "std_sample": g["math_score"].std(ddof=1),
                 "std_pop": g["math_score"].std(ddof=0),
                 "min": g["math_score"].min(), "max": g["math_score"].max()})
stats = pd.DataFrame(rows).set_index("tutoring")

n0, n1 = stats.loc[0,"n"], stats.loc[1,"n"]
m0, m1 = stats.loc[0,"mean"], stats.loc[1,"mean"]
s0, s1 = stats.loc[0,"std_sample"], stats.loc[1,"std_sample"]
pooled = np.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
diff = m1 - m0
d = diff / pooled
# t-test for reference
t = diff / (pooled * np.sqrt(1/n0 + 1/n1))
from scipy import stats as st
pval = 2*st.t.sf(abs(t), n0+n1-2)

out = {
 "n0": int(n0), "n1": int(n1), "n_total": int(n0+n1),
 "mean0": m0, "mean1": m1,
 "std0_sample": s0, "std1_sample": s1,
 "std0_pop": stats.loc[0,"std_pop"], "std1_pop": stats.loc[1,"std_pop"],
 "min0": int(stats.loc[0,"min"]), "max0": int(stats.loc[0,"max"]),
 "min1": int(stats.loc[1,"min"]), "max1": int(stats.loc[1,"max"]),
 "pooled_std": pooled, "mean_diff": diff, "cohens_d": d,
 "t": t, "p_value": pval,
}
print(json.dumps(out, indent=2))

tmp = base + r"\_sandbox\tmp"
import os
os.makedirs(tmp, exist_ok=True)
stats.reset_index().to_csv(tmp + r"\group_stats.csv", index=False)
with open(tmp + r"\group_stats.json","w") as f:
    json.dump(out, f, indent=2)
print("saved to", tmp)

```
