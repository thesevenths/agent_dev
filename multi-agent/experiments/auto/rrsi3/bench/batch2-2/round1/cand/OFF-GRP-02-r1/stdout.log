import pandas as pd, json, os

src = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-02-r1\_sandbox\offline_data\students.csv'
out_dir = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-02-r1\_sandbox\tmp'
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(src)
print("total rows:", len(df))
print("regions:", sorted(df['region'].unique()))
print("nulls in grade/region/reading_score:", df[['grade','region','reading_score']].isna().sum().to_dict())

g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g = g.sort_values(['grade','region']).reset_index(drop=True)
g['mean'] = g['mean'].round(4)
print(g.to_string())

hi = g.loc[g['mean'].idxmax()]
lo = g.loc[g['mean'].idxmin()]
print("HIGHEST:", hi.to_dict())
print("LOWEST:", lo.to_dict())

overall = df['reading_score'].mean()
print("overall mean:", round(overall,4))

result = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "grades": sorted(df['grade'].unique().tolist()),
    "regions": sorted(df['region'].unique().tolist()),
    "overall_reading_mean": round(float(overall), 4),
    "cells": [
        {"grade": r['grade'], "region": r['region'], "count": int(r['count']), "mean": float(r['mean'])}
        for _, r in g.iterrows()
    ],
    "highest": {"grade": hi['grade'], "region": hi['region'], "count": int(hi['count']), "mean": float(hi['mean'])},
    "lowest": {"grade": lo['grade'], "region": lo['region'], "count": int(lo['count']), "mean": float(lo['mean'])},
}
out = os.path.join(out_dir, 'crosstab_grade_region.json')
with open(out, 'w', encoding='utf-8') as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print("saved:", out)

