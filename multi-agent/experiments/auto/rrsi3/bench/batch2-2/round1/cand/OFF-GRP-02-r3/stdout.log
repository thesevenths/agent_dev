import pandas as pd

df = pd.read_csv("offline_data/students.csv")

g = df.groupby(["grade", "region"], observed=True).agg(
    row_count=("reading_score", "size"),
    mean_reading_score=("reading_score", "mean"),
).reset_index()

g = g.sort_values(["grade", "region"]).reset_index(drop=True)
g["mean_reading_score"] = g["mean_reading_score"].round(4)

print(g.to_string(index=False))
print("\ntotal rows:", g["row_count"].sum())

imax = g["mean_reading_score"].idxmax()
imin = g["mean_reading_score"].idxmin()
print("\nMAX:", g.loc[imax].to_dict())
print("MIN:", g.loc[imin].to_dict())
print("diff:", round(g.loc[imax, "mean_reading_score"] - g.loc[imin, "mean_reading_score"], 4))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-02-r3\_sandbox\tmp\step2_crosstab.csv"
g.to_csv(out, index=False)
print("\nsaved:", out)

```
