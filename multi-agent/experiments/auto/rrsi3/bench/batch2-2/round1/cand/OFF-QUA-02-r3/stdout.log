```python
import pandas as pd
df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-QUA-02-r3\_sandbox\offline_data\regional_sales.csv")
exp = df.units*df.unit_price
dev = (df.revenue-exp).abs()/exp*100
print("rows:", len(df))
print("months:", df.month.min(), df.month.max())
print("regions:", sorted(df.region.unique()), "lines:", sorted(df.product_line.unique()))
print("max dev:", dev.max(), "n>0.5:", (dev>0.5).sum())
print("returns>units:", (df.returns>df.units).sum())
print("returns==units:", (df.returns==df.units).sum())
print("returns max/min:", df.returns.max(), df.returns.min())
print("units max/min:", df.units.max(), df.units.min())
print("revenue sum:", round(df.revenue.sum(),2))
print("units sum:", df.units.sum())
print("returns sum:", df.returns.sum())
print("returns/units overall:", round(df.returns.sum()/df.units.sum()*100,3),"%")
print("dev>0 rows:", (dev>0).sum(), "dev>1e-6:", (dev>1e-6).sum())
print("dev describe:"); print(dev.describe())
# top 5 dev rows
top = df.assign(dev=dev).nlargest(5,"dev")
print(top[["month","region","product_line","units","unit_price","revenue","returns","dev"]].to_string())
# returns rate extremes
rr = df.assign(rr=df.returns/df.units*100)
print("returns rate max row:"); print(rr.nlargest(3,"rr")[["month","region","product_line","units","returns","rr"]].to_string())
print("returns rate min row:"); print(rr.nsmallest(3,"rr")[["month","region","product_line","units","returns","rr"]].to_string())

```
