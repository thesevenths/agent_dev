import pandas as pd

df = pd.read_csv(r"offline_data/app_metrics.csv")
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# Group means
means = sub.groupby("group")[metrics].mean()
counts = sub.groupby("group")[metrics].count()
print("MEANS:\n", means.round(6))
print("COUNTS:\n", counts)

# Differences: after - before
diff = means.loc["W37-W43"] - means.loc["W30-W36"]
rel = diff / means.loc["W30-W36"]
print("ABS DIFF (after-before):\n", diff.round(6))
