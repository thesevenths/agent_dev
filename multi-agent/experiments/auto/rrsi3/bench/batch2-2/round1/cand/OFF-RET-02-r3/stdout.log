import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r3\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
sub["group"] = sub.week.apply(lambda w: "W30-W36" if w <= "W36" else "W37-W43")

# per-week table with week-over-week deltas
per = sub[["week", "group"] + metrics].copy()
for m in metrics:
    per[f"{m}_wow_delta"] = per[m].diff()
per.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)

# group means
means = sub.groupby("group")[metrics].mean().reset_index()
means.columns = ["group"] + [f"mean_{c}" for c in metrics]
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)

# differences (after - before)
a = sub[sub.group == "W30-W36"][metrics].mean()
b = sub[sub.group == "W37-W43"][metrics].mean()
diff = (b - a).rename("abs_diff")
pct = ((b - a) / a * 100).rename("pct_diff")
diff_df = pd.concat([a.rename("before_mean"), b.rename("after_mean"), diff, pct], axis=1)
diff_df.to_csv(f"{out_dir}\\step2_diffs.csv")

print("PER WEEK:\n", per.to_string(index=False))
print("\nGROUP MEANS:\n", means.to_string(index=False))
print("\nDIFFS:\n", diff_df.to_string())

# pinpoint breakpoint: largest |wow delta| per metric
print("\nLargest WoW drop in retention_d7:", per.loc[per.retention_d7_wow_delta.idxmin(), ["week","retention_d7_wow_delta"]].tolist())
print("Largest WoW rise in churn_rate:", per.loc[per.churn_rate_wow_delta.idxmax(), ["week","churn_rate_wow_delta"]].tolist())
print("Largest WoW drop in arpu_usd:", per.loc[per.arpu_usd_wow_delta.idxmin(), ["week","arpu_usd_wow_delta"]].tolist())

