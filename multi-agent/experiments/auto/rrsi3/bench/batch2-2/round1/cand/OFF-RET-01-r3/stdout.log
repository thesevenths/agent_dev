out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-01-r3\_sandbox\tmp\step2_stats.csv"

df = pd.read_csv(p)
df = df.sort_values('week').reset_index(drop=True)
assert len(df) == 60

first = df['retention_d7'].iloc[:30]
last = df['retention_d7'].iloc[30:]
overall = df['retention_d7']

stats = pd.DataFrame([
    {'segment': 'first_30 (W01-W30)', 'n': len(first), 'mean': first.mean(), 'std_ddof1': first.std(ddof=1), 'std_ddof0': first.std(ddof=0), 'min': first.min(), 'max': first.max()},
    {'segment': 'last_30 (W31-W60)', 'n': len(last), 'mean': last.mean(), 'std_ddof1': last.std(ddof=1), 'std_ddof0': last.std(ddof=0), 'min': last.min(), 'max': last.max()},
    {'segment': 'overall_60', 'n': len(overall), 'mean': overall.mean(), 'std_ddof1': overall.std(ddof=1), 'std_ddof0': overall.std(ddof=0), 'min': overall.min(), 'max': overall.max()},
])
stats['diff_last_minus_first_mean'] = stats.loc[1,'mean'] - stats.loc[0,'mean']
stats['diff_last_minus_first_std_ddof1'] = stats.loc[1,'std_ddof1'] - stats.loc[0,'std_ddof1']

thr = overall.mean() - 2*overall.std(ddof=1)
below = df[df['retention_d7'] < thr]
summary = pd.DataFrame([
    {'metric': 'overall_mean', 'value': overall.mean()},
    {'metric': 'overall_std_ddof1', 'value': overall.std(ddof=1)},
    {'metric': 'threshold_mean_minus_2std', 'value': thr},
    {'metric': 'weeks_below_threshold_count', 'value': len(below)},
    {'metric': 'weeks_below_threshold_list', 'value': ','.join(below['week'])},
])
stats.to_csv(out, index=False)
summary.to_csv(out.replace('step2_stats.csv','step2_summary.csv'), index=False)

print(stats.to_string(index=False))
print()
print(summary.to_string(index=False))
print()
print(below[['week','retention_d7']].to_string(index=False))

