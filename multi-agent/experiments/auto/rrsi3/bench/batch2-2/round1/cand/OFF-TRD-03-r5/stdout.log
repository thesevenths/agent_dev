```python
import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")

# Per-region aggregates
agg = df.groupby('region')['revenue'].agg(['sum', 'count']).reset_index()
total = agg['sum'].sum()
agg['share_pct'] = agg['sum'] / total * 100
agg['monthly_avg'] = agg['sum'] / 24  # 24 months
agg = agg.rename(columns={'sum': 'total_revenue', 'count': 'n_rows'})
agg = agg[['region', 'total_revenue', 'share_pct', 'monthly_avg', 'n_rows']]
agg = agg.sort_values('total_revenue', ascending=False).reset_index(drop=True)
print(agg.to_string())

# Monthly revenue per region for top region
top = agg.iloc[0]['region']
monthly = df[df['region'] == top].groupby('month')['revenue'].sum().reset_index()
monthly = monthly.sort_values('revenue', ascending=False)
print(f"\nTop region: {top}")
print(monthly.head(5).to_string())
peak = monthly.iloc[0]
print(f"\nPeak month: {peak['month']} with revenue {peak['revenue']:.2f}")

# Save aggregates
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r5\_sandbox\tmp"
agg.to_csv(f"{out_dir}\\regional_aggregates.csv", index=False)

# Also save monthly detail for top region
monthly.to_csv(f"{out_dir}\\top_region_monthly.csv", index=False)

# Save a summary JSON-like text for step 3
summary = {
    "total_revenue_all": float(total),
    "top_region": top,
    "top_region_total": float(agg.iloc[0]['total_revenue']),
    "top_region_share": float(agg.iloc[0]['share_pct']),
    "top_region_monthly_avg": float(agg.iloc[0]['monthly_avg']),
    "peak_month": peak['month'],
    "peak_revenue": float(peak['revenue']),
}
import json
with open(f"{out_dir}\\step2_summary.json", "w") as f:
    json.dump(summary, f, indent=2)
print("\nSaved files.")
print(json.dumps(summary, indent=2))

