import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "n_months:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dup rows:", df.duplicated().sum())
print("revenue<=0:", (df['revenue']<=0).sum())
print("rows per region:\n", df['region'].value_counts())
print("rows per month-region consistent:", df.groupby(['month','region']).size().unique())

# sanity: revenue vs units*unit_price
df['calc'] = df['units']*df['unit_price']
print("max |revenue - units*price|:", (df['revenue']-df['calc']).abs().max())

out = {
  "file": os.path.abspath(path),
  "n_rows": int(len(df)),
  "columns": list(df.columns),
  "regions": sorted(df['region'].unique()),
  "month_range": [df['month'].min(), df['month'].max()],
  "n_months": int(df['month'].nunique()),
  "product_lines": sorted(df['product_line'].unique()),
  "null_cells": int(df.isna().sum().sum()),
  "duplicate_rows": int(df.duplicated().sum()),
  "nonpositive_revenue": int((df['revenue']<=0).sum()),
  "rows_per_region": {k:int(v) for k,v in df['region'].value_counts().items()},
  "rows_per_month_region": {k:int(v) for k,v in df.groupby(['month','region']).size().unique()},
  "revenue_units_price_max_diff": float((df['revenue']-df['units']*df['unit_price']).abs().max()),
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r5\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out_path = os.path.join(out_dir, "step1_csv_validation.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved:", out_path)

