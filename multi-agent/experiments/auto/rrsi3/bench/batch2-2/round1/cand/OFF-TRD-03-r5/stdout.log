```python
import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

# per-region aggregates
g = df.groupby('region')['revenue'].agg(total='sum', n_rows='count')
grand = df['revenue'].sum()
g['share'] = g['total']/grand
g['monthly_avg'] = g['total']/df['month'].nunique()  # 24 months
g = g.sort_values('total', ascending=False)

# per-region monthly totals for peak month
monthly = df.groupby(['region','month'])['revenue'].sum().reset_index()
top_region = g.index[0]
peak = monthly[monthly['region']==top_region].sort_values('revenue', ascending=False).iloc[0]

# also per-region peak month (all regions) for context
peaks = monthly.loc[monthly.groupby('region')['revenue'].idxmax()][['region','month','revenue']]

result = {
  "source_file": os.path.abspath(path),
  "n_rows": int(len(df)),
  "n_months": int(df['month'].nunique()),
  "month_range": [df['month'].min(), df['month'].max()],
  "grand_total_revenue": float(grand),
  "regions": [
    {"region": r, "total_revenue": float(row.total), "share": float(row.share),
     "monthly_avg_revenue": float(row.monthly_avg), "n_rows": int(row.n_rows)}
    for r, row in g.iterrows()
  ],
  "top_region": top_region,
  "top_region_peak_month": {"month": peak['month'], "revenue": float(peak['revenue'])},
  "all_regions_peak_month": [
    {"region": r, "month": m, "revenue": float(v)} for r, m, v in peaks.values
  ],
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r5\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
jpath = os.path.join(out_dir, "step2_regional_aggregates.json")
with open(jpath, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

# also a CSV artifact
g.reset_index().to_csv(os.path.join(out_dir, "step2_regional_aggregates.csv"), index=False, encoding="utf-8-sig")

print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", jpath)

```
