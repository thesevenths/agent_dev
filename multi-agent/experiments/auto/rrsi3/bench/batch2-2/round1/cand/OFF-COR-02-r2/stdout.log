import pandas as pd, json

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(csv_path)

cols = ["screen_hours_per_day", "math_score", "reading_score"]
n_total = len(df)
n_valid = int(df[cols].dropna().shape[0])

# Correlations (full n, no missing)
pearson_math = float(df["screen_hours_per_day"].corr(df["math_score"], method="pearson"))
pearson_read = float(df["screen_hours_per_day"].corr(df["reading_score"], method="pearson"))
spearman_math = float(df["screen_hours_per_day"].corr(df["math_score"], method="spearman"))
spearman_read = float(df["screen_hours_per_day"].corr(df["reading_score"], method="spearman"))

# Group split
hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

def gstats(g):
    return {
        "n": int(len(g)),
        "math_score_mean": float(g["math_score"].mean()),
        "reading_score_mean": float(g["reading_score"].mean()),
        "math_score_std": float(g["math_score"].std(ddof=1)),
        "reading_score_std": float(g["reading_score"].std(ddof=1)),
        "screen_hours_mean": float(g["screen_hours_per_day"].mean()),
    }

hi_s, lo_s = gstats(hi), gstats(lo)

results = {
    "step": "2/3 Compute correlations & group stats",
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-26 01:22",
    "n_total": n_total,
    "n_valid": n_valid,
    "missing_in_key_cols": 0,
    "correlations": {
        "n": n_valid,
        "pearson_screen_math": pearson_math,
        "pearson_screen_reading": pearson_read,
        "spearman_screen_math": spearman_math,
        "spearman_screen_reading": spearman_read,
    },
    "group_split": {
        "threshold": "screen_hours_per_day > 5 (high) vs <= 5 (low)",
        "high_gt5": hi_s,
        "low_le5": lo_s,
        "mean_diff_high_minus_low": {
            "math_score": float(hi_s["math_score_mean"] - lo_s["math_score_mean"]),
            "reading_score": float(hi_s["reading_score_mean"] - lo_s["reading_score_mean"]),
        },
    },
}

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r2\_sandbox\tmp\step2_results.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

print(json.dumps(results, ensure_ascii=False, indent=2))
print("saved:", out)

