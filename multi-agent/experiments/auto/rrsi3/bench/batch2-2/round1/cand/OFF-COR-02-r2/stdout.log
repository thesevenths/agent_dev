import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print(df.head(3).to_string())

cols = ["screen_hours_per_day", "math_score", "reading_score"]
missing = {c: int(df[c].isna().sum()) for c in cols}
print("missing:", missing)
print("dtypes:\n", df[cols].dtypes)

# basic stats for downstream
stats = {}
for c in cols:
    s = df[c].dropna()
    stats[c] = {"n": int(s.count()), "mean": float(s.mean()), "std": float(s.std(ddof=1)),
                "min": float(s.min()), "max": float(s.max())}
print(json.dumps(stats, indent=2))

# group split
hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]
print("hi n:", len(hi), "lo n:", len(lo))
for g, name in [(hi, "hi"), (lo, "lo")]:
    print(name, {c: float(g[c].mean()) for c in ["math_score", "reading_score"]})

# correlations
print("pearson math:", df["screen_hours_per_day"].corr(df["math_score"]))
print("pearson reading:", df["screen_hours_per_day"].corr(df["reading_score"]))
print("spearman math:", df["screen_hours_per_day"].corr(df["math_score"], method="spearman"))
print("spearman reading:", df["screen_hours_per_day"].corr(df["reading_score"], method="spearman"))

