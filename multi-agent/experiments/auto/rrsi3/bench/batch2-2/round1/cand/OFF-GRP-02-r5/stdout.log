import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-02-r5\_sandbox\tmp\grade_region_crosstab.csv"

df = pd.read_csv(src)
g = df.groupby(["grade", "region"], observed=True).agg(
    row_count=("reading_score", "size"),
    reading_score_mean=("reading_score", "mean"),
).reset_index()
g["reading_score_mean"] = g["reading_score_mean"].round(4)

# overall mean for reference
overall = df["reading_score"].mean()

imax = g["reading_score_mean"].idxmax()
imin = g["reading_score_mean"].idxmin()
mx = g.loc[imax]; mn = g.loc[imin]
print(g.to_string(index=False))
print("overall mean:", overall, "n:", len(df))
print("MAX:", mx["grade"], mx["region"], mx["reading_score_mean"], "n=", mx["row_count"])
print("MIN:", mn["grade"], mn["region"], mn["reading_score_mean"], "n=", mn["row_count"])
print("diff:", round(mx["reading_score_mean"] - mn["reading_score_mean"], 4))
print("ratio:", round(mx["reading_score_mean"] / mn["reading_score_mean"], 4))

g.to_csv(out, index=False)
print("saved:", out)

```
