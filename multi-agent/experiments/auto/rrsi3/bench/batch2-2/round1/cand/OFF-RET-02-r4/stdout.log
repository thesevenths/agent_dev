import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
w = df["week"].str[1:].astype(int)
s = df[w.between(30, 43)].copy()
s["group"] = s["week"].map(lambda x: "W30-W36" if int(x[1:]) <= 36 else "W37-W43")

cols = ["retention_d7", "churn_rate", "arpu_usd"]
means = s.groupby("group")[cols].mean()
print(means)

# per-week deltas to pinpoint breakpoint
s["ret_d"] = s["retention_d7"].diff()
s["churn_d"] = s["churn_rate"].diff()
s["arpu_d"] = s["arpu_usd"].diff()
print(s[["week","retention_d7","churn_rate","arpu_usd","ret_d","churn_d","arpu_d"]].to_string(index=False))

# group means detail
for g, sub in s.groupby("group"):
    print(g, len(sub), sub[cols].mean().round(6).to_dict())

# save intermediate CSV
out = s[["week","group","cohort_size","dau","retention_d7","churn_rate","arpu_usd","support_tickets","ret_d","churn_d","arpu_d"]]
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r4\_sandbox\tmp\step2_weekly_values.csv", index=False)

means.reset_index().to_csv(r"E:\agent_dev\multi-agent\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r4\_sandbox\tmp\step2_group_means.csv", index=False) if False else means.reset_index().to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r4\_sandbox\tmp\step2_group_means.csv", index=False)

# differences
a = s[s.group=="W30-W36"][cols].mean()
b = s[s.group=="W37-W43"][cols].mean()
diff = b - a
print("diff (after-before):", diff.round(6).to_dict())
print("rel change %:", (diff/a*100).round(4).to_dict())

