import pandas as pd
import numpy as np

path = r"offline_data/app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r4\_sandbox\tmp"

df = pd.read_csv(path)
sub = df[df['week'].astype(str).str.match(r'W(3[0-9]|4[0-3])$')].copy().reset_index(drop=True)
sub['group'] = np.where(sub['week'].astype(str) <= 'W36', 'W30-W36', 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# per-week table
per_week = sub[['week', 'group'] + metrics].copy()

# group means
means = sub.groupby('group')[metrics].mean().reset_index()
n = sub.groupby('group')['week'].count().rename('n_rows').reset_index()
means = means.merge(n, on='group')

# differences: after - before
before = means[means['group'] == 'W30-W36'].iloc[0]
after = means[means['group'] == 'W37-W43'].iloc[0]
diff = {m: after[m] - before[m] for m in metrics}
pct = {m: diff[m] / before[m] * 100 for m in metrics}

# breakpoint location: week-over-week change within W30-W43
wow = per_week.copy()
for m in metrics:
    wow[f'{m}_wow'] = wow[m].diff()

print("=== group means ===")
print(means.to_string(index=False))
print("\n=== diff (after - before) ===")
for m in metrics:
    print(f"{m}: {diff[m]:+.4f}  ({pct[m]:+.2f}%)")
print("\n=== per-week with WoW ===")
print(wow.to_string(index=False))

# max absolute WoW change per metric
print("\n=== largest WoW change per metric ===")
for m in metrics:
    col = f'{m}_wow'
    i = wow[col].abs().idxmax()
    print(f"{m}: max |WoW| at {wow.loc[i,'week']} = {wow.loc[i,col]:+.4f}")

# save intermediate CSV
out_csv = f"{out_dir}\\step2_group_means.csv"
with open(out_csv, 'w', encoding='utf-8-sig') as f:
    f.write("# step2 intermediate results: group means & breakpoint\n")
    f.write("# source: offline_data/app_metrics.csv (60 rows x 7 cols, 0 nulls, W01-W60)\n")
    f.write("# AS_OF: 2026-10-25 05:56 (local); offline snapshot, file mtime 2026-10-23 10:11\n")
    f.write("\n[per_week]\n")
    wow.to_csv(f, index=False)
    f.write("\n[group_means]\n")
    means.to_csv(f, index=False)
    f.write("\n[diff_after_minus_before]\n")
    for m in metrics:
        f.write(f"{m},{diff[m]:.6f},{pct[m]:.4f}%\n")

print("\nsaved:", out_csv)

