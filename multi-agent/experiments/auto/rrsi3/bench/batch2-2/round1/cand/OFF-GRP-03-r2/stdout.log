```python
import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-03-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(n=("math_score","size"),
                            mean_math=("math_score","mean"),
                            min_h=("study_hours_per_week","min"),
                            max_h=("study_hours_per_week","max"))
print(g.to_string())
print("\nboundary check: values near 2.5 and 4.5")
print(sorted(df["study_hours_per_week"].unique())[:10])
print("count ==2.5:", (df["study_hours_per_week"]==2.5).sum(), " count ==4.5:", (df["study_hours_per_week"]==4.5).sum())
print("\ngain high-low:", g.loc["high","mean_math"] - g.loc["low","mean_math"])
print("ratio high/low:", g.loc["high","mean_math"]/g.loc["low","mean_math"])

out = {
  "file": path,
  "rows": int(df.shape[0]),
  "cols": list(df.columns),
  "missing": {c:int(v) for c,v in df.isna().sum().items()},
  "groups": {k: {"n": int(r.n), "mean_math": round(r.mean_math,4),
                 "h_min": float(r.min_h), "h_max": float(r.max_h)}
             for k,r in g.iterrows()},
  "gain_high_minus_low": round(g.loc["high","mean_math"]-g.loc["low","mean_math"],4),
  "ratio_high_over_low": round(g.loc["high","mean_math"]/g.loc["low","mean_math"],4),
  "overall_mean_math": round(df["math_score"].mean(),4),
  "overall_mean_hours": round(df["study_hours_per_week"].mean(),4),
}
outpath = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-03-r2\_sandbox\tmp\validation_summary.json"
with open(outpath,"w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print("\nsaved:", outpath)
print(json.dumps(out,ensure_ascii=False,indent=2))

