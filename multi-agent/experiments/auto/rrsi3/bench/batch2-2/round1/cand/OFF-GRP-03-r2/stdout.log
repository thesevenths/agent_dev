import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-03-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(
    n=("math_score","size"),
    mean_math=("math_score","mean"),
    std_math=("math_score","std"),
    min_math=("math_score","min"),
    max_math=("math_score","max"),
    mean_hours=("study_hours_per_week","mean"),
    min_h=("study_hours_per_week","min"),
    max_h=("study_hours_per_week","max"),
)
print(g.round(4).to_string())

gain = g.loc["high","mean_math"] - g.loc["low","mean_math"]
ratio = g.loc["high","mean_math"] / g.loc["low","mean_math"]
print("\ngain high-low:", round(gain,4))
print("ratio high/low:", round(ratio,4))
print("pct gain:", round(gain/g.loc["low","mean_math"]*100,2), "%")

out = {
  "source_file": path,
  "total_rows": int(df.shape[0]),
  "groups": {k: {
      "n": int(r.n),
      "mean_math": round(float(r.mean_math),4),
      "std_math": round(float(r.std_math),4),
      "min_math": int(r.min_math),
      "max_math": int(r.max_math),
      "mean_hours": round(float(r.mean_hours),4),
      "h_min": float(r.min_h),
      "h_max": float(r.max_h),
  } for k,r in g.iterrows()},
  "gain_high_minus_low": round(float(gain),4),
  "ratio_high_over_low": round(float(ratio),4),
  "pct_gain_vs_low": round(float(gain/g.loc["low","mean_math"]*100),2),
  "overall_mean_math": round(float(df["math_score"].mean()),4),
  "overall_mean_hours": round(float(df["study_hours_per_week"].mean()),4),
}
outpath = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-03-r2\_sandbox\tmp\step2_group_stats.json"
with open(outpath,"w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print("\nsaved:", outpath)
print(json.dumps(out,ensure_ascii=False,indent=2))

