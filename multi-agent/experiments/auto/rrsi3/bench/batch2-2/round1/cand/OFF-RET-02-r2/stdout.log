import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sl = df[df["week"].between("W30","W43")].copy()
sl["group"] = sl["week"].apply(lambda w: "W30-W36" if w <= "W36" else "W37-W43")

metrics = ["retention_d7","churn_rate","arpu_usd"]
means = sl.groupby("group")[metrics].mean()
print(means)

# per-week deltas
sl["d_ret"] = sl["retention_d7"].diff()
sl["d_churn"] = sl["churn_rate"].diff()
sl["d_arpu"] = sl["arpu_usd"].diff()
print(sl[["week","retention_d7","churn_rate","arpu_usd","d_ret","d_churn","d_arpu"]].to_string(index=False))

# relative changes group means
a, b = means.loc["W30-W36"], means.loc["W37-W43"]
for m in metrics:
    print(m, "abs diff:", round(b[m]-a[m],6), "rel %:", round((b[m]-a[m])/a[m]*100,3))

# save intermediate CSV
out = sl[["week","group","cohort_size","dau","retention_d7","churn_rate","arpu_usd","support_tickets","d_ret","d_churn","d_arpu"]].round(6)
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r2\_sandbox\tmp\step2_group_means.csv"
out.to_csv(out_path, index=False)
print("saved", out_path)

```
