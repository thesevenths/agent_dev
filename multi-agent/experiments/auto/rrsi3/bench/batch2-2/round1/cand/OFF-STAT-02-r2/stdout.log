import pandas as pd, json

CSV = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-STAT-02-r2\_sandbox\offline_data\students.csv"
OUT = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-STAT-02-r2\_sandbox\tmp"

df = pd.read_csv(CSV)
m, r = df['math_score'], df['reading_score']
n = len(df)

stats = {
    'n': n,
    'math_mean': m.mean(), 'math_std': m.std(ddof=1), 'math_median': m.median(),
    'math_min': m.min(), 'math_max': m.max(),
    'read_mean': r.mean(), 'read_std': r.std(ddof=1), 'read_median': r.median(),
    'read_min': r.min(), 'read_max': r.max(),
    'pearson': m.corr(r, method='pearson'),
    'math_cv': m.std(ddof=1)/m.mean(), 'read_cv': r.std(ddof=1)/r.mean(),
}
# also population std for reference
stats['math_std_pop'] = m.std(ddof=0)
stats['read_std_pop'] = r.std(ddof=0)

for k, v in stats.items():
    print(f"{k}: {v}")

with open(OUT + r"\stats.json", "w", encoding="utf-8") as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)
print("saved stats.json")

```
