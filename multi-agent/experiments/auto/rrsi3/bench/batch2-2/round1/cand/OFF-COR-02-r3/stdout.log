import pandas as pd
from scipy import stats
df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r3\_sandbox\offline_data\students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True:">5", False:"<=5"})
g = df.groupby("group").agg(n=("student_id","count"),
                            math_mean=("math_score","mean"),
                            read_mean=("reading_score","mean"),
                            math_std=("math_score","std"),
                            read_std=("reading_score","std"),
                            screen_mean=("screen_hours_per_day","mean"))
print(g)
lo, hi = g.loc["<=5"], g.loc[">5"]
print("math diff (hi-lo):", hi.math_mean - lo.math_mean)
print("read diff (hi-lo):", hi.read_mean - lo.read_mean)
# t-tests
for col in ["math_score","reading_score"]:
    a = df.loc[df.group=="<=5", col]; b = df.loc[df.group==">5", col]
    t, p = stats.ttest_ind(b, a, equal_var=False)
    print(col, "welch t=%.4f p=%.4f" % (t,p))

