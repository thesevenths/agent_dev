import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-STAT-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
print(df.head())
print(df.shape)
print(df.dtypes)
print("nulls:", df[['math_score','reading_score']].isna().sum().to_dict())

cols = ['math_score','reading_score']
res = {}
for c in cols:
    s = df[c].dropna()
    res[c] = {
        'n': int(s.count()),
        'mean': float(s.mean()),
        'std_sample': float(s.std(ddof=1)),
        'std_pop': float(s.std(ddof=0)),
        'median': float(s.median()),
        'min': float(s.min()),
        'max': float(s.max()),
    }
    res[c]['cv_sample'] = res[c]['std_sample']/res[c]['mean']
    res[c]['cv_pop'] = res[c]['std_pop']/res[c]['mean']

pearson = float(df[cols].corr(method='pearson').iloc[0,1])
res['pearson'] = pearson
res['n_pairs'] = int(df[cols].dropna().shape[0])

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-STAT-02-r0\_sandbox\tmp\stats_results.json"
with open(out,'w',encoding='utf-8') as f:
    json.dump(res,f,indent=2,ensure_ascii=False)
print(json.dumps(res,indent=2))
print("saved:", out)

