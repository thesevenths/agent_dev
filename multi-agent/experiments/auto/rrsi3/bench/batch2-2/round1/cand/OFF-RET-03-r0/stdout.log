import pandas as pd, numpy as np, os, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-03-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-03-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(path)
n = len(df)
med = df["retention_d7"].median()

# Correlations (Pearson, full sample n=60)
r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")
# Spearman for robustness
s_arpu = df["retention_d7"].corr(df["arpu_usd"], method="spearman")
s_churn = df["retention_d7"].corr(df["churn_rate"], method="spearman")

# Group split by median
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

groups = pd.DataFrame([
    {"group": "retention_d7 > median (high)", "n_weeks": len(hi),
     "retention_d7_min": hi["retention_d7"].min(), "retention_d7_max": hi["retention_d7"].max(),
     "arpu_usd_mean": hi["arpu_usd"].mean(), "cohort_size_sum": int(hi["cohort_size"].sum()),
     "churn_rate_mean": hi["churn_rate"].mean()},
    {"group": "retention_d7 <= median (low)", "n_weeks": len(lo),
     "retention_d7_min": lo["retention_d7"].min(), "retention_d7_max": lo["retention_d7"].max(),
     "arpu_usd_mean": lo["arpu_usd"].mean(), "cohort_size_sum": int(lo["cohort_size"].sum()),
     "churn_rate_mean": lo["churn_rate"].mean()},
])
groups.to_csv(os.path.join(out_dir, "step2_group_stats.csv"), index=False, encoding="utf-8-sig")

# Correlation summary CSV
corr = pd.DataFrame([
    {"pair": "retention_d7 vs arpu_usd", "pearson_r": r_arpu, "spearman_rho": s_arpu, "n": n},
    {"pair": "retention_d7 vs churn_rate", "pearson_r": r_churn, "spearman_rho": s_churn, "n": n},
])
corr.to_csv(os.path.join(out_dir, "step2_correlations.csv"), index=False, encoding="utf-8-sig")

# Full results JSON for downstream report step
res = {
    "source_file": path,
    "n_rows": n,
    "retention_d7_median": med,
    "correlations": {
        "retention_d7_vs_arpu_usd": {"pearson": r_arpu, "spearman": s_arpu},
        "retention_d7_vs_churn_rate": {"pearson": r_churn, "spearman": s_churn},
    },
    "groups": groups.to_dict(orient="records"),
    "arpu_gap_high_minus_low": groups.iloc[0]["arpu_usd_mean"] - groups.iloc[1]["arpu_usd_mean"],
    "arpu_ratio_high_over_low": groups.iloc[0]["arpu_usd_mean"] / groups.iloc[1]["arpu_usd_mean"],
    "cohort_share_high": groups.iloc[0]["cohort_size_sum"] / (groups.iloc[0]["cohort_size_sum"] + groups.iloc[1]["cohort_size_sum"]),
}
with open(os.path.join(out_dir, "step2_results.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)

print(json.dumps(res, indent=2, ensure_ascii=False))
print("saved:", os.path.join(out_dir, "step2_correlations.csv"))
print("saved:", os.path.join(out_dir, "step2_group_stats.csv"))
print("saved:", os.path.join(out_dir, "step2_results.json"))

```
