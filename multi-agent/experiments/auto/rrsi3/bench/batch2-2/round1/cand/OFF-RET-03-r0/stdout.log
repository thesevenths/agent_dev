import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-03-r0\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

# Correlations (Pearson, n=60)
corr_arpu = df['retention_d7'].corr(df['arpu_usd'])
corr_churn = df['retention_d7'].corr(df['churn_rate'])
print("corr retention_d7 vs arpu_usd:", corr_arpu)
print("corr retention_d7 vs churn_rate:", corr_churn)

# Median split
med = df['retention_d7'].median()
print("median:", med)
hi = df[df['retention_d7'] > med]
lo = df[df['retention_d7'] < med]
print("hi rows:", len(hi), "lo rows:", len(lo))
print("hi arpu mean:", hi['arpu_usd'].mean(), "hi cohort sum:", hi['cohort_size'].sum())
print("lo arpu mean:", lo['arpu_usd'].mean(), "lo cohort sum:", lo['cohort_size'].sum())
print("arpu ratio hi/lo:", hi['arpu_usd'].mean()/lo['arpu_usd'].mean())
print("cohort share hi:", hi['cohort_size'].sum()/df['cohort_size'].sum())

# Save intermediate results CSV
