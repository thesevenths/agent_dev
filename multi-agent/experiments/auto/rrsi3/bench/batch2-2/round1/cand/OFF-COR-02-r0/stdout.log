import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
cols = ["screen_hours_per_day", "math_score", "reading_score"]
n = len(df)

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

# p-values via scipy if available
try:
    from scipy import stats
    p_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"])[1]
    p_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"])[1]
except Exception as e:
    p_math = p_read = None
    print("scipy unavailable:", e)

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "method": "Pearson correlation (pandas .corr, default ddof; scipy pearsonr for p-value)",
    "screen_hours_per_day_vs_math_score": {"pearson_r": round(r_math, 6), "p_value": p_math},
    "screen_hours_per_day_vs_reading_score": {"pearson_r": round(r_read, 6), "p_value": p_read},
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)

# also a small CSV artifact
rows = [
    {"variable": "math_score", "pearson_r": round(r_math, 6), "p_value": p_math, "n": n},
