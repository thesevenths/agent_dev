import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df.screen_hours_per_day > 5).map({True:"gt5", False:"le5"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
).to_dict("index")
diff_math = g["gt5"]["mean_math"] - g["le5"]["mean_math"]
diff_read = g["gt5"]["mean_reading"] - g["le5"]["mean_reading"]
out = {
  "gt5": {k: round(v,6) for k,v in g["gt5"].items()},
  "le5": {k: round(v,6) for k,v in g["le5"].items()},
  "diff_gt5_minus_le5": {"math": round(diff_math,6), "reading": round(diff_read,6)},
}
print(json.dumps(out, indent=2))
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

