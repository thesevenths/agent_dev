d(\n        f"| {i} | {r[\'region\']} | {r[\'product_line\']} | {r[\'month\']} "\n        f"| {fmt(r[\'month_sales\'], 0)}（来源：offline_data/regional_sales.csv 的 `units`，{r[\'region\']}×{r[\'product_line\']}×{r[\'month\']} 单行取值） "\n        f"| {fmt(r[\'rolling_mean\'])}（来源：offline_data/regional_sales.csv 的 `units`，{r[\'region\']}×{r[\'product_line\']} 截至 {r[\'month\']} 的 24 个月滚动均值，样本 24 行） "\n        f"| {fmt(r[\'ratio\'], 4)}（来源：由前述两行计算，当月 units ÷ 24 个月均值） "\n        f"| {fmt(r[\'returns\'], 0)}（来源：offline_data/regional_sales.csv 的 `returns`，同月单行取值） "\n        f"| {rr:.4%}（来源：由前述两行计算，returns ÷ units） |"\n    )\nlines.append("")\nlines.append("三个异常组合全部集中在数据集的最后一个月 **2025-12**，这是后续定性判断的关键时间特征。")\nlines.append("")\nlines.append("## 三、放量前后 3 个月走势与退货率对照")\nlines.append("")\nlines.append("| 区域 | 产品线 | 月份 | 相对异常月 | units | 退货率 | 该组合 24 个月平均退货率 |")\nlines.append("|---|---|---|---|---|---|---|")\nfor _, r in ctx.iterrows():\n    lines.append(\n        f"| {r[\'region\']} | {r[\'product_line\']} | {r[\'context_month\']} | {r[\'offset\']} "\n        f"| {fmt(r[\'units\'], 0)}（来源：offline_data/regional_sales.csv 的 `units`，单行取值） "\n        f"| {r[\'return_rate\']:.4%}（来源：由前述两行计算，`returns`÷`units`，单行） "\n        f"| {r[\'avg24_return_rate\']:.4%}（来源：offline_data/regional_sales.csv 的 `returns`÷`units`，{r[\'region\']}×{r[\'product_line\']} 24 行均值） |"\n    )\nlines.append("")\nlines.append("## 四、定性判断：真实需求 vs 渠道压货")\nlines.append("")\nlines.append("判断依据：(a) 异常月之前是否已出现连续放量（≥1.10× 自身 24 个月滚动均值）；(b) 异常月退货率相对该组合 24 个月平均退货率是否异常抬升；"\n             "(c) 时间位置——2025-12 为数据集最后一个月，无后续月份可验证放量是否延续。")\nlines.append("")\nfor _, r in top3.iterrows():\n    key = (r["region"], r["product_line"])\n    v = verdicts.loc[key]\n    rr = r["returns"] / r["month_sales"]\n    if "channel stuffing" in v["verdict"]:\n        judge = "**更像渠道压货（孤立尖峰）**"\n        detail = (f"异常月之前仅 {int(v[\'months_before_elevated\'])} 个月（2025-11）处于放量状态，其余月份销量平稳；"\n                  f"异常月退货率 {rr:.4%} 反而低于其 24 个月平均退货率 {v[\'avg24_return_rate\']:.4%}，"\n                  f"且尖峰出现在年末最后一个月，符合年末冲量/向渠道压货的典型形态。")\n    else:\n        judge = "**更像真实需求（持续趋势）**"\n        detail = (f"异常月之前已有 {int(v[\'months_before_elevated\'])} 个月（2025-09/10/11 区间）连续放量，"\n                  f"呈逐月爬坡而非单月跳变；异常月退货率 {rr:.4%} 不高于其 24 个月平均退货率 {v[\'avg24_return_rate\']:.4%}，"\n                  f"未见压货后常见的退货激增，更符合真实需求增长。")\n    lines.append(f"### {r[\'region\']} × {r[\'product_line\']}（{r[\'month\']}，倍数 {fmt(r[\'ratio\'], 4)}）：{judge}")\n    lines.append("")\n    lines.append(detail)\n    lines.append("")\nlines.append("## 五、结论")\nlines.append("")\nlines.append("在 288 行数据（24 个月 × 4 区域 × 3 产品线）中，月度销量相对自身 24 个月均值倍数最大的三个组合均出现在 2025-12："\n             "E×Service（1.4134 倍）、S×Service（1.3823 倍）、E×Hardware（1.3434 倍）。"\n             "其中 **E×Service 为孤立尖峰、更像渠道压货**：此前仅 1 个月放量、年末最后一个月跳升、退货率未抬升；"\n             "而 **S×Service 与 E×Hardware 呈连续 2–3 个月的爬坡式放量、退货率均不高于各自 24 个月平均水平，更像真实需求**。"\n             "需要说明的局限是：2025-12 为数据集最后一个月，缺少放量后的后续月份，"\n             "上述判断基于放量前的趋势形态与退货率对照，建议待 2026 年 1–2 月数据到位后复核 E×Service 是否出现退货回冲。")\nlines.append("")\n\nos.makedirs(os.path.dirname(OUT), exist_ok=True)\nwith open(OUT, "w", encoding="utf-8") as f:\n    f.write("\\n".join(lines))\nprint("REPORT SAVED:", os.path.abspath(OUT))\nprint("LINES:", len(lines))\n'} with error:
