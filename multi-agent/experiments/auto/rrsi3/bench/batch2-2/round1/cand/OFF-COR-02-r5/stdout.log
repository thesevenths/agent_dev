import pandas as pd
import numpy as np
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
results = {}
for x, y in pairs:
    sub = df[[x, y]].dropna()
    n = len(sub)
    r, p = stats.pearsonr(sub[x], sub[y])
    results[(x,y)] = dict(n=n, r=r, p=p)
    print(f"{x} vs {y}: n={n}, pearson r={r:.6f}, p={p:.6e}")

# also Spearman for robustness
for x, y in pairs:
    sub = df[[x, y]].dropna()
    rs, ps = stats.spearmanr(sub[x], sub[y])
    print(f"{x} vs {y}: spearman rho={rs:.6f}, p={ps:.6e}")

# save results
import json
out = {f"{x}_vs_{y}": {k: (float(v) if isinstance(v,(int,float,np.floating)) else v) for k,v in v.items()} for (x,y),v in results.items()}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r5\_sandbox\tmp\step2_correlations.json","w") as f:
    json.dump(out, f, indent=2)
print("saved json")

