    "reading_diff_hi_minus_lo": hi["reading_mean"] - lo["reading_mean"],
    "math_diff_pct": (hi["math_mean"] - lo["math_mean"]) / lo["math_mean"] * 100,
    "reading_diff_pct": (hi["reading_mean"] - lo["reading_mean"]) / lo["reading_mean"] * 100,
}
print(diffs)

out = {"groups": res, "diffs": diffs}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r5\_sandbox\tmp\step3_group_stats.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

