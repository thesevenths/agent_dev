import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r1\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

grand_total = float(df["revenue"].sum())
n_months = df["month"].nunique()  # 24

# per-region aggregates
reg = df.groupby("region")["revenue"].agg(total="sum", rows="count")
reg["share"] = reg["total"] / grand_total
reg["monthly_avg"] = reg["total"] / n_months

# monthly sums per region
monthly = df.groupby(["region", "month"])["revenue"].sum().unstack()

top_region = reg["total"].idxmax()
top_row = reg.loc[top_region]

# peak month for top region
peak_month = monthly.loc[top_region].idxmax()
peak_value = float(monthly.loc[top_region, peak_month])

# also overall peak month per region for context
peaks = {r: {"month": str(monthly.loc[r].idxmax()), "value": float(monthly.loc[r].max())} for r in reg.index}

out = {
    "source_file": path,
    "as_of": "2026-10-26 02:20 (local compute time; data covers 2024-01 to 2025-12)",
    "n_months": n_months,
    "grand_total_revenue": grand_total,
    "regions": {
        r: {
            "total_revenue": float(reg.loc[r, "total"]),
            "share_of_grand_total": float(reg.loc[r, "share"]),
            "monthly_avg_revenue": float(reg.loc[r, "monthly_avg"]),
            "rows_used": int(reg.loc[r, "rows"]),
            "peak_month": peaks[r]["month"],
            "peak_month_revenue": peaks[r]["value"],
        }
        for r in ["N", "S", "E", "W"]
    },
    "top_region": {
        "region": top_region,
        "total_revenue": float(top_row["total"]),
        "share_of_grand_total": float(top_row["share"]),
        "monthly_avg_revenue": float(top_row["monthly_avg"]),
        "peak_month": peak_month,
        "peak_month_revenue": peak_value,
    },
    "monthly_revenue_by_region": {r: {m: float(v) for m, v in monthly.loc[r].items()} for r in ["N", "S", "E", "W"]},
}

out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r1\_sandbox\tmp\step2_regional_aggregates.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)

print(json.dumps({k: out[k] for k in ["grand_total_revenue", "n_months", "regions", "top_region"]}, indent=2, ensure_ascii=False))
print("saved:", out_path)

```
