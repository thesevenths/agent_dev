import pandas as pd, os
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r1\_sandbox\tmp"
df = pd.read_csv(os.path.join(base, "step2_per_week_series.csv"))
summ = pd.read_csv(os.path.join(base, "step2_group_summary.csv"))

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
labels = {"retention_d7": "7-Day Retention Rate", "churn_rate": "Churn Rate", "arpu_usd": "ARPU (USD)"}
bp_week = "W37"

# --- 3 line charts, one per metric, breakpoint highlighted ---
for m in metrics:
    fig, ax = plt.subplots(figsize=(9, 4.5))
    x = df["week"].values
    y = df[m].values
    colors = ["#d62728" if w == bp_week else "#1f77b4" for w in x]
    ax.plot(x, y, marker="o", color="#1f77b4", linewidth=1.8, markersize=5, label=m)
    # highlight breakpoint
    bp_idx = list(x).index(bp_week)
    ax.scatter([x[bp_idx]], [y[bp_idx]], color="#d62728", s=120, zorder=5, label=f"Breakpoint {bp_week}")
    ax.axvline(x=bp_idx, color="#d62728", linestyle="--", alpha=0.5)
    # shade pre/post
    ax.axvspan(-0.5, bp_idx - 0.5, alpha=0.06, color="green", label="W30–W36 (pre)")
    ax.axvspan(bp_idx - 0.5, len(x) - 0.5, alpha=0.06, color="red", label="W37–W43 (post)")
    ax.set_title(f"{labels[m]} — W30 to W43 (breakpoint: {bp_week})", fontsize=12, fontweight="bold")
    ax.set_xlabel("Week")
    ax.set_ylabel(labels[m])
    ax.set_xticks(range(len(x)))
    ax.set_xticklabels(x, rotation=45, fontsize=8)
    ax.legend(fontsize=8)
    ax.grid(True, alpha=0.3)
    fig.tight_layout()
    out = os.path.join(base, f"chart_{m}.png")
    fig.savefig(out, dpi=150)
    plt.close(fig)
    print("saved:", out)

# --- grouped bar chart of group means ---
fig, axes = plt.subplots(1, 3, figsize=(12, 4.5))
for i, m in enumerate(metrics):
    row = summ[summ.metric == m].iloc[0]
    bars = axes[i].bar(["W30–W36", "W37–W43"], [row.W30_W36_mean, row.W37_W43_mean],
                       color=["#2ca02c", "#d62728"], width=0.5)
    axes[i].set_title(labels[m], fontsize=11, fontweight="bold")
    axes[i].set_ylabel(labels[m])
    for bar, v in zip(bars, [row.W30_W36_mean, row.W37_W43_mean]):
        axes[i].text(bar.get_x() + bar.get_width()/2, v, f"{v:.4f}", ha="center", va="bottom", fontsize=9)
    axes[i].grid(True, axis="y", alpha=0.3)
fig.suptitle("Group Means: W30–W36 vs W37–W43", fontsize=13, fontweight="bold", y=1.02)
fig.tight_layout()
out = os.path.join(base, "chart_group_means.png")
fig.savefig(out, dpi=150, bbox_inches="tight")
plt.close(fig)
print("saved:", out)

