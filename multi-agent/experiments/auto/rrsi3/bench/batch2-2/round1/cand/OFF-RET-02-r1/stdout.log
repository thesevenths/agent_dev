csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r1\_sandbox\tmp\step2_group_means.csv"

df = pd.read_csv(csv)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
w30_36 = [f"W{i:02d}" for i in range(30, 37)]
w37_43 = [f"W{i:02d}" for i in range(37, 44)]

a = df[df['week'].isin(w30_36)]
b = df[df['week'].isin(w37_43)]

means = pd.DataFrame({
    'group': ['W30-W36', 'W37-W43'],
    'n_rows': [len(a), len(b)],
    'retention_d7_mean': [a['retention_d7'].mean(), b['retention_d7'].mean()],
    'churn_rate_mean': [a['churn_rate'].mean(), b['churn_rate'].mean()],
    'arpu_usd_mean': [a['arpu_usd'].mean(), b['arpu_usd'].mean()],
})
means['retention_d7_diff'] = means['retention_d7_mean'].iloc[1] - means['retention_d7_mean'].iloc[0]
means['churn_rate_diff'] = means['churn_rate_mean'].iloc[1] - means['churn_rate_mean'].iloc[0]
means['arpu_usd_diff'] = means['arpu_usd_mean'].iloc[1] - means['arpu_usd_mean'].iloc[0]
for c in ['retention_d7', 'churn_rate', 'arpu_usd']:
    means[f'{c}_diff_pct'] = means[f'{c}_diff'] / means[f'{c}_mean'].iloc[0] * 100

# per-week table with week-over-week deltas
sub = df[df['week'].isin(w30_36 + w37_43)].copy()
for c in metrics:
    sub[f'{c}_wow'] = sub[c].diff()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')

with pd.ExcelWriter(out, engine='openpyxl') as xw:
    means.to_excel(xw, sheet_name='group_means', index=False)
    sub.to_excel(xw, sheet_name='per_week', index=False)

print(means.to_string(index=False))
print()
print(sub[['week','group','retention_d7','retention_d7_wow','churn_rate','churn_rate_wow','arpu_usd','arpu_usd_wow']].to_string(index=False))
print("\nsaved:", out)

```
