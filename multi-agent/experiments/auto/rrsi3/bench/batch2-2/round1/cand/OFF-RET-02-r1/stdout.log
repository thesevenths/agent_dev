import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r1\_sandbox\tmp"
src = os.path.join(base, "app_metrics_w30_w43.csv")
df = pd.read_csv(src)
df["week_num"] = df["week"].str.extract(r"(\d+)").astype(int)
df = df.sort_values("week_num").reset_index(drop=True)

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# week-over-week absolute change
for m in metrics:
    df[f"{m}_wow"] = df[m].diff()

# breakpoint week: largest |wow| across the 3 metrics (normalized by group std? use raw max abs)
# Use max absolute week-over-week change per metric, then pick week with max across metrics
for m in metrics:
    df[f"{m}_wow_abs"] = df[f"{m}_wow"].abs()
df["max_wow_abs"] = df[["retention_d7_wow_abs","churn_rate_wow_abs","arpu_usd_wow_abs"]].max(axis=1)
bp = df.loc[df["max_wow_abs"].idxmax()]
print("breakpoint week:", bp["week"], "max_wow_abs:", bp["max_wow_abs"])

# group means
g1 = df[df.week_num <= 36]
g2 = df[df.week_num >= 37]
rows = []
for m in metrics:
    m1, m2 = g1[m].mean(), g2[m].mean()
    rows.append({
        "metric": m,
        "W30_W36_mean": round(m1, 6),
        "W37_W43_mean": round(m2, 6),
        "abs_diff": round(m2 - m1, 6),
        "rel_diff_pct": round((m2 - m1) / m1 * 100, 4),
        "n_W30_W36": len(g1),
        "n_W37_W43": len(g2),
    })
summary = pd.DataFrame(rows)
print(summary.to_string(index=False))

# save per-week series
out_week = os.path.join(base, "step2_per_week_series.csv")
df.drop(columns=["week_num"]).to_csv(out_week, index=False)

# save group summary
out_sum = os.path.join(base, "step2_group_summary.csv")
summary.to_csv(out_sum, index=False)

# breakpoint detail
bp_detail = {
    "breakpoint_week": bp["week"],
    "prev_week": df.loc[bp.name - 1, "week"],
    "retention_d7_prev": df.loc[bp.name-1, "retention_d7"],
    "retention_d7_bp": bp["retention_d7"],
    "churn_rate_prev": df.loc[bp.name-1, "churn_rate"],
    "churn_rate_bp": bp["churn_rate"],
    "arpu_usd_prev": df.loc[bp.name-1, "arpu_usd"],
    "arpu_usd_bp": bp["arpu_usd"],
}
print(bp_detail)
with open(os.path.join(base, "step2_breakpoint.json"), "w") as f:
    import json; json.dump(bp_detail, f, indent=2)

print("saved:", out_week)
print("saved:", out_sum)
print(df.to_string(index=False))

