import pandas as pd
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-03-r5\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(p)

med = df['retention_d7'].median()
high = df[df['retention_d7'] > med]
low  = df[df['retention_d7'] <= med]

corr_arpu = df['retention_d7'].corr(df['arpu_usd'])
corr_churn = df['retention_d7'].corr(df['churn_rate'])
# also spearman for reference
from scipy.stats import pearsonr, spearmanr
pr_arpu = pearsonr(df['retention_d7'], df['arpu_usd'])
pr_churn = pearsonr(df['retention_d7'], df['churn_rate'])
sr_arpu = spearmanr(df['retention_d7'], df['arpu_usd'])
sr_churn = spearmanr(df['retention_d7'], df['churn_rate'])

res = pd.DataFrame([
    {"metric":"pearson_corr_retention_d7_vs_arpu_usd","value":round(corr_arpu,6),"n":60,"p_value":round(pr_arpu.pvalue,6)},
    {"metric":"pearson_corr_retention_d7_vs_churn_rate","value":round(corr_churn,6),"n":60,"p_value":round(pr_churn.pvalue,6)},
    {"metric":"spearman_corr_retention_d7_vs_arpu_usd","value":round(sr_arpu.correlation,6),"n":60,"p_value":round(sr_arpu.pvalue,6)},
    {"metric":"spearman_corr_retention_d7_vs_churn_rate","value":round(sr_churn.correlation,6),"n":60,"p_value":round(sr_churn.pvalue,6)},
    {"metric":"retention_d7_median_split","value":med,"n":60,"p_value":""},
    {"metric":"high_group_n","value":len(high),"n":"","p_value":""},
    {"metric":"high_group_mean_arpu_usd","value":round(high['arpu_usd'].mean(),6),"n":len(high),"p_value":""},
    {"metric":"high_group_sum_cohort_size","value":int(high['cohort_size'].sum()),"n":len(high),"p_value":""},
    {"metric":"high_group_mean_retention_d7","value":round(high['retention_d7'].mean(),6),"n":len(high),"p_value":""},
    {"metric":"low_group_n","value":len(low),"n":"","p_value":""},
    {"metric":"low_group_mean_arpu_usd","value":round(low['arpu_usd'].mean(),6),"n":len(low),"p_value":""},
    {"metric":"low_group_sum_cohort_size","value":int(low['cohort_size'].sum()),"n":len(low),"p_value":""},
    {"metric":"low_group_mean_retention_d7","value":round(low['retention_d7'].mean(),6),"n":len(low),"p_value":""},
    {"metric":"arpu_diff_high_minus_low","value":round(high['arpu_usd'].mean()-low['arpu_usd'].mean(),6),"n":"","p_value":""},
    {"metric":"arpu_ratio_high_over_low","value":round(high['arpu_usd'].mean()/low['arpu_usd'].mean(),6),"n":"","p_value":""},
])
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-03-r5\_sandbox\tmp\step2_correlations_group_stats.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

