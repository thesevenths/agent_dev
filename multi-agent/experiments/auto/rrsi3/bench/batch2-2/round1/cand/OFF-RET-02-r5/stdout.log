import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].str.match(r'W(3[0-9]|4[0-3])$')].copy()
sub['group'] = np.where(sub['week'].str.match(r'W3[0-6]$'), 'W30-W36', 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# group means
means = sub.groupby('group')[metrics].mean()
print(means)

# per-week table with diffs
sub['retention_d7_diff'] = sub['retention_d7'].diff()
sub['churn_rate_diff'] = sub['churn_rate'].diff()
sub['arpu_usd_diff'] = sub['arpu_usd'].diff()
print(sub[['week','group','retention_d7','churn_rate','arpu_usd','retention_d7_diff','churn_rate_diff','arpu_usd_diff']].to_string())

# absolute & relative diffs
before = means.loc['W30-W36']; after = means.loc['W37-W43']
abs_diff = after - before
rel_diff = abs_diff / before
print("\nabs diff:\n", abs_diff)
print("\nrel diff:\n", rel_diff)

# breakpoint: week with largest |retention_d7 diff| and largest |churn_rate diff|
