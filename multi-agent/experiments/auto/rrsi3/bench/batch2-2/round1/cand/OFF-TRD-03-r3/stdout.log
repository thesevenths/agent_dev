```python
import pandas as pd
p = "offline_data/regional_sales.csv"
df = pd.read_csv(p)
# completeness checks
print("nulls:", df.isna().sum().sum())
print("months:", sorted(df['month'].unique()))
print("regions:", sorted(df['region'].unique()))
print("product_lines:", sorted(df['product_line'].unique()))
# verify full grid: 24 months x 4 regions x 3 lines = 288
print("grid complete:", df.groupby(['month','region','product_line']).size().eq(1).all())
# revenue consistency check
diff = (df['units']*df['unit_price'] - df['revenue']).abs()
print("max |units*price - revenue|:", diff.max())
# quick aggregates for downstream step
g = df.groupby('region')['revenue'].agg(['sum','count'])
g['share'] = g['sum']/g['sum'].sum()
g['monthly_avg'] = g['sum']/24
print(g)
print("total revenue:", df['revenue'].sum())
# peak month per region
pm = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak = pm.loc[pm.groupby('region')['revenue'].idxmax()]
print(peak)
# overall peak month
print(pm.loc[pm['revenue'].idxmax()])

```
