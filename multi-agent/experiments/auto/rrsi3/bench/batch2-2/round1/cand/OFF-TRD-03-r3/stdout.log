```python
import pandas as pd

p = "offline_data/regional_sales.csv"
df = pd.read_csv(p)

# --- Region-level aggregates ---
g = df.groupby('region')['revenue'].agg(total_revenue='sum', n_rows='count')
total_all = df['revenue'].sum()
g['share_of_total'] = g['total_revenue'] / total_all
g['monthly_avg_revenue'] = g['total_revenue'] / 24  # 24 months: 2024-01..2025-12
g = g.sort_values('total_revenue', ascending=False)
print(g)
print("total_all:", total_all)

# --- Peak month per region ---
pm = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak = pm.loc[pm.groupby('region')['revenue'].idxmax()][['region','month','revenue']]
peak.columns = ['region','peak_month','peak_month_revenue']
print(peak)

# --- Top region ---
top = g.index[0]
top_peak = peak[peak['region']==top].iloc[0]
print("top region:", top, "peak:", top_peak['peak_month'], top_peak['peak_month_revenue'])

# --- Save intermediate CSV ---
out = g.reset_index()
out = out.merge(peak, on='region', how='left')
out = out[['region','total_revenue','share_of_total','monthly_avg_revenue','n_rows','peak_month','peak_month_revenue']]
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"
out_path = out_dir + r"\step2_regional_aggregates.csv"
out.to_csv(out_path, index=False)
print("saved:", out_path)
print(out)

