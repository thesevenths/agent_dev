import pandas as pd
import os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-02-r2\_sandbox\tmp"
os.makedirs(base, exist_ok=True)

# locate csv
cand = os.path.join(base, "offline_data", "students.csv")
if not os.path.exists(cand):
    # try relative
    cand = "offline_data/students.csv"
print("csv path:", cand, os.path.exists(cand))

df = pd.read_csv(cand)
print(df.shape)
print(df["grade"].unique(), df["region"].unique())
print(df["reading_score"].isna().sum())

g = df.groupby(["grade","region"], observed=True)["reading_score"].agg(["count","mean"]).reset_index()
g = g.sort_values(["grade","region"])
print(g.to_string(index=False))

# overall
print("total rows:", len(df), "overall mean:", df["reading_score"].mean())

# max/min
mx = g.loc[g["mean"].idxmax()]
mn = g.loc[g["mean"].idxmin()]
print("MAX:", mx)
print("MIN:", mn)
print("diff:", mx["mean"]-mn["mean"])

# grade / region marginals
print(df.groupby("grade")["reading_score"].agg(["count","mean"]))
print(df.groupby("region")["reading_score"].agg(["count","mean"]))

# save pivot tables
piv_n = df.pivot_table(index="grade", columns="region", values="student_id", aggfunc="count")
piv_m = df.pivot_table(index="grade", columns="region", values="reading_score", aggfunc="mean")
print(piv_n)
print(piv_m.round(2))

g.to_csv(os.path.join(base, "grade_region_summary.csv"), index=False)
print("saved summary")

