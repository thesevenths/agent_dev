import pandas as pd

df = pd.read_csv("offline_data/students.csv")
g = df.groupby(["grade","region"], observed=True)["reading_score"].agg(["count","mean"]).reset_index()
g = g.sort_values(["grade","region"]).reset_index(drop=True)
g.columns = ["grade","region","n","mean_reading_score"]
g["mean_reading_score"] = g["mean_reading_score"].round(4)
print(g.to_string(index=False))
print("total rows:", len(df))
print("overall mean:", round(df["reading_score"].mean(),4))
imax = g["mean_reading_score"].idxmax(); imin = g["mean_reading_score"].idxmin()
print("max:", g.loc[imax].tolist())
print("min:", g.loc[imin].tolist())
print("diff:", round(g.loc[imax,"mean_reading_score"]-g.loc[imin,"mean_reading_score"],4))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-02-r2\_sandbox\tmp"
g.to_csv(out + r"\crosstab_grade_region.csv", index=False)
print("saved")

