```python
import pandas as pd, numpy as np, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-STAT-02-r5\_sandbox"
csv_path = os.path.join(base, "offline_data", "students.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv_path)
m = df["math_score"]; r = df["reading_score"]

pearson = float(np.corrcoef(m, r)[0,1])
# also pandas check
pearson_pd = float(m.corr(r))

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": int(len(df)),
    "n_math": int(m.notna().sum()),
    "n_reading": int(r.notna().sum()),
    "math_score": {
        "mean": float(m.mean()),
        "std_sample": float(m.std(ddof=1)),
        "std_population": float(m.std(ddof=0)),
        "median": float(m.median()),
        "cv_sample": float(m.std(ddof=1)/m.mean()),
        "cv_population": float(m.std(ddof=0)/m.mean()),
        "min": float(m.min()), "max": float(m.max()),
    },
    "reading_score": {
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_population": float(r.std(ddof=0)),
        "median": float(r.median()),
        "cv_sample": float(r.std(ddof=1)/r.mean()),
        "cv_population": float(r.std(ddof=0)/r.mean()),
        "min": float(r.min()), "max": float(r.max()),
    },
    "pearson_r": pearson,
    "pearson_r_pandas": pearson_pd,
}
out_path = os.path.join(out_dir, "stats_results.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out_path)

```
