import json, os

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r2\_sandbox\tmp\step1_validation.json"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r2\_sandbox\tmp"

with open(src, encoding="utf-8") as f:
    d = json.load(f)

CSV = "offline_data/regional_sales.csv"
n_months = d["n_months"]  # 24
grand = d["revenue_sum"]  # 126444439.57

regions = {}
for r in ["N", "S", "E", "W"]:
    total = d["region_totals"][r]
    share = round(total / grand * 100, 4)
    mavg = round(total / n_months, 2)
    monthly = d["monthly_totals"][r]
    peak_month = max(monthly, key=monthly.get)
    peak_val = round(monthly[peak_month], 2)
    regions[r] = {
        "total_revenue": round(total, 2),
        "share_of_grand_total_pct": share,
        "monthly_avg_revenue": mavg,
        "peak_month": peak_month,
        "peak_month_revenue": peak_val,
        "monthly_revenue": {m: round(v, 2) for m, v in monthly.items()},
        "source_annotations": {
            "total_revenue": f"（来源：{CSV} 的 revenue 列，按 region={r} 分组求和，样本 {d['rows_per_region'][r]} 行）",
            "share_of_grand_total_pct": f"（来源：由前述两行计算，{r} 区域合计 ÷ 全公司总营收 × 100%）",
            "monthly_avg_revenue": f"（来源：由前述两行计算，{r} 区域合计 ÷ {n_months} 个月）",
            "peak_month_revenue": f"（来源：{CSV} 的 revenue 列，筛选 region={r} 且 month={peak_month} 的 3 行求和）",
        },
    }

top_region = d["top_region"]
top = regions[top_region]
artifact = {
    "as_of": "2026-10-26 02:23",
    "data_note": "本地离线文件，非实时数据；数据覆盖 2024-01 至 2025-12 共 24 个月",
    "source_file": CSV,
    "n_rows": d["n_rows"],
    "n_months": n_months,
    "grand_total_revenue": round(grand, 2),
    "grand_total_source": f"（来源：{CSV} 的 revenue 列，全部 288 行求和）",
    "grand_monthly_avg": round(grand / n_months, 2),
    "grand_monthly_avg_source": "（来源：由前述两行计算，总营收 ÷ 24 个月）",
    "regions": regions,
    "top_region": {
        "region": top_region,
        "total_revenue": top["total_revenue"],
        "total_revenue_source": top["source_annotations"]["total_revenue"],
        "peak_month": top["peak_month"],
        "peak_month_revenue": top["peak_month_revenue"],
        "peak_month_revenue_source": top["source_annotations"]["peak_month_revenue"],
        "runner_up": {
            "region": "S",
            "total_revenue": regions["S"]["total_revenue"],
            "gap": round(top["total_revenue"] - regions["S"]["total_revenue"], 2),
            "gap_source": "（来源：由前述两行计算，E 区域合计 − S 区域合计）",
        },
    },
    "overall_peak_month": {
        "month": max(d["overall_monthly"], key=d["overall_monthly"].get),
        "revenue": round(max(d["overall_monthly"].values()), 2),
        "source": f"（来源：{CSV} 的 revenue 列，按 month 分组求和，24 个月中取最大）",
    },
}

out_path = os.path.join(out_dir, "regional_aggregates.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(artifact, f, ensure_ascii=False, indent=2)

print("written:", os.path.abspath(out_path))
print(json.dumps({k: v for k, v in artifact.items() if k != "regions"}, ensure_ascii=False, indent=2))
for r, v in regions.items():
    print(r, v["total_revenue"], v["share_of_grand_total_pct"], v["monthly_avg_revenue"], v["peak_month"], v["peak_month_revenue"])

