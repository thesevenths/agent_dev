```python
import pandas as pd, json

df = pd.read_csv('offline_data/regional_sales.csv')
grand_total = df['revenue'].sum()

out = {"as_of": "2026-10-25 06:06",
       "source": "offline_data/regional_sales.csv",
       "n_months": int(df['month'].nunique()),
       "grand_total": round(float(grand_total), 2),
       "regions": []}

for region in ['N', 'S', 'E', 'W']:
    sub = df[df['region'] == region]
    total = float(sub['revenue'].sum())
    monthly = sub.groupby('month')['revenue'].sum()
    peak_month = monthly.idxmax()
    out["regions"].append({
        "region": region,
        "total_revenue": round(total, 2),
        "share_pct": round(total / grand_total * 100, 4),
        "monthly_avg": round(total / 24, 2),
        "peak_month": peak_month,
        "peak_month_revenue": round(float(monthly.max()), 2),
        "n_rows": int(len(sub)),
    })

top = max(out["regions"], key=lambda r: r["total_revenue"])
out["top_region"] = top["region"]
out["top_region_peak_month"] = top["peak_month"]

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r2\_sandbox\tmp\regional_aggregates.json"
with open(path, 'w', encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", path)

```
