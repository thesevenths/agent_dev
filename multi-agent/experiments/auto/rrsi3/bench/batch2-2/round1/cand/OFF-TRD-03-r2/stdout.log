import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-TRD-03-r2\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

info = {
    "file": os.path.abspath(path),
    "columns": list(df.columns),
    "dtypes": {c: str(t) for c, t in df.dtypes.items()},
    "n_rows": len(df),
    "n_cols": df.shape[1],
    "regions": sorted(df["region"].unique().tolist()),
    "months": [df["month"].min(), df["month"].max()],
    "n_months": df["month"].nunique(),
    "product_lines": sorted(df["product_line"].unique().tolist()),
    "null_counts": df.isna().sum().to_dict(),
    "dup_rows": int(df.duplicated().sum()),
    "revenue_min": float(df["revenue"].min()),
    "revenue_max": float(df["revenue"].max()),
    "revenue_sum": float(df["revenue"].sum()),
    "rows_per_region": df.groupby("region")["revenue"].count().to_dict(),
    "rows_per_month": df.groupby("month")["revenue"].count().to_dict(),
}

# sanity: revenue == units * unit_price?
df["calc"] = df["units"] * df["unit_price"]
info["max_abs_rev_diff"] = float((df["revenue"] - df["calc"]).abs().max())

# region totals
g = df.groupby("region")["revenue"].sum()
info["region_totals"] = g.to_dict()
info["region_share"] = (g / g.sum() * 100).round(4).to_dict()
info["region_monthly_avg"] = (g / df["month"].nunique()).round(2).to_dict()

# monthly totals per region
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
info["monthly_totals"] = piv.round(2).to_dict()
top_region = g.idxmax()
top_month = piv[top_region].idxmax()
info["top_region"] = top_region
info["top_region_peak_month"] = top_month
info["top_region_peak_value"] = float(piv.loc[top_month, top_region])

# overall monthly totals
info["overall_monthly"] = df.groupby("month")["revenue"].sum().round(2).to_dict()

with open(os.path.join(out_dir, "step1_validation.json"), "w", encoding="utf-8") as f:
    json.dump(info, f, ensure_ascii=False, indent=2)

print(json.dumps(info, ensure_ascii=False, indent=2))

```
