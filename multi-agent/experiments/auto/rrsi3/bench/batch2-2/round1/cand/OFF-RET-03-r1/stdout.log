import pandas as pd
import numpy as np

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-03-r1\_sandbox\offline_data\app_metrics.csv")

# Correlations (Pearson)
corr_arpu = df['retention_d7'].corr(df['arpu_usd'])
corr_churn = df['retention_d7'].corr(df['churn_rate'])

# Median split
med = df['retention_d7'].median()
high = df[df['retention_d7'] > med]
low = df[df['retention_d7'] < med]
eq = df[df['retention_d7'] == med]
print("median:", med, "n_high:", len(high), "n_low:", len(low), "n_eq:", len(eq))

res = pd.DataFrame([
    {"metric": "retention_d7_median", "value": med, "n_rows": len(df)},
    {"metric": "pearson_retention_d7_vs_arpu_usd", "value": corr_arpu, "n_rows": len(df)},
    {"metric": "pearson_retention_d7_vs_churn_rate", "value": corr_churn, "n_rows": len(df)},
    {"metric": "high_group_n", "value": len(high), "n_rows": len(high)},
    {"metric": "high_group_arpu_usd_mean", "value": high['arpu_usd'].mean(), "n_rows": len(high)},
    {"metric": "high_group_cohort_size_sum", "value": high['cohort_size'].sum(), "n_rows": len(high)},
    {"metric": "low_group_n", "value": len(low), "n_rows": len(low)},
    {"metric": "low_group_arpu_usd_mean", "value": low['arpu_usd'].mean(), "n_rows": len(low)},
    {"metric": "low_group_cohort_size_sum", "value": low['cohort_size'].sum(), "n_rows": len(low)},
])
