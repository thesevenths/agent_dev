import pandas as pd
import numpy as np

OUT = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-03-r1\_sandbox\tmp"

df = pd.read_csv("offline_data/app_metrics.csv")
print(df.shape)
print(df.dtypes)
print(df.isna().sum())
print(df.describe().T)

# validation: numeric ranges
assert (df["retention_d7"].between(0,1)).all()
assert (df["churn_rate"].between(0,1)).all()
assert (df["cohort_size"] > 0).all()
assert (df["arpu_usd"] > 0).all()
assert df["week"].is_unique

# correlations
corr_ra = df["retention_d7"].corr(df["arpu_usd"])
corr_rc = df["retention_d7"].corr(df["churn_rate"])
print("corr retention_d7 vs arpu_usd:", corr_ra)
print("corr retention_d7 vs churn_rate:", corr_rc)

med = df["retention_d7"].median()
print("median retention_d7:", med)
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]
print("hi n:", len(hi), "arpu mean:", hi["arpu_usd"].mean(), "cohort total:", hi["cohort_size"].sum())
print("lo n:", len(lo), "arpu mean:", lo["arpu_usd"].mean(), "cohort total:", lo["cohort_size"].sum())

# save cleaned copy + summary
df.to_csv(OUT + r"\app_metrics_clean.csv", index=False)
summary = pd.DataFrame({
    "metric": ["n_rows","n_cols","corr_retention_d7_arpu_usd","corr_retention_d7_churn_rate",
               "median_retention_d7","hi_group_n","hi_group_arpu_mean","hi_group_cohort_total",
               "lo_group_n","lo_group_arpu_mean","lo_group_cohort_total"],
    "value": [len(df), len(df.columns), corr_ra, corr_rc, med,
              len(hi), hi["arpu_usd"].mean(), int(hi["cohort_size"].sum()),
              len(lo), lo["arpu_usd"].mean(), int(lo["cohort_size"].sum())]
})
summary.to_csv(OUT + r"\step1_summary.csv", index=False)
print(summary.to_string(index=False))

