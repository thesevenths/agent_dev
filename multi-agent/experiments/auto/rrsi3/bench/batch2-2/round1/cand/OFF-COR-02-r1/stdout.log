import pandas as pd
df = pd.read_csv("offline_data/students.csv")
sub = df[["screen_hours_per_day","math_score","reading_score"]].dropna()
n = len(sub)
r_math = sub["screen_hours_per_day"].corr(sub["math_score"])
r_read = sub["screen_hours_per_day"].corr(sub["reading_score"])
print("n =", n)
print("r(math) =", r_math)
print("r(reading) =", r_read)
# also pearson p-values for context
from scipy import stats
print(stats.pearsonr(sub["screen_hours_per_day"], sub["math_score"]))
print(stats.pearsonr(sub["screen_hours_per_day"], sub["reading_score"]))

