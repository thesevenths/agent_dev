path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

df["group"] = df["screen_hours_per_day"].apply(lambda v: "high(>5)" if v > 5 else "low(<=5)")
g = df.groupby("group").agg(
    n=("math_score", "size"),
    mean_screen=("screen_hours_per_day", "mean"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
)
low = g.loc["low(<=5)"]; high = g.loc["high(>5)"]

result = {
    "source_file": path,
    "split_rule": "high: screen_hours_per_day > 5; low: screen_hours_per_day <= 5",
    "groups": {
        "low(<=5)": {k: (int(v) if k == "n" else float(v)) for k, v in low.items()},
        "high(>5)": {k: (int(v) if k == "n" else float(v)) for k, v in high.items()},
    },
    "mean_differences_high_minus_low": {
        "math_score": float(high["mean_math"] - low["mean_math"]),
        "reading_score": float(high["mean_reading"] - low["mean_reading"]),
    },
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step3_group_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

