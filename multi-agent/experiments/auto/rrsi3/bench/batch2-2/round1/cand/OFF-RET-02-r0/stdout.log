import pandas as pd

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r0\_sandbox\tmp"
df = pd.read_csv(p)

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
w30_36 = [f"W{i:02d}" for i in range(30, 37)]
w37_43 = [f"W{i:02d}" for i in range(37, 44)]

a = df[df['week'].isin(w30_36)]
b = df[df['week'].isin(w37_43)]
print("rows A:", len(a), "rows B:", len(b))

means = pd.DataFrame({
    'group': ['W30-W36', 'W37-W43'],
    'n': [len(a), len(b)],
    'retention_d7_mean': [a['retention_d7'].mean(), b['retention_d7'].mean()],
    'churn_rate_mean': [a['churn_rate'].mean(), b['churn_rate'].mean()],
    'arpu_usd_mean': [a['arpu_usd'].mean(), b['arpu_usd'].mean()],
})
means['retention_d7_diff'] = means['retention_d7_mean'].iloc[1] - means['retention_d7_mean'].iloc[0]
means['churn_rate_diff'] = means['churn_rate_mean'].iloc[1] - means['churn_rate_mean'].iloc[0]
means['arpu_usd_diff'] = means['arpu_usd_mean'].iloc[1] - means['arpu_usd_mean'].iloc[0]
means['retention_d7_rel_pct'] = means['retention_d7_diff'] / means['retention_d7_mean'].iloc[0] * 100
means['churn_rate_rel_pct'] = means['churn_rate_diff'] / means['churn_rate_mean'].iloc[0] * 100
means['arpu_usd_rel_pct'] = means['arpu_usd_diff'] / means['arpu_usd_mean'].iloc[0] * 100
print(means.to_string(index=False))

# per-week table with week-over-week deltas
sub = df[df['week'].isin(w30_36 + w37_43)].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')
for m in metrics:
    sub[f'{m}_wow'] = sub[m].diff()
sub.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
print(sub.to_string(index=False))

```
