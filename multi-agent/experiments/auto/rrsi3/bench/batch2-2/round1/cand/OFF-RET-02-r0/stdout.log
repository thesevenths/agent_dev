```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-RET-02-r0\_sandbox\tmp\step2_group_means.csv"

df = pd.read_csv(src)
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
sub["group"] = sub.week.apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week table with group
weekly = sub[["week", "group"] + metrics].copy()

# group means
g = sub.groupby("group")[metrics].mean().reset_index()
g.columns = ["group"] + [f"{m}_mean" for m in metrics]
g["n_weeks"] = sub.groupby("group").size().values

# deltas (after - before) and relative change
before = g[g.group == "W30-W36"].iloc[0]
after = g[g.group == "W37-W43"].iloc[0]
rows = []
for m in metrics:
    b, a = before[f"{m}_mean"], after[f"{m}_mean"]
    rows.append({"metric": m, "before_mean": round(b, 6), "after_mean": round(a, 6),
                 "delta_abs": round(a - b, 6), "delta_rel_pct": round((a - b) / b * 100, 4)})
delta = pd.DataFrame(rows)

# breakpoint detection: largest week-over-week absolute change in each metric within W30-W43
sub = sub.sort_values("week").reset_index(drop=True)
wow = sub[metrics].diff().abs()
bp = {m: sub.loc[wow[m].idxmax(), "week"] for m in metrics}
print("breakpoint week (largest WoW jump):", bp)

# combined score: z-score each metric across W30-W43, sum abs z of WoW change
z = (wow - wow.mean()) / wow.std()
score = z.sum(axis=1)
bp_combined = sub.loc[score.idxmax(), "week"]
print("combined breakpoint week:", bp_combined)

# save combined CSV: weekly + group means + deltas
with open(out, "w", index=False) as f:
    f.write("# STEP 2 intermediate results\n")
    f.write(f"# AS_OF: 2026-10-25 05:46 (local); source file last modified 2026-10-23 10:11 (offline snapshot)\n")
    f.write("# source: offline_data/app_metrics.csv\n\n")
    f.write("## per-week (W30-W43)\n")
    weekly.to_csv(f, index=False)
    f.write("\n## group means\n")
    g.to_csv(f, index=False)
    f.write("\n## deltas (after - before)\n")
    delta.to_csv(f, index=False)
    f.write("\n## breakpoint detection\n")
    pd.DataFrame([{"metric": m, "breakpoint_week": w} for m, w in bp.items()]).to_csv(f, index=False)
    f.write(f"\ncombined_breakpoint_week,{bp_combined}\n")

print(weekly.to_string(index=False))
print(g.to_string(index=False))
print(delta.to_string(index=False))
print("saved:", out)

```
