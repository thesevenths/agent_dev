import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
print(df.shape)
print(df["tutoring"].value_counts())
print(df["math_score"].isna().sum())

g = df.groupby("tutoring")["math_score"]
n0, n1 = g.count()
m0, m1 = g.mean()
s0, s1 = g.std(ddof=1)
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled**0.5
diff = m1 - m0
d = diff / pooled_std

res = {
  "n_tutoring0": int(n0), "n_tutoring1": int(n1),
  "mean_tutoring0": float(m0), "mean_tutoring1": float(m1),
  "std_tutoring0": float(s0), "std_tutoring1": float(s1),
  "pooled_std": float(pooled_std),
  "mean_diff": float(diff),
  "cohens_d": float(d),
  "total_rows": int(len(df)),
}
print(json.dumps(res, indent=2))

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\cand\OFF-GRP-01-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
with open(os.path.join(out_dir, "group_stats.json"), "w") as f:
    json.dump(res, f, indent=2)
