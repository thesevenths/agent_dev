import pandas as pd, json

path = "offline_data/students.csv"
df = pd.read_csv(path)
g = df.groupby("tutoring")["math_score"]
n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std(ddof=1)[0]), float(g.std(ddof=1)[1])
diff = m1 - m0
pooled_var = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled = pooled_var ** 0.5
d = diff / pooled
print("pooled_var:", pooled_var, "pooled_std:", pooled, "d:", d)

