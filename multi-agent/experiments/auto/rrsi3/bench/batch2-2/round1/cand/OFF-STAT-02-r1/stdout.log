import pandas as pd, numpy as np

df = pd.read_csv("offline_data/students.csv")
print(df.head())
print(df.shape)
print(df.dtypes)
print("nulls:", df[['math_score','reading_score']].isna().sum().to_dict())

m = df['math_score']; r = df['reading_score']
stats = {
 'math_mean': m.mean(), 'math_std': m.std(ddof=1), 'math_median': m.median(),
 'read_mean': r.mean(), 'read_std': r.std(ddof=1), 'read_median': r.median(),
 'pearson': m.corr(r),
 'cv_math': m.std(ddof=1)/m.mean(), 'cv_read': r.std(ddof=1)/r.mean(),
}
for k,v in stats.items(): print(k, v)
print("n =", len(df))

```
