import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-TRD-01-r1\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-TRD-01-r1\_sandbox\tmp"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]
df['mm'] = df['month'].str[5:7]

# Monthly revenue aggregation
monthly = df.groupby(['year','month']).agg(
    revenue=('revenue','sum'),
    units=('units','sum'),
    rows=('revenue','size')
).reset_index()

# Annual totals
annual = df.groupby('year').agg(
    revenue=('revenue','sum'),
    units=('units','sum'),
    rows=('revenue','size')
).reset_index()

r2024 = annual.loc[annual.year=='2024','revenue'].iloc[0]
r2025 = annual.loc[annual.year=='2025','revenue'].iloc[0]
yoy = (r2025 - r2024) / r2024

annual['revenue_yoy'] = ''
annual.loc[annual.year=='2024','revenue_yoy'] = 'base'
annual.loc[annual.year=='2025','revenue_yoy'] = f"{yoy*100:.4f}%"

print(monthly.to_string(index=False))
print()
print(annual.to_string(index=False))
print(f"\nYoY growth: {yoy:.6f} = {yoy*100:.4f}%")
print(f"2024 revenue: {r2024:,.2f}")
print(f"2025 revenue: {r2025:,.2f}")
print(f"delta: {r2025-r2024:,.2f}")

# Save intermediate CSVs
monthly.to_csv(f"{out_dir}\\step2_monthly_revenue.csv", index=False)
annual.to_csv(f"{out_dir}\\step2_annual_revenue_yoy.csv", index=False)
print("\nSaved step2_monthly_revenue.csv and step2_annual_revenue_yoy.csv")

