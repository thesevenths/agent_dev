import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-TRD-01-r1\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-TRD-01-r1\_sandbox\tmp"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]
df['mm'] = df['month'].str[5:7].astype(int)

rows = []
for year in ['2024','2025']:
    d = df[df.year==year]
    nd = d[d.mm.isin([11,12])]
    rest = d[~d.mm.isin([11,12])]
    nd_units = nd['units'].sum()
    rest_units = rest['units'].sum()
    nd_avg = nd_units / 2
    rest_avg = rest_units / 10
    mult = nd_avg / rest_avg
    rows.append({
        'year': year,
        'nov_dec_units_total': nd_units,
        'nov_dec_months': 2,
        'nov_dec_avg_units_per_month': round(nd_avg, 2),
        'other_months_units_total': rest_units,
        'other_months_count': 10,
        'other_months_avg_units_per_month': round(rest_avg, 2),
        'amplification_multiplier': round(mult, 4),
        'nov_dec_rows': len(nd),
        'other_months_rows': len(rest),
    })
    print(f"{year}: Nov-Dec total={nd_units:,} (avg {nd_avg:,.2f}/mo), "
          f"other 10mo total={rest_units:,} (avg {rest_avg:,.2f}/mo), "
          f"multiplier={mult:.4f}")

res = pd.DataFrame(rows)
res.to_csv(f"{out_dir}\\step3_nov_dec_multiplier.csv", index=False)
print("\nSaved step3_nov_dec_multiplier.csv")
print(res.to_string(index=False))

```
