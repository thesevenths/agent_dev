import pandas as pd
import numpy as np
import json
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\cand\OFF-COR-03-r0\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\cand\OFF-COR-03-r0\_sandbox\tmp"

df = pd.read_csv(path)
cols = ["math_score", "study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
n = len(df)

# Pearson correlation matrix
corr = df[cols].corr(method="pearson")
print("CORR MATRIX:\n", corr.to_string())

# correlation p-values for math_score vs each predictor
corr_p = {}
for c in cols[1:]:
    r, p = stats.pearsonr(df["math_score"], df[c])
    corr_p[c] = {"r": r, "p": p}
print("\nCORR P:\n", json.dumps(corr_p, indent=2))

# Simple OLS: math_score ~ x
results = []
for c in cols[1:]:
    x = df[c].astype(float).values
    y = df["math_score"].astype(float).values
    res = stats.linregress(x, y)
    results.append({
        "variable": c,
        "slope": res.slope,
        "intercept": res.intercept,
        "r_value": res.rvalue,
        "r_squared": res.rvalue**2,
        "p_value": res.pvalue,
        "std_err_slope": res.stderr,
        "n": n,
    })
    print(f"\n{c}: slope={res.slope:.6f}, intercept={res.intercept:.4f}, R2={res.rvalue**2:.4f}, p={res.pvalue:.3e}, stderr={res.stderr:.4f}")

# Also compute correlation matrix p-values for all pairs
from itertools import combinations
pair_p = {}
for a, b in combinations(cols, 2):
    r, p = stats.pearsonr(df[a], df[b])
    pair_p[f"{a}~{b}"] = {"r": r, "p": p}

artifact = {
    "as_of": "2026-10-25 06:42",
    "source_file": "offline_data/students.csv",
    "n": n,
    "correlation_matrix": corr.to_dict(),
    "correlation_pvalues": pair_p,
    "regressions": results,
}
json_path = out_dir + r"\step2_stats.json"
with open(json_path, "w", encoding="utf-8") as f:
    json.dump(artifact, f, indent=2, ensure_ascii=False)

# also CSV of regressions
pd.DataFrame(results).to_csv(out_dir + r"\step2_regressions.csv", index=False)
print("\nSaved:", json_path)
print("Saved:", out_dir + r"\step2_regressions.csv")

