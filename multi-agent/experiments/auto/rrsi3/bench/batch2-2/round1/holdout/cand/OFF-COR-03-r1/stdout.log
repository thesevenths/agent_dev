```python
import pandas as pd, numpy as np, os

df = pd.read_csv("offline_data/students.csv")
preds = ["study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
y = "math_score"

# Pearson correlation matrix (math_score vs each predictor + among predictors)
cols = [y] + preds
corr = df[cols].corr(method="pearson")

# Simple OLS: y = a + b*x  -> b = cov(x,y)/var(x)
rows = []
for x in preds:
    xv, yv = df[x].astype(float), df[y].astype(float)
    b = np.cov(xv, yv, ddof=1)[0,1] / xv.var(ddof=1)
    a = yv.mean() - b*xv.mean()
    r = np.corrcoef(xv, yv)[0,1]
    rows.append({"predictor": x, "slope_per_unit": round(b,4), "intercept": round(a,4),
                 "pearson_r": round(r,4), "r2": round(r**2,4), "n": len(df)})
res = pd.DataFrame(rows)
print(corr.round(4))
print(res.to_string(index=False))

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\cand\OFF-COR-03-r1\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
corr.to_csv(os.path.join(out_dir, "step2_correlation_matrix.csv"), float_format="%.6f")
res.to_csv(os.path.join(out_dir, "step2_regression_slopes.csv"), index=False, float_format="%.6f")
print("saved")

