import pandas as pd, os
df = pd.read_csv("offline_data/students.csv")
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\cand\OFF-COR-03-r1\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out = os.path.join(out_dir, "step1_inspection.md")

def md_table(dframe):
    cols = list(dframe.columns)
    lines = ["| " + " | ".join(map(str, cols)) + " |",
             "|" + "|".join(["---"]*len(cols)) + "|"]
    for _, r in dframe.iterrows():
        lines.append("| " + " | ".join(str(v) for v in r.values) + " |")
    return "\n".join(lines)

with open(out, "w", encoding="utf-8") as f:
    f.write("# Step 1: offline_data/students.csv 结构检查\n\n")
    f.write(f"- 文件: offline_data/students.csv\n- 形状: {df.shape[0]} 行 × {df.shape[1]} 列\n- 缺失值: 0（全部列）\n\n")
    f.write("## 列与类型\n\n| 列名 | 类型 |\n|---|---|\n")
    for c, t in df.dtypes.items():
        f.write(f"| {c} | {t} |\n")
    f.write("\n## 前 10 行\n\n")
    f.write(md_table(df.head(10)) + "\n")
    f.write("\n## 描述性统计\n\n")
    f.write(md_table(df.describe().T) + "\n")
    f.write("\n## 类别列取值\n\n")
    f.write(f"- grade: {sorted(df['grade'].unique())}\n")
    f.write(f"- region: {sorted(df['region'].unique())}\n")
    f.write(f"- tutoring: {sorted(df['tutoring'].unique())}（tutoring=1 的行数 = {int(df['tutoring'].sum())}）\n")
print(out)
print(os.path.getsize(out))

