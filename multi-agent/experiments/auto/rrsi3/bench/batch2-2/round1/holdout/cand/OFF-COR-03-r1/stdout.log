import pandas as pd, numpy as np, os

df = pd.read_csv("offline_data/students.csv")
preds = ["study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
y = "math_score"

# exact numbers for the report
stats = {c: (df[c].mean(), df[c].std(ddof=1), df[c].min(), df[c].max()) for c in [y]+preds}
for c, v in stats.items():
    print(c, [round(x,4) for x in v])

corr = df[[y]+preds].corr(method="pearson")
print(corr.round(4).to_string())

rows = []
for x in preds:
    xv, yv = df[x].astype(float), df[y].astype(float)
    b = np.cov(xv, yv, ddof=1)[0,1]/xv.var(ddof=1)
    a = yv.mean()-b*xv.mean()
    r = np.corrcoef(xv, yv)[0,1]
    rows.append((x, b, a, r, r**2))
    print(x, round(b,4), round(a,4), round(r,4), round(r**2,4))

# extra derived: tutoring mean diff
print("tutoring=1 mean math:", df.loc[df.tutoring==1, y].mean(), "n=", (df.tutoring==1).sum())
print("tutoring=0 mean math:", df.loc[df.tutoring==0, y].mean(), "n=", (df.tutoring==0).sum())
print("study hours range:", df.study_hours_per_week.min(), df.study_hours_per_week.max())
print("screen range:", df.screen_hours_per_day.min(), df.screen_hours_per_day.max())
print("attendance range:", df.attendance_pct.min(), df.attendance_pct.max())
# slope ratio tutoring vs study
b_study = rows[0][1]; b_tut = rows[2][1]
print("ratio tutoring/study slope:", round(b_tut/b_study,3))
print("n =", len(df))

