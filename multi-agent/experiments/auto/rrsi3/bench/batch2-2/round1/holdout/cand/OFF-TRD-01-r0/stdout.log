```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\cand\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)
df['y'] = df['month'].str[:4]
df['m'] = df['month'].str[5:7].astype(int)

rev = df.groupby('y')['revenue'].sum()
units = df.groupby('y')['units'].sum()
print(rev, units)
print("YoY:", rev['2025']/rev['2024']-1)

for y in ['2024','2025']:
    d = df[df['y']==y]
    nd = d[d['m'].isin([11,12])]['units'].sum()
    ot = d[~d['m'].isin([11,12])]['units'].sum()
    nd_avg = d[d['m'].isin([11,12])].groupby('month')['units'].sum().mean()
    ot_avg = d[~d['m'].isin([11,12])].groupby('month')['units'].sum().mean()
    print(y, "nd", nd, "ot", ot, "nd_avg", nd_avg, "ot_avg", ot_avg, "ratio", nd_avg/ot_avg)

# monthly revenue table for the report
mr = df.groupby('month').agg(rev=('revenue','sum'), units=('units','sum'))
print(mr.to_string())

