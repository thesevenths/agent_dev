import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\cand\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

# verify revenue = units * unit_price
diff = (df['revenue'] - df['units']*df['unit_price']).abs()
print("max |revenue - units*unit_price|:", diff.max())

# months per year
print(df.groupby(df['month'].str[:4]).size())

# consistency: 12 months x 4 regions x 3 lines = 144 per year
print("rows per month:", df.groupby('month').size().unique())

# quick aggregates for downstream
rev = df.groupby(df['month'].str[:4])['revenue'].sum()
print("\nannual revenue:\n", rev)
print("\nYoY 2025 vs 2024: {:.4%}".format(rev['2025']/rev['2024']-1))

units = df.groupby(df['month'].str[:4])['units'].sum()
print("\nannual units:\n", units)

# Nov-Dec vs other months amplification (units)
df['m'] = df['month'].str[5:7].astype(int)
for y in ['2024','2025']:
    d = df[df['month'].str[:4]==y]
    nd = d[d['m'].isin([11,12])]['units'].sum()
    ot = d[~d['m'].isin([11,12])]['units'].sum()
    nd_avg = d[d['m'].isin([11,12])].groupby('month')['units'].sum().mean()
    ot_avg = d[~d['m'].isin([11,12])].groupby('month')['units'].sum().mean()
    print(f"{y}: NovDec total={nd}, other total={ot}, ratio(total)={nd/ot:.4f}, monthly avg NovDec={nd_avg:.1f}, monthly avg other={ot_avg:.1f}, ratio(monthly avg)={nd_avg/ot_avg:.4f}")

# monthly units table
print("\nmonthly units:\n", df.groupby('month')['units'].sum())

