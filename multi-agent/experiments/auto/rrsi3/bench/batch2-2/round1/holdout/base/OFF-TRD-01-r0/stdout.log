import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

# completeness checks
months = sorted(df["month"].unique())
print("months:", months[0], "->", months[-1], "count:", len(months))
print("rows per month:", df.groupby("month").size().unique())
print("rows per region:", df.groupby("region").size().to_dict())
print("rows per product_line:", df.groupby("product_line").size().to_dict())

# consistency: revenue vs units*unit_price
diff = (df["revenue"] - df["units"]*df["unit_price"]).abs()
print("max |revenue - units*unit_price|:", diff.max())

# quick aggregates for downstream
df["year"] = df["month"].str[:4]
print("\nAnnual revenue:\n", df.groupby("year")["revenue"].sum())
print("\nAnnual units:\n", df.groupby("year")["units"].sum())
df["month_num"] = df["month"].str[5:7].astype(int)
df["is_q4"] = df["month_num"].isin([11,12])
print("\nUnits by year & is_q4:\n", df.groupby(["year","is_q4"])["units"].sum())
print("\nMonthly units (2025):\n", df[df.year=="2025"].groupby("month")["units"].sum())

