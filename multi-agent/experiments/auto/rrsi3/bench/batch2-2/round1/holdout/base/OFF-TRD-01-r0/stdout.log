import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-TRD-01-r0\_sandbox\tmp\step3_novdec_multiplier.csv"

df = pd.read_csv(src)
df["year"] = df["month"].str[:4]
df["month_num"] = df["month"].str[5:7].astype(int)
df["period"] = df["month_num"].apply(lambda m: "Nov-Dec" if m in (11, 12) else "Jan-Oct")

rows = []
for year, ydf in df.groupby("year"):
    for period, pdf in ydf.groupby("period"):
        n_months = pdf["month"].nunique()
        total_units = int(pdf["units"].sum())
        rows.append({
            "year": year,
            "period": period,
            "n_months": n_months,
            "total_units": total_units,
            "avg_monthly_units": total_units / n_months,
            "row_count": len(pdf),
        })

res = pd.DataFrame(rows)
# amplification multiplier per year
for year in res["year"].unique():
    nd = res[(res.year == year) & (res.period == "Nov-Dec")]["avg_monthly_units"].iloc[0]
    jo = res[(res.year == year) & (res.period == "Jan-Oct")]["avg_monthly_units"].iloc[0]
    res.loc[(res.year == year) & (res.period == "Nov-Dec"), "amplification_multiplier"] = nd / jo

res.to_csv(out, index=False, float_format="%.4f")
print(res.to_string(index=False))
print("\nSaved to:", out)

```
