import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
print(df.shape)
print(df.dtypes)
print("nulls:", df.isna().sum().sum())
print("month range:", df["month"].min(), "->", df["month"].max())
print("months per year:")
print(df.groupby(df["month"].str[:4])["month"].nunique())
print("regions:", sorted(df["region"].unique()))
print("product lines:", sorted(df["product_line"].unique()))
print("dup (month,region,product_line):", df.duplicated(subset=["month","region","product_line"]).sum())
# consistency check revenue vs units*unit_price
diff = (df["revenue"] - df["units"]*df["unit_price"]).abs()
print("max |revenue - units*price|:", diff.max())
print("rows per month:", df.groupby("month").size().min(), df.groupby("month").size().max())

```
