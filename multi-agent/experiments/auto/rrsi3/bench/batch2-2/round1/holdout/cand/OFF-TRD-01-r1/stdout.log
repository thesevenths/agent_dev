import pandas as pd

m = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\cand\OFF-TRD-01-r1\_sandbox\tmp\step2_monthly_revenue.csv")
m["year"] = m["month"].str[:4]
m["mm"] = m["month"].str[5:7].astype(int)

rows = []
for year, sub in m.groupby("year"):
    nd = sub[sub.mm.isin([11,12])]
    other = sub[~sub.mm.isin([11,12])]
    nd_avg = nd["units"].mean()
    other_avg = other["units"].mean()
    rows.append({
        "year": year,
        "novdec_months": ",".join(nd["month"]),
        "novdec_units_sum": int(nd["units"].sum()),
        "novdec_units_avg": round(nd_avg,1),
        "other_months": "01-10",
        "other_units_sum": int(other["units"].sum()),
        "other_units_avg": round(other_avg,1),
        "multiplier": round(nd_avg/other_avg,4),
        "novdec_rows": int(len(nd)*12),
        "other_rows": int(len(other)*12),
    })

# combined
nd = m[m.mm.isin([11,12])]; other = m[~m.mm.isin([11,12])]
rows.append({
    "year":"2024+2025",
    "novdec_months":"2024-11,2024-12,2025-11,2025-12",
    "novdec_units_sum": int(nd["units"].sum()),
    "novdec_units_avg": round(nd["units"].mean(),1),
    "other_months":"01-10 (both years)",
    "other_units_sum": int(other["units"].sum()),
    "other_units_avg": round(other["units"].mean(),1),
    "multiplier": round(nd["units"].mean()/other["units"].mean(),4),
    "novdec_rows": int(len(nd)*12),
    "other_rows": int(len(other)*12),
})

out = pd.DataFrame(rows)
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\cand\OFF-TRD-01-r1\_sandbox\tmp\step3_novdec_multiplier.csv", index=False)
print(out.to_string(index=False))

