import pandas as pd
import numpy as np
from scipy import stats
import os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-COR-03-r1\_sandbox"
csv = os.path.join(base, "offline_data", "students.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv)
targets = ["math_score", "study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
n = len(df)

# 1) Pearson correlation matrix
corr = df[targets].corr(method="pearson")
print("Correlation matrix:")
print(corr.round(4).to_string())

# 2) Simple OLS regressions: math_score ~ each predictor
results = []
for x in targets[1:]:
    res = stats.linregress(df[x], df["math_score"])
    results.append({
        "predictor": x,
        "slope": res.slope,
        "intercept": res.intercept,
        "r_value": res.rvalue,
        "r_squared": res.rvalue**2,
        "p_value": res.pvalue,
        "stderr_slope": res.stderr,
        "n": n,
    })
    print(f"\n{ x }: slope={res.slope:.4f}, intercept={res.intercept:.4f}, R2={res.rvalue**2:.4f}, p={res.pvalue:.3e}, n={n}")

res_df = pd.DataFrame(results)
out_csv = os.path.join(out_dir, "dfa_results.csv")
res_df.to_csv(out_csv, index=False)
print("\nSaved regression results to:", out_csv)

# Also save correlation matrix
out_corr = os.path.join(out_dir, "dfa_corr.csv")
corr.to_csv(out_corr)
print("Saved correlation matrix to:", out_corr)

