import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round1\holdout\base\OFF-COR-03-r1\_sandbox"
csv = os.path.join(base, "offline_data", "students.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv)
targets = ["math_score", "study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]

lines = []
lines.append(f"File: {csv}")
lines.append(f"Shape: {df.shape[0]} rows x {df.shape[1]} cols")
lines.append("")
lines.append("Columns & dtypes:")
for c, t in df.dtypes.items():
    lines.append(f"  {c}: {t}")
lines.append("")
lines.append("Missing counts:")
for c in df.columns:
    lines.append(f"  {c}: {df[c].isna().sum()}")
lines.append("")
lines.append("Target columns present: " + ", ".join(f"{c}={'OK' if c in df.columns else 'MISSING'}" for c in targets))
lines.append("")
lines.append("Sample rows (head 5):")
lines.append(df.head(5).to_string(index=False))
lines.append("")
lines.append("Describe of target columns:")
lines.append(df[targets].describe().to_string())

summary = "\n".join(lines)
print(summary)

out = os.path.join(out_dir, "students_profile.txt")
with open(out, "w", encoding="utf-8") as f:
    f.write(summary)
print("\nSaved to:", out)

