import pandas as pd
df = pd.read_csv("offline_data/students.csv")
s = df["screen_hours_per_day"]
m = df["math_score"]
r = df["reading_score"]
n = len(df)
pm = s.corr(m)  # Pearson
pr = s.corr(r)
print("n =", n)
print("pearson screen~math =", pm)
print("pearson screen~reading =", pr)
# also spearman for reference
print("spearman screen~math =", s.corr(m, method="spearman"))
print("spearman screen~reading =", s.corr(r, method="spearman"))
# p-values via t approx
import math
def pval(rho, n):
    t = rho*math.sqrt((n-2)/(1-rho**2))
    return t
print("t math =", pval(pm, n), "t reading =", pval(pr, n))
from scipy import stats
print("p math =", stats.t.sf(abs(pval(pm,n)), n-2)*2)
print("p reading =", stats.t.sf(abs(pval(pr,n)), n-2)*2)

