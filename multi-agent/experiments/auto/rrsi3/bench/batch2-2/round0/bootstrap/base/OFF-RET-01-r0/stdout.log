import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']

first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
