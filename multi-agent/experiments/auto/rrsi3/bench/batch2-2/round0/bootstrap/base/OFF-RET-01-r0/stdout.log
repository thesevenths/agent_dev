import pandas as pd, json, os

src = "offline_data/app_metrics.csv"
df = pd.read_csv(src)
r = df["retention_d7"]
first = r.iloc[:30]; last = r.iloc[30:]
overall_mean = r.mean(); overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
    "source_file": src,
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": "W01-W30", "n": 30, "mean": first.mean(), "std": first.std(ddof=1), "min": first.min(), "max": first.max()},
    "last30": {"weeks": "W31-W60", "n": 30, "mean": last.mean(), "std": last.std(ddof=1), "min": last.min(), "max": last.max()},
    "diff_mean_last_minus_first": last.mean() - first.mean(),
    "overall": {"mean": overall_mean, "std": overall_std, "threshold_mean_minus_2std": threshold},
    "weeks_below_threshold": {"count": int(len(below)), "weeks": below["week"].tolist(), "values": below["retention_d7"].tolist()},
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch2-2\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out = os.path.join(out_dir, "retention_d7_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("SAVED:", out)

