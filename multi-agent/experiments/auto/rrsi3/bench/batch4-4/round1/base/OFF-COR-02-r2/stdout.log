```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high(>5)", False: "low(<=5)"})

g = df.groupby("group").agg(
    n=("student_id", "size"),
    screen_mean=("screen_hours_per_day", "mean"),
    math_mean=("math_score", "mean"),
    reading_mean=("reading_score", "mean"),
)
print(g.to_string())
print()
hi, lo = g.loc["high(>5)"], g.loc["low(<=5)"]
print("math diff (high - low):", hi.math_mean - lo.math_mean)
print("reading diff (high - low):", hi.reading_mean - lo.reading_mean)
print("n check:", hi.n + lo.n)
print("screen range check: high min", df.loc[df.group=='high(>5)','screen_hours_per_day'].min(),
      "low max", df.loc[df.group=='low(<=5)','screen_hours_per_day'].max())
# more decimals
for col in ["screen_mean","math_mean","reading_mean"]:
    print(col, "high:", round(hi[col],6), "low:", round(lo[col],6))

```
