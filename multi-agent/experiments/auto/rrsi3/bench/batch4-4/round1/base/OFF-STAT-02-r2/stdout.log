import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-STAT-02-r2\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-STAT-02-r2\_sandbox\tmp\stats_results.json"

df = pd.read_csv(path)
m, r = df['math_score'], df['reading_score']
n = len(df)

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "n_math_valid": int(m.notna().sum()),
    "n_reading_valid": int(r.notna().sum()),
    "math_score": {
        "mean": float(m.mean()),
        "std_sample": float(m.std(ddof=1)),
        "std_population": float(m.std(ddof=0)),
        "median": float(m.median()),
        "min": float(m.min()),
        "max": float(m.max()),
        "cv_sample": float(m.std(ddof=1)/m.mean()),
    },
    "reading_score": {
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_population": float(r.std(ddof=0)),
        "median": float(r.median()),
        "min": float(r.min()),
        "max": float(r.max()),
        "cv_sample": float(r.std(ddof=1)/r.mean()),
    },
    "pearson_r": float(m.corr(r, method='pearson')),
    "cv_ratio_math_over_reading": float(m.std(ddof=1)/m.mean() / (r.std(ddof=1)/r.mean())),
    "computed_at": "2026-10-26 07:42",
}
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

