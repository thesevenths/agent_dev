import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]

stats = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "as_of": "2026-10-26 06:42",
    "first30": {
        "weeks": "W01-W30",
        "n": int(len(first30)),
        "mean": float(first30.mean()),
        "std_sample": float(first30.std(ddof=1)),
        "std_population": float(first30.std(ddof=0)),
    },
    "last30": {
        "weeks": "W31-W60",
        "n": int(len(last30)),
        "mean": float(last30.mean()),
        "std_sample": float(last30.std(ddof=1)),
        "std_population": float(last30.std(ddof=0)),
    },
    "overall": {
        "weeks": "W01-W60",
        "n": int(len(r)),
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_population": float(r.std(ddof=0)),
    },
    "diff_mean_last30_minus_first30": float(last30.mean() - first30.mean()),
    "threshold_mean_minus_2std_sample": float(r.mean() - 2*r.std(ddof=1)),
    "threshold_mean_minus_2std_population": float(r.mean() - 2*r.std(ddof=0)),
    "weeks_below_mean_minus_2std_sample": int((r < r.mean() - 2*r.std(ddof=1)).sum()),
    "weeks_below_mean_minus_2std_population": int((r < r.mean() - 2*r.std(ddof=0)).sum()),
}
# list the below-threshold weeks for sample std
thr = r.mean() - 2*r.std(ddof=1)
below = df.loc[r < thr, ["week", "retention_d7"]]
stats["below_threshold_weeks_sample"] = below.to_dict("records")

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-01-r5\_sandbox\tmp\retention_d7_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)
print(json.dumps(stats, ensure_ascii=False, indent=2))
print("saved:", out)

```
