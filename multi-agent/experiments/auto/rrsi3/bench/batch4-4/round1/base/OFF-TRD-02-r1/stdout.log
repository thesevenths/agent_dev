import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
print(df.shape)
print(df.dtypes)
print(df.isna().sum())

agg = df.groupby("product_line").agg(
    total_units=("units", "sum"),
    total_revenue=("revenue", "sum"),
    avg_unit_price=("unit_price", "mean"),
    rows=("units", "size"),
).reset_index()
agg["revenue_share"] = agg["total_revenue"] / agg["total_revenue"].sum()
agg = agg.sort_values("total_revenue", ascending=False)
print(agg.to_string())
print("grand total revenue:", df["revenue"].sum())
print("grand total units:", df["units"].sum())
print("months:", df["month"].min(), df["month"].max())
print("regions:", sorted(df["region"].unique()))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-TRD-02-r1\_sandbox\tmp\product_line_agg.csv"
agg.to_csv(out, index=False)
print("saved:", out)

