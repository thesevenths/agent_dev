import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)

# Correlations (Pearson)
corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] <= med]

res = pd.DataFrame({
    "metric": [
        "corr_retention_d7_arpu_usd",
        "corr_retention_d7_churn_rate",
        "retention_d7_median",
        "high_group_n",
        "high_group_arpu_usd_mean",
        "high_group_cohort_size_sum",
        "low_group_n",
        "low_group_arpu_usd_mean",
        "low_group_cohort_size_sum",
        "total_rows",
    ],
    "value": [
        corr_arpu, corr_churn, med,
        len(high), high["arpu_usd"].mean(), int(high["cohort_size"].sum()),
        len(low), low["arpu_usd"].mean(), int(low["cohort_size"].sum()),
        n,
    ],
})
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-03-r4\_sandbox\tmp\step2_results.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

