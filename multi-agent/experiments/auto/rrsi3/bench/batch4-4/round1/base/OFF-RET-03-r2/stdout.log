import pandas as pd, numpy as np, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-03-r2\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)

# Pearson correlations
r_ret_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_ret_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

groups = pd.DataFrame([
    {"group": "retention_d7 > median", "n": len(hi), "mean_arpu_usd": hi["arpu_usd"].mean(), "sum_cohort_size": int(hi["cohort_size"].sum())},
    {"group": "retention_d7 <= median", "n": len(lo), "mean_arpu_usd": lo["arpu_usd"].mean(), "sum_cohort_size": int(lo["cohort_size"].sum())},
])
groups.to_csv(f"{out_dir}\\step2_group_stats.csv", index=False)

# also save a full results json for step 3
results = {
    "as_of": "2026-10-25 10:41",
    "n": n,
    "retention_d7_median": float(med),
    "pearson_retention_d7_vs_arpu_usd": float(r_ret_arpu),
    "pearson_retention_d7_vs_churn_rate": float(r_ret_churn),
    "groups": groups.to_dict(orient="records"),
}
with open(f"{out_dir}\\step2_results.json", "w", encoding="utf-8") as f:
    json.dump(results, f, indent=2, ensure_ascii=False)

print(json.dumps(results, indent=2, ensure_ascii=False))
print("saved:", f"{out_dir}\\step2_group_stats.csv", f"{out_dir}\\step2_results.json")

```
