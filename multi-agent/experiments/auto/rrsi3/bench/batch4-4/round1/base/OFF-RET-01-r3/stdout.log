        last.mean() - first.mean(), last.std(ddof=1) - first.std(ddof=1),
        overall_mean, overall_std, threshold,
        len(below), len(r),
    ],
    "n": [30, 30, 30, 30, None, None, 60, 60, None, None, 60],
})
print(results.to_string(index=False))
print("\nweeks below threshold:")
