below = r[r < threshold]

results = pd.DataFrame({
    "metric": [
        "first30_mean", "first30_std", "last30_mean", "last30_std",
        "mean_diff_last_minus_first", "std_diff_last_minus_first",
        "overall_mean", "overall_std", "threshold_mean_minus_2std",
