s=1).mean().reindex(other.index)).max()\n    return dict(\n        n=len(g),\n        pre_mean=pre_units.mean(),\n        pre_ret=pre_ret,\n        post_mean=post_units.mean(),\n        post_ret=post_ret,\n        other_max_ratio=other_ratio,\n        spike_ret_rate=ret[g.month == "2025-03"].iloc[0] / units[g.month == "2025-03"].iloc[0],\n        pre_ret_n=len(pre),\n        post_ret_n=len(post),\n    )\n\nctx = {}\nfor _, r in top3.iterrows():\n    ctx[(r.region, r.product_line)] = combo_stats(r.region, r.product_line)\n\ndef verdict(rg, pl):\n    c = ctx[(rg, pl)]\n    spike_ret = c["spike_ret_rate"]\n    # channel-stuffing signals: spike return rate far above baseline, post-spike collapse,\n    # and no other month in the combo ever came close to this ratio\n    collapse = c["post_mean"] < 0.85 * c["pre_mean"]\n    ret_jump = spike_ret > 1.5 * c["pre_ret"] if c["pre_ret"] > 0 else False\n    isolated = c["other_max_ratio"] < 1.3\n    score = sum([ret_jump, collapse, isolated])\n    if score >= 2:\n        return "更像渠道压货（channel stuffing）"\n    if score == 1:\n        return "介于两者之间，偏渠道压货"\n    return "更像真实需求"\n\nlines = []\nA = lines.append\nA("# Regional Sales Anomaly Analysis Report")\nA("")\nA("AS_OF: 2026-10-25 10:14（本地离线数据，非实时；数据覆盖 2024-01 至 2025-12 共 24 个月）")\nA("")\nA("## 1. 分析背景与方法")\nA("")\nA(f"本报告基于本地文件 `offline_data/regional_sales.csv`（共 {len(df)} 行，"\n  f"4 个区域 E/N/S/W × 3 条产品线 Accessory/Hardware/Service × 24 个月，"\n  f"列：month, region, product_line, units, unit_price, revenue, returns）。"\n  "对每个「区域×产品线」组合，以其自身 24 个月滚动均值（min_periods=1）为基线，"\n  "计算每月销量倍数 = 当月 units ÷ 24 个月滚动均值，取倍数最大的前三个组合。"\n  "全部结论仅来自上述本地 CSV，未使用任何外部数据。")\nA("")\nA("## 2. 前三个单月放量异常")\nA("")\nA("| 排名 | 区域 | 产品线 | 异常月份 | 当月销量 (units) | 24 个月滚动均值 | 倍数 | 当月退货量 (returns) | 当月退货率 (returns/units) |")\nA("|---|---|---|---|---|---|---|---|---|")\nfor i, r in top3.iterrows():\n    rr = r.returns / r.units\n    A(f"| {i+1} | {r.region} | {r.product_line} | {r.month} | "\n      f"{int(r.units)}（来源