import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]

stats = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "total_weeks": int(len(r)),
    "first30": {
        "weeks": "W01-W30", "n": int(len(first30)),
        "mean": float(first30.mean()),
        "std_sample": float(first30.std(ddof=1)),
        "std_pop": float(first30.std(ddof=0)),
        "min": float(first30.min()), "max": float(first30.max()),
    },
    "last30": {
        "weeks": "W31-W60", "n": int(len(last30)),
        "mean": float(last30.mean()),
        "std_sample": float(last30.std(ddof=1)),
        "std_pop": float(last30.std(ddof=0)),
        "min": float(last30.min()), "max": float(last30.max()),
    },
    "overall": {
        "weeks": "W01-W60", "n": int(len(r)),
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_pop": float(r.std(ddof=0)),
    },
}
stats["diff_mean_last30_minus_first30"] = stats["last30"]["mean"] - stats["first30"]["mean"]
stats["diff_std_last30_minus_first30"] = stats["last30"]["std_sample"] - stats["first30"]["std_sample"]

thr = stats["overall"]["mean"] - 2 * stats["overall"]["std_sample"]
low = df[r < thr]
stats["threshold_mean_minus_2std"] = float(thr)
stats["weeks_below_threshold_count"] = int(len(low))
stats["weeks_below_threshold"] = low["week"].tolist()

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-01-r0\_sandbox\tmp\retention_d7_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)

print(json.dumps(stats, ensure_ascii=False, indent=2))
print("saved:", out)

```
