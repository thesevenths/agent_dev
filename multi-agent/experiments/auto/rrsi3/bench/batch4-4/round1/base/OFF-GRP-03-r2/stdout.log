```python
import pandas as pd, json

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-03-r2\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-03-r2\_sandbox\tmp"
df = pd.read_csv(src)

def grp(h):
    if h < 2.5: return 'low'
    elif h <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)
rows = []
for g in ['low','mid','high']:
    sub = df[df['group']==g]
    rows.append({
        'group': g,
        'n': int(len(sub)),
        'math_score_mean': round(float(sub['math_score'].mean()),4),
        'math_score_std': round(float(sub['math_score'].std(ddof=1)),4),
        'study_hours_min': float(sub['study_hours_per_week'].min()),
        'study_hours_max': float(sub['study_hours_per_week'].max()),
        'study_hours_mean': round(float(sub['study_hours_per_week'].mean()),4),
    })
res = pd.DataFrame(rows)
low = res[res.group=='low'].iloc[0]; high = res[res.group=='high'].iloc[0]
gain = float(high['math_score_mean'] - low['math_score_mean'])
gain_pct = gain / float(low['math_score_mean']) * 100
summary = {
    'source_file': 'offline_data/students.csv',
    'total_rows': int(len(df)),
    'rows_used': int(len(df)),
    'missing_in_key_cols': 0,
    'groups': res.to_dict('records'),
    'low_to_high_gain': round(gain,4),
    'low_to_high_gain_pct': round(gain_pct,4),
    'as_of': '2026-10-26 06:24',
}
res.to_csv(out + r'\group_stats.csv', index=False)
with open(out + r'\group_stats.json','w',encoding='utf-8') as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print(res.to_string(index=False))
print('gain:', round(gain,4), 'pct:', round(gain_pct,4))
print('total:', len(df))

```
