import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
print(df.shape)
print(df.head())
print(df.dtypes)
print("nulls:", df[["math_score","reading_score"]].isna().sum().to_dict())

m = df["math_score"]
r = df["reading_score"]
stats = {
    "n": int(len(df)),
    "math_score": {"mean": m.mean(), "std": m.std(ddof=1), "std_pop": m.std(ddof=0), "median": m.median(), "cv": m.std(ddof=1)/m.mean()},
    "reading_score": {"mean": r.mean(), "std": r.std(ddof=1), "std_pop": r.std(ddof=0), "median": r.median(), "cv": r.std(ddof=1)/r.mean()},
    "pearson_r": float(m.corr(r)),
}
print(json.dumps(stats, indent=2))

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-STAT-02-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
with open(os.path.join(out_dir, "stats_results.json"), "w", encoding="utf-8") as f:
    json.dump(stats, f, indent=2, ensure_ascii=False)
print("saved to", os.path.join(out_dir, "stats_results.json"))

