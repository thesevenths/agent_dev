```python
import pandas as pd
df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[(df.week >= 'W30') & (df.week <= 'W43')].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')
m = ['retention_d7','churn_rate','arpu_usd']
means = sub.groupby('group')[m].mean()
print(means.round(6))
print("n per group:", sub.groupby('group').size().to_dict())
# deltas
d = means.loc['W37-W43'] - means.loc['W30-W36']
print("delta:", d.round(6))
print("pct:", (d/means.loc['W30-W36']*100).round(4))
# W36->W37 single-week deltas
w36 = sub[sub.week=='W36'][m].iloc[0]; w37 = sub[sub.week=='W37'][m].iloc[0]
print("W36->W37:", (w37-w36).round(6))
# mean of |wow| per group
sub['r_wow'] = sub['retention_d7'].diff()
print("mean |wow| retention per group:", sub.groupby('group')['r_wow'].apply(lambda s: s.abs().mean()).round(6))

```
