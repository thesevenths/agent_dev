```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r0\_sandbox\tmp"

df = pd.read_csv(path)
weeks = [f"W{i:02d}" for i in range(30, 44)]
win = df[df['week'].isin(weeks)].copy()
win = win.sort_values('week').reset_index(drop=True)
assert len(win) == 14, len(win)

win['group'] = win['week'].apply(lambda w: 'A_W30-W36' if int(w[1:]) <= 36 else 'B_W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# per-week table
perweek = win[['week'] + metrics].copy()
perweek['group'] = win['group']

# group means
means = win.groupby('group')[metrics].mean().round(6)
print("group means:\n", means)

# differences B - A
diff = (means.loc['B_W37-W43'] - means.loc['A_W30-W36']).round(6)
rel = (diff / means.loc['A_W30-W36']).round(6)
print("\nabs diff (B-A):\n", diff)
print("\nrel diff (B-A)/A:\n", rel)

# breakpoint week: W36 -> W37
w36 = win[win['week']=='W36'][metrics].iloc[0]
w37 = win[win['week']=='W37'][metrics].iloc[0]
bp_abs = (w37 - w36).round(6)
bp_rel = (bp_abs / w36).round(6)
print("\nW36:", w36.to_dict())
print("W37:", w37.to_dict())
print("W37-W36 abs:", bp_abs.to_dict())
print("W37/W36-1 rel:", bp_rel.to_dict())

# save per-week CSV
perweek_path = f"{out_dir}\\step2_perweek_W30-W43.csv"
perweek.to_csv(perweek_path, index=False)

# save group summary CSV
summary = pd.DataFrame({
    'metric': metrics,
    'mean_A_W30-W36': [round(means.loc['A_W30-W36', m], 6) for m in metrics],
    'mean_B_W37-W43': [round(means.loc['B_W37-W43', m], 6) for m in metrics],
    'abs_diff_B_minus_A': [round(diff[m], 6) for m in metrics],
    'rel_diff_pct': [round(rel[m]*100, 4) for m in metrics],
    'W36_value': [round(w36[m], 6) for m in metrics],
    'W37_value': [round(w37[m], 6) for m in metrics],
    'W37_minus_W36_abs': [round(bp_abs[m], 6) for m in metrics],
    'W37_vs_W36_rel_pct': [round(bp_rel[m]*100, 4) for m in metrics],
})
summary_path = f"{out_dir}\\step2_group_summary.csv"
summary.to_csv(summary_path, index=False)
print("\nsaved:", perweek_path)
print("saved:", summary_path)
print("\nsummary:\n", summary.to_string(index=False))

