import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[(df.week >= 'W30') & (df.week <= 'W43')].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
means = sub.groupby('group')[metrics].mean()
print(means)

# per-week table with week-over-week deltas
per = sub[['week','group','retention_d7','churn_rate','arpu_usd']].copy()
for m in metrics:
    per[f'{m}_wow'] = per[m].diff()
print(per.to_string(index=False))

# breakpoint: week with largest |wow| change in retention_d7
print("\nmax |wow| retention_d7:", per.loc[per['retention_d7_wow'].abs().idxmax(), 'week'])
print("max |wow| churn_rate:", per.loc[per['churn_rate_wow'].abs().idxmax(), 'week'])
print("max |wow| arpu_usd:", per.loc[per['arpu_usd_wow'].abs().idxmax(), 'week'])

# save intermediate CSV
out = per.drop(columns=['group'])
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_group_means_breakpoint.csv", index=False)
print("\nsaved csv")

```
