```python
import pandas as pd, numpy as np, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-STAT-02-r5\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv("offline_data/students.csv")
m = df["math_score"]; r = df["reading_score"]
n = len(df)
missing = int(df[["math_score","reading_score"]].isna().sum().sum())

stats = {
    "n": n, "missing": missing,
    "math_mean": m.mean(), "math_std": m.std(ddof=1), "math_median": m.median(),
    "read_mean": r.mean(), "read_std": r.std(ddof=1), "read_median": r.median(),
    "pearson_r": m.corr(r),
    "math_cv": m.mean()/m.std(ddof=1), "read_cv": r.mean()/r.std(ddof=1),
}
# population std for reference
stats["math_std_pop"] = m.std(ddof=0); stats["read_std_pop"] = r.std(ddof=0)
for k,v in stats.items():
    print(k, "=", v)

with open(os.path.join(out_dir, "stats.json"), "w") as f:
    json.dump(stats, f, indent=2)
print("saved", os.path.join(out_dir, "stats.json"))

```
