```python
import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
grand_total = float(df['revenue'].sum())

monthly = df.groupby(['region','month'])['revenue'].sum().reset_index()
results = {}
for region in ['N','S','E','W']:
    sub = df[df['region']==region]
    total = float(sub['revenue'].sum())
    msub = monthly[monthly['region']==region]
    peak_row = msub.loc[msub['revenue'].idxmax()]
    results[region] = {
        "total_revenue": round(total, 2),
        "share": round(total/grand_total, 6),
        "monthly_avg": round(total/24, 2),
        "peak_month": peak_row['month'],
        "peak_month_revenue": round(float(peak_row['revenue']), 2),
        "n_rows": int(len(sub)),
        "n_months": int(sub['month'].nunique()),
    }

top_region = max(results, key=lambda r: results[r]['total_revenue'])
out = {
    "source_file": "offline_data/regional_sales.csv",
    "as_of": "2026-10-25 11:37",
    "period": "2024-01..2025-12 (24 months)",
    "grand_total": round(grand_total, 2),
    "top_region": top_region,
    "regions": results,
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-TRD-03-r3\_sandbox\tmp\regional_aggregates.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", path)

```
