import pandas as pd

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-03-r5\_sandbox\offline_data\app_metrics.csv")

# Correlations (Pearson)
corr_arpu = df['retention_d7'].corr(df['arpu_usd'])
corr_churn = df['retention_d7'].corr(df['churn_rate'])
print("corr retention_d7 vs arpu_usd:", corr_arpu)
print("corr retention_d7 vs churn_rate:", corr_churn)

# Median split
med = df['retention_d7'].median()
print("median retention_d7:", med)
high = df[df['retention_d7'] > med]
low = df[df['retention_d7'] <= med]
