print("high arpu mean:", high['arpu_usd'].mean(), "high cohort sum:", high['cohort_size'].sum())
print("low arpu mean:", low['arpu_usd'].mean(), "low cohort sum:", low['cohort_size'].sum())

# Save intermediate results CSV
