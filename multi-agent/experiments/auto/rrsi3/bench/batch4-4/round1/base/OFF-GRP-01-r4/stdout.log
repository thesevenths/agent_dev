import pandas as pd, numpy as np, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-01-r4\_sandbox\offline_data\students.csv"
out  = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-01-r4\_sandbox\tmp\step2_group_stats.json"

df = pd.read_csv(path)
g = df.groupby("tutoring")["math_score"]

n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std(ddof=1)[0]), float(g.std(ddof=1)[1])

mean_diff = m1 - m0
pooled_std = np.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
d = mean_diff / pooled_std

# classification
absd = abs(d)
if absd < 0.2: cls = "极小 (negligible)"
elif absd < 0.5: cls = "小 (small)"
elif absd < 0.8: cls = "中 (medium)"
else: cls = "大 (large)"

res = {
    "group0": {"n": n0, "mean": round(m0,4), "std_ddof1": round(s0,4)},
    "group1": {"n": n1, "mean": round(m1,4), "std_ddof1": round(s1,4)},
    "mean_diff_1_minus_0": round(mean_diff,4),
    "pooled_std": round(float(pooled_std),4),
    "cohens_d": round(float(d),4),
    "classification": cls,
    "note": "std uses sample std (ddof=1); pooled_std = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); d = mean_diff/pooled_std",
}
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

