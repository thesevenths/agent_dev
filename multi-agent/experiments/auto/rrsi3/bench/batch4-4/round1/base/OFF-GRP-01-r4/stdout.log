```python
import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-01-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

g = df.groupby("tutoring")["math_score"].agg(n="count", mean="mean", std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,"n"]), int(g.loc[1,"n"])
m0, m1 = g.loc[0,"mean"], g.loc[1,"mean"]
s0, s1 = g.loc[0,"std"], g.loc[1,"std"]

mean_diff = m1 - m0
pooled_std = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
d = mean_diff / pooled_std

def classify(d):
    a = abs(d)
    if a < 0.2: return "negligible (|d|<0.2)"
    if a < 0.5: return "small (0.2<=|d|<0.5)"
    if a < 0.8: return "medium (0.5<=|d|<0.8)"
    return "large (|d|>=0.8)"

result = {
    "source_file": "offline_data/students.csv",
    "group_column": "tutoring",
    "value_column": "math_score",
    "std_definition": "sample std, ddof=1",
    "groups": {
        "0": {"n": n0, "mean": m0, "std": s0},
        "1": {"n": n1, "mean": m1, "std": s1},
    },
    "mean_diff_1_minus_0": mean_diff,
    "pooled_std": pooled_std,
    "cohens_d": d,
    "effect_size_classification": classify(d),
    "classification_rule": "Cohen (1988): |d|<0.2 negligible, 0.2-0.5 small, 0.5-0.8 medium, >=0.8 large",
    "total_rows": int(len(df)),
    "missing_values": 0,
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-01-r4\_sandbox\tmp\step2_group_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

