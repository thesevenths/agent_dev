```python

import pandas as pd

src = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r4\_sandbox\offline_data\students.csv'
out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r4\_sandbox\tmp\offline_data\grade_region_cross_tab.csv'

df = pd.read_csv(src)
grades = ['G10','G11','G12']
regions = ['A','B','C','D']

rows = []
for g in grades:
    for r in regions:
        sub = df[(df['grade']==g) & (df['region']==r)]
        n = len(sub)
        mean = sub['reading_score'].mean() if n else float('nan')
        rows.append({'grade': g, 'region': r, 'row_count': n,
                     'reading_score_mean': round(mean, 4) if n else ''})

tab = pd.DataFrame(rows)
import os
os.makedirs(os.path.dirname(out), exist_ok=True)
tab.to_csv(out, index=False)
print(tab.to_string(index=False))

# stats for report
valid = tab[tab['row_count']>0].copy()
hi = valid.loc[valid['reading_score_mean'].idxmax()]
lo = valid.loc[valid['reading_score_mean'].idxmin()]
print('HIGHEST:', hi)
print('LOWEST:', lo)
print('total rows:', len(df), 'sum cells:', tab['row_count'].sum())
print('overall mean:', df['reading_score'].mean())
print('saved to', out)

