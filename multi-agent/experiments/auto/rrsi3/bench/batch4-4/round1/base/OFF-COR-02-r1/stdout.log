import pandas as pd, json

path = r"E:\agent_dev\multi-agent\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
n = len(df)
print("n =", n)
print("r(screen, math) =", r_math)
print("r(screen, reading) =", r_read)

out = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "method": "Pearson correlation (pandas .corr, default pearson)",
    "correlations": [
        {"x": "screen_hours_per_day", "y": "math_score", "pearson_r": round(r_math, 6), "n": n},
        {"x": "screen_hours_per_day", "y": "reading_score", "pearson_r": round(r_read, 6), "n": n},
    ],
}
