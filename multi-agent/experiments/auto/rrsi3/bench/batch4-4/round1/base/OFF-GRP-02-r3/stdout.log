import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r3\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

# cross-tab counts
ct = df.groupby(['grade','region']).size().unstack(fill_value=0)
ct = ct.reindex(index=['G10','G11','G12'], columns=['A','B','C','D'])

# means
means = df.groupby(['grade','region'])['reading_score'].mean().unstack()
means = means.reindex(index=['G10','G11','G12'], columns=['A','B','C','D'])

print("COUNTS:\n", ct)
print("\nMEANS:\n", means.round(4))

# flat list for max/min
flat = df.groupby(['grade','region'])['reading_score'].agg(['count','mean'])
flat = flat.sort_values('mean', ascending=False)
print("\nSorted by mean desc:\n", flat.round(4))
print("\nMax:", flat.index[0], flat.iloc[0])
print("Min:", flat.index[-1], flat.iloc[-1])

# overall
print("\noverall mean:", df['reading_score'].mean(), "n=", len(df))
print("grade means:\n", df.groupby('grade')['reading_score'].agg(['count','mean']).round(4))
print("region means:\n", df.groupby('region')['reading_score'].agg(['count','mean']).round(4))

```
