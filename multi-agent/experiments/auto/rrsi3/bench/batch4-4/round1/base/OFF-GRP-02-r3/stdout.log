```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r3\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r3\_sandbox\tmp\grade_region_cross_tab.csv"

df = pd.read_csv(src)
g = df.groupby(['grade','region'])['reading_score'].agg(row_count='count', mean_reading_score='mean').reset_index()
g['mean_reading_score'] = g['mean_reading_score'].round(4)
g = g.sort_values(['grade','region']).reset_index(drop=True)

# mark max/min mean combos
max_i = g['mean_reading_score'].idxmax()
min_i = g['mean_reading_score'].idxmin()
g['is_max_mean'] = g.index == max_i
g['is_min_mean'] = g.index == min_i

g.to_csv(out, index=False)
print(g.to_string(index=False))
print("\nsaved:", out)
print("max:", g.loc[max_i].to_dict())
print("min:", g.loc[min_i].to_dict())

```
