import pandas as pd
import numpy as np
import os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-01-r5\_sandbox\tmp"
os.makedirs(base, exist_ok=True)
path = os.path.join(os.getcwd(), "offline_data", "students.csv")
df = pd.read_csv(path)
n = len(df)

vars_ = ["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day"]
rows = []
for v in vars_:
    r = df[v].corr(df["math_score"], method="pearson")
    rows.append({"var": v, "r": r, "abs_r": abs(r),
                 "mean_x": df[v].mean(), "std_x": df[v].std(ddof=1),
                 "min_x": df[v].min(), "max_x": df[v].max()})
res_df = pd.DataFrame(rows).sort_values("abs_r", ascending=False).reset_index(drop=True)

m_mean = df["math_score"].mean(); m_std = df["math_score"].std(ddof=1)
m_min = df["math_score"].min(); m_max = df["math_score"].max()

def f(x, d=4): return f"{x:.{d}f}"

table = "| 排名 | 变量 | 皮尔逊相关系数 r | |r| | 变量均值 | 变量标准差 | 变量取值范围 |\n"
table += "|---|---|---|---|---|---|---|\n"
for i, row in res_df.iterrows():
    table += (f"| {i+1} | {row['var']} | {f(row['r'])} | {f(row['abs_r'])} | "
              f"{f(row['mean_x'],2)} | {f(row['std_x'],2)} | [{f(row['min_x'],1)}, {f(row['max_x'],1)}] |\n")

top = res_df.iloc[0]
second = res_df.iloc[1]
ratio = top["abs_r"] / second["abs_r"]

report = f"""# 学生行为变量与数学成绩（math_score）的皮尔逊相关分析

- 报告生成日期：2026-10-25（周日）
- 数据来源：本地文件 `offline_data/students.csv`（离线数据，未联网检索）
- 样本量：{n} 名学生（来源：offline_data/students.csv 的 student_id，按行计数，n={n}，无缺失值）
- 方法：对每个自变量与 `math_score` 计算皮尔逊相关系数（Pearson r），按 |r| 降序排序

## 一、分析背景

本报告基于本地离线数据集 `offline_data/students.csv`，考察四个学生行为变量——每周学习时长（study_hours_per_week）、每晚睡眠时长（sleep_hours_per_night）、出勤率（attendance_pct）、每日屏幕使用时长（screen_hours_per_day）——与数学成绩（math_score）之间的线性相关强度，并按相关系数绝对值排序，识别与数学成绩关系最强的变量。

## 二、数据概览

样本共 {n} 行（来源：offline_data/students.csv 的 student_id，按行计数，n={n}），四个自变量与 math_score 均无缺失值（来源：offline_data/students.csv 的 study_hours_per_week / sleep_hours_per_night / attendance_pct / screen_hours_per_day / math_score，缺失值计数均为 0）。

| 变量 | 均值 | 标准差 | 最小值 | 最大值 |
|---|---|---|---|---|
| math_score | {f(m_mean,2)} | {f(m_std,2)} | {m_min} | {m_max} |
| study_hours_per_week | {f(df['study_hours_per_week'].mean(),2)} | {f(df['study_hours_per_week'].std(ddof=1),2)} | {df['study_hours_per_week'].min()} | {df['study_hours_per_week'].max()} |
| sleep_hours_per_night | {f(df['sleep_hours_per_night'].mean(),2)} | {f(df['sleep_hours_per_night'].std(ddof=1),2)} | {df['sleep_hours_per_night'].min()} | {df['sleep_hours_per_night'].max()} |
| attendance_pct | {f(df['attendance_pct'].mean(),2)} | {f(df['attendance_pct'].std(ddof=1),2)} | {df['attendance_pct'].min()} | {df['attendance_pct'].max()} |
| screen_hours_per_day | {f(df['screen_hours_per_day'].mean(),2)} | {f(df['screen_hours_per_day'].std(ddof=1),2)} | {df['screen_hours_per_day'].min()} | {df['screen_hours_per_day'].max()} |

（来源：offline_data/students.csv 的对应列名，全样本 n={n} 行的均值 / 样本标准差(ddof=1) / 最小值 / 最大值）

## 三、皮尔逊相关系数结果（按 |r| 降序）

{table}

（来源：offline_data/students.csv 的 <变量列名> 与 math_score，全样本 n={n} 行计算皮尔逊相关系数；均值/标准差/取值范围同列名，n={n} 行）

## 四、分析洞察

1. **study_hours_per_week 与 math_score 呈强正相关**：r = {f(top['r'])}（来源：offline_data/students.csv 的 study_hours_per_week 与 math_score，n={n} 行皮尔逊相关），是四个变量中 |r| 最大者，每周学习时长每增加 1 小时，数学成绩在统计上平均伴随上升。
2. **attendance_pct 呈中等正相关**：r = {f(res_df.iloc[1]['r'])}（来源：offline_data/students.csv 的 attendance_pct 与 math_score，n={n} 行皮尔逊相关），强度约为 study_hours_per_week 的 {f(1/ratio,2)} 倍倒数关系，即 study_hours_per_week 的 |r| 是 attendance_pct 的 {f(ratio,2)} 倍（来源：由前述两行计算，{f(top['abs_r'])} ÷ {f(second['abs_r'])}）。
3. **screen_hours_per_day 呈弱负相关**：r = {f(res_df.iloc[2]['r'])}（来源：offline_data/students.csv 的 screen_hours_per_day 与 math_score，n={n} 行皮尔逊相关），屏幕使用时长越长，数学成绩倾向略低，但线性关系较弱。
4. **sleep_hours_per_night 几乎无线性相关**：r = {f(res_df.iloc[3]['r'])}（来源：offline_data/students.csv 的 sleep_hours_per_night 与 math_score，n={n} 行皮尔逊相关），|r| 接近 0，说明在本样本中睡眠时长与数学成绩基本不存在线性关系。

## 五、结论

在四个候选变量中，**study_hours_per_week（每周学习时长）与 math_score 的关系最强**：其皮尔逊相关系数 r = {f(top['r'])}（来源：offline_data/students.csv 的 study_hours_per_week 与 math_score，n={n} 行皮尔逊相关），|r| = {f(top['abs_r'])} 显著高于其余三个变量（attendance_pct 的 {f(second['abs_r'])}、screen_hours_per_day 的 {f(res_df.iloc[2]['abs_r'])}、sleep_hours_per_night 的 {f(res_df.iloc[3]['abs_r'])}，来源：offline_data/students.csv 的对应列与 math_score，n={n} 行皮尔逊相关），且为四者中唯一的强相关（|r| > 0.7）。需要强调的是，皮尔逊相关仅刻画线性关联，不能推断因果关系；上述结论完全基于本地 CSV 数据，未使用任何联网信息。
"""

out = os.path.join(base, "math_score_correlation_report.md")
with open(out, "w", encoding="utf-8") as fh:
    fh.write(report)
print("written:", os.path.abspath(out))
print("size:", os.path.getsize(out))

