import pandas as pd
import numpy as np
import os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-01-r5\_sandbox\tmp"
os.makedirs(base, exist_ok=True)

# find the csv
cand = [
    os.path.join(base, "offline_data", "students.csv"),
    os.path.join(os.getcwd(), "offline_data", "students.csv"),
]
path = next(p for p in cand if os.path.exists(p))
print("CSV:", path)

df = pd.read_csv(path)
n = len(df)
print("rows:", n)
print("nulls:\n", df[["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day","math_score"]].isna().sum())

vars_ = ["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day"]
res = []
for v in vars_:
    r = df[v].corr(df["math_score"], method="pearson")
    res.append({"var": v, "r": r, "abs_r": abs(r),
                "mean_x": df[v].mean(), "mean_y": df["math_score"].mean(),
                "std_x": df[v].std(ddof=1), "std_y": df["math_score"].std(ddof=1)})
res_df = pd.DataFrame(res).sort_values("abs_r", ascending=False).reset_index(drop=True)
print(res_df.to_string())

# descriptive stats for math_score
print("math_score min/max:", df["math_score"].min(), df["math_score"].max())
print("math_score mean:", round(df["math_score"].mean(),4))
print("math_score std:", round(df["math_score"].std(ddof=1),4))
for v in vars_:
    print(v, "mean", round(df[v].mean(),4), "std", round(df[v].std(ddof=1),4), "min", df[v].min(), "max", df[v].max())

