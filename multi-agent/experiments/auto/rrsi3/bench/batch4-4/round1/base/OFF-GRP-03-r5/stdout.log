import pandas as pd
import json

df = pd.read_csv("offline_data/students.csv")
sub = df[["study_hours_per_week","math_score"]].copy()

def grp(h):
    if h < 2.5: return "low"
    if h <= 4.5: return "mid"
    return "high"

sub["group"] = sub["study_hours_per_week"].apply(grp)
res = sub.groupby("group")["math_score"].agg(["count","mean","std","min","max"])
res["hours_min"] = sub.groupby("group")["study_hours_per_week"].min()
res["hours_max"] = sub.groupby("group")["study_hours_per_week"].max()
print(res)

out = {
  "file": "offline_data/students.csv",
  "rows": int(len(df)),
  "cols": list(df.columns),
  "missing_total": int(df.isna().sum().sum()),
  "missing_study_hours": int(df["study_hours_per_week"].isna().sum()),
  "missing_math_score": int(df["math_score"].isna().sum()),
  "study_hours_range": [float(df["study_hours_per_week"].min()), float(df["study_hours_per_week"].max())],
  "math_score_range": [int(df["math_score"].min()), int(df["math_score"].max())],
  "groups": {g: {"n": int(r["count"]), "mean": float(r["mean"]), "std": float(r["std"]),
                 "min": int(r["min"]), "max": int(r["max"]),
                 "hours_min": float(r["hours_min"]), "hours_max": float(r["hours_max"])}
             for g, r in res.iterrows()},
  "gain_low_to_high": float(res.loc["high","mean"] - res.loc["low","mean"]),
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-03-r5\_sandbox\tmp\step1_validation.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved")

