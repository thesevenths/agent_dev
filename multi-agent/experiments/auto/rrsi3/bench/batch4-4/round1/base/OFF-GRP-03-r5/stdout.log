import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
sub = df[["study_hours_per_week","math_score"]].copy()

def grp(h):
    if h < 2.5: return "low"
    if h <= 4.5: return "mid"
    return "high"

sub["group"] = sub["study_hours_per_week"].apply(grp)
g = sub.groupby("group")
stats = {
  "total_rows": int(len(df)),
  "rows_used": int(len(sub)),
  "groups": {}
}
for name in ["low","mid","high"]:
    d = sub[sub["group"]==name]
    stats["groups"][name] = {
        "n": int(len(d)),
        "math_score_mean": round(float(d["math_score"].mean()), 4),
        "math_score_std": round(float(d["math_score"].std(ddof=1)), 4),
        "math_score_min": int(d["math_score"].min()),
        "math_score_max": int(d["math_score"].max()),
        "study_hours_min": float(d["study_hours_per_week"].min()),
        "study_hours_max": float(d["study_hours_per_week"].max()),
        "study_hours_mean": round(float(d["study_hours_per_week"].mean()), 4),
    }
lo = stats["groups"]["low"]["math_score_mean"]
hi = stats["groups"]["high"]["math_score_mean"]
mid = stats["groups"]["mid"]["math_score_mean"]
stats["gain_low_to_high"] = round(hi - lo, 4)
stats["gain_low_to_mid"] = round(mid - lo, 4)
stats["gain_mid_to_high"] = round(hi - mid, 4)
stats["ratio_high_over_low"] = round(hi / lo, 4)

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-03-r5\_sandbox\tmp\step2_group_stats.json"
with open(path,"w",encoding="utf-8") as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)
print(json.dumps(stats, ensure_ascii=False, indent=2))

```
