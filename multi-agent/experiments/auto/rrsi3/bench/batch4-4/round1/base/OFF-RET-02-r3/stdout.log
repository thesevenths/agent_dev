```python
import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub = sub.sort_values("week").reset_index(drop=True)

sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week series
per_week = sub[["week", "group"] + metrics].copy()

# group means
means = sub.groupby("group")[metrics].mean().reset_index()
n = sub.groupby("group").size().rename("n_rows").reset_index()
means = means.merge(n, on="group")

# deltas: W37-W43 minus W30-W36
m1 = means[means["group"] == "W30-W36"].iloc[0]
m2 = means[means["group"] == "W37-W43"].iloc[0]
delta = pd.DataFrame({
    "metric": metrics,
    "W30-W36_mean": [m1[m] for m in metrics],
    "W37-W43_mean": [m2[m] for m in metrics],
    "abs_diff": [m2[m] - m1[m] for m in metrics],
    "rel_diff_pct": [(m2[m] - m1[m]) / m1[m] * 100 for m in metrics],
})

# breakpoint detection: week-over-week change in W30-W43
pw = per_week.copy()
for m in metrics:
    pw[f"{m}_wow"] = pw[m].diff()

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r3\_sandbox\tmp"
per_week.to_csv(f"{out_dir}/step2_per_week.csv", index=False)
means.to_csv(f"{out_dir}/step2_group_means.csv", index=False)
delta.to_csv(f"{out_dir}/step2_delta.csv", index=False)

print("=== per_week ===")
print(per_week.to_string(index=False))
print("\n=== group means ===")
print(means.to_string(index=False))
print("\n=== delta ===")
print(delta.to_string(index=False))
print("\n=== wow changes ===")
print(pw[["week"] + [f"{m}_wow" for m in metrics]].to_string(index=False))

```
