```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("nulls:\n", df.isna().sum())
print("week range:", df.week.min(), "->", df.week.max())
print("week unique count:", df.week.nunique())

s = df[df.week.between("W30","W43")]
print("\nW30-W43 slice:")
print(s.to_string(index=False))

pre = df[df.week.between("W30","W36")]
post = df[df.week.between("W37","W43")]
cols = ["retention_d7","churn_rate","arpu_usd"]
print("\npre W30-W36 n=", len(pre), "post W37-W43 n=", len(post))
for c in cols:
    a,b = pre[c].mean(), post[c].mean()
    print(f"{c}: pre={a:.6f} post={b:.6f} diff={b-a:+.6f} rel={(b-a)/a*100:+.2f}%")

# per-week diffs to locate breakpoint
d = s[cols].copy()
d["ret_d7_wow"] = d.retention_d7.diff()
d["churn_wow"] = d.churn_rate.diff()
d["arpu_wow"] = d.arpu_usd.diff()
print("\nWoW changes:")
print(d.to_string(index=False))

```
