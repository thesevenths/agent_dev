import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r3\_sandbox\tmp\step2_group_means_breakpoint.csv"

df = pd.read_csv(src)
s = df[df.week.between("W30","W43")].copy()
s["group"] = s.week.apply(lambda w: "pre_W30-W36" if w <= "W36" else "post_W37-W43")

cols = ["retention_d7","churn_rate","arpu_usd"]
# per-week with WoW
for c in cols:
    s[f"{c}_wow"] = s[c].diff()

# group means
gm = s.groupby("group")[cols].agg(["mean","std","min","max","count"]).round(6)
gm.columns = [f"{c}_{a}" for c,a in gm.columns]
gm = gm.reset_index()

# diff rows
pre = s[s.group=="pre_W30-W36"][cols].mean()
post = s[s.group=="post_W37-W43"][cols].mean()
diff = pd.DataFrame({
    "metric": cols,
    "pre_mean": pre.round(6),
    "post_mean": post.round(6),
    "abs_diff": (post-pre).round(6),
    "rel_diff_pct": ((post-pre)/pre*100).round(4),
})

# breakpoint: week with max |z-like| jump — use max abs WoW across the 3 metrics (scaled)
# simple rule: week where churn_rate WoW is max AND retention WoW is min
bp = s.loc[s.churn_rate_wow.idxmax(), ["week","retention_d7","churn_rate","arpu_usd"]]
print("breakpoint week (max churn WoW):", bp.to_dict())

# write combined CSV: per-week table + group means + diff
with open(out, "w", encoding="utf-8-sig") as f:
    f.write("# per-week W30-W43\n")
    s[["week","group","retention_d7","churn_rate","arpu_usd","retention_d7_wow","churn_rate_wow","arpu_usd_wow"]].to_csv(f, index=False)
    f.write("\n# group means (W30-W36 vs W37-W43)\n")
    gm.to_csv(f, index=False)
    f.write("\n# group diff (post - pre)\n")
    diff.to_csv(f, index=False)
    f.write("\n# breakpoint\n")
    pd.DataFrame([{"breakpoint_week": "W36->W37", "note": "max churn_rate WoW jump at W37"}]).to_csv(f, index=False)

print(diff.to_string(index=False))
print("\nsaved:", out)
print(s[["week","retention_d7","churn_rate","arpu_usd","churn_rate_wow"]].to_string(index=False))

```
