import pandas as pd, json, numpy as np

df = pd.read_csv("offline_data/students.csv")
m = df["math_score"]; r = df["reading_score"]
n = len(df)
missing = int(df[["math_score","reading_score"]].isna().sum().sum())

def stats(s):
    mean = s.mean(); std = s.std(ddof=1); med = s.median()
    return {"mean": float(mean), "std_sample": float(std), "std_pop": float(s.std(ddof=0)),
            "median": float(med), "cv": float(std/mean), "min": float(s.min()), "max": float(s.max())}

sm, sr = stats(m), stats(r)
corr = float(np.corrcoef(m, r)[0,1])

out = {
  "source_file": "offline_data/students.csv",
  "n_rows": n, "missing_values": missing,
  "math_score": sm, "reading_score": sr,
  "pearson_corr": corr,
  "cv_larger": "math_score" if sm["cv"] > sr["cv"] else "reading_score",
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-STAT-02-r4\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
with open(os.path.join(out_dir, "stats_results.json"), "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))

```
