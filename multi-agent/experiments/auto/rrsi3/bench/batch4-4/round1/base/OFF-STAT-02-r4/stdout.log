import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-STAT-02-r4\_sandbox"
out_dir = os.path.join(base, "tmp")
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
m, r = df["math_score"], df["reading_score"]

res = {
    "n_rows": int(len(df)),
    "n_math": int(m.count()), "n_reading": int(r.count()),
    "math_mean": float(m.mean()), "math_std_sample": float(m.std(ddof=1)), "math_std_pop": float(m.std(ddof=0)),
    "math_median": float(m.median()), "math_min": int(m.min()), "math_max": int(m.max()),
    "reading_mean": float(r.mean()), "reading_std_sample": float(r.std(ddof=1)), "reading_std_pop": float(r.std(ddof=0)),
    "reading_median": float(r.median()), "reading_min": int(r.min()), "reading_max": int(r.max()),
    "pearson": float(m.corr(r)),
    "cv_math_sample": float(m.std(ddof=1)/m.mean()), "cv_reading_sample": float(r.std(ddof=1)/r.mean()),
    "cv_math_pop": float(m.std(ddof=0)/m.mean()), "cv_reading_pop": float(r.std(ddof=0)/r.mean()),
}
with open(os.path.join(out_dir, "step1_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print(json.dumps(res, indent=2))

