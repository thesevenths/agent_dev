import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r5\_sandbox\tmp"

df = pd.read_csv(src)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g['mean_reading_score'] = g['mean'].round(4)
g = g.rename(columns={'count':'row_count','mean':'mean_raw'})
g = g[['grade','region','row_count','mean_reading_score','mean_raw']]
g = g.sort_values(['grade','region']).reset_index(drop=True)
