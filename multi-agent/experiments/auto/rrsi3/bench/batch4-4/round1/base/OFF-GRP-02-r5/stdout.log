```python
import pandas as pd, json

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-02-r5\_sandbox\tmp"

df = pd.read_csv(src)
g = df.groupby(['grade','region'], observed=True).agg(
    n=('reading_score','size'),
    mean_reading=('reading_score','mean'),
    min_reading=('reading_score','min'),
    max_reading=('reading_score','max'),
    sum_reading=('reading_score','sum'),
).reset_index()
g['mean_reading'] = g['mean_reading'].round(4)
g = g.sort_values(['grade','region']).reset_index(drop=True)
print(g.to_string(index=False))

hi = g.loc[g['mean_reading'].idxmax()]
lo = g.loc[g['mean_reading'].idxmin()]
print("MAX:", hi)
print("MIN:", lo)
print("overall n:", len(df), "overall mean:", round(df['reading_score'].mean(),4))

g.to_csv(out_dir + r"\crosstab_stats.csv", index=False)
meta = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "overall_mean_reading": round(float(df['reading_score'].mean()),4),
  "max_cell": {"grade": hi['grade'], "region": hi['region'], "n": int(hi['n']), "mean": float(hi['mean_reading'])},
  "min_cell": {"grade": lo['grade'], "region": lo['region'], "n": int(lo['n']), "mean": float(lo['mean_reading'])},
}
with open(out_dir + r"\crosstab_meta.json","w",encoding="utf-8") as f:
    json.dump(meta,f,ensure_ascii=False,indent=2)
print("saved")

```
