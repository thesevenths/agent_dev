import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
# 低(<2.5)、中(2.5-4.5)、高(>4.5)
def grp(x):
    if x < 2.5: return "low"
    if x <= 4.5: return "mid"
    return "high"
df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(n=("math_score","size"), mean=("math_score","mean"), std=("math_score","std"), min=("math_score","min"), max=("math_score","max"))
print(g)
print("gain:", g.loc["high","mean"]-g.loc["low","mean"])
print("ratio:", g.loc["high","mean"]/g.loc["low","mean"])
out = {
 "file": "offline_data/students.csv",
 "rows": int(df.shape[0]), "cols": int(df.shape[1]),
 "columns": list(df.columns),
 "missing": {c:int(df[c].isna().sum()) for c in ["study_hours_per_week","math_score"]},
 "grouping_rule": "low: study_hours_per_week<2.5; mid: 2.5<=x<=4.5; high: x>4.5",
 "group_stats": g.reset_index().astype({"group":str}).to_dict("records"),
 "gain_high_minus_low": float(g.loc["high","mean"]-g.loc["low","mean"]),
 "ratio_high_over_low": float(g.loc["high","mean"]/g.loc["low","mean"]),
 "as_of": "2026-10-26 06:29",
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-03-r4\_sandbox\tmp\validation_summary.json","w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print("saved")

