import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]; last = r.iloc[30:]
overall_mean = r.mean(); overall_std = r.std(ddof=1)
first_std = first.std(ddof=1); last_std = last.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": f"{df['week'].iloc[0]}-{df['week'].iloc[29]}", "n": 30,
                "mean": float(first.mean()), "std": float(first_std)},
    "last30": {"weeks": f"{df['week'].iloc[30]}-{df['week'].iloc[59]}", "n": 30,
               "mean": float(last.mean()), "std": float(last_std)},
    "diff_mean_last_minus_first": float(last.mean() - first.mean()),
    "overall": {"mean": float(overall_mean), "std": float(overall_std), "n": 60},
    "threshold_mean_minus_2std": float(threshold),
    "weeks_below_threshold_count": int(len(below)),
    "weeks_below_threshold": below["week"].tolist(),
    "std_definition": "sample std, ddof=1",
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-01-r2\_sandbox\tmp"
os.makedirs(out, exist_ok=True)
p = os.path.join(out, "retention_d7_stats.json")
with open(p, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", p)

```
