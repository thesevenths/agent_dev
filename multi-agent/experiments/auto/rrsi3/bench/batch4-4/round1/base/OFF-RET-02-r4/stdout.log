import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r4\_sandbox\tmp\step2_breakpoint_stats.csv"

df = pd.read_csv(src)
weeks = [f"W{i:02d}" for i in range(30, 44)]
sl = df[df["week"].isin(weeks)].copy()
sl["segment"] = sl["week"].apply(lambda w: "pre_W30-W36" if int(w[1:]) <= 36 else "post_W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week table
per_week = sl[["week", "segment"] + metrics].copy()

# group means
g = sl.groupby("segment")[metrics].mean()
n = sl.groupby("segment").size()

# deltas (post - pre) and relative change
delta = g.loc["post_W37-W43"] - g.loc["pre_W30-W36"]
rel = delta / g.loc["pre_W30-W36"]

summary = pd.DataFrame({
    "n_weeks": n,
    "retention_d7_mean": g["retention_d7"],
    "churn_rate_mean": g["churn_rate"],
    "arpu_usd_mean": g["arpu_usd"],
})
summary["retention_d7_delta"] = delta["retention_d7"]
summary["churn_rate_delta"] = delta["churn_rate"]
summary["arpu_usd_delta"] = delta["arpu_usd"]
summary["retention_d7_rel"] = rel["retention_d7"]
summary["churn_rate_rel"] = rel["churn_rate"]
summary["arpu_usd_rel"] = rel["arpu_usd"]

# breakpoint pinpointing: week-over-week change in pre/post window
sl["wow_ret"] = sl["retention_d7"].diff()
sl["wow_churn"] = sl["churn_rate"].diff()
sl["wow_arpu"] = sl["arpu_usd"].diff()
wow = sl[["week", "wow_ret", "wow_churn", "wow_arpu"]]

with pd.ExcelWriter(out.replace(".csv", ".xlsx")) as xw:
    per_week.to_excel(xw, sheet_name="per_week", index=False)
    summary.to_excel(xw, sheet_name="group_summary")
    wow.to_excel(xw, sheet_name="wow", index=False)

# also save plain CSV (per-week + summary concatenated with a section marker)
with open(out, "w", encoding="utf-8") as f:
    f.write("section,week,segment,retention_d7,churn_rate,arpu_usd\n")
    for _, r in per_week.iterrows():
        f.write(f"per_week,{r.week},{r.segment},{r.retention_d7},{r.churn_rate},{r.arpu_usd}\n")
    for seg in ["pre_W30-W36", "post_W37-W43"]:
        s = summary.loc[seg]
        f.write(f"group_mean,{seg},{seg},{s.retention_d7_mean:.6f},{s.churn_rate_mean:.6f},{s.arpu_usd_mean:.6f}\n")
    f.write("section,week,wow_retention_d7,wow_churn_rate,wow_arpu_usd\n")
    for _, r in wow.iterrows():
        f.write(f"wow,{r.week},{r.wow_ret:.4f},{r.wow_churn:.4f},{r.wow_arpu:.4f}\n")

print(summary.to_string())
print()
print(wow.to_string(index=False))
print()
print("saved:", out)

