import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
df["wk"] = df["week"].str[1:].astype(int)
sel = df[(df["wk"]>=30)&(df["wk"]<=43)].copy()
sel["group"] = sel["wk"].apply(lambda w: "W30-W36" if w<=36 else "W37-W43")

metrics = ["retention_d7","churn_rate","arpu_usd"]
means = sel.groupby("group")[metrics].mean()
n = sel.groupby("group").size()
print(means)
print(n)

# per-week deltas to pinpoint breakpoint
sel["d_ret"] = sel["retention_d7"].diff()
sel["d_churn"] = sel["churn_rate"].diff()
sel["d_arpu"] = sel["arpu_usd"].diff()
print(sel[["week","retention_d7","churn_rate","arpu_usd","d_ret","d_churn","d_arpu"]].to_string(index=False))

# group means with more precision
for g in ["W30-W36","W37-W43"]:
    sub = sel[sel["group"]==g]
    print(g, {m: round(sub[m].mean(),6) for m in metrics}, "n=",len(sub))

# differences
