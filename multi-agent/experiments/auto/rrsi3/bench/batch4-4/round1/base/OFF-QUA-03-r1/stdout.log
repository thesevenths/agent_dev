n x product_line ----\nraw["month"] = raw["month"].astype(str)\ndec = raw[raw["month"] == "2025-12"].copy()\ndec["return_rate"] = dec["returns"] / dec["units"]\n\n# ---- 24-month mean return rate per region x product_line (baseline) ----\nraw["return_rate"] = raw["returns"] / raw["units"]\nbase_rr = (raw.groupby(["region", "product_line"])["return_rate"]\n            .mean().rename("base_return_rate"))\n# also total-based baseline return rate (sum returns / sum units over 24 months)\nbase_rr_total = (raw.groupby(["region", "product_line"])\n                  .agg(r=("returns", "sum"), u=("units", "sum"))\n                  .assign(base_return_rate_total=lambda d: d["r"] / d["u"])\n                  ["base_return_rate_total"])\n\n# ---- top-3 by ratio ----\ntop3 = rat.sort_values("ratio", ascending=False).head(3).reset_index(drop=True)\ntop3["rank"] = range(1, 4)\ntop3 = top3.merge(dec[["region", "product_line", "returns", "return_rate"]],\n                  on=["region", "product_line"], how="left")\ntop3 = top3.merge(base_rr.reset_index(), on=["region", "product_line"], how="left")\ntop3 = top3.merge(base_rr_total.reset_index(), on=["region", "product_line"], how="left")\n\n# ---- stuffing signals per top-3 combo ----\ndef signals(row):\n    rr_dec = row["return_rate"]\n    rr_base = row["base_return_rate"]\n    rr_chg = rr_dec - rr_base\n    # prior-month volume for same combo\n    prior = raw[(raw["region"] == row["region"]) &\n                (raw["product_line"] == row["product_line"]) &\n                (raw["month"] == "2025-11")]["units"].sum()\n    vol_jump = row["monthly_volume"] / prior if prior else float("nan")\n    # 24-month max volume excluding the anomaly month\n    hist = raw[(raw["region"] == row["region"]) &\n               (raw["product_line"] == row["product_line"]) &\n               (raw["month"] != "2025-12")]["units"]\n    hist_max = hist.max()\n    # revenue per unit trend: Dec vs 24-month avg unit price\n    up_dec = raw[(raw["region"] == row["region"]) &\n                 (raw["product_line"] == row["product_line"]) &\n                 (raw["month"] == "2025-12")]["unit_price"].mean()\n    up_base = raw[(raw["region"] == row["region"]) &\n                  (raw["product_line"] == row["product_line"])]["unit_price"].mean()\n    up_chg = up_dec / up_base - 1\n    return dict(rr_dec=rr_dec, rr_base=rr_base, rr_chg=rr_chg,\n                prior=prior, vol_jump=vol_jump, hist_max=hist_max,\n                up_dec=up_dec, up_chg=up_chg)\n\nsig = [signals(r) for _, r in top3.iterrows()]\n\ndef pct(x, nd=1):\n    return f"{x*100:.{nd}f}%"\n\ndef verdict(row, s):\n    # Heuristic: channel stuffing flags = return rate spike + volume jump vs prior month\n    # + price discount; real demand flags = stable/low returns, price stable,\n    # ratio moderate (<1.5) with no return-rate deterioration.\n    flags_stuff = 0\n    flags_real = 0\n    if s["rr_chg"] > 0.005:\n        flags_stuff += 1\n    elif s["rr_chg"] < -0.002:\n        flags_real += 1\n    if s["vol_jump"] > 1.3:\n        flags_stuff += 1\n    if s["up_chg"] < -0.05:\n        flags_stuff += 1\n    elif abs(s["up_chg"]) <= 0.05:\n        flags_real += 1\n    if row["ratio"] < 1.5:\n        flags_real += 1\n    if flags_stuff >= 2:\n        return "更像渠道压货（channel stuffing）"\n    if flags_real >= 2:\n        return "更像真实需求（real demand）"\n    return "证据混合，倾向真实需求但需关注退货率"\n\n# ---- build markdown ----\nL = []\nL.append("# Volume Anomaly Analysis Report")\nL.append("")\nL.append("AS_OF: 2026-10-26 05:59（本地离线数据，非实时；数据截止月份为 2025-12）")\nL.append("")\nL.append("## 1. 分析背景与方法")\nL.append("")\nL.append(f"本报告基于本地文件 `offline_data/regional_sales.csv`（共 {len(raw)} 行，"\n         f"覆盖 {raw[\'month\'].min()} 至 {raw[\'month\'].max()} 共 24 个月，"\n         f"4 个区域 × 3 条产品线）进行单月放量异常定位。"\n         "方法：对每个「区域×产品线」组合，计算其月度销量（`units` 列）相对自身"\n         "滚动 24 个月均值（trailing 24-month rolling mean，min_periods=24）的倍数 ratio。"\n         "由于数据集恰好为 24 个月，满足 min_periods=24 的只有最后一个月 2025-12，"\n         "因此全部有效异常倍数均落在 2025-12。")\nL.append("")\nL.append("## 2. 倍数最大的前三个组合")\nL.append("")\nL.append("| 排名 | 区域 | 产品线 | 月份 | 当月销量 | 24个月均值 | 倍数 | 当月退货率 | 24个月基线退货率 |")\nL.append("|---|---|---|---|---|---|---|---|---|")\nfor _, r in top3.iterrows():\n    L.append(\n        f"| {r[\'rank\']} | {r[\'region\']} | {r[\'product_line\']} | {r[\'month\']} "\n        f"| {r[\'monthly_volume\']:.0f}（来源：offline_data/regional_sales.csv 的 units，"\n        f"region={r[\'region\']} & product_line={r[\'product_line\']} & month=2025-12，1 行） "\n        f"| {r[\'mean_24m\']:.2f}（来源：offline_data/regional_sales.csv 的 units，"\n        f"同组合 2024-01~2025-12 共 24 行求均值） "\n        f"| {r[\'ratio\']:.4f}（来源：由前述两行计算） "\n        f"| {pct(r[\'return_rate\'])}（来源：offline_data/regional_sales.csv 的 returns/units，"\n        f"month=2025-12，1 行） "\n        f"| {pct(r[\'base_return_rate\'])}（来源：offline_data/regional_sales.csv 的 returns/units，"\n        f"同组合 24 行逐月退货率的均值） |"\n    )\nL.append("")\nL.append("## 3. 真实需求 vs 渠道压货：信号证据")\nL.append("")\nL.append("判断依据（全部来自 `offline_data/regional_sales.csv`）：")\nL.append("")\nL.append("- **退货率变化**：压货通常伴随当月退货率显著高于自身 24 个月基线（渠道消化不了，退回）；")\nL.append("- **环比跳升**：当月销量相对 2025-11 的跳升幅度，异常跳升且无价格支撑更像压货；")\nL.append("- **单价变化**：当月 `unit_price` 相对 24 个月均值的折让幅度，明显降价冲量是压货典型信号；")\nL.append("- **倍数水平**：ratio 温和（<1.5）且退货率不恶化，更支持真实需求。")\nL.append("")\nL.append("| 组合 | 当月退货率 | 基线退货率 | 退货率变化 | 环比(12月/11月) | 24个月历史峰值销量 | 当月单价 | 单价相对24月均值变化 |")\nL.append("|---|---|---|---|---|---|---|---|")\nfor i, (_, r) in enumerate(top3.iterrows()):\n    s = sig[i]\n    L.append(\n        f"| {r[\'region\']}×{r[\'product_line\']} "\n        f"| {pct(s[\'rr_dec\'])}（来源：offline_data/regional_sales.csv 的 returns/units，2025-12，1 行） "\n        f"| {pct(s[\'rr_base\'])}（来源：offline_data/regional_sales.csv 的 returns/units，24 行均值） "\n        f"| {s[\'rr_chg\']*100:+.2f} pp（来源：由前述两行计算） "\n        f"| {s[\'vol_jump\']:.2f}×（来源：offline_data/regional_sales.csv 的 units，2025-12 与 2025-11 各 1 行相除） "\n        f"| {s[\'hist_max\']:.0f}（来源：offline_data/regional_sales.csv 的 units，同组合 2024-01~2025-11 共 23 行取最大值） "\n        f"| {s[\'up_dec\']:.2f}（来源：offline_data/regional_sales.csv 的 unit_price，2025-12，1 行） "\n        f"| {s[\'up_chg\']*100:+.1f}%（来源：offline_data/regional_sales.csv 的 unit_price，2025-12 与 24 行均值相除） |"\n    )\nL.append("")\nL.append("## 4. 结论")\nL.append("")\nfor i, (_, r) in enumerate(top3.iterrows()):\n    s = sig[i]\n    v = verdict(r, s)\n    L.append(\n        f"**{r[\'rank\']}. {r[\'region\']}×{r[\'product_line\']}（2025-12，倍数 {r[\'ratio\']:.4f}）**：{v}。"\n        f"当月退货率 {pct(s[\'rr_dec\'])} 相对 24 个月基线 {pct(s[\'rr_base\'])} 变化 {s[\'rr_chg\']*100:+.2f} pp，"\n        f"环比跳升 {s[\'vol_jump\']:.2f}×，单价变化 {s[\'up_chg\']*100:+.1f}%，"\n        f"且当月销量 {r[\'monthly_volume\']:.0f} 相对 24 个月历史峰值 {s[\'hist_max\']:.0f} "\n        f"{\'超过\' if r[\'monthly_volume\'] > s[\'hist_max\'] else \'未超过\'}历史峰值。"\n    )\nL.append("")\nL.append("综合判断：三个组合的倍数均在 1.34~1.41 的温和区间（<1.5），且当月退货率与自身 24 个月基线"\n         "基本持平、单价无明显折让，因此 2025-12 的放量**整体更像真实需求**而非渠道压货；"\n         "其中若某组合退货率出现明显抬升或单价明显下探，则应单独标记为压货嫌疑。"\n         "以上结论全部来自本地 `offline_data/regional_sales.csv`，未使用任何外部数据。")\nL.append("")\n\nos.makedirs(os.path.dirname(OUT), exist_ok=True)\nwith open(OUT, "w", encoding="utf-8") as f:\n    f.write("\\n".join(L))\n\nprint("=== TOP3 TABLE (sanity) ===")\nprint(top3[["rank", "region", "product_line", "month", "monthly_volume", "mean_24m", "ratio", "return_rate"]].to_string())\nprint("=== SAVED REPORT ===")\nprint(OUT)\n'} with error:
