import pandas as pd
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-03-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-03-r0\_sandbox\tmp"
df = pd.read_csv(p)
n = len(df)

r_arpu = df['retention_d7'].corr(df['arpu_usd'])
r_churn = df['retention_d7'].corr(df['churn_rate'])
med = df['retention_d7'].median()
hi = df[df['retention_d7'] > med]
lo = df[df['retention_d7'] <= med]

rows = [
    {"metric": "pearson_retention_d7_vs_arpu_usd", "value": round(r_arpu, 6), "n": n},
    {"metric": "pearson_retention_d7_vs_churn_rate", "value": round(r_churn, 6), "n": n},
    {"metric": "retention_d7_median", "value": med, "n": n},
    {"metric": "high_group_arpu_usd_mean", "value": round(hi['arpu_usd'].mean(), 6), "n": len(hi)},
    {"metric": "low_group_arpu_usd_mean", "value": round(lo['arpu_usd'].mean(), 6), "n": len(lo)},
    {"metric": "high_group_cohort_size_sum", "value": int(hi['cohort_size'].sum()), "n": len(hi)},
    {"metric": "low_group_cohort_size_sum", "value": int(lo['cohort_size'].sum()), "n": len(lo)},
]
res = pd.DataFrame(rows)
out = out_dir + r"\step2_results.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

```
