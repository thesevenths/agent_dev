```python
import pandas as pd, json, os
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

def grp(g):
    return {
        "n": int(len(g)),
        "mean_screen": round(float(g["screen_hours_per_day"].mean()), 4),
        "mean_math": round(float(g["math_score"].mean()), 4),
        "mean_reading": round(float(g["reading_score"].mean()), 4),
        "std_math": round(float(g["math_score"].std(ddof=1)), 4),
        "std_reading": round(float(g["reading_score"].std(ddof=1)), 4),
    }

g_hi, g_lo = grp(hi), grp(lo)

# t-tests (Welch)
t_math, p_math = stats.ttest_ind(hi["math_score"], lo["math_score"], equal_var=False)
t_read, p_read = stats.ttest_ind(hi["reading_score"], lo["reading_score"], equal_var=False)

out = {
    "source_file": path,
    "split_rule": "screen_hours_per_day > 5 (high) vs <= 5 (low)",
    "high_group": g_hi,
    "low_group": g_lo,
    "diff_high_minus_low": {
        "n": g_hi["n"] - g_lo["n"],
        "mean_math": round(g_hi["mean_math"] - g_lo["mean_math"], 4),
        "mean_reading": round(g_hi["mean_reading"] - g_lo["mean_reading"], 4),
    },
    "welch_ttest": {
        "math": {"t": round(float(t_math), 4), "p_value": float(f"{p_math:.6g}")},
        "reading": {"t": round(float(t_read), 4), "p_value": float(f"{p_read:.6g}")},
    },
}
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r5\_sandbox\tmp"
outpath = os.path.join(outdir, "step3_group_stats.json")
with open(outpath, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", outpath)

```
