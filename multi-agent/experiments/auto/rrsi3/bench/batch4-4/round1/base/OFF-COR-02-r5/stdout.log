import pandas as pd, json

df = pd.read_csv('offline_data/students.csv')
cols = ['screen_hours_per_day','math_score','reading_score']
sub = df[cols].dropna()
n = len(sub)
r_math = sub['screen_hours_per_day'].corr(sub['math_score'])
r_read = sub['screen_hours_per_day'].corr(sub['reading_score'])
print('n =', n)
print('r(screen, math)   =', r_math)
print('r(screen, reading)=', r_read)

out = {
  "file": "offline_data/students.csv",
  "method": "Pearson correlation",
  "sample_size": n,
  "correlations": {
    "screen_hours_per_day_vs_math_score": round(r_math, 6),
    "screen_hours_per_day_vs_reading_score": round(r_read, 6)
  },
  "full_precision": {
    "screen_hours_per_day_vs_math_score": r_math,
    "screen_hours_per_day_vs_reading_score": r_read
  }
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r5\_sandbox\tmp\step2_correlations.json"
with open(path,'w',encoding='utf-8') as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print('saved', path)

```
