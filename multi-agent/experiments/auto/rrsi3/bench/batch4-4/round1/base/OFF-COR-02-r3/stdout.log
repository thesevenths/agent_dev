]
out = pd.DataFrame(rows)
csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r3\_sandbox\tmp\step3_group_stats.csv"
out.to_csv(csv_path, index=False)
print(out.to_string())

# t-tests for reference
from scipy.stats import ttest_ind
t_m, p_m = ttest_ind(df.loc[df.group=="high_gt5","math_score"], df.loc[df.group=="low_le5","math_score"])
t_r, p_r = ttest_ind(df.loc[df.group=="high_gt5","reading_score"], df.loc[df.group=="low_le5","reading_score"])
print("t-test math: t=%.4f p=%.4f" % (t_m, p_m))
print("t-test reading: t=%.4f p=%.4f" % (t_r, p_r))

json_out = {
    "n_total": int(len(df)),
    "groups": {
        "low_le5": {"n": int(low.n), "screen_mean": round(float(low.screen_mean),4), "math_mean": round(float(low.math_mean),4), "reading_mean": round(float(low.reading_mean),4)},
        "high_gt5": {"n": int(high.n), "screen_mean": round(float(high.screen_mean),4), "math_mean": round(float(high.math_mean),4), "reading_mean": round(float(high.reading_mean),4)},
    },
    "diff_high_minus_low": {"math": round(float(diff_math),4), "reading": round(float(diff_read),4)},
    "ttest_high_vs_low": {"math": {"t": float(t_m), "p": float(p_m)}, "reading": {"t": float(t_r), "p": float(p_r)}},
}
