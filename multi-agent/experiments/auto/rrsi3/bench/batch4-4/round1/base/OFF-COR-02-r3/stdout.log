import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r3\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"], method="pearson")
r_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")

# also spearman for robustness
from scipy.stats import pearsonr, spearmanr
pm, pm_p = pearsonr(df["screen_hours_per_day"], df["math_score"])
pr, pr_p = pearsonr(df["screen_hours_per_day"], df["reading_score"])
sm, sm_p = spearmanr(df["screen_hours_per_day"], df["math_score"])
sr, sr_p = spearmanr(df["screen_hours_per_day"], df["reading_score"])

out = {
    "n": n,
    "pearson": {
        "screen_vs_math": {"r": round(float(r_math), 6), "p_value": float(pm_p)},
        "screen_vs_reading": {"r": round(float(r_read), 6), "p_value": float(pr_p)},
    },
    "spearman": {
        "screen_vs_math": {"rho": round(float(sm), 6), "p_value": float(sm_p)},
        "screen_vs_reading": {"rho": round(float(sr), 6), "p_value": float(sr_p)},
    },
    "means": {
        "screen_hours_per_day": float(df["screen_hours_per_day"].mean()),
        "math_score": float(df["math_score"].mean()),
        "reading_score": float(df["reading_score"].mean()),
    },
    "stds": {
        "screen_hours_per_day": float(df["screen_hours_per_day"].std(ddof=1)),
        "math_score": float(df["math_score"].std(ddof=1)),
        "reading_score": float(df["reading_score"].std(ddof=1)),
    },
}
print(json.dumps(out, indent=2, ensure_ascii=False))

out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r3\_sandbox\tmp\step2_correlations.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)

# also a small CSV
rows = [
    {"pair": "screen_hours_per_day vs math_score", "pearson_r": round(float(r_math),6), "p_value": float(pm_p), "spearman_rho": round(float(sm),6), "n": n},
    {"pair": "screen_hours_per_day vs reading_score", "pearson_r": round(float(r_read),6), "p_value": float(pr_p), "spearman_rho": round(float(sr),6), "n": n},
]
csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r3\_sandbox\tmp\step2_correlations.csv"
pd.DataFrame(rows).to_csv(csv_path, index=False)
print("saved:", out_path, csv_path)

