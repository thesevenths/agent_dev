import pandas as pd
import os

src = 'F:/agent/multi-agent/offline_data/regional_sales.csv'
out_dir = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-QUA-02-r5\_sandbox\tmp'
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(src)
print("COLUMNS:", list(df.columns))
print("DTYPES:\n", df.dtypes)
print("ROW_COUNT:", len(df))
print("HEAD:\n", df.head(5).to_string())

# revenue check
exp = df['units'] * df['unit_price']
dev = (df['revenue'] - exp).abs() / exp.abs()
flag = dev > 0.005
print("FLAGGED_ROWS:", int(flag.sum()))
print("MAX_ABS_DEV:", float(dev.max()))
print("MAX_REL_DEV:", float(dev.max()))
print("MAX_REL_DEV_PCT:", float(dev.max()*100))

# returns check
bad_ret = df['returns'] > df['units']
print("RETURNS_GT_UNITS_ROWS:", int(bad_ret.sum()))

# save flagged rows summary
flagged = df[flag].copy()
flagged['expected_revenue'] = exp[flag]
flagged['abs_deviation'] = (df['revenue'] - exp)[flag]
flagged['rel_deviation_pct'] = dev[flag] * 100
out_csv = os.path.join(out_dir, 'revenue_check_summary.csv')
flagged.to_csv(out_csv, index=False)
print("SAVED:", out_csv)
print("FLAGGED_ROWS_IN_CSV:", len(flagged))

# extra context for report
print("TOTAL_ROWS:", len(df))
print("MEAN_REL_DEV_PCT:", float(dev.mean()*100))
print("NAN_REVENUE:", int(df['revenue'].isna().sum()), "NAN_UNITS:", int(df['units'].isna().sum()), "NAN_PRICE:", int(df['unit_price'].isna().sum()))
print("RETURNS_TOTAL:", int(df['returns'].sum()), "UNITS_TOTAL:", int(df['units'].sum()))
print("RETURNS_GT_UNITS_MAX_EXCESS:", int((df['returns']-df['units'])[bad_ret].max()) if bad_ret.any() else 0)
print("FLAGGED_MAX_ABS_DEV_VALUE:", float((df['revenue']-exp)[flag].abs().max()) if flag.any() else 0)

