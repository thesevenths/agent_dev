import json, csv, os

tmp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-TRD-03-r1\_sandbox\tmp"
with open(os.path.join(tmp, "step1_validation.json"), encoding="utf-8") as f:
    d = json.load(f)

regions = ["N", "S", "E", "W"]
grand = d["grand_total"]
n_months = d["n_months"]

rows = []
for r in regions:
    total = d["region_totals"][r]
    share = total / grand
    avg = total / n_months
    rows.append({
        "region": r,
        "total_revenue": round(total, 2),
        "share_of_grand_total": round(share, 6),
        "share_pct": round(share * 100, 2),
        "n_months": n_months,
        "monthly_avg_revenue": round(avg, 2),
        "n_rows": d["region_rows"][r],
    })

# top region & peak month
top = d["top_region"]
top_total = d["top_region_total"]
peak_month = d["top_region_peak_month"]
peak_val = d["top_region_peak_value"]
top_share = top_total / grand

# write main aggregates CSV
main_path = os.path.join(tmp, "step2_regional_aggregates.csv")
with open(main_path, "w", newline="", encoding="utf-8") as f:
    w = csv.DictWriter(f, fieldnames=["region","total_revenue","share_of_grand_total","share_pct","n_months","monthly_avg_revenue","n_rows"])
    w.writeheader()
    w.writerows(rows)
    # grand total row
    w.writerow({"region":"TOTAL","total_revenue":round(grand,2),"share_of_grand_total":1.0,"share_pct":100.0,
                "n_months":n_months,"monthly_avg_revenue":round(grand/n_months,2),"n_rows":d["n_rows"]})

# write top region / peak month CSV
top_path = os.path.join(tmp, "step2_top_region_peak.csv")
with open(top_path, "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)
    w.writerow(["metric","value","source_note"])
    w.writerow(["top_region", top, "max of region total_revenue (revenue summed per region, 72 rows each)"])
    w.writerow(["top_region_total_revenue", round(top_total,2), "offline_data/regional_sales.csv revenue, region=E, 72 rows sum"])
    w.writerow(["top_region_share_pct", round(top_share*100,2), "top_region_total / grand_total (126444439.57)"])
    w.writerow(["top_region_peak_month", peak_month, "max of E monthly revenue"])
    w.writerow(["top_region_peak_month_revenue", round(peak_val,2), "offline_data/regional_sales.csv revenue, region=E & month=2025-12, 3 rows sum"])
    w.writerow(["peak_month_share_of_region_pct", round(peak_val/top_total*100,2), "peak month revenue / E total"])

print(open(main_path, encoding="utf-8").read())
print(open(top_path, encoding="utf-8").read())
print("WROTE:", main_path)
print("WROTE:", top_path)

```
