import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

out = {}
out["file"] = os.path.abspath(path)
out["columns"] = list(df.columns)
out["n_rows"] = int(len(df))
out["regions"] = sorted(df["region"].unique().tolist())
out["months"] = [df["month"].min(), df["month"].max()]
out["n_months"] = int(df["month"].nunique())
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["null_counts"] = df.isna().sum().to_dict()
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}

# consistency check: revenue vs units*unit_price
df["calc"] = df["units"] * df["unit_price"]
df["diff"] = (df["calc"] - df["revenue"]).abs()
out["max_revenue_diff"] = float(df["diff"].max())

# per region
g = df.groupby("region")["revenue"].agg(["sum","count"])
out["region_totals"] = {r: float(v) for r, v in g["sum"].items()}
out["region_rows"] = {r: int(v) for r, v in g["count"].items()}
out["grand_total"] = float(df["revenue"].sum())

# monthly totals per region
m = df.groupby(["region","month"])["revenue"].sum().unstack()
out["monthly"] = {r: {k: float(v) for k, v in m[r].items()} for r in m.columns}

# top region & its peak month
top = out["region_totals"].max()
top_region = max(out["region_totals"], key=out["region_totals"].get)
peak_month, peak_val = max(out["monthly"][top_region].items(), key=lambda kv: kv[1])
out["top_region"] = top_region
out["top_region_total"] = top
out["top_region_peak_month"] = peak_month
out["top_region_peak_value"] = float(peak_val)

# monthly avg per region
out["monthly_avg"] = {r: out["region_totals"][r] / out["n_months"] for r in out["region_totals"]}
out["share"] = {r: out["region_totals"][r] / out["grand_total"] for r in out["region_totals"]}

# overall peak month (all regions) for context
out["overall_monthly_total"] = {k: float(v) for k, v in df.groupby("month")["revenue"].sum().items()}

os.makedirs("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch4-4\\round1\\base\\OFF-TRD-03-r1\\_sandbox\\tmp", exist_ok=True)
with open("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch4-4\\round1\\base\\OFF-TRD-03-r1\\_sandbox\\tmp\\step1_validation.json", "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(json.dumps(out, ensure_ascii=False, indent=2))

```
