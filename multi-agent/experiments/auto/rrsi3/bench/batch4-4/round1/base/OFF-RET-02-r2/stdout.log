```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r2\_sandbox\offline_data\app_metrics.csv"
out  = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r2\_sandbox\tmp\step2_breakpoint_results.csv"

df = pd.read_csv(path)
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df['week'].isin(weeks)].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# Per-week values
per_week = sub[['week'] + metrics].copy()

# Group means
means = sub.groupby('group')[metrics].mean().reset_index()
print(means.to_string())

# Deltas (after - before)
before = means[means['group']=='W30-W36'].iloc[0]
after  = means[means['group']=='W37-W43'].iloc[0]
delta = pd.DataFrame({'metric': metrics,
                      'W30-W36_mean': [before[m] for m in metrics],
                      'W37-W43_mean': [after[m] for m in metrics],
                      'delta_after_minus_before': [after[m]-before[m] for m in metrics],
                      'pct_change': [(after[m]-before[m])/before[m]*100 for m in metrics]})
print(delta.to_string())

# Per-week week-over-week change to locate breakpoint
wow = per_week.copy()
for m in metrics:
    wow[f'{m}_wow'] = wow[m].diff()
print(wow.to_string())

# Save combined CSV
with open(out, 'w', encoding='utf-8-sig') as f:
    f.write("# SECTION: per_week\n")
    per_week.to_csv(f, index=False)
    f.write("\n# SECTION: group_means\n")
    means.to_csv(f, index=False)
    f.write("\n# SECTION: delta\n")
    delta.to_csv(f, index=False)
    f.write("\n# SECTION: week_over_week\n")
    wow.to_csv(f, index=False)

print("saved:", out)

