metrics = ["retention_d7", "churn_rate", "arpu_usd"]

pre  = df[df["week"].between("W30", "W36")]
post = df[df["week"].between("W37", "W43")]

m_pre  = {m: pre[m].mean()  for m in metrics}
m_post = {m: post[m].mean() for m in metrics}

means = pd.DataFrame([
    {"group": "W30-W36 (pre)",  "n": len(pre),
     "retention_d7_mean": m_pre["retention_d7"], "churn_rate_mean": m_pre["churn_rate"], "arpu_usd_mean": m_pre["arpu_usd"]},
    {"group": "W37-W43 (post)", "n": len(post),
     "retention_d7_mean": m_post["retention_d7"], "churn_rate_mean": m_post["churn_rate"], "arpu_usd_mean": m_post["arpu_usd"]},
    {"group": "delta (post - pre)", "n": len(pre)+len(post),
     "retention_d7_mean": m_post["retention_d7"]-m_pre["retention_d7"],
     "churn_rate_mean":   m_post["churn_rate"]-m_pre["churn_rate"],
     "arpu_usd_mean":     m_post["arpu_usd"]-m_pre["arpu_usd"]},
    {"group": "delta_pct (post vs pre)", "n": "",
     "retention_d7_mean": (m_post["retention_d7"]-m_pre["retention_d7"])/m_pre["retention_d7"]*100,
     "churn_rate_mean":   (m_post["churn_rate"]-m_pre["churn_rate"])/m_pre["churn_rate"]*100,
     "arpu_usd_mean":     (m_post["arpu_usd"]-m_pre["arpu_usd"])/m_pre["arpu_usd"]*100},
])

per = df.copy()
for m in metrics:
    per[f"{m}_wow"] = per[m].diff()

rows = []
for i, w in enumerate(df["week"]):
    if i == 0:
        continue
    before, after = df.iloc[:i], df.iloc[i:]
    row = {"breakpoint_week": w, "n_before": len(before), "n_after": len(after)}
    for m in metrics:
        row[f"{m}_before_mean"] = before[m].mean()
        row[f"{m}_after_mean"]  = after[m].mean()
        row[f"{m}_shift"]       = after[m].mean() - before[m].mean()
    row["composite_badness"] = (-row["retention_d7_shift"] + row["churn_rate_shift"] - row["arpu_usd_shift"])
    rows.append(row)
bp = pd.DataFrame(rows)

