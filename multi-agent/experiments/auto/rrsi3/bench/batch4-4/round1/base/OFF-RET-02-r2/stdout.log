```python
import pandas as pd

sub_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r2\_sandbox\tmp\step1_app_metrics_w30_w43.csv"
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r2\_sandbox\tmp\step2_group_means_breakpoint.csv"

df = pd.read_csv(sub_path)
assert len(df) == 14 and list(df["week"]) == [f"W{i:02d}" for i in range(30, 44)]

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# Group means
pre  = df[df["week"].between("W30", "W36")]   # 7 rows
post = df[df["week"].between("W37", "W43")]   # 7 rows
means = pd.DataFrame({
    "group": ["W30-W36 (pre)", "W37-W43 (post)"],
    "n": [len(pre), len(post)],
    "retention_d7_mean": [pre["retention_d7"].mean(), post["retention_d7"].mean()],
    "churn_rate_mean":   [pre["churn_rate"].mean(),   post["churn_rate"].mean()],
    "arpu_usd_mean":     [pre["arpu_usd"].mean(),     post["arpu_usd"].mean()],
})
diff = post.iloc[0] - pre.iloc[0]
means.loc[len(means)] = ["delta (post - pre)", len(pre)+len(post),
                         diff["retention_d7_mean"], diff["churn_rate_mean"], diff["arpu_usd_mean"]]
pct = (diff / pre.iloc[0]) * 100
means.loc[len(means)] = ["delta_pct (post vs pre)", "",
                         pct["retention_d7_mean"], pct["churn_rate_mean"], pct["arpu_usd_mean"]]

# Per-week table with week-over-week deltas
per = df.copy()
for m in metrics:
    per[f"{m}_wow"] = per[m].diff()

# Breakpoint scoring: for each week W31..W43, compare that week's value to the
# mean of the 7 weeks before it (W24..W30 etc.) — but simpler & more robust:
# use the max |WoW change| in each metric and the cumulative shift.
# Also compute: for each candidate breakpoint week B (W31..W43),
# mean of weeks before B vs mean of weeks from B onward within W30-W43.
rows = []
for i, w in enumerate(df["week"]):
    if i == 0:
        continue
    before = df.iloc[:i]
    after  = df.iloc[i:]
    row = {"breakpoint_week": w, "n_before": len(before), "n_after": len(after)}
    for m in metrics:
        row[f"{m}_before_mean"] = before[m].mean()
        row[f"{m}_after_mean"]  = after[m].mean()
        row[f"{m}_shift"]       = after[m].mean() - before[m].mean()
    # composite score: standardized shifts (retention down = bad, churn up = bad, arpu down = bad)
    s_ret  = -row["retention_d7_shift"]
    s_ch   =  row["churn_rate_shift"]
    s_arpu = -row["arpu_usd_shift"]
    row["composite_badness"] = s_ret + s_ch + s_arpu
    rows.append(row)
bp = pd.DataFrame(rows)

# Write combined CSV: means block, per-week block, breakpoint scan block
with open(out_path, "w", encoding="utf-8") as f:
    f.write("# BLOCK 1: group means (W30-W36 vs W37-W43)\n")
    means.to_csv(f, index=False)
    f.write("\n# BLOCK 2: per-week values with WoW deltas\n")
    per.to_csv(f, index=False)
    f.write("\n# BLOCK 3: breakpoint scan (candidate week B: mean before B vs mean from B onward)\n")
    bp.to_csv(f, index=False)

print(means.to_string(index=False))
print()
print(per[["week","retention_d7","retention_d7_wow","churn_rate","churn_rate_wow","arpu_usd","arpu_usd_wow"]].to_string(index=False))
print()
print(bp[["breakpoint_week","retention_d7_shift","churn_rate_shift","arpu_usd_shift","composite_badness"]].to_string(index=False))
print("\nsaved:", out_path)

```
