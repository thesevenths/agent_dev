import pandas as pd

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "screen>5", False: "screen<=5"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
).reindex(["screen<=5","screen>5"])
print(g)

diff_math = g.loc["screen>5","mean_math"] - g.loc["screen<=5","mean_math"]
diff_read = g.loc["screen>5","mean_reading"] - g.loc["screen<=5","mean_reading"]
print("diff math (>5 minus <=5):", diff_math)
print("diff reading (>5 minus <=5):", diff_read)

out = g.reset_index()
out["diff_math_vs_le5"] = [diff_math, None]
out["diff_reading_vs_le5"] = [diff_read, None]
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r4\_sandbox\tmp\step3_group_stats.csv", index=False)
print(out)

