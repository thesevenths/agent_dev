import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"], method="pearson")
r_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")

# significance: t-test for correlation
from scipy import stats
t_math = r_math * np.sqrt((n-2)/(1-r_math**2))
t_read = r_read * np.sqrt((n-2)/(1-r_read**2))
p_math = 2*stats.t.sf(abs(t_math), n-2)
p_read = 2*stats.t.sf(abs(t_read), n-2)

print("n =", n)
print("r(math) =", r_math, "t =", t_math, "p =", p_math)
print("r(reading) =", r_read, "t =", t_read, "p =", p_read)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r4\_sandbox\tmp\step2_correlations.md"
lines = []
lines.append("# Step 2: Pearson 相关系数计算结果\n")
lines.append("AS_OF: 2026-10-26 06:34（本地静态 CSV，文件修改时间 2026-10-23 10:11，非实时数据）\n")
lines.append("## 计算口径\n")
lines.append(f"- 数据：`offline_data/students.csv`，有效样本 n = {n}（来源：offline_data/students.csv 的 screen_hours_per_day / math_score / reading_score，400 行，缺失值 0，全部行参与计算）")
lines.append("- 方法：Pearson 相关系数（pandas `Series.corr(method='pearson')`）\n")
lines.append("## 结果\n")
lines.append("| 变量对 | Pearson r | t 统计量 (df=398) | p 值 |")
lines.append("|---|---|---|---|")
lines.append(f"| screen_hours_per_day vs math_score | {r_math:.4f} | {t_math:.3f} | {p_math:.3e} |")
lines.append(f"| screen_hours_per_day vs reading_score | {r_read:.4f} | {t_read:.3f} | {p_read:.3e} |")
lines.append(f"\n- r(screen, math) = {r_math:.4f}（来源：offline_data/students.csv 的 screen_hours_per_day 与 math_score，Pearson 相关，n=400）")
lines.append(f"- r(screen, reading) = {r_read:.4f}（来源：offline_data/students.csv 的 screen_hours_per_day 与 reading_score，Pearson 相关，n=400）")
lines.append(f"- 显著性：t = r·√((n−2)/(1−r²))，df = n−2 = 398（来源：由前述两行计算）")
lines.append(f"  - math：t = {t_math:.3f}，p = {p_math:.3e}（来源：由前述两行计算）")
lines.append(f"  - reading：t = {t_read:.3f}，p = {p_read:.3e}（来源：由前述两行计算）")
lines.append("\n## 结论\n")
lines.append(f"screen_hours_per_day 与 math_score 呈显著负相关（r = {r_math:.4f}, p < 0.001）；与 reading_score 亦呈显著负相关（r = {r_read:.4f}, p < 0.001）。")

with open(out, "w", encoding="utf-8") as f:
    f.write("\n".join(lines))
import os
print("written:", out, os.path.getsize(out))

