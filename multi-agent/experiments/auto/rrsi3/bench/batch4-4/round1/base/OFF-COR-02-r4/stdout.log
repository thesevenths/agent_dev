import pandas as pd
import numpy as np
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

df["group"] = np.where(df["screen_hours_per_day"] > 5, "high(>5)", "low(<=5)")
g = df.groupby("group").agg(
    n=("student_id", "count"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
    mean_screen=("screen_hours_per_day", "mean"),
).reindex(["low(<=5)", "high(>5)"])
print(g)

n_low, n_high = int(g.loc["low(<=5)","n"]), int(g.loc["high(>5)","n"])
m_math_low, m_math_high = g.loc["low(<=5)","mean_math"], g.loc["high(>5)","mean_math"]
m_read_low, m_read_high = g.loc["low(<=5)","mean_reading"], g.loc["high(>5)","mean_reading"]
d_math = m_math_high - m_math_low
d_read = m_read_high - m_read_low

# t-tests
t_math, p_math = stats.ttest_ind(df.loc[df.group=="high(>5)","math_score"], df.loc[df.group=="low(<=5)","math_score"])
t_read, p_read = stats.ttest_ind(df.loc[df.group=="high(>5)","reading_score"], df.loc[df.group=="low(<=5)","reading_score"])
print("math diff:", d_math, "t=", t_math, "p=", p_math)
print("read diff:", d_read, "t=", t_read, "p=", p_read)
print("screen means:", g["mean_screen"].tolist())

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r4\_sandbox\tmp\step3_group_means.md"
lines = []
lines.append("# Step 3: 按 screen_hours_per_day = 5 分组的样本量与成绩均值差\n")
lines.append("AS_OF: 2026-10-26 06:35（本地静态 CSV，文件修改时间 2026-10-23 10:11，非实时数据）\n")
lines.append("## 分组口径\n")
lines.append(f"- 数据：`offline_data/students.csv`，总样本 n = 400（来源：offline_data/students.csv 的 student_id，400 行计数）")
lines.append("- 分组规则：`screen_hours_per_day > 5` 为高屏幕组，`screen_hours_per_day <= 5` 为低屏幕组（来源：offline_data/students.csv 的 screen_hours_per_day，400 行）\n")
lines.append("## 分组结果\n")
lines.append("| 组别 | 样本量 n | math_score 均值 | reading_score 均值 | screen_hours_per_day 组内均值 |")
lines.append("|---|---|---|---|---|")
lines.append(f"| 低屏幕组 (<=5) | {n_low} | {m_math_low:.2f} | {m_read_low:.2f} | {g.loc['low(<=5)','mean_screen']:.2f} |")
lines.append(f"| 高屏幕组 (>5) | {n_high} | {m_math_high:.2f} | {m_read_high:.2f} | {g.loc['high(>5)','mean_screen']:.2f} |")
lines.append(f"\n- 低屏幕组 n = {n_low}（来源：offline_data/students.csv 的 screen_hours_per_day，筛选 <=5，{n_low} 行计数）")
lines.append(f"- 高屏幕组 n = {n_high}（来源：offline_data/students.csv 的 screen_hours_per_day，筛选 >5，{n_high} 行计数）")
lines.append(f"- 低组 math 均值 = {m_math_low:.2f}（来源：offline_data/students.csv 的 math_score，screen_hours_per_day<=5 的 {n_low} 行求均值）")
lines.append(f"- 高组 math 均值 = {m_math_high:.2f}（来源：offline_data/students.csv 的 math_score，screen_hours_per_day>5 的 {n_high} 行求均值）")
lines.append(f"- 低组 reading 均值 = {m_read_low:.2f}（来源：offline_data/students.csv 的 reading_score，screen_hours_per_day<=5 的 {n_low} 行求均值）")
lines.append(f"- 高组 reading 均值 = {m_read_high:.2f}（来源：offline_data/students.csv 的 reading_score，screen_hours_per_day>5 的 {n_high} 行求均值）\n")
lines.append("## 均值差（高屏幕组 − 低屏幕组）\n")
lines.append("| 指标 | 高组均值 | 低组均值 | 差值 (高−低) | t 检验 p 值 |")
lines.append("|---|---|---|---|---|")
lines.append(f"| math_score | {m_math_high:.2f} | {m_math_low:.2f} | {d_math:+.2f} | {p_math:.4f} |")
lines.append(f"| reading_score | {m_read_high:.2f} | {m_read_low:.2f} | {d_read:+.2f} | {p_read:.4f} |")
lines.append(f"\n- math 均值差 = {d_math:+.2f}（来源：由前述两行计算，{m_math_high:.2f} − {m_math_low:.2f}）")
lines.append(f"- reading 均值差 = {d_read:+.2f}（来源：由前述两行计算，{m_read_high:.2f} − {m_read_low:.2f}）")
lines.append(f"- 独立样本 t 检验：math t = {t_math:.3f}, p = {p_math:.4f}；reading t = {t_read:.3f}, p = {p_read:.4f}（来源：由前述两行计算，scipy.stats.ttest_ind）\n")
lines.append("## 结论\n")
lines.append(f"高屏幕组（>5h/天，n={n_high}）的 math 均值比低屏幕组（n={n_low}）低 {abs(d_math):.2f} 分（p = {p_math:.4f}）；reading 均值差为 {d_read:+.2f} 分（p = {p_read:.4f}）。")

with open(out, "w", encoding="utf-8") as f:
    f.write("\n".join(lines))
import os
print("written:", out, os.path.getsize(out))

