```python
import pandas as pd
import json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-03-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)

stats = {}
for g in ["low", "mid", "high"]:
    sub = df[df["group"] == g]
    stats[g] = {
        "n": int(len(sub)),
        "math_mean": float(sub["math_score"].mean()),
        "math_std": float(sub["math_score"].std(ddof=1)),
        "math_min": int(sub["math_score"].min()),
        "math_max": int(sub["math_score"].max()),
        "study_min": float(sub["study_hours_per_week"].min()),
        "study_max": float(sub["study_hours_per_week"].max()),
        "study_mean": float(sub["study_hours_per_week"].mean()),
    }

low_mean = stats["low"]["math_mean"]
mid_mean = stats["mid"]["math_mean"]
high_mean = stats["high"]["math_mean"]

gain_high_low = high_mean - low_mean
gain_mid_low = mid_mean - low_mean
gain_high_mid = high_mean - mid_mean
pct_high_low = gain_high_low / low_mean * 100

# standard errors
import math
se_low = stats["low"]["math_std"] / math.sqrt(stats["low"]["n"])
se_high = stats["high"]["math_std"] / math.sqrt(stats["high"]["n"])
se_diff = math.sqrt(se_low**2 + se_high**2)
t_stat = gain_high_low / se_diff

result = {
    "total_rows": int(len(df)),
    "groups": stats,
    "gain_high_minus_low": gain_high_low,
    "gain_mid_minus_low": gain_mid_low,
    "gain_high_minus_mid": gain_high_mid,
    "pct_gain_high_vs_low": pct_high_low,
    "se_low": se_low, "se_high": se_high, "se_diff": se_diff, "t_stat": t_stat,
}
print(json.dumps(result, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-03-r0\_sandbox\tmp\step2_group_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, indent=2, ensure_ascii=False)
print("saved:", out)

```
