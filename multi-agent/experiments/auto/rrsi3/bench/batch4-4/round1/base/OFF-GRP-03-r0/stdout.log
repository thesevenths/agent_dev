import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-03-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

# boundary check: rows exactly at 2.5 or 4.5
print("rows with study_hours == 2.5:", (df["study_hours_per_week"] == 2.5).sum())
print("rows with study_hours == 4.5:", (df["study_hours_per_week"] == 4.5).sum())

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group")["math_score"].agg(["count", "mean", "std", "min", "max"])
print(g)
print("\nlow mean:", df.loc[df.group=="low","math_score"].mean())
print("high mean:", df.loc[df.group=="high","math_score"].mean())
print("gain high-low:", df.loc[df.group=="high","math_score"].mean() - df.loc[df.group=="low","math_score"].mean())
print("ratio high/low:", df.loc[df.group=="high","math_score"].mean() / df.loc[df.group=="low","math_score"].mean())
print("\nstudy hours range per group:")
print(df.groupby("group")["study_hours_per_week"].agg(["min","max","mean"]))

