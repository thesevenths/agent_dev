```python
import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

pre = df[df["week"].isin([f"W{i:02d}" for i in range(30,37)])].copy()
post = df[df["week"].isin([f"W{i:02d}" for i in range(37,44)])].copy()

# group means
means = pd.DataFrame({
    "group": ["W30-W36", "W37-W43"],
    "n": [len(pre), len(post)],
    "retention_d7_mean": [pre["retention_d7"].mean(), post["retention_d7"].mean()],
    "churn_rate_mean": [pre["churn_rate"].mean(), post["churn_rate"].mean()],
    "arpu_usd_mean": [pre["arpu_usd"].mean(), post["arpu_usd"].mean()],
})
print(means.to_string(index=False))

# per-week table with week-over-week deltas
win = df[df["week"].isin([f"W{i:02d}" for i in range(30,44)])].copy()
win["group"] = win["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")
for m in metrics:
    win[f"{m}_wow"] = win[m].diff()
print(win.to_string(index=False))

# absolute & relative differences (post - pre)
diff = pd.DataFrame({
    "metric": metrics,
    "pre_mean": [pre[m].mean() for m in metrics],
    "post_mean": [post[m].mean() for m in metrics],
})
diff["abs_diff"] = diff["post_mean"] - diff["pre_mean"]
diff["rel_diff_pct"] = diff["abs_diff"] / diff["pre_mean"] * 100
print(diff.to_string(index=False))

# breakpoint detection: largest single-week WoW change within W30-W43
bp = pd.DataFrame()
for m in metrics:
    s = win.set_index("week")[f"{m}_wow"]
    idx = s.abs().idxmax()
    bp.loc[m, "breakpoint_week"] = idx
    bp.loc[m, "wow_change"] = s[idx]
print(bp)

# save intermediate results
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r5\_sandbox\tmp"
win.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
diff.to_csv(f"{out_dir}\\step2_differences.csv", index=False)
bp.to_csv(f"{out_dir}\\step2_breakpoint.csv")
print("saved")

```
