import pandas as pd

df = pd.read_csv(r"offline_data/app_metrics.csv")
sl = df[df["week"].str.match(r"W(3[0-9]|4[0-3])$")].copy()
sl["group"] = sl["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
means = sl.groupby("group")[metrics].mean()
print(means.to_string())

# per-week deltas
sl["d_ret"] = sl["retention_d7"].diff()
sl["d_churn"] = sl["churn_rate"].diff()
sl["d_arpu"] = sl["arpu_usd"].diff()
print(sl[["week","retention_d7","churn_rate","arpu_usd","d_ret","d_churn","d_arpu"]].to_string(index=False))

# save intermediate CSV
out = sl[["week","group","cohort_size","dau","retention_d7","churn_rate","arpu_usd","d_ret","d_churn","d_arpu"]]
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r5\_sandbox\tmp\step2_breakpoint_data.csv", index=False)

# summary rows
summary = pd.DataFrame([
    {"week":"W30-W36_mean","retention_d7":means.loc["W30-W36","retention_d7"],
     "churn_rate":means.loc["W30-W36","churn_rate"],"arpu_usd":means.loc["W30-W36","arpu_usd"],"n":7},
    {"week":"W37-W43_mean","retention_d7":means.loc["W37-W43","retention_d7"],
     "churn_rate":means.loc["W37-W43","churn_rate"],"arpu_usd":means.loc["W37-W43","arpu_usd"],"n":7},
])
print(summary.to_string(index=False))
summary.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r5\_sandbox\tmp\step2_group_means.csv", index=False)

# deltas
d = means.loc["W37-W43"] - means.loc["W30-W36"]
print("\nDelta (W37-W43 minus W30-W36):")
print(d.to_string())
print("\nRelative change %:")
print((d/means.loc["W30-W36"]*100).to_string())

