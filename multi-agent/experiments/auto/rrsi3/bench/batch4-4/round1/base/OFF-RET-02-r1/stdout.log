import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(path)
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()

# group means
g = sub.assign(group=sub.week.apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43"))
means = g.groupby("group")[["retention_d7","churn_rate","arpu_usd"]].mean().round(6)
print(means)

# per-week with week-over-week deltas
sub["ret_d7_wow"] = sub.retention_d7.diff()
sub["churn_wow"] = sub.churn_rate.diff()
sub["arpu_wow"] = sub.arpu_usd.diff()
print(sub[["week","retention_d7","churn_rate","arpu_usd","ret_d7_wow","churn_wow","arpu_wow"]].to_string())

# breakpoint candidate: week with largest combined normalized jump
# simple: max |ret_d7_wow|
print("\nmax |ret_d7_wow| at:", sub.loc[sub.ret_d7_wow.abs().idxmax(), "week"])
print("max |churn_wow| at:", sub.loc[sub.churn_wow.abs().idxmax(), "week"])
print("max |arpu_wow| at:", sub.loc[sub.arpu_wow.abs().idxmax(), "week"])

# save intermediate CSV
out = sub[["week","group","cohort_size","dau","retention_d7","churn_rate","arpu_usd","support_tickets","ret_d7_wow","churn_wow","arpu_wow"]].round(6)
out.to_csv(f"{out_dir}\\step2_intermediate.csv", index=False)

# also save means
means.to_csv(f"{out_dir}\\step2_group_means.csv")
print("\nsaved.")

```
