import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(src)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# Per-week values around the breakpoint window (W28-W45 for context)
win = df[df['week'].isin([f"W{i:02d}" for i in range(28, 46)])].copy()

# Group means
g1 = df[df['week'].isin([f"W{i:02d}" for i in range(30, 37)])]  # W30-W36
g2 = df[df['week'].isin([f"W{i:02d}" for i in range(37, 44)])]  # W37-W43

means = pd.DataFrame({
    'group': ['W30-W36', 'W37-W43'],
    'n': [len(g1), len(g2)],
    'retention_d7_mean': [g1['retention_d7'].mean(), g2['retention_d7'].mean()],
    'churn_rate_mean': [g1['churn_rate'].mean(), g2['churn_rate'].mean()],
    'arpu_usd_mean': [g1['arpu_usd'].mean(), g2['arpu_usd'].mean()],
})
delta = means.iloc[1] - means.iloc[0]
pct = delta / means.iloc[0] * 100

