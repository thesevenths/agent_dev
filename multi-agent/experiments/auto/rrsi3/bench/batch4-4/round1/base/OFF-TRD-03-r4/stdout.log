import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "n_months:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dup (month,region,product_line):", df.duplicated(subset=['month','region','product_line']).sum())
print("revenue<=0:", (df['revenue']<=0).sum())

# sanity: revenue == units*unit_price?
calc = df['units']*df['unit_price']
print("max |revenue - units*unit_price|:", (df['revenue']-calc).abs().max())

# per region-month rows
print("rows per region:", df.groupby('region').size().to_dict())
print("rows per month:", df.groupby('month').size().unique())

# aggregates
tot = df.groupby('region')['revenue'].sum()
grand = tot.sum()
share = tot/grand*100
monthly = df.groupby(['region','month'])['revenue'].sum().unstack()
avg = monthly.mean(axis=1)
top = tot.idxmax()
peak_month = monthly.loc[top].idxmax()
print("\nTotals:\n", tot.round(2))
print("Grand total:", round(grand,2))
print("Share %:\n", share.round(4))
print("Monthly avg:\n", avg.round(2))
print("Top region:", top, "total:", round(tot[top],2))
print("Peak month of top:", peak_month, round(monthly.loc[top, peak_month],2))
# overall peak month per region
print("Peak month per region:\n", monthly.idxmax(axis=1))
print("Overall max cell:", monthly.stack().idxmax(), monthly.stack().max())

out = {
 "shape": list(df.shape),
 "columns": list(df.columns),
 "regions": sorted(df['region'].unique()),
 "months_min": df['month'].min(), "months_max": df['month'].max(), "n_months": int(df['month'].nunique()),
 "product_lines": sorted(df['product_line'].unique()),
 "nulls": int(df.isna().sum().sum()),
 "dup_keys": int(df.duplicated(subset=['month','region','product_line']).sum()),
 "revenue_nonpositive": int((df['revenue']<=0).sum()),
 "revenue_units_price_maxdiff": float((df['revenue']-calc).abs().max()),
 "rows_per_region": df.groupby('region').size().to_dict(),
 "rows_per_month_unique": df.groupby('month').size().unique().tolist(),
 "region_totals": {k: round(v,2) for k,v in tot.items()},
 "grand_total": round(grand,2),
 "share_pct": {k: round(v,4) for k,v in share.items()},
 "monthly_avg": {k: round(v,2) for k,v in avg.items()},
 "top_region": top,
 "top_region_total": round(tot[top],2),
 "top_region_peak_month": peak_month,
 "top_region_peak_value": round(monthly.loc[top, peak_month],2),
 "peak_month_per_region": {k: v for k,v in monthly.idxmax(axis=1).items()},
 "monthly_table": {m: {r: round(monthly.loc[m,r],2) for r in monthly.columns} for m in monthly.index},
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-TRD-03-r4\_sandbox\tmp\step1_validation.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("\nsaved step1_validation.json")

