import pandas as pd, json, math

df = pd.read_csv("offline_data/students.csv")
g = df.groupby("tutoring")["math_score"].agg(n="count", mean="mean", std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,"n"]), int(g.loc[1,"n"])
m0, m1 = g.loc[0,"mean"], g.loc[1,"mean"]
s0, s1 = g.loc[0,"std"], g.loc[1,"std"]
pooled = math.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
diff = m1 - m0
d = diff / pooled
print("pooled std:", pooled)
print("mean diff (1-0):", diff)
print("Cohen's d:", d)

res = {
  "source_file": "offline_data/students.csv",
  "group_column": "tutoring",
  "value_column": "math_score",
  "total_rows": int(len(df)),
  "missing_rows_excluded": int(df["math_score"].isna().sum() + df["tutoring"].isna().sum()),
  "std_definition": "sample std (ddof=1)",
  "groups": {
    "0": {"n": n0, "mean": m0, "std": s0},
    "1": {"n": n1, "mean": m1, "std": s1},
  },
  "pooled_std": pooled,
  "mean_diff_1_minus_0": diff,
  "cohens_d": d,
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-GRP-01-r5\_sandbox\tmp\group_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print("saved:", out)
print(json.dumps(res, ensure_ascii=False, indent=2))

