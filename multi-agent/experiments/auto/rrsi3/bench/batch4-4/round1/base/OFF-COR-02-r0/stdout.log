r_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")
n = len(df)

# significance: t = r*sqrt(n-2)/sqrt(1-r^2)
import math
def tstat(r, n):
    return r*math.sqrt(n-2)/math.sqrt(1-r*r)

out = {
    "step": "step 2/4 - Compute correlations",
