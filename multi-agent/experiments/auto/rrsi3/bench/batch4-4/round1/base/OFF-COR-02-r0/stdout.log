```python
import pandas as pd
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: ">5", False: "<=5"})
g = df.groupby("group").agg(n=("student_id","count"),
                            mean_math=("math_score","mean"),
                            mean_reading=("reading_score","mean"),
                            mean_screen=("screen_hours_per_day","mean"))
g = g.reindex(["<=5", ">5"])
rows = []
for grp in ["<=5", ">5"]:
    r = g.loc[grp]
    rows.append({"group": grp, "n": int(r["n"]), "mean_math": r["mean_math"],
                 "mean_reading": r["mean_reading"], "mean_screen": r["mean_screen"]})
rows.append({"group": "diff(>5 - <=5)", "n": None,
             "mean_math": g.loc[">5","mean_math"] - g.loc["<=5","mean_math"],
             "mean_reading": g.loc[">5","mean_reading"] - g.loc["<=5","mean_reading"],
             "mean_screen": g.loc[">5","mean_screen"] - g.loc["<=5","mean_screen"]})
out = pd.DataFrame(rows)
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.csv", index=False)
print(out.to_string(index=False))

```
