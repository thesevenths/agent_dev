lo = df[df["screen_hours_per_day"] <= 5]

rows = []
for name, g in [("screen_hours_per_day > 5", hi), ("screen_hours_per_day <= 5", lo)]:
    rows.append({
        "group": name,
        "n": len(g),
        "mean_math_score": round(g["math_score"].mean(), 4),
        "mean_reading_score": round(g["reading_score"].mean(), 4),
        "mean_screen_hours": round(g["screen_hours_per_day"].mean(), 4),
    })

out = pd.DataFrame(rows)
diff_math = out.loc[0,"mean_math_score"] - out.loc[1,"mean_math_score"]
diff_read = out.loc[0,"mean_reading_score"] - out.loc[1,"mean_reading_score"]
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.csv", index=False)

