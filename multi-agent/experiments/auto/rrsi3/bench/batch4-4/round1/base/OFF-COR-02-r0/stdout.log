import pandas as pd
df = pd.read_csv("offline_data/students.csv")
c_math = df["screen_hours_per_day"].corr(df["math_score"])
c_read = df["screen_hours_per_day"].corr(df["reading_score"])
out = pd.DataFrame({
    "pair": ["screen_hours_per_day vs math_score", "screen_hours_per_day vs reading_score"],
    "pearson_r": [c_math, c_read],
    "n": [len(df), len(df)],
})
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.csv", index=False)
print(out.to_string(index=False))
print(repr(c_math), repr(c_read))

