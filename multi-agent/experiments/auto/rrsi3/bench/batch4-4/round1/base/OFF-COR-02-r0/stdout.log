         "mean_reading_score": round(lo["reading_score"].mean(),4),
         "mean_screen_hours": round(lo["screen_hours_per_day"].mean(),4)},
    ],
    "mean_difference_gt5_minus_le5": {
        "math_score": round(diff_math,4),
        "reading_score": round(diff_read,4),
    },
}
print(json.dumps(summary, indent=2, ensure_ascii=False))
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.json", "w", encoding="utf-8") as f:
