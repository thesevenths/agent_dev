import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-TRD-03-r2\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

n_months = df['month'].nunique()
grand_total = df['revenue'].sum()

# per-region totals
reg = df.groupby('region')['revenue'].agg(['sum','count'])
reg['share'] = reg['sum'] / grand_total
reg['monthly_avg'] = reg['sum'] / n_months

# monthly revenue per region
monthly = df.groupby(['region','month'])['revenue'].sum().reset_index()
top_region = reg['sum'].idxmax()
top_row = monthly[monthly['region']==top_region].sort_values('revenue', ascending=False).iloc[0]

# also full monthly series for top region (for report context)
top_series = monthly[monthly['region']==top_region].sort_values('month')

out = {
  "as_of": "2026-10-26 07:28",
  "source_file": "offline_data/regional_sales.csv",
  "n_rows": int(len(df)),
  "n_months": int(n_months),
  "month_range": [df['month'].min(), df['month'].max()],
  "grand_total_revenue": round(float(grand_total), 2),
  "regions": {},
  "top_region": {
     "region": top_region,
     "total_revenue": round(float(reg.loc[top_region,'sum']),2),
     "peak_month": top_row['month'],
     "peak_month_revenue": round(float(top_row['revenue']),2),
     "monthly_series": {r['month']: round(float(r['revenue']),2) for _,r in top_series.iterrows()}
  }
}
for r in ['N','S','E','W']:
    out['regions'][r] = {
        "total_revenue": round(float(reg.loc[r,'sum']),2),
        "share_of_grand_total": round(float(reg.loc[r,'share']),6),
        "share_pct": round(float(reg.loc[r,'share'])*100,2),
        "monthly_avg_revenue": round(float(reg.loc[r,'monthly_avg']),2),
        "rows_used": int(reg.loc[r,'count']),
        "peak_month": monthly[monthly['region']==r].sort_values('revenue',ascending=False).iloc[0]['month'],
    }

dest = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\base\OFF-TRD-03-r2\_sandbox\tmp\regional_aggregates.json"
with open(dest,'w',encoding='utf-8') as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print(json.dumps(out,ensure_ascii=False,indent=2))

