import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]

# Monthly revenue aggregation
monthly = df.groupby('month').agg(
    revenue=('revenue', 'sum'),
    units=('units', 'sum'),
    rows=('revenue', 'size')
).reset_index()
monthly['year'] = monthly['month'].str[:4]

# Annual totals
annual = df.groupby('year').agg(
    revenue_total=('revenue', 'sum'),
    units_total=('units', 'sum'),
    rows=('revenue', 'size')
).reset_index()
annual['yoy_revenue_growth'] = annual['revenue_total'].pct_change()
annual['yoy_units_growth'] = annual['units_total'].pct_change()

print("monthly:\n", monthly.to_string(index=False))
print("\nannual:\n", annual.to_string(index=False))

# Save intermediate CSVs
monthly.to_csv(f"{out_dir}\\step2_monthly_revenue.csv", index=False, float_format='%.2f')
annual.to_csv(f"{out_dir}\\step2_annual_revenue_yoy.csv", index=False, float_format='%.6f')

# Cross-check vs step 1 pre-computed values
print("\nCross-check vs step1:")
