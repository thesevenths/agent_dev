df = pd.read_csv(src)
df['mm'] = df['month'].str[5:7].astype(int)

# monthly totals of units (12 rows per month)
monthly = df.groupby('month')['units'].sum().reset_index()
monthly['mm'] = monthly['month'].str[5:7].astype(int)

novdec = monthly[monthly['mm'].isin([11, 12])]['units']   # 4 months (2024-11,2024-12,2025-11,2025-12)
janoct = monthly[monthly['mm'].isin(range(1, 11))]['units']  # 20 months

avg_nd = novdec.mean()
avg_jo = janoct.mean()
ratio = avg_nd / avg_jo

res = pd.DataFrame([{
    'avg_units_novdec': round(avg_nd, 2),
    'avg_units_jan_oct': round(avg_jo, 2),
    'amplification_ratio': round(ratio, 6),
    'n_months_novdec': len(novdec),
    'n_months_jan_oct': len(janoct),
}])
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("\nmonthly units detail:")
print(monthly.to_string(index=False))
print("saved:", out)

