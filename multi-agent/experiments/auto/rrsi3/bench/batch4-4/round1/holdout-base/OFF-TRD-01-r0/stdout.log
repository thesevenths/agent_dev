```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

print("months:", sorted(df['month'].unique()))
print("regions:", sorted(df['region'].unique()))
print("product_lines:", sorted(df['product_line'].unique()))

# consistency check: revenue vs units*unit_price
df['calc_rev'] = df['units']*df['unit_price']
diff = (df['revenue'] - df['calc_rev']).abs()
print("max |revenue - units*unit_price|:", diff.max())

# rows per month
print(df.groupby('month').size().describe())
print("rows per month all 12:", (df.groupby('month').size()==12).all())

# quick aggregates for downstream
rev = df.groupby(df['month'].str[:4])['revenue'].sum()
units = df.groupby(df['month'].str[:4])['units'].sum()
print("annual revenue:\n", rev)
print("annual units:\n", units)
print("YoY revenue growth:", rev['2025']/rev['2024']-1)

# Nov-Dec units amplification
for y in ['2024','2025']:
    sub = df[df['month'].str[:4]==y]
    m = sub.groupby(sub['month'].str[5:])['units'].sum()
    nd = m[['11','12']].mean()
    rest = m.drop(['11','12']).mean()
    print(y, "Nov-Dec avg units:", nd, "other-month avg units:", rest, "multiplier:", nd/rest)

