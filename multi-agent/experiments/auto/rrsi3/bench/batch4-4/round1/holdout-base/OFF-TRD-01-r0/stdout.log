import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\annual_totals.csv"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]

rows = []
prev = None
for y in ['2024', '2025']:
    sub = df[df['year'] == y]
    total = sub['revenue'].sum()
    yoy = (total - prev) / prev if prev is not None else None
    rows.append({'year': y, 'total_revenue': round(total, 2), 'yoy_growth': None if yoy is None else round(yoy, 6), 'n_rows': len(sub)})
    prev = total

res = pd.DataFrame(rows)
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

