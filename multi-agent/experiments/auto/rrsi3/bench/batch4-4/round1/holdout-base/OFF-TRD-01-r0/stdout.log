import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]
df['mm'] = df['month'].str[5:]
df['is_nov_dec'] = df['mm'].isin(['11', '12'])

rows = []
for y in ['2024', '2025']:
    sub = df[df['year'] == y]
    nd = sub[sub['is_nov_dec']]
    rest = sub[~sub['is_nov_dec']]
    nd_total = nd['units'].sum()
    rest_total = rest['units'].sum()
    nd_avg = nd_total / 2          # 11-12 月平均月销量
    rest_avg = rest_total / 10     # 其余 10 个月平均月销量
    mult = nd_avg / rest_avg
    rows.append({
        'year': y,
        'nov_dec_units_total': nd_total,
        'nov_dec_months': 2,
        'nov_dec_avg_monthly_units': nd_avg,
        'other_months_units_total': rest_total,
        'other_months': 10,
        'other_avg_monthly_units': rest_avg,
        'amplification_multiplier': mult,
        'nov_dec_rows': len(nd),
        'other_rows': len(rest),
    })

res = pd.DataFrame(rows)
print(res.to_string(index=False))

# cross-check vs step1: 2024 ≈ 1.275, 2025 ≈ 1.231
res.to_csv(f"{out_dir}\\step3_novdec_amplification.csv", index=False, float_format='%.6f')
print("\nsaved.")

