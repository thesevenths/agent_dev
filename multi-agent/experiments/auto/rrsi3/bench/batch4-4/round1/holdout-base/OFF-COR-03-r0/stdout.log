import pandas as pd, numpy as np, json
from scipy import stats

df = pd.read_csv("offline_data/students.csv")
cols = ["math_score","study_hours_per_week","attendance_pct","tutoring","screen_hours_per_day"]
N = len(df)

corr = df[cols].corr(method="pearson")
corr_pvals = {}
for c in cols:
    for d in cols:
        if c != d:
            r, p = stats.pearsonr(df[c], df[d])
            corr_pvals[f"{c}~{d}"] = p

results = []
for x in cols[1:]:
    res = stats.linregress(df[x], df["math_score"])
    results.append({
        "predictor": x,
        "slope": res.slope,
        "intercept": res.intercept,
        "r_value": res.rvalue,
        "r_squared": res.rvalue**2,
        "p_value": res.pvalue,
        "stderr": res.stderr,
    })

reg_df = pd.DataFrame(results)
