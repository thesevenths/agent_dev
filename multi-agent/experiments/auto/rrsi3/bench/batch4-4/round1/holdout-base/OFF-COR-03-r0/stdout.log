```python
import pandas as pd, numpy as np, json
from scipy import stats

df = pd.read_csv("offline_data/students.csv")
cols = ["math_score","study_hours_per_week","attendance_pct","tutoring","screen_hours_per_day"]
N = len(df)

# Pearson correlation matrix
corr = df[cols].corr(method="pearson")
# p-values for correlations
def corr_p(x, y):
    r, p = stats.pearsonr(x, y)
    return r, p

corr_pvals = {}
for c in cols:
    for d in cols:
        if c != d:
            r, p = corr_p(df[c], df[d])
            corr_pvals[f"{c}~{d}"] = p

# Simple OLS regressions
results = []
for x in cols[1:]:
    res = stats.linregress(df[x], df["math_score"])
    results.append({
        "predictor": x,
        "slope": res.slope,
        "intercept": res.intercept,
        "r_value": res.rvalue,
        "r_squared": res.rvalue**2,
        "p_value": res.pvalue,
        "stderr": res.stderr,
    })

reg_df = pd.DataFrame(results)
print(reg_df.to_string(index=False))
print("\nCorrelation matrix:")
print(corr.round(4).to_string())

# save artifacts
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp"
reg_df.to_csv(f"{out_dir}\\step2_regression_results.csv", index=False)

corr_out = corr.reset_index().rename(columns={"index":"variable"})
corr_out.to_csv(f"{out_dir}\\step2_correlation_matrix.csv", index=False)

# JSON with everything
payload = {
    "as_of": "2026-10-26 08:02",
    "source_file": "offline_data/students.csv",
    "n_rows": N,
    "correlation_matrix": corr.round(6).to_dict(),
    "correlation_pvalues": corr_pvals,
    "regressions": results,
}
with open(f"{out_dir}\\step2_results.json","w",encoding="utf-8") as f:
    json.dump(payload, f, indent=2, ensure_ascii=False)

print("\nSaved artifacts to", out_dir)

