import pandas as pd
import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-COR-03-r0\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp"

df = pd.read_csv(csv)
drivers = ['study_hours_per_week', 'attendance_pct', 'tutoring', 'screen_hours_per_day']

# --- Chart 1: correlation bar chart ---
r_vals = {x: df[x].corr(df['math_score']) for x in drivers}
fig, ax = plt.subplots(figsize=(7, 4))
colors = ['#2e7d32' if v > 0 else '#c62828' for v in r_vals.values()]
bars = ax.bar(r_vals.keys(), r_vals.values(), color=colors)
ax.axhline(0, color='k', lw=0.8)
ax.set_ylabel('Pearson r with math_score')
ax.set_title('Correlation of each driver with math_score (n=400)')
for b, v in zip(bars, r_vals.values()):
    ax.text(b.get_x()+b.get_width()/2, v + (0.02 if v>0 else -0.05), f'{v:.3f}', ha='center')
plt.xticks(rotation=15)
plt.tight_layout()
p1 = f"{out_dir}\\chart_correlation.png"
plt.savefig(p1, dpi=110)
plt.close()

# --- Chart 2: slope bar chart ---
from scipy import stats
slopes = {x: stats.linregress(df[x], df['math_score']).slope for x in drivers}
