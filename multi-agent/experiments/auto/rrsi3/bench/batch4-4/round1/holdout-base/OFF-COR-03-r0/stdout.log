colors = ['#2e7d32' if v > 0 else '#c62828' for v in slopes.values()]
bars = ax.bar(slopes.keys(), slopes.values(), color=colors)
ax.axhline(0, color='k', lw=0.8)
ax.set_ylabel('OLS slope (math_score points per unit)')
ax.set_title('Simple OLS slope: math_score ~ each driver (n=400)')
for b, v in zip(bars, slopes.values()):
    ax.text(b.get_x()+b.get_width()/2, v + (0.1 if v>0 else -0.3), f'{v:.3f}', ha='center')
plt.xticks(rotation=15)
plt.tight_layout()
p2 = f"{out_dir}\\chart_slopes.png"
