import pandas as pd
import numpy as np

df = pd.read_csv(r"offline_data/app_metrics.csv")
n = len(df)

# Pearson correlations
corr_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
corr_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

res = pd.DataFrame({
    "metric": [
        "corr_retention_d7_arpu_usd",
        "corr_retention_d7_churn_rate",
        "retention_d7_median",
        "n_rows_total",
        "n_rows_high_group",
        "n_rows_low_group",
        "high_group_arpu_usd_mean",
        "high_group_cohort_size_sum",
        "low_group_arpu_usd_mean",
        "low_group_cohort_size_sum",
    ],
    "value": [
        corr_arpu,
        corr_churn,
        med,
        n,
        len(hi),
        len(lo),
        hi["arpu_usd"].mean(),
        int(hi["cohort_size"].sum()),
        lo["arpu_usd"].mean(),
        int(lo["cohort_size"].sum()),
    ],
})
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-03-r5\_sandbox\tmp\step2_results.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

