import pandas as pd, json

df = pd.read_csv(r"offline_data/students.csv")
g = df.groupby("tutoring")["math_score"].agg(n="count", mean="mean", std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,"n"]), int(g.loc[1,"n"])
m0, m1 = g.loc[0,"mean"], g.loc[1,"mean"]
s0, s1 = g.loc[0,"std"], g.loc[1,"std"]
diff = m1 - m0
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled**0.5
d = diff / pooled_std
print("diff:", diff, "pooled_std:", pooled_std, "d:", d)

# Cohen's d thresholds: small 0.2, medium 0.5, large 0.8
if d < 0.2: cat = "小效应 (small)"
elif d < 0.5: cat = "小-中效应 (small-to-medium)"
elif d < 0.8: cat = "中效应 (medium)"
else: cat = "大效应 (large)"
print("category:", cat)

out = {
    "as_of": "2026-10-26 07:09",
    "source_file": "offline_data/students.csv",
    "groups": {
        "tutoring_0": {"n": n0, "mean": round(m0,4), "std": round(s0,4)},
        "tutoring_1": {"n": n1, "mean": round(m1,4), "std": round(s1,4)},
    },
    "mean_diff_t1_minus_t0": round(diff,4),
    "pooled_std": round(pooled_std,4),
    "cohens_d": round(d,4),
    "effect_size_category": cat,
    "std_ddof": 1,
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r3\_sandbox\tmp\step2_group_stats.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

pd.DataFrame([
    {"tutoring":0,"n":n0,"mean":round(m0,4),"std":round(s0,4)},
    {"tutoring":1,"n":n1,"mean":round(m1,4),"std":round(s1,4)},
]).to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r3\_sandbox\tmp\step2_group_stats.csv", index=False)
print("saved")

