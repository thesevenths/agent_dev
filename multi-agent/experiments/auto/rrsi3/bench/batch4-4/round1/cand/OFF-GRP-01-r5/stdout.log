```python
import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
g = df.groupby("tutoring")["math_score"]
n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std()[0]), float(g.std()[1])  # sample std, ddof=1
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled**0.5
diff = m1 - m0
d = diff / pooled_std

# effect size classification (Cohen's conventions)
ad = abs(d)
label = "小效应" if ad < 0.5 else ("中效应" if ad < 0.8 else "大效应")

res = {
  "source_file": "offline_data/students.csv",
  "n_total": int(len(df)),
  "n_missing_math_score": int(df["math_score"].isna().sum()),
  "group_tutoring_0": {"n": n0, "mean": m0, "std": s0},
  "group_tutoring_1": {"n": n1, "mean": m1, "std": s1},
  "mean_diff_t1_minus_t0": diff,
  "pooled_variance": pooled,
  "pooled_std": pooled_std,
  "cohens_d": d,
  "effect_size_label": label,
  "notes": "std uses sample std (ddof=1); pooled std = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); d = (mean1-mean0)/pooled_std; Cohen conventions: <0.5 small, 0.5-0.8 medium, >=0.8 large",
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r5\_sandbox\tmp\group_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
