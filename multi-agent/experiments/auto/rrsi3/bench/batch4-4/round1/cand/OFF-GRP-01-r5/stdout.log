```python
import pandas as pd, json, os

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r5\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r5\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(p)
g = df.groupby("tutoring")["math_score"]
n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std(ddof=1)[0]), float(g.std(ddof=1)[1])
mean_diff = m1 - m0
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled**0.5
d = mean_diff / pooled_std

# Cohen's d magnitude classification
def classify(d):
    a = abs(d)
    if a < 0.2: return "可忽略 (negligible, |d|<0.2)"
    if a < 0.5: return "小效应 (small, 0.2≤|d|<0.5)"
    if a < 0.8: return "中效应 (medium, 0.5≤|d|<0.8)"
    return "大效应 (large, |d|≥0.8)"

res = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "missing_math_score": int(df["math_score"].isna().sum()),
    "groups": {
        "0 (无辅导)": {"n": n0, "mean": m0, "std": s0},
        "1 (有辅导)": {"n": n1, "mean": m1, "std": s1},
    },
    "mean_diff_tutoring_minus_control": mean_diff,
    "pooled_variance": pooled,
    "pooled_std": pooled_std,
    "cohens_d": d,
    "effect_size_label": classify(d),
    "std_convention": "sample std (ddof=1)",
}
out = os.path.join(out_dir, "group_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
