import pandas as pd
import json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]

first = r.iloc[:30]
last = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2 * overall_std
below = df[r < threshold]

results = {
    "as_of": "2026-10-25 10:34",
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "total_weeks": len(r),
