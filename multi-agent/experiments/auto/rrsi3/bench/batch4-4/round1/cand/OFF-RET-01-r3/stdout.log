        "n": int(len(first)),
        "mean": float(first.mean()),
        "std_ddof1": float(first.std(ddof=1)),
        "std_ddof0": float(first.std(ddof=0)),
        "min": float(first.min()),
        "max": float(first.max()),
    },
    "last30": {
        "weeks": f"{df['week'].iloc[30]}..{df['week'].iloc[59]}",
        "n": int(len(last)),
        "mean": float(last.mean()),
        "std_ddof1": float(last.std(ddof=1)),
        "std_ddof0": float(last.std(ddof=0)),
        "min": float(last.min()),
        "max": float(last.max()),
    },
    "diff_last_minus_first": {
        "mean_diff": float(last.mean() - first.mean()),
        "std_diff": float(last.std(ddof=1) - first.std(ddof=1)),
        "mean_diff_pct_of_first": float((last.mean() - first.mean()) / first.mean() * 100),
    },
    "overall": {
        "n": int(len(r)),
        "mean": float(overall_mean),
        "std_ddof1": float(overall_std),
        "threshold_mean_minus_2std": float(threshold),
        "weeks_below_threshold_count": int(len(below)),
        "weeks_below_threshold": below["week"].tolist(),
    },
}

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r3\_sandbox\tmp\step2_stats.json", "w", encoding="utf-8") as f:
