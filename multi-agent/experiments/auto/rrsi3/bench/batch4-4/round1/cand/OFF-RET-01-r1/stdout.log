import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]; last = r.iloc[30:]

res = {
    "as_of": "2026-10-26 06:12",
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": "W01-W30", "n": 30,
                "mean": float(first.mean()), "std_ddof1": float(first.std(ddof=1)),
                "std_ddof0": float(first.std(ddof=0))},
    "last30": {"weeks": "W31-W60", "n": 30,
               "mean": float(last.mean()), "std_ddof1": float(last.std(ddof=1)),
               "std_ddof0": float(last.std(ddof=0))},
    "diff_mean_last_minus_first": float(last.mean() - first.mean()),
    "overall": {"n": 60, "mean": float(r.mean()),
                "std_ddof1": float(r.std(ddof=1)), "std_ddof0": float(r.std(ddof=0))},
}
thr = res["overall"]["mean"] - 2*res["overall"]["std_ddof1"]
res["threshold_mean_minus_2std"] = float(thr)
low = df[r < thr]
res["weeks_below_mean_minus_2std"] = {
    "count": int(len(low)),
    "weeks": low["week"].tolist(),
    "values": low["retention_d7"].tolist(),
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r1\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

