import pandas as pd
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high (>5)", False: "low (<=5)"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
    mean_screen=("screen_hours_per_day","mean"),
).reindex(["low (<=5)","high (>5)"])
print(g)
diff_math = g.loc["high (>5)","mean_math"] - g.loc["low (<=5)","mean_math"]
diff_read = g.loc["high (>5)","mean_reading"] - g.loc["low (<=5)","mean_reading"]
print("diff math (high-low):", diff_math)
print("diff reading (high-low):", diff_read)

out = g.reset_index()
out["mean_math_diff_high_minus_low"] = [diff_math, diff_math]
out["mean_reading_diff_high_minus_low"] = [diff_read, diff_read]
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.csv"
out.to_csv(out_path, index=False)
print(out)
print("saved:", out_path)

