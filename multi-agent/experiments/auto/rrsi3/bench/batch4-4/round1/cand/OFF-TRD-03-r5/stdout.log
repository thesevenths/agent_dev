import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

grand_total = df['revenue'].sum()

# per-region totals
reg = df.groupby('region')['revenue'].agg(['sum','count'])
reg['share'] = reg['sum'] / grand_total
reg['monthly_avg'] = reg['sum'] / 24

# monthly sums per region
monthly = df.groupby(['region','month'])['revenue'].sum().reset_index()
top = monthly.loc[monthly.groupby('region')['revenue'].idxmax()]

# overall peak month (region-month max)
overall_peak = monthly.loc[monthly['revenue'].idxmax()]

result = {
    "source_file": os.path.abspath(path),
    "as_of": "2026-10-26 07:37",
    "data_range": {"start": df['month'].min(), "end": df['month'].max(), "n_months": int(df['month'].nunique())},
    "grand_total_revenue": round(float(grand_total), 2),
    "grand_total_rows": int(len(df)),
    "regions": {},
}
for r in ['N','S','E','W']:
    row = reg.loc[r]
    pk = top[top['region']==r].iloc[0]
    result["regions"][r] = {
        "total_revenue": round(float(row['sum']), 2),
        "rows": int(row['count']),
        "share_pct": round(float(row['share'])*100, 4),
        "monthly_avg_revenue": round(float(row['monthly_avg']), 2),
        "peak_month": str(pk['month']),
        "peak_month_revenue": round(float(pk['revenue']), 2),
    }
result["overall_peak"] = {
    "region": str(overall_peak['region']),
    "month": str(overall_peak['month']),
    "revenue": round(float(overall_peak['revenue']), 2),
}
result["top_region"] = max(result["regions"], key=lambda k: result["regions"][k]["total_revenue"])

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-TRD-03-r5\_sandbox\tmp\reports\regional_aggregates.json"
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, 'w', encoding='utf-8') as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

# also save monthly detail CSV for step 3
mcsv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-TRD-03-r5\_sandbox\tmp\reports\regional_monthly_revenue.csv"
monthly_out = monthly.copy()
monthly_out['revenue'] = monthly_out['revenue'].round(2)
monthly_out.to_csv(mcsv, index=False)

print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)
print("saved:", mcsv)

```
