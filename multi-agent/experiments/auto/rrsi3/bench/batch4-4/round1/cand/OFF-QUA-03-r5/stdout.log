maly combos ----\ndef combo_stats(region, pline):\n    sub = df[(df["region"] == region) & (df["product_line"] == pline)].sort_values("month")\n    units = sub["units"]\n    ret = sub["returns"]\n    r = {\n        "n_months": len(sub),\n        "mean_units": units.mean(),\n        "std_units": units.std(ddof=0),\n        "min_units": units.min(),\n        "max_units": units.max(),\n        "mean_ret_pct": (ret / units).mean() * 100,\n        "mean_price": sub["unit_price"].mean(),\n        "price_spike": None,\n        "price_prev": None,\n        "ret_before": None,\n        "ret_after": None,\n        "units_before": None,\n        "units_after": None,\n    }\n    # spike month\n    spike = sub.loc[sub["month"] == "2025-03"].iloc[0]\n    r["spike_units"] = int(spike["units"])\n    r["spike_returns"] = int(spike["returns"])\n    r["spike_ret_pct"] = spike["returns"] / spike["units"] * 100\n    r["spike_price"] = spike["unit_price"]\n    # months before/after spike\n    before = sub[sub["month"] < "2025-03"]\n    after = sub[sub["month"] > "2025-03"]\n    if len(before):\n        r["ret_before"] = before["returns"].sum() / before["units"].sum() * 100\n        r["units_before"] = before["units"].mean()\n        r["price_prev"] = before["unit_price"].mean()\n    if len(after):\n        r["ret_after"] = after["returns"].sum() / after["units"].sum() * 100\n        r["units_after"] = after["units"].mean()\n    if r["price_prev"]:\n        r["price_spike"] = spike["unit_price"] / r["price_prev"] - 1\n    return r\n\nctx = {}\nfor _, row in top3.iterrows():\n    ctx[(row["region"], row["product_line"])] = combo_stats(row["region"], row["product_line"])\n\n# ---- region E context (all 3 anomalies are region E, 2025-03) ----\ne_all = df[(df["region"] == "E") & (df["month"] == "2025-03")]\ne_before = df[(df["region"] == "E") & (df["month"] < "2025-03")]\ne_after = df[(df["region"] == "E") & (df["month"] > "2025-03")]\ne_spike_units = int(e_all["units"].sum())\ne_before_units = e_before["units"].sum() / (e_before["month"].nunique())\ne_after_units = e_after["units"].sum() / (e_after["month"].nunique())\ne_spike_ret = e_all["returns"].sum() / e_all["units"].sum() * 100\ne_before_ret = e_before["returns"].sum() / e_before["units"].sum() * 100\ne_after_ret = e_after["returns"].sum() / e_after["units"].sum() * 100\n\n# ---- report ----\nL = []\nL.append("# Regional Sales Volume Anomaly Report")\nL.append("")\nL.append("AS_OF: 2026-10-25 10:19（本地离线数据，非实时；数据覆盖 2024-01 至 2025-12 共 24 个自然月）")\nL.append("")\nL.append("## 1. 分析背景与方法")\nL.append("")\nL.append("本报告基于本地文件 `offline_data/regional_sales.csv`（288 行 = 12 个「区域×产品线」组合 × 24 个月，"\n         "字段：month, region, product_line, units, unit_price, revenue, returns；"\n         "（来源：offline_data/regional_sales.csv 的 month/region/product_line/units/returns 列，288 行全量样本））。"\n         "对每个「区域×产品线」组合，以其自身 24 个月销量（units）的滚动均值（trailing 24 个月，min_periods=1）为基线，"\n         "计算每月销量相对基线的倍数 multiple = 当月 units ÷ 24 个月均值，取倍数最大的前三个「组合×月份」作为单月放量异常。"\n         "中间结果表见 `offline_data/anomaly_multiples.csv`（288 行，每行一个 区域×产品线×月份 三元组）。")\nL.append("")\nL.append("## 2. 前三个单月放量异常")\nL.append("")\nL.append("| 排名 | 区域 | 产品线 | 月份 | 当月销量 units | 24 个月均值 | 倍数 | 当月退货数 | 当月退货率 |")\nL.append("|---|---|---|---|---|---|---|---|---|")\nfor i, row in top3.iterrows():\n    c = ctx[(row["region"], row["product_line"])]\n    L.append(\n        f"| {i+1} | {row[\'region\']} | {row[\'product_line\']} | {row[\'month\']} "\n        f"| {int(row[\'sales\']):,}（来源：offline_data/regional_sales.csv 的 units 列，{row[\'region\']}×{row[\'product_line\']} 2025-03 单行） "\n        f"| {row[\'mean24\']:,.2f}（来源：offline_data/regional_sales.csv 的 units 列，{row[\'region\']}×{row[\'product_line\']} 24 个月滚动均值，样本 24 行） "\n        f"| {row[\'multiple\']:.4f}（来源：由前述两行计算） "\n        f"| {int(row[\'return_rate\']):,}（来源：offline_data/regional_sales.csv 的 returns 列，{row[\'region\']}×{row[\'product_line\']} 2025-03 单行） "\n        f"| {c[\'spike_ret_pct\']:.2f}%（来源：由前述两行