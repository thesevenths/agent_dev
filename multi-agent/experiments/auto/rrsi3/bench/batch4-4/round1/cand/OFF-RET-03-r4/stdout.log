r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")
s_arpu = df["retention_d7"].corr(df["arpu_usd"], method="spearman")
s_churn = df["retention_d7"].corr(df["churn_rate"], method="spearman")

def corr_t(r, n):
    return r * np.sqrt((n-2)/(1-r*r))
t_arpu = corr_t(r_arpu, n); p_arpu = 2*stats.t.sf(abs(t_arpu), n-2)
t_churn = corr_t(r_churn, n); p_churn = 2*stats.t.sf(abs(t_churn), n-2)

med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] < med]
eq = df[df["retention_d7"] == med]
print("median:", med, "rows equal to median:", len(eq))

rows = []
for name, g in [("high", high), ("low", low)]:
    rows.append({
        "group": name,
        "n_weeks": len(g),
        "retention_d7_min": g.retention_d7.min(),
        "retention_d7_max": g.retention_d7.max(),
        "arpu_usd_mean": g.arpu_usd.mean(),
        "arpu_usd_min": g.arpu_usd.min(),
        "arpu_usd_max": g.arpu_usd.max(),
        "cohort_size_sum": int(g.cohort_size.sum()),
        "churn_rate_mean": g.churn_rate.mean(),
    })
grp = pd.DataFrame(rows)
print(grp.to_string())

arpu_diff = grp.loc[0,"arpu_usd_mean"] - grp.loc[1,"arpu_usd_mean"]
arpu_ratio = grp.loc[0,"arpu_usd_mean"] / grp.loc[1,"arpu_usd_mean"]
cohort_ratio = grp.loc[0,"cohort_size_sum"] / grp.loc[1,"cohort_size_sum"]
print("arpu diff:", arpu_diff, "ratio:", arpu_ratio, "cohort ratio:", cohort_ratio)

t2, p2 = stats.ttest_ind(high.arpu_usd, low.arpu_usd)
print("ttest arpu:", t2, p2)

out = os.path.join(out_dir, "step2_results.csv")
with open(out, "w", encoding="utf-8") as f:
    f.write("# Step 2 intermediate results: correlations & median-split group stats\n")
    f.write("# source: offline_data/app_metrics.csv, n=60 weekly rows (W01-W60), 0 missing\n")
    f.write("# as_of: 2026-10-25 10:45 (analysis run time); data file mtime 2026-10-23 10:11\n")
    f.write("\n[correlations]\n")
    f.write("pair,pearson_r,spearman_r,t_stat,p_value,n\n")
    f.write(f"retention_d7_vs_arpu_usd,{r_arpu:.6f},{s_arpu:.6f},{t_arpu:.4f},{p_arpu:.3e},{n}\n")
    f.write(f"retention_d7_vs_churn_rate,{r_churn:.6f},{s_churn:.6f},{t_churn:.4f},{p_churn:.3e},{n}\n")
    f.write("\n[median_split]\n")
    f.write(f"median_retention_d7,{med}\n")
    f.write(f"rows_equal_to_median,{len(eq)}\n")
    f.write("\n[group_stats]\n")
    grp.to_csv(f, index=False)
    f.write("\n[derived]\n")
    f.write(f"arpu_mean_diff_high_minus_low,{arpu_diff:.6f}\n")
    f.write(f"arpu_mean_ratio_high_over_low,{arpu_ratio:.6f}\n")
    f.write(f"cohort_size_ratio_high_over_low,{cohort_ratio:.6f}\n")
    f.write(f"ttest_arpu_high_vs_low_t,{t2:.4f}\n")
    f.write(f"ttest_arpu_high_vs_low_p,{p2:.3e}\n")
print("saved:", out)

