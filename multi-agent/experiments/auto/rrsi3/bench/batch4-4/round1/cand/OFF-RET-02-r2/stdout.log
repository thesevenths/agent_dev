import pandas as pd, json
df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df.week.str.match(r"W(3[0-9]|4[0-3])$")].copy()
a = sub[sub.week <= "W36"]; b = sub[sub.week >= "W37"]
res = {}
for col in ["retention_d7","churn_rate","arpu_usd"]:
    ma, mb = a[col].mean(), b[col].mean()
    res[col] = dict(before=ma, after=mb, diff=mb-ma, rel=(mb-ma)/ma)
print(json.dumps(res, indent=2))
# per-week deltas
sub["d_ret"] = sub.retention_d7.diff()
sub["d_churn"] = sub.churn_rate.diff()
sub["d_arpu"] = sub.arpu_usd.diff()
print(sub[["week","retention_d7","churn_rate","arpu_usd","d_ret","d_churn","d_arpu"]].to_string())
# max negative jump in retention / max positive jump in churn
print("max d_ret drop:", sub.d_ret.min(), "at", sub.loc[sub.d_ret.idxmin(),"week"])
print("max d_churn rise:", sub.d_churn.max(), "at", sub.loc[sub.d_churn.idxmax(),"week"])
print("max d_arpu drop:", sub.d_arpu.min(), "at", sub.loc[sub.d_arpu.idxmin(),"week"])
# std within groups

