import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df["week"].str.match(r"W(3[0-9]|4[0-3])$")].copy()
sub["segment"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
means = sub.groupby("segment")[metrics].mean()
counts = sub.groupby("segment")[metrics].count()
print(means.round(6))
print(counts)

# per-week deltas to pinpoint breakpoint
sub["delta_ret"] = sub["retention_d7"].diff()
sub["delta_churn"] = sub["churn_rate"].diff()
sub["delta_arpu"] = sub["arpu_usd"].diff()
print(sub[["week","retention_d7","churn_rate","arpu_usd","delta_ret","delta_churn","delta_arpu"]].round(4).to_string(index=False))

# relative changes
pre, post = means.loc["W30-W36"], means.loc["W37-W43"]
for m in metrics:
    print(m, "abs diff:", round(post[m]-pre[m],6), "rel %:", round((post[m]-pre[m])/pre[m]*100,2))

out = sub[["week","segment","cohort_size","dau","retention_d7","churn_rate","arpu_usd","support_tickets","delta_ret","delta_churn","delta_arpu"]]
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r2\_sandbox\tmp\step2_perweek.csv", index=False)

summary = pd.DataFrame({
    "segment": ["W30-W36","W37-W43"],
    "n": [7,7],
    "retention_d7_mean": [round(pre["retention_d7"],6), round(post["retention_d7"],6)],
    "churn_rate_mean": [round(pre["churn_rate"],6), round(post["churn_rate"],6)],
    "arpu_usd_mean": [round(pre["arpu_usd"],6), round(post["arpu_usd"],6)],
})
summary.to_csv(r"E:\agent_dev\multi-agent\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r2\_sandbox\tmp\step2_group_means.csv", index=False) if False else summary.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r2\_sandbox\tmp\step2_group_means.csv", index=False)
print(summary)

