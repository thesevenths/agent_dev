```python
import pandas as pd, os, json

df = pd.read_csv("offline_data/regional_sales.csv")
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-TRD-03-r4\_sandbox\tmp"
os.makedirs(outdir, exist_ok=True)

# per-region aggregates
n_months = df["month"].nunique()
reg = df.groupby("region")["revenue"].agg(total_revenue="sum", n_rows="count").reset_index()
reg["n_months"] = n_months
reg["monthly_avg_revenue"] = reg["total_revenue"] / n_months
reg["revenue_share_pct"] = reg["total_revenue"] / reg["total_revenue"].sum() * 100
reg = reg.sort_values("total_revenue", ascending=False).reset_index(drop=True)
reg.to_csv(os.path.join(outdir, "step2_regional_aggregates.csv"), index=False, encoding="utf-8-sig")

# per-region monthly revenue
monthly = df.groupby(["region", "month"])["revenue"].sum().reset_index()
monthly.to_csv(os.path.join(outdir, "step2_regional_monthly_revenue.csv"), index=False, encoding="utf-8-sig")

# top region & its peak month
top = reg.iloc[0]
top_region = top["region"]
peak = monthly[monthly["region"] == top_region].sort_values("revenue", ascending=False).iloc[0]

# also each region's peak month for context
peaks = monthly.loc[monthly.groupby("region")["revenue"].idxmax()][["region","month","revenue"]]

summary = {
    "n_months": int(n_months),
    "month_range": [df["month"].min(), df["month"].max()],
    "overall_total_revenue": float(df["revenue"].sum()),
    "regional": reg.to_dict(orient="records"),
    "top_region": top_region,
    "top_region_total": float(top["total_revenue"]),
    "top_region_share_pct": float(top["revenue_share_pct"]),
    "top_region_peak_month": peak["month"],
    "top_region_peak_revenue": float(peak["revenue"]),
    "all_region_peaks": peaks.to_dict(orient="records"),
}
with open(os.path.join(outdir, "step2_summary.json"), "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)

print(reg.to_string(index=False))
print("\nTop region:", top_region, "| peak month:", peak["month"], "| peak revenue:", peak["revenue"])
print("\nAll region peaks:\n", peaks.to_string(index=False))
print("\nSaved:")
for fn in ["step2_regional_aggregates.csv", "step2_regional_monthly_revenue.csv", "step2_summary.json"]:
    p = os.path.join(outdir, fn)
    print(" ", p, os.path.getsize(p), "bytes")

