```python
import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")

# region totals
reg = df.groupby('region')['revenue'].sum()
total_all = df['revenue'].sum()
months = df['month'].nunique()

summary = {
    "total_rows": len(df),
    "regions": {r: {"total_revenue": round(reg[r],2),
                    "share_pct": round(reg[r]/total_all*100,2),
                    "monthly_avg": round(reg[r]/months,2)} for r in ["N","S","E","W"]},
    "grand_total": round(total_all,2),
    "n_months": months,
    "top_region": reg.idxmax(),
}

# monthly revenue per region
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
top = reg.idxmax()
peak_month = piv[top].idxmax()
summary["top_region_peak_month"] = peak_month
summary["top_region_peak_revenue"] = round(piv.loc[peak_month, top],2)

# monthly totals per region (for report table)
summary["monthly"] = {r: {m: round(v,2) for m,v in piv[r].items()} for r in ["N","S","E","W"]}

out = "E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch4-4/round1/cand/OFF-TRD-03-r4/_sandbox/tmp/step1_validation_summary.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print(json.dumps(summary, ensure_ascii=False, indent=2))
print("saved:", out)

