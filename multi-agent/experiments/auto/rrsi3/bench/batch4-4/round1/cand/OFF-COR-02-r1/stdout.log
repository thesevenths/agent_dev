import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day","math_score","reading_score"]
n = len(df)

res = []
for c in ["math_score","reading_score"]:
    r = df["screen_hours_per_day"].corr(df[c])  # Pearson
    res.append({"pair": f"screen_hours_per_day vs {c}", "method": "pearson",
                "correlation": round(r, 6), "n": n})

out = pd.DataFrame(res)
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step2_correlations.csv", index=False)
out.to_json(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step2_correlations.json", orient="records", indent=2)
print(out.to_string(index=False))

```
