import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: ">5", False: "<=5"})

g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
).reindex(["<=5", ">5"])

diff = g.loc[">5"] - g.loc["<=5"]
g["diff_math_gt5_minus_le5"] = diff["mean_math"]
g["diff_reading_gt5_minus_le5"] = diff["mean_reading"]
g["diff_screen"] = diff["mean_screen"]

out = g.reset_index().rename(columns={"group":"screen_hours_per_day_group"})
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step3_group_stats.csv", index=False)
out.to_json(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step3_group_stats.json", orient="records", indent=2)
print(out.to_string(index=False))

