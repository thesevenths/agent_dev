```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(path)
df['week_num'] = df['week'].str.replace('W', '', regex=False).astype(int)
sub = df[(df['week_num'] >= 30) & (df['week_num'] <= 43)].copy()
sub['group'] = sub['week_num'].apply(lambda w: 'W30-W36' if w <= 36 else 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# per-week table
per_week = sub[['week'] + metrics].copy()

# group means
g = sub.groupby('group')[metrics].mean()
n = sub.groupby('group').size()
print("group sizes:\n", n)
print("\ngroup means:\n", g)

# deltas (after - before)
before, after = g.loc['W30-W36'], g.loc['W37-W43']
delta = after - before
pct = (delta / before * 100)
print("\ndelta (after-before):\n", delta)
print("\npct change:\n", pct)

# breakpoint detection: week-over-week change within W30-W43
sub2 = sub.sort_values('week_num').reset_index(drop=True)
wow = sub2[metrics].diff()
print("\nweek-over-week changes:\n", pd.concat([sub2[['week']], wow], axis=1).to_string())

# max absolute relative jump
rel = wow / sub2[metrics].shift(1)
print("\nrelative WoW:\n", pd.concat([sub2[['week']], rel], axis=1).to_string())

# save intermediate CSV
out = pd.concat([sub2[['week','group'] + metrics], wow.rename(columns=lambda c: f'{c}_wow'), rel.rename(columns=lambda c: f'{c}_wow_rel')], axis=1)
out_path = f"{out_dir}\\step2_breakpoint_results.csv"
out.to_csv(out_path, index=False)

# also save group means
gm = g.copy()
gm['n_rows'] = n
gm.to_csv(f"{out_dir}\\step2_group_means.csv")

print("\nsaved:", out_path)
print(out.to_string())

