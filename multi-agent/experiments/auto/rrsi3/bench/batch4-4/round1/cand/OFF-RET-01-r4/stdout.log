```python
import pandas as pd, numpy as np, json

df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
first = r.iloc[:30]; last = r.iloc[30:]
stats = {
 'n': len(r),
 'first_mean': first.mean(), 'first_std': first.std(ddof=1),
 'last_mean': last.mean(), 'last_std': last.std(ddof=1),
 'diff_mean': last.mean()-first.mean(),
 'diff_std': last.std(ddof=1)-first.std(ddof=1),
 'overall_mean': r.mean(), 'overall_std': r.std(ddof=1),
 'threshold': r.mean()-2*r.std(ddof=1),
 'below_count': int((r < r.mean()-2*r.std(ddof=1)).sum()),
 'below_weeks': df.loc[r < r.mean()-2*r.std(ddof=1), 'week'].tolist(),
 'min': r.min(), 'max': r.max(),
 'first_min': first.min(), 'first_max': first.max(),
 'last_min': last.min(), 'last_max': last.max(),
}
print(json.dumps(stats, indent=2, default=float))
print('first weeks:', df['week'].iloc[0], '->', df['week'].iloc[29])
print('last weeks:', df['week'].iloc[30], '->', df['week'].iloc[59])

```
