import pandas as pd, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r4\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(r"offline_data/app_metrics.csv")
r = df["retention_d7"].astype(float)
n = len(r)
first30 = r.iloc[:30]
last30 = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

res = {
    "n_weeks": n,
    "first30": {"weeks": [df['week'].iloc[0], df['week'].iloc[29]], "mean": first30.mean(), "std": first30.std(ddof=1)},
    "last30": {"weeks": [df['week'].iloc[30], df['week'].iloc[59]], "mean": last30.mean(), "std": last30.std(ddof=1)},
    "overall": {"mean": overall_mean, "std": overall_std, "threshold": threshold},
    "diff_mean": first30.mean() - last30.mean(),
    "diff_std": first30.std(ddof=1) - last30.std(ddof=1),
    "below_count": int(len(below)),
    "below_weeks": below.index.tolist(),
    "below_labels": df.loc[below.index, "week"].tolist(),
    "below_values": below.tolist(),
}
with open(os.path.join(out_dir, "retention_d7_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))

