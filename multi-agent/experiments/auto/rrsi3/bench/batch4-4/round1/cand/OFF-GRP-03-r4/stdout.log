import pandas as pd, json, os

df = pd.read_csv('offline_data/students.csv')
print(df[['study_hours_per_week','math_score']].describe())
print("nulls:", df[['study_hours_per_week','math_score']].isna().sum().to_dict())

def grp(h):
    if h < 2.5: return 'low'
    elif h <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)
g = df.groupby('group')['math_score'].agg(['mean','count','std','min','max'])
print(g)

low = g.loc['low','mean']; high = g.loc['high','mean']
gain = high - low
gain_pct = gain/low*100
print("gain:", gain, "pct:", gain_pct)

out = {
  "as_of": "2026-10-26 06:29",
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "groups": {k: {"math_score_mean": round(v['mean'],4), "n": int(v['count']),
                 "std": round(v['std'],4), "min": float(v['min']), "max": float(v['max'])}
             for k,v in g.iterrows()},
  "low_to_high_gain": round(gain,4),
  "low_to_high_gain_pct": round(gain_pct,4),
  "hour_ranges": {"low": "<2.5", "mid": "2.5-4.5", "high": ">4.5"},
  "study_hours_mean_by_group": {k: round(v,4) for k,v in df.groupby('group')['study_hours_per_week'].mean().items()},
}
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-03-r4\_sandbox\tmp"
os.makedirs(outdir, exist_ok=True)
with open(os.path.join(outdir,'group_stats.json'),'w',encoding='utf-8') as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
pd.DataFrame(g).to_csv(os.path.join(outdir,'group_stats.csv'), encoding='utf-8-sig')
print("saved to", outdir)
print(json.dumps(out,ensure_ascii=False,indent=2))

