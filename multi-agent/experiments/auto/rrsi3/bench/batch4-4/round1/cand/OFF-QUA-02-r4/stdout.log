istency_report.md")\n\nos.makedirs(OUT_DIR, exist_ok=True)\n\ndf = pd.read_csv(SRC)\nn = len(df)\nprint("columns:", list(df.columns))\nprint("dtypes:\\n", df.dtypes)\nprint("rows:", n)\nprint(df.head(5).to_string())\n\n# 逐行计算\ndf["expected_revenue"] = df["units"] * df["unit_price"]\ndf["abs_diff"] = (df["revenue"] - df["expected_revenue"]).abs()\ndf["deviation_pct"] = df["abs_diff"] / df["expected_revenue"] * 100.0\ndf["deviation_gt_0.5pct"] = df["deviation_pct"] > 0.5\ndf["returns_gt_units"] = df["returns"] > df["units"]\n\nn_dev = int(df["deviation_gt_0.5pct"].sum())\nn_ret = int(df["returns_gt_units"].sum())\nmax_dev = float(df["deviation_pct"].max())\nmax_dev_idx = int(df["deviation_pct"].idxmax())\navg_dev = float(df["deviation_pct"].mean())\nmax_abs = float(df["abs_diff"].max())\nmax_abs_idx = int(df["abs_diff"].idxmax())\n\n# 最大偏差行的上下文\nrow_max = df.loc[max_dev_idx]\nrow_abs = df.loc[max_abs_idx]\n\n# 明细 CSV\ndetail = df[["month", "region", "product_line", "units", "unit_price",\n             "revenue", "expected_revenue", "abs_diff", "deviation_pct",\n             "deviation_gt_0.5pct", "returns", "returns_gt_units"]].copy()\ndetail.to_csv(DETAIL_CSV, index=False, encoding="utf-8-sig")\n\n# 偏差>0.5% 的行明细表（若为 0 行则说明）\nif n_dev > 0:\n    dev_rows = df[df["deviation_gt_0.5pct"]].head(10)\n    dev_table = dev_rows[["month", "region", "product_line", "units",\n                          "unit_price", "revenue", "expected_revenue",\n                          "deviation_pct"]].to_markdown(index=True)\nelse:\n    dev_table = "（无偏差超过 0.5% 的行）"\n\nif n_ret > 0:\n    ret_rows = df[df["returns_gt_units"]].head(10)\n    ret_table = ret_rows[["month", "region", "product_line", "units",\n                          "returns"]].to_markdown(index=True)\nelse:\n    ret_table = "（无 returns > units 的非法行）"\n\nreport = f"""# offline_data/regional_sales.csv 内部一致性核查报告\n\n- 核查时间：2026-10-26（周一）06:59（本地时间）\n- 数据源：`{SRC}`（仅本地文件，未使用任何联网数据）\n- AS_OF: 2026-10-26 06:58\n- 逐行明细文件：`{DETAIL_CSV}`