import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("missing:\n", df.isna().sum())
print("dtypes:\n", df.dtypes)
print("study_hours range:", df.study_hours_per_week.min(), df.study_hours_per_week.max())
print("math_score range:", df.math_score.min(), df.math_score.max())
print("dup student_id:", df.student_id.duplicated().sum())

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"
df["group"] = df.study_hours_per_week.apply(grp)
g = df.groupby("group").math_score.agg(["count","mean","std","min","max"])
print(g)
print("boundary check: values ==2.5:", (df.study_hours_per_week==2.5).sum(), "==4.5:", (df.study_hours_per_week==4.5).sum())
print("low->high gain:", g.loc["high","mean"]-g.loc["low","mean"])

out = {
 "shape": list(df.shape),
 "columns": list(df.columns),
 "missing": df.isna().sum().to_dict(),
 "dtypes": {k:str(v) for k,v in df.dtypes.items()},
 "study_hours": [float(df.study_hours_per_week.min()), float(df.study_hours_per_week.max())],
 "math_score": [float(df.math_score.min()), float(df.math_score.max())],
 "dup_ids": int(df.student_id.duplicated().sum()),
 "groups": {k: {"n": int(v["count"]), "mean": float(v["mean"]), "std": float(v["std"]), "min": float(v["min"]), "max": float(v["max"])} for k,v in g.iterrows()},
 "gain_low_high": float(g.loc["high","mean"]-g.loc["low","mean"]),
 "n_eq_2_5": int((df.study_hours_per_week==2.5).sum()),
 "n_eq_4_5": int((df.study_hours_per_week==4.5).sum()),
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-03-r3\_sandbox\tmp\step1_validation.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

