import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"
df["study_group"] = df.study_hours_per_week.apply(grp)

order = ["low","mid","high"]
g = df.groupby("study_group").math_score.agg(n="count", mean="mean", std="std", min="min", max="max")
g = g.reindex(order)
g["mean_rounded"] = g["mean"].round(3)

# low -> high gain
gain = g.loc["high","mean"] - g.loc["low","mean"]
gain_pct = gain / g.loc["low","mean"] * 100

# per-student file with group label
df.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-03-r3\_sandbox\tmp\step2_students_grouped.csv", index=False)

# group summary CSV
out = g.reset_index()
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-03-r3\_sandbox\tmp\step2_group_stats.csv", index=False)

# gain CSV
gain_df = pd.DataFrame([{
    "metric": "low_to_high_mean_gain",
    "value": round(gain,3),
    "formula": "mean(high) - mean(low) = 87.441 - 65.798",
    "relative_gain_pct": round(gain_pct,3),
    "n_low": int(g.loc["low","n"]), "n_high": int(g.loc["high","n"]),
}])
gain_df.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-03-r3\_sandbox\tmp\step2_gain.csv", index=False)

print(out.to_string(index=False))
print(gain_df.to_string(index=False))
print("total n:", int(g["n"].sum()))

