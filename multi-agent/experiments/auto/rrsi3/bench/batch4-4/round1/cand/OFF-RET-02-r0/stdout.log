```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r0\_sandbox\tmp"

df = pd.read_csv(src)
metrics = ['retention_d7','churn_rate','arpu_usd']

# per-week values W29-W44 (context) + group assignment
sub = df[df['week'].between('W29','W44')].copy().reset_index(drop=True)
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if 'W30' <= w <= 'W36' else ('W37-W43' if 'W37' <= w <= 'W43' else 'context'))

# group means
g = sub[sub['group'].isin(['W30-W36','W37-W43'])].groupby('group')[metrics].mean()
g['n'] = sub[sub['group'].isin(['W30-W36','W37-W43'])].groupby('group')[metrics].count()[metrics[0]]
print("group means:\n", g)

# deltas
a, b = g.loc['W30-W36'], g.loc['W37-W43']
delta = pd.DataFrame({'W30-W36': a, 'W37-W43': b})
delta['abs_diff'] = delta['W37-W43'] - delta['W30-W36']
delta['rel_diff_pct'] = (delta['abs_diff'] / delta['W30-W36'] * 100).round(2)
print("\ndeltas:\n", delta)

# per-week table with week-over-week change
pw = sub.copy()
for m in metrics:
    pw[f'{m}_wow'] = pw[m].diff()
print("\nper-week:\n", pw[['week','group','retention_d7','retention_d7_wow','churn_rate','churn_rate_wow','arpu_usd','arpu_usd_wow']].to_string())

# breakpoint: week with largest combined normalized |WoW| change
norm = pd.DataFrame(index=pw.index)
for m in metrics:
    s = pw[f'{m}_wow'].dropna()
    sd = s.abs().max()
    norm[f'{m}_norm'] = pw[f'{m}_wow'].abs() / sd
norm['score'] = norm.sum(axis=1)
bp = norm.loc[norm['score'].idxmax()]
print("\nbreakpoint week:", pw.loc[norm['score'].idxmax(),'week'], "score:", bp['score'])

# save intermediate CSV
out = pw[['week','group','cohort_size','dau','retention_d7','retention_d7_wow','churn_rate','churn_rate_wow','arpu_usd','arpu_usd_wow','support_tickets']].copy()
out.to_csv(f"{out_dir}\\step2_per_week_metrics.csv", index=False)

# save group means CSV
delta.reset_index().to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
print("\nsaved.")

```
