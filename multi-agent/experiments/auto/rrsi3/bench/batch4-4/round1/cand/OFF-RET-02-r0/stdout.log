import pandas as pd, numpy as np

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r0\_sandbox\tmp"

df = pd.read_csv(p)
metrics = ['retention_d7','churn_rate','arpu_usd']
sub = df[df['week'].isin([f"W{i:02d}" for i in range(30,44)])].copy()
sub['group'] = np.where(sub['week'].isin([f"W{i:02d}" for i in range(30,37)]), 'W30-W36', 'W37-W43')

# group means
g = sub.groupby('group')[metrics].mean()
print(g)

# per-week with week-over-week deltas
sub['d_retention_d7'] = sub['retention_d7'].diff()
sub['d_churn_rate'] = sub['churn_rate'].diff()
sub['d_arpu_usd'] = sub['arpu_usd'].diff()
print(sub[['week','group','retention_d7','churn_rate','arpu_usd','d_retention_d7','d_churn_rate','d_arpu_usd']].to_string(index=False))

# breakpoint: largest absolute normalized shift between consecutive weeks
# normalize each metric by its std over W30-W43 to compare magnitudes
norm = {}
for m in metrics:
    s = sub[m].std()
    norm[m] = sub[f'd_{m}'].abs() / s
norm_df = pd.DataFrame(norm)
norm_df['max_norm'] = norm_df.max(axis=1)
print("\nNormalized WoW shifts:")
print(norm_df.to_string())
bp = norm_df['max_norm'].idxmax()
print("\nBreakpoint transition:", sub.loc[bp,'week'], "<-", sub.loc[bp-1,'week'])

# save intermediate CSV
out = sub[['week','group','retention_d7','churn_rate','arpu_usd','d_retention_d7','d_churn_rate','d_arpu_usd']].copy()
out.to_csv(f"{out_dir}\\step2_perweek.csv", index=False)

# save group means CSV
g.to_csv(f"{out_dir}\\step2_group_means.csv")
print("\nsaved.")

