import pandas as pd, os

df = pd.read_csv('offline_data/students.csv')
sub = df[df['grade'].isin(['G10','G11','G12']) & df['region'].isin(['A','B','C','D'])]
g = sub.groupby(['grade','region'])['reading_score'].agg(['count','mean'])
g = g.reindex([(gr,r) for gr in ['G10','G11','G12'] for r in ['A','B','C','D']])

max_cell = g['mean'].idxmax(); min_cell = g['mean'].idxmin()
max_mean = g.loc[max_cell,'mean']; min_mean = g.loc[min_cell,'mean']
max_n = int(g.loc[max_cell,'count']); min_n = int(g.loc[min_cell,'count'])
gap = max_mean - min_mean
