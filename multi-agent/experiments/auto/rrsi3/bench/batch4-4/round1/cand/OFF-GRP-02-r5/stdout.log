import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-02-r5\_sandbox\tmp\step2_crosstab.csv"

df = pd.read_csv(src)
g = df.groupby(["grade","region"], observed=True)["reading_score"].agg(row_count="count", mean_reading_score="mean").reset_index()
g["mean_reading_score"] = g["mean_reading_score"].round(4)
g = g.sort_values(["grade","region"]).reset_index(drop=True)

max_row = g.loc[g["mean_reading_score"].idxmax()]
min_row = g.loc[g["mean_reading_score"].idxmin()]
print(g.to_string(index=False))
print("MAX:", max_row.tolist())
print("MIN:", min_row.tolist())
print("diff:", round(max_row["mean_reading_score"] - min_row["mean_reading_score"], 4))

g.to_csv(out, index=False)
print("saved:", out)

```
