import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-02-r5\_sandbox\tmp\crosstab_grade_region.csv"

df = pd.read_csv(src)
g = df.groupby(['grade','region'], observed=True).agg(
    n=('reading_score','size'),
    mean_reading=('reading_score','mean'),
    min_reading=('reading_score','min'),
    max_reading=('reading_score','max'),
    total_reading=('reading_score','sum'),
).reset_index()
g = g.sort_values(['grade','region'])
g['mean_reading_rounded'] = g['mean_reading'].round(2)
g.to_csv(out, index=False)
print(g.to_string(index=False))
print("total rows:", len(df))
print("overall mean:", df['reading_score'].mean())
mx = g.loc[g['mean_reading'].idxmax()]
mn = g.loc[g['mean_reading'].idxmin()]
print("MAX:", mx['grade'], mx['region'], mx['mean_reading'], "n=", mx['n'])
print("MIN:", mn['grade'], mn['region'], mn['mean_reading'], "n=", mn['n'])
print("saved:", out)

```
