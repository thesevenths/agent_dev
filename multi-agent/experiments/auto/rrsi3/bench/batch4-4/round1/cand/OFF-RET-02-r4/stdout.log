```python
import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df["week"].isin([f"W{i:02d}" for i in range(30, 44)])].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week series
weekly = sub[["week", "group"] + metrics].copy()

# group means
means = sub.groupby("group")[metrics].mean().reset_index()
print(means.to_string(index=False))

# differences (after - before)
before = sub[sub["group"] == "W30-W36"][metrics].mean()
after = sub[sub["group"] == "W37-W43"][metrics].mean()
diff = after - before
pct = diff / before * 100
print("\ndiff (after-before):\n", diff)
print("\npct change:\n", pct)

# save intermediate CSVs
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r4\_sandbox\tmp"
weekly.to_csv(f"{out_dir}\\step2_weekly_series.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)

diff_df = pd.DataFrame({
    "metric": metrics,
    "mean_W30_W36": before.values,
    "mean_W37_W43": after.values,
    "diff_after_minus_before": diff.values,
    "pct_change": pct.values,
})
diff_df.to_csv(f"{out_dir}\\step2_diff.csv", index=False)
print("\nsaved.")
print(diff_df.to_string(index=False))

```
