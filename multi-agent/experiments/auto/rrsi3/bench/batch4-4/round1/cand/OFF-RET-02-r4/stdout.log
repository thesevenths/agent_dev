```python
import pandas as pd

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r4\_sandbox\tmp"
weekly = pd.read_csv(f"{out_dir}\\step2_weekly_series.csv")
weekly["d_ret"] = weekly["retention_d7"].diff()
weekly["d_churn"] = weekly["churn_rate"].diff()
weekly["d_arpu"] = weekly["arpu_usd"].diff()

# breakpoint = week with largest combined |shift|
weekly["shift_score"] = (weekly["d_ret"].abs() + weekly["d_churn"].abs() + weekly["d_arpu"].abs())
bp = weekly.loc[weekly["shift_score"].idxmax()]
print("breakpoint week:", bp["week"])
print(bp[["week","d_ret","d_churn","d_arpu","shift_score"]])

summary = pd.DataFrame([{
    "breakpoint_week": bp["week"],
    "retention_d7_shift": round(bp["d_ret"], 4),
    "churn_rate_shift": round(bp["d_churn"], 4),
    "arpu_usd_shift": round(bp["d_arpu"], 3),
    "shift_score": round(bp["shift_score"], 4),
}])
summary.to_csv(f"{out_dir}\\breakpoint_summary.csv", index=False)
print(summary.to_string(index=False))

