: int(row["count"]),\n        "peak_month": str(p["month"]),\n        "peak_month_revenue": round(float(p["revenue"]), 2),\n    }\n\ntop_region = max(regions, key=lambda r: regions[r]["total_revenue"])\n\nresult = {\n    "source_file": os.path.abspath(CSV),\n    "as_of": "2026-10-26 07:26 (static offline file; data covers 2024-01 .. 2025-12)",\n    "aggregation_basis": {\n        "revenue_column": "revenue",\n        "total_rows": int(len(df)),\n        "rows_per_region": {r: int(n) for r, n in df["region"].value_counts().items()},\n        "n_months": n_months,\n        "month_range": [str(df["month"].min()), str(df["month"].max())],\n        "grand_total_revenue": round(grand_total, 2),\n    },\n    "regions": regions,\n    "top_region": {\n        "region": top_region,\n        "total_revenue": regions[top_region]["total_revenue"],\n        "peak_month": regions[top_region]["peak_month"],\n        "peak_month_revenue": regions[top_region]["peak_month_revenue"],\n    },\n    "monthly_revenue_by_region": {\n        r: {m: round(v, 2) for m, v in\n            monthly[monthly["region"] == r].set_index("month")["revenue"].items()}\n        for r in ["N", "S", "E", "W"]\n    },\n}\n\nwith open(OUT, "w", encoding="utf-8") as f:\n    json.dump(result, f, ensure_ascii=False, indent=2)\n\nprint(json.dumps({k: v for k, v in result.items() if k != "monthly_revenue_by_region"},\n                 ensure_ascii=False, indent=2))\nprint("\\nSaved to:", os.path.abspath(OUT))\n'} with error:
