import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]

def stats(s):
    return {"n": int(len(s)), "mean": float(s.mean()), "std": float(s.std(ddof=1))}

out = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "total_weeks": int(len(r)),
    "first_30": stats(first),
    "last_30": stats(last),
    "diff_mean_last_minus_first": float(last.mean() - first.mean()),
    "overall": stats(r),
    "threshold_mean_minus_2std": float(r.mean() - 2*r.std(ddof=1)),
    "weeks_below_threshold": int((r < r.mean() - 2*r.std(ddof=1)).sum()),
    "weeks_below_threshold_list": df.loc[r < r.mean() - 2*r.std(ddof=1), "week"].tolist(),
}
os.makedirs(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r2\_sandbox\tmp", exist_ok=True)
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r2\_sandbox\tmp\retention_d7_stats.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", path)

