```python
import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/students.csv')
print(df.shape)
print(df['tutoring'].value_counts())
print(df['math_score'].isna().sum())

g = df.groupby('tutoring')['math_score']
n0, n1 = (df['tutoring']==0).sum(), (df['tutoring']==1).sum()
m0, m1 = g.mean()
s0, s1 = g.std(ddof=1)
pooled = np.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2)/(n0+n1-2))
diff = m1 - m0
d = diff / pooled
print(dict(n0=n0, n1=n1, m0=m0, m1=m1, s0=s0, s1=s1, pooled=pooled, diff=diff, d=d))

```
