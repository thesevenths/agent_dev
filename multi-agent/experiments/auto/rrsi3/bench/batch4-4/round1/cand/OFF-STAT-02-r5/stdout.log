import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-STAT-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
print(df.head())
print(df.shape)
print(df.dtypes)
print("nulls:", df[['math_score','reading_score']].isna().sum().to_dict())

m = df['math_score']; r = df['reading_score']
stats = {
    'n': len(df),
    'math_mean': m.mean(), 'math_std': m.std(ddof=1), 'math_std_pop': m.std(ddof=0),
    'math_median': m.median(),
    'read_mean': r.mean(), 'read_std': r.std(ddof=1), 'read_std_pop': r.std(ddof=0),
    'read_median': r.median(),
    'pearson': m.corr(r),
}
stats['math_cv'] = stats['math_std']/stats['math_mean']
stats['read_cv'] = stats['read_std']/stats['read_mean']
for k,v in stats.items():
    print(k, v)

```
