import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("week range:", df['week'].min(), "->", df['week'].max())
print("nulls:\n", df.isna().sum())
print("dtypes:\n", df.dtypes)

w30_36 = df[df['week'].between('W30','W36')]
w37_43 = df[df['week'].between('W37','W43')]
print("\nW30-W36 rows:", len(w30_36), w30_36['week'].tolist())
print("W37-W43 rows:", len(w37_43), w37_43['week'].tolist())

cols = ['retention_d7','churn_rate','arpu_usd']
m1 = w30_36[cols].mean()
m2 = w37_43[cols].mean()
print("\nW30-W36 means:\n", m1)
print("\nW37-W43 means:\n", m2)
print("\ndiff (W37-43 minus W30-36):\n", m2-m1)
print("\nrel change %:\n", (m2-m1)/m1*100)

# per-week values around breakpoint
print("\nweekly W29-W44:")
print(df[df['week'].between('W29','W44')][['week']+cols].to_string(index=False))

# where does each metric cross? check W36->W37 jump
for c in cols:
    print(c, "W36:", df.loc[df.week=='W36', c].values[0], "W37:", df.loc[df.week=='W37', c].values[0])

```
