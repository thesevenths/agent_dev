import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week table
perweek = sub[["week", "group"] + metrics].copy()

# group means
means = sub.groupby("group")[metrics].mean().round(6)
n = sub.groupby("group").size()

# deltas (after - before) and relative change
before = means.loc["W30-W36"]
after = means.loc["W37-W43"]
delta = (after - before).round(6)
rel = (delta / before * 100).round(3)

summary = pd.DataFrame({
    "n_weeks": [n["W30-W36"], n["W37-W43"]],
    "mean_before": [before[m] for m in metrics],
    "mean_after": [after[m] for m in metrics],
    "delta_after_minus_before": [delta[m] for m in metrics],
    "rel_change_pct": [rel[m] for m in metrics],
}).set_index(pd.Index(metrics, name="metric"))

# W36->W37 single-week jump
w36 = sub[sub.week=="W36"][metrics].iloc[0]
w37 = sub[sub.week=="W37"][metrics].iloc[0]
jump = (w37 - w36).round(6)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r3\_sandbox\tmp"
perweek.to_csv(f"{out_dir}\\step2_perweek.csv", index=False)
summary.to_csv(f"{out_dir}\\step2_group_means.csv")
pd.DataFrame({"W36": w36, "W37": w37, "jump_W37_minus_W36": jump}).to_csv(f"{out_dir}\\step2_w36_w37_jump.csv")

print(perweek.to_string(index=False))
print("\nGroup means (n weeks: W30-W36=7, W37-W43=7):")
print(summary.to_string())
print("\nW36->W37 jump:")
