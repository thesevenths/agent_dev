import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r0\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
r = df["retention_d7"]

first30 = df.iloc[:30]["retention_d7"]
last30 = df.iloc[30:]["retention_d7"]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

results = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "total_weeks": int(len(df)),
    "first30": {
        "weeks": f"{df.iloc[0]['week']}..{df.iloc[29]['week']}",
        "n": int(len(first30)),
        "mean": first30.mean(),
        "std_ddof1": first30.std(ddof=1),
        "std_ddof0": first30.std(ddof=0),
    },
    "last30": {
        "weeks": f"{df.iloc[30]['week']}..{df.iloc[59]['week']}",
        "n": int(len(last30)),
        "mean": last30.mean(),
        "std_ddof1": last30.std(ddof=1),
        "std_ddof0": last30.std(ddof=0),
    },
    "diff_mean_last30_minus_first30": last30.mean() - first30.mean(),
    "overall": {
        "n": int(len(r)),
        "mean": overall_mean,
        "std_ddof1": overall_std,
        "std_ddof0": r.std(ddof=0),
    },
    "anomaly": {
        "rule": "retention_d7 < overall_mean - 2*overall_std (ddof=1)",
        "threshold": threshold,
        "count": int(len(below)),
        "weeks": below["week"].tolist(),
        "values": below["retention_d7"].tolist(),
    },
}
print(json.dumps(results, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r0\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(results, f, indent=2, ensure_ascii=False)
print("saved:", out)

