import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

g = df.groupby("tutoring")["math_score"]
n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std(ddof=1)[0]), float(g.std(ddof=1)[1])

diff = m1 - m0
pooled = np.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
d = diff / pooled

print(f"n0={n0} n1={n1}")
print(f"mean0={m0:.6f} mean1={m1:.6f}")
print(f"std0={s0:.6f} std1={s1:.6f}")
print(f"diff(m1-m0)={diff:.6f}")
print(f"pooled_std={pooled:.6f}")
print(f"cohens_d={d:.6f}")

