```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-03-r5\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)

rows = []
for g in ["low","mid","high"]:
    sub = df[df["group"]==g]
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "math_mean": round(float(sub["math_score"].mean()), 4),
        "math_std": round(float(sub["math_score"].std(ddof=1)), 4),
        "math_min": int(sub["math_score"].min()),
        "math_max": int(sub["math_score"].max()),
        "hours_min": float(sub["study_hours_per_week"].min()),
        "hours_max": float(sub["study_hours_per_week"].max()),
        "hours_mean": round(float(sub["study_hours_per_week"].mean()), 4),
    })

res = pd.DataFrame(rows)
low_mean = res.loc[res.group=="low","math_mean"].iloc[0]
high_mean = res.loc[res.group=="high","math_mean"].iloc[0]
gain = high_mean - low_mean
gain_pct = gain / low_mean * 100

summary = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "nulls": {"study_hours_per_week": 0, "math_score": 0},
    "overall_math_mean": round(float(df["math_score"].mean()), 4),
    "groups": res.to_dict("records"),
    "low_to_high_gain": round(float(gain), 4),
    "low_to_high_gain_pct": round(float(gain_pct), 4),
    "as_of": "2026-10-26 06:30",
}
with open(os.path.join(out_dir, "group_stats.json"), "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
res.to_csv(os.path.join(out_dir, "group_stats.csv"), index=False)
print(res.to_string(index=False))
print("gain:", round(gain,4), "pct:", round(gain_pct,4))
print("saved:", os.path.join(out_dir,"group_stats.json"), os.path.join(out_dir,"group_stats.csv"))

```
