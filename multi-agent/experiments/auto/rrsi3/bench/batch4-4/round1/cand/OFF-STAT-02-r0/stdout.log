import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
m, r = df["math_score"], df["reading_score"]
n = len(df)

pearson = m.corr(r)  # pandas default = Pearson
out = {
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-25 11:48",
    "n": n,
    "missing": {"math_score": int(m.isna().sum()), "reading_score": int(r.isna().sum())},
    "math_score": {
        "mean": float(m.mean()),
        "std": float(m.std(ddof=1)),
        "median": float(m.median()),
        "cv": float(m.std(ddof=1) / m.mean()),
    },
    "reading_score": {
        "mean": float(r.mean()),
        "std": float(r.std(ddof=1)),
        "median": float(r.median()),
        "cv": float(r.std(ddof=1) / r.mean()),
    },
    "pearson_r": float(pearson),
    "notes": "std uses sample std (ddof=1); cv = std/mean; pearson via pandas .corr (default method='pearson')",
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-STAT-02-r0\_sandbox\tmp\step2_stats.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", os.path.abspath(path))

