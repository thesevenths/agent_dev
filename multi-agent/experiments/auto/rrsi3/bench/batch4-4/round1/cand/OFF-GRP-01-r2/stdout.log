import pandas as pd
from pathlib import Path

csv = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r2\_sandbox\offline_data\students.csv")
df = pd.read_csv(csv)
g = df.groupby('tutoring')['math_score'].agg(['count','mean','std','min','max'])
print(g)
# group sizes
print(df['tutoring'].value_counts())
# pooled std (n1+n2-2)
n1, n2 = int((df.tutoring==0).sum()), int((df.tutoring==1).sum())
s1 = df.loc[df.tutoring==0,'math_score'].std(ddof=1)
s2 = df.loc[df.tutoring==1,'math_score'].std(ddof=1)
sp = ((n1-1)*s1**2 + (n2-1)*s2**2)/(n1+n2-2) ** 0.5
print("pooled std:", sp)
m1 = df.loc[df.tutoring==0,'math_score'].mean()
m2 = df.loc[df.tutoring==1,'math_score'].mean()
print("diff:", m2-m1, "d:", (m2-m1)/sp)

