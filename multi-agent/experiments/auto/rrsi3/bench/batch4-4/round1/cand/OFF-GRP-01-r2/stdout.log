import pandas as pd, json
from pathlib import Path

csv = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r2\_sandbox\offline_data\students.csv")
out_dir = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-01-r2\_sandbox\tmp")
df = pd.read_csv(csv)

rows = []
for t in [0, 1]:
    s = df.loc[df.tutoring == t, 'math_score']
    rows.append({"tutoring": t, "n": int(s.count()), "mean": float(s.mean()), "std": float(s.std(ddof=1)),
                 "min": int(s.min()), "max": int(s.max())})

g0, g1 = rows
n1, n2 = g0["n"], g1["n"]
s1, s2 = g0["std"], g1["std"]
pooled_var = ((n1-1)*s1**2 + (n2-1)*s2**2) / (n1+n2-2)
pooled_std = pooled_var ** 0.5
mean_diff = g1["mean"] - g0["mean"]
cohens_d = mean_diff / pooled_std
# Cohen 1988 thresholds: 0.2 small, 0.5 medium, 0.8 large
if abs(cohens_d) < 0.2: cls = "小 (small)"
elif abs(cohens_d) < 0.5: cls = "小-中之间 (small-to-medium)"
elif abs(cohens_d) < 0.8: cls = "中 (medium)"
else: cls = "大 (large)"

result = {
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-26 07:09 (static local CSV, file mtime 2026-10-23 10:11)",
    "groups": rows,
    "mean_diff_tutoring1_minus_0": mean_diff,
    "pooled_std": pooled_std,
    "cohens_d": cohens_d,
    "effect_size_classification": cls,
    "thresholds": "Cohen(1988): |d|<0.2 small, 0.2-0.5 small-medium, 0.5-0.8 medium, >=0.8 large",
}
(out_dir / "group_stats_effect_size.json").write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8")

# also a CSV of group stats
pd.DataFrame(rows).to_csv(out_dir / "group_stats.csv", index=False)
print(json.dumps(result, ensure_ascii=False, indent=2))

