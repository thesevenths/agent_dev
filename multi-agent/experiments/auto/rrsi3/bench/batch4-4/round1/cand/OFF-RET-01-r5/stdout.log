import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]
last = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
    "as_of": "2026-10-26 06:43",
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "total_rows": int(len(r)),
    "first30": {
        "weeks": [df['week'].iloc[0], df['week'].iloc[29]],
        "n": int(len(first)),
        "mean": float(first.mean()),
        "std_ddof1": float(first.std(ddof=1)),
    },
    "last30": {
        "weeks": [df['week'].iloc[30], df['week'].iloc[59]],
        "n": int(len(last)),
        "mean": float(last.mean()),
        "std_ddof1": float(last.std(ddof=1)),
    },
    "overall60": {
        "n": int(len(r)),
        "mean": float(overall_mean),
        "std_ddof1": float(overall_std),
    },
    "diff_mean_last_minus_first": float(last.mean() - first.mean()),
    "threshold_mean_minus_2std": float(threshold),
    "weeks_below_threshold": {
        "count": int(len(below)),
        "weeks": below['week'].tolist(),
        "values": below['retention_d7'].tolist(),
    },
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r5\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

