```python
import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]

first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
below = r < threshold
below_weeks = df.loc[below, "week"].tolist()

res = pd.DataFrame({
    "metric": [
        "first30_mean", "first30_std", "last30_mean", "last30_std",
        "mean_diff_last_minus_first", "std_diff_last_minus_first",
        "overall_mean", "overall_std", "threshold_mean_minus_2std",
        "weeks_below_threshold_count", "weeks_below_threshold_list",
        "n_first30", "n_last30", "n_total",
    ],
    "value": [
        first30.mean(), first30.std(ddof=1), last30.mean(), last30.std(ddof=1),
        last30.mean() - first30.mean(), last30.std(ddof=1) - first30.std(ddof=1),
        overall_mean, overall_std, threshold,
        int(below.sum()), ",".join(below_weeks),
        len(first30), len(last30), len(r),
    ],
})
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-01-r5\_sandbox\tmp\step2_stats.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

```
