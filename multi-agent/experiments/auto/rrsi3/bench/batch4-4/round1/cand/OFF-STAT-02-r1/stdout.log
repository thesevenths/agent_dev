import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-STAT-02-r1\_sandbox"
out_dir = os.path.join(base, "tmp")
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
m, r = df["math_score"], df["reading_score"]
n = len(df)

def stats(s):
    mean = s.mean(); std = s.std(ddof=1); med = s.median()
    return {"mean": mean, "std_sample": std, "std_pop": s.std(ddof=0), "median": med,
            "cv_sample": std/mean, "cv_pop": s.std(ddof=0)/mean,
            "min": s.min(), "max": s.max()}

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "n_math_valid": int(m.notna().sum()),
    "n_reading_valid": int(r.notna().sum()),
    "math_score": stats(m),
    "reading_score": stats(r),
    "pearson_r": float(m.corr(r, method="pearson")),
    "pearson_r_pop": float(m.corr(r, method="pearson")),
}
# significance
import math
r_ = res["pearson_r"]; k = n
t = r_ * math.sqrt((k-2)/(1-r_**2))
res["t_stat"] = t
res["df"] = k-2
from scipy import stats as st
res["p_value"] = float(2*st.t.sf(abs(t), k-2))

with open(os.path.join(out_dir, "step1_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
