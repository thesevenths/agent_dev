```python
import pandas as pd, numpy as np, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-STAT-02-r4\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
m, r = df["math_score"], df["reading_score"]

def stats(s):
    mean = s.mean()
    std_sample = s.std(ddof=1)
    std_pop = s.std(ddof=0)
    return dict(n=int(s.count()), mean=float(mean), std_sample=float(std_sample),
                std_pop=float(std_pop), median=float(s.median()),
                min=int(s.min()), max=int(s.max()),
                cv_sample=float(std_sample/mean), cv_pop=float(std_pop/mean))

sm, sr = stats(m), stats(r)
pearson = float(m.corr(r, method="pearson"))
pearson_manual = float(np.corrcoef(m, r)[0,1])

result = {
    "source_file": "offline_data/students.csv",
    "n_rows_total": int(len(df)),
    "n_used": int(len(df)),
    "missing": {"math_score": int(m.isna().sum()), "reading_score": int(r.isna().sum())},
    "math_score": sm,
    "reading_score": sr,
    "pearson_r": pearson,
    "pearson_r_manual_check": pearson_manual,
    "cv_comparison": {
        "cv_math_sample": sm["cv_sample"],
        "cv_reading_sample": sr["cv_sample"],
        "larger_dispersion": "math_score" if sm["cv_sample"] > sr["cv_sample"] else "reading_score",
        "cv_ratio": sm["cv_sample"]/sr["cv_sample"],
    },
}
out = os.path.join(out_dir, "step1_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
