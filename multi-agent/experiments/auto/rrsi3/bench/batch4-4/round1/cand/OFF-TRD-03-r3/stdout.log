```python
import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")

# Per-region aggregates
g = df.groupby("region")["revenue"].agg(total="sum", n_rows="count")
grand = df["revenue"].sum()
g["share"] = g["total"] / grand
g["monthly_avg"] = g["total"] / 24  # 24 months
g = g.sort_values("total", ascending=False)

# Per-region monthly totals to find peak month
monthly = df.groupby(["region","month"])["revenue"].sum().reset_index()
peak = monthly.loc[monthly.groupby("region")["revenue"].idxmax()]

top_region = g.index[0]
top_peak = peak[peak["region"]==top_region].iloc[0]

print("grand total:", grand)
print(g)
print(peak)
print("top region:", top_region, "peak month:", top_peak["month"], "peak value:", top_peak["revenue"])

# Save artifacts
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"
g.reset_index().to_csv(f"{out_dir}\\step2_region_aggregates.csv", index=False)
monthly.to_csv(f"{out_dir}\\step2_region_monthly.csv", index=False)

summary = {
    "source": "offline_data/regional_sales.csv",
    "as_of": "2026-10-26 07:32",
    "grand_total_revenue": round(float(grand),2),
    "n_months": 24,
    "regions": [
        {"region": r, "total_revenue": round(float(row.total),2),
         "share": round(float(row.share),6), "monthly_avg": round(float(row.monthly_avg),2),
         "n_rows": int(row.n_rows)}
        for r,row in g.iterrows()
    ],
    "peak_month_by_region": {r: {"month": m, "revenue": round(float(v),2)} for r,m,v in zip(peak["region"],peak["month"],peak["revenue"])},
    "top_region": top_region,
    "top_region_peak_month": {"month": top_peak["month"], "revenue": round(float(top_peak["revenue"]),2)},
}
with open(f"{out_dir}\\step2_summary.json","w",encoding="utf-8") as f:
    json.dump(summary,f,ensure_ascii=False,indent=2)
print("saved")

