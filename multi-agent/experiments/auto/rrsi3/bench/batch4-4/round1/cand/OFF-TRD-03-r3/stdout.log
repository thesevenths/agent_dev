import pandas as pd, os, json

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

info = {
    "file": os.path.abspath(path),
    "columns": list(df.columns),
    "dtypes": {c: str(t) for c, t in df.dtypes.items()},
    "row_count": int(len(df)),
    "regions": sorted(df["region"].unique().tolist()),
    "region_counts": df["region"].value_counts().to_dict(),
    "months": [df["month"].min(), df["month"].max()],
    "n_months": int(df["month"].nunique()),
    "product_lines": sorted(df["product_line"].unique().tolist()),
    "null_counts": df.isna().sum().to_dict(),
    "revenue_min": float(df["revenue"].min()),
    "revenue_max": float(df["revenue"].max()),
    "revenue_sum": float(df["revenue"].sum()),
    "revenue_negative_or_zero": int((df["revenue"] <= 0).sum()),
    "month_region_combos": int(df.groupby(["month","region"]).ngroups),
    "expected_combos": 24*4,
}

# per-region aggregates
reg = df.groupby("region")["revenue"].agg(["sum","count"]).reindex(["N","S","E","W"])
reg["share"] = reg["sum"]/reg["sum"].sum()
reg["monthly_avg"] = reg["sum"]/24
info["region_totals"] = reg.round(2).to_dict()

# monthly totals per region
monthly = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
info["monthly_totals"] = monthly.round(2).to_dict()
top_region = reg["sum"].idxmax()
peak = monthly[top_region].idxmax()
info["top_region"] = top_region
info["top_region_total"] = float(reg.loc[top_region,"sum"])
info["peak_month"] = peak
info["peak_month_value"] = float(monthly.loc[peak, top_region])

# save validation summary
summary_path = os.path.join(out_dir, "step1_csv_validation.json")
with open(summary_path, "w", encoding="utf-8") as f:
    json.dump(info, f, ensure_ascii=False, indent=2)

print(json.dumps(info, ensure_ascii=False, indent=2))
print("SAVED:", summary_path)

```
