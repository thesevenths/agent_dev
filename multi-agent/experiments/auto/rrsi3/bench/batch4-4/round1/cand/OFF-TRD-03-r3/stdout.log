tmp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"
with open(os.path.join(tmp, "step1_csv_validation.json"), encoding="utf-8") as f:
    info = json.load(f)

rt = info["region_totals"]
mt = info["monthly_totals"]
grand = sum(rt["sum"][r] for r in ["N", "S", "E", "W"])

rows = []
for region in ["N", "S", "E", "W"]:
    total = rt["sum"][region]
    monthly = mt[region]
    peak_month = max(monthly, key=monthly.get)
    rows.append({
        "region": region,
        "total_revenue": round(total, 2),
        "share_pct": round(total / grand * 100, 2),
        "monthly_avg": round(total / 24, 2),
        "peak_month": peak_month,
        "peak_month_revenue": round(monthly[peak_month], 2),
    })

agg = pd.DataFrame(rows)
out = os.path.join(tmp, "regional_aggregates.csv")
agg.to_csv(out, index=False)
print(agg.to_string(index=False))
print("grand_total:", round(grand, 2))
print("SAVED:", os.path.abspath(out))

```
