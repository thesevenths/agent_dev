import pandas as pd, json

CSV = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-03-r0\_sandbox\offline_data\app_metrics.csv"
OUT = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-03-r0\_sandbox\tmp\step2_results.csv"

df = pd.read_csv(CSV)
n = len(df)

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
med = df["retention_d7"].median()

hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = [
    {"metric": "pearson_corr_retention_d7_vs_arpu_usd", "value": round(r_arpu, 6),
     "n": n, "note": "Pearson, 全样本60行"},
    {"metric": "pearson_corr_retention_d7_vs_churn_rate", "value": round(r_churn, 6),
     "n": n, "note": "Pearson, 全样本60行"},
    {"metric": "retention_d7_median", "value": med, "n": n, "note": "分组阈值"},
    {"metric": "group_high_arpu_usd_mean", "value": round(hi["arpu_usd"].mean(), 6),
     "n": len(hi), "note": "retention_d7 > 中位数"},
    {"metric": "group_high_cohort_size_sum", "value": int(hi["cohort_size"].sum()),
     "n": len(hi), "note": "retention_d7 > 中位数"},
    {"metric": "group_low_arpu_usd_mean", "value": round(lo["arpu_usd"].mean(), 6),
     "n": len(lo), "note": "retention_d7 <= 中位数"},
    {"metric": "group_low_cohort_size_sum", "value": int(lo["cohort_size"].sum()),
     "n": len(lo), "note": "retention_d7 <= 中位数"},
]
out = pd.DataFrame(rows)
out.to_csv(OUT, index=False)
print(out.to_string(index=False))
print("saved:", OUT)

```
