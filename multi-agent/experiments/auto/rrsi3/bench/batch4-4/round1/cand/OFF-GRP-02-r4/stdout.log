import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-02-r4\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-GRP-02-r4\_sandbox\tmp\step2_crosstab_metrics.csv"

df = pd.read_csv(src)
g = df.groupby(['grade', 'region'], observed=True).agg(
    row_count=('reading_score', 'size'),
    mean_reading_score=('reading_score', 'mean'),
    min_reading_score=('reading_score', 'min'),
    max_reading_score=('reading_score', 'max'),
).reset_index()

# ensure all 12 cells present
full = pd.MultiIndex.from_product([['G10','G11','G12'], ['A','B','C','D']], names=['grade','region'])
g = g.set_index(['grade','region']).reindex(full).reset_index()
g['mean_reading_score'] = g['mean_reading_score'].round(2)
g = g.sort_values(['grade','region']).reset_index(drop=True)
g.to_csv(out, index=False)
print(g.to_string(index=False))

imax = g['mean_reading_score'].idxmax()
imin = g['mean_reading_score'].idxmin()
print("\nMAX cell:", g.loc[imax, ['grade','region','mean_reading_score','row_count']].to_dict())
print("MIN cell:", g.loc[imin, ['grade','region','mean_reading_score','row_count']].to_dict())
print("diff:", round(g.loc[imax,'mean_reading_score'] - g.loc[imin,'mean_reading_score'], 2))
print("total rows:", g['row_count'].sum())
print("overall mean:", round(df['reading_score'].mean(), 2))

```
