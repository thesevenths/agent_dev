import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-03-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
med = df["retention_d7"].median()
high = df[df["retention_d7"] >= med]
low = df[df["retention_d7"] < med]
print("med:", med)
print("high n:", len(high), "arpu mean:", high["arpu_usd"].mean(), "cohort sum:", high["cohort_size"].sum())
print("low n:", len(low), "arpu mean:", low["arpu_usd"].mean(), "cohort sum:", low["cohort_size"].sum())
print("r arpu:", df["retention_d7"].corr(df["arpu_usd"]))
print("r churn:", df["retention_d7"].corr(df["churn_rate"]))
print("high arpu min/max:", high["arpu_usd"].min(), high["arpu_usd"].max())
print("low arpu min/max:", low["arpu_usd"].min(), low["arpu_usd"].max())
print("high churn mean:", high["churn_rate"].mean(), "low churn mean:", low["churn_rate"].mean())
print("high ret min/max:", high["retention_d7"].min(), high["retention_d7"].max())
print("low ret min/max:", low["retention_d7"].min(), low["retention_d7"].max())
print("arpu diff:", high["arpu_usd"].mean()-low["arpu_usd"].mean())
print("arpu diff pct:", (high["arpu_usd"].mean()/low["arpu_usd"].mean()-1)*100)
print("cohort diff pct:", (high["cohort_size"].sum()/low["cohort_size"].sum()-1)*100)
print("churn diff pct:", (high["churn_rate"].mean()/low["churn_rate"].mean()-1)*100)

```
