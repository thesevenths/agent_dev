import pandas as pd
import numpy as np

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-03-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(p)

# Correlations
corr_arpu = df['retention_d7'].corr(df['arpu_usd'])
corr_churn = df['retention_d7'].corr(df['churn_rate'])

# Median split
med = df['retention_d7'].median()
high = df[df['retention_d7'] > med]
low = df[df['retention_d7'] <= med]

res = pd.DataFrame({
    'metric': ['corr_retention_arpu', 'corr_retention_churn',
               'retention_median',
               'high_n', 'high_arpu_mean', 'high_cohort_sum',
               'low_n', 'low_arpu_mean', 'low_cohort_sum',
               'total_cohort_sum'],
    'value': [corr_arpu, corr_churn, med,
              len(high), high['arpu_usd'].mean(), high['cohort_size'].sum(),
              len(low), low['arpu_usd'].mean(), low['cohort_size'].sum(),
              df['cohort_size'].sum()]
})
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-03-r3\_sandbox\tmp\step2_results.csv"
res.to_csv(out, index=False)
print(res.to_string())
print("saved:", out)

