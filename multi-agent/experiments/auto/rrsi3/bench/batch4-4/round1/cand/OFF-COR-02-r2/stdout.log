sr, sr_p = spearmanr(df["screen_hours_per_day"], df["reading_score"])
res = {
  "n_rows": n,
  "pearson": {
    "screen_vs_math": {"r": round(r_math,6), "p_value": pm_p},
    "screen_vs_reading": {"r": round(r_read,6), "p_value": pr_p}
