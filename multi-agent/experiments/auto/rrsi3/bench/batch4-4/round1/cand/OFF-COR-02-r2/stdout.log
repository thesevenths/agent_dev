import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-COR-02-r2\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
n = len(df)

r_math = df["screen_hours_per_day"].corr(df["math_score"], method="pearson")
r_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

res = {
    "source_file": "offline_data/students.csv",
    "n_total": int(n),
    "pearson_screen_vs_math": round(float(r_math), 6),
    "pearson_screen_vs_reading": round(float(r_read), 6),
    "group_hi_gt5": {
        "n": int(len(hi)),
        "mean_screen": round(float(hi["screen_hours_per_day"].mean()), 6),
        "mean_math": round(float(hi["math_score"].mean()), 6),
        "mean_reading": round(float(hi["reading_score"].mean()), 6),
    },
    "group_lo_le5": {
        "n": int(len(lo)),
        "mean_screen": round(float(lo["screen_hours_per_day"].mean()), 6),
        "mean_math": round(float(lo["math_score"].mean()), 6),
        "mean_reading": round(float(lo["reading_score"].mean()), 6),
    },
    "diff_math_hi_minus_lo": round(float(hi["math_score"].mean() - lo["math_score"].mean()), 6),
    "diff_reading_hi_minus_lo": round(float(hi["reading_score"].mean() - lo["reading_score"].mean()), 6),
}
out = os.path.join(out_dir, "step1_correlations.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
