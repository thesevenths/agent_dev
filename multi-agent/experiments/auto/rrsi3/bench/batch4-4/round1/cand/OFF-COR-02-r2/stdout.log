import pandas as pd, json
df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-COR-02-r2\_sandbox\offline_data\students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
# also spearman for robustness
from scipy.stats import pearsonr, spearmanr
pm, pm_p = pearsonr(df["screen_hours_per_day"], df["math_score"])
pr, pr_p = pearsonr(df["screen_hours_per_day"], df["reading_score"])
