path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

r_ret_arpu = df['retention_d7'].corr(df['arpu_usd'])
r_ret_churn = df['retention_d7'].corr(df['churn_rate'])
med = df['retention_d7'].median()

hi = df[df['retention_d7'] > med]
lo = df[df['retention_d7'] < med]
eq = df[df['retention_d7'] == med]
print("median:", med, "eq rows:", len(eq))
print("hi rows:", len(hi), "lo rows:", len(lo))

rows = []
for name, g in [("high", hi), ("low", lo)]:
    rows.append({
        "group": name,
        "row_count": len(g),
        "mean_arpu_usd": g['arpu_usd'].mean(),
        "mean_churn_rate": g['churn_rate'].mean(),
        "sum_cohort_size": g['cohort_size'].sum(),
        "mean_retention_d7": g['retention_d7'].mean(),
    })

grp = pd.DataFrame(rows)
corr = pd.DataFrame([
    {"pair": "retention_d7_vs_arpu_usd", "pearson_r": r_ret_arpu, "n": len(df)},
    {"pair": "retention_d7_vs_churn_rate", "pearson_r": r_ret_churn, "n": len(df)},
])
print(corr.to_string())
print(grp.to_string())

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-03-r2\_sandbox\tmp\step2_correlations.csv"
with open(out, "w", encoding="utf-8") as f:
    f.write("# AS_OF: 2026-10-26 06:47 (offline snapshot, file mtime 2026-10-23 10:11)\n")
    f.write("# source: offline_data/app_metrics.csv, n=60 weekly rows, no missing values\n")
    f.write("# retention_d7 median = %.6f; high = retention_d7 > median, low = retention_d7 < median\n" % med)
    f.write("\n[correlations]\n")
    corr.to_csv(f, index=False)
    f.write("\n[group_stats]\n")
    grp.to_csv(f, index=False)
print("saved:", out)

```
