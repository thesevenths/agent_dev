import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
w = lambda i: f"W{i:02d}"
pre = df[df['week'].isin([w(i) for i in range(30,37)])].copy()
post = df[df['week'].isin([w(i) for i in range(37,44)])].copy()

metrics = ['retention_d7','churn_rate','arpu_usd']
pre_m = pre[metrics].mean()
post_m = post[metrics].mean()

out = pd.DataFrame({
    'group': ['W30-W36','W37-W43'],
    'n': [len(pre), len(post)],
    'retention_d7_mean': [pre_m['retention_d7'], post_m['retention_d7']],
    'churn_rate_mean': [pre_m['churn_rate'], post_m['churn_rate']],
    'arpu_usd_mean': [pre_m['arpu_usd'], post_m['arpu_usd']],
})
out['retention_d7_diff'] = out['retention_d7_mean'].iloc[1]-out['retention_d7_mean'].iloc[0]
out['churn_rate_diff'] = out['churn_rate_mean'].iloc[1]-out['churn_rate_mean'].iloc[0]
out['arpu_usd_diff'] = out['arpu_usd_mean'].iloc[1]-out['arpu_usd_mean'].iloc[0]
out['retention_d7_pct'] = out['retention_d7_diff']/out['retention_d7_mean'].iloc[0]*100
out['churn_rate_pct'] = out['churn_rate_diff']/out['churn_rate_mean'].iloc[0]*100
out['arpu_usd_pct'] = out['arpu_usd_diff']/out['arpu_usd_mean'].iloc[0]*100
print(out.to_string(index=False))

# per-week window
win = df[df['week'].isin([w(i) for i in range(30,44)])].copy()
win['retention_d7_wow'] = win['retention_d7'].diff()
win['churn_rate_wow'] = win['churn_rate'].diff()
win['arpu_usd_wow'] = win['arpu_usd'].diff()
print(win.to_string(index=False))

# breakpoint: week with largest combined normalized shift vs prior week
import numpy as np
z = pd.DataFrame({
    'ret': win['retention_d7_wow'].abs()/win['retention_d7_wow'].abs().max(),
    'churn': win['churn_rate_wow'].abs()/win['churn_rate_wow'].abs().max(),
    'arpu': win['arpu_usd_wow'].abs()/win['arpu_usd_wow'].abs().max(),
})
z['score'] = z.sum(axis=1)
