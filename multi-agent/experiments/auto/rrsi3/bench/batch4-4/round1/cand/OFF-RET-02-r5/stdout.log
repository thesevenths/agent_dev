import pandas as pd
import numpy as np

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round1\cand\OFF-RET-02-r5\_sandbox\tmp\step2_breakpoint_results.csv"

df = pd.read_csv(src)
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub = sub.sort_values("week").reset_index(drop=True)
assert len(sub) == 14, len(sub)

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week table with group label and week-over-week changes
sub["group"] = np.where(sub["week"].isin([f"W{i:02d}" for i in range(30,37)]), "W30-W36", "W37-W43")
for m in metrics:
    sub[f"{m}_wow_abs"] = sub[m].diff()
    sub[f"{m}_wow_rel"] = sub[m].diff() / sub[m].shift(1)

# combined week-over-week absolute change: normalize each metric's |wow| by its W30-W36 mean to make comparable
base = sub[sub["group"] == "W30-W36"][metrics].mean()
sub["combined_wow_abs"] = sum((sub[f"{m}_wow_abs"].abs() / base[m]) for m in metrics)

# group means
g = sub.groupby("group")[metrics].mean()
g.index.name = "group"
g = g.reset_index()

# deltas (W37-W43 minus W30-W36) and relative ratios
a = g[g["group"] == "W30-W36"].iloc[0]
b = g[g["group"] == "W37-W43"].iloc[0]
delta_rows = []
for m in metrics:
    delta_rows.append({
        "metric": m,
        "mean_W30_W36": a[m],
        "mean_W37_W43": b[m],
        "abs_delta": b[m] - a[m],
        "rel_ratio_b_over_a": b[m] / a[m],
        "rel_change_pct": (b[m] / a[m] - 1) * 100,
    })
delta = pd.DataFrame(delta_rows)

# breakpoint week: largest combined_wow_abs among W31..W43
bp = sub.loc[sub["combined_wow_abs"].idxmax()]
print("BREAKPOINT WEEK:", bp["week"], "combined_wow_abs =", round(bp["combined_wow_abs"], 6))
print("\nPer-week table:")
print(sub.to_string(index=False))
print("\nGroup means:\n", g.to_string(index=False))
print("\nDeltas:\n", delta.to_string(index=False))

# save combined CSV with sections
with open(out, "w", encoding="utf-8-sig") as f:
    f.write("# section: per_week (W30-W43, 14 rows)\n")
    sub.to_csv(f, index=False)
    f.write("\n# section: group_means (2 rows)\n")
    g.to_csv(f, index=False)
    f.write("\n# section: deltas (3 rows, W37-W43 minus W30-W36)\n")
    delta.to_csv(f, index=False)
    f.write("\n# section: breakpoint (1 row)\n")
    pd.DataFrame([{"breakpoint_week": bp["week"], "combined_wow_abs": bp["combined_wow_abs"]}]).to_csv(f, index=False)

print("\nSaved:", out)

