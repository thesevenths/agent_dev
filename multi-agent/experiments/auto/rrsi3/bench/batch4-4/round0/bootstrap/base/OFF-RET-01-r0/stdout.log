import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
thr = overall_mean - 2*overall_std
below = r[r < thr]

res = {
  "n_total": int(len(r)),
  "first30": {"mean": first.mean(), "std": first.std(ddof=1), "min": first.min(), "max": first.max()},
  "last30": {"mean": last.mean(), "std": last.std(ddof=1), "min": last.min(), "max": last.max()},
  "diff_mean": last.mean() - first.mean(),
  "overall": {"mean": overall_mean, "std": overall_std},
  "threshold": thr,
  "weeks_below_threshold": int(len(below)),
  "weeks_below_list": below.index.tolist(),
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\tmp\retention_d7_stats.json"
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, indent=2))
print("saved:", out)

```
