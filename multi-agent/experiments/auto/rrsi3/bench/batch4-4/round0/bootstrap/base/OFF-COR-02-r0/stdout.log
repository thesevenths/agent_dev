import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
cols = ["screen_hours_per_day", "math_score", "reading_score"]
sub = df[cols].dropna()
n = len(sub)
r_math = sub["screen_hours_per_day"].corr(sub["math_score"])
r_read = sub["screen_hours_per_day"].corr(sub["reading_score"])
r_mm = sub["math_score"].corr(sub["reading_score"])

out = {
    "source_file": "offline_data/students.csv",
    "n_rows_used": n,
    "method": "Pearson correlation (pandas .corr, default pearson)",
    "corr_screen_math": round(r_math, 6),
    "corr_screen_reading": round(r_read, 6),
    "corr_math_reading": round(r_mm, 6),
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(out)
print("saved:", out_path)

