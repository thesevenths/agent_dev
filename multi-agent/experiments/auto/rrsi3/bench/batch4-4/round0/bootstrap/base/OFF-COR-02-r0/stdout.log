    sub = df[[x,y]].dropna()
    n = len(sub)
    r, p = stats.pearsonr(sub[x], sub[y])
    results[(x,y)] = dict(n=n, r=r, p=p)
    print(x, y, "n=", n, "r=", r, "p=", p)

# also report means/std for context
