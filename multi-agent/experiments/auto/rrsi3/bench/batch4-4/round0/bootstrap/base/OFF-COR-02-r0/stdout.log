import pandas as pd
import numpy as np
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch4-4\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
results = {}
for x, y in pairs:
    sub = df[[x,y]].dropna()
    n = len(sub)
    r, p = stats.pearsonr(sub[x], sub[y])
    results[(x,y)] = dict(n=n, r=r, p=p)
    print(x, y, "n=", n, "r=", r, "p=", p)

# also report means/std for context
for c in ["screen_hours_per_day","math_score","reading_score"]:
    print(c, "mean=", df[c].mean(), "std=", df[c].std())

