import pandas as pd, os, json

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "screen>5", False: "screen<=5"})

g = df.groupby("group").agg(
    n=("student_id", "count"),
    screen_mean=("screen_hours_per_day", "mean"),
    math_mean=("math_score", "mean"),
    reading_mean=("reading_score", "mean"),
).reindex(["screen<=5", "screen>5"])

lo, hi = g.loc["screen<=5"], g.loc["screen>5"]
out = {
    "source_file": "offline_data/students.csv",
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "groups": {
        "screen<=5": g.loc["screen<=5"].to_dict(),
        "screen>5": g.loc["screen>5"].to_dict(),
    },
    "mean_diff_high_minus_low": {
        "math_score": hi["math_mean"] - lo["math_mean"],
        "reading_score": hi["reading_mean"] - lo["reading_mean"],
    },
    "total_n": int(g["n"].sum()),
}

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
jpath = os.path.join(out_dir, "step3_group_stats.json")
cpath = os.path.join(out_dir, "step3_group_stats.csv")
with open(jpath, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
g.reset_index().to_csv(cpath, index=False)

print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", os.path.abspath(jpath), os.path.abspath(cpath))

