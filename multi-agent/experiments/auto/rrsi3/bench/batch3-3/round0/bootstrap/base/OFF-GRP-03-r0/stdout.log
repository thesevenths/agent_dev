import pandas as pd, json, os

path = "offline_data/students.csv"
df = pd.read_csv(path)

out = {
    "file": path,
    "abs_path": os.path.abspath(path),
    "n_rows": len(df),
    "columns": list(df.columns),
    "missing": df.isna().sum().to_dict(),
    "dup_student_id": int(df["student_id"].duplicated().sum()),
    "study_hours": {"min": float(df.study_hours_per_week.min()), "max": float(df.study_hours_per_week.max()),
                    "mean": float(df.study_hours_per_week.mean())},
    "math_score": {"min": float(df.math_score.min()), "max": float(df.math_score.max()),
                   "mean": float(df.math_score.mean())},
    "dtypes": {c: str(t) for c, t in df.dtypes.items()},
}

# grouping: low <2.5, mid 2.5-4.5 (inclusive), high >4.5
def grp(x):
    if x < 2.5: return "low"
    if x <= 4.5: return "mid"
    return "high"
df["group"] = df.study_hours_per_week.map(grp)
g = df.groupby("group").math_score.agg(["count","mean","std","min","max"])
out["groups"] = {k: {m: (float(v) if m!="count" else int(v)) for m,v in row.items()} for k,row in g.iterrows()}
out["boundary_counts"] = {
    "eq_2.5": int((df.study_hours_per_week==2.5).sum()),
    "eq_4.5": int((df.study_hours_per_week==4.5).sum()),
}
out["gain_low_to_high"] = float(g.loc["high","mean"] - g.loc["low","mean"])
out["gain_low_to_mid"] = float(g.loc["mid","mean"] - g.loc["low","mean"])
out["gain_mid_to_high"] = float(g.loc["high","mean"] - g.loc["mid","mean"])
out["ratio_high_over_low"] = float(g.loc["high","mean"] / g.loc["low","mean"])

print(json.dumps(out, indent=2, ensure_ascii=False))

