import pandas as pd, json, os

path = "offline_data/students.csv"
df = pd.read_csv(path)

def grp(x):
    if x < 2.5: return "low"
    if x <= 4.5: return "mid"
    return "high"
df["group"] = df.study_hours_per_week.map(grp)

g = df.groupby("group").math_score.agg(["count","mean","std","min","max"])
g = g.reindex(["low","mid","high"])

# extra context: study hours mean per group, and gain metrics
sh = df.groupby("group").study_hours_per_week.agg(["mean","min","max"]).reindex(["low","mid","high"])

out = {}
for name in ["low","mid","high"]:
    out[name] = {
        "n": int(g.loc[name,"count"]),
        "mean": round(float(g.loc[name,"mean"]),4),
        "std": round(float(g.loc[name,"std"]),4),
        "min": int(g.loc[name,"min"]),
        "max": int(g.loc[name,"max"]),
        "sh_mean": round(float(sh.loc[name,"mean"]),4),
        "sh_min": float(sh.loc[name,"min"]),
        "sh_max": float(sh.loc[name,"max"]),
    }
out["overall"] = {"n": int(len(df)), "mean": round(float(df.math_score.mean()),4)}
out["gain_low_to_high"] = round(float(g.loc["high","mean"] - g.loc["low","mean"]),4)
out["gain_low_to_mid"] = round(float(g.loc["mid","mean"] - g.loc["low","mean"]),4)
out["gain_mid_to_high"] = round(float(g.loc["high","mean"] - g.loc["mid","mean"]),4)
out["ratio_high_over_low"] = round(float(g.loc["high","mean"] / g.loc["low","mean"]),4)
out["pct_gain_high_over_low"] = round(float((g.loc["high","mean"]-g.loc["low","mean"])/g.loc["low","mean"]*100),2)

print(json.dumps(out, indent=2, ensure_ascii=False))

```
