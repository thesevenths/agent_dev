import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]
last = r.iloc[30:]

res = {
    "as_of": "2026-10-25 07:38",
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": "W01-W30", "n": int(len(first)), "mean": float(first.mean()), "std_ddof1": float(first.std(ddof=1))},
    "last30": {"weeks": "W31-W60", "n": int(len(last)), "mean": float(last.mean()), "std_ddof1": float(last.std(ddof=1))},
    "overall": {"n": int(len(r)), "mean": float(r.mean()), "std_ddof1": float(r.std(ddof=1))},
}
res["diff_mean_last_minus_first"] = res["last30"]["mean"] - res["first30"]["mean"]
res["diff_mean_first_minus_last"] = res["first30"]["mean"] - res["last30"]["mean"]
thr = res["overall"]["mean"] - 2*res["overall"]["std_ddof1"]
res["threshold_mean_minus_2std"] = float(thr)
below = df[r < thr]
res["count_below_mean_minus_2std"] = int(len(below))
res["weeks_below"] = below["week"].tolist()
res["values_below"] = below["retention_d7"].tolist()

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

