import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-STAT-02-r4\_sandbox"
out_dir = os.path.join(base, "tmp")
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))

m = df["math_score"]; r = df["reading_score"]
n = len(df)

def stats(s):
    return {
        "n": int(s.count()),
        "mean": float(s.mean()),
        "std_sample": float(s.std(ddof=1)),
        "std_pop": float(s.std(ddof=0)),
        "median": float(s.median()),
        "min": float(s.min()),
        "max": float(s.max()),
    }

sm, sr = stats(m), stats(r)
pearson = float(m.corr(r, method="pearson"))
cv_m = sm["std_sample"] / sm["mean"]
cv_r = sr["std_sample"] / sr["mean"]

result = {
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-25 09:29",
    "n_rows": n,
    "math_score": sm,
    "reading_score": sr,
    "pearson_r": pearson,
    "cv_math": cv_m,
    "cv_reading": cv_r,
    "higher_cv": "math_score" if cv_m > cv_r else "reading_score",
    "note": "std uses sample std (ddof=1); CV = std_sample / mean",
}
out = os.path.join(out_dir, "step1_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
