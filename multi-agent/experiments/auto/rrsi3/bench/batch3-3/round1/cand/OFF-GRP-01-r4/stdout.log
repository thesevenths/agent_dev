import pandas as pd, json, math

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-01-r4\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-01-r4\_sandbox\tmp"

df = pd.read_csv(src)
g = df.groupby('tutoring')['math_score'].agg(n='count', mean='mean', std=lambda s: s.std(ddof=1),
                                             min='min', max='max', median='median', sum='sum')
n0, n1 = int(g.loc[0,'n']), int(g.loc[1,'n'])
m0, m1 = g.loc[0,'mean'], g.loc[1,'mean']
s0, s1 = g.loc[0,'std'], g.loc[1,'std']
# pooled std (Welch-style df)
sp = math.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
diff = m1 - m0
d = diff / sp
# effect size classification (Cohen conventions)
ad = abs(d)
label = "小效应 (small)" if ad < 0.5 else ("中效应 (medium)" if ad < 0.8 else "大效应 (large)")

res = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "missing_math_score": int(df['math_score'].isna().sum()),
  "groups": {
    "0": {"n": n0, "mean": round(m0,4), "std_sample_ddof1": round(s0,4), "median": float(g.loc[0,'median']), "min": int(g.loc[0,'min']), "max": int(g.loc[0,'max']), "sum": int(g.loc[0,'sum'])},
    "1": {"n": n1, "mean": round(m1,4), "std_sample_ddof1": round(s1,4), "median": float(g.loc[1,'median']), "min": int(g.loc[1,'min']), "max": int(g.loc[1,'max']), "sum": int(g.loc[1,'sum'])},
  },
  "pooled_std": round(sp,4),
  "mean_diff_tutoring1_minus_0": round(diff,4),
  "cohens_d": round(d,4),
  "effect_size_label": label,
  "as_of": "2026-10-26 04:35",
}
with open(out_dir + r"\group_stats.json", "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

# also a CSV of group stats
out = pd.DataFrame([
    {"tutoring": 0, "n": n0, "mean": round(m0,4), "std": round(s0,4), "median": g.loc[0,'median'], "min": int(g.loc[0,'min']), "max": int(g.loc[0,'max'])},
    {"tutoring": 1, "n": n1, "mean": round(m1,4), "std": round(s1,4), "median": g.loc[1,'median'], "min": int(g.loc[1,'min']), "max": int(g.loc[1,'max'])},
])
out.to_csv(out_dir + r"\group_stats.csv", index=False, encoding="utf-8-sig")
print(json.dumps(res, ensure_ascii=False, indent=2))

```
