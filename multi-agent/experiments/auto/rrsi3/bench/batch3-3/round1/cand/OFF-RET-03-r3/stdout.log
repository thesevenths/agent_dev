import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r3\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r3\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)

# Correlations (Pearson)
corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

res = {
    "n_rows": n,
    "retention_d7_median": med,
    "corr_retention_arpu": corr_arpu,
    "corr_retention_churn": corr_churn,
    "group_high": {
        "definition": "retention_d7 > median",
        "n_weeks": len(hi),
        "arpu_usd_mean": hi["arpu_usd"].mean(),
        "cohort_size_sum": int(hi["cohort_size"].sum()),
    },
    "group_low": {
        "definition": "retention_d7 <= median",
        "n_weeks": len(lo),
        "arpu_usd_mean": lo["arpu_usd"].mean(),
        "cohort_size_sum": int(lo["cohort_size"].sum()),
    },
}
print(json.dumps(res, indent=2))

# Save intermediate results CSV
rows = [
