```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-STAT-02-r5\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
m = df["math_score"]; r = df["reading_score"]
n = len(df)

def stats(s):
    mean = s.mean()
    std = s.std(ddof=1)  # sample std
    med = s.median()
    cv = std / mean
    return dict(n=int(s.count()), mean=float(mean), std_sample=float(std),
                std_pop=float(s.std(ddof=0)), median=float(med), cv=float(cv),
                min=int(s.min()), max=int(s.max()))

sm, sr = stats(m), stats(r)
pearson = float(m.corr(r, method="pearson"))

result = {
    "source_file": "offline_data/students.csv",
    "rows_total": int(n),
    "rows_used": int(n),
    "missing": {"math_score": 0, "reading_score": 0},
    "math_score": sm,
    "reading_score": sr,
    "pearson_r": pearson,
    "cv_comparison": {
        "larger_cv_column": "math_score" if sm["cv"] > sr["cv"] else "reading_score",
        "cv_ratio": float(sm["cv"] / sr["cv"]),
    },
    "notes": "std_sample uses ddof=1 (sample standard deviation); std_pop uses ddof=0.",
}
out = os.path.join(out_dir, "stats_results.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
