```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-STAT-02-r5\_sandbox"
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
print(df.head())
print(df.shape)
print(df.dtypes)

cols = ["math_score", "reading_score"]
res = {}
for c in cols:
    s = df[c].dropna()
    res[c] = {
        "n": int(s.count()),
        "mean": float(s.mean()),
        "std_sample": float(s.std(ddof=1)),
        "std_pop": float(s.std(ddof=0)),
        "median": float(s.median()),
        "min": float(s.min()),
        "max": float(s.max()),
    }
    res[c]["cv_sample"] = res[c]["std_sample"] / res[c]["mean"]
    res[c]["cv_pop"] = res[c]["std_pop"] / res[c]["mean"]

res["pearson"] = float(df[cols].corr(method="pearson").iloc[0,1])
res["n_rows_total"] = int(len(df))
res["n_missing_math"] = int(df["math_score"].isna().sum())
res["n_missing_reading"] = int(df["reading_score"].isna().sum())

out = os.path.join(base, "tmp", "stats_results.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

