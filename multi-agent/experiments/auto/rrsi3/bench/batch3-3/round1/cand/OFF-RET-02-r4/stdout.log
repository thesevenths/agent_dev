```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r4\_sandbox\tmp"

df = pd.read_csv(path)
df['wk'] = df['week'].astype(str).str.replace('W','',regex=False).astype(int)
sel = df[(df['wk']>=30)&(df['wk']<=43)].copy().reset_index(drop=True)
assert len(sel)==14

pre  = sel[sel['wk']<=36]   # W30-W36
post = sel[sel['wk']>=37]   # W37-W43
assert len(pre)==7 and len(post)==7

cols = ['retention_d7','churn_rate','arpu_usd']

# group means
means = pd.DataFrame({
    'group': ['W30-W36','W37-W43'],
    'n': [len(pre), len(post)],
    'retention_d7_mean': [pre['retention_d7'].mean(), post['retention_d7'].mean()],
    'churn_rate_mean': [pre['churn_rate'].mean(), post['churn_rate'].mean()],
    'arpu_usd_mean': [pre['arpu_usd'].mean(), post['arpu_usd'].mean()],
})
print(means.to_string(index=False))

# diffs
for c in cols:
    a, b = pre[c].mean(), post[c].mean()
    print(f"{c}: pre={a:.6f} post={b:.6f} diff={b-a:+.6f} rel={(b-a)/a*100:+.2f}%")

# per-week table with group label and week-over-week delta
per = sel[['week','wk','retention_d7','churn_rate','arpu_usd']].copy()
per['group'] = per['wk'].apply(lambda w: 'W30-W36' if w<=36 else 'W37-W43')
per['retention_d7_wow'] = per['retention_d7'].diff()
per['churn_rate_wow'] = per['churn_rate'].diff()
per['arpu_usd_wow'] = per['arpu_usd'].diff()
print(per.to_string(index=False))

# breakpoint: largest single-week drop in retention_d7 / largest jump in churn_rate
print("\nMax retention_d7 WoW drop:", per.loc[per['retention_d7_wow'].idxmin(), 'week'], per['retention_d7_wow'].min())
print("Max churn_rate WoW jump:", per.loc[per['churn_rate_wow'].idxmax(), 'week'], per['churn_rate_wow'].max())

# save intermediate CSVs
per.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
print("\nSaved step2_per_week.csv and step2_group_means.csv")

