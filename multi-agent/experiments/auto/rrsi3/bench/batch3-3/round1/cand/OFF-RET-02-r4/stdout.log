```python
import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r4\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# --- Group means ---
g1 = df[(df.week >= "W30") & (df.week <= "W36")]
g2 = df[(df.week >= "W37") & (df.week <= "W43")]
print("g1 rows:", len(g1), "g2 rows:", len(g2))

means = pd.DataFrame({
    "group": ["W30-W36", "W37-W43"],
    "n": [len(g1), len(g2)],
    "retention_d7_mean": [g1.retention_d7.mean(), g2.retention_d7.mean()],
    "churn_rate_mean": [g1.churn_rate.mean(), g2.churn_rate.mean()],
    "arpu_usd_mean": [g1.arpu_usd.mean(), g2.arpu_usd.mean()],
})
print(means.to_string(index=False))

# --- Deltas ---
d_ret = g2.retention_d7.mean() - g1.retention_d7.mean()
d_churn = g2.churn_rate.mean() - g1.churn_rate.mean()
d_arpu = g2.arpu_usd.mean() - g1.arpu_usd.mean()
print("\nDeltas (W37-W43 minus W30-W36):")
print(f"retention_d7: {d_ret:+.4f}  ({d_ret/g1.retention_d7.mean()*100:+.2f}%)")
print(f"churn_rate:   {d_churn:+.4f}  ({d_churn/g1.churn_rate.mean()*100:+.2f}%)")
print(f"arpu_usd:     {d_arpu:+.4f}  ({d_arpu/g1.arpu_usd.mean()*100:+.2f}%)")

# --- Per-week values W28-W45 with week-over-week deltas ---
sub = df[(df.week >= "W28") & (df.week <= "W45")].copy().reset_index(drop=True)
for m in metrics:
    sub[f"{m}_wow"] = sub[m].diff()
print("\nPer-week W28-W45:")
print(sub.to_string(index=False))

# --- Breakpoint detection: largest WoW drop in retention / jump in churn ---
print("\nLargest WoW retention_d7 drop in W28-W45:")
print(sub.loc[sub.retention_d7_wow.idxmin(), ["week", "retention_d7", "retention_d7_wow"]])
print("Largest WoW churn_rate jump in W28-W45:")
print(sub.loc[sub.churn_rate_wow.idxmax(), ["week", "churn_rate", "churn_rate_wow"]])
print("Largest WoW arpu_usd drop in W28-W45:")
print(sub.loc[sub.arpu_usd_wow.idxmin(), ["week", "arpu_usd", "arpu_usd_wow"]])

# --- Save intermediate CSVs ---
means_path = f"{out_dir}\\step2_group_means.csv"
means.to_csv(means_path, index=False)

sub_path = f"{out_dir}\\step2_per_week_w28_w45.csv"
sub.to_csv(sub_path, index=False)

# deltas file
deltas = pd.DataFrame({
    "metric": ["retention_d7", "churn_rate", "arpu_usd"],
    "W30-W36_mean": [g1[m].mean() for m in metrics],
    "W37-W43_mean": [g2[m].mean() for m in metrics],
    "delta_abs": [d_ret, d_churn, d_arpu],
    "delta_pct": [d_ret/g1.retention_d7.mean()*100, d_churn/g1.churn_rate.mean()*100, d_arpu/g1.arpu_usd.mean()*100],
})
deltas_path = f"{out_dir}\\step2_deltas.csv"
deltas.to_csv(deltas_path, index=False)
print("\nSaved:", means_path, sub_path, deltas_path)
print(deltas.to_string(index=False))

