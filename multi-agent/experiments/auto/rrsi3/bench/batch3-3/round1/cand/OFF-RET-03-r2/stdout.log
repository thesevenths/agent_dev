```python
import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r2\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)
med = df["retention_d7"].median()

corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])
# also spearman for robustness
from scipy.stats import pearsonr, spearmanr
pr_arpu, p_arpu = pearsonr(df["retention_d7"], df["arpu_usd"])
pr_churn, p_churn = pearsonr(df["retention_d7"], df["churn_rate"])
sr_arpu, sp_arpu = spearmanr(df["retention_d7"], df["arpu_usd"])
sr_churn, sp_churn = spearmanr(df["retention_d7"], df["churn_rate"])

hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = []
for name, g in [("high_retention", hi), ("low_retention", lo)]:
    rows.append({
        "group": name,
        "n_weeks": len(g),
        "retention_d7_min": g["retention_d7"].min(),
        "retention_d7_max": g["retention_d7"].max(),
        "arpu_usd_mean": g["arpu_usd"].mean(),
        "arpu_usd_min": g["arpu_usd"].min(),
        "arpu_usd_max": g["arpu_usd"].max(),
        "churn_rate_mean": g["churn_rate"].mean(),
        "cohort_size_sum": int(g["cohort_size"].sum()),
        "cohort_size_mean": g["cohort_size"].mean(),
    })

grp = pd.DataFrame(rows)
grp.to_csv(f"{out_dir}\\step2_group_stats.csv", index=False)

res = {
    "n_rows": n,
    "retention_d7_median": med,
    "pearson_retention_arpu": {"r": corr_arpu, "p": p_arpu},
    "pearson_retention_churn": {"r": corr_churn, "p": p_churn},
    "spearman_retention_arpu": {"rho": sr_arpu, "p": sp_arpu},
    "spearman_retention_churn": {"rho": sr_churn, "p": sp_churn},
    "groups": rows,
    "arpu_ratio_hi_over_lo": hi["arpu_usd"].mean() / lo["arpu_usd"].mean(),
    "churn_ratio_hi_over_lo": hi["churn_rate"].mean() / lo["churn_rate"].mean(),
}
print(json.dumps(res, ensure_ascii=False, indent=2))

```
