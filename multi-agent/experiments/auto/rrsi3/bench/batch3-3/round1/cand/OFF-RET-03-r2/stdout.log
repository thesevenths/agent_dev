import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/app_metrics.csv')
n = len(df)

r_arpu = df['retention_d7'].corr(df['arpu_usd'])
r_churn = df['retention_d7'].corr(df['churn_rate'])
r_spearman_arpu = df['retention_d7'].corr(df['arpu_usd'], method='spearman')
r_spearman_churn = df['retention_d7'].corr(df['churn_rate'], method='spearman')

med = df['retention_d7'].median()
hi = df[df['retention_d7'] > med]
lo = df[df['retention_d7'] <= med]

res = pd.DataFrame([
    {'metric': 'pearson_retention_d7_vs_arpu_usd', 'value': r_arpu, 'n': n},
    {'metric': 'pearson_retention_d7_vs_churn_rate', 'value': r_churn, 'n': n},
    {'metric': 'spearman_retention_d7_vs_arpu_usd', 'value': r_spearman_arpu, 'n': n},
    {'metric': 'spearman_retention_d7_vs_churn_rate', 'value': r_spearman_churn, 'n': n},
    {'metric': 'retention_d7_median', 'value': med, 'n': n},
    {'metric': 'group_high_rows', 'value': len(hi), 'n': n},
    {'metric': 'group_low_rows', 'value': len(lo), 'n': n},
    {'metric': 'group_high_arpu_mean', 'value': hi['arpu_usd'].mean(), 'n': len(hi)},
    {'metric': 'group_low_arpu_mean', 'value': lo['arpu_usd'].mean(), 'n': len(lo)},
    {'metric': 'group_high_cohort_sum', 'value': hi['cohort_size'].sum(), 'n': len(hi)},
    {'metric': 'group_low_cohort_sum', 'value': lo['cohort_size'].sum(), 'n': len(lo)},
    {'metric': 'group_high_churn_mean', 'value': hi['churn_rate'].mean(), 'n': len(hi)},
    {'metric': 'group_low_churn_mean', 'value': lo['churn_rate'].mean(), 'n': len(lo)},
    {'metric': 'arpu_ratio_high_over_low', 'value': hi['arpu_usd'].mean()/lo['arpu_usd'].mean(), 'n': n},
])
out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r2\_sandbox\tmp\step2_results.csv'
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

```
