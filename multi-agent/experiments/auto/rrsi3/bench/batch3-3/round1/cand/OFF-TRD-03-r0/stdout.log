import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

info = {
    "file": os.path.abspath(path),
    "columns": list(df.columns),
    "dtypes": {c: str(t) for c, t in df.dtypes.items()},
    "n_rows": len(df),
    "n_regions": df["region"].nunique(),
    "regions": sorted(df["region"].unique().tolist()),
    "months": [df["month"].min(), df["month"].max()],
    "n_months": df["month"].nunique(),
    "product_lines": sorted(df["product_line"].unique().tolist()),
    "nulls": int(df.isna().sum().sum()),
    "neg_revenue": int((df["revenue"] < 0).sum()),
    "rows_per_region": df.groupby("region").size().to_dict(),
    "rows_per_month": df.groupby("month").size().to_dict(),
}

# quick aggregates for downstream
rev = df.groupby("region")["revenue"].sum()
total = rev.sum()
monthly = df.groupby(["region", "month"])["revenue"].sum().unstack()
top_region = rev.idxmax()
peak = monthly.loc[top_region].idxmax()
info["region_totals"] = rev.to_dict()
info["grand_total"] = float(total)
info["region_shares"] = (rev / total * 100).round(4).to_dict()
info["monthly_avg"] = (rev / 24).round(2).to_dict()
info["top_region"] = top_region
info["top_region_peak_month"] = peak
info["top_region_peak_value"] = float(monthly.loc[top_region, peak])
info["monthly_totals"] = monthly.round(2).to_dict()

out = os.path.join("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch3-3\\round1\\cand\\OFF-TRD-03-r0\\_sandbox\\tmp", "step1_csv_validation.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(info, f, ensure_ascii=False, indent=2)
print(json.dumps(info, ensure_ascii=False, indent=2))
print("SAVED:", out)

```
