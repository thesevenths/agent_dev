import pandas as pd, os

path = "E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch3-3/round1/cand/OFF-TRD-03-r0/_sandbox/offline_data/regional_sales.csv"
df = pd.read_csv(path)

rev = df.groupby("region")["revenue"].sum()
total = rev.sum()
share = rev / total * 100
avg = rev / 24
monthly = df.groupby(["region", "month"])["revenue"].sum().unstack()
top = rev.idxmax()
peak_m = monthly.loc[top].idxmax()
peak_v = monthly.loc[top, peak_m]

# anomaly check: E 2025-03
e_mar = df[(df.region=="E") & (df.month=="2025-03")]
print(e_mar)
print(rev, total, share.round(4), avg.round(2))
print("top:", top, "peak:", peak_m, peak_v)
print("E 2025-03 total:", e_mar.revenue.sum())
print("E 2025-03 Hardware units:", e_mar[e_mar.product_line=="Hardware"].units.iloc[0])
# typical E hardware units
hw = df[(df.region=="E") & (df.product_line=="Hardware")].units
print("E Hardware units mean/min/max:", hw.mean(), hw.min(), hw.max())
# top region vs runner-up gap
srt = rev.sort_values(ascending=False)
print(srt)
print("gap E-S:", srt.iloc[0]-srt.iloc[1])
# monthly totals for context
print(monthly.round(2))

