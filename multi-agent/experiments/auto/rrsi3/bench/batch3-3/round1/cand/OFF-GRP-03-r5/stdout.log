import pandas as pd
from pathlib import Path

csv_path = Path("offline_data/students.csv")
df = pd.read_csv(csv_path)

print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("missing:\n", df.isna().sum())
print("dup student_id:", df["student_id"].duplicated().sum())
print("study_hours range:", df["study_hours_per_week"].min(), df["study_hours_per_week"].max())
print("math_score range:", df["math_score"].min(), df["math_score"].max())

# group boundaries: low <2.5, mid 2.5-4.5, high >4.5
def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"
df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group")["math_score"].agg(["count","mean","std","min","max"])
print(g)
print("boundary check: values ==2.5:", (df.study_hours_per_week==2.5).sum(), "==4.5:", (df.study_hours_per_week==4.5).sum())
print("gain high-low:", g.loc["high","mean"]-g.loc["low","mean"])
print("abs path:", csv_path.resolve())

