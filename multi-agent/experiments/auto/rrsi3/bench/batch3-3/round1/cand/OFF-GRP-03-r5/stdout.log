import pandas as pd, json
from pathlib import Path

csv_path = Path("offline_data/students.csv")
df = pd.read_csv(csv_path)

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"
df["group"] = df["study_hours_per_week"].apply(grp)

rows = []
for name in ["low","mid","high"]:
    sub = df[df.group==name]
    rows.append({
        "group": name,
        "n": int(len(sub)),
        "mean": round(float(sub.math_score.mean()), 3),
        "std": round(float(sub.math_score.std(ddof=1)), 3),
        "min": int(sub.math_score.min()),
        "max": int(sub.math_score.max()),
        "median": float(sub.math_score.median()),
        "hours_min": float(sub.study_hours_per_week.min()),
        "hours_max": float(sub.study_hours_per_week.max()),
    })
low = next(r for r in rows if r.group=="low")
high = next(r for r in rows if r.group=="high")
mid = next(r for r in rows if r.group=="mid")
gain = round(high["mean"]-low["mean"],3)
gain_pct = round(gain/low["mean"]*100,2)
gain_mid = round(mid["mean"]-low["mean"],3)
gain_high_mid = round(high["mean"]-mid["mean"],3)

result = {"rows": rows, "gain_high_minus_low": gain, "gain_pct": gain_pct,
          "gain_mid_minus_low": gain_mid, "gain_high_minus_mid": gain_high_mid,
          "total_n": int(len(df))}
out = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-03-r5\_sandbox\tmp\step2_group_stats.json")
out.write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8")
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
