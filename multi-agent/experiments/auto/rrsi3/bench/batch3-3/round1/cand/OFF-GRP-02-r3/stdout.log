import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-02-r3\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-02-r3\_sandbox\tmp\step2_crosstab_metrics.csv"

df = pd.read_csv(path)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g['mean_reading_score'] = g['mean'].round(4)
g = g[['grade','region','count','mean_reading_score']]
g = g.sort_values(['grade','region']).reset_index(drop=True)
g.to_csv(out, index=False)
print(g.to_string(index=False))

hi = g.loc[g['mean_reading_score'].idxmax()]
lo = g.loc[g['mean_reading_score'].idxmin()]
print("\nMAX:", hi.to_dict())
print("MIN:", lo.to_dict())
print("diff:", round(hi['mean_reading_score']-lo['mean_reading_score'],4))
print("ratio:", round(hi['mean_reading_score']/lo['mean_reading_score'],4))
print("total rows:", g['count'].sum())

```
