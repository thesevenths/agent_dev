import pandas as pd

path = "offline_data/app_metrics.csv"
df = pd.read_csv(path)
r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]
print("first30 mean:", first30.mean(), "std(ddof=1):", first30.std(), "std(ddof=0):", first30.std(ddof=0))
print("last30 mean:", last30.mean(), "std(ddof=1):", last30.std(), "std(ddof=0):", last30.std(ddof=0))
print("diff (last-first):", last30.mean() - first30.mean())
print("overall mean:", r.mean(), "std(ddof=1):", r.std())
thr = r.mean() - 2*r.std()
print("threshold:", thr)
low = r[r < thr]
print("count below mean-2std:", len(low))
print(low)
print("week labels:", df["week"].iloc[:30].tolist()[:3], "...", df["week"].iloc[30:].tolist()[-3:])

