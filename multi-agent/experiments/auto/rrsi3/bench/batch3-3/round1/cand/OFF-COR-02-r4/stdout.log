t1,p1 = stats.ttest_ind(hi.math_score, lo.math_score)
t2,p2 = stats.ttest_ind(hi.reading_score, lo.reading_score)
print("math t,p:", t1, p1)
print("read t,p:", t2, p2)
print("screen mean hi/lo:", hi.screen_hours_per_day.mean(), lo.screen_hours_per_day.mean())

```
