```python
import pandas as pd
df = pd.read_csv("offline_data/students.csv")
s = df.screen_hours_per_day
r_math = s.corr(df.math_score, method="pearson")
r_read = s.corr(df.reading_score, method="pearson")
n = len(df)
import math
# p-values via t-statistic
from scipy import stats
t1 = r_math*math.sqrt(n-2)/math.sqrt(1-r_math**2)
t2 = r_read*math.sqrt(n-2)/math.sqrt(1-r_read**2)
p1 = 2*stats.t.sf(abs(t1), n-2)
p2 = 2*stats.t.sf(abs(t2), n-2)
print("n =", n)
print("r(screen, math) =", r_math, "t =", t1, "p =", p1)
print("r(screen, reading) =", r_read, "t =", t2, "p =", p2)

```
