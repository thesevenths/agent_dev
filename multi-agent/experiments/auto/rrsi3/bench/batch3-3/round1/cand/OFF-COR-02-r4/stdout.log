print(g)
hi = df[df.screen_hours_per_day>5]; lo = df[df.screen_hours_per_day<=5]
print("n_hi", len(hi), "n_lo", len(lo))
print("math mean hi/lo:", hi.math_score.mean(), lo.math_score.mean(), "diff:", hi.math_score.mean()-lo.math_score.mean())
print("read mean hi/lo:", hi.reading_score.mean(), lo.reading_score.mean(), "diff:", hi.reading_score.mean()-lo.reading_score.mean())
# t-tests
from scipy import stats
t1,p1 = stats.ttest_ind(hi.math_score, lo.math_score)
t2,p2 = stats.ttest_ind(hi.reading_score, lo.reading_score)
print("math t,p:", t1, p1)
print("read t,p:", t2, p2)
print("screen mean hi/lo:", hi.screen_hours_per_day.mean(), lo.screen_hours_per_day.mean())

