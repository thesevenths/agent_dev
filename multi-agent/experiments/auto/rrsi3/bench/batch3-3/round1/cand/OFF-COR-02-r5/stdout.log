import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

# also Spearman for robustness
from scipy import stats
p_math, pv_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"])
p_read, pv_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"])
s_math, sv_math = stats.spearmanr(df["screen_hours_per_day"], df["math_score"])
s_read, sv_read = stats.spearmanr(df["screen_hours_per_day"], df["reading_score"])

print("n =", n)
print("pearson screen~math:   r=%.6f p=%.3e" % (r_math, pv_math))
print("pearson screen~reading:r=%.6f p=%.3e" % (r_read, pv_read))
print("spearman screen~math:  r=%.6f p=%.3e" % (s_math, sv_math))
