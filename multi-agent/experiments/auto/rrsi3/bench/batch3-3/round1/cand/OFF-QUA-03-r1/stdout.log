import pandas as pd
BASE = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-QUA-03-r1\_sandbox\offline_data"
df = pd.read_csv(BASE + r"\anomaly_ratios.csv")
print("regions:", sorted(df["region"].unique()))
print("n_regions:", df["region"].nunique())
print("n_rows:", len(df))
print("months:", df["month"].min(), df["month"].max())
print("valid ratios:", df["ratio"].notna().sum())

# E x Accessory return rate history
e_acc = df[(df["region"]=="E") & (df["product_line"]=="Accessory")].sort_values("month").copy()
e_acc["rr"] = e_acc["returns"]/e_acc["units"]*100
print("\nE x Accessory monthly rr:")
print(e_acc[["month","units","returns","rr"]].to_string(index=False))

# E x Hardware rr history
e_hw = df[(df["region"]=="E") & (df["product_line"]=="Hardware")].sort_values("month").copy()
e_hw["rr"] = e_hw["returns"]/e_hw["units"]*100
print("\nE x Hardware rr:")
print(e_hw[["month","units","returns","rr"]].to_string(index=False))

# E x Service rr history
e_sv = df[(df["region"]=="E") & (df["product_line"]=="Service")].sort_values("month").copy()
e_sv["rr"] = e_sv["returns"]/e_sv["units"]*100
print("\nE x Service rr:")
print(e_sv[["month","units","returns","rr"]].to_string(index=False))

# E total units by month
e = df[df["region"]=="E"]
e_tot = e.groupby("month")["units"].sum().sort_index()
print("\nE total units by month:")
print(e_tot.to_string())
print("\nE 2025-03 total:", e_tot["2025-03"])
prior = e_tot[e_tot.index < "2025-03"]
print("E prior mean:", prior.mean(), "mult:", e_tot["2025-03"]/prior.mean())

# other regions max ratio
others = df[(df["region"]!="E") & df["ratio"].notna()]
om = others.loc[others["ratio"].idxmax()]
print("\nother max:", om["region"], om["product_line"], om["month"], om["ratio"])

# E x Accessory 2024 range
ea24 = e_acc[e_acc["month"] < "2025-01"]["units"]
print("\nE x Accessory 2024 units range:", ea24.min(), ea24.max())
# E x Accessory 2025-04
print("E x Accessory 2025-04 units:", e_acc[e_acc["month"]=="2025-04"]["units"].values)

```
