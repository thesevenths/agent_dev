# group means
means = w.groupby('group')[metrics].mean().reset_index()
print(means.to_string(index=False))

# differences (after - before) and relative %
m1 = means[means.group=='W30-W36'].iloc[0]
m2 = means[means.group=='W37-W43'].iloc[0]
diff = pd.DataFrame({
    'metric': metrics,
    'W30-W36_mean': [m1[m] for m in metrics],
    'W37-W43_mean': [m2[m] for m in metrics],
    'diff_after_minus_before': [m2[m]-m1[m] for m in metrics],
    'rel_change_pct': [(m2[m]-m1[m])/m1[m]*100 for m in metrics],
})
print(diff.to_string(index=False))

# breakpoint pinpoint: week-over-week deltas within W30-W43
pw = per_week.set_index('week')[metrics]
deltas = pw.diff()
print("\nWoW deltas:\n", deltas.to_string())

# save per-week CSV
per_week.to_csv(f'{out}/step2_per_week_metrics.csv', index=False)
# save group means CSV
means.to_csv(f'{out}/step2_group_means.csv', index=False)
diff.to_csv(f'{out}/step2_group_diff.csv', index=False)
print("\nSaved 3 CSVs to", out)

