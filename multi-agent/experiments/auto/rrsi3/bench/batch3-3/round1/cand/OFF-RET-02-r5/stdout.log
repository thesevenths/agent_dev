import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df["week"].str.match(r"W(3[0-9]|4[0-3])$")].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

means = sub.groupby("group")[metrics].mean()
print(means)

# per-week diffs to find breakpoint week (largest shift)
sub = sub.sort_values("week").reset_index(drop=True)
diffs = sub[metrics].diff()
print(diffs)

# largest absolute relative shift per week
rel = diffs / sub[metrics].shift(1)
print(rel)

# combined score: sum of abs relative shifts across 3 metrics
