import pandas as pd

src = 'E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch3-3/round1/cand/OFF-RET-02-r5/_sandbox/offline_data/app_metrics.csv'
out = 'E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch3-3/round1/cand/OFF-RET-02-r5/_sandbox/tmp'
df = pd.read_csv(src)

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
w = df[(df.week >= 'W30') & (df.week <= 'W43')].copy()
w['group'] = w.week.apply(lambda x: 'W30-W36' if x <= 'W36' else 'W37-W43')

# per-week table
