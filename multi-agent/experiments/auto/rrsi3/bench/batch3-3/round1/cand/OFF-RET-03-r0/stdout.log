import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r0\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)

# Correlations (Pearson)
corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] >= med]
low = df[df["retention_d7"] < med]

groups = pd.DataFrame([
    {"group": "high_retention (retention_d7 >= median)", "n_rows": len(high),
     "retention_d7_min": high["retention_d7"].min(), "retention_d7_max": high["retention_d7"].max(),
     "arpu_usd_mean": high["arpu_usd"].mean(), "cohort_size_sum": int(high["cohort_size"].sum())},
    {"group": "low_retention (retention_d7 < median)", "n_rows": len(low),
     "retention_d7_min": low["retention_d7"].min(), "retention_d7_max": low["retention_d7"].max(),
     "arpu_usd_mean": low["arpu_usd"].mean(), "cohort_size_sum": int(low["cohort_size"].sum())},
])
groups.to_csv(f"{out_dir}\\step2_group_stats.csv", index=False)

res = {
    "n_rows": n,
    "retention_d7_median": float(med),
    "pearson_retention_d7_vs_arpu_usd": float(corr_arpu),
    "pearson_retention_d7_vs_churn_rate": float(corr_churn),
    "groups": groups.to_dict(orient="records"),
    "arpu_gap_high_minus_low": float(high["arpu_usd"].mean() - low["arpu_usd"].mean()),
}
print(json.dumps(res, indent=2))

