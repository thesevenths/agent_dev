import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
w30_36 = [f"W{i:02d}" for i in range(30, 37)]
w37_43 = [f"W{i:02d}" for i in range(37, 44)]

a = df[df["week"].isin(w30_36)].sort_values("week")
b = df[df["week"].isin(w37_43)].sort_values("week")

# Group means
means = pd.DataFrame({
    "group": ["W30-W36", "W37-W43"],
    "n": [len(a), len(b)],
    "retention_d7_mean": [a["retention_d7"].mean(), b["retention_d7"].mean()],
    "churn_rate_mean": [a["churn_rate"].mean(), b["churn_rate"].mean()],
    "arpu_usd_mean": [a["arpu_usd"].mean(), b["arpu_usd"].mean()],
})

# Absolute & relative differences (after - before)
diff = pd.DataFrame({
    "metric": metrics,
    "W30-W36_mean": [a[m].mean() for m in metrics],
    "W37-W43_mean": [b[m].mean() for m in metrics],
    "abs_diff": [b[m].mean() - a[m].mean() for m in metrics],
    "rel_diff_pct": [(b[m].mean() - a[m].mean()) / a[m].mean() * 100 for m in metrics],
})

# Per-week values W29-W44 to pinpoint breakpoint (include W29 & W44 as context)
ctx = df[df["week"].isin([f"W{i:02d}" for i in range(29, 45)])].sort_values("week")

print("=== GROUP MEANS ===")
print(means.to_string(index=False))
print("\n=== DIFFS ===")
print(diff.to_string(index=False))
print("\n=== PER-WEEK W29-W44 ===")
print(ctx[["week"] + metrics].to_string(index=False))

# Save intermediate results
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r3\_sandbox\tmp\step2_breakpoint_results.csv"
with open(out, "w", encoding="utf-8", newline="") as f:
    f.write("# SECTION: group_means\n")
    means.to_csv(f, index=False)
    f.write("\n# SECTION: diffs\n")
    diff.to_csv(f, index=False)
    f.write("\n# SECTION: per_week_W29_W44\n")
    ctx[["week"] + metrics].to_csv(f, index=False)
print("\nsaved:", out)

