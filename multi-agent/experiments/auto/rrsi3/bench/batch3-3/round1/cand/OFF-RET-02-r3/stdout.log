import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r3\_sandbox\tmp"

df = pd.read_csv(path)
sub = df[df['week'].isin([f"W{i}" for i in range(30, 44)])].sort_values('week').reset_index(drop=True)

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
sub['group'] = np.where(sub['week'].isin([f"W{i}" for i in range(30, 37)]), 'W30-W36', 'W37-W43')

# Group means
g = sub.groupby('group')[metrics].agg(['mean', 'std', 'min', 'max', 'count'])
print(g)

# Deltas
m1 = sub[sub['group']=='W30-W36'][metrics].mean()
m2 = sub[sub['group']=='W37-W43'][metrics].mean()
delta = m2 - m1
pct = delta / m1 * 100
print("\nDelta (W37-W43 - W30-W36):")
print(pd.DataFrame({'mean_W30_36': m1, 'mean_W37_43': m2, 'delta': delta, 'delta_pct': pct}))

# Per-week: locate breakpoint via week-over-week change
sub['wow_ret'] = sub['retention_d7'].diff()
sub['wow_churn'] = sub['churn_rate'].diff()
sub['wow_arpu'] = sub['arpu_usd'].diff()
print("\nWeek-over-week changes:")
print(sub[['week','retention_d7','wow_ret','churn_rate','wow_churn','arpu_usd','wow_arpu']].to_string(index=False))

# Largest single-week drop in retention / jump in churn
print("\nMax WoW retention drop:", sub.loc[sub['wow_ret'].idxmin(), ['week','wow_ret']].to_dict())
print("Max WoW churn jump:", sub.loc[sub['wow_churn'].idxmax(), ['week','wow_churn']].to_dict())
print("Max WoW arpu drop:", sub.loc[sub['wow_arpu'].idxmin(), ['week','wow_arpu']].to_dict())

# Save intermediate results
# 1) per-week detail with group labels
perweek = sub[['week','group','cohort_size','dau','retention_d7','churn_rate','arpu_usd','support_tickets','wow_ret','wow_churn','wow_arpu']]
perweek_path = f"{out_dir}\\step2_perweek_detail.csv"
perweek.to_csv(perweek_path, index=False)

# 2) group summary
summary = pd.DataFrame({
    'metric': metrics,
    'mean_W30_W36': [m1[m] for m in metrics],
    'std_W30_W36': [sub[sub['group']=='W30-W36'][m].std() for m in metrics],
    'n_W30_W36': 7,
    'mean_W37_W43': [m2[m] for m in metrics],
    'std_W37_W43': [sub[sub['group']=='W37-W43'][m].std() for m in metrics],
    'n_W37_W43': 7,
    'delta': [delta[m] for m in metrics],
    'delta_pct': [pct[m] for m in metrics],
})
summary_path = f"{out_dir}\\step2_group_summary.csv"
summary.to_csv(summary_path, index=False)

print("\nSaved:", perweek_path)
print("Saved:", summary_path)
print("\nSummary:")
print(summary.to_string(index=False))

