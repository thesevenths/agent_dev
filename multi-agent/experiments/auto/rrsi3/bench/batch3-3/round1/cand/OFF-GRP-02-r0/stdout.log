import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-02-r0\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-02-r0\_sandbox\tmp\step2_crosstab.csv"

df = pd.read_csv(src)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g.columns = ['grade','region','row_count','reading_score_mean']
g['reading_score_mean'] = g['reading_score_mean'].round(4)
# order grades G10..G12, regions A..D
g['grade'] = pd.Categorical(g['grade'], ['G10','G11','G12'], ordered=True)
g['region'] = pd.Categorical(g['region'], ['A','B','C','D'], ordered=True)
g = g.sort_values(['grade','region']).reset_index(drop=True)
g.to_csv(out, index=False)
print(g.to_string(index=False))
print("\ncells:", len(g), "total rows:", g['row_count'].sum())
mx = g.loc[g['reading_score_mean'].idxmax()]
mn = g.loc[g['reading_score_mean'].idxmin()]
print("\nMAX:", mx.to_dict())
print("MIN:", mn.to_dict())
print("diff:", round(mx['reading_score_mean']-mn['reading_score_mean'],4))
print("saved:", out)

```
