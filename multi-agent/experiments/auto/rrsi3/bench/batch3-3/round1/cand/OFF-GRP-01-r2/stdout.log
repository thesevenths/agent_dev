import json, math

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-01-r2\_sandbox\tmp\group_stats.json"
d = json.load(open(p, encoding="utf-8"))
g0 = next(g for g in d["groups"] if g["tutoring"]==0)
g1 = next(g for g in d["groups"] if g["tutoring"]==1)

# 正确的合并标准差（pooled SD, df = n0+n1-2）
n0, n1 = g0["n"], g1["n"]
s0, s1 = g0["std_sample"], g1["std_sample"]
pooled = math.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
diff = g1["mean"] - g0["mean"]
d_cohen = diff / pooled
print("pooled:", pooled)
print("diff:", diff)
print("d:", d_cohen)
print("json pooled (wrong):", d["pooled_std"], "json d:", d["cohens_d"])

```
