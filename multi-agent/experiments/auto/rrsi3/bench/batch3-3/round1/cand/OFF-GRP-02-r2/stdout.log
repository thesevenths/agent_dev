import pandas as pd

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-02-r2\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-02-r2\_sandbox\tmp\step2_crosstab_aggregation.csv"

df = pd.read_csv(p)
g = df.groupby(["grade", "region"], observed=True).agg(
    n=("reading_score", "size"),
    reading_score_mean=("reading_score", "mean"),
    reading_score_min=("reading_score", "min"),
    reading_score_max=("reading_score", "max"),
).reset_index()

# order grades G10..G12, regions A..D
g["grade"] = pd.Categorical(g["grade"], ["G10","G11","G12"], ordered=True)
g["region"] = pd.Categorical(g["region"], ["A","B","C","D"], ordered=True)
g = g.sort_values(["grade","region"]).reset_index(drop=True)
g["reading_score_mean"] = g["reading_score_mean"].round(4)

imax = g["reading_score_mean"].idxmax()
imin = g["reading_score_mean"].idxmin()
print(g.to_string(index=False))
print("MAX:", g.loc[imax].tolist())
print("MIN:", g.loc[imin].tolist())
print("overall mean:", round(df["reading_score"].mean(),4), "n=", len(df))
print("max-min diff:", round(g.loc[imax,"reading_score_mean"]-g.loc[imin,"reading_score_mean"],4))

g.to_csv(out, index=False)
print("saved:", out)

```
