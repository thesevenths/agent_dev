import pandas as pd, os

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-02-r2\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-02-r2\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(src)
g = df.groupby(["grade","region"], observed=True)["reading_score"].agg(
    row_count="count", mean_reading_score="mean"
).reset_index()
g["mean_reading_score"] = g["mean_reading_score"].round(4)
g = g.sort_values(["grade","region"]).reset_index(drop=True)
print(g.to_string(index=False))

imax = g["mean_reading_score"].idxmax()
imin = g["mean_reading_score"].idxmin()
hi = g.loc[imax]; lo = g.loc[imin]
print("HIGHEST:", hi.to_dict())
print("LOWEST:", lo.to_dict())
print("diff:", round(hi["mean_reading_score"]-lo["mean_reading_score"],4))
print("ratio:", round(hi["mean_reading_score"]/lo["mean_reading_score"],4))
print("overall mean:", round(df["reading_score"].mean(),4), "n=", len(df))

out_csv = os.path.join(out_dir, "step2_crosstab.csv")
g.to_csv(out_csv, index=False)
print("saved:", out_csv)

