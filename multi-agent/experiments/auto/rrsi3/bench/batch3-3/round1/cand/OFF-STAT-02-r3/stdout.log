```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-STAT-02-r3\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
m = df["math_score"]; r = df["reading_score"]
n = len(df)

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "n_math": int(m.notna().sum()),
    "n_reading": int(r.notna().sum()),
    "math_score": {
        "mean": float(m.mean()),
        "std_sample": float(m.std(ddof=1)),
        "std_pop": float(m.std(ddof=0)),
        "median": float(m.median()),
        "min": int(m.min()), "max": int(m.max()),
        "cv_sample": float(m.std(ddof=1)/m.mean()),
        "cv_pop": float(m.std(ddof=0)/m.mean()),
    },
    "reading_score": {
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_pop": float(r.std(ddof=0)),
        "median": float(r.median()),
        "min": int(r.min()), "max": int(r.max()),
        "cv_sample": float(r.std(ddof=1)/r.mean()),
        "cv_pop": float(r.std(ddof=0)/r.mean()),
    },
    "pearson_r": float(df[["math_score","reading_score"]].corr().iloc[0,1]),
}
out = os.path.join(out_dir, "stats_results.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
