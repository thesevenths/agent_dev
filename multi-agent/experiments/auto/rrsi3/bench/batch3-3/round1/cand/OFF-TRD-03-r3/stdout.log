import pandas as pd
import os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"
df = pd.read_csv("offline_data/regional_sales.csv")

# per-region aggregates
g = df.groupby("region").agg(
    total_revenue=("revenue", "sum"),
    n_months=("month", "nunique"),
)
g["monthly_avg_revenue"] = g["total_revenue"] / g["n_months"]
grand = df["revenue"].sum()
g["share_pct"] = g["total_revenue"] / grand * 100

# peak month per region (sum revenue across product lines within region+month)
rm = df.groupby(["region", "month"])["revenue"].sum().reset_index()
peak = rm.loc[rm.groupby("region")["revenue"].idxmax()][["region", "month", "revenue"]]
peak = peak.rename(columns={"month": "peak_month", "revenue": "peak_month_revenue"})

out = g.reset_index().merge(peak, on="region")
out = out[["region", "total_revenue", "share_pct", "monthly_avg_revenue", "n_months", "peak_month", "peak_month_revenue"]]
out = out.sort_values("total_revenue", ascending=False).reset_index(drop=True)

out_path = os.path.join(base, "regional_summary.csv")
out.to_csv(out_path, index=False)
print(out.to_string(index=False))
print("grand total:", grand)
print("saved:", os.path.abspath(out_path))

# also show top region peak detail
top = out.iloc[0]["region"]
print("top region:", top)
print(rm[rm["region"] == top].sort_values("revenue", ascending=False).head(3))

