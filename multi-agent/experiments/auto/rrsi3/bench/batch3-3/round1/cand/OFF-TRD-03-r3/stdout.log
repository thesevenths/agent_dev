import pandas as pd, json

df = pd.read_csv('offline_data/regional_sales.csv')
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dup rows:", df.duplicated().sum())
print("revenue negative/zero:", (df['revenue']<=0).sum())

# consistency check: units*unit_price vs revenue
df['calc'] = df['units']*df['unit_price']
diff = (df['calc']-df['revenue']).abs()
print("max |units*price - revenue|:", diff.max())

# per-region aggregates
g = df.groupby('region')['revenue'].agg(['sum','count'])
g['months'] = df.groupby('region')['month'].nunique()
g['monthly_avg'] = g['sum']/g['months']
g['share'] = g['sum']/df['revenue'].sum()*100
print(g.round(2))

# monthly totals per region
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
print(piv.round(2))
print("grand total:", df['revenue'].sum())
top_region = g['sum'].idxmax()
print("top region:", top_region)
peak = piv[top_region].idxmax()
print("peak month of top region:", peak, piv.loc[peak, top_region])
print("overall peak month (any region):", piv.max().idxmax())

# save validation summary
summary = {
  "file": "offline_data/regional_sales.csv",
  "rows": int(df.shape[0]),
  "columns": list(df.columns),
  "regions": sorted(df['region'].unique()),
  "month_range": [df['month'].min(), df['month'].max()],
  "n_months": int(df['month'].nunique()),
  "product_lines": sorted(df['product_line'].unique()),
  "null_cells": int(df.isna().sum().sum()),
  "duplicate_rows": int(df.duplicated().sum()),
  "revenue_nonpositive": int((df['revenue']<=0).sum()),
  "max_units_price_revenue_diff": float(diff.max()),
  "region_totals": {r: {"total_revenue": round(float(g.loc[r,'sum']),2),
                         "rows": int(g.loc[r,'count']),
                         "months": int(g.loc[r,'months']),
                         "monthly_avg": round(float(g.loc[r,'monthly_avg']),2),
                         "share_pct": round(float(g.loc[r,'share']),4)} for r in g.index},
  "grand_total_revenue": round(float(df['revenue'].sum()),2),
  "top_region": top_region,
  "top_region_peak_month": peak,
  "top_region_peak_revenue": round(float(piv.loc[peak, top_region]),2),
  "monthly_pivot": {m: {r: round(float(piv.loc[m,r]),2) for r in piv.columns} for m in piv.index},
}
with open(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-TRD-03-r3\_sandbox\tmp\csv_validation_summary.json','w',encoding='utf-8') as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("saved summary json")

