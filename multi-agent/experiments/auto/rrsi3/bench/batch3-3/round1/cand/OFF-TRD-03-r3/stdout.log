print("nulls:\n", df.isna().sum())
print("revenue sum check vs units*price max diff:", (df["revenue"] - df["units"]*df["unit_price"]).abs().max())

profile = {
    "file": path,
    "shape": list(df.shape),
    "columns": df.columns.tolist(),
    "dtypes": {c: str(t) for c, t in df.dtypes.items()},
    "regions": regions,
    "month_min": df["month"].min(),
    "month_max": df["month"].max(),
    "n_months": int(df["month"].nunique()),
    "product_lines": sorted(df["product_line"].unique()),
    "rows_per_region": {k: int(v) for k, v in df.groupby("region").size().items()},
    "null_counts": {c: int(v) for c, v in df.isna().sum().items() if v > 0},
    "revenue_equals_units_x_price_max_abs_diff": float((df["revenue"] - df["units"]*df["unit_price"]).abs().max()),
}

out = os.path.join(base, "regional_sales_profile.json")
import json
with open(out, "w", encoding="utf-8") as f:
    json.dump(profile, f, ensure_ascii=False, indent=2)
print("saved:", os.path.abspath(out))
print(json.dumps(profile, ensure_ascii=False, indent=2))

