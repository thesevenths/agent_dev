import pandas as pd
import os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"
path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

regions = sorted(df["region"].unique())
print("regions:", regions)
print("month range:", df["month"].min(), "->", df["month"].max())
print("n months:", df["month"].nunique())
print("product lines:", sorted(df["product_line"].unique()))
