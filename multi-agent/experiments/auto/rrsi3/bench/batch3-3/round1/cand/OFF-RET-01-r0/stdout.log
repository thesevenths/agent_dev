import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
n = len(r)
first, last = r.iloc[:30], r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)
below = (r < overall_mean - 2*overall_std).sum()

res = {
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "total_weeks": int(n),
    "first30": {"weeks": "W01-W30", "n": 30, "mean": float(first.mean()), "std": float(first.std(ddof=1)), "min": float(first.min()), "max": float(first.max())},
    "last30": {"weeks": "W31-W60", "n": 30, "mean": float(last.mean()), "std": float(last.std(ddof=1)), "min": float(last.min()), "max": float(last.max())},
    "diff_mean_last_minus_first": float(last.mean() - first.mean()),
    "overall": {"mean": float(overall_mean), "std": float(overall_std), "threshold_mean_minus_2std": float(overall_mean - 2*overall_std)},
    "weeks_below_mean_minus_2std": int(below),
    "weeks_below_list": df.loc[r < overall_mean - 2*overall_std, "week"].tolist(),
    "std_note": "std uses sample standard deviation (ddof=1)",
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-01-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out = os.path.join(out_dir, "retention_d7_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("SAVED:", os.path.abspath(out))

```
