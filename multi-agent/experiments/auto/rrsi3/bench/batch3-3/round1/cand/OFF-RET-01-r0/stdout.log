import pandas as pd
df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
print("rows:", len(df), "nulls:", r.isna().sum(), "dtype:", r.dtype)
print("week range:", df["week"].iloc[0], "->", df["week"].iloc[-1])
print("unique weeks:", df["week"].nunique())
print("min/max:", r.min(), r.max())
print("overall mean/std(ddof=1):", r.mean(), r.std(ddof=1))
print("overall std(ddof=0):", r.std(ddof=0))
first = r.iloc[:30]; last = r.iloc[30:]
print("first30 mean/std:", first.mean(), first.std(ddof=1))
print("last30 mean/std:", last.mean(), last.std(ddof=1))
thr = r.mean() - 2*r.std(ddof=1)
print("threshold:", thr, "count below:", (r < thr).sum())
print(df.loc[r < thr, "week"].tolist())

```
