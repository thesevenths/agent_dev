import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-QUA-02-r5\_sandbox"
csv_path = os.path.join(base, "offline_data", "regional_sales.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv_path)
print("COLUMNS:", list(df.columns))
print("DTYPES:\n", df.dtypes)
print("TOTAL ROWS:", len(df))
print("SAMPLE:\n", df.head(5).to_string())

exp = df["units"] * df["unit_price"]
dev = (df["revenue"] - exp).abs() / exp * 100
res = df.copy()
res["expected_revenue"] = exp
res["deviation_pct"] = dev
res.to_csv(os.path.join(out_dir, "revenue_check.csv"), index=False)

bad = res[res["deviation_pct"] > 0.5]
print("DEV>0.5% COUNT:", len(bad))
if len(res):
    i = res["deviation_pct"].idxmax()
    print("MAX DEV:", res.loc[i, "deviation_pct"], "at index", i)
    print(res.loc[[i]].to_string())
print("RETURNS>UNITS COUNT:", int((df["returns"] > df["units"]).sum()))
print("ARTIFACT:", os.path.join(out_dir, "revenue_check.csv"))

