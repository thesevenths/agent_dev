import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sl = df[df["week"].isin([f"W{i:02d}" for i in range(30,44)])].copy()
sl["group"] = sl["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
means = sl.groupby("group")[metrics].mean().reset_index()
counts = sl.groupby("group").size().rename("n").reset_index()
res = means.merge(counts, on="group")
print(res.to_string(index=False))

# per-week deltas to pinpoint breakpoint
sl["ret_delta"] = sl["retention_d7"].diff()
sl["churn_delta"] = sl["churn_rate"].diff()
sl["arpu_delta"] = sl["arpu_usd"].diff()
print(sl[["week","ret_delta","churn_delta","arpu_delta"]].to_string(index=False))

# breakpoint week = week with largest |ret_delta| (and consistent direction across metrics)
bp = sl.loc[sl["ret_delta"].abs().idxmax(), "week"]
print("breakpoint week:", bp)

# group-level differences (after - before) and relative change
a = res[res.group=="W30-W36"].iloc[0]; b = res[res.group=="W37-W43"].iloc[0]
for m in metrics:
    diff = b[m]-a[m]; rel = diff/a[m]*100
    print(m, "before", a[m], "after", b[m], "diff", round(diff,4), "rel%", round(rel,2))

# W36->W37 single-week shift
w36 = sl[sl.week=="W36"].iloc[0]; w37 = sl[sl.week=="W37"].iloc[0]
for m in metrics:
    print("W36->W37", m, w36[m], w37[m], round(w37[m]-w36[m],4), round((w37[m]-w36[m])/w36[m]*100,2))

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r0\_sandbox\tmp"
res.to_csv(f"{out_dir}\\group_means_W30_W43.csv", index=False)
sl.to_csv(f"{out_dir}\\per_week_W30_W43_with_deltas.csv", index=False)
print("saved")

