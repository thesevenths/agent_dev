diff = pd.DataFrame({'metric':metrics,
                     'W30-W36_mean':[a[m] for m in metrics],
                     'W37-W43_mean':[b[m] for m in metrics],
                     'delta(b-a)':[b[m]-a[m] for m in metrics],
                     'pct_change%':[(b[m]-a[m])/a[m]*100 for m in metrics]})
diff.to_csv(f"{out}\\step2_group_diff.csv", index=False)

# breakpoint detection: largest single-week drop in retention_d7 within W30-W43
per['ret_drop'] = per['retention_d7'].diff()
bp = per.loc[per['ret_drop'].idxmin()]
print("=== per week ===")
print(per.to_string(index=False))
print("\n=== group means ===")
print(gm.to_string(index=False))
print("\n=== diff ===")
print(diff.to_string(index=False))
print("\nbreakpoint week (max WoW retention drop):", bp['week'], "ret", bp['retention_d7'], "drop", bp['retention_d7_wow'])

