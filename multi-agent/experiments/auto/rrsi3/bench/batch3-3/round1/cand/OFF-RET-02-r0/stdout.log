import pandas as pd
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r0\_sandbox\tmp"
df = pd.read_csv(p)
sl = df[df['week'].between('W30','W43')].copy()
sl['group'] = sl['week'].apply(lambda w: 'W30-W36' if int(w[1:])<=36 else 'W37-W43')
metrics = ['retention_d7','churn_rate','arpu_usd']

# per-week table with week-over-week deltas
per = sl[['week','group','retention_d7','churn_rate','arpu_usd']].copy()
for m in metrics:
    per[f'{m}_wow'] = per[m].diff()
per.to_csv(f"{out}\\step2_per_week.csv", index=False)

# group means
gm = sl.groupby('group')[metrics].mean().reset_index()
