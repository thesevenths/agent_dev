import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print(df.head(3).to_string())

cols = ["screen_hours_per_day", "math_score", "reading_score"]
missing = {c: int(df[c].isna().sum()) for c in cols if c in df.columns}
print("missing:", missing)
print("dtypes:")
print(df[cols].dtypes)
print("describe:")
print(df[cols].describe().to_string())
print("duplicates full rows:", int(df.duplicated().sum()))

# group counts for downstream
g = df.groupby(df["screen_hours_per_day"] > 5).agg(
    n=("math_score","size"),
    math_mean=("math_score","mean"),
    reading_mean=("reading_score","mean"),
)
print(g.to_string())

out = {
    "file": path,
    "rows": int(len(df)),
    "columns": list(df.columns),
    "required_columns_present": all(c in df.columns for c in cols),
    "missing_values": missing,
    "dtypes": {c: str(df[c].dtype) for c in cols},
    "describe": {c: {k: float(v) for k,v in df[c].describe().items()} for c in cols},
    "group_gt5": {
        "n": int(g.loc[True,"n"]),
        "math_mean": float(g.loc[True,"math_mean"]),
        "reading_mean": float(g.loc[True,"reading_mean"]),
    },
    "group_le5": {
        "n": int(g.loc[False,"n"]),
        "math_mean": float(g.loc[False,"math_mean"]),
        "reading_mean": float(g.loc[False,"reading_mean"]),
    },
}
outp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step1_validation.json"
with open(outp,"w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved:", outp)

```
