import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-COR-02-r1\_sandbox"
path = os.path.join(base, "offline_data", "students.csv")
df = pd.read_csv(path)

n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

# p-values via scipy if available
try:
    from scipy import stats
    p_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"])[1]
    p_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"])[1]
except Exception:
    p_math = p_read = None

res = {
    "source_file": path,
    "n_rows": n,
    "correlations": [
        {"pair": "screen_hours_per_day vs math_score", "pearson_r": round(r_math, 6), "p_value": p_math, "n": n},
        {"pair": "screen_hours_per_day vs reading_score", "pearson_r": round(r_read, 6), "p_value": p_read, "n": n},
    ],
}
print(json.dumps(res, indent=2))

out = os.path.join(base, "tmp", "step2_correlations.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("SAVED:", out)

