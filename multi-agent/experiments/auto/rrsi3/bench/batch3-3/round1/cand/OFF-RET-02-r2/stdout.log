import pandas as pd

stats = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r2\_sandbox\tmp\retention_breakpoint_stats.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r2\_sandbox\tmp\breakpoint_summary.csv"

df = pd.read_csv(stats)
weekly = df[df['week'].str.startswith('W')].copy()
means = df[df['week']=='MEAN'].set_index('group')
metrics = ['retention_d7','churn_rate','arpu_usd']

# find week of largest shift for each metric: max |week_t - week_{t-1}| within W30-W43
breakpoints = {}
for m in metrics:
    d = weekly[m].diff().abs()
    idx = d.idxmax()
    w = weekly.loc[idx, 'week']
    breakpoints[m] = w
    print(m, "largest week-over-week shift at", w, "delta=", weekly.loc[idx, m]-weekly.loc[idx-1, m])

rows = []
for m in metrics:
    pre = means.loc['W30-W36', m]
    post = means.loc['W37-W43', m]
    rows.append({
        'metric': m,
        'pre_mean': round(pre, 6),
        'post_mean': round(post, 6),
        'abs_diff': round(post-pre, 6),
        'rel_diff_pct': round((post-pre)/pre*100, 2),
        'breakpoint_week': breakpoints[m],
    })
summary = pd.DataFrame(rows)
summary.to_csv(out, index=False, encoding='utf-8-sig')
print(summary.to_string(index=False))
print("saved:", out)

