import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r2\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r2\_sandbox\tmp\retention_breakpoint_stats.csv"

df = pd.read_csv(src)
sub = df[df['week'].between('W30','W43')].copy()
metrics = ['retention_d7','churn_rate','arpu_usd']
grp = sub['week'].apply(lambda w: 'W30-W36' if w <= 'W36' else 'W37-W43')

# per-week
per_week = sub[['week']].copy()
per_week['group'] = grp.values
for m in metrics:
    per_week[m] = sub[m].values

# group means
g = sub.copy(); g['group'] = grp.values
means = g.groupby('group')[metrics].mean().reset_index()
means['n_rows'] = g.groupby('group').size().values
means.insert(0, 'week', 'MEAN')

# diff row
pre = means[means['group']=='W30-W36'].iloc[0]
post = means[means['group']=='W37-W43'].iloc[0]
diff = pd.DataFrame({'week':['DIFF'], 'group':['W37-W43 minus W30-W36']})
for m in metrics:
    diff[m] = [post[m]-pre[m]]
    diff[m+'_rel_pct'] = [(post[m]-pre[m])/pre[m]*100]

combined = pd.concat([per_week, means, diff], ignore_index=True)
combined.to_csv(out, index=False, encoding='utf-8-sig')
print(combined.to_string(index=False))
print("saved:", out)

