for _, r in sub.iterrows():
    lines.append(f"| {r['week']} | {r['cohort_size']} | {r['dau']} | {r['retention_d7']:.4f} | {r['churn_rate']:.4f} | {r['arpu_usd']:.3f} | {r['support_tickets']} |")
