import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].between('W30','W43')].copy()

pre = sub[sub['week'].between('W30','W36')]
post = sub[sub['week'].between('W37','W43')]

metrics = ['retention_d7','churn_rate','arpu_usd']

rows = []
for m in metrics:
    a, b = pre[m].mean(), post[m].mean()
    rows.append({
        'metric': m,
        'pre_mean_W30_W36': round(a,6),
        'post_mean_W37_W43': round(b,6),
        'abs_diff_post_minus_pre': round(b-a,6),
        'rel_diff_pct': round((b-a)/a*100,4),
        'pre_n': len(pre), 'post_n': len(post),
    })
summary = pd.DataFrame(rows)
print(summary.to_string(index=False))

# breakpoint: week with largest shift vs previous week (W31..W43)
s = sub.set_index('week')[metrics]
shifts = s.diff()
# use relative change magnitude summed across metrics to rank weeks
rel = shifts / s.shift(1)
score = rel.abs().sum(axis=1)
print("\nRelative-shift score per week:")
print(score.sort_values(ascending=False).head(5))

# also raw diffs W36->W37
print("\nW36->W37 raw diffs:")
print(s.loc[['W36','W37']])

# save intermediate CSV
out = pd.DataFrame({
    'week': sub['week'],
    'group': np.where(sub['week'].between('W30','W36'),'pre_W30_W36','post_W37_W43'),
    **{m: sub[m] for m in metrics},
})
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r2\_sandbox\tmp\step2_group_means.csv"
with pd.ExcelWriter(out_path, engine='openpyxl') as w:
    out.to_excel(w, sheet_name='W30_W43_rows', index=False)
    summary.to_excel(w, sheet_name='group_means', index=False)
    score.sort_values(ascending=False).rename('shift_score').to_frame().to_excel(w, sheet_name='breakpoint_ranking')
print("\nsaved:", out_path)

```
