    diff = vals[1]-vals[0]
    rel = diff/vals[0]*100
    ax.set_title(f'{m}\nΔ = {diff:+.4f} ({rel:+.2f}%)', fontsize=10)
    ax.grid(axis='y', alpha=0.3)
