import pandas as pd
import numpy as np

PATH = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-01-r3\_sandbox\offline_data\app_metrics.csv"
OUT = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-01-r3\_sandbox\tmp\step2_stats.csv"

df = pd.read_csv(PATH)
r = df["retention_d7"]
first = r.iloc[:30]
last = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2 * overall_std
below = df[r < threshold]

rows = [
    ("first30_mean", first.mean(), 30),
    ("first30_std_ddof1", first.std(ddof=1), 30),
    ("last30_mean", last.mean(), 30),
    ("last30_std_ddof1", last.std(ddof=1), 30),
    ("mean_diff_last_minus_first", last.mean() - first.mean(), 60),
    ("std_diff_last_minus_first", last.std(ddof=1) - first.std(ddof=1), 60),
    ("overall_mean", overall_mean, 60),
    ("overall_std_ddof1", overall_std, 60),
    ("threshold_mean_minus_2std", threshold, 60),
    ("weeks_below_threshold", len(below), 60),
]
out = pd.DataFrame(rows, columns=["metric", "value", "n_rows"])
out.to_csv(OUT, index=False)
print(out.to_string(index=False))
print("\nweeks below threshold:")
print(below[["week", "retention_d7"]].to_string(index=False))
print("\nsaved:", OUT)

