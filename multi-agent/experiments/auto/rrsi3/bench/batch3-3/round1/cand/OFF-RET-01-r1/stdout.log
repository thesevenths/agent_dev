import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
low_weeks = df[r < threshold]

res = {
    "as_of": "2026-10-25 07:56",
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": "W01-W30", "n": int(len(first30)), "mean": first30.mean(), "std_sample": first30.std(ddof=1), "std_pop": first30.std(ddof=0)},
    "last30": {"weeks": "W31-W60", "n": int(len(last30)), "mean": last30.mean(), "std_sample": last30.std(ddof=1), "std_pop": last30.std(ddof=0)},
    "diff_mean_last_minus_first": last30.mean() - first30.mean(),
    "overall": {"n": int(len(r)), "mean": overall_mean, "std_sample": overall_std, "std_pop": r.std(ddof=0)},
    "threshold_mean_minus_2std": threshold,
    "weeks_below_threshold": {
        "count": int(len(low_weeks)),
        "weeks": low_weeks["week"].tolist(),
        "values": low_weeks["retention_d7"].tolist(),
    },
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-01-r1\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("saved:", out)

