```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

win = df[df['week'].between('W30', 'W43')].copy()
win['group'] = win['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')

# per-week table with week-over-week deltas
per = win[['week', 'group'] + metrics].copy()
for m in metrics:
    per[f'{m}_wow_delta'] = per[m].diff()

# group means
means = win.groupby('group')[metrics].mean().reset_index()
n = win.groupby('group')['week'].count().rename('n_rows').reindex(means['group']).values
means['n_rows'] = n

# breakpoint detection: largest week-over-week jump in churn_rate / drop in retention_d7
jump_churn = per['churn_rate_wow_delta'].idxmax()
drop_ret = per['retention_d7_wow_delta'].idxmin()
print("max churn WoW jump at row idx:", jump_churn, "->", per.loc[jump_churn, 'week'])
print("max retention WoW drop at row idx:", drop_ret, "->", per.loc[drop_ret, 'week'])
print("churn WoW deltas:\n", per[['week','churn_rate','churn_rate_wow_delta']].to_string(index=False))
print("retention WoW deltas:\n", per[['week','retention_d7','retention_d7_wow_delta']].to_string(index=False))

# absolute & relative differences (after - before)
after = means[means['group']=='W37-W43'].iloc[0]
before = means[means['group']=='W30-W36'].iloc[0]
diff = pd.DataFrame({'metric': metrics,
                     'before_W30_W36': [before[m] for m in metrics],
                     'after_W37_W43': [after[m] for m in metrics],
                     'abs_diff_after_minus_before': [after[m]-before[m] for m in metrics],
                     'rel_diff_pct': [(after[m]-before[m])/before[m]*100 for m in metrics]})
print(diff.to_string(index=False))

# save intermediate CSVs
per.to_csv(f"{out_dir}\\step2_per_week_metrics.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
diff.to_csv(f"{out_dir}\\step2_group_differences.csv", index=False)
print("saved 3 csv files")
print(means.to_string(index=False))

```
