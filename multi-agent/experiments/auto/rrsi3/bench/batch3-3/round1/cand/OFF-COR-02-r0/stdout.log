import pandas as pd, json, math

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
n = len(df)

def pearson(x, y):
    x = x.to_numpy(float); y = y.to_numpy(float)
    mx, my = x.mean(), y.mean()
    cov = ((x-mx)*(y-my)).sum()
    return cov / math.sqrt(((x-mx)**2).sum() * ((y-my)**2).sum())

r_math = pearson(df["screen_hours_per_day"], df["math_score"])
r_read = pearson(df["screen_hours_per_day"], df["reading_score"])

# sanity check vs pandas
print("pandas check:", df["screen_hours_per_day"].corr(df["math_score"]), df["screen_hours_per_day"].corr(df["reading_score"]))

# t-statistic for significance
def t_stat(r, n):
    return r * math.sqrt((n-2)/(1-r*r))

t_math = t_stat(r_math, n)
t_read = t_stat(r_read, n)

out = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "correlations": [
        {"x": "screen_hours_per_day", "y": "math_score", "pearson_r": round(r_math, 6), "t_stat": round(t_math, 4), "n": n},
        {"x": "screen_hours_per_day", "y": "reading_score", "pearson_r": round(r_read, 6), "t_stat": round(t_read, 4), "n": n},
    ],
    "as_of": "2026-10-26 03:16",
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", out_path)

