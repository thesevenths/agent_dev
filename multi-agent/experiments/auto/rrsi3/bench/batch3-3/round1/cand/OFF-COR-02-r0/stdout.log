import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "screen_gt_5", False: "screen_le_5"})

g = df.groupby("group").agg(
    n=("student_id", "count"),
    mean_screen=("screen_hours_per_day", "mean"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
).reset_index()
print(g.to_string(index=False))

# mean differences (gt5 - le5)
hi = g[g.group=="screen_gt_5"].iloc[0]
lo = g[g.group=="screen_le_5"].iloc[0]
diff_math = hi.mean_math - lo.mean_math
diff_read = hi.mean_reading - lo.mean_reading
print("diff math (gt5 - le5):", round(diff_math, 4))
print("diff reading (gt5 - le5):", round(diff_read, 4))

rows = []
for _, r in g.iterrows():
    rows.append({"group": r.group, "n": int(r.n),
                 "mean_screen_hours_per_day": round(r.mean_screen, 4),
                 "mean_math_score": round(r.mean_math, 4),
                 "mean_reading_score": round(r.mean_reading, 4)})
rows.append({"group": "diff_gt5_minus_le5", "n": None,
             "mean_screen_hours_per_day": round(hi.mean_screen - lo.mean_screen, 4),
             "mean_math_score": round(diff_math, 4),
             "mean_reading_score": round(diff_read, 4)})
out = pd.DataFrame(rows)
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.csv"
out.to_csv(out_path, index=False)
print(out.to_string(index=False))
print("saved:", out_path)

