import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]
last = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

out = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "std_convention": "sample std (ddof=1)",
    "first_30": {"weeks": "W01-W30", "n": int(len(first)), "mean": float(first.mean()), "std": float(first.std(ddof=1))},
    "last_30": {"weeks": "W31-W60", "n": int(len(last)), "mean": float(last.mean()), "std": float(last.std(ddof=1))},
    "diff_mean_last_minus_first": float(last.mean() - first.mean()),
    "overall": {"n": int(len(r)), "mean": float(overall_mean), "std": float(overall_std)},
    "threshold_mean_minus_2std": float(threshold),
    "weeks_below_threshold": {
        "count": int(len(below)),
        "weeks": below["week"].tolist(),
        "values": below["retention_d7"].tolist(),
    },
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-01-r2\_sandbox\tmp\retention_d7_stats.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", path)

