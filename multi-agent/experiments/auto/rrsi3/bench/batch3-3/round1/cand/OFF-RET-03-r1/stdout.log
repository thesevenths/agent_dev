import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r1\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

# Correlations (Pearson)
corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] <= med]

rows = [
    {"metric": "n_rows", "value": len(df)},
    {"metric": "retention_d7_median", "value": med},
    {"metric": "corr_retention_d7_arpu_usd", "value": corr_arpu},
    {"metric": "corr_retention_d7_churn_rate", "value": corr_churn},
    {"metric": "group_high_n", "value": len(high)},
    {"metric": "group_high_mean_arpu_usd", "value": high["arpu_usd"].mean()},
    {"metric": "group_high_sum_cohort_size", "value": int(high["cohort_size"].sum())},
    {"metric": "group_high_retention_d7_min", "value": high["retention_d7"].min()},
    {"metric": "group_high_retention_d7_max", "value": high["retention_d7"].max()},
    {"metric": "group_low_n", "value": len(low)},
    {"metric": "group_low_mean_arpu_usd", "value": low["arpu_usd"].mean()},
    {"metric": "group_low_sum_cohort_size", "value": int(low["cohort_size"].sum())},
    {"metric": "group_low_retention_d7_min", "value": low["retention_d7"].min()},
    {"metric": "group_low_retention_d7_max", "value": low["retention_d7"].max()},
    {"metric": "arpu_gap_high_minus_low", "value": high["arpu_usd"].mean() - low["arpu_usd"].mean()},
    {"metric": "arpu_ratio_high_over_low", "value": high["arpu_usd"].mean() / low["arpu_usd"].mean()},
    {"metric": "total_cohort_size", "value": int(df["cohort_size"].sum())},
]
out = pd.DataFrame(rows)
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-RET-03-r1\_sandbox\tmp\step2_results.csv"
out.to_csv(out_path, index=False)
print(out.to_string(index=False))
print("saved:", out_path)

