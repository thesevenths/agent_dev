import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")

def grp(h):
    if h < 2.5: return "Low"
    if h <= 4.5: return "Mid"
    return "High"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(
    n=("math_score","size"),
    mean_math=("math_score","mean"),
    std_math=("math_score","std"),
    min_math=("math_score","min"),
    max_math=("math_score","max"),
    mean_h=("study_hours_per_week","mean"),
    min_h=("study_hours_per_week","min"),
    max_h=("study_hours_per_week","max"),
).loc[["Low","Mid","High"]]

low, mid, high = g.loc["Low"], g.loc["Mid"], g.loc["High"]
gain_abs = high.mean_math - low.mean_math
gain_pct = gain_abs / low.mean_math * 100
gain_mid_to_high = high.mean_math - mid.mean_math
gain_low_to_mid = mid.mean_math - low.mean_math

out = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "groups": {k: {
      "n": int(r.n),
      "mean_math": round(r.mean_math, 4),
      "std_math": round(r.std_math, 4),
      "min_math": int(r.min_math),
      "max_math": int(r.max_math),
      "mean_hours": round(r.mean_h, 4),
      "min_hours": float(r.min_h),
      "max_hours": float(r.max_h),
  } for k, r in g.iterrows()},
  "gains": {
      "low_to_high_abs": round(gain_abs, 4),
      "low_to_high_pct": round(gain_pct, 4),
      "low_to_mid_abs": round(gain_low_to_mid, 4),
      "mid_to_high_abs": round(gain_mid_to_high, 4),
  },
}
print(json.dumps(out, indent=2, ensure_ascii=False))

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-03-r4\_sandbox\tmp\step2_group_stats.json"
json.dump(out, open(p, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
print("saved:", p)

```
