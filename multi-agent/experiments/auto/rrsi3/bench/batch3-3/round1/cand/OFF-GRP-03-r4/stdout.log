```python
import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")

def grp(h):
    if h < 2.5: return "Low"
    if h <= 4.5: return "Mid"
    return "High"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(n=("math_score","size"),
                            mean_math=("math_score","mean"),
                            min_h=("study_hours_per_week","min"),
                            max_h=("study_hours_per_week","max"),
                            mean_h=("study_hours_per_week","mean"))
order = ["Low","Mid","High"]
g = g.loc[order]

low_mean = g.loc["Low","mean_math"]; high_mean = g.loc["High","mean_math"]
gain = high_mean - low_mean
gain_pct = gain / low_mean * 100

out = {
  "file": "offline_data/students.csv",
  "rows": int(len(df)), "cols": int(df.shape[1]),
  "missing_total": int(df.isna().sum().sum()),
  "duplicated_rows": int(df.duplicated().sum()),
  "study_hours_range": [float(df.study_hours_per_week.min()), float(df.study_hours_per_week.max())],
  "math_score_range": [int(df.math_score.min()), int(df.math_score.max())],
  "groups": {k: {"n": int(r.n), "mean_math": round(r.mean_math,4),
                 "h_min": float(r.min_h), "h_max": float(r.max_h),
                 "mean_h": round(r.mean_h,4)} for k,r in g.iterrows()},
  "gain_low_to_high": round(gain,4),
  "gain_pct": round(gain_pct,4),
}
print(json.dumps(out, indent=2, ensure_ascii=False))

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-03-r4\_sandbox\tmp\step1_validation.json","w",encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved")

```
