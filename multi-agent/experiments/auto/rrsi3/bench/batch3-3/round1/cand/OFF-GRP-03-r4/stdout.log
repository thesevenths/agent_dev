import pandas as pd, json
from scipy import stats

CSV = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-03-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(CSV)

def grp(x):
    if x < 2.5: return "低组（<2.5）"
    elif x <= 4.5: return "中组（2.5–4.5）"
    else: return "高组（>4.5）"
df["group"] = df.study_hours_per_week.apply(grp)
order = ["低组（<2.5）", "中组（2.5–4.5）", "高组（>4.5）"]

rows = []
for g in order:
    sub = df[df.group == g]
    rows.append({
        "group": g,
        "n": len(sub),
        "mean": sub.math_score.mean(),
        "std": sub.math_score.std(),
        "min": sub.math_score.min(),
        "max": sub.math_score.max(),
        "hours_mean": sub.study_hours_per_week.mean(),
        "hours_min": sub.study_hours_per_week.min(),
        "hours_max": sub.study_hours_per_week.max(),
    })
R = {g: r for g, r in zip(order, rows)}
low, mid, high = R[order[0]], R[order[1]], R[order[2]]
gain = high["mean"] - low["mean"]
ratio = high["mean"] / low["mean"]
t, p = stats.ttest_ind(df[df.group == order[2]].math_score, df[df.group == order[0]].math_score)
overall_mean = df.math_score.mean()
overall_n = len(df)
print(json.dumps({
    "overall_n": overall_n, "overall_mean": overall_mean,
    "rows": rows, "gain": gain, "ratio": ratio, "t": t, "p": p,
    "b25": int((df.study_hours_per_week == 2.5).sum()),
    "b45": int((df.study_hours_per_week == 4.5).sum()),
}, ensure_ascii=False, indent=1))

