import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-03-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

# boundary checks
print("rows with study_hours == 2.5:", (df.study_hours_per_week == 2.5).sum())
print("rows with study_hours == 4.5:", (df.study_hours_per_week == 4.5).sum())
print("unique student_id:", df.student_id.nunique())

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"
df["group"] = df.study_hours_per_week.apply(grp)

g = df.groupby("group").agg(n=("math_score","size"),
                            mean_math=("math_score","mean"),
                            std_math=("math_score","std"),
                            min_math=("math_score","min"),
                            max_math=("math_score","max"),
                            mean_hours=("study_hours_per_week","mean"),
                            min_hours=("study_hours_per_week","min"),
                            max_hours=("study_hours_per_week","max"))
print(g.to_string())

# gain low->high
low_mean = df.loc[df.group=="low","math_score"].mean()
high_mean = df.loc[df.group=="high","math_score"].mean()
print("gain:", high_mean - low_mean, "ratio:", high_mean/low_mean)

# t-test for rigor
from scipy import stats
t, p = stats.ttest_ind(df.loc[df.group=="high","math_score"], df.loc[df.group=="low","math_score"])
print("t-test high vs low: t=%.4f p=%.6g" % (t,p))

# save validation summary
out = {
  "file": path,
  "rows": int(len(df)), "cols": int(df.shape[1]),
  "columns": list(df.columns),
  "missing": {c:int(v) for c,v in df.isna().sum().items()},
  "duplicated_rows": int(df.duplicated().sum()),
  "unique_student_id": int(df.student_id.nunique()),
  "study_hours_per_week": {"min":float(df.study_hours_per_week.min()),"max":float(df.study_hours_per_week.max()),"mean":round(float(df.study_hours_per_week.mean()),4)},
  "math_score": {"min":int(df.math_score.min()),"max":int(df.math_score.max()),"mean":round(float(df.math_score.mean()),4)},
  "boundary_rows_2.5": int((df.study_hours_per_week==2.5).sum()),
  "boundary_rows_4.5": int((df.study_hours_per_week==4.5).sum()),
  "groups": {k: {"n":int(r.n),"mean_math":round(float(r.mean_math),4),"std_math":round(float(r.std_math),4),
                 "min_math":int(r.min_math),"max_math":int(r.max_math),
                 "mean_hours":round(float(r.mean_hours),4),"min_hours":float(r.min_hours),"max_hours":float(r.max_hours)}
             for k,r in g.iterrows()},
  "gain_high_minus_low": round(float(high_mean-low_mean),4),
  "ratio_high_over_low": round(float(high_mean/low_mean),4),
  "ttest_high_vs_low": {"t":round(float(t),4),"p":float(p)},
}
outpath = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\cand\OFF-GRP-03-r4\_sandbox\tmp\step1_validation.json"
with open(outpath,"w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print("saved:", outpath)
print(json.dumps(out,ensure_ascii=False,indent=2))

```
