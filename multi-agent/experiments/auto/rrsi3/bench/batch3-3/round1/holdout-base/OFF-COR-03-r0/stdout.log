import pandas as pd
import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from scipy import stats

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp"
csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\holdout-base\OFF-COR-03-r0\_sandbox\offline_data\students.csv"

df = pd.read_csv(csv)
preds = ["study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
y = "math_score"
n = len(df)

# ---------- (a) Correlation heatmap ----------
cols = [y] + preds
corr = df[cols].corr(method="pearson")

fig, ax = plt.subplots(figsize=(7, 6))
im = ax.imshow(corr.values, cmap="RdBu_r", vmin=-1, vmax=1)
ax.set_xticks(range(len(cols)))
ax.set_yticks(range(len(cols)))
ax.set_xticklabels(cols, rotation=35, ha="right", fontsize=9)
ax.set_yticklabels(cols, fontsize=9)
for i in range(len(cols)):
    for j in range(len(cols)):
        ax.text(j, i, f"{corr.values[i, j]:.2f}", ha="center", va="center",
                color="white" if abs(corr.values[i, j]) > 0.55 else "black", fontsize=9)
ax.set_title("Pearson Correlation Matrix — math_score vs predictors\n(offline_data/students.csv, n=400, AS_OF 2026-10-25 09:46)", fontsize=10)
fig.colorbar(im, ax=ax, shrink=0.85, label="Pearson r")
fig.tight_layout()
fig.savefig(f"{out_dir}\\correlation_heatmap.png", dpi=150)
plt.close(fig)

# ---------- (b) Slope bar chart with 95% CI ----------
rows = []
for p in preds:
    x = df[p].astype(float).values
    yv = df[y].astype(float).values
    res = stats.linregress(x, yv)
    # slope SE = res.stderr ; 95% CI via t
    tcrit = stats.t.ppf(0.975, n - 2)
    lo, hi = res.slope - tcrit * res.stderr, res.slope + tcrit * res.stderr
    rows.append({"predictor": p, "slope": res.slope, "lo": lo, "hi": hi,
                 "ci": res.slope - lo})
res_df = pd.DataFrame(rows)

fig, ax = plt.subplots(figsize=(8, 5))
colors = ["#2c7fb8" if s > 0 else "#d7191c" for s in res_df["slope"]]
bars = ax.barh(res_df["predictor"], res_df["slope"], xerr=res_df["ci"],
               capsize=6, color=colors, alpha=0.85, error_kw={"lw": 1.5})
ax.axvline(0, color="black", lw=0.8)
for i, r in res_df.iterrows():
    ax.text(r["slope"] + r["ci"] + 0.15, i, f"{r['slope']:+.2f}", va="center", fontsize=10)
ax.set_xlabel("OLS slope: Δ math_score per 1-unit increase in predictor (95% CI)")
ax.set_title("Simple OLS Slopes: math_score ~ each predictor\n(offline_data/students.csv, n=400, AS_OF 2026-10-25 09:46)", fontsize=10)
ax.invert_yaxis()
fig.tight_layout()
fig.savefig(f"{out_dir}\\ols_slopes_ci.png", dpi=150)
plt.close(fig)

import os
for f in ["correlation_heatmap.png", "ols_slopes_ci.png"]:
    p = os.path.join(out_dir, f)
    print(p, os.path.getsize(p), "bytes")
print(res_df.to_string(index=False))

