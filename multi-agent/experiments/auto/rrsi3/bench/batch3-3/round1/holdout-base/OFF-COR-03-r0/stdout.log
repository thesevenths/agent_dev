```python
import pandas as pd
import numpy as np
from scipy import stats

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\holdout-base\OFF-COR-03-r0\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp"

df = pd.read_csv(csv)
preds = ["study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
y = "math_score"
n = len(df)

# --- Correlation matrix (Pearson) ---
cols = [y] + preds
corr = df[cols].corr(method="pearson")
corr.to_csv(f"{out_dir}\\correlation_matrix.csv", float_format="%.6f")

# correlation p-values
corr_p = {}
for p in preds:
    r, pv = stats.pearsonr(df[p], df[y])
    corr_p[p] = (r, pv)

# --- Simple OLS: math_score ~ each predictor ---
rows = []
for p in preds:
    x = df[p].astype(float).values
    yv = df[y].astype(float).values
    res = stats.linregress(x, yv)
    rows.append({
        "predictor": p,
        "slope": round(res.slope, 6),
        "intercept": round(res.intercept, 6),
        "r_squared": round(res.rvalue**2, 6),
        "p_value": res.pvalue,
        "n": n,
        "pearson_r": round(res.rvalue, 6),
    })
ols = pd.DataFrame(rows)
ols.to_csv(f"{out_dir}\\ols_slopes.csv", index=False, float_format="%.6g")

# combined structured results file
with open(f"{out_dir}\\analysis_results.csv", "w", encoding="utf-8") as f:
    f.write("section,metric,value\n")
    f.write(f"meta,source_csv,offline_data/students.csv\n")
    f.write(f"meta,n_rows,{n}\n")
    f.write(f"meta,missing_values,0\n")
    f.write(f"meta,as_of,2026-10-25 09:45\n")
    f.write("\n")
    f.write("correlation_matrix,pearson_r,p_value\n")
    for p in preds:
        r, pv = corr_p[p]
        f.write(f"math_score_vs_{p},{r:.6f},{pv:.3e}\n")
    f.write("\n")
    f.write("ols_simple,")
    f.write(",".join(ols.columns) + "\n")
    for _, row in ols.iterrows():
        f.write(f"{row['predictor']},{row['slope']},{row['intercept']},{row['r_squared']},{row['p_value']:.3e},{row['n']},{row['pearson_r']}\n")

print(corr.to_string(float_format=lambda v: f"{v:.4f}"))
print()
for p in preds:
    r, pv = corr_p[p]
    print(f"corr(math_score, {p}) = {r:.4f}, p = {pv:.3e}")
print()
print(ols.to_string(index=False))
print()
print("saved:", f"{out_dir}\\analysis_results.csv")

