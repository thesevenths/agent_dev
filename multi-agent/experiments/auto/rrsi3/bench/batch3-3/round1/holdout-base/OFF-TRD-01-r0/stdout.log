import pandas as pd

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv")
df["year"] = df["month"].str[:4]
df["mm"] = df["month"].str[5:7].astype(int)
df["is_q4"] = df["mm"].isin([11, 12])

rows = []
for year, g in df.groupby("year"):
    q4 = g[g["is_q4"]]
    rest = g[~g["is_q4"]]
    q4_sum = q4["units"].sum()
    rest_sum = rest["units"].sum()
    rest_avg = rest_sum / 10  # 10 months
    mult = q4_sum / rest_avg
    rows.append({
        "year": year,
        "nov_dec_units_sum": q4_sum,
        "nov_dec_rows": len(q4),
        "jan_oct_units_sum": rest_sum,
        "jan_oct_rows": len(rest),
        "jan_oct_avg_monthly_units": rest_avg,
        "nov_dec_multiplier": mult,
