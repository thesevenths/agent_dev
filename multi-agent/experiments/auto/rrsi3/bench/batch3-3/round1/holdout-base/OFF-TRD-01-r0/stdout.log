import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)
df['year'] = df['month'].str[:4]
df['mm'] = df['month'].str[5:7].astype(int)
df['is_novdec'] = df['mm'].isin([11, 12])

rows = []
for year, g in df.groupby('year'):
    nd = g[g['is_novdec']]
    other = g[~g['is_novdec']]
    nd_total = nd['units'].sum()
    other_total = other['units'].sum()
    nd_avg = nd_total / 2          # 11-12月共2个月
    other_avg = other_total / 10   # 其余10个月
    rows.append({
        'year': year,
        'novdec_units_total': nd_total,
        'other_months_units_total': other_total,
        'novdec_avg_monthly_units': nd_avg,
        'other_avg_monthly_units': other_avg,
        'amplification_ratio': nd_avg / other_avg,
        'novdec_rows': len(nd),
        'other_rows': len(other),
    })

res = pd.DataFrame(rows)
print(res.to_string
