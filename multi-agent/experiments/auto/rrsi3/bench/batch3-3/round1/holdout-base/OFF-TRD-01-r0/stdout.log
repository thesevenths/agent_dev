import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
months = sorted(df["month"].unique())
print("months:", months)
print("first/last:", months[0], months[-1])

# check completeness: 24 months x 4 regions x 3 lines = 288
combos = df.groupby(["month","region","product_line"]).size()
print("rows per combo min/max:", combos.min(), combos.max())

# sanity: revenue vs units*unit_price
diff = (df["revenue"] - df["units"]*df["unit_price"]).abs()
print("max |revenue - units*unit_price|:", diff.max())

# year coverage
df["year"] = df["month"].str[:4]
print(df.groupby("year").size())
print("\nrevenue range:", df["revenue"].min(), df["revenue"].max())
print("units range:", df["units"].min(), df["units"].max())
print("returns range:", df["returns"].min(), df["returns"].max())

```
