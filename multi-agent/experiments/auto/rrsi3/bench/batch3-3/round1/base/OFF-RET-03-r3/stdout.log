```python
import pandas as pd
import numpy as np
import os, json

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)

# Pearson correlations
corr_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
corr_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] < med]
eq = df[df["retention_d7"] == med]

def grp(g):
    return {
        "n_weeks": int(len(g)),
        "arpu_usd_mean": float(g["arpu_usd"].mean()),
        "cohort_size_sum": int(g["cohort_size"].sum()),
        "retention_d7_min": float(g["retention_d7"].min()),
        "retention_d7_max": float(g["retention_d7"].max()),
        "churn_rate_mean": float(g["churn_rate"].mean()),
    }

res = {
    "n_rows": n,
    "retention_d7_median": float(med),
    "n_equal_to_median": int(len(eq)),
    "pearson_retention_d7_vs_arpu_usd": float(corr_arpu),
    "pearson_retention_d7_vs_churn_rate": float(corr_churn),
    "group_high": grp(high),
    "group_low": grp(low),
    "arpu_ratio_high_over_low": float(high["arpu_usd"].mean() / low["arpu_usd"].mean()),
    "cohort_share_high": float(high["cohort_size"].sum() / df["cohort_size"].sum()),
}

# Save intermediate CSV
rows = [
    {"metric": "pearson_retention_d7_vs_arpu_usd", "value": round(corr_arpu, 6), "n": n, "note": "Pearson, all 60 weekly rows"},
    {"metric": "pearson_retention_d7_vs_churn_rate", "value": round(corr_churn, 6), "n": n, "note": "Pearson, all 60 weekly rows"},
    {"metric": "retention_d7_median", "value": med, "n": n, "note": "median of retention_d7, 60 rows"},
    {"metric": "group_high_arpu_usd_mean", "value": round(high["arpu_usd"].mean(), 6), "n": len(high), "note": "rows with retention_d7 > median"},
    {"metric": "group_high_cohort_size_sum", "value": int(high["cohort_size"].sum()), "n": len(high), "note": "rows with retention_d7 > median"},
    {"metric": "group_low_arpu_usd_mean", "value": round(low["arpu_usd"].mean(), 6), "n": len(low), "note": "rows with retention_d7 < median"},
    {"metric": "group_low_cohort_size_sum", "value": int(low["cohort_size"].sum()), "n": len(low), "note": "rows with retention_d7 < median"},
    {"metric": "arpu_ratio_high_over_low", "value": round(res["arpu_ratio_high_over_low"], 6), "n": n, "note": "derived: high mean / low mean"},
]
csv_path = os.path.join(out_dir, "step2_results.csv")
pd.DataFrame(rows).to_csv(csv_path, index=False)

json_path = os.path.join(out_dir, "step2_results.json")
with open(json_path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))
print("csv:", os.path.abspath(csv_path))
print("json:", os.path.abspath(json_path))

```
