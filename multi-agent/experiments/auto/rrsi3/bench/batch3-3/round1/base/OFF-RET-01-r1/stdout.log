import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-01-r1\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
r = df["retention_d7"]

first = r.iloc[:30]
last = r.iloc[30:]

def stats(s):
    return {
        "n": int(len(s)),
        "mean": float(s.mean()),
        "std_sample_ddof1": float(s.std(ddof=1)),
        "std_pop_ddof0": float(s.std(ddof=0)),
        "min": float(s.min()),
        "max": float(s.max()),
    }

res = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "as_of": "2026-10-25 07:55",
    "data_snapshot_last_modified": "2026-10-23 10:11",
    "overall": stats(r),
    "first_30_weeks_W01_W30": stats(first),
    "last_30_weeks_W31_W60": stats(last),
}
res["diff_mean_last_minus_first"] = float(last.mean() - first.mean())
res["diff_std_sample_last_minus_first"] = float(last.std(ddof=1) - first.std(ddof=1))
res["diff_std_pop_last_minus_first"] = float(last.std(ddof=0) - first.std(ddof=0))

# 2-sigma threshold (report both conventions)
for ddof in (0, 1):
    thr = r.mean() - 2 * r.std(ddof=ddof)
    below = r[r < thr]
    res[f"threshold_mean_minus_2std_ddof{ddof}"] = float(thr)
    res[f"weeks_below_threshold_ddof{ddof}"] = int(len(below))
    res[f"weeks_below_threshold_ddof{ddof}_list"] = below.index.tolist()

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-01-r1\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))

