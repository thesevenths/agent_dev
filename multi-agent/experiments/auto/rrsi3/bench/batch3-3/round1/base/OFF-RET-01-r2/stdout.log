```python
import pandas as pd, numpy as np, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
stats = {
    "n": len(r),
    "first_mean": first.mean(), "first_std": first.std(ddof=1),
    "last_mean": last.mean(), "last_std": last.std(ddof=1),
    "diff_mean": first.mean() - last.mean(),
    "overall_mean": overall_mean, "overall_std": overall_std,
    "threshold": overall_mean - 2*overall_std,
    "below_count": int((r < overall_mean - 2*overall_std).sum()),
    "min": r.min(), "max": r.max(),
    "below_weeks": df.loc[r < overall_mean - 2*overall_std, "week"].tolist(),
}
print(json.dumps(stats, indent=2, ensure_ascii=False))

```
