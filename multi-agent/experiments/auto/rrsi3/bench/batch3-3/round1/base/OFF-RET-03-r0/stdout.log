import pandas as pd, os, json

path = "offline_data/app_metrics.csv"
df = pd.read_csv(path)
assert len(df) == 60

# Correlations (Pearson)
corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] <= med]

stats = {
    "n_total": int(len(df)),
    "retention_d7_median": float(med),
    "corr_retention_arpu": float(corr_arpu),
    "corr_retention_churn": float(corr_churn),
    "high_group": {
        "n": int(len(high)),
        "mean_arpu_usd": float(high["arpu_usd"].mean()),
        "sum_cohort_size": int(high["cohort_size"].sum()),
    },
    "low_group": {
        "n": int(len(low)),
        "mean_arpu_usd": float(low["arpu_usd"].mean()),
        "sum_cohort_size": int(low["cohort_size"].sum()),
    },
}
print(json.dumps(stats, indent=2))

# Save intermediate results CSV
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r0\_sandbox\tmp"
rows = [
    {"metric": "corr_retention_d7_arpu_usd", "value": corr_arpu, "n": 60, "note": "Pearson, 60 rows"},
    {"metric": "corr_retention_d7_churn_rate", "value": corr_churn, "n": 60, "note": "Pearson, 60 rows"},
    {"metric": "retention_d7_median", "value": med, "n": 60, "note": "median of retention_d7, 60 rows"},
    {"metric": "high_group_n", "value": len(high), "n": 60, "note": "retention_d7 > median"},
    {"metric": "high_group_mean_arpu_usd", "value": high["arpu_usd"].mean(), "n": len(high), "note": "mean arpu_usd, high group"},
    {"metric": "high_group_sum_cohort_size", "value": high["cohort_size"].sum(), "n": len(high), "note": "sum cohort_size, high group"},
    {"metric": "low_group_n", "value": len(low), "n": 60, "note": "retention_d7 <= median"},
    {"metric": "low_group_mean_arpu_usd", "value": low["arpu_usd"].mean(), "n": len(low), "note": "mean arpu_usd, low group"},
    {"metric": "low_group_sum_cohort_size", "value": low["cohort_size"].sum(), "n": len(low), "note": "sum cohort_size, low group"},
]
out_csv = os.path.join(out_dir, "step2_intermediate_results.csv")
pd.DataFrame(rows).to_csv(out_csv, index=False)
print("saved:", out_csv)

# also save json for step 3
out_json = os.path.join(out_dir, "step2_stats.json")
with open(out_json, "w", encoding="utf-8") as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)
print("saved:", out_json)

