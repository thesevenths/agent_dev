```python
import pandas as pd, json

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-STAT-02-r2\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-STAT-02-r2\_sandbox\tmp"
df = pd.read_csv(csv_path)
n = len(df)

res = {}
for col in ['math_score', 'reading_score']:
    s = df[col]
    mean = s.mean()
    std = s.std(ddof=1)  # sample std
    med = s.median()
    cv = std / mean
    res[col] = dict(n=n, mean=mean, std=std, median=med, cv=cv,
                    min=int(s.min()), max=int(s.max()))

corr = df['math_score'].corr(df['reading_score'])  # Pearson
res['pearson_corr'] = corr
res['cv_ratio_math_over_reading'] = res['math_score']['cv'] / res['reading_score']['cv']

out_path = os.path.join(out_dir, 'stats_results.json')
with open(out_path, 'w', encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))
print('saved:', out_path)

```
