import pandas as pd
df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-QUA-02-r4\_sandbox\offline_data\regional_sales.csv")
exp = df["units"]*df["unit_price"]
dev = (df["revenue"]-exp).abs()/exp*100
print("rows:", len(df))
print("dev>0.5 count:", int((dev>0.5).sum()))
print("max dev:", dev.max(), "at idx", dev.idxmax())
print("top5 dev:")
print(dev.sort_values(ascending=False).head(5).to_string())
print("returns>units:", int((df["returns"]>df["units"]).sum()))
print("returns==units:", int((df["returns"]==df["units"]).sum()))
print("returns max/units min:", df["returns"].max(), df["units"].min())
print("months:", df["month"].min(), df["month"].max())
print("regions:", sorted(df["region"].unique()))
print("products:", sorted(df["product_line"].unique()))
print("nulls:", int(df.isna().sum().sum()))
print("revenue sum:", df["revenue"].sum())
print("units sum:", df["units"].sum())
print("returns sum:", df["returns"].sum())
print("returns/units overall:", df["returns"].sum()/df["units"].sum()*100)
print("dup rows:", int(df.duplicated().sum()))
print("dup (month,region,product_line):", int(df.duplicated(subset=["month","region","product_line"]).sum()))

