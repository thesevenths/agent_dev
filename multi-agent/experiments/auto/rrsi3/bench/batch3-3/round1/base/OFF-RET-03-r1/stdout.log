import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r1\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)

# Correlations (Pearson)
r_arpu = df['retention_d7'].corr(df['arpu_usd'])
r_churn = df['retention_d7'].corr(df['churn_rate'])

# Spearman for robustness
from scipy import stats
rho_arpu, p_arpu = stats.pearsonr(df['retention_d7'], df['arpu_usd'])
rho_churn, p_churn = stats.pearsonr(df['retention_d7'], df['churn_rate'])
s_arpu, ps_arpu = stats.spearmanr(df['retention_d7'], df['arpu_usd'])
s_churn, ps_churn = stats.spearmanr(df['retention_d7'], df['churn_rate'])

# Median split
med = df['retention_d7'].median()
hi = df[df['retention_d7'] > med]
lo = df[df['retention_d7'] <= med]

stats_rows = [
    {'group': 'above_median', 'n_weeks': len(hi), 'retention_d7_mean': hi['retention_d7'].mean(),
     'arpu_usd_mean': hi['arpu_usd'].mean(), 'churn_rate_mean': hi['churn_rate'].mean(),
     'cohort_size_sum': int(hi['cohort_size'].sum())},
    {'group': 'below_or_equal_median', 'n_weeks': len(lo), 'retention_d7_mean': lo['retention_d7'].mean(),
     'arpu_usd_mean': lo['arpu_usd'].mean(), 'churn_rate_mean': lo['churn_rate'].mean(),
     'cohort_size_sum': int(lo['cohort_size'].sum())},
]
gdf = pd.DataFrame(stats_rows)

corr_df = pd.DataFrame([
    {'pair': 'retention_d7 vs arpu_usd', 'pearson_r': r_arpu, 'p_value': p_arpu, 'spearman_rho': s_arpu, 'spearman_p': ps_arpu, 'n': n},
    {'pair': 'retention_d7 vs churn_rate', 'pearson_r': r_churn, 'p_value': p_churn, 'spearman_rho': s_churn, 'spearman_p': ps_churn, 'n': n},
