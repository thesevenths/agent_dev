import pandas as pd, numpy as np, json

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r1\_sandbox\tmp"

df = pd.read_csv(src)
n = len(df)

# Pearson correlations
r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# Median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] < med]
eq = int((df["retention_d7"] == med).sum())

groups = pd.DataFrame([
    {"group": "high_retention (retention_d7 > median)", "n_weeks": len(hi),
     "arpu_usd_mean": hi["arpu_usd"].mean(), "cohort_size_sum": int(hi["cohort_size"].sum()),
     "retention_d7_min": hi["retention_d7"].min(), "retention_d7_max": hi["retention_d7"].max()},
    {"group": "low_retention (retention_d7 < median)", "n_weeks": len(lo),
     "arpu_usd_mean": lo["arpu_usd"].mean(), "cohort_size_sum": int(lo["cohort_size"].sum()),
     "retention_d7_min": lo["retention_d7"].min(), "retention_d7_max": lo["retention_d7"].max()},
])
groups.to_csv(out_dir + r"\step2_group_stats.csv", index=False, encoding="utf-8-sig")

res = {
    "n_rows": n,
    "pearson_retention_d7_vs_arpu_usd": float(r_arpu),
    "pearson_retention_d7_vs_churn_rate": float(r_churn),
    "retention_d7_median": float(med),
    "rows_equal_to_median": eq,
    "groups": groups.to_dict(orient="records"),
    "arpu_ratio_hi_over_lo": float(hi["arpu_usd"].mean() / lo["arpu_usd"].mean()),
}
with open(out_dir + r"\step2_results.json", "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))

