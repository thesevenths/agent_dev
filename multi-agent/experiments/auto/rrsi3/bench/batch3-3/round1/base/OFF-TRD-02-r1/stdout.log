import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
print(df.shape)
print(df.dtypes)
print(df['product_line'].unique())

g = df.groupby('product_line').agg(
    total_units=('units','sum'),
    total_revenue=('revenue','sum'),
    rows=('revenue','size'),
)
g['avg_unit_price'] = g['total_revenue'] / g['total_units']
g['revenue_share'] = g['total_revenue'] / g['total_revenue'].sum()
print(g)
print('grand total revenue:', df['revenue'].sum())
print('grand total units:', df['units'].sum())

out = g.reset_index()
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-TRD-02-r1\_sandbox\tmp\product_line_summary.csv', index=False)
print(out)

