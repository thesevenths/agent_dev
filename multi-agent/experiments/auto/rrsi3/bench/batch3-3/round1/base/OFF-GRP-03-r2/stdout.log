```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-03-r2\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)

rows = []
for g in ["low","mid","high"]:
    sub = df[df["group"]==g]
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "math_score_mean": round(float(sub["math_score"].mean()), 4),
        "math_score_std": round(float(sub["math_score"].std(ddof=1)), 4),
        "study_hours_mean": round(float(sub["study_hours_per_week"].mean()), 4),
        "study_hours_min": float(sub["study_hours_per_week"].min()),
        "study_hours_max": float(sub["study_hours_per_week"].max()),
    })

res = pd.DataFrame(rows)
low = res[res.group=="low"].iloc[0]
high = res[res.group=="high"].iloc[0]
gain = round(float(high["math_score_mean"] - low["math_score_mean"]), 4)
res.to_csv(os.path.join(out_dir, "group_stats.csv"), index=False)

summary = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "nulls": {"study_hours_per_week": int(df["study_hours_per_week"].isna().sum()),
              "math_score": int(df["math_score"].isna().sum())},
    "groups": rows,
    "low_to_high_gain": gain,
    "overall_math_score_mean": round(float(df["math_score"].mean()), 4),
}
with open(os.path.join(out_dir, "group_stats.json"), "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)

print(res.to_string(index=False))
print("gain:", gain)
print("overall mean:", summary["overall_math_score_mean"])

