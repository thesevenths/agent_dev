```python

import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
n_months = df['month'].nunique()  # 24

# per-region totals
region = df.groupby('region')['revenue'].sum().sort_values(ascending=False)
total_all = region.sum()
share = region / total_all * 100
monthly_avg = region / n_months

summary = pd.DataFrame({
    'total_revenue': region,
    'share_pct': share,
    'monthly_avg_revenue': monthly_avg,
})
print(summary.round(2))
print('grand total:', round(total_all,2))

# peak month per region
pivot = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
print(pivot.round(2))

top_region = region.idxmax()
top_month = pivot[top_region].idxmax()
print('top region:', top_region, region.max())
print('peak month of top region:', top_month, pivot.loc[top_month, top_region])

# also overall peak month per region
for r in ['N','S','E','W']:
    m = pivot[r].idxmax()
    print(r, 'peak', m, round(pivot.loc[m, r],2))

# save intermediate CSV
out = summary.reset_index()
out['peak_month'] = [pivot[r].idxmax() for r in out['region']]
out['peak_month_revenue'] = [round(pivot.loc[pivot[r].idxmax(), r],2) for r in out['region']]
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-TRD-03-r2\_sandbox\tmp\regional_summary.csv', index=False)
print(out)

```
