import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
print(df.shape)
print(df['month'].nunique(), sorted(df['month'].unique())[:3], sorted(df['month'].unique())[-3:])
print(df['region'].unique())

# per-region totals
reg = df.groupby('region')['revenue'].agg(['sum','count'])
reg['share'] = reg['sum']/reg['sum'].sum()*100
reg['monthly_avg'] = reg['sum']/df['month'].nunique()
print(reg)

# monthly per region
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
print(piv)

top_region = reg['sum'].idxmax()
top_month = piv[top_region].idxmax()
print('top region:', top_region, reg.loc[top_region,'sum'])
print('peak month:', top_month, piv.loc[top_month, top_region])

# save intermediate CSV
out = reg.reset_index()
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-TRD-03-r2\_sandbox\tmp\regional_summary.csv', index=False)
piv.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-TRD-03-r2\_sandbox\tmp\regional_monthly.csv')
print('saved')

