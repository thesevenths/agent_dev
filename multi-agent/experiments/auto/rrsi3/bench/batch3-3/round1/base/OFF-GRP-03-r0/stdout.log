import pandas as pd

df = pd.read_csv("offline_data/students.csv")
h = df["study_hours_per_week"]

def group(x):
    if x < 2.5: return "低组(<2.5)"
    elif x <= 4.5: return "中组(2.5-4.5)"
    else: return "高组(>4.5)"

df["group"] = h.map(group)
stats = df.groupby("group", sort=False).agg(
    n=("math_score","count"),
    mean=("math_score","mean"),
    std=("math_score","std"),
    min=("math_score","min"),
    max=("math_score","max"),
    h_mean=("study_hours_per_week","mean"),
)
print(stats.to_string())

low = stats.loc["低组(<2.5)","mean"]; high = stats.loc["高组(>4.5)","mean"]
print("\ngain high-low:", high - low)
print("relative gain %:", (high-low)/low*100)
print("mid-low:", stats.loc["中组(2.5-4.5)","mean"] - low)
print("high-mid:", high - stats.loc["中组(2.5-4.5)","mean"])
print("overall mean:", df["math_score"].mean())

```
