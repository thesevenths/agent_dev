import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")

# per-region aggregates
g = df.groupby('region')['revenue'].agg(['sum','count'])
g['months'] = df.groupby('region')['month'].nunique()
g['monthly_avg'] = g['sum'] / g['months']
grand = df['revenue'].sum()
g['share'] = g['sum'] / grand
g = g.sort_values('sum', ascending=False)
print(g)
print("grand total:", grand, "rows:", len(df))

# monthly revenue per region for top region
top = g.index[0]
monthly = df[df['region']==top].groupby('month')['revenue'].sum().sort_values(ascending=False)
print("top region:", top)
print(monthly.head(3))
peak_month = monthly.idxmax()
print("peak month:", peak_month, monthly.max())

# also monthly totals for all regions (for report context)
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
print(piv.tail(3))

# save artifacts
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-TRD-03-r5\_sandbox\tmp"
g.round(2).to_csv(f"{out_dir}\\step2_region_aggregates.csv")

result = {
    "as_of": "2026-10-25 09:24",
    "source": "offline_data/regional_sales.csv",
    "grand_total_revenue": round(grand,2),
    "total_rows": len(df),
    "months": 24,
    "regions": {r: {"total_revenue": round(row['sum'],2),
                    "share": round(row['share'],6),
                    "monthly_avg": round(row['monthly_avg'],2),
                    "rows": int(row['count'])} for r,row in g.iterrows()},
    "top_region": top,
    "top_region_peak_month": peak_month,
    "top_region_peak_month_revenue": round(monthly.max(),2),
    "top_region_monthly_top3": {m: round(v,2) for m,v in monthly.head(3).items()},
}
with open(f"{out_dir}\\step2_region_aggregates.json","w",encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print("saved")

