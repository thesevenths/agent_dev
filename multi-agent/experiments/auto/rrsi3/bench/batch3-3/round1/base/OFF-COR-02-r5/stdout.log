import pandas as pd, json

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r5\_sandbox\tmp"

df = pd.read_csv(csv_path)
n = len(df)

corr_math = df["screen_hours_per_day"].corr(df["math_score"], method="pearson")
corr_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

res = {
    "source_file": "offline_data/students.csv",
    "sample_size": n,
    "corr_screen_math": corr_math,
    "corr_screen_reading": corr_read,
    "group_high": {
        "definition": "screen_hours_per_day > 5",
        "n": len(hi),
        "math_mean": hi["math_score"].mean(),
        "reading_mean": hi["reading_score"].mean(),
        "screen_mean": hi["screen_hours_per_day"].mean(),
    },
    "group_low": {
        "definition": "screen_hours_per_day <= 5",
        "n": len(lo),
        "math_mean": lo["math_score"].mean(),
        "reading_mean": lo["reading_score"].mean(),
        "screen_mean": lo["screen_hours_per_day"].mean(),
    },
    "diff_math": hi["math_score"].mean() - lo["math_score"].mean(),
    "diff_reading": hi["reading_score"].mean() - lo["reading_score"].mean(),
    "screen_min": df["screen_hours_per_day"].min(),
    "screen_max": df["screen_hours_per_day"].max(),
    "math_mean_all": df["math_score"].mean(),
    "reading_mean_all": df["reading_score"].mean(),
    "screen_mean_all": df["screen_hours_per_day"].mean(),
}
with open(out_dir + r"\step1_correlations.json", "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
