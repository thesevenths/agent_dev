r_read = df["screen_hours_per_day"].corr(df["reading_score"])
out = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "method": "Pearson correlation (pandas .corr, default pearson)",
    "screen_hours_per_day_vs_math_score": round(r_math, 6),
    "screen_hours_per_day_vs_reading_score": round(r_read, 6),
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r5\_sandbox\tmp\step2_correlations.json"
with open(out_path, "w", encoding="utf-8") as f:
