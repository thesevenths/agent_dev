path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = [
    {"metric": "pearson_corr_retention_d7_vs_arpu_usd", "value": corr_arpu, "n": len(df), "note": "Pearson, n=60 周粒度"},
    {"metric": "pearson_corr_retention_d7_vs_churn_rate", "value": corr_churn, "n": len(df), "note": "Pearson, n=60 周粒度"},
    {"metric": "retention_d7_median", "value": med, "n": len(df), "note": "中位数, n=60"},
    {"metric": "group_high_retention_mean_arpu_usd", "value": hi["arpu_usd"].mean(), "n": len(hi), "note": "retention_d7 > 中位数"},
    {"metric": "group_high_retention_sum_cohort_size", "value": hi["cohort_size"].sum(), "n": len(hi), "note": "retention_d7 > 中位数"},
    {"metric": "group_low_retention_mean_arpu_usd", "value": lo["arpu_usd"].mean(), "n": len(lo), "note": "retention_d7 <= 中位数"},
    {"metric": "group_low_retention_sum_cohort_size", "value": lo["cohort_size"].sum(), "n": len(lo), "note": "retention_d7 <= 中位数"},
]
out = pd.DataFrame(rows)
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r2\_sandbox\tmp\step2_results.csv"
out.to_csv(out_path, index=False)
print(out.to_string())
print("saved:", out_path)
print("hi weeks:", list(hi["week"]), "lo weeks:", list(lo["week"]))

