import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-02-r2\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-02-r2\_sandbox\tmp"

df = pd.read_csv(src)
g = df.groupby(['grade','region'])['reading_score'].agg(['count','mean']).reset_index()
g.columns = ['grade','region','row_count','reading_score_mean']
g['reading_score_mean'] = g['reading_score_mean'].round(2)
g = g.sort_values(['grade','region']).reset_index(drop=True)

imax = g['reading_score_mean'].idxmax()
imin = g['reading_score_mean'].idxmin()
hi, lo = g.loc[imax], g.loc[imin]
print(g.to_string(index=False))
print("MAX:", hi.to_dict())
print("MIN:", lo.to_dict())
print("diff:", round(hi['reading_score_mean']-lo['reading_score_mean'],2))
print("ratio:", round(hi['reading_score_mean']/lo['reading_score_mean'],4))
