import pandas as pd
from pathlib import Path

out_dir = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-TRD-03-r4\_sandbox\tmp")
out_dir.mkdir(parents=True, exist_ok=True)

df = pd.read_csv("offline_data/regional_sales.csv")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("nulls:\n", df.isna().sum())
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))

# sanity: revenue == units * unit_price?
df['calc'] = df['units'] * df['unit_price']
diff = (df['calc'] - df['revenue']).abs()
print("max |units*price - revenue|:", diff.max())

# rows per region
print(df.groupby('region').size())
# rows per region-month
print("rows per region-month (should be 3 each):", df.groupby(['region','month']).size().unique())

# quick aggregates for downstream
g = df.groupby('region')['revenue'].sum()
total = g.sum()
print("\nregion totals:\n", g)
print("grand total:", total)
print("shares:\n", (g/total*100).round(2))
print("monthly avg:\n", (g/df['month'].nunique()).round(2))

top_region = g.idxmax()
top_month = df[df['region']==top_region].groupby('month')['revenue'].sum().idxmax()
print("top region:", top_region, "peak month:", top_month)

# save validation summary
summary = {
    "file": "offline_data/regional_sales.csv",
    "rows": int(df.shape[0]),
    "columns": list(df.columns),
    "regions": sorted(df['region'].unique()),
    "months_range": [df['month'].min(), df['month'].max()],
    "n_months": int(df['month'].nunique()),
    "product_lines": sorted(df['product_line'].unique()),
    "null_cells": int(df.isna().sum().sum()),
    "revenue_consistent_with_units_x_price": bool(diff.max() < 0.01),
    "rows_per_region": {k: int(v) for k, v in df.groupby('region').size().items()},
    "rows_per_region_month": int(df.groupby(['region','month']).size().unique()[0]),
}
import json
(out_dir / "step1_csv_validation.json").write_text(json.dumps(summary, indent=2, ensure_ascii=False), encoding='utf-8')
print("\nsaved:", (out_dir / "step1_csv_validation.json").resolve())

