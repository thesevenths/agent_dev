```python
import pandas as pd, json
from pathlib import Path

out_dir = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-TRD-03-r4\_sandbox\tmp")
df = pd.read_csv("offline_data/regional_sales.csv")

n_months = df['month'].nunique()  # 24
g = df.groupby('region')['revenue'].sum()
grand = g.sum()

rows = []
for r in ['N','S','E','W']:
    total = g[r]
    rows.append({
        'region': r,
        'total_revenue': round(total, 2),
        'share_pct': round(total/grand*100, 2),
        'monthly_avg_revenue': round(total/n_months, 2),
        'n_months': n_months,
        'n_rows': int((df['region']==r).sum()),
    })
agg = pd.DataFrame(rows)
agg.to_csv(out_dir / "step2_regional_aggregates.csv", index=False, encoding='utf-8-sig')

# peak month per region
peaks = {}
for r in ['N','S','E','W']:
    s = df[df['region']==r].groupby('month')['revenue'].sum()
    peaks[r] = {'peak_month': s.idxmax(), 'peak_revenue': round(float(s.max()),2)}

top_region = g.idxmax()
result = {
    'as_of': '2026-10-26 05:00',
    'source_file': 'offline_data/regional_sales.csv',
    'n_months': n_months,
    'month_range': [df['month'].min(), df['month'].max()],
    'grand_total_revenue': round(float(grand), 2),
    'regions': rows,
    'peak_month_by_region': peaks,
    'top_region': top_region,
    'top_region_peak_month': peaks[top_region]['peak_month'],
    'top_region_peak_revenue': peaks[top_region]['peak_revenue'],
}
(out_dir / "step2_regional_aggregates.json").write_text(json.dumps(result, indent=2, ensure_ascii=False), encoding='utf-8')
print(agg.to_string(index=False))
print(json.dumps(result, indent=2, ensure_ascii=False))
print("saved:", (out_dir/'step2_regional_aggregates.csv').resolve(), (out_dir/'step2_regional_aggregates.json').resolve())

