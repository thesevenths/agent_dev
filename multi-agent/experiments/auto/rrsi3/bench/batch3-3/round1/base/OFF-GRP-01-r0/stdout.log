import pandas as pd, json

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-01-r0\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-01-r0\_sandbox\tmp\group_stats.json"

df = pd.read_csv(src)
g = df.groupby("tutoring")["math_score"]

n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std(ddof=1)[0]), float(g.std(ddof=1)[1])

# pooled std (equal-variance, df = n0+n1-2)
sp = float(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)) ** 0.5
diff = m1 - m0
d = diff / sp

res = {
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-25 08:52 (local file, no timestamp column; read at this time)",
    "total_rows": int(len(df)),
    "rows_used": int(g.count().sum()),
    "missing_math_score": int(df["math_score"].isna().sum()),
    "groups": {
        "tutoring_0": {"n": n0, "mean": round(m0,4), "std_ddof1": round(s0,4)},
        "tutoring_1": {"n": n1, "mean": round(m1,4), "std_ddof1": round(s1,4)},
    },
    "pooled_std": round(sp,4),
    "mean_diff_t1_minus_t0": round(diff,4),
    "cohens_d": round(d,4),
    "effect_size_label": "small" if abs(d)<0.5 else ("medium" if abs(d)<0.8 else "large"),
}
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
