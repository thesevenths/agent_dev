import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "gt5", False: "le5"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
)
print(g)
le5, gt5 = g.loc["le5"], g.loc["gt5"]
diff_math = gt5["mean_math"] - le5["mean_math"]
diff_read = gt5["mean_reading"] - le5["mean_reading"]
out = {
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "le5": {k: round(v,6) for k,v in le5.items()},
    "gt5": {k: round(v,6) for k,v in gt5.items()},
    "diff_gt5_minus_le5": {"math_score": round(diff_math,6), "reading_score": round(diff_read,6)},
}
print(json.dumps(out, indent=2))
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

