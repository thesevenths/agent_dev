import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day", "math_score", "reading_score"]
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
# also spearman for robustness
from scipy.stats import pearsonr, spearmanr
pm, pm_p = pearsonr(df["screen_hours_per_day"], df["math_score"])
pr, pr_p = pearsonr(df["screen_hours_per_day"], df["reading_score"])
sm, sm_p = spearmanr(df["screen_hours_per_day"], df["math_score"])
sr, sr_p = spearmanr(df["screen_hours_per_day"], df["reading_score"])

out = {
  "as_of": "2026-10-26 03:15",
  "source_file": "offline_data/students.csv",
  "n_rows": n,
  "missing_values": 0,
  "pearson": {
    "screen_hours_per_day_vs_math_score": {"r": round(pm,6), "p_value": pm_p, "n": n},
    "screen_hours_per_day_vs_reading_score": {"r": round(pr,6), "p_value": pr_p, "n": n}
  },
  "spearman": {
    "screen_hours_per_day_vs_math_score": {"rho": round(sm,6), "p_value": sm_p, "n": n},
    "screen_hours_per_day_vs_reading_score": {"rho": round(sr,6), "p_value": sr_p, "n": n}
  }
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", path)

