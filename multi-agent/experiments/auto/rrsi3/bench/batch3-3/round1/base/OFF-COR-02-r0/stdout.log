import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
# p-values via scipy if available
try:
    from scipy import stats
    p_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"]).pvalue
    p_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"]).pvalue
except Exception as e:
    p_math = p_read = None
    print("scipy err", e)
out = {
    "n": n,
    "corr_screen_math": round(r_math, 6),
    "corr_screen_reading": round(r_read, 6),
    "p_screen_math": p_math,
    "p_screen_reading": p_read,
}
print(out)
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

```
