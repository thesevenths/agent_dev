df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "screen>5", False: "screen<=5"})

rows = []
for g in ["screen<=5", "screen>5"]:
    sub = df[df["group"] == g]
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "mean_screen_hours_per_day": round(sub["screen_hours_per_day"].mean(), 4),
        "mean_math_score": round(sub["math_score"].mean(), 4),
        "mean_reading_score": round(sub["reading_score"].mean(), 4),
        "std_math_score": round(sub["math_score"].std(), 4),
        "std_reading_score": round(sub["reading_score"].std(), 4),
    })

low = df[df["screen_hours_per_day"] <= 5]
high = df[df["screen_hours_per_day"] > 5]
diff_math = high["math_score"].mean() - low["math_score"].mean()
diff_read = high["reading_score"].mean() - low["reading_score"].mean()

out = {
    "as_of": "2026-10-26 03:16",
    "source_file": "offline_data/students.csv",
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "n_total": int(len(df)),
    "groups": rows,
    "mean_difference_high_minus_low": {
        "math_score": round(diff_math, 4),
        "reading_score": round(diff_read, 4),
        "note": "mean(screen>5) - mean(screen<=5)"
    }
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.json"
with open(path, "w", encoding="utf-8") as f:
