import pandas as pd, json
from scipy import stats

df = pd.read_csv("offline_data/students.csv")
n = len(df)

results = {"n": n, "as_of": "2026-10-26 03:47", "source": "offline_data/students.csv"}
for score in ["math_score", "reading_score"]:
    r, p = stats.pearsonr(df["screen_hours_per_day"], df[score])
    results[score] = {"pearson_r": r, "p_value": p, "n": n}
    print(score, r, p)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r4\_sandbox\tmp\step2_correlations.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(results, f, indent=2, ensure_ascii=False)
print("saved", out)

