import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df.screen_hours_per_day.corr(df.math_score)
r_read = df.screen_hours_per_day.corr(df.reading_score)
# also p-values via scipy if available
try:
    from scipy import stats
    p_math = stats.pearsonr(df.screen_hours_per_day, df.math_score).pvalue
    p_read = stats.pearsonr(df.screen_hours_per_day, df.reading_score).pvalue
except Exception as e:
    p_math = p_read = None
    print("scipy err:", e)
out = {
  "source_file": "offline_data/students.csv",
  "n": n,
  "missing_in_key_cols": 0,
  "pearson": {
    "screen_hours_per_day_vs_math_score": {"r": round(r_math,6), "p_value": p_math, "n": n},
    "screen_hours_per_day_vs_reading_score": {"r": round(r_read,6), "p_value": p_read, "n": n}
  }
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r4\_sandbox\tmp\step2_correlations.json"
with open(path,"w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print(json.dumps(out,ensure_ascii=False,indent=2))
print("saved:", path)

```
