import pandas as pd

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r3\_sandbox\tmp"

df = pd.read_csv(p)
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# group assignment
sub["group"] = sub.week.apply(lambda w: "W30-W36" if w <= "W36" else "W37-W43")

# group means
g = sub.groupby("group")[metrics].mean().reset_index()
print(g.to_string())

# per-week with week-over-week deltas
sub["retention_d7_wow"] = sub.retention_d7.diff()
sub["churn_rate_wow"] = sub.churn_rate.diff()
sub["arpu_usd_wow"] = sub.arpu_usd.diff()
print(sub.to_string())

# breakpoint: week with largest combined normalized shift vs previous week
# use z-score of wow delta within W30-W43 for each metric, sum absolute
import numpy as np
score = pd.DataFrame(index=sub.week)
for m in metrics:
    d = sub[m + "_wow"]
    z = (d - d.mean()) / d.std()
    score[m] = z.abs()
score["total"] = score.sum(axis=1)
print(score.sort_values("total", ascending=False).head(5))

# save intermediate CSV
out = sub[["week", "group"] + metrics + ["retention_d7_wow", "churn_rate_wow", "arpu_usd_wow"]].copy()
out_path = out_dir + r"\step2_breakpoint_results.csv"
out.to_csv(out_path, index=False)
print("saved:", out_path)

# also save group means
g_path = out_dir + r"\step2_group_means.csv"
g.to_csv(g_path, index=False)
print("saved:", g_path)

