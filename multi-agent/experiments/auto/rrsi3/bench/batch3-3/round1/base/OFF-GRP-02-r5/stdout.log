import pandas as pd

src = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-02-r5\_sandbox\offline_data\students.csv'
out_dir = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-02-r5\_sandbox\tmp'

df = pd.read_csv(src)
print(df.shape)
print(df['region'].unique())
print(df[['grade','region','reading_score']].isna().sum())

grades = ['G10','G11','G12']
regions = ['A','B','C','D']
sub = df[df['grade'].isin(grades) & df['region'].isin(regions)]

g = sub.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g = g.set_index(['grade','region']).reindex(pd.MultiIndex.from_product([grades, regions]))
g = g.rename(columns={'count':'row_count','mean':'mean_reading_score'}).reset_index()
g['mean_reading_score'] = g['mean_reading_score'].round(4)
print(g.to_string(index=False))

g.to_csv(out_dir + r'\offline_data\grade_region_cross.csv', index=False)

hi = g.loc[g['mean_reading_score'].idxmax()]
lo = g.loc[g['mean_reading_score'].idxmin()]
ext = pd.DataFrame([
    {'cell_type':'max','grade':hi['grade'],'region':hi['region'],'row_count':int(hi['row_count']),'mean_reading_score':hi['mean_reading_score']},
    {'cell_type':'min','grade':lo['grade'],'region':lo['region'],'row_count':int(lo['row_count']),'mean_reading_score':lo['mean_reading_score']},
])
ext.to_csv(out_dir + r'\offline_data\grade_region_extremes.csv', index=False)
print(ext.to_string(index=False))
print('total rows in sub:', len(sub), 'of', len(df))

```
