g = df.groupby("region")["revenue"].agg(total="sum", n_rows="count")
g["months"] = df.groupby("region")["month"].nunique()
g["monthly_avg"] = g["total"] / g["months"]
total_all = df["revenue"].sum()
g["share"] = g["total"] / total_all
g = g.sort_values("total", ascending=False)
print(g)
print("grand total:", total_all, "rows:", len(df))

rm = df.groupby(["region", "month"])["revenue"].sum().reset_index()
rm = rm.sort_values("revenue", ascending=False)
print(rm.head(8))

top = g.index[0]
peak = rm[rm.region == top].sort_values("revenue", ascending=False).iloc[0]
print("top region:", top, "peak month:", peak["month"], peak["revenue"])

g.reset_index().to_csv(f"{out_dir}\\step2_regional_aggregates.csv", index=False, float_format="%.2f")
rm.to_csv(f"{out_dir}\\step2_region_month_revenue.csv", index=False, float_format="%.2f")
print("saved")

