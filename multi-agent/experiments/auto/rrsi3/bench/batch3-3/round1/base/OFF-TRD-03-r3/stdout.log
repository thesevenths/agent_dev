df = pd.read_csv("offline_data/regional_sales.csv")
# extra context for report: top region's monthly trend & runner-up peak
rm = df.groupby(["region","month"])["revenue"].sum().reset_index()
e = rm[rm.region=="E"].sort_values("month")
print(e.tail(6).to_string(index=False))
print("E 2025-12 vs 2024-12:", e[e.month=="2025-12"].revenue.iloc[0], e[e.month=="2024-12"].revenue.iloc[0])
# gap E vs S
print("gap E-S:", 31976756.96-31868486.94)
# top-5 region-month overall
print(rm.sort_values("revenue",ascending=False).head(5).to_string(index=False))

```
