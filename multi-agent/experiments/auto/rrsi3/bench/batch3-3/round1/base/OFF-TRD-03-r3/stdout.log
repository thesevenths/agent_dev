import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

out = {}
out["file"] = os.path.abspath(path)
out["columns"] = list(df.columns)
out["n_rows"] = int(len(df))
out["regions"] = sorted(df["region"].unique().tolist())
out["months"] = [df["month"].min(), df["month"].max()]
out["n_months"] = int(df["month"].nunique())
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["nulls"] = {c: int(df[c].isna().sum()) for c in df.columns}
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}

# consistency check: revenue vs units*unit_price
df["calc"] = df["units"] * df["unit_price"]
out["max_rev_diff"] = float((df["revenue"] - df["calc"]).abs().max())

# rows per region
out["rows_per_region"] = df.groupby("region").size().to_dict()

# region totals
g = df.groupby("region")["revenue"].agg(["sum", "count"])
total = g["sum"].sum()
g["share"] = g["sum"] / total
g["monthly_avg"] = g["sum"] / df["month"].nunique()
out["region_totals"] = {r: {"sum": float(g.loc[r,"sum"]), "share": float(g.loc[r,"share"]),
                             "monthly_avg": float(g.loc[r,"monthly_avg"]), "n_rows": int(g.loc[r,"count"])}
                        for r in g.index}
out["grand_total"] = float(total)

# monthly totals per region
mt = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
out["monthly_by_region"] = mt.round(2).to_dict()
top_region = g["sum"].idxmax()
peak_month = mt[top_region].idxmax()
out["top_region"] = top_region
out["top_region_peak_month"] = peak_month
out["top_region_peak_value"] = float(mt.loc[peak_month, top_region])

# also overall peak month per region for context
out["peak_by_region"] = {r: {"month": str(mt[r].idxmax()), "value": float(mt[r].max())} for r in mt.columns}

os.makedirs("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch3-3\\round1\\base\\OFF-TRD-03-r3\\_sandbox\\tmp", exist_ok=True)
dest = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-TRD-03-r3\_sandbox\tmp\step1_validation.json"
with open(dest, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("SAVED:", dest)

```
