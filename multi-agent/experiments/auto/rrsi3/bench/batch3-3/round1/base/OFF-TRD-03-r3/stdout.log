```python
import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

out = {}
out["file"] = os.path.abspath(path)
out["columns"] = list(df.columns)
out["n_rows"] = int(len(df))
out["regions"] = sorted(df["region"].unique().tolist())
out["months"] = [df["month"].min(), df["month"].max()]
out["n_months"] = int(df["month"].nunique())
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["nulls"] = {c: int(df[c].isna().sum()) for c in df.columns}
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}

# consistency check: revenue vs units*unit_price
df["calc"] = df["units"] * df["unit_price"]
out["max_rev_diff"] = float((df["revenue"] - df["calc"]).abs().max())

# rows per region
out["rows_per_region"] = df.groupby("region").size().to_dict()

# region totals
g = df.groupby("region")["revenue"].agg(["sum", "count"])
total = g["sum"].sum()
g["share"] = g["sum"] / total
g["monthly_avg"] = g["sum"] / df["month"].n
