```python
import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r4\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# Group means
pre = df[df["week"].isin([f"W{i:02d}" for i in range(30, 37)])]
post = df[df["week"].isin([f"W{i:02d}" for i in range(37, 44)])]

means = pd.DataFrame({
    "group": ["W30-W36 (pre)", "W37-W43 (post)"],
    "n": [len(pre), len(post)],
    **{m: [pre[m].mean(), post[m].mean()] for m in metrics},
})
diff = post[metrics].mean() - pre[metrics].mean()
pct = diff / pre[metrics].mean() * 100

print(means.to_string(index=False))
print("\nDiff (post - pre):\n", diff.round(6))
print("\nPct change:\n", pct.round(4))

# Per-week table with week-over-week deltas to pinpoint breakpoint
win = df[df["week"].isin([f"W{i:02d}" for i in range(30, 44)])].copy()
for m in metrics:
    win[f"delta_{m}"] = win[m].diff()
print("\nPer-week with deltas:\n", win.to_string(index=False))

# Largest absolute week-over-week jump per metric
for m in metrics:
    d = win.dropna(subset=[f"delta_{m}"]).copy()
    d["abs"] = d[f"delta_{m}"].abs()
    top = d.loc[d["abs"].idxmax()]
    print(f"\nLargest |WoW delta| for {m}: at {top['week']}, delta={top[f'delta_{m}']:.4f}")

# Save intermediate CSV
out = pd.DataFrame({
    "group": ["W30-W36 (pre)", "W37-W43 (post)"],
    "n": [len(pre), len(post)],
    **{f"mean_{m}": [pre[m].mean(), post[m].mean()] for m in metrics},
    **{f"std_{m}": [pre[m].std(ddof=1), post[m].std(ddof=1)] for m in metrics},
})
out.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)

win.to_csv(f"{out_dir}\\step2_per_week_w30_w43.csv", index=False)
print("\nSaved:", f"{out_dir}\\step2_group_means.csv")
print("Saved:", f"{out_dir}\\step2_per_week_w30_w43.csv")

```
