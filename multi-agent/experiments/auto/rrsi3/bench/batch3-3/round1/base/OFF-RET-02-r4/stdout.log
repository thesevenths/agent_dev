import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df.week.between("W30","W43")].copy()
sub["group"] = sub.week.apply(lambda w: "W30-W36" if int(w[1:])<=36 else "W37-W43")

cols = ["retention_d7","churn_rate","arpu_usd"]
means = sub.groupby("group")[cols].mean()
print(means)

# per-week deltas
sub["ret_d"] = sub.retention_d7.diff()
sub["churn_d"] = sub.churn_rate.diff()
sub["arpu_d"] = sub.arpu_usd.diff()
print(sub[["week","retention_d7","churn_rate","arpu_usd","ret_d","churn_d","arpu_d"]].to_string())

# relative changes
pre, post = means.loc["W30-W36"], means.loc["W37-W43"]
for c in cols:
    print(c, "abs diff:", post[c]-pre[c], "rel %:", (post[c]-pre[c])/pre[c]*100)

# save intermediate CSV
out = sub[["week","group","retention_d7","churn_rate","arpu_usd","ret_d","churn_d","arpu_d"]].copy()
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r4\_sandbox\tmp\step2_weekly_values.csv", index=False)

means_out = means.reset_index()
means_out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r4\_sandbox\tmp\step2_group_means.csv", index=False)
print("saved")

