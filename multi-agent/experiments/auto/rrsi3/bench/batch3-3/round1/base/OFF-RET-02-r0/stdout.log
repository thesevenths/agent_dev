```python
import pandas as pd
import numpy as np

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(src)
sl = df[df['week'].between('W30','W43')].copy()
metrics = ['retention_d7','churn_rate','arpu_usd']

# per-week table with group label and week-over-week delta
sl['group'] = np.where(sl['week'].between('W30','W36'), 'W30-W36', 'W37-W43')
per = sl[['week','group'] + metrics].copy()
for m in metrics:
    per[f'{m}_wow_delta'] = per[m].diff()

# group means
means = sl.groupby('group')[metrics].mean().loc[['W30-W36','W37-W43']]
n = sl.groupby('group').size()

# diff & relative change
diff = means.loc['W37-W43'] - means.loc['W30-W36']
rel = diff / means.loc['W30-W36']

# breakpoint detection: week with max |WoW delta| for each metric within W31-W43
bp = {}
for m in metrics:
    d = per.set_index('week')[f'{m}_wow_delta'].dropna()
    # signed magnitude: for retention, drop is negative; use |delta|
    w = d.abs().idxmax()
    bp[m] = (w, d[w])
print("per-week:\n", per.to_string(index=False))
print("\nmeans:\n", means)
print("\nn:\n", n)
print("\ndiff (W37-43 minus W30-36):\n", diff)
print("\nrelative change:\n", rel)
print("\nbreakpoint week per metric (max |WoW|):", bp)

# also check W36->W37 delta specifically
w36 = sl[sl['week']=='W36'].iloc[0]; w37 = sl[sl['week']=='W37'].iloc[0]
print("\nW36->W37 delta:")
for m in metrics:
    print(f"  {m}: {w37[m]-w36[m]:+.6f} ({(w37[m]-w36[m])/w36[m]*100:+.2f}%)")

# save intermediate CSVs
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r0\_sandbox\tmp"
per.to_csv(rf"{outdir}\step2_per_week.csv", index=False)

summary = pd.DataFrame({
    'metric': metrics,
    'mean_W30_W36': [means.loc['W30-W36', m] for m in metrics],
    'mean_W37_W43': [means.loc['W37-W43', m] for m in metrics],
    'abs_diff': [diff[m] for m in metrics],
    'rel_change_pct': [rel[m]*100 for m in metrics],
    'breakpoint_week': [bp[m][0] for m in metrics],
    'breakpoint_wow_delta': [bp[m][1] for m in metrics],
})
summary.to_csv(rf"{outdir}\step2_group_summary.csv", index=False)
print("\nsaved step2_per_week.csv and step2_group_summary.csv")
print(summary.to_string(index=False))

```
