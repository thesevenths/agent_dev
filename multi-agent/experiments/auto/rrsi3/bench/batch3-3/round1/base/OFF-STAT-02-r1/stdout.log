import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-STAT-02-r1\_sandbox"
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
print(df.head())
print(df.shape)
print(df.dtypes)
print("nulls:", df[["math_score","reading_score"]].isna().sum().to_dict())

m = df["math_score"]; r = df["reading_score"]
res = {
    "n_rows": int(len(df)),
    "n_math": int(m.notna().sum()),
    "n_reading": int(r.notna().sum()),
    "math": {"mean": m.mean(), "std_sample": m.std(ddof=1), "std_pop": m.std(ddof=0), "median": m.median(), "min": m.min(), "max": m.max()},
    "reading": {"mean": r.mean(), "std_sample": r.std(ddof=1), "std_pop": r.std(ddof=0), "median": r.median(), "min": r.min(), "max": r.max()},
    "pearson": float(m.corr(r, method="pearson")),
}
res["math"]["cv_sample"] = res["math"]["std_sample"]/res["math"]["mean"]
res["reading"]["cv_sample"] = res["reading"]["std_sample"]/res["reading"]["mean"]
res["math"]["cv_pop"] = res["math"]["std_pop"]/res["math"]["mean"]
res["reading"]["cv_pop"] = res["reading"]["std_pop"]/res["reading"]["mean"]

out = os.path.join(base, "tmp", "stats_results.json")
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, indent=2))
print("saved:", out)

```
