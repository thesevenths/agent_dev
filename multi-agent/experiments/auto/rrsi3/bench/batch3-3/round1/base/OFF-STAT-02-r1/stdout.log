m = df["math_score"]; r = df["reading_score"]
f = lambda x: float(x)
res = {
    "n_rows": int(len(df)),
    "n_math": int(m.notna().sum()),
    "n_reading": int(r.notna().sum()),
    "math": {"mean": f(m.mean()), "std_sample": f(m.std(ddof=1)), "std_pop": f(m.std(ddof=0)), "median": f(m.median()), "min": f(m.min()), "max": f(m.max())},
    "reading": {"mean": f(r.mean()), "std_sample": f(r.std(ddof=1)), "std_pop": f(r.std(ddof=0)), "median": f(r.median()), "min": f(r.min()), "max": f(r.max())},
    "pearson": f(m.corr(r, method="pearson")),
}
res["math"]["cv_sample"] = res["math"]["std_sample"]/res["math"]["mean"]
res["reading"]["cv_sample"] = res["reading"]["std_sample"]/res["reading"]["mean"]
res["math"]["cv_pop"] = res["math"]["std_pop"]/res["math"]["mean"]
res["reading"]["cv_pop"] = res["reading"]["std_pop"]/res["reading"]["mean"]

out = os.path.join(base, "tmp", "stats_results.json")
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, "w", encoding="utf-8") as fh:
    json.dump(res, fh, ensure_ascii=False, indent=2)
print(json.dumps(res, indent=2))
print("saved:", out)

