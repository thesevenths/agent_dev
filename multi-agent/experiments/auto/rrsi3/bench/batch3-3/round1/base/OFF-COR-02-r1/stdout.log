import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day","math_score","reading_score"]
n = len(df)

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

# also Spearman for robustness
from scipy import stats
p_math, pv_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"])
p_read, pv_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"])
s_math, sv_math = stats.spearmanr(df["screen_hours_per_day"], df["math_score"])
s_read, sv_read = stats.spearmanr(df["screen_hours_per_day"], df["reading_score"])

res = {
  "n": n,
  "pearson": {
    "screen_vs_math": {"r": r_math, "p": pv_math},
    "screen_vs_reading": {"r": r_read, "p": pv_read},
  },
  "spearman": {
    "screen_vs_math": {"rho": s_math, "p": sv_math},
    "screen_vs_reading": {"rho": s_read, "p": sv_read},
  },
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r1\_sandbox\tmp"
with open(os.path.join(out_dir,"step2_correlations.json"),"w",encoding="utf-8") as f:
    json.dump(res,f,ensure_ascii=False,indent=2)
pd.DataFrame([
    {"pair":"screen_hours_per_day vs math_score","pearson_r":r_math,"pearson_p":pv_math,"spearman_rho":s_math,"spearman_p":sv_math},
    {"pair":"screen_hours_per_day vs reading_score","pearson_r":r_read,"pearson_p":pv_read,"spearman_rho":s_read,"spearman_p":sv_read},
]).to_csv(os.path.join(out_dir,"step2_correlations.csv"),index=False)
print(json.dumps(res,indent=2))

