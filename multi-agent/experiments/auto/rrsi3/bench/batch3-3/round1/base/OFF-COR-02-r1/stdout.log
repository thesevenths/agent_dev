```python
import pandas as pd, json, os
from scipy import stats

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True:"high_gt5", False:"low_le5"})

rows = []
for g, sub in df.groupby("group"):
    rows.append({
        "group": g,
        "n": len(sub),
        "screen_mean": sub["screen_hours_per_day"].mean(),
        "math_mean": sub["math_score"].mean(),
        "reading_mean": sub["reading_score"].mean(),
        "math_std": sub["math_score"].std(),
        "reading_std": sub["reading_score"].std(),
    })
g = pd.DataFrame(rows)
print(g)

hi = df[df["screen_hours_per_day"]>5]; lo = df[df["screen_hours_per_day"]<=5]
diff_math = hi["math_score"].mean() - lo["math_score"].mean()
diff_read = hi["reading_score"].mean() - lo["reading_score"].mean()
t_math, p_math = stats.ttest_ind(hi["math_score"], lo["math_score"])
t_read, p_read = stats.ttest_ind(hi["reading_score"], lo["reading_score"])

res = {
  "groups": rows,
  "mean_diff_high_minus_low": {
     "math_score": {"diff": diff_math, "t": t_math, "p": p_math},
     "reading_score": {"diff": diff_read, "t": t_read, "p": p_read},
  },
  "total_n": len(df),
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r1\_sandbox\tmp"
with open(os.path.join(out_dir,"step3_group_stats.json"),"w",encoding="utf-8") as f:
    json.dump(res,f,ensure_ascii=False,indent=2)
g.to_csv(os.path.join(out_dir,"step3_group_stats.csv"),index=False)
print(json.dumps(res,indent=2))

```
