import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high_gt5", False: "low_le5"})

g = df.groupby("group").agg(
    n=("student_id", "count"),
    mean_screen=("screen_hours_per_day", "mean"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
)
print(g)

low = g.loc["low_le5"]; high = g.loc["high_gt5"]
diff_math = high["mean_math"] - low["mean_math"]
diff_reading = high["mean_reading"] - low["mean_reading"]

out = {
    "source_file": "offline_data/students.csv",
    "split_rule": "high: screen_hours_per_day > 5; low: screen_hours_per_day <= 5",
    "n_total": len(df),
    "groups": {
        "low_le5": {"n": int(low["n"]), "mean_screen_hours_per_day": low["mean_screen"],
                    "mean_math_score": low["mean_math"], "mean_reading_score": low["mean_reading"]},
        "high_gt5": {"n": int(high["n"]), "mean_screen_hours_per_day": high["mean_screen"],
                     "mean_math_score": high["mean_math"], "mean_reading_score": high["mean_reading"]},
    },
    "mean_difference_high_minus_low": {
        "math_score": diff_math,
        "reading_score": diff_reading,
    },
}
print(json.dumps(out, indent=2))

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r3\_sandbox\tmp\step3_group_stats.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved:", path)

