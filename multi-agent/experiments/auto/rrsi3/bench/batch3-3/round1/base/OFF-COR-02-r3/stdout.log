import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
n = len(df)

r_math = df["screen_hours_per_day"].corr(df["math_score"], method="pearson")
r_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")

# p-values via scipy if available
try:
    from scipy import stats
    p_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"])[1]
    p_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"])[1]
except Exception as e:
    p_math = p_read = None
    print("scipy unavailable:", e)

out = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "method": "Pearson correlation",
    "screen_hours_per_day_vs_math_score": {"r": r_math, "p_value": p_math},
    "screen_hours_per_day_vs_reading_score": {"r": r_read, "p_value": p_read},
}
print(json.dumps(out, indent=2))

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r3\_sandbox\tmp\step2_correlations.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved:", path)

```
