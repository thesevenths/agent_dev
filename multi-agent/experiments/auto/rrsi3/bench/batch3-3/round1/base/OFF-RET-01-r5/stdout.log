import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"].astype(float)
n = len(r)
first, last = r.iloc[:30], r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

res = pd.DataFrame({
    "metric": ["first30_mean","first30_std","last30_mean","last30_std","diff_mean_last_minus_first",
               "overall_mean","overall_std","threshold_mean_minus_2std","weeks_below_threshold","total_weeks"],
    "value": [first.mean(), first.std(ddof=1), last.mean(), last.std(ddof=1),
              last.mean()-first.mean(), overall_mean, overall_std, threshold, len(below), n]
})
print(res.to_string(index=False))
print("below weeks:", list(below.index))
print("min/max:", r.min(), r.max())

out = r.to_frame("retention_d7")
out["below_mean_minus_2std"] = out["retention_d7"] < threshold
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-01-r5\_sandbox\tmp\retention_d7_stats.csv", index=False)
res.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-01-r5\_sandbox\tmp\retention_d7_summary.csv", index=False)
print("saved")

