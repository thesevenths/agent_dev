import pandas as pd, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-01-r5\_sandbox\tmp"
df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]

first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
    "as_of": "2026-10-25 08:30",
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": [df['week'].iloc[0], df['week'].iloc[29]], "n": 30,
                "mean": first30.mean(), "std_ddof1": first30.std(ddof=1)},
    "last30": {"weeks": [df['week'].iloc[30], df['week'].iloc[59]], "n": 30,
               "mean": last30.mean(), "std_ddof1": last30.std(ddof=1)},
    "diff_mean_first_minus_last": first30.mean() - last30.mean(),
    "overall": {"n": 60, "mean": overall_mean, "std_ddof1": overall_std},
    "threshold_mean_minus_2std": threshold,
    "weeks_below_threshold": int((r < threshold).sum()),
    "weeks_below_threshold_list": below["week"].tolist(),
    "weeks_below_threshold_values": below["retention_d7"].tolist(),
}
with open(os.path.join(out_dir, "step2_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

