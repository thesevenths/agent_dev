\n\nraw = pd.read_csv(RAW)\nrat = pd.read_csv(RAT)\n\n# ---- top-3 anomaly combos (by ratio) -------------------------------------\ntop3 = rat.dropna(subset=["volume_ratio_24m"]).nlargest(3, "volume_ratio_24m").copy()\n\n# merge returns from raw for the flagged months\nm = top3.merge(raw[["month", "region", "product_line", "returns", "unit_price", "revenue"]],\n               on=["month", "region", "product_line"], how="left")\nm["return_rate"] = m["returns"] / m["units"]\n\nsummary = m[["region", "product_line", "month", "units", "rolling_mean_24m",\n             "volume_ratio_24m", "returns", "return_rate"]].copy()\nsummary.to_csv(SUM_CSV, index=False, encoding="utf-8-sig")\n\n# ---- stuffing assessment signals per combo --------------------------------\nrows = []\nfor _, r in summary.iterrows():\n    sub = raw[(raw.region == r.region) & (raw.product_line == r.product_line)].sort_values("month")\n    idx = list(sub.month).index(r.month)\n    prev3 = sub.iloc[max(0, idx - 3):idx]\n    nxt = sub.iloc[idx + 1] if idx + 1 < len(sub) else None\n    prev3_rr = prev3.returns.sum() / prev3.units.sum()\n    prev3_units = prev3.units.mean()\n    nxt_units = nxt.units if nxt is not None else None\n    nxt_rr = (nxt.returns / nxt.units) if nxt is not None else None\n    # next-month drop-off: ratio of next month units to spike month units\n    dropoff = (nxt_units / r.units) if nxt_units is not None else None\n    # sustained? next month still above 1.2x its own 24m mean?\n    nxt_row = rat[(rat.region == r.region) & (rat.product_line == r.product_line) & (rat.month == nxt.month)] if nxt is not None else None\n    nxt_ratio = float(nxt_row.volume_ratio_24m.iloc[0]) if nxt_row is not None and len(nxt_row) else None\n    rows.append({\n        "region": r.region, "product_line": r.product_line, "month": r.month,\n        "spike_units": r.units, "spike_return_rate": round(r.return_rate, 4),\n        "prev3m_return_rate": round(prev3_rr, 4),\n        "prev3m_avg_units": round(prev3_units, 1),\n        "next_month_units": nxt_units, "next_month_return_rate": round(nxt_rr, 4) if nxt_rr is not None else None,\n        "next_month_units_vs_spike": round(dropoff, 4) if dropoff is not None else None,\n        "next_month_ratio_24m": round(nxt_ratio, 4) if nxt_ratio is not None else None,\n    })\nassess = pd.DataFrame(rows)\nassess.to_csv(ASSESS_CSV, index=False, encoding="utf-8-sig")\n\n# ---- context numbers for the report ---------------------------------------\nn_rows = len(raw)\nn_months = raw.month.nunique()\nn_groups = raw.groupby(["region", "product_line"]).ngroups\n# region E total units 2025-03 vs other regions same month\ne03 = raw[(raw.region == "E") & (raw.month == "2025-03")].units.sum()\noth03 = raw[(raw.region != "E") & (raw.month == "2025-03")].units.sum()\n# region E 2025-02 and 2025-04 totals\ne02 = raw[(raw.region == "E") & (raw.month == "2025-02")].units.sum()\ne04 = raw[(raw.region == "E") & (raw.month == "2025-04")].units.sum()\n# E Accessory return rate trend: 2025-01..2025-05\nea = raw[(raw.region == "E") & (raw.product_line == "Accessory") & (raw.month >= "2025-01") & (raw.month <= "2025-05")].sort_values("month")\nea_rr = (ea.returns / ea.units).round(4).tolist()\nea_m = ea.month.tolist()\n\n# ---- build markdown --------------------------------------------------------\ndef src(col, agg, n):\n    return f"（来源：offline_data/regional_sales.csv 的 {col}，{agg}，样本 {n} 行）"\n\ndef calc():\n    return "（来源：由前述两行计算）"\n\nL = []\nL.append("# Volume Anomaly Analysis Report")\nL.append("")\nL.append(f"AS_OF: 2026-10-25 07:59（本地离线数据，非实时；数据窗口 {raw.month.min()} ~ {raw.month.max()}）")\nL.append("")\nL.append("## 1. 分析背景与方法")\nL.append("")\nL.append(f"本报告基于本地文件 `offline_data/regional_sales.csv`（共 {n_rows} 行，"\n         f"{n_months} 个月 × {n_groups} 个「区域×产品线」组合），"\n         f"对每个组合计算月度销量 `units` 相对其自身 24 个月滚动均值（min_periods=12）的倍数，"\n         f"定位单月放量异常。全部结论仅来自本地 CSV，未使用任何外部信息。")\nL.append("")\nL.append("## 2. 数据概览")\nL.append("")\nL.append(f