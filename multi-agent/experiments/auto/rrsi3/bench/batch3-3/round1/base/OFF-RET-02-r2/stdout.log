import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r2\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
nums = df['week'].str.extract(r'W(\d+)')[0].astype(int)
sel = df[(nums>=30)&(nums<=43)].copy()
sel['week_num'] = nums[(nums>=30)&(nums<=43)]

metrics = ['retention_d7','churn_rate','arpu_usd']
pre = sel[sel['week_num']<=36]
post = sel[sel['week_num']>=37]

# per-week table with first differences
per = sel[['week','week_num']+metrics].copy()
for c in metrics:
    per[f'{c}_wow'] = per[c].diff()

# breakpoint: week with max |wow| for each metric
bp = {}
for c in metrics:
    col = f'{c}_wow'
    i = per[col].abs().idxmax()
    bp[c] = (per.loc[i,'week'], per.loc[i,col])

# group means
means = pd.DataFrame({
    'metric': metrics,
    'W30_W36_mean': [pre[c].mean() for c in metrics],
    'W37_W43_mean': [post[c].mean() for c in metrics],
})
means['diff'] = means['W37_W43_mean'] - means['W30_W36_mean']
means['rel_pct'] = means['diff']/means['W30_W36_mean']*100
means['n_pre'] = len(pre)
means['n_post'] = len(post)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r2\_sandbox\tmp"
per_path = f"{out_dir}\\step2_per_week.csv"
means_path = f"{out_dir}\\step2_group_means.csv"
per.to_csv(per_path, index=False)
means.to_csv(means_path, index=False)

print(per.to_string(index=False))
print()
print(means.to_string(index=False))
print()
print("breakpoint (max |WoW|):", bp)
print("saved:", per_path, means_path)

