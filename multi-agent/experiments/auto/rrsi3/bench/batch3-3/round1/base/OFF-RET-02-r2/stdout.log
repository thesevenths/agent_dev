import pandas as pd
import numpy as np

TMP = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r2\_sandbox\tmp"
df = pd.read_csv(TMP + r"\app_metrics_W30_W43.csv")
print(df.to_string(index=False))

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
g1 = df[df['week'].between('W30','W36')]
g2 = df[df['week'].between('W37','W43')]
print("\ng1 rows:", len(g1), "g2 rows:", len(g2))

means = pd.DataFrame({
    'W30-W36_mean': g1[metrics].mean(),
    'W37-W43_mean': g2[metrics].mean(),
})
means['abs_diff (g2-g1)'] = means['W37-W43_mean'] - means['W30-W36_mean']
means['rel_diff_pct'] = means['abs_diff (g2-g1)'] / means['W30-W36_mean'] * 100
print("\nGROUP MEANS:\n", means.round(6).to_string())

# per-week deltas to pinpoint breakpoint
d = df.set_index('week')[metrics].diff()
d['ret_drop'] = -d['retention_d7']
d['churn_jump'] = d['churn_rate']
d['arpu_drop'] = -d['arpu_usd']
print("\nPER-WEEK DELTAS:\n", d.round(4).to_string())

# breakpoint = week with largest combined normalized deterioration
z = d[['ret_drop','churn_jump','arpu_drop']].copy()
zscore = (z - z.mean()) / z.std()
d['score'] = zscore.sum(axis=1)
print("\nBREAKPOINT SCORES:\n", d[['ret_drop','churn_jump','arpu_drop','score']].round(4).to_string())
bp = d['score'].idxmax()
print("\nBREAKPOINT WEEK:", bp)

# W36->W37 specific
w36, w37 = df[df['week']=='W36'].iloc[0], df[df['week']=='W37'].iloc[0]
print("\nW36:", w36[metrics].tolist())
print("W37:", w37[metrics].tolist())

# save intermediate results CSV
out = pd.DataFrame(index=metrics)
out['W30-W36_mean'] = g1[metrics].mean()
out['W37-W43_mean'] = g2[metrics].mean()
out['abs_diff_g2_minus_g1'] = out['W37-W43_mean'] - out['W30-W36_mean']
out['rel_diff_pct'] = out['abs_diff_g2_minus_g1'] / out['W30-W36_mean'] * 100
out['n_W30_W36'] = len(g1)
out['n_W37_W43'] = len(g2)
out.to_csv(TMP + r"\step2_group_means.csv")

# per-week table for report
pw = df[['week'] + metrics].copy()
pw['ret_delta_vs_prev'] = pw['retention_d7'].diff()
pw['churn_delta_vs_prev'] = pw['churn_rate'].diff()
pw['arpu_delta_vs_prev'] = pw['arpu_usd'].diff()
pw.to_csv(TMP + r"\step2_per_week.csv", index=False)
print("\nsaved step2_group_means.csv and step2_per_week.csv")

