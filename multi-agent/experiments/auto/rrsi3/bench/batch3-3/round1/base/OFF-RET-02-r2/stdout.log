def md_table(frame, index=False):
    cols = list(frame.columns)
    lines = ["| " + " | ".join(cols) + " |", "|" + "---|"*len(cols)]
    for idx, row in frame.iterrows():
        vals = ([str(idx)] if index else []) + [f"{v:.4f}" if isinstance(v,float) else str(v) for v in row]
        lines.append("| " + " | ".join(vals) + " |")
    return "\n".join(lines)

d = sel.set_index('week')[['retention_d7','churn_rate','arpu_usd']].diff()

