    i = per[col].abs().idxmax()
    bp[c] = (per.loc[i,'week'], per.loc[i,col])

# group means
means = pd.DataFrame({
    'metric': metrics,
    'W30_W36_mean': [pre[c].mean() for c in metrics],
    'W37_W43_mean': [post[c].mean() for c in metrics],
})
means['diff'] = means['W37_W43_mean'] 
