import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "gt5", False: "le5"})

rows = []
for g in ["le5", "gt5"]:
    sub = df[df["group"] == g]
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "mean_math": round(float(sub["math_score"].mean()), 4),
        "mean_reading": round(float(sub["reading_score"].mean()), 4),
        "mean_screen": round(float(sub["screen_hours_per_day"].mean()), 4),
    })

le5, gt5 = rows
out = {
    "groups": rows,
    "diff_math_gt5_minus_le5": round(gt5["mean_math"] - le5["mean_math"], 4),
    "diff_reading_gt5_minus_le5": round(gt5["mean_reading"] - le5["mean_reading"], 4),
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-COR-02-r2\_sandbox\tmp\step3_group_stats.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(path)
print(json.dumps(out, ensure_ascii=False, indent=2))

