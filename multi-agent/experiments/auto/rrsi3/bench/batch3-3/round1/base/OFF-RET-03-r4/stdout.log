```python
import pandas as pd, numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)
med = df["retention_d7"].median()

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])

hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] < med]

res = pd.DataFrame([
    {"metric": "pearson_corr_retention_d7_vs_arpu_usd", "value": r_arpu, "n": n, "note": "Pearson, 60 rows"},
    {"metric": "pearson_corr_retention_d7_vs_churn_rate", "value": r_churn, "n": n, "note": "Pearson, 60 rows"},
    {"metric": "retention_d7_median", "value": med, "n": n, "note": "median, 60 rows"},
    {"metric": "group_high_arpu_usd_mean", "value": hi["arpu_usd"].mean(), "n": len(hi), "note": "retention_d7 > median"},
    {"metric": "group_low_arpu_usd_mean", "value": lo["arpu_usd"].mean(), "n": len(lo), "note": "retention_d7 < median"},
    {"metric": "group_high_cohort_size_sum", "value": hi["cohort_size"].sum(), "n": len(hi), "note": "retention_d7 > median"},
    {"metric": "group_low_cohort_size_sum", "value": lo["cohort_size"].sum(), "n": len(lo), "note": "retention_d7 < median"},
    {"metric": "arpu_gap_high_minus_low", "value": hi["arpu_usd"].mean() - lo["arpu_usd"].mean(), "n": n, "note": "derived from two group means"},
    {"metric": "arpu_gap_pct", "value": (hi["arpu_usd"].mean() - lo["arpu_usd"].mean()) / lo["arpu_usd"].mean() * 100, "n": n, "note": "derived from two group means"},
])
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r4\_sandbox\tmp\step2_results.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

