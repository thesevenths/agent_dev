import pandas as pd, numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r4\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
n = len(df)

med = df["retention_d7"].median()
r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
spearman_arpu = df["retention_d7"].corr(df["arpu_usd"], method="spearman")
spearman_churn = df["retention_d7"].corr(df["churn_rate"], method="spearman")

hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = {
 "retention_d7_median": med,
 "pearson_retention_d7_arpu_usd": r_arpu,
 "pearson_retention_d7_churn_rate": r_churn,
 "spearman_retention_d7_arpu_usd": spearman_arpu,
 "spearman_retention_d7_churn_rate": spearman_churn,
 "n_total": n,
 "n_high": len(hi), "n_low": len(lo),
 "high_mean_arpu_usd": hi["arpu_usd"].mean(),
 "low_mean_arpu_usd": lo["arpu_usd"].mean(),
 "high_sum_cohort_size": int(hi["cohort_size"].sum()),
 "low_sum_cohort_size": int(lo["cohort_size"].sum()),
 "high_mean_retention_d7": hi["retention_d7"].mean(),
 "low_mean_retention_d7": lo["retention_d7"].mean(),
 "high_mean_churn_rate": hi["churn_rate"].mean(),
 "low_mean_churn_rate": lo["churn_rate"].mean(),
}
# t-test for arpu difference
from scipy import stats
t, p = stats.ttest_ind(hi["arpu_usd"], lo["arpu_usd"])
rows["ttest_arpu_t"] = t; rows["ttest_arpu_p"] = p

out = pd.DataFrame(list(rows.items()), columns=["metric","value"])
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-03-r4\_sandbox\tmp\step2_results.csv"
out.to_csv(out_path, index=False)
print(out.to_string(index=False))
print("saved:", out_path)

