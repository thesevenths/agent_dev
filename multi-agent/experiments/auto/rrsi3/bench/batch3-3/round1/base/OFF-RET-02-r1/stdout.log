```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(path)
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week table
per_week = sub[["week", "group"] + metrics].copy()

# group means
g = sub.groupby("group")[metrics].mean()
n = sub.groupby("group").size()

# differences: after - before
diff = g.loc["W37-W43"] - g.loc["W30-W36"]
rel = diff / g.loc["W30-W36"]

# locate breakpoint week: first week in W37-W43 where each metric crosses the prior-group mean
bp = {}
for m in metrics:
    prior_mean = g.loc["W30-W36", m]
    after = sub[sub["group"] == "W37-W43"]
    crossed = after[after[m] < prior_mean if m != "churn_rate" else after[m] > prior_mean]
    bp[m] = crossed["week"].iloc[0] if len(crossed) else None

print("group means:\n", g)
print("n:\n", n)
print("diff (after-before):\n", diff)
print("rel diff:\n", rel)
print("breakpoint week per metric:", bp)
print("\nper-week:\n", per_week.to_string(index=False))

# save intermediate CSV
out = pd.concat([
    per_week.assign(row_type="per_week"),
    g.reset_index().assign(row_type="group_mean"),
    diff.reset_index().rename(columns={"index": "week"}).assign(row_type="diff_after_minus_before"),
    rel.reset_index().rename(columns={"index": "week"}).assign(row_type="rel_diff_pct"),
], ignore_index=True)
out_path = out_dir + r"\step2_group_means_breakpoint.csv"
out.to_csv(out_path, index=False)
print("\nsaved:", out_path)

