w2 = df[df["week"].isin([f"W{i:02d}" for i in range(37, 44)])]

print("W30-W36 rows:", len(w1), " W37-W43 rows:", len(w2))

m1 = w1[metrics].mean()
m2 = w2[metrics].mean()
print("\nW30-W36 means:\n", m1)
print("\nW37-W43 means:\n", m2)

diff = m2 - m1
pct = diff / m1 * 100
print("\nDiff (W37-43 - W30-36):\n", diff)
print("\nPct change:\n", pct)

# per-week table with week-over-week deltas
sub = df[df["week"].isin([f"W{i:02d}" for i in range(30, 44)])].copy()
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")
for c in metrics:
    sub[f"{c}_wow"] = sub[c].diff()
print("\n", sub.to_string(index=False))

# save intermediate CSV
out = sub[["week", "group"] + metrics + [f"{c}_wow" for c in metrics]].round(6)
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r1\_sandbox\tmp\step2_breakpoint_stats.csv"
out.to_csv(out_path, index=False)

summary = pd.DataFrame({
    "group": ["W30-W36", "W37-W43"],
    "n": [len(w1), len(w2)],
    "retention_d7_mean": [m1["retention_d7"], m2["retention_d7"]],
    "churn_rate_mean": [m1["churn_rate"], m2["churn_rate"]],
    "arpu_usd_mean": [m1["arpu_usd"], m2["arpu_usd"]],
})
summary_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r1\_sandbox\tmp\step2_group_means.csv"
summary.round(6).to_csv(summary_path, index=False)
print("\nsaved:", out_path)
print("saved:", summary_path)
print(summary.round(6).to_string(index=False))

