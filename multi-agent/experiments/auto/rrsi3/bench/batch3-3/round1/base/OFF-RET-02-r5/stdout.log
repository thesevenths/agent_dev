```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r5\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

pre = df[df['week'].isin([f"W{i:02d}" for i in range(30, 37)])]
post = df[df['week'].isin([f"W{i:02d}" for i in range(37, 44)])]
print("pre rows:", len(pre), "post rows:", len(post))

# Per-week table W28-W44 with group labels
sub = df[df['week'].isin([f"W{i:02d}" for i in range(28, 45)])].copy()
def label(w):
    n = int(w[1:])
    if 30 <= n <= 36: return 'W30-W36 (pre)'
    if 37 <= n <= 43: return 'W37-W43 (post)'
    return 'context'
sub['group'] = sub['week'].apply(label)
sub['delta_wow'] = sub['retention_d7'].diff()
sub.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)

# Group means
means = pd.DataFrame({
    'metric': metrics,
    'mean_pre_W30_W36': [pre[m].mean() for m in metrics],
    'mean_post_W37_W43': [post[m].mean() for m in metrics],
})
means['abs_diff_post_minus_pre'] = means['mean_post_W37_W43'] - means['mean_pre_W30_W36']
means['rel_diff_pct'] = means['abs_diff_post_minus_pre'] / means['mean_pre_W30_W36'] * 100
print(means.to_string(index=False))

# std for reference
std = pd.DataFrame({
    'metric': metrics,
    'std_pre': [pre[m].std(ddof=1) for m in metrics],
    'std_post': [post[m].std(ddof=1) for m in metrics],
})
print(std.to_string(index=False))

# t-test for rigor
from scipy import stats
for m in metrics:
    t, p = stats.ttest_ind(pre[m], post[m])
    print(f"{m}: t={t:.4f}, p={p:.6f}")

means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
std.to_csv(f"{out_dir}\\step2_group_std.csv", index=False)
print("\nSaved per-week, means, std CSVs.")

