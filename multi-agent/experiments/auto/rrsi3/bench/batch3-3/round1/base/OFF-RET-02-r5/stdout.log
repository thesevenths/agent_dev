import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
pre  = df[df['week'].isin([f"W{i:02d}" for i in range(30,37)])]
post = df[df['week'].isin([f"W{i:02d}" for i in range(37,44)])]

# exact fractions
for col in ['retention_d7','churn_rate','arpu_usd']:
    s_pre, s_post = pre[col].sum(), post[col].sum()
    print(col, "pre sum:", s_pre, "mean:", s_pre/7)
    print(col, "post sum:", s_post, "mean:", s_post/7)
    print(col, "diff:", s_post/7 - s_pre/7, "rel%:", (s_post/7 - s_pre/7)/(s_pre/7)*100)

# W37 vs W36 single-step
w36 = df[df['week']=='W36'].iloc[0]; w37 = df[df['week']=='W37'].iloc[0]
for col in ['retention_d7','churn_rate','arpu_usd']:
    print(f"W37-W36 {col}:", w37[col]-w36[col], f"({(w37[col]-w36[col])/w36[col]*100:+.2f}%)")

# W37 vs pre-mean
for col in ['retention_d7','churn_rate','arpu_usd']:
    m = pre[col].mean()
    print(f"W37 vs pre-mean {col}:", w37[col]-m, f"({(w37[col]-m)/m*100:+.2f}%)")

# post-mean vs pre-mean ratios
print("\npost/pre ratios:")
for col in ['retention_d7','churn_rate','arpu_usd']:
    print(col, post[col].mean()/pre[col].mean())

