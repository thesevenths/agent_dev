import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
metrics = ['retention_d7','churn_rate','arpu_usd']

pre  = df[df['week'].isin([f"W{i:02d}" for i in range(30,37)])]
post = df[df['week'].isin([f"W{i:02d}" for i in range(37,44)])]

means = pd.DataFrame({
    'group': ['W30-W36 (pre)', 'W37-W43 (post)'],
    'n': [len(pre), len(post)],
    'retention_d7_mean': [pre['retention_d7'].mean(), post['retention_d7'].mean()],
    'churn_rate_mean':   [pre['churn_rate'].mean(),   post['churn_rate'].mean()],
    'arpu_usd_mean':     [pre['arpu_usd'].mean(),     post['arpu_usd'].mean()],
})
print(means.to_string(index=False))

# differences
d_ret  = post['retention_d7'].mean() - pre['retention_d7'].mean()
d_ch   = post['churn_rate'].mean()   - pre['churn_rate'].mean()
d_arpu = post['arpu_usd'].mean()     - pre['arpu_usd'].mean()
print(f"\ndiff retention_d7: {d_ret:+.4f}  ({d_ret/pre['retention_d7'].mean()*100:+.2f}%)")
print(f"diff churn_rate:   {d_ch:+.4f}  ({d_ch/pre['churn_rate'].mean()*100:+.2f}%)")
print(f"diff arpu_usd:     {d_arpu:+.4f}  ({d_arpu/pre['arpu_usd'].mean()*100:+.2f}%)")

# per-week deltas to pinpoint breakpoint week
sub = df[df['week'].isin([f"W{i:02d}" for i in range(30,44)])].reset_index(drop=True)
sub['d_ret']  = sub['retention_d7'].diff()
sub['d_churn']= sub['churn_rate'].diff()
sub['d_arpu'] = sub['arpu_usd'].diff()
print("\nPer-week deltas (W31-W43):")
print(sub[['week','retention_d7','churn_rate','arpu_usd','d_ret','d_churn','d_arpu']].to_string(index=False))

# breakpoint week = week with largest combined normalized drop
sub['z_ret']  = sub['d_ret'].abs() / sub['d_ret'].abs().max()
sub['z_ch']   = sub['d_churn'].abs() / sub['d_churn'].abs().max()
sub['z_arpu'] = sub['d_arpu'].abs() / sub['d_arpu'].abs().max()
sub['score']  = sub['z_ret'] + sub['z_ch'] + sub['z_arpu']
print("\nBreakpoint score (sum of normalized |delta|):")
print(sub[['week','d_ret','d_churn','d_arpu','score']].to_string(index=False))

# save intermediate CSV
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-RET-02-r5\_sandbox\tmp\breakpoint_analysis_step2.csv"
with open(out, 'w', encoding='utf-8') as f:
    f.write("## group_means\n")
    means.to_csv(f, index=False)
    f.write("\n## per_week\n")
    sub[['week','cohort_size','retention_d7','churn_rate','arpu_usd','d_ret','d_churn','d_arpu','score']].to_csv(f, index=False)
print("\nsaved:", out)

