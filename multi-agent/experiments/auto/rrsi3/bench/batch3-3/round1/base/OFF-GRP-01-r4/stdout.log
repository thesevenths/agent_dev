import pandas as pd, json, math

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-01-r4\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch3-3\round1\base\OFF-GRP-01-r4\_sandbox\tmp\group_stats.json"

df = pd.read_csv(src)
res = {"source_file": "offline_data/students.csv", "n_total": int(len(df)), "missing_math_score": int(df['math_score'].isna().sum())}
stats = {}
for t, g in df.groupby('tutoring'):
    stats[int(t)] = {
        "n": int(len(g)),
        "mean": float(g['math_score'].mean()),
        "std_sample": float(g['math_score'].std(ddof=1)),
        "std_pop": float(g['math_score'].std(ddof=0)),
        "min": float(g['math_score'].min()),
        "max": float(g['math_score'].max()),
    }
res["groups"] = stats
n0, n1 = stats[0]["n"], stats[1]["n"]
m0, m1 = stats[0]["mean"], stats[1]["mean"]
s0, s1 = stats[0]["std_sample"], stats[1]["std_sample"]
pooled_var = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled = math.sqrt(pooled_var)
mean_diff = m1 - m0
d = mean_diff / pooled
res["pooled_var"] = pooled_var
res["pooled_std"] = pooled
res["mean_diff_t1_minus_t0"] = mean_diff
res["cohens_d"] = d
ad = abs(d)
res["effect_size_label"] = "小" if ad < 0.2 else "中" if ad < 0.8 else "大"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

