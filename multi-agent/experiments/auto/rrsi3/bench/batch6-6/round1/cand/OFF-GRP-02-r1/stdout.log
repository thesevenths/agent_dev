```python
import pandas as pd

df = pd.read_csv("offline_data/students.csv")

g = df.groupby(["grade", "region"], observed=True).agg(
    row_count=("reading_score", "size"),
    mean_reading_score=("reading_score", "mean"),
).reset_index()

# round means for readability but keep full precision in a separate column
g["mean_reading_score"] = g["mean_reading_score"].round(2)

# totals row
total = pd.DataFrame([{"grade": "ALL", "region": "ALL",
                       "row_count": int(g["row_count"].sum()),
                       "mean_reading_score": round(df["reading_score"].mean(), 2)}])
out = pd.concat([g, total], ignore_index=True)

out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-02-r1\_sandbox\tmp\step2_grade_region_crosstab.csv", index=False)

print(out.to_string(index=False))

cells = g  # exclude ALL row
mx = cells.loc[cells["mean_reading_score"].idxmax()]
mn = cells.loc[cells["mean_reading_score"].idxmin()]
print("\nMAX:", mx.to_dict())
print("MIN:", mn.to_dict())
print("Spread (max-min):", round(mx["mean_reading_score"] - mn["mean_reading_score"], 2))
print("Ratio max/min:", round(mx["mean_reading_score"] / mn["mean_reading_score"], 4))

```
