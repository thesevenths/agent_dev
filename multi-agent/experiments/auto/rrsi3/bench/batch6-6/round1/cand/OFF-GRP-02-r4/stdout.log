out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-02-r4\_sandbox\tmp\crosstab_grade_region.csv"

df = pd.read_csv(src)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g = g.sort_values(['grade','region']).reset_index(drop=True)
g['mean'] = g['mean'].round(4)
g.to_csv(out, index=False)
print(g.to_string(index=False))

mx = g.loc[g['mean'].idxmax()]
mn = g.loc[g['mean'].idxmin()]
print("MAX:", mx.tolist())
print("MIN:", mn.tolist())
print("total rows:", len(df))
print("overall mean:", round(df['reading_score'].mean(),4))

