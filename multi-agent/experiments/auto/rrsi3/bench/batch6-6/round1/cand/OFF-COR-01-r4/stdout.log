```python
import pandas as pd, json
df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-01-r4\_sandbox\offline_data\students.csv")
vars_ = ['study_hours_per_week','sleep_hours_per_night','attendance_pct','screen_hours_per_day']
res = []
for v in vars_:
    r = df[v].corr(df['math_score'])
    res.append((v, r))
res.sort(key=lambda x: abs(x[1]), reverse=True)
for v,r in res: print(v, round(r,6))
# extra stats for report
print("n =", len(df))
print("math_score mean/std:", round(df['math_score'].mean(),4), round(df['math_score'].std(),4))
for v in vars_:
    print(v, "mean", round(df[v].mean(),4), "std", round(df[v].std(),4), "min", df[v].min(), "max", df[v].max())
# t-statistic for significance
import math
n = len(df)
for v,r in res:
    t = r*math.sqrt((n-2)/(1-r*r))
    print(v, "t=", round(t,3))

```
