metrics = ["retention_d7", "churn_rate", "arpu_usd"]
pre = sub[sub["week"] <= "W36"]
post = sub[sub["week"] >= "W37"]

rows = []
for name, g in [("W30-W36 (pre)", pre), ("W37-W43 (post)", post)]:
    row = {"group": name, "n": len(g)}
    for m in metrics:
        row[f"{m}_mean"] = g[m].mean()
        row[f"{m}_std"] = g[m].std(ddof=1)
    rows.append(row)
means = pd.DataFrame(rows)

print(means.to_string(index=False))
print("\nDelta (post - pre):")
for m in metrics:
    d = means.iloc[1][f"{m}_mean"] - means.iloc[0][f"{m}_mean"]
    p = d / means.iloc[0][f"{m}_mean"] * 100
    print(f"  {m}: {d:+.4f} ({p:+.2f}%)")

sub["group"] = np.where(sub["week"] <= "W36", "pre(W30-W36)", "post(W37-W43)")
for m in metrics:
    sub[f"{m}_wow"] = sub[m].diff()
print("\nPer-week:")
print(sub.to_string(index=False))

print("\nLargest retention_d7 WoW drop:", sub.loc[sub["retention_d7_wow"].idxmin(), ["week","retention_d7_wow"]].tolist())
print("Largest churn_rate WoW jump:", sub.loc[sub["churn_rate_wow"].idxmax(), ["week","churn_rate_wow"]].tolist())
print("Largest arpu_usd WoW drop:", sub.loc[sub["arpu_usd_wow"].idxmin(), ["week","arpu_usd_wow"]].tolist())

means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
sub.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)
print("\nSaved step2_group_means.csv and step2_per_week.csv")

