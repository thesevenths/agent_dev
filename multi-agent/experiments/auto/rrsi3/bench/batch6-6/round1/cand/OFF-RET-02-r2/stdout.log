import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r2\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r2\_sandbox\tmp"

df = pd.read_csv(path)
sub = df[df["week"].isin([f"W{i:02d}" for i in range(30,44)])].sort_values("week").reset_index(drop=True)

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
pre = sub[sub["week"] <= "W36"]
post = sub[sub["week"] >= "W37"]

# group means
means = pd.DataFrame({
    "group": ["W30-W36 (pre)", "W37-W43 (post)"],
    "n": [len(pre), len(post)],
    "retention_d7_mean": [pre["retention_d7"].mean(), post["retention_d7"].mean()],
    "churn_rate_mean": [pre["churn_rate"].mean(), post["churn_rate"].mean()],
    "arpu_usd_mean": [pre["arpu_usd"].mean(), post["arpu_usd"].mean()],
})
# std for reference
means["retention_d7_std"] = [pre["retention_d7"].std(ddof=1), post["retention_d7"].std(ddof=1)]
means["churn_rate_std"] = [pre["churn_rate"].std(ddof=1), post["churn_rate"].std(ddof=1)]
means["arpu_usd_std"] = [pre["arpu_usd"].std(ddof=1), post["arpu_usd"].std(ddof=1)]

# deltas
delta = means.iloc[1] - means.iloc[0]
pct = (delta / means.iloc[0]) * 100

print(means.to_string(index=False))
print("\nDelta (post - pre):")
for m in metrics:
    d = delta[f"{m}_mean"]
    p = pct[f"{m}_mean"]
    print(f"  {m}: {d:+.4f} ({p:+.2f}%)")

# per-week table with group labels
sub["group"] = np.where(sub["week"] <= "W36", "pre(W30-W36)", "post(W37-W43)")
sub["retention_d7_wow"] = sub["retention_d7"].diff()
sub["churn_rate_wow"] = sub["churn_rate"].diff()
sub["arpu_usd_wow"] = sub["arpu_usd"].diff()
print("\nPer-week:")
print(sub.to_string(index=False))

# breakpoint detection: largest single-week drop in retention_d7 / largest jump in churn
print("\nLargest retention_d7 WoW drop:", sub.loc[sub["retention_d7_wow"].idxmin(), ["week","retention_d7_wow"]].tolist())
print("Largest churn_rate WoW jump:", sub.loc[sub["churn_rate_wow"].idxmax(), ["week","churn_rate_wow"]].tolist())
print("Largest arpu_usd WoW drop:", sub.loc[sub["arpu_usd_wow"].idxmin(), ["week","arpu_usd_wow"]].tolist())

# save intermediate CSV
out = pd.concat([
    means.assign(metric="group_summary").reset_index(drop=True),
], ignore_index=True)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
sub.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)
print("\nSaved step2_group_means.csv and step2_per_week.csv")

