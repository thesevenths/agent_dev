k_month_revenue": round(peak_value, 2),\n    "region_monthly_totals": {\n        r: {m: round(float(v), 2) for m, v in piv[r].items()} for r in piv.columns\n    },\n}\n\njson_path = os.path.join(BASE, "step2_regional_aggregates.json")\nwith open(json_path, "w", encoding="utf-8") as f:\n    json.dump(result, f, ensure_ascii=False, indent=2)\n\ntab = pd.DataFrame(result["regions"])\ntab.to_csv(os.path.join(BASE, "step2_regional_aggregates.csv"), index=False, encoding="utf-8-sig")\n\nprint(json.dumps(result, ensure_ascii=False, indent=2))\nprint("SAVED:", json_path)\nprint("SAVED:", os.path.join(BASE, "step2_regional_aggregates.csv"))\n'} with error:
