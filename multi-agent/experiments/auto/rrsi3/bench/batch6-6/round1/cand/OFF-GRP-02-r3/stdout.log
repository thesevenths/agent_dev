import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-02-r3\_sandbox\offline_data\students.csv"
out  = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-02-r3\_sandbox\tmp\step2_crosstab.csv"

df = pd.read_csv(path)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g['mean'] = g['mean'].round(4)
g = g.sort_values(['grade','region']).reset_index(drop=True)
g.to_csv(out, index=False)
print(g.to_string(index=False))

hi = g.loc[g['mean'].idxmax()]
lo = g.loc[g['mean'].idxmin()]
print("\nHIGHEST:", hi['grade'], hi['region'], hi['mean'], "n=", hi['count'])
print("LOWEST :", lo['grade'], lo['region'], lo['mean'], "n=", lo['count'])
print("diff:", round(hi['mean']-lo['mean'],4))
print("overall mean:", round(df['reading_score'].mean(),4), "n=", len(df))
print("saved:", out)

```
