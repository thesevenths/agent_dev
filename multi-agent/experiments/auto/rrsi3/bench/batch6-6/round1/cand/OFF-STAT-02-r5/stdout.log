```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-STAT-02-r5\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
m, r = df["math_score"], df["reading_score"]
n = len(df)

def stats(s):
    mean = s.mean()
    std = s.std(ddof=1)  # sample std
    std_pop = s.std(ddof=0)
    return {
        "n": int(s.count()),
        "mean": round(float(mean), 4),
        "std_sample": round(float(std), 4),
        "std_population": round(float(std_pop), 4),
        "median": float(s.median()),
        "min": int(s.min()),
        "max": int(s.max()),
        "cv_sample": round(float(std/mean), 6),
        "cv_population": round(float(std_pop/mean), 6),
    }

sm, sr = stats(m), stats(r)
pearson = float(m.corr(r, method="pearson"))

result = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "n_used": int(m.count()),
    "nulls": {"math_score": int(m.isna().sum()), "reading_score": int(r.isna().sum())},
    "math_score": sm,
    "reading_score": sr,
    "pearson_r": round(pearson, 6),
    "cv_comparison": {
        "cv_math_sample": sm["cv_sample"],
        "cv_reading_sample": sr["cv_sample"],
        "larger_dispersion": "math_score" if sm["cv_sample"] > sr["cv_sample"] else "reading_score",
    },
}
out = os.path.join(out_dir, "stats_results.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
