import pandas as pd, numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r0\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)

# Correlations (Pearson)
r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] < med]
eq = df[df["retention_d7"] == med]

def grp(g):
    return {
        "n": len(g),
        "arpu_mean": g["arpu_usd"].mean(),
        "cohort_sum": int(g["cohort_size"].sum()),
        "ret_min": g["retention_d7"].min(),
        "ret_max": g["retention_d7"].max(),
    }

res = {
    "n_total": n,
    "retention_d7_median": med,
    "rows_equal_to_median": len(eq),
    "corr_retention_arpu": r_arpu,
    "corr_retention_churn": r_churn,
    "high": grp(high),
    "low": grp(low),
}
# derived ratios
res["arpu_ratio_high_over_low"] = res["high"]["arpu_mean"] / res["low"]["arpu_mean"]
res["arpu_diff_high_minus_low"] = res["high"]["arpu_mean"] - res["low"]["arpu_mean"]
res["cohort_share_high"] = res["high"]["cohort_sum"] / (res["high"]["cohort_sum"] + res["low"]["cohort_sum"])

import json
print(json.dumps(res, indent=2, default=str))

# Save intermediate CSV
rows = [
    {"metric": "n_total", "value": n, "note": "全部周度 cohort 行数"},
    {"metric": "retention_d7_median", "value": med, "note": "retention_d7 中位数（分组阈值）"},
    {"metric": "corr_retention_d7_arpu_usd", "value": round(r_arpu, 6), "note": "Pearson 相关系数，n=60"},
    {"metric": "corr_retention_d7_churn_rate", "value": round(r_churn, 6), "note": "Pearson 相关系数，n=60"},
    {"metric": "high_group_n", "value": res["high"]["n"], "note": "retention_d7 > 中位数的行数"},
    {"metric": "high_group_arpu_mean", "value": round(res["high"]["arpu_mean"], 6), "note": "高留存组 arpu_usd 均值"},
    {"metric": "high_group_cohort_sum", "value": res["high"]["cohort_sum"], "note": "高留存组 cohort_size 总和"},
    {"metric": "low_group_n", "value": res["low"]["n"], "note": "retention_d7 < 中位数的行数"},
    {"metric": "low_group_arpu_mean", "value": round(res["low"]["arpu_mean"], 6), "note": "低留存组 arpu_usd 均值"},
    {"metric": "low_group_cohort_sum", "value": res["low"]["cohort_sum"], "note": "低留存组 cohort_size 总和"},
    {"metric": "arpu_ratio_high_over_low", "value": round(res["arpu_ratio_high_over_low"], 6), "note": "高/低组 arpu 均值之比（推导值）"},
    {"metric": "arpu_diff_high_minus_low", "value": round(res["arpu_diff_high_minus_low"], 6), "note": "高-低组 arpu 均值差（推导值）"},
    {"metric": "cohort_share_high", "value": round(res["cohort_share_high"], 6), "note": "高留存组 cohort_size 占比（推导值）"},
]
out_csv = out_dir + r"\step2_results.csv"
pd.DataFrame(rows).to_csv(out_csv, index=False, encoding="utf-8-sig")
print("saved:", out_csv)

```
