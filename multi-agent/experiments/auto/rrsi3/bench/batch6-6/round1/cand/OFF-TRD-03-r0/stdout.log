import pandas as pd, json, os

df = pd.read_csv("offline_data/regional_sales.csv")
out = {}
out["shape"] = list(df.shape)
out["columns"] = list(df.columns)
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}
out["regions"] = sorted(df["region"].unique().tolist())
out["n_regions"] = df["region"].nunique()
out["months"] = [df["month"].min(), df["month"].max()]
out["n_months"] = df["month"].nunique()
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["nulls"] = df.isna().sum().to_dict()
out["dupes"] = int(df.duplicated().sum())

# per region: total revenue, monthly avg
g = df.groupby("region")["revenue"].sum()
out["region_totals"] = g.to_dict()
out["grand_total"] = float(df["revenue"].sum())
out["region_monthly_avg"] = (g / df["month"].nunique()).to_dict()

# monthly totals per region -> peak month
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
out["peak"] = {r: {"month": piv[r].idxmax(), "value": float(piv[r].max())} for r in piv.columns}
out["top_region"] = g.idxmax()

# rows per region
out["rows_per_region"] = df.groupby("region").size().to_dict()

os.makedirs(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-TRD-03-r0\_sandbox\tmp", exist_ok=True)
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-TRD-03-r0\_sandbox\tmp\step1_validation.json"
with open(p, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", p)

```
