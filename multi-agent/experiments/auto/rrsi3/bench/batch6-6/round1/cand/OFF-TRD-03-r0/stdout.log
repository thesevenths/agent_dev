import pandas as pd, json, os

df = pd.read_csv("offline_data/regional_sales.csv")
n_months = df["month"].nunique()  # 24

g = df.groupby("region")["revenue"].sum()
grand = float(df["revenue"].sum())
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")

rows = []
for r in ["N", "S", "E", "W"]:
    total = float(g[r])
    rows.append({
        "region": r,
        "total_revenue": round(total, 2),
        "share_of_grand_total_pct": round(total / grand * 100, 4),
        "monthly_avg_revenue": round(total / n_months, 2),
        "n_rows": int((df["region"] == r).sum()),
        "peak_month": piv[r].idxmax(),
        "peak_month_revenue": round(float(piv[r].max()), 2),
    })

out = {
    "source_file": "offline_data/regional_sales.csv",
    "as_of": "2026-10-25 17:40",
    "n_months": n_months,
    "month_range": [df["month"].min(), df["month"].max()],
    "grand_total_revenue": round(grand, 2),
    "regions": rows,
    "top_region": max(rows, key=lambda x: x["total_revenue"])["region"],
}
top = out["top_region"]
out["top_region_peak_month"] = next(x["peak_month"] for x in rows if x["region"] == top)

outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-TRD-03-r0\_sandbox\tmp"
os.makedirs(outdir, exist_ok=True)
p_json = os.path.join(outdir, "step2_regional_aggregates.json")
p_csv = os.path.join(outdir, "step2_regional_aggregates.csv")
with open(p_json, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
pd.DataFrame(rows).to_csv(p_csv, index=False)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", p_json, "\nsaved:", p_csv)

```
