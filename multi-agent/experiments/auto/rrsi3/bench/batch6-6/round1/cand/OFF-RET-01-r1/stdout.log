import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"].astype(float)
assert len(df) == 60, len(df)

first = r.iloc[:30]
last = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
below = (r < threshold).sum()
below_weeks = df.loc[r < threshold, "week"].tolist()

res = pd.DataFrame({
    "metric": ["first30_mean","first30_std","last30_mean","last30_std",
               "diff_last_minus_first","overall_mean","overall_std",
               "threshold_mean_minus_2std","weeks_below_threshold"],
    "value": [first.mean(), first.std(ddof=1), last.mean(), last.std(ddof=1),
              last.mean()-first.mean(), overall_mean, overall_std,
              threshold, below]
})
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-01-r1\_sandbox\tmp\retention_d7_stats.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("below weeks:", below_weeks)
print("saved:", out)

```
