import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r0\_sandbox\tmp\breakpoint_metrics.csv"

df = pd.read_csv(src)
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
assert len(sub) == 14, len(sub)

sub["group"] = sub["week"].apply(lambda w: "W30-W36" if int(w[1:]) <= 36 else "W37-W43")
metrics = ["retention_d7", "churn_rate", "arpu_usd"]
means = sub.groupby("group")[metrics].mean()
print(means)

out_df = sub[["group", "week"] + metrics].copy()
for g, m in means.iterrows():
    mask = out_df["group"] == g
    out_df.loc[mask, "group_mean_retention_d7"] = m["retention_d7"]
    out_df.loc[mask, "group_mean_churn_rate"] = m["churn_rate"]
    out_df.loc[mask, "group_mean_arpu_usd"] = m["arpu_usd"]
out_df = out_df[["group", "week", "retention_d7", "churn_rate", "arpu_usd",
                 "group_mean_retention_d7", "group_mean_churn_rate", "group_mean_arpu_usd"]]
out_df.to_csv(out, index=False)
print(out_df.to_string(index=False))
print("saved:", out)

# deltas for downstream
a, b = means.loc["W30-W36"], means.loc["W37-W43"]
for c in metrics:
    print(f"{c}: before={a[c]:.6f} after={b[c]:.6f} delta={b[c]-a[c]:+.6f} rel={100*(b[c]-a[c])/a[c]:+.2f}%")

