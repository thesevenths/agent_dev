import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sl = df[df["week"].between("W30","W43")].copy()
sl["group"] = sl["week"].apply(lambda w: "pre_W30-W36" if int(w[1:])<=36 else "post_W37-W43")

metrics = ["retention_d7","churn_rate","arpu_usd"]
means = sl.groupby("group")[metrics].mean()
n = sl.groupby("group").size()
print(means)
print(n)

# per-week deltas
sl["ret_d"] = sl["retention_d7"].diff()
sl["churn_d"] = sl["churn_rate"].diff()
sl["arpu_d"] = sl["arpu_usd"].diff()
print(sl[["week","ret_d","churn_d","arpu_d"]].to_string(index=False))

# group means with n
out = means.copy()
out["n"] = n
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r0\_sandbox\tmp\step2_group_means.csv")

# per-week table
sl.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r0\_sandbox\tmp\step2_per_week.csv", index=False)

# differences
diff = means.loc["post_W37-W43"] - means.loc["pre_W30-W36"]
print(diff)
print("rel change:", diff/means.loc["pre_W30-W36"])
print("ratio post/pre:", means.loc["post_W37-W43"]/means.loc["pre_W30-W36"])

```
