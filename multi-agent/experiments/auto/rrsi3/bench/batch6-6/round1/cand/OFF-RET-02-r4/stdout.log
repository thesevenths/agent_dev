```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r4\_sandbox\tmp"

df = pd.read_csv(path)
sub = df[(df['week'] >= 'W30') & (df['week'] <= 'W43')].copy()
g1 = sub[sub['week'] <= 'W36']
g2 = sub[sub['week'] >= 'W37']

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# per-week series with week-over-week deltas
per = sub[['week'] + metrics].copy()
for m in metrics:
    per[f'{m}_wow_delta'] = per[m].diff()

# group means
means = pd.DataFrame({
    'metric': metrics,
    'W30_W36_mean': [round(g1[m].mean(), 6) for m in metrics],
    'W37_W43_mean': [round(g2[m].mean(), 6) for m in metrics],
})
means['abs_diff'] = means['W37_W43_mean'] - means['W30_W36_mean']
means['rel_diff_pct'] = (means['abs_diff'] / means['W30_W36_mean'] * 100).round(4)
means['n_W30_W36'] = len(g1)
means['n_W37_W43'] = len(g2)

# breakpoint candidate: week with max |wow| change in retention_d7 (normalized)
for m in metrics:
    d = per[f'{m}_wow_delta'].abs()
    per[f'{m}_wow_abs'] = d
    print(m, "max |wow| at", per.loc[d.idxmax(), 'week'], d.max())

per.to_csv(f"{out_dir}\\step2_per_week_W30_W43.csv", index=False, encoding='utf-8-sig')
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False, encoding='utf-8-sig')

print(per.to_string(index=False))
print()
print(means.to_string(index=False))
print()
print("W30-W36 rows:", list(g1['week']))
print("W37-W43 rows:", list(g2['week']))

