import pandas as pd

sub = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r4\_sandbox\tmp\step1_w30_w43.csv")
print(sub.to_string(index=False))

pre = sub[sub['week'] <= 'W36']
post = sub[sub['week'] >= 'W37']
print("pre rows:", len(pre), "post rows:", len(post))

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
means = pd.DataFrame({
    'metric': metrics,
    'mean_W30_W36': [pre[m].mean() for m in metrics],
    'mean_W37_W43': [post[m].mean() for m in metrics],
})
means['diff_post_minus_pre'] = means['mean_W37_W43'] - means['mean_W30_W36']
means['pct_change'] = means['diff_post_minus_pre'] / means['mean_W30_W36'] * 100
print(means.to_string(index=False))

# per-week deltas to locate breakpoint
sub['delta_ret'] = sub['retention_d7'].diff()
sub['delta_churn'] = sub['churn_rate'].diff()
sub['delta_arpu'] = sub['arpu_usd'].diff()
print(sub[['week','retention_d7','churn_rate','arpu_usd','delta_ret','delta_churn','delta_arpu']].to_string(index=False))

# breakpoint candidates: max |delta|
for col in ['delta_ret','delta_churn','delta_arpu']:
    i = sub[col].abs().idxmax()
    print(col, "max abs delta at", sub.loc[i,'week'], sub.loc[i,col])

# combined z-score style: standardize deltas
import numpy as np
z = pd.DataFrame(index=sub.index)
for m, d in [('retention_d7','delta_ret'),('churn_rate','delta_churn'),('arpu_usd','delta_arpu')]:
    z[m] = sub[d] / sub[d].std(ddof=0)
z['sum_abs'] = z.abs().sum(axis=1)
sub['z_sum_abs'] = z['sum_abs']
print(sub[['week','z_sum_abs']].to_string(index=False))
print("breakpoint week by combined z:", sub.loc[sub['z_sum_abs'].idxmax(),'week'])

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r4\_sandbox\tmp\step2_means_breakpoint.csv"
# save both: group means table and per-week table
with open(out, 'w', encoding='utf-8') as f:
    f.write("group_means\n")
    means.to_csv(f, index=False)
    f.write("\nper_week\n")
    sub.to_csv(f, index=False)
print("saved:", out)

