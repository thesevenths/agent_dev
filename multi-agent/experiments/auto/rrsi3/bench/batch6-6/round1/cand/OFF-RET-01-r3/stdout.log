import pandas as pd, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-01-r3\_sandbox\tmp"
df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
assert len(df) == 60

first30 = r.iloc[:30]
last30 = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

res = {
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_weeks": len(df),
    "first30": {"weeks": f"{df['week'].iloc[0]}-{df['week'].iloc[29]}", "n": 30,
                "mean": first30.mean(), "std": first30.std(ddof=1)},
    "last30": {"weeks": f"{df['week'].iloc[30]}-{df['week'].iloc[59]}", "n": 30,
               "mean": last30.mean(), "std": last30.std(ddof=1)},
    "diff_mean": last30.mean() - first30.mean(),
    "overall": {"mean": overall_mean, "std": overall_std, "min": r.min(), "max": r.max()},
    "threshold_mean_minus_2std": threshold,
    "weeks_below_threshold": {
        "count": int(len(below)),
        "weeks": below.index.tolist(),
        "week_labels": df.loc[below.index, 'week'].tolist(),
        "values": below.tolist(),
    },
}
path = os.path.join(out_dir, "retention_d7_stats.json")
with open(path, 'w', encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("SAVED:", path)

```
