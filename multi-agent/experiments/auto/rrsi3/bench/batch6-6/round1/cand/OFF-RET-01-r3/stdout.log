```python
import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
  "n_total": len(r),
  "first30": {"weeks": list(df["week"].iloc[:30]), "mean": first.mean(), "std": first.std(ddof=1), "min": first.min(), "max": first.max()},
  "last30": {"weeks": list(df["week"].iloc[30:]), "mean": last.mean(), "std": last.std(ddof=1), "min": last.min(), "max": last.max()},
  "diff_mean_last_minus_first": last.mean() - first.mean(),
  "overall": {"mean": overall_mean, "std": overall_std, "min": r.min(), "max": r.max()},
  "threshold": threshold,
  "below_threshold_count": int((r < threshold).sum()),
  "below_threshold_weeks": below["week"].tolist(),
  "below_threshold_values": below["retention_d7"].tolist(),
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-01-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
path = os.path.join(out_dir, "retention_d7_stats.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(path)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
