        "min": float(last30.min()),
        "max": float(last30.max()),
    },
    "diff_mean_last_minus_first": float(last30.mean() - first30.mean()),
    "diff_std_last_minus_first": float(last30.std(ddof=1) - first30.std(ddof=1)),
    "overall": {
        "n": int(len(r)),
        "mean": float(overall_mean),
        "std_ddof1": float(overall_std),
    },
    "threshold_mean_minus_2std": float(threshold),
    "weeks_below_threshold": {
        "count": int(len(below)),
        "weeks": below["week"].tolist(),
        "values": below["retention_d7"].tolist(),
    },
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-01-r2\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
