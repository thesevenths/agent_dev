import pandas as pd, numpy as np, os, base64
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r4\_sandbox\tmp\app_metrics_clean.csv"
df = pd.read_csv(p)
med = df['retention_d7'].median()
hi = df[df['retention_d7'] > med]; lo = df[df['retention_d7'] < med]

# extra derived numbers for report
arpu_gap = hi['arpu_usd'].mean() - lo['arpu_usd'].mean()
arpu_gap_pct = arpu_gap / lo['arpu_usd'].mean() * 100
cohort_gap = hi['cohort_size'].sum() - lo['cohort_size'].sum()
cohort_gap_pct = cohort_gap / lo['cohort_size'].sum() * 100
print(round(arpu_gap,4), round(arpu_gap_pct,2), cohort_gap, round(cohort_gap_pct,2))

# chart: scatter retention vs arpu colored by group + churn vs retention
fig, axes = plt.subplots(1, 2, figsize=(11, 4.2))
ax = axes[0]
ax.scatter(lo['retention_d7'], lo['arpu_usd'], s=28, alpha=.7, label='Low retention (<0.39575)', color='#d62728')
ax.scatter(hi['retention_d7'], hi['arpu_usd'], s=28, alpha=.7, label='High retention (>0.39575)', color='#2ca02c')
ax.set_xlabel('retention_d7'); ax.set_ylabel('arpu_usd')
ax.set_title('retention_d7 vs arpu_usd (r = 0.6214)')
ax.legend(fontsize=8)
ax = axes[1]
ax.scatter(lo['retention_d7'], lo['churn_rate'], s=28, alpha=.7, label='Low retention', color='#d62728')
ax.scatter(hi['retention_d7'], hi['churn_rate'], s=28, alpha=.7, label='High retention', color='#2ca02c')
ax.set_xlabel('retention_d7'); ax.set_ylabel('churn_rate')
ax.set_title('retention_d7 vs churn_rate (r = -0.7755)')
ax.legend(fontsize=8)
plt.tight_layout()
png = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r4\_sandbox\tmp\retention_value_scatter.png"
plt.savefig(png, dpi=130)
b64 = base64.b64encode(open(png,'rb').read()).decode()
print("png:", png, os.path.getsize(png), "b64 len:", len(b64))

