import pandas as pd, os

src = "offline_data/app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r4\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(src)
print(df.shape)
print(df.dtypes)
print("nulls:\n", df.isna().sum())
print("dups week:", df['week'].duplicated().sum())
print(df.describe())

# validation
issues = []
if df.isna().any().any(): issues.append("has nulls")
if (df[['cohort_size','dau','support_tickets']] < 0).any().any(): issues.append("negative counts")
if not ((df['retention_d7']>=0)&(df['retention_d7']<=1)).all(): issues.append("retention out of [0,1]")
if not ((df['churn_rate']>=0)&(df['churn_rate']<=1)).all(): issues.append("churn out of [0,1]")
if (df['dau'] > df['cohort_size']).any(): issues.append("dau > cohort_size")
print("issues:", issues)

# cleaned copy (drop dupes, keep order)
clean = df.drop_duplicates(subset='week').reset_index(drop=True)
clean_path = os.path.join(out_dir, "app_metrics_clean.csv")
clean.to_csv(clean_path, index=False)
print("saved:", clean_path, clean.shape)

