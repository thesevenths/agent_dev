```python
import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-01-r2\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-01-r2\_sandbox\tmp\group_stats.json"

df = pd.read_csv(path)
g = df.groupby('tutoring')['math_score'].agg(n='count', mean='mean', std=lambda s: s.std(ddof=1))
g0, g1 = g.loc[0], g.loc[1]

n0, n1 = int(g0['n']), int(g1['n'])
m0, m1 = g0['mean'], g1['mean']
s0, s1 = g0['std'], g1['std']

pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled**0.5
diff = m1 - m0
d = diff / pooled_std

# effect size interpretation (Cohen conventions)
ad = abs(d)
label = "小效应" if ad < 0.2 else ("小-中效应" if ad < 0.5 else ("中效应" if ad < 0.8 else "大效应"))

res = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "missing_math_score": int(df['math_score'].isna().sum()),
    "missing_tutoring": int(df['tutoring'].isna().sum()),
    "groups": {
        "tutoring_0": {"n": n0, "mean": m0, "std": s0, "std_ddof": 1},
        "tutoring_1": {"n": n1, "mean": m1, "std": s1, "std_ddof": 1},
    },
    "mean_diff_t1_minus_t0": diff,
    "pooled_variance": pooled,
    "pooled_std": pooled_std,
    "cohens_d": d,
    "effect_size_label": label,
    "overall_math_score": {"n": int(len(df)), "mean": float(df['math_score'].mean()), "std": float(df['math_score'].std(ddof=1))},
}
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
