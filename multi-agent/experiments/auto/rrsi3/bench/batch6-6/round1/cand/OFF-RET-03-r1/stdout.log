import pandas as pd
import numpy as np
import json

path = "offline_data/app_metrics.csv"
df = pd.read_csv(path)
n = len(df)

# Correlations (Pearson)
r_ret_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_ret_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# Median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] < med]

def grp_stats(g):
    return {
        "n_rows": len(g),
        "arpu_usd_mean": float(g["arpu_usd"].mean()),
        "cohort_size_sum": int(g["cohort_size"].sum()),
        "retention_d7_mean": float(g["retention_d7"].mean()),
        "churn_rate_mean": float(g["churn_rate"].mean()),
        "weeks": [g["week"].min(), g["week"].max()],
    }

hi_s, lo_s = grp_stats(hi), grp_stats(lo)

# t-test for arpu difference (extra context)
from scipy import stats
t_stat, p_val = stats.ttest_ind(hi["arpu_usd"], lo["arpu_usd"])

results = {
    "n_rows": n,
    "retention_d7_median": float(med),
    "pearson_retention_d7_vs_arpu_usd": float(r_ret_arpu),
    "pearson_retention_d7_vs_churn_rate": float(r_ret_churn),
    "group_high": hi_s,
    "group_low": lo_s,
    "arpu_diff_high_minus_low": float(hi_s["arpu_usd_mean"] - lo_s["arpu_usd_mean"]),
    "arpu_ratio_high_over_low": float(hi_s["arpu_usd_mean"] / lo_s["arpu_usd_mean"]),
    "ttest_arpu": {"t": float(t_stat), "p": float(p_val)},
}

# Save intermediate results CSV
out_csv = "E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch6-6/round1/cand/OFF-RET-03-r1/_sandbox/tmp/step2_results.csv"
rows = [
    {"metric": "retention_d7_median", "value": med, "n_rows": n, "note": "median of retention_d7, 60 rows"},
    {"metric": "pearson_corr_retention_d7_arpu_usd", "value": r_ret_arpu, "n_rows": n, "note": "Pearson, 60 rows"},
    {"metric": "pearson_corr_retention_d7_churn_rate", "value": r_ret_churn, "n_rows": n, "note": "Pearson, 60 rows"},
    {"metric": "arpu_usd_mean_high_retention", "value": hi_s["arpu_usd_mean"], "n_rows": hi_s["n_rows"], "note": "retention_d7 > median"},
    {"metric": "arpu_usd_mean_low_retention", "value": lo_s["arpu_usd_mean"], "n_rows": lo_s["n_rows"], "note": "retention_d7 < median"},
    {"metric": "cohort_size_sum_high_retention", "value": hi_s["cohort_size_sum"], "n_rows": hi_s["n_rows"], "note": "retention_d7 > median"},
    {"metric": "cohort_size_sum_low_retention", "value": lo_s["cohort_size_sum"], "n_rows": lo_s["n_rows"], "note": "retention_d7 < median"},
    {"metric": "retention_d7_mean_high", "value": hi_s["retention_d7_mean"], "n_rows": hi_s["n_rows"], "note": "retention_d7 > median"},
    {"metric": "retention_d7_mean_low", "value": lo_s["retention_d7_mean"], "n_rows": lo_s["n_rows"], "note": "retention_d7 < median"},
    {"metric": "churn_rate_mean_high", "value": hi_s["churn_rate_mean"], "n_rows": hi_s["n_rows"], "note": "retention_d7 > median"},
    {"metric": "churn_rate_mean_low", "value": lo_s["churn_rate_mean"], "n_rows": lo_s["n_rows"], "note": "retention_d7 < median"},
    {"metric": "arpu_diff_high_minus_low", "value": results["arpu_diff_high_minus_low"], "n_rows": n, "note": "derived from the two group means"},
    {"metric": "arpu_ratio_high_over_low", "value": results["arpu_ratio_high_over_low"], "n_rows": n, "note": "derived from the two group means"},
    {"metric": "ttest_arpu_t", "value": t_stat, "n_rows": n, "note": "independent t-test, high vs low group"},
    {"metric": "ttest_arpu_p", "value": p_val, "n_rows": n, "note": "independent t-test, high vs low group"},
]
pd.DataFrame(rows).to_csv(out_csv, index=False)

# Also save JSON for step 3
out_json = "E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch6-6/round1/cand/OFF-RET-03-r1/_sandbox/tmp/step2_results.json"
with open(out_json, "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

print(json.dumps(results, ensure_ascii=False, indent=2))
print("saved:", out_csv)
print("saved:", out_json)

