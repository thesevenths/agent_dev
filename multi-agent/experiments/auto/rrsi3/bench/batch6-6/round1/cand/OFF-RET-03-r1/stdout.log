import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r1\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
n = len(df)

med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

pear_r_arpu = df["retention_d7"].corr(df["arpu_usd"])
pear_r_churn = df["retention_d7"].corr(df["churn_rate"])
spear_r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="spearman")
spear_r_churn = df["retention_d7"].corr(df["churn_rate"], method="spearman")

res = {
    "as_of": "2026-10-26 14:21",
    "source_file": "offline_data/app_metrics.csv",
    "n_rows": n,
    "retention_d7_median": float(med),
    "grouping_rule": "high: retention_d7 > median; low: retention_d7 <= median",
    "pearson_retention_d7_vs_arpu_usd": float(pear_r_arpu),
    "pearson_retention_d7_vs_churn_rate": float(pear_r_churn),
    "spearman_retention_d7_vs_arpu_usd": float(spear_r_arpu),
    "spearman_retention_d7_vs_churn_rate": float(spear_r_churn),
    "high_group": {
        "n_rows": int(len(hi)),
        "mean_arpu_usd": float(hi["arpu_usd"].mean()),
        "sum_cohort_size": int(hi["cohort_size"].sum()),
    },
    "low_group": {
        "n_rows": int(len(lo)),
        "mean_arpu_usd": float(lo["arpu_usd"].mean()),
        "sum_cohort_size": int(lo["cohort_size"].sum()),
    },
}
res["arpu_ratio_high_over_low"] = res["high_group"]["mean_arpu_usd"] / res["low_group"]["mean_arpu_usd"]
res["cohort_share_high"] = res["high_group"]["sum_cohort_size"] / (res["high_group"]["sum_cohort_size"] + res["low_group"]["sum_cohort_size"])

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r1\_sandbox\tmp\step2_correlations_and_groups.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))
print("\nSaved:", out)

