import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: ">5h", False: "<=5h"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
)
print(g)
lo, hi = g.loc["<=5h"], g.loc[">5h"]
out = {
  "source_file": "offline_data/students.csv",
  "split_rule": "screen_hours_per_day > 5 vs <= 5",
  "n_total": int(len(df)),
  "groups": {
    "<=5h": {"n": int(lo["n"]), "mean_screen_hours_per_day": round(float(lo["mean_screen"]),6),
             "mean_math_score": round(float(lo["mean_math"]),6), "mean_reading_score": round(float(lo["mean_reading"]),6)},
    ">5h": {"n": int(hi["n"]), "mean_screen_hours_per_day": round(float(hi["mean_screen"]),6),
            "mean_math_score": round(float(hi["mean_math"]),6), "mean_reading_score": round(float(hi["mean_reading"]),6)},
  },
  "mean_diff_high_minus_low": {
    "math_score": round(float(hi["mean_math"]-lo["mean_math"]),6),
    "reading_score": round(float(hi["mean_reading"]-lo["mean_reading"]),6),
  },
  "computed_at": "2026-10-25 16:36"
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-02-r2\_sandbox\tmp\step3_group_stats.json"
with open(path,"w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print(json.dumps(out,ensure_ascii=False,indent=2))
print("saved:", path)

