import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day","math_score","reading_score"]
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
out = {
  "source_file": "offline_data/students.csv",
  "n_rows": int(len(df)),
  "missing_values": {c: int(df[c].isna().sum()) for c in cols},
  "correlation_method": "Pearson",
  "screen_hours_per_day_vs_math_score": round(float(r_math), 6),
  "screen_hours_per_day_vs_reading_score": round(float(r_read), 6),
  "computed_at": "2026-10-25 16:36"
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-02-r2\_sandbox\tmp\step2_correlations.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(out)
print("saved:", path)

