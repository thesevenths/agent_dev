import pandas as pd, json

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-01-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(p)

g = df.groupby('tutoring')['math_score'].agg(n='count', mean='mean', std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,'n']), int(g.loc[1,'n'])
m0, m1 = g.loc[0,'mean'], g.loc[1,'mean']
s0, s1 = g.loc[0,'std'], g.loc[1,'std']

mean_diff = m1 - m0
pooled_std = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
d = mean_diff / pooled_std

# Cohen's d thresholds: |d|<0.2 negligible, 0.2 small, 0.5 medium, 0.8 large
ad = abs(d)
if ad < 0.2: cls = "negligible (可忽略)"
elif ad < 0.5: cls = "small (小)"
elif ad < 0.8: cls = "medium (中)"
else: cls = "large (大)"

res = {
  "source_file": "offline_data/students.csv",
  "as_of": "2026-10-26 14:53",
  "group_tutoring_0": {"n": n0, "mean": round(m0,4), "std_ddof1": round(s0,4)},
  "group_tutoring_1": {"n": n1, "mean": round(m1,4), "std_ddof1": round(s1,4)},
  "mean_diff_1_minus_0": round(mean_diff,4),
  "pooled_std": round(pooled_std,4),
  "cohens_d": round(d,4),
  "effect_size_class": cls,
  "thresholds": "Cohen(1988): |d|<0.2 negligible, 0.2-0.5 small, 0.5-0.8 medium, >=0.8 large",
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-01-r4\_sandbox\tmp\step2_group_stats.json"
with open(out,'w',encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

