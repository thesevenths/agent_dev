import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
m, r = df["math_score"], df["reading_score"]
n = len(df)
stats = {
    "n": n,
    "math_mean": m.mean(), "math_std": m.std(ddof=1), "math_median": m.median(),
    "reading_mean": r.mean(), "reading_std": r.std(ddof=1), "reading_median": r.median(),
    "pearson_r": m.corr(r),
    "math_cv": m.std(ddof=1)/m.mean(), "reading_cv": r.std(ddof=1)/r.mean(),
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-STAT-02-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out = os.path.join(out_dir, "score_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(stats, f, indent=2, ensure_ascii=False)
print(json.dumps(stats, indent=2))
print("saved:", out)

