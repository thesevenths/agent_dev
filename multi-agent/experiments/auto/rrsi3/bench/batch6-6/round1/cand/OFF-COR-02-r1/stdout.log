import pandas as pd
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True:"high(>5)", False:"low(<=5)"})
g = df.groupby("group").agg(n=("student_id","count"),
                            screen_mean=("screen_hours_per_day","mean"),
                            math_mean=("math_score","mean"),
                            reading_mean=("reading_score","mean"))
print(g)
hi = df[df.screen_hours_per_day>5]; lo = df[df.screen_hours_per_day<=5]
print("n hi/lo:", len(hi), len(lo))
print("math diff (hi-lo):", hi.math_score.mean()-lo.math_score.mean())
print("reading diff (hi-lo):", hi.reading_score.mean()-lo.reading_score.mean())
print("screen means:", hi.screen_hours_per_day.mean(), lo.screen_hours_per_day.mean())

```
