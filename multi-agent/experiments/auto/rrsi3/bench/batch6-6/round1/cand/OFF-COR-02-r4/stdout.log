import pandas as pd
df = pd.read_csv("offline_data/students.csv")
df["grp"] = (df["screen_hours_per_day"] > 5).map({True:"gt5", False:"le5"})
g = df.groupby("grp").agg(n=("student_id","count"),
                          screen_mean=("screen_hours_per_day","mean"),
                          math_mean=("math_score","mean"),
                          math_std=("math_score","std"),
                          read_mean=("reading_score","mean"),
                          read_std=("reading_score","std"))
print(g)
gt, le = g.loc["gt5"], g.loc["le5"]
print("math diff (gt5 - le5):", gt.math_mean - le.math_mean)
print("read diff (gt5 - le5):", gt.read_mean - le.read_mean)
# t-tests
from scipy import stats
for col in ["math_score","reading_score"]:
    a = df.loc[df.grp=="gt5", col]; b = df.loc[df.grp=="le5", col]
    t,p = stats.ttest_ind(a,b)
    print(col, "t=",t,"p=",p)

```
