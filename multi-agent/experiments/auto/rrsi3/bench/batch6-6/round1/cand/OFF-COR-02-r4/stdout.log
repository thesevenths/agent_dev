import pandas as pd
df = pd.read_csv("offline_data/students.csv")
sub = df[["screen_hours_per_day","math_score","reading_score"]].dropna()
print("n =", len(sub))
r_math = sub["screen_hours_per_day"].corr(sub["math_score"])
r_read = sub["screen_hours_per_day"].corr(sub["reading_score"])
print("pearson screen~math:", r_math)
print("pearson screen~reading:", r_read)
# significance
import math
n = len(sub)
for name, r in [("math", r_math), ("reading", r_read)]:
    t = r*math.sqrt((n-2)/(1-r*r))
    print(name, "t =", t)

