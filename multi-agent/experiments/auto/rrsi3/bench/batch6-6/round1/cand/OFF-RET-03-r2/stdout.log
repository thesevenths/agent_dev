```python
import pandas as pd, numpy as np, os

BASE = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r2\_sandbox"
CSV = os.path.join(BASE, "offline_data", "app_metrics.csv")
OUT = os.path.join(BASE, "tmp", "step2_results.csv")

df = pd.read_csv(CSV)
n = len(df)

# Pearson correlations
r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# Median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = [
    {"metric": "n_total", "value": n},
    {"metric": "retention_d7_median", "value": med},
    {"metric": "corr_retention_d7_arpu_usd", "value": r_arpu},
    {"metric": "corr_retention_d7_churn_rate", "value": r_churn},
    {"metric": "group_high_n", "value": len(hi)},
    {"metric": "group_high_arpu_mean", "value": hi["arpu_usd"].mean()},
    {"metric": "group_high_cohort_sum", "value": int(hi["cohort_size"].sum())},
    {"metric": "group_low_n", "value": len(lo)},
    {"metric": "group_low_arpu_mean", "value": lo["arpu_usd"].mean()},
    {"metric": "group_low_cohort_sum", "value": int(lo["cohort_size"].sum())},
]
out_df = pd.DataFrame(rows)
out_df.to_csv(OUT, index=False)
print(out_df.to_string(index=False))
print("saved:", OUT)

```
