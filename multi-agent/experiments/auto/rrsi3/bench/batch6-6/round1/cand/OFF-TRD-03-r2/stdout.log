import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
total = df["revenue"].sum()
g = df.groupby("region")["revenue"].sum()
print("total:", total)
for r in ["N","S","E","W"]:
    print(r, g[r], g[r]/total*100, g[r]/24)
# monthly totals per region
m = df.groupby(["region","month"])["revenue"].sum().unstack()
print(m)
print(m.idxmax(axis=1))
print(m.max())

