```python
import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
total = df["revenue"].sum()
n_months = df["month"].nunique()

g = df.groupby("region")["revenue"].sum()
agg = pd.DataFrame({
    "total_revenue": g,
    "revenue_share_pct": g / total * 100,
    "monthly_avg_revenue": g / n_months,
})
agg["n_rows"] = df.groupby("region")["revenue"].count()

# peak month per region
pm = df.groupby(["region","month"])["revenue"].sum().reset_index()
peak = pm.loc[pm.groupby("region")["revenue"].idxmax()]
agg = agg.join(peak.set_index("region")[["month","revenue"]].rename(columns={"month":"peak_month","revenue":"peak_month_revenue"}))
agg = agg.loc[["N","S","E","W"]]
print(agg)
print("grand_total:", total, "n_months:", n_months)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-TRD-03-r2\_sandbox\tmp\step2_regional_aggregates.csv"
agg.round(2).to_csv(out)
print("saved:", out)

```
