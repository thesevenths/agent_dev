import pandas as pd, json, math

df = pd.read_csv("offline_data/students.csv")
n = len(df)

r_math = df.screen_hours_per_day.corr(df.math_score)
r_read = df.screen_hours_per_day.corr(df.reading_score)

def tstat(r, n):
    return r * math.sqrt((n-2)/(1-r*r))

out = {
    "n": n,
    "corr_screen_math": round(r_math, 6),
    "corr_screen_reading": round(r_read, 6),
    "t_screen_math": round(tstat(r_math, n), 4),
    "t_screen_reading": round(tstat(r_read, n), 4),
}
print(out)

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-02-r3\_sandbox\tmp\step2_correlations.json", "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved")

```
