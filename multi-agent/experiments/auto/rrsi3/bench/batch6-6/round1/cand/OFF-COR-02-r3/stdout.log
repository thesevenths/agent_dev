g = df.groupby("group").agg(n=("student_id","count"),
                             mean_math=("math_score","mean"),
                             mean_reading=("reading_score","mean"),
                             mean_screen=("screen_hours_per_day","mean"))
hi = g.loc["high_gt5"]; lo = g.loc["low_le5"]
out = {
  "source_file": "offline_data/students.csv",
  "as_of": "2026-10-25 16:37",
  "split_rule": "high: screen_hours_per_day > 5; low: screen_hours_per_day <= 5",
  "high_gt5": {"n": int(hi["n"]), "mean_math": round(float(hi["mean_math"]),4),
               "mean_reading": round(float(hi["mean_reading"]),4),
               "mean_screen": round(float(hi["mean_screen"]),4)},
  "low_le5": {"n": int(lo["n"]), "mean_math": round(float(lo["mean_math"]),4),
              "mean_reading": round(float(lo["mean_reading"]),4),
              "mean_screen": round(float(lo["mean_screen"]),4)},
  "diff_high_minus_low": {
      "mean_math": round(float(hi["mean_math"]-lo["mean_math"]),4),
      "mean_reading": round(float(hi["mean_reading"]-lo["mean_reading"]),4)},
}
outp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-02-r3\_sandbox\tmp\step3_group_stats.json"
with open(outp,"w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", outp)

