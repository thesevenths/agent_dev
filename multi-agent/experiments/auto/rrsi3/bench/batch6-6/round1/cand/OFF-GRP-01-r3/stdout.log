```python
import pandas as pd, json, os

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-01-r3\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-01-r3\_sandbox\tmp"

df = pd.read_csv(csv)
g = df.groupby("tutoring")["math_score"]
n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std()[0]), float(g.std()[1])
mean_diff = m1 - m0
pooled_var = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled_var ** 0.5
d = mean_diff / pooled_std
ad = abs(d)
label = "小效应" if ad < 0.2 else ("中效应" if ad < 0.8 else "大效应")

result = {
    "source_file": "offline_data/students.csv",
    "n_total": int(len(df)),
    "group_0": {"n": n0, "mean": m0, "std": s0},
    "group_1": {"n": n1, "mean": m1, "std": s1},
    "mean_diff_1_minus_0": mean_diff,
    "pooled_var": pooled_var,
    "pooled_std": pooled_std,
    "cohens_d": d,
    "effect_size_label": label,
    "note": "std uses sample std (ddof=1); pooled_std = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); d = (mean1-mean0)/pooled_std; |d|<0.2 小, 0.2-0.8 中, >=0.8 大"
}
path = os.path.join(out_dir, "tutoring_stats.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", path)

