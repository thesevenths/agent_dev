```python
import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].isin([f"W{i}" for i in range(30, 44)])].sort_values('week').reset_index(drop=True)

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
g1 = sub[sub['week'].isin([f"W{i}" for i in range(30, 37)])]  # W30-W36
g2 = sub[sub['week'].isin([f"W{i}" for i in range(37, 44)])]  # W37-W43

means1 = g1[metrics].mean()
means2 = g2[metrics].mean()
delta = means2 - means1
rel = delta / means1 * 100

summary = pd.DataFrame({
    'group_mean_W30_W36': means1,
    'group_mean_W37_W43': means2,
    'delta': delta,
    'rel_change_pct': rel
})
print(summary.to_string())

# largest single-week jump per metric (W30-W43, week-over-week)
jumps = sub[metrics].diff()
print("\nmax |jump| per metric:")
for m in metrics:
    idx = jumps[m].abs().idxmax()
    print(m, "at", sub.loc[idx, 'week'], "jump =", jumps.loc[idx, m])

# also signed jump for churn (increase is bad)
print("\nchurn_rate jumps:\n", jumps['churn_rate'].to_string())
print("\nretention_d7 jumps:\n", jumps['retention_d7'].to_string())
print("\narpu_usd jumps:\n", jumps['arpu_usd'].to_string())

# std for context
print("\nstd W30-W36:\n", g1[metrics].std())
print("\nstd W37-W43:\n", g2[metrics].std())

# save per-week + group results
out = sub[['week', 'cohort_size', 'dau'] + metrics].copy()
out['group'] = np.where(out['week'].isin(g1['week']), 'W30-W36', 'W37-W43')

grp = pd.DataFrame({
    'week': ['W30-W36 (mean, n=7)', 'W37-W43 (mean, n=7)'],
    'retention_d7': [means1['retention_d7'], means2['retention_d7']],
    'churn_rate': [means1['churn_rate'], means2['churn_rate']],
    'arpu_usd': [means1['arpu_usd'], means2['arpu_usd']],
    'group': ['W30-W36', 'W37-W43']
})

delta_df = pd.DataFrame({
    'week': ['delta (W37-W43 - W30-W36)'],
    'retention_d7': [delta['retention_d7']],
    'churn_rate': [delta['churn_rate']],
    'arpu_usd': [delta['arpu_usd']],
    'group': ['delta']
})
rel_df = pd.DataFrame({
    'week': ['rel_change_pct'],
    'retention_d7': [rel['retention_d7']],
    'churn_rate': [rel['churn_rate']],
    'arpu_usd': [rel['arpu_usd']],
    'group': ['rel_pct']
})

full = pd.concat([out, grp, delta_df, rel_df], ignore_index=True)
outpath = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r3\_sandbox\tmp\retention_breakpoint_data.csv"
full.to_csv(outpath, index=False)
print("\nsaved:", outpath)
print(full.to_string(index=False))

