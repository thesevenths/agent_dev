import pandas as pd, numpy as np, json, os

path = "offline_data/app_metrics.csv"
df = pd.read_csv(path)

# Correlations (Pearson)
r_ret_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_ret_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] <= med]

results = {
    "n": int(len(df)),
    "retention_d7_median": float(med),
    "corr_retention_arpu": float(r_ret_arpu),
    "corr_retention_churn": float(r_ret_churn),
    "high_group": {
        "definition": "retention_d7 > median",
        "n": int(len(high)),
        "mean_arpu_usd": float(high["arpu_usd"].mean()),
        "sum_cohort_size": int(high["cohort_size"].sum()),
    },
    "low_group": {
        "definition": "retention_d7 <= median",
        "n": int(len(low)),
        "mean_arpu_usd": float(low["arpu_usd"].mean()),
        "sum_cohort_size": int(low["cohort_size"].sum()),
    },
}
print(json.dumps(results, indent=2))

# Save intermediate results CSV
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r5\_sandbox\tmp"
rows = [
    {"metric": "retention_d7_median", "value": med, "n": len(df), "source": "offline_data/app_metrics.csv:retention_d7, median, 60 rows"},
    {"metric": "corr_pearson_retention_d7_arpu_usd", "value": r_ret_arpu, "n": len(df), "source": "offline_data/app_metrics.csv:retention_d7 vs arpu_usd, pearson, 60 rows"},
    {"metric": "corr_pearson_retention_d7_churn_rate", "value": r_ret_churn, "n": len(df), "source": "offline_data/app_metrics.csv:retention_d7 vs churn_rate, pearson, 60 rows"},
    {"metric": "high_group_n", "value": len(high), "n": len(high), "source": "offline_data/app_metrics.csv:retention_d7 > median"},
    {"metric": "high_group_mean_arpu_usd", "value": high["arpu_usd"].mean(), "n": len(high), "source": "offline_data/app_metrics.csv:arpu_usd, mean, retention_d7>median group"},
    {"metric": "high_group_sum_cohort_size", "value": int(high["cohort_size"].sum()), "n": len(high), "source": "offline_data/app_metrics.csv:cohort_size, sum, retention_d7>median group"},
    {"metric": "low_group_n", "value": len(low), "n": len(low), "source": "offline_data/app_metrics.csv:retention_d7 <= median"},
    {"metric": "low_group_mean_arpu_usd", "value": low["arpu_usd"].mean(), "n": len(low), "source": "offline_data/app_metrics.csv:arpu_usd, mean, retention_d7<=median group"},
    {"metric": "low_group_sum_cohort_size", "value": int(low["cohort_size"].sum()), "n": len(low), "source": "offline_data/app_metrics.csv:cohort_size, sum, retention_d7<=median group"},
]
out = pd.DataFrame(rows)
out_path = os.path.join(out_dir, "step2_results.csv")
out.to_csv(out_path, index=False)
print("saved:", os.path.abspath(out_path))
