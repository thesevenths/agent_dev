import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r5\_sandbox\tmp\app_metrics_clean.csv"
df = pd.read_csv(path)
n = len(df)

med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
# also spearman for robustness
from scipy.stats import pearsonr, spearmanr
pr_arpu = pearsonr(df["retention_d7"], df["arpu_usd"])
pr_churn = pearsonr(df["retention_d7"], df["churn_rate"])
sr_arpu = spearmanr(df["retention_d7"], df["arpu_usd"])
sr_churn = spearmanr(df["retention_d7"], df["churn_rate"])

res = {
    "n_rows": n,
    "retention_d7_median": med,
    "corr_retention_d7_arpu_usd_pearson": r_arpu,
    "corr_retention_d7_churn_rate_pearson": r_churn,
    "pearson_p_arpu": pr_arpu.pvalue,
    "pearson_p_churn": pr_churn.pvalue,
    "spearman_arpu": sr_arpu.correlation,
    "spearman_churn": sr_churn.correlation,
    "high_group": {
        "definition": "retention_d7 > median",
        "n": len(hi),
        "mean_arpu_usd": hi["arpu_usd"].mean(),
        "sum_cohort_size": int(hi["cohort_size"].sum()),
        "retention_d7_range": [hi["retention_d7"].min(), hi["retention_d7"].max()],
    },
    "low_group": {
        "definition": "retention_d7 <= median",
        "n": len(lo),
        "mean_arpu_usd": lo["arpu_usd"].mean(),
        "sum_cohort_size": int(lo["cohort_size"].sum()),
        "retention_d7_range": [lo["retention_d7"].min(), lo["retention_d7"].max()],
    },
}
res["arpu_ratio_high_over_low"] = res["high_group"]["mean_arpu_usd"] / res["low_group"]["mean_arpu_usd"]

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-03-r5\_sandbox\tmp\step2_results.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

