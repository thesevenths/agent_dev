asonality: Dec 2024 vs Dec 2025\n    dec24 = sub[sub["month"] == "2024-12-01"]\n    dec25 = sub[sub["month"] == "2025-12-01"]\n    dec24_units = float(dec24["units"].iloc[0]) if len(dec24) else None\n    dec25_units = float(dec25["units"].iloc[0]) if len(dec25) else None\n    dec_yoy = round(dec25_units / dec24_units - 1, 4) if (dec24_units and dec25_units) else None\n\n    # return-rate trend over window\n    rr_window = win[["month", "return_rate"]].copy()\n    rr_window["month"] = rr_window["month"].dt.strftime("%Y-%m")\n    rr_trend = rr_window.to_dict("records")\n\n    # MoM window\n    mom_window = win[["month", "units", "mom_growth", "return_rate"]].copy()\n    mom_window["month"] = mom_window["month"].dt.strftime("%Y-%m")\n    mom_window["mom_growth"] = mom_window["mom_growth"].round(4)\n    mom_window["return_rate"] = mom_window["return_rate"].round(4)\n\n    # (6) judgment\n    anom_rr = float(sub.loc[pos, "return_rate"])\n    prior3_rr = float(prior3["return_rate"].mean())\n    rr_up = anom_rr > prior3_rr * 1.2  # return rate up >20% vs prior 3m avg\n    mom_jump = float(sub.loc[pos, "units"]) / float(sub.loc[pos - 1, "units"]) - 1 if pos >= 1 else None\n    ramp = (float(sub.loc[pos - 1, "units"]) > float(sub.loc[pos - 2, "units"])) if pos >= 2 else False\n\n    if price_drop and rr_up:\n        label, rationale = "channel_stuffing", "异常月单价低于前3月均值且退货率明显抬升，符合压货特征"\n    elif price_drop:\n        label, rationale = "mixed", "异常月单价低于前3月均值（冲量信号），但退货率未抬升，需观察后续"\n    elif rr_up:\n        label, rationale = "mixed", "退货率较前3月均值抬升>20%，但单价未下降，压货证据不足"\n    else:\n        label = "genuine_demand"\n        extra = "销量连续爬坡" if ramp else "单月跳升"\n        rationale = (f"单价较前3月均值{price_change_pct*100:+.1f}%（未降价）、退货率{anom_rr*100:.2f}%未抬升（前3月均值{prior3_rr*100:.2f}%），"\n                     f"环比{mom_jump*100:+.1f}%，{extra}，更符合真实需求")\n\n    results.append({\n        "region": reg,\n        "product_line": pl,\n        "anomaly_month": am.strftime("%Y-%m"),\n        "anomaly_units": int(sub.loc[pos, "units"]),\n        "anomaly_return_rate": round(anom_rr, 4),\n        "window_6m": mom_window.to_dict("records"),\n        "return_rate_trend": rr_trend,\n        "price_check": {\n            "anomaly_month_unit_price": float(anom_price),\n            "prior_3m_avg_unit_price": round(float(prior3_price), 2),\n            "price_change_pct": price_change_pct,\n            "price_dropped": price_drop,\n        },\n        "seasonality_check": {\n            "dec_2024_units": dec24_units,\n            "dec_2025_units": dec25_units,\n            "dec_yoy_growth": dec_yoy,\n            "consistent_with_year_end_seasonality": bool(dec_yoy is not None and dec_yoy > 0),\n        },\n        "judgment": label,\n        "rationale": rationale,\n    })\n\nout = {\n    "as_of": "2026-10-25 16:21",\n    "source": "offline_data/regional_sales.csv (288 rows, 2024-01..2025-12)",\n    "method": "6-month window (3 before + anomaly + 3 after, truncated at data end) per top-3 anomaly; MoM growth, return-rate trend, price vs prior-3m avg, Dec24 vs Dec25 seasonality",\n    "anomalies": results,\n}\nwith open(OUT, "w", encoding="utf-8") as f:\n    json.dump(out, f, ensure_ascii=False, indent=2)\n\nprint("SAVED:", OUT)\nfor r in results:\n    print(f"{r[\'region\']} x {r[\'product_line\']} {r[\'anomaly_month\']}: {r[\'judgment\']} | price_chg={r[\'price_check\'][\'price_change_pct\']} | dec_yoy={r[\'seasonality_check\'][\'dec_yoy_growth\']}")\n    print("  ", r["rationale"])\n'} with error:
