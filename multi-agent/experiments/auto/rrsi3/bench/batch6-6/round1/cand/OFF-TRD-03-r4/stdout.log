import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")

grand_total = df["revenue"].sum()
region_total = df.groupby("region")["revenue"].sum()
region_avg = region_total / 24
region_share = region_total / grand_total

# peak month per region
rm = df.groupby(["region","month"])["revenue"].sum().reset_index()
peaks = rm.loc[rm.groupby("region")["revenue"].idxmax()]

# overall top region
top_region = region_total.idxmax()
top_peak = peaks[peaks["region"]==top_region].iloc[0]

# monthly series for top region (for report context)
top_monthly = rm[rm["region"]==top_region].sort_values("month")

out = {
  "as_of": "2026-10-26 15:18",
  "source": "offline_data/regional_sales.csv",
  "grand_total_revenue": round(grand_total,2),
  "months": 24,
  "regions": {
    r: {
      "total_revenue": round(region_total[r],2),
      "share": round(region_share[r],6),
      "monthly_avg": round(region_avg[r],2),
      "peak_month": peaks[peaks["region"]==r].iloc[0]["month"],
      "peak_month_revenue": round(peaks[peaks["region"]==r].iloc[0]["revenue"],2),
    } for r in ["N","S","E","W"]
  },
  "top_region": top_region,
  "top_region_peak_month": top_peak["month"],
  "top_region_peak_month_revenue": round(top_peak["revenue"],2),
  "top_region_monthly": {row["month"]: round(row["revenue"],2) for _,row in top_monthly.iterrows()},
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-TRD-03-r4\_sandbox\tmp\step2_regional_aggregates.json","w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)

pd.DataFrame({
    "region": region_total.index,
    "total_revenue": region_total.values,
    "share": region_share.values,
    "monthly_avg": region_avg.values,
}).to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-TRD-03-r4\_sandbox\tmp\step2_regional_aggregates.csv", index=False)

print(json.dumps(out,ensure_ascii=False,indent=2))

