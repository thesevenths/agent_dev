import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")

# Per-region aggregates
g = df.groupby("region")["revenue"].agg(["sum", "count"]).reindex(["N","S","E","W"])
grand = df["revenue"].sum()
g["share"] = g["sum"] / grand
g["monthly_avg"] = g["sum"] / 24  # 24 months per region
g = g.rename(columns={"sum":"total_revenue","count":"n_rows"})
g = g[["total_revenue","n_rows","share","monthly_avg"]]
print(g.round(6))
print("grand total:", grand)
print("grand total check (sum of region totals):", g["total_revenue"].sum())

# Peak month per region
pm = df.groupby(["region","month"])["revenue"].sum().reset_index()
peak = pm.loc[pm.groupby("region")["revenue"].idxmax()]
print(peak)

# Top region
top = g["total_revenue"].idxmax()
print("top region:", top)

# Save intermediate CSV
out = g.reset_index()
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-TRD-03-r1\_sandbox\tmp\step2_region_aggregates.csv", index=False)
