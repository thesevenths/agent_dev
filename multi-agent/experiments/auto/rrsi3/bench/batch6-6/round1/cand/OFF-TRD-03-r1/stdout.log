import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
print(df.shape)
print(df['month'].nunique(), df['region'].unique())

# per region totals
tot = df.groupby('region')['revenue'].sum()
print(tot)
grand = df['revenue'].sum()
print('grand', grand)
share = tot/grand*100
print(share)

# monthly avg per region (12 months each)
months = df.groupby(['region','month'])['revenue'].sum()
print(months.groupby('region').count())
avg = months.groupby('region').mean()
print(avg)

# peak month per region
peak = months.reset_index()
pk = peak.loc[peak.groupby('region')['revenue'].idxmax()]
print(pk)

# top region
top = tot.idxmax()
print('top region', top)
# peak month of top region
topm = months.xs(top)
print(topm.idxmax(), topm.max())

# overall peak month of top region rows
sub = df[df['region']==top].groupby('month')['revenue'].sum()
print(sub.idxmax(), sub.max())

# per-region row counts
print(df.groupby('region').size())
print('total rows', len(df))

