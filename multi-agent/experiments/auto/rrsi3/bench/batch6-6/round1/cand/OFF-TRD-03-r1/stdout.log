```python
import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
tot = df.groupby('region')['revenue'].sum()
grand = df['revenue'].sum()
share = tot/grand*100
months = df.groupby(['region','month'])['revenue'].sum()
avg = months.groupby('region').mean()

fmt = lambda x: f"{x:,.2f}"
rows = []
for r in ['N','S','E','W']:
    rows.append((r, fmt(tot[r]), f"{share[r]:.2f}%", fmt(avg[r])))
for row in rows:
    print(row)
print('grand', fmt(grand))
print('E peak', fmt(months.xs('E')['2025-12']))
# E 2025-12 rows detail
print(df[(df.region=='E')&(df.month=='2025-12')][['product_line','units','revenue']])
# E 2025-11 for comparison
print(df[(df.region=='E')&(df.month=='2025-11')][['product_line','revenue']])
# S peak month
print('S peak', months.xs('S').idxmax(), fmt(months.xs('S').max()))
# E share of grand, E vs S diff
print('E-S diff', fmt(tot['E']-tot['S']))
# E 2025-12 as % of E total
print('E peak month share of E total', months.xs('E')['2025-12']/tot['E']*100)

