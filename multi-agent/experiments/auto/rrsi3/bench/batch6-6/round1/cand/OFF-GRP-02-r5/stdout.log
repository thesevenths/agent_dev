import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-GRP-02-r5\_sandbox\tmp\students_inspection.md"

df = pd.read_csv(path)
ct = df.groupby(['grade','region']).agg(n=('reading_score','size'), mean_reading=('reading_score','mean'))
ct = ct.reindex(pd.MultiIndex.from_product([['G10','G11','G12'],['A','B','C','D']]))
ct['mean_reading'] = ct['mean_reading'].round(4)

lines = []
lines.append("# students.csv 加载与检查报告（Step 1/3）")
lines.append("")
lines.append("AS_OF: 2026-10-25 18:09（本地静态 CSV，文件修改时间 2026-10-23 10:11，非实时数据）")
lines.append("")
lines.append("## 1. 数据概览")
lines.append("")
lines.append(f"- 文件：`offline_data/students.csv`，共 {df.shape[0]} 行 × {df.shape[1]} 列（来源：offline_data/students.csv 全文件，行数=400，列数=10）")
lines.append(f"- 列名：{', '.join(df.columns)}（来源：offline_data/students.csv 表头）")
lines.append("- 必需列 `grade`、`region`、`reading_score` 均存在，类型分别为 str / str / int64（来源：offline_data/students.csv 的 grade、region、reading_score，dtype 检查，400 行）")
lines.append("- 全表缺失值：0（来源：offline_data/students.csv 全部 10 列，isna().sum()，400 行）")
lines.append(f"- `reading_score` 全表：均值 {df['reading_score'].mean():.4f}，最小 {df['reading_score'].min()}，最大 {df['reading_score'].max()}（来源：offline_data/students.csv 的 reading_score，全表 400 行）")
lines.append(f"- grade 取值：G10/G11/G12；region 取值：A/B/C/D，无异常取值（来源：offline_data/students.csv 的 grade、region，unique 检查，400 行）")
lines.append("")
lines.append("## 2. grade × region 交叉表（行数与 reading_score 均值）")
lines.append("")
lines.append("| grade | region | 行数 n | reading_score 均值 |")
lines.append("|---|---|---:|---:|")
for (g,r), row in ct.iterrows():
    lines.append(f"| {g} | {r} | {int(row['n'])} | {row['mean_reading']:.4f} |")
lines.append("")
lines.append("（来源：offline_data/students.csv 的 grade、region、reading_score，按 grade×region 分组，size 与 mean，共 400 行，12 个单元格）")
lines.append("")
mx = ct['mean_reading'].idxmax(); mn = ct['mean_reading'].idxmin()
lines.append(f"- 均值最高组合：{mx[0]}×{mx[1]}，均值 {ct.loc[mx,'mean_reading']:.4f}，样本量 n={int(ct.loc[mx,'n'])}（来源：offline_data/students.csv 的 grade、region、reading_score，分组 mean 取最大值，n 为该单元格行数）")
lines.append(f"- 均值最低组合：{mn[0]}×{mn[1]}，均值 {ct.loc[mn,'mean_reading']:.4f}，样本量 n={int(ct.loc[mn,'n'])}（来源：offline_data/students.csv 的 grade、region、reading_score，分组 mean 取最小值，n 为该单元格行数）")
lines.append(f"- 最高与最低均值之差：{ct.loc[mx,'mean_reading']-ct.loc[mn,'mean_reading']:.4f}（来源：由前述两行计算）")
lines.append("")
lines.append("## 3. 结论")
lines.append("")
lines.append(f"数据加载成功且质量良好：400 行无缺失、无异常取值，可直接进入后续交叉分析。reading_score 均值最高的组合为 {mx[0]}×{mx[1]}（n={int(ct.loc[mx,'n'])}），最低为 {mn[0]}×{mn[1]}（n={int(ct.loc[mn,'n'])}）。")
lines.append("")

with open(out, 'w', encoding='utf-8') as f:
    f.write('\n'.join(lines))
print("saved:", out)
print(ct)

