import pandas as pd
import numpy as np

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r1\_sandbox\tmp\app_metrics_W30_W43_inspection.csv")
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week table with window labels and week-over-week deltas
df["window"] = np.where(df["week"] <= "W36", "W30-W36", "W37-W43")
for c in metrics:
    df[f"{c}_wow"] = df[c].diff()

# group means
pre = df[df["window"] == "W30-W36"]
post = df[df["window"] == "W37-W43"]
means = pd.DataFrame({
    "metric": metrics,
    "mean_W30_W36": [round(pre[c].mean(), 6) for c in metrics],
    "mean_W37_W43": [round(post[c].mean(), 6) for c in metrics],
    "n_pre": len(pre), "n_post": len(post),
})
means["abs_diff"] = means["mean_W37_W43"] - means["mean_W30_W36"]
means["pct_diff"] = means["abs_diff"] / means["mean_W30_W36"] * 100
print(means.to_string(index=False))

# breakpoint detection: largest single-week absolute change (normalized by pre-window std)
print("\nWoW deltas:")
print(df[["week"] + metrics + [f"{c}_wow" for c in metrics]].to_string(index=False))

# normalized jump size at each week boundary
score = {}
for c in metrics:
    s = pre[c].std(ddof=0)
    for w, d in zip(df["week"], df[f"{c}_wow"]):
        if pd.notna(d):
            score[w] = score.get(w, 0) + abs(d) / s
print("\nNormalized jump score per week:", sorted(score.items(), key=lambda x: -x[1])[:5])

# save intermediate CSV
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r1\_sandbox\tmp\step2_breakpoint_results.csv"
with pd.ExcelWriter(out.replace(".csv",""), engine="openpyxl") as xw:
    pass  # not needed; just CSV
df.to_csv(out, index=False)
print("\nSAVED:", out)

