import pandas as pd
import numpy as np

df = pd.read_csv("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch6-6/round1/cand/OFF-RET-02-r1/_sandbox/offline_data/app_metrics.csv")

weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df["week"].isin(weeks)].copy()
sub = sub.sort_values("week").reset_index(drop=True)

seg1 = sub[sub["week"].isin([f"W{i:02d}" for i in range(30, 37)])]  # W30-W36
seg2 = sub[sub["week"].isin([f"W{i:02d}" for i in range(37, 44)])]  # W37-W43

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# Group means
means = pd.DataFrame({
    "segment": ["W30-W36", "W37-W43"],
    "n": [len(seg1), len(seg2)],
    "retention_d7_mean": [seg1["retention_d7"].mean(), seg2["retention_d7"].mean()],
    "churn_rate_mean": [seg1["churn_rate"].mean(), seg2["churn_rate"].mean()],
    "arpu_usd_mean": [seg1["arpu_usd"].mean(), seg2["arpu_usd"].mean()],
})
print("=== Group means ===")
print(means.to_string(index=False))

# Deltas
d_ret = means.loc[1, "retention_d7_mean"] - means.loc[0, "retention_d7_mean"]
d_churn = means.loc[1, "churn_rate_mean"] - means.loc[0, "churn_rate_mean"]
d_arpu = means.loc[1, "arpu_usd_mean"] - means.loc[0, "arpu_usd_mean"]
r_ret = d_ret / means.loc[0, "retention_d7_mean"]
r_churn = d_churn / means.loc[0, "churn_rate_mean"]
r_arpu = d_arpu / means.loc[0, "arpu_usd_mean"]

print("\n=== Deltas (W37-W43 minus W30-W36) ===")
print(f"retention_d7: abs={d_ret:.6f}, rel={r_ret*100:.2f}%")
print(f"churn_rate:   abs={d_churn:.6f}, rel={r_churn*100:.2f}%")
print(f"arpu_usd:     abs={d_arpu:.6f}, rel={r_arpu*100:.2f}%")

# Per-week table with week-over-week deltas to pinpoint breakpoint
sub["retention_d7_wow"] = sub["retention_d7"].diff()
sub["churn_rate_wow"] = sub["churn_rate"].diff()
sub["arpu_usd_wow"] = sub["arpu_usd"].diff()
print("\n=== Per-week with WoW deltas ===")
print(sub.to_string(index=False))

# Standard deviations for context
print("\n=== Std devs ===")
for m in metrics:
    print(f"{m}: seg1 std={seg1[m].std(ddof=1):.6f}, seg2 std={seg2[m].std(ddof=1):.6f}")

# Save intermediate results CSV
out = sub[["week","cohort_size","dau","retention_d7","churn_rate","arpu_usd","support_tickets",
           "retention_d7_wow","churn_rate_wow","arpu_usd_wow"]].copy()
out.to_csv("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch6-6/round1/cand/OFF-RET-02-r1/_sandbox/tmp/step2_perweek_w30_w43.csv", index=False)

means_out = means.copy()
means_out["retention_d7_delta_abs"] = [np.nan, d_ret]
means_out["retention_d7_delta_rel_pct"] = [np.nan, r_ret*100]
means_out["churn_rate_delta_abs"] = [np.nan, d_churn]
means_out["churn_rate_delta_rel_pct"] = [np.nan, r_churn*100]
means_out["arpu_usd_delta_abs"] = [np.nan, d_arpu]
means_out["arpu_usd_delta_rel_pct"] = [np.nan, r_arpu*100]
means_out.to_csv("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch6-6/round1/cand/OFF-RET-02-r1/_sandbox/tmp/step2_group_means.csv", index=False)
print("\nSaved step2_perweek_w30_w43.csv and step2_group_means.csv")

