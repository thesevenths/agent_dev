import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
w = df["week"].str[1:].astype(int)
cols = ["retention_d7", "churn_rate", "arpu_usd"]

# Per-week values W30-W43
sub = df[(w>=30)&(w<=43)].copy()
sub["week_num"] = w[(w>=30)&(w<=43)]
sub["segment"] = sub["week_num"].apply(lambda x: "W30-W36" if x<=36 else "W37-W43")
sub["wow_change"] = sub.set_index("week")[cols].diff().loc[sub["week"]]
sub = sub[["week","week_num","segment"]+cols+["wow_change"]]

# Group means
pre = df[(w>=30)&(w<=36)][cols].mean()
post = df[(w>=37)&(w<=43)][cols].mean()
delta = post - pre
delta_pct = (post-pre)/pre*100

summary = pd.DataFrame({
    "metric": cols,
    "mean_W30_W36": pre.values,
    "mean_W37_W43": post.values,
    "delta_post_minus_pre": delta.values,
    "delta_pct": delta_pct.values,
    "n_pre": 7, "n_post": 7,
})

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r5\_sandbox\tmp"
per = sub.to_csv(f"{out_dir}\\step2_per_week_values.csv", index=False)
summ = summary.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)

# breakpoint: week with max |z| of churn wow change within window
print(sub.to_string(index=False))
print()
print(summary.to_string(index=False))

