print("weighted arpu pre:", (pre["arpu_usd"]*pre["cohort_size"]).sum()/pre["cohort_size"].sum())
print("weighted arpu post:", (post["arpu_usd"]*post["cohort_size"]).sum()/post["cohort_size"].sum())
# min/max
