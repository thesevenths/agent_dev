post = df[(w>=37)&(w<=43)][["retention_d7","churn_rate","arpu_usd"]]
mp, mq = pre.mean(), post.mean()
print("pre mean:", mp.to_dict(), "n=", len(pre))
print("post mean:", mq.to_dict(), "n=", len(post))
print("delta (post-pre):", (mq-mp).to_dict())
print("delta %:", ((mq-mp)/mp*100).to_dict())
