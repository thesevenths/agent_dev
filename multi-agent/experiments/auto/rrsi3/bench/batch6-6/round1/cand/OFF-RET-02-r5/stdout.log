print("weighted ret post:", (post["retention_d7"]*post["cohort_size"]).sum()/post["cohort_size"].sum())
print("weighted churn pre:", (pre["churn_rate"]*pre["cohort_size"]).sum()/pre["cohort_size"].sum())
