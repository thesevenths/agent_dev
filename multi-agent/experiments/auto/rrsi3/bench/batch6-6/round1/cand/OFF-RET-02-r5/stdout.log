cols = ["retention_d7","churn_rate","arpu_usd"]
d = df.set_index("week")[cols]
print("W36->W37 change:", (d.loc["W37"]-d.loc["W36"]).to_dict())
# largest single-week drop in retention
print("retention weekly diff:\n", d["retention_d7"].diff().loc["W30":"W43"])
print("churn weekly diff:\n", d["churn_rate"].diff().loc["W30":"W43"])

