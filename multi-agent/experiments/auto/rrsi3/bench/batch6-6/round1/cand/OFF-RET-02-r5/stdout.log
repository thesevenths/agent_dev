import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-02-r5\_sandbox\tmp"
df = pd.read_csv(path)
metrics = ['retention_d7','churn_rate','arpu_usd']

pre = df[df['week'].between('W30','W36')]
post = df[df['week'].between('W37','W43')]
print("pre rows:", len(pre), "post rows:", len(post))

means = pd.DataFrame({
    'period': ['W30-W36 (pre)','W37-W43 (post)'],
    'n': [len(pre), len(post)],
    'retention_d7_mean': [pre['retention_d7'].mean(), post['retention_d7'].mean()],
    'churn_rate_mean': [pre['churn_rate'].mean(), post['churn_rate'].mean()],
    'arpu_usd_mean': [pre['arpu_usd'].mean(), post['arpu_usd'].mean()],
})
means['retention_d7_delta'] = means['retention_d7_mean'].iloc[1]-means['retention_d7_mean'].iloc[0]
means['churn_rate_delta'] = means['churn_rate_mean'].iloc[1]-means['churn_rate_mean'].iloc[0]
means['arpu_usd_delta'] = means['arpu_usd_mean'].iloc[1]-means['arpu_usd_mean'].iloc[0]
means['retention_d7_pct_change'] = means['retention_d7_delta']/means['retention_d7_mean'].iloc[0]*100
means['churn_rate_pct_change'] = means['churn_rate_delta']/means['churn_rate_mean'].iloc[0]*100
means['arpu_usd_pct_change'] = means['arpu_usd_delta']/means['arpu_usd_mean'].iloc[0]*100
pd.set_option('display.float_format', lambda x: f'{x:.6f}')
print(means.to_string(index=False))

# per-week table W30-W43
sub = df[df['week'].between('W30','W43')][['week']+metrics].copy()
sub['period'] = sub['week'].apply(lambda w: 'pre' if w <= 'W36' else 'post')
sub['retention_d7_wow'] = sub['retention_d7'].diff()
sub['churn_rate_wow'] = sub['churn_rate'].diff()
sub['arpu_usd_wow'] = sub['arpu_usd'].diff()
print(sub.to_string(index=False))

# breakpoint detection: largest single-week jump in churn_rate / drop in retention
print("\nLargest churn_rate WoW jump:", sub.loc[sub['churn_rate_wow'].idxmax(),'week'], sub['churn_rate_wow'].max())
print("Largest retention_d7 WoW drop:", sub.loc[sub['retention_d7_wow'].idxmin(),'week'], sub['retention_d7_wow'].min())

# save intermediate CSV
out = pd.concat([
    means.assign(level='group_mean'),
    sub.assign(level='per_week'),
], ignore_index=True)
out_path = f"{out_dir}\\step2_group_means_breakpoint.csv"
out.to_csv(out_path, index=False)
print("\nsaved:", out_path)

```
