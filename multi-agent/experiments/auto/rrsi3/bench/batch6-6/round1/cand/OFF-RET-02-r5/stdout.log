import pandas as pd
df = pd.read_csv("offline_data/app_metrics.csv")
w = df["week"].str[1:].astype(int)
pre = df[(w>=30)&(w<=36)]
post = df[(w>=37)&(w<=43)]
print("pre cohort sum:", pre["cohort_size"].sum(), "post cohort sum:", post["cohort_size"].sum())
print("pre dau sum:", pre["dau"].sum(), "post dau sum:", post["dau"].sum())
print("pre tickets:", pre["support_tickets"].sum(), "post tickets:", post["support_tickets"].sum())
