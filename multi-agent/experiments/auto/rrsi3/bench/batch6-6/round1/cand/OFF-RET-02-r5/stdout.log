print("post ret range:", post["retention_d7"].min(), post["retention_d7"].max())
print("pre churn range:", pre["churn_rate"].min(), pre["churn_rate"].max())
print("post churn range:", post["churn_rate"].min(), post["churn_rate"].max())
print("pre arpu range:", pre["arpu_usd"].min(), pre["arpu_usd"].max())
print("post arpu range:", post["arpu_usd"].min(), post["arpu_usd"].max())

