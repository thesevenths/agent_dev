```python
import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
n = len(df)

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

# p-values via scipy if available
try:
    from scipy import stats
    p_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"])[1]
    p_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"])[1]
except Exception as e:
    p_math = p_read = None
    print("scipy unavailable:", e)

out = {
    "n": n,
    "pearson_screen_vs_math": round(float(r_math), 6),
    "pearson_screen_vs_reading": round(float(r_read), 6),
    "p_value_screen_vs_math": p_math,
    "p_value_screen_vs_reading": p_read,
}
print(json.dumps(out, indent=2))

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-02-r5\_sandbox\tmp\step2_correlations.json", "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved")

