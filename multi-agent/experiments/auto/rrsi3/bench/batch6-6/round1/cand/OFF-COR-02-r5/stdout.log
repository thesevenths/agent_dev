import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high(>5)", False: "low(<=5)"})

g = df.groupby("group").agg(
    n=("student_id", "count"),
    mean_screen=("screen_hours_per_day", "mean"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
)
print(g)

high = g.loc["high(>5)"]; low = g.loc["low(<=5)"]
out = {
    "n_total": len(df),
    "high_gt5": {
        "n": int(high["n"]),
        "mean_screen_hours_per_day": round(float(high["mean_screen"]), 6),
        "mean_math_score": round(float(high["mean_math"]), 6),
        "mean_reading_score": round(float(high["mean_reading"]), 6),
    },
    "low_le5": {
        "n": int(low["n"]),
        "mean_screen_hours_per_day": round(float(low["mean_screen"]), 6),
        "mean_math_score": round(float(low["mean_math"]), 6),
        "mean_reading_score": round(float(low["mean_reading"]), 6),
    },
    "diff_high_minus_low": {
        "mean_math_score": round(float(high["mean_math"] - low["mean_math"]), 6),
        "mean_reading_score": round(float(high["mean_reading"] - low["mean_reading"]), 6),
    },
}
print(json.dumps(out, indent=2))

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-02-r5\_sandbox\tmp\step3_group_comparison.json", "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved")

