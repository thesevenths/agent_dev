import pandas as pd
import numpy as np
import json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-COR-02-r5\_sandbox\tmp"

df = pd.read_csv(path)
cols = ["screen_hours_per_day","math_score","reading_score"]
d = df.dropna(subset=cols)
n = len(d)

# Pearson
corr_math = d["screen_hours_per_day"].corr(d["math_score"])
corr_read = d["screen_hours_per_day"].corr(d["reading_score"])
# Spearman
from scipy.stats import pearsonr, spearmanr
pm, pm_p = pearsonr(d["screen_hours_per_day"], d["math_score"])
pr, pr_p = pearsonr(d["screen_hours_per_day"], d["reading_score"])
sm, sm_p = spearmanr(d["screen_hours_per_day"], d["math_score"])
sr, sr_p = spearmanr(d["screen_hours_per_day"], d["reading_score"])

# groups
hi = d[d["screen_hours_per_day"] > 5]
lo = d[d["screen_hours_per_day"] <= 5]
g = {
 "hi": {"n": len(hi), "math_mean": hi["math_score"].mean(), "read_mean": hi["reading_score"].mean(),
        "math_std": hi["math_score"].std(ddof=1), "read_std": hi["reading_score"].std(ddof=1)},
 "lo": {"n": len(lo), "math_mean": lo["math_score"].mean(), "read_mean": lo["reading_score"].mean(),
        "math_std": lo["math_score"].std(ddof=1), "read_std": lo["reading_score"].std(ddof=1)},
}
g["math_diff"] = g["hi"]["math_mean"] - g["lo"]["math_mean"]
g["read_diff"] = g["hi"]["read_mean"] - g["lo"]["read_mean"]

res = {
 "n_total": n,
 "corr_pearson_math": corr_math, "corr_pearson_reading": corr_read,
 "pearson_p_math": pm_p, "pearson_p_reading": pr_p,
 "spearman_math": sm, "spearman_reading": sr,
 "spearman_p_math": sm_p, "spearman_p_reading": sr_p,
 "groups": g,
 "overall": {"math_mean": d["math_score"].mean(), "read_mean": d["reading_score"].mean(),
             "screen_mean": d["screen_hours_per_day"].mean()},
}
with open(out + r"\step1_exploration.json","w",encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
