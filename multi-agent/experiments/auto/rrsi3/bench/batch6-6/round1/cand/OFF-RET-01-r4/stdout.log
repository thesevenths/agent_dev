import pandas as pd, json, os

df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
first30, last30 = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
thr = overall_mean - 2*overall_std
below = r[r < thr]

res = {
  "source_file": "offline_data/app_metrics.csv",
  "column": "retention_d7",
  "n_total": int(len(r)),
  "first30": {"weeks": "W01-W30", "n": 30, "mean": float(first30.mean()), "std": float(first30.std(ddof=1))},
  "last30": {"weeks": "W31-W60", "n": 30, "mean": float(last30.mean()), "std": float(last30.std(ddof=1))},
  "diff_mean_last_minus_first": float(last30.mean() - first30.mean()),
  "overall": {"mean": float(overall_mean), "std": float(overall_std)},
  "threshold_mean_minus_2std": float(thr),
  "weeks_below_threshold_count": int(len(below)),
  "weeks_below_threshold": below.index.tolist(),
  "weeks_below_values": {k: float(v) for k, v in below.items()},
}
out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-01-r4\_sandbox\tmp'
os.makedirs(out, exist_ok=True)
path = os.path.join(out, 'retention_d7_stats.json')
with open(path, 'w', encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print('saved:', path)

