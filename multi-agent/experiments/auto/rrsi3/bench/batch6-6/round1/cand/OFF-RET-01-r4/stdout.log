import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
thr = overall_mean - 2*overall_std
below = df[r < thr]

res = {
  "n_total": len(r),
  "first30": {"weeks": list(df["week"].iloc[:30]), "mean": first.mean(), "std": first.std(ddof=1)},
  "last30": {"weeks": list(df["week"].iloc[30:]), "mean": last.mean(), "std": last.std(ddof=1)},
  "diff_mean": last.mean() - first.mean(),
  "diff_std": last.std(ddof=1) - first.std(ddof=1),
  "overall_mean": overall_mean,
  "overall_std": overall_std,
  "threshold": thr,
  "below_count": int((r < thr).sum()),
  "below_weeks": list(below["week"]),
  "below_values": {w: v for w, v in zip(below["week"], below["retention_d7"])},
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\cand\OFF-RET-01-r4\_sandbox\tmp"
os.makedirs(out, exist_ok=True)
with open(os.path.join(out, "retention_d7_stats.json"), "w") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print(json.dumps(res, indent=2))

