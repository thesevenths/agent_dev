```python
import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv('offline_data/students.csv')
cols = ['study_hours_per_week','sleep_hours_per_night','attendance_pct','screen_hours_per_day']
res = []
for c in cols:
    r, p = stats.pearsonr(df[c], df['math_score'])
    res.append((c, r, p, df[c].mean(), df[c].std(), df[c].min(), df[c].max()))
for x in res: print(x)
print('math_score mean/std:', df['math_score'].mean(), df['math_score'].std())
print('n =', len(df))
print('nulls:', df[cols+['math_score']].isna().sum().sum())

```
