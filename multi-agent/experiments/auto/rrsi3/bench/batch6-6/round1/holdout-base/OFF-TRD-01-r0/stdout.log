import pandas as pd

m = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step2_monthly_revenue.csv")
print(m.to_string(index=False))

rows = []
for year, sub in m.groupby("year"):
    nd = sub[sub["month_no"].isin([11, 12])]
    other = sub[~sub["month_no"].isin([11, 12])]
    nd_units = nd["units"].sum()
    other_units = other["units"].sum()
    nd_avg = nd_units / 2
    other_avg = other_units / 10
    ratio = nd_avg / other_avg
    rows.append({
        "year": year,
        "nov_dec_units_total": nd_units,
        "nov_dec_avg_monthly_units": round(nd_avg, 1),
        "jan_oct_units_total": other_units,
        "jan_oct_avg_monthly_units": round(other_avg, 1),
        "amplification_ratio": round(ratio, 4),
        "nov_dec_rows": len(nd) * 12,   # each month = 12 rows in source
        "jan_oct_rows": len(other) * 12,
    })

res = pd.DataFrame(rows)
print("\n=== Nov-Dec amplification ===")
print(res.to_string(index=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step3_nov_dec_amplification.csv"
res.to_csv(out, index=False, encoding="utf-8-sig")
import os
print("\nsaved:", out, os.path.getsize(out), "bytes")

