```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp"

df = pd.read_csv(src)
df['year'] = df['month'].str[:4]
df['month_num'] = df['month'].str[5:7].astype(int)

# Monthly aggregation (all regions, all product lines)
monthly = df.groupby('month').agg(
    revenue=('revenue', 'sum'),
    units=('units', 'sum'),
    rows=('revenue', 'size'),
).reset_index()
monthly['year'] = monthly['month'].str[:4]
monthly['month_num'] = monthly['month'].str[5:7].astype(int)
monthly.to_csv(f"{out_dir}\\step2_monthly_revenue.csv", index=False)

# Annual aggregation
annual = df.groupby('year').agg(
    revenue=('revenue', 'sum'),
    units=('units', 'sum'),
    rows=('revenue', 'size'),
).reset_index()
annual.to_csv(f"{out_dir}\\step2_annual_revenue.csv", index=False)

# YoY
r24 = annual.loc[annual.year=='2024','revenue'].iloc[0]
r25 = annual.loc[annual.year=='2025','revenue'].iloc[0]
u24 = annual.loc[annual.year=='2024','units'].iloc[0]
u25 = annual.loc[annual.year=='2025','units'].iloc[0]
yoy_rev = (r25 - r24) / r24
yoy_units = (u25 - u24) / u24

print("=== monthly ===")
print(monthly.to_string(index=False))
print("\n=== annual ===")
print(annual.to_string(index=False))
print(f"\n2024 revenue: {r24:,.2f} (144 rows)")
print(f"2025 revenue: {r25:,.2f} (144 rows)")
print(f"YoY revenue growth: {yoy_rev:.6f} = {yoy_rev*100:.2f}%")
print(f"2024 units: {u24:,}  2025 units: {u25:,}  YoY units: {yoy_units*100:.2f}%")

# Nov-Dec preview for next step
for y in ['2024','2025']:
    sub = monthly[monthly.year==y]
    nd = sub[sub.month_num.isin([11,12])].units.sum()
    rest = sub[~sub.month_num.isin([11,12])].units.sum()
    nd_avg = nd/2
    rest_avg = rest/10
    print(f"{y}: Nov+Dec units={nd:,}, other 10 months units={rest:,}, avg Nov-Dec={nd_avg:,.1f}, avg other={rest_avg:,.1f}, ratio={nd_avg/rest_avg:.4f}")

```
