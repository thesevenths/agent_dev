import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
df["year"] = df["month"].str[:4]

# Monthly aggregates
m = df.groupby("month").agg(
    revenue=("revenue", "sum"),
    units=("units", "sum"),
    rows=("revenue", "size"),
).reset_index()
m["year"] = m["month"].str[:4]
m["month_no"] = m["month"].str[5:7].astype(int)

# Annual aggregates
a = df.groupby("year").agg(
    total_revenue=("revenue", "sum"),
    total_units=("units", "sum"),
    rows=("revenue", "size"),
).reset_index()
a["yoy_revenue_pct"] = a["total_revenue"].pct_change() * 100
a["yoy_units_pct"] = a["total_units"].pct_change() * 100

print("=== monthly ===")
print(m.to_string(index=False))
print("\n=== annual ===")
print(a.to_string(index=False))

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp"
m.to_csv(f"{out_dir}\\step2_monthly_revenue.csv", index=False, encoding="utf-8-sig")
a.to_csv(f"{out_dir}\\step2_annual_revenue.csv", index=False, encoding="utf-8-sig")
print("\nsaved step2_monthly_revenue.csv and step2_annual_revenue.csv")

