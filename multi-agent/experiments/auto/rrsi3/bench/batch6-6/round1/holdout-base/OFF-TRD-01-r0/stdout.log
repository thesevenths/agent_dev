```python
import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
m = df.groupby("month").agg(revenue=("revenue","sum"), units=("units","sum"))
m["year"] = m.index.str[:4]
m["month_no"] = m.index.str[5:7].astype(int)

y24 = m[m.year=="2024"]; y25 = m[m.year=="2025"]
r24, r25 = y24.revenue.sum(), y25.revenue.sum()
u24, u25 = y24.units.sum(), y25.units.sum()
print(f"2024 revenue={r24:.2f} units={u24}")
print(f"2025 revenue={r25:.2f} units={u25}")
print(f"YoY revenue={(r25/r24-1)*100:.2f}%  YoY units={(u25/u24-1)*100:.2f}%")

for y, sub in [("2024", y24), ("2025", y25)]:
    nd = sub[sub.month_no.isin([11,12])].units.sum()
    other = sub[~sub.month_no.isin([11,12])].units.sum()
    avg_nd = nd/2; avg_other = other/10
    print(f"{y}: Nov-Dec units={nd}, other={other}, avg Nov-Dec={avg_nd:.1f}, avg other={avg_other:.1f}, ratio={avg_nd/avg_other:.4f}")

```
