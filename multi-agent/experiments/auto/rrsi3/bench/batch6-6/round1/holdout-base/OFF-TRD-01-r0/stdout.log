import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker
import numpy as np

plt.rcParams["font.sans-serif"] = ["Microsoft YaHei", "SimHei", "DejaVu Sans"]
plt.rcParams["axes.unicode_minus"] = False

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp"
m = pd.read_csv(f"{out_dir}\\step2_monthly_revenue.csv")
amp = pd.read_csv(f"{out_dir}\\step3_nov_dec_amplification.csv")

# ---------- Chart 1: monthly revenue trend, 2024 vs 2025 ----------
fig, ax = plt.subplots(figsize=(11, 5.5))
for year, color in [("2024", "#4C72B0"), ("2025", "#DD8452")]:
    sub = m[m["year"] == year]
    ax.plot(sub["month_no"], sub["revenue"] / 1e6, marker="o", ms=4, lw=2,
            color=color, label=f"{year} 月度营收")
ax.set_xlabel("月份")
ax.set_ylabel("营收（百万元）")
ax.set_title("月度营收趋势：2024 vs 2025\n（来源：offline_data/regional_sales.csv 的 revenue，按月求和，每月 12 行）")
ax.set_xticks(range(1, 13))
ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"{v:,.0f}"))
ax.grid(alpha=0.3)
ax.legend()
# annotate Nov-Dec
for year, color in [("2024", "#4C72B0"), ("2025", "#DD8452")]:
    sub = m[m["year"] == year]
    nd = sub[sub["month_no"].isin([11, 12])]["revenue"].sum() / 1e6
    ax.annotate(f"{year} 11-12月\n{nd:,.1f}M", xy=(11.5, nd), xytext=(9.2, nd + 0.6),
                fontsize=8, color=color,
                arrowprops=dict(arrowstyle="->", color=color, lw=0.8))
fig.tight_layout()
p1 = f"{out_dir}\\step4_monthly_revenue_trend.png"
fig.savefig(p1, dpi=150)
plt.close(fig)

# ---------- Chart 2: seasonal amplification ----------
fig, ax = plt.subplots(figsize=(8, 5))
years = amp["year"].astype(str)
ratios = amp["amplification_ratio"]
bars = ax.bar(years, ratios, width=0.45, color=["#4C72B0", "#DD8452"])
ax.axhline(1.0, color="gray", ls="--", lw=1)
ax.text(1.45, 1.0, "1.0x（无放大）", fontsize=8, color="gray", va="bottom")
for b, r in zip(bars, ratios):
    ax.text(b.get_x() + b.get_width() / 2, r + 0.01, f"{r:.4f}x",
            ha="center", fontsize=11, fontweight="bold")
ax.set_ylim(0, max(ratios) * 1.2)
ax.set_ylabel("放大倍数（11-12月单月均销量 ÷ 1-10月单月均销量）")
ax.set_title("11-12 月销量季节性放大倍数\n（来源：offline_data/regional_sales.csv 的 units，11-12月各24行、1-10月各120行求和后计算）")
ax.grid(axis="y", alpha=0.3)
fig.tight_layout()
p2 = f"{out_dir}\\step4_seasonal_amplification.png"
fig.savefig(p2, dpi=150)
plt.close(fig)

import os
for p in [p1, p2]:
    print(p, os.path.exists(p), os.path.getsize(p), "bytes")

