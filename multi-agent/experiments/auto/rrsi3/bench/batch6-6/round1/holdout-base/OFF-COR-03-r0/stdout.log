import pandas as pd
import numpy as np
import json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-COR-03-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

cols = ["math_score", "study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
n = len(df)

# Pearson correlation matrix
corr = df[cols].corr(method="pearson")
print("CORR MATRIX:\n", corr.to_string())

# Simple OLS: math_score ~ X  (slope = cov/var, intercept = mean_y - slope*mean_x)
y = df["math_score"].values.astype(float)
results = []
for xcol in cols[1:]:
    x = df[xcol].values.astype(float)
    slope = np.cov(x, y, ddof=1)[0, 1] / np.var(x, ddof=1)
    intercept = y.mean() - slope * x.mean()
    yhat = slope * x + intercept
    ss_res = np.sum((y - yhat) ** 2)
    ss_tot = np.sum((y - y.mean()) ** 2)
    r2 = 1 - ss_res / ss_tot
    # t-stat for slope
    r = np.corrcoef(x, y)[0, 1]
    t = r * np.sqrt((n - 2) / (1 - r ** 2))
    # p-value via scipy
    from scipy import stats
    p = 2 * stats.t.sf(abs(t), df=n - 2)
    results.append({
        "predictor": xcol,
        "pearson_r": round(r, 6),
        "slope": round(slope, 6),
        "intercept": round(intercept, 6),
        "r_squared": round(r2, 6),
        "t_stat": round(t, 4),
        "p_value": float(f"{p:.6g}"),
        "n": n,
    })
    print(results[-1])

out = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "as_of": "2026-10-26 15:51",
    "correlation_matrix": {
        a: {b: round(corr.loc[a, b], 6) for b in cols} for a in cols
    },
    "regressions": results,
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp\step2_stats.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("\nSaved:", out_path)

# Also save a small CSV of regressions
pd.DataFrame(results).to_csv(out_path.replace(".json", ".csv"), index=False)
print("Saved CSV:", out_path.replace(".json", ".csv"))

