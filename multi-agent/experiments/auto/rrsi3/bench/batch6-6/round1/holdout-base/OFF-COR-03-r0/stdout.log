```python
import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv("offline_data/students.csv")
preds = ["study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
y = "math_score"
n = len(df)

rows = []
for p in preds:
    r, pval = stats.pearsonr(df[p], df[y])
    # simple OLS slope
    slope, intercept, r_value, p_value, se = stats.linregress(df[p], df[y])
    rows.append({
        "predictor": p,
        "pearson_r": round(r, 4),
        "p_value": pval,
        "ols_slope": round(slope, 4),
        "ols_intercept": round(intercept, 4),
        "r_squared": round(r_value**2, 4),
        "slope_se": round(se, 4),
        "mean_predictor": round(df[p].mean(), 4),
        "mean_math_score": round(df[y].mean(), 4),
        "n": n,
    })

res = pd.DataFrame(rows)
# also full correlation matrix among the 5 vars
corr = df[[y] + preds].corr().round(4)
res.to_csv("tmp/step2_corr_regression.csv", index=False)
corr.to_csv("tmp/step2_corr_matrix.csv")
print(res.to_string(index=False))
print()
print(corr)

```
