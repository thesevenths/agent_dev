    rows.append({
        "predictor": p,
        "pearson_r": round(r, 4),
        "p_value": pval,
        "ols_slope": round(slope, 4),
        "ols_intercept": round(intercept, 4),
        "r_squared": round(r_value**2, 4),
        "slope_se": round(se, 4),
        "mean_predictor": round(df[p].mean(), 4),
        "mean_math_score": round(df[y].mean(), 4),
        "n": n,
    })

res = pd.DataFrame(rows)
# also full correlation matrix among the 5 vars
corr = df[[y] + preds].corr().round(4)
