import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\multi-agent"  # placeholder
base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\holdout-base\OFF-STAT-01-r0\_sandbox"
out_dir = os.path.join(base, "tmp")
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
s = df["math_score"]

q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
iqr = q3 - q1
lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
out_mask = (s < lo) | (s > hi)
out_count = int(out_mask.sum())

res = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "n_rows": int(len(df)),
    "n_valid": int(s.notna().sum()),
    "n_missing": int(s.isna().sum()),
    "mean": float(s.mean()),
    "std_sample": float(s.std(ddof=1)),
    "std_pop": float(s.std(ddof=0)),
    "median": float(s.median()),
    "q1": float(q1),
    "q3": float(q3),
    "iqr": float(iqr),
    "min": float(s.min()),
    "max": float(s.max()),
    "lower_fence": float(lo),
    "upper_fence": float(hi),
    "outlier_count": out_count,
    "outlier_ratio": out_count / len(df),
    "outlier_ids": df.loc[out_mask, "student_id"].tolist(),
    "outlier_values": s[out_mask].tolist(),
    "as_of": "2026-10-25 18:13",
}
with open(os.path.join(out_dir, "math_score_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

