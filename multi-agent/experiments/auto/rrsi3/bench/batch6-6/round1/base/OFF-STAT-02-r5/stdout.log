import pandas as pd, json, numpy as np

df = pd.read_csv("offline_data/students.csv")
m, r = df["math_score"], df["reading_score"]
n = len(df)
missing = int(m.isna().sum() + r.isna().sum())

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "missing_cells": missing,
    "math_score": {
        "mean": float(m.mean()),
        "std_sample": float(m.std(ddof=1)),
        "std_pop": float(m.std(ddof=0)),
        "median": float(m.median()),
        "cv_sample": float(m.std(ddof=1)/m.mean()),
        "cv_pop": float(m.std(ddof=0)/m.mean()),
        "min": int(m.min()), "max": int(m.max()),
    },
    "reading_score": {
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_pop": float(r.std(ddof=0)),
        "median": float(r.median()),
        "cv_sample": float(r.std(ddof=1)/r.mean()),
        "cv_pop": float(r.std(ddof=0)/r.mean()),
        "min": int(r.min()), "max": int(r.max()),
    },
    "pearson_r": float(np.corrcoef(m, r)[0,1]),
    "pearson_r_pop_std": float(np.corrcoef(m, r)[0,1]),
}
# t-test for significance of r
from scipy import stats
t, pval = stats.pearsonr(m, r)
res["pearson_t"] = float(t); res["pearson_pvalue"] = float(pval)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r5\_sandbox\tmp\stats_results.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, indent=2))
print("saved:", out)

