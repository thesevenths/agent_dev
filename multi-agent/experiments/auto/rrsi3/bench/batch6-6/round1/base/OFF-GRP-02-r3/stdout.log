import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-02-r3\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

ct = df.groupby(['grade','region']).agg(n=('reading_score','size'), mean_reading=('reading_score','mean'))

def md_table(ct):
    lines = ["| grade | region | 行数 | reading_score 均值 |", "|---|---|---|---|"]
    for (g,r), row in ct.iterrows():
        lines.append(f"| {g} | {r} | {int(row['n'])} | {row['mean_reading']:.4f} |")
    return "\n".join(lines)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-02-r3\_sandbox\tmp\step1_validation.md"
with open(out,'w',encoding='utf-8') as f:
    f.write("# Step 1: students.csv 加载与校验\n\n")
    f.write(f"- 文件: offline_data/students.csv\n- 总行数: {len(df)}（不含表头）\n- 列数: {df.shape[1]}\n")
    f.write("- 列名: " + ", ".join(df.columns) + "\n")
    f.write("- 必需列 grade / region / reading_score: 均存在\n")
    f.write("- 缺失值: 全部 10 列缺失数均为 0\n")
    f.write("- grade 取值: G10, G11, G12（无其他值）\n")
    f.write("- region 取值: A, B, C, D（无其他值）\n")
    f.write("- reading_score: int64, 范围 55–100, 全表均值 80.94\n")
    f.write("- student_id 重复: 0\n\n")
    f.write("## grade × region 交叉表（行数 / reading_score 均值）\n\n")
    f.write(md_table(ct))
    f.write("\n")
print("saved:", out)
print(md_table(ct))

