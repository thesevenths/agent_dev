```python
import pandas as pd, json, numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
  "n_total": len(r),
  "first30": {"weeks": list(df["week"].iloc[:30]), "mean": first.mean(), "std": first.std(ddof=1), "min": first.min(), "max": first.max()},
  "last30": {"weeks": list(df["week"].iloc[30:]), "mean": last.mean(), "std": last.std(ddof=1), "min": last.min(), "max": last.max()},
  "diff_mean_last_minus_first": last.mean() - first.mean(),
  "diff_std_last_minus_first": last.std(ddof=1) - first.std(ddof=1),
  "overall": {"mean": overall_mean, "std": overall_std, "threshold_mean_minus_2std": threshold},
  "weeks_below_threshold": {"count": len(below), "weeks": list(below["week"]), "values": list(below["retention_d7"])},
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-01-r5\_sandbox\tmp\retention_d7_stats.json","w") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print(json.dumps(res, indent=2))

```
