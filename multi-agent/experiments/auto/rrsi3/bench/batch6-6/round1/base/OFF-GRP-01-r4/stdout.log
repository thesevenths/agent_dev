def classify(d):
    a = abs(d)
    if a < 0.2: return "可忽略 (negligible, |d|<0.2)"
    if a < 0.5: return "小 (small, 0.2≤|d|<0.5)"
    if a < 0.8: return "中 (medium, 0.5≤|d|<0.8)"
    return "大 (large, |d|≥0.8)"

