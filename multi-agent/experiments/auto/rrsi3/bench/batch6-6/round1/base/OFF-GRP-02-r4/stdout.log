import pandas as pd, json, os
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-02-r4\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-02-r4\_sandbox\tmp"
df = pd.read_csv(path)

# cross-tab counts
ct = df.groupby(['grade','region']).size().unstack(fill_value=0)
# reading_score means
means = df.groupby(['grade','region'])['reading_score'].mean().unstack()
# also per-cell sample count for means (same as ct)
print(ct.to_string())
print()
print(means.round(4).to_string())
print()
print("overall mean:", df['reading_score'].mean())

# save validation summary json
summary = {
    "file": path,
    "shape": list(df.shape),
    "columns": list(df.columns),
    "required_columns_present": all(c in df.columns for c in ['grade','region','reading_score']),
    "null_counts": df.isna().sum().to_dict(),
    "grade_values": sorted(df['grade'].unique().tolist()),
    "region_values": sorted(df['region'].unique().tolist()),
    "reading_score": {
        "min": int(df['reading_score'].min()),
        "max": int(df['reading_score'].max()),
        "mean": round(float(df['reading_score'].mean()), 4),
        "std": round(float(df['reading_score'].std()), 4),
    },
    "duplicated_full_rows": int(df.duplicated().sum()),
    "cross_tab_counts": ct.to_dict(),
    "cross_tab_means": {g: {r: round(float(v),4) for r,v in row.items()} for g,row in means.iterrows()},
}
out = os.path.join(out_dir, "step1_validation_summary.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("saved:", out)

```
