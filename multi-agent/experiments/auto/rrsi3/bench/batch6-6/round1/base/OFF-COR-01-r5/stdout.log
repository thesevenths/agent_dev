import pandas as pd, numpy as np
df = pd.read_csv("offline_data/students.csv")
cols = ["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day"]
res = []
for c in cols:
    r = df[c].corr(df["math_score"], method="pearson")
    res.append((c, r))
res.sort(key=lambda x: -abs(x[1]))
for c, r in res:
    print(c, round(r, 6))
print("n =", len(df))
print(df[cols + ["math_score"]].describe().round(3).to_string())
# significance: t = r*sqrt(n-2)/sqrt(1-r^2)
from scipy import stats
for c, r in res:
    t = r*np.sqrt(len(df)-2)/np.sqrt(1-r**2)
    p = 2*stats.t.sf(abs(t), len(df)-2)
    print(c, "t=", round(t,3), "p=", p)

