import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
assert len(df) == 60

first = r.iloc[:30]
last = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
first_mean, first_std = first.mean(), first.std(ddof=1)
last_mean, last_std = last.mean(), last.std(ddof=1)
diff = last_mean - first_mean
threshold = overall_mean - 2*overall_std
below = (r < threshold).sum()
below_weeks = df.loc[r < threshold, 'week'].tolist()

print(f"first30: mean={first_mean:.6f} std={first_std:.6f}")
print(f"last30:  mean={last_mean:.6f} std={last_std:.6f}")
print(f"diff(last-first)={diff:.6f}")
print(f"overall: mean={overall_mean:.6f} std={overall_std:.6f} threshold={threshold:.6f}")
print(f"weeks below threshold: {below} -> {below_weeks}")
# also ddof=0 for reference
print("ddof0 overall std:", r.std(ddof=0), "first:", first.std(ddof=0), "last:", last.std(ddof=0))

out = pd.DataFrame({
    'metric': ['first30_mean','first30_std','last30_mean','last30_std','diff_last_minus_first',
               'overall_mean','overall_std','threshold_mean_minus_2std','weeks_below_threshold'],
    'value': [first_mean, first_std, last_mean, last_std, diff, overall_mean, overall_std, threshold, below]
})
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-01-r2\_sandbox\tmp\retention_d7_stats.csv', index=False)
print(out)
print(df['week'].iloc[0], df['week'].iloc[-1])

```
