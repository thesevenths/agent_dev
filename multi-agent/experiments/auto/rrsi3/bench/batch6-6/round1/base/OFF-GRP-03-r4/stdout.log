```python
import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
print(df.shape)
print(df[["study_hours_per_week","math_score"]].isna().sum())

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group")["math_score"].agg(n="count", mean="mean", std="std", min="min", max="max")
print(g)

low_mean = g.loc["low","mean"]; high_mean = g.loc["high","mean"]
gain = high_mean - low_mean
ratio = high_mean/low_mean
print("gain:", gain, "ratio:", ratio)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-03-r4\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
res = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "groups": {k: {"n": int(v["n"]), "mean_math_score": round(float(v["mean"]),4),
                 "std": round(float(v["std"]),4), "min": int(v["min"]), "max": int(v["max"]),
                 "hours_range": [float(df[df.group==k]["study_hours_per_week"].min()),
                                 float(df[df.group==k]["study_hours_per_week"].max())]}
             for k,v in g.iterrows()},
  "low_to_high_gain": round(float(gain),4),
  "high_over_low_ratio": round(float(ratio),4),
  "overall_mean_math_score": round(float(df["math_score"].mean()),4),
  "overall_mean_hours": round(float(df["study_hours_per_week"].mean()),4),
}
with open(os.path.join(out_dir,"group_stats.json"),"w",encoding="utf-8") as f:
    json.dump(res,f,ensure_ascii=False,indent=2)
print(json.dumps(res,ensure_ascii=False,indent=2))
print("saved to", os.path.join(out_dir,"group_stats.json"))

