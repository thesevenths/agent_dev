sp = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
d = diff / sp
print(n0, n1, m0, m1, s0, s1, diff, sp, d)
print("pooled in json:", s["pooled_std"], "d in json:", s["cohens_d"])
print("label json:", s["effect_label"])

