import pandas as pd, numpy as np, json

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)
med = df["retention_d7"].median()

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])

df["group"] = np.where(df["retention_d7"] > med, "high", "low")
g = df.groupby("group").agg(
    n_weeks=("week","count"),
    mean_arpu=("arpu_usd","mean"),
    sum_cohort=("cohort_size","sum"),
    mean_retention=("retention_d7","mean"),
    mean_churn=("churn_rate","mean"),
)
print("median:", med)
print("corr arpu:", r_arpu, "corr churn:", r_churn)
print(g)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r2\_sandbox\tmp\step2_results.csv"
res = pd.DataFrame({
    "metric": ["n_rows","retention_d7_median","pearson_retention_d7_vs_arpu_usd","pearson_retention_d7_vs_churn_rate",
               "high_group_n_weeks","high_group_mean_arpu_usd","high_group_sum_cohort_size",
               "low_group_n_weeks","low_group_mean_arpu_usd","low_group_sum_cohort_size",
               "high_group_mean_retention_d7","low_group_mean_retention_d7",
               "high_group_mean_churn_rate","low_group_mean_churn_rate",
               "arpu_gap_high_minus_low","arpu_ratio_high_over_low","cohort_share_high_pct"],
    "value": [n, med, r_arpu, r_churn,
              int(g.loc["high","n_weeks"]), g.loc["high","mean_arpu"], int(g.loc["high","sum_cohort"]),
              int(g.loc["low","n_weeks"]), g.loc["low","mean_arpu"], int(g.loc["low","sum_cohort"]),
              g.loc["high","mean_retention"], g.loc["low","mean_retention"],
              g.loc["high","mean_churn"], g.loc["low","mean_churn"],
              g.loc["high","mean_arpu"]-g.loc["low","mean_arpu"],
              g.loc["high","mean_arpu"]/g.loc["low","mean_arpu"],
              100*g.loc["high","sum_cohort"]/(g.loc["high","sum_cohort"]+g.loc["low","sum_cohort"])],
})
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

