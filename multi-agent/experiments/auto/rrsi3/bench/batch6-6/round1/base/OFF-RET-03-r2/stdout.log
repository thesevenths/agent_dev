import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

r_ret_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_ret_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

print("n =", len(df), "median =", med)
print("r(ret,arpu) =", r_ret_arpu)
print("r(ret,churn) =", r_ret_churn)
print("hi: n=%d arpu_mean=%.6f cohort_sum=%d" % (len(hi), hi["arpu_usd"].mean(), hi["cohort_size"].sum()))
print("lo: n=%d arpu_mean=%.6f cohort_sum=%d" % (len(lo), lo["arpu_usd"].mean(), lo["cohort_size"].sum()))
print("arpu diff hi-lo =", hi["arpu_usd"].mean() - lo["arpu_usd"].mean())
print("arpu ratio hi/lo =", hi["arpu_usd"].mean() / lo["arpu_usd"].mean())
print("cohort ratio hi/lo =", hi["cohort_size"].sum() / lo["cohort_size"].sum())

out = pd.DataFrame([
