import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r5\_sandbox\tmp"

df = pd.read_csv(src)
sub = df[(df['week'] >= 'W30') & (df['week'] <= 'W43')][['week','retention_d7','churn_rate','arpu_usd']].copy()

pre = sub[sub['week'] <= 'W36']
post = sub[sub['week'] >= 'W37']

means = pd.DataFrame({
    'group': ['W30-W36 (pre)', 'W37-W43 (post)'],
    'n': [len(pre), len(post)],
    'retention_d7_mean': [pre['retention_d7'].mean(), post['retention_d7'].mean()],
    'churn_rate_mean': [pre['churn_rate'].mean(), post['churn_rate'].mean()],
    'arpu_usd_mean': [pre['arpu_usd'].mean(), post['arpu_usd'].mean()],
})
means['retention_d7_delta'] = means['retention_d7_mean'].iloc[1] - means['retention_d7_mean'].iloc[0]
means['churn_rate_delta'] = means['churn_rate_mean'].iloc[1] - means['churn_rate_mean'].iloc[0]
means['arpu_usd_delta'] = means['arpu_usd_mean'].iloc[1] - means['arpu_usd_mean'].iloc[0]
means['retention_d7_rel_pct'] = means['retention_d7_delta'] / means['retention_d7_mean'].iloc[0] * 100
means['churn_rate_rel_pct'] = means['churn_rate_delta'] / means['churn_rate_mean'].iloc[0] * 100
means['arpu_usd_rel_pct'] = means['arpu_usd_delta'] / means['arpu_usd_mean'].iloc[0] * 100

# per-week deltas to pinpoint breakpoint
sub['ret_d'] = sub['retention_d7'].diff()
sub['churn_d'] = sub['churn_rate'].diff()
sub['arpu_d'] = sub['arpu_usd'].diff()

# breakpoint: week with largest combined normalized drop
import numpy as np
def norm(s):
    return (s - s.min()) / (s.max() - s.min())
sub['score'] = norm(-sub['ret_d']) + norm(sub['churn_d']) + norm(-sub['arpu_d'])
bp = sub.loc[sub['score'].idxmax(), 'week']

print(means.to_string(index=False))
print("\nper-week:")
print(sub.to_string(index=False))
print("\nbreakpoint week:", bp)

# save intermediate CSV
out = pd.concat([
    sub.rename(columns={'ret_d':'retention_d7_wow','churn_d':'churn_rate_wow','arpu_d':'arpu_usd_wow'}),
], ignore_index=True)
out.to_csv(f"{out_dir}\\step2_weekly_w30_w43.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
print("\nsaved.")

```
