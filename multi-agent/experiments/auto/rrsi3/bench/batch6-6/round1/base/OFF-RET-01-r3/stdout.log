import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-01-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
assert len(df) == 60 and "retention_d7" in df.columns

first30 = df.iloc[:30]["retention_d7"]
last30  = df.iloc[30:]["retention_d7"]
overall = df["retention_d7"]

# 使用样本标准差 ddof=1（pandas 默认）
f_mean, f_std = first30.mean(), first30.std(ddof=1)
l_mean, l_std = last30.mean(), last30.std(ddof=1)
o_mean, o_std = overall.mean(), overall.std(ddof=1)

threshold = o_mean - 2 * o_std
below = df[df["retention_d7"] < threshold]
below_weeks = below["week"].tolist()

result = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "std_convention": "sample std (ddof=1, pandas default)",
    "first30": {"weeks": "W01-W30", "n": int(len(first30)), "mean": f_mean, "std": f_std},
    "last30":  {"weeks": "W31-W60", "n": int(len(last30)),  "mean": l_mean, "std": l_std},
    "diff_mean_last30_minus_first30": l_mean - f_mean,
    "overall": {"weeks": "W01-W60", "n": int(len(overall)), "mean": o_mean, "std": o_std},
    "threshold_mean_minus_2std": threshold,
    "weeks_below_threshold": {
        "count": int(len(below_weeks)),
        "weeks": below_weeks,
        "values": {w: v for w, v in zip(below_weeks, below["retention_d7"].tolist())},
    },
}

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-01-r3\_sandbox\tmp\retention_d7_stats.json"
with open(out, "w", encoding="utf-8") as fh:
    json.dump(result, fh, ensure_ascii=False, indent=2)

print(json.dumps(result, ensure_ascii=False, indent=2))
print("\nsaved to:", out)

