import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
print(df.shape)
print(df.dtypes)
print(df.head(3).to_string())

cols = ["screen_hours_per_day", "math_score", "reading_score"]
missing = {c: int(df[c].isna().sum()) for c in cols}
print("missing:", missing)

# group split
g = df.assign(group=lambda d: d["screen_hours_per_day"] > 5)
grp = g.groupby("group").agg(n=("math_score","size"),
                              math_mean=("math_score","mean"),
                              reading_mean=("reading_score","mean"),
                              screen_mean=("screen_hours_per_day","mean"))
print(grp)

corr = df[["screen_hours_per_day","math_score","reading_score"]].corr()
print(corr)

out = {
  "file": path,
  "rows": int(df.shape[0]),
  "columns": list(df.columns),
  "missing": missing,
  "correlations": {
     "screen_vs_math": float(corr.loc["screen_hours_per_day","math_score"]),
     "screen_vs_reading": float(corr.loc["screen_hours_per_day","reading_score"]),
     "math_vs_reading": float(corr.loc["math_score","reading_score"]),
  },
  "groups": {
     "gt5": {"n": int(grp.loc[True,"n"]), "math_mean": float(grp.loc[True,"math_mean"]),
             "reading_mean": float(grp.loc[True,"reading_mean"]), "screen_mean": float(grp.loc[True,"screen_mean"])},
     "le5": {"n": int(grp.loc[False,"n"]), "math_mean": float(grp.loc[False,"math_mean"]),
             "reading_mean": float(grp.loc[False,"reading_mean"]), "screen_mean": float(grp.loc[False,"screen_mean"])},
  },
  "diff": {
     "math": float(grp.loc[True,"math_mean"]-grp.loc[False,"math_mean"]),
     "reading": float(grp.loc[True,"reading_mean"]-grp.loc[False,"reading_mean"]),
  },
}
outpath = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-02-r1\_sandbox\tmp\step1_validation.json"
with open(outpath,"w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print("saved", outpath)
print(json.dumps(out,ensure_ascii=False,indent=2))

