```python
import pandas as pd, json, math

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-01-r1\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-01-r1\_sandbox\tmp\group_stats.json"

df = pd.read_csv(src)
g = df.groupby('tutoring')['math_score']
n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std(ddof=1)[0]), float(g.std(ddof=1)[1])
diff = m1 - m0
pooled = math.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
d = diff / pooled
# Cohen conventions: small ~0.2, medium ~0.5, large ~0.8
if abs(d) < 0.2: label = "小效应 (|d| < 0.2)"
elif abs(d) < 0.5: label = "小-中效应 (0.2 ≤ |d| < 0.5)"
elif abs(d) < 0.8: label = "中效应 (0.5 ≤ |d| < 0.8)"
else: label = "大效应 (|d| ≥ 0.8)"

res = {
  "source_file": "offline_data/students.csv",
  "n_total": int(len(df)),
  "n_missing_math_score": int(df['math_score'].isna().sum()),
  "groups": {
    "0": {"label": "无辅导 (tutoring=0)", "n": n0, "mean": round(m0,4), "std": round(s0,4)},
    "1": {"label": "有辅导 (tutoring=1)", "n": n1, "mean": round(m1,4), "std": round(s1,4)},
  },
  "mean_diff_t1_minus_t0": round(diff,4),
  "pooled_std": round(pooled,4),
  "cohens_d": round(d,4),
  "effect_size_label": label,
  "std_convention": "样本标准差 ddof=1; 合并标准差 pooled = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); Cohen's d = mean_diff / pooled_std; 判定阈值: <0.2 小, 0.2-0.5 小-中, 0.5-0.8 中, >=0.8 大",
}
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
