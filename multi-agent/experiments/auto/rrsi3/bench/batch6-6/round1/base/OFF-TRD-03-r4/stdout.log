import pandas as pd, json

df = pd.read_csv('offline_data/regional_sales.csv')

grand_total = df['revenue'].sum()
n_months = df['month'].nunique()  # 24

regions = {}
for r in ['N','S','E','W']:
    sub = df[df['region']==r]
    total = sub['revenue'].sum()
    monthly = sub.groupby('month')['revenue'].sum()
    peak_month = monthly.idxmax()
    peak_val = monthly.max()
    regions[r] = {
        'rows': int(len(sub)),
        'total_revenue': round(float(total), 2),
        'share_pct': round(float(total/grand_total*100), 4),
        'monthly_avg': round(float(total/n_months), 2),
        'peak_month': peak_month,
        'peak_month_revenue': round(float(peak_val), 2),
        'monthly_revenue': {m: round(float(v),2) for m,v in monthly.items()},
    }

out = {
    'source_file': 'offline_data/regional_sales.csv',
    'as_of': '2026-10-25 17:47',
    'period': {'start': df['month'].min(), 'end': df['month'].max(), 'n_months': int(n_months)},
    'grand_total_revenue': round(float(grand_total), 2),
    'grand_total_rows': int(len(df)),
    'regions': regions,
    'top_region': max(regions, key=lambda r: regions[r]['total_revenue']),
}

path = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r4\_sandbox\tmp\regional_aggregates.json'
with open(path, 'w', encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(json.dumps({k: v for k, v in out.items() if k != 'regions'}, ensure_ascii=False, indent=2))
for r, d in regions.items():
    d2 = {k: v for k, v in d.items() if k != 'monthly_revenue'}
    print(r, d2)
print('saved:', path)

```
