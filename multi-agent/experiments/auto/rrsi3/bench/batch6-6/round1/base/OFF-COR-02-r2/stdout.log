import pandas as pd, json, math

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-02-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
n = len(df)

# Pearson correlations
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

# t-test for correlations
def corr_t(r, n):
    return r * math.sqrt((n-2)/(1-r*r))
t_math = corr_t(r_math, n)
t_read = corr_t(r_read, n)

# group split
hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

groups = {}
for name, g in [("screen_gt_5", hi), ("screen_le_5", lo)]:
    groups[name] = {
        "n": int(len(g)),
        "math_score_mean": round(float(g["math_score"].mean()), 4),
        "reading_score_mean": round(float(g["reading_score"].mean()), 4),
        "math_score_std": round(float(g["math_score"].std(ddof=1)), 4),
        "reading_score_std": round(float(g["reading_score"].std(ddof=1)), 4),
    }

diff_math = groups["screen_gt_5"]["math_score_mean"] - groups["screen_le_5"]["math_score_mean"]
diff_read = groups["screen_gt_5"]["reading_score_mean"] - groups["screen_le_5"]["reading_score_mean"]

result = {
    "source_file": "offline_data/students.csv",
    "n_total": n,
    "correlations": {
        "screen_hours_per_day_vs_math_score": {
            "pearson_r": round(float(r_math), 4),
            "t_statistic": round(float(t_math), 4),
            "df": n - 2,
        },
        "screen_hours_per_day_vs_reading_score": {
            "pearson_r": round(float(r_read), 4),
            "t_statistic": round(float(t_read), 4),
            "df": n - 2,
        },
    },
    "groups": groups,
    "mean_differences_gt5_minus_le5": {
        "math_score": round(float(diff_math), 4),
        "reading_score": round(float(diff_read), 4),
    },
}

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-02-r2\_sandbox\tmp\step2_correlation_group_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
