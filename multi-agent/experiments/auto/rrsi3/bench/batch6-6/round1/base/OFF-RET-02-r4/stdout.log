```python
import pandas as pd
df = pd.read_csv("offline_data/app_metrics.csv")
cols=['retention_d7','churn_rate','arpu_usd']
pre = df[df['week'].between('W30','W36')][cols]
post = df[df['week'].between('W37','W43')][cols]
print("pre mean:", pre.mean().round(6).to_dict())
print("post mean:", post.mean().round(6).to_dict())
print("diff:", (post.mean()-pre.mean()).round(6).to_dict())
print("pct:", ((post.mean()-pre.mean())/pre.mean()*100).round(3).to_dict())
print("pre n=",len(pre),"post n=",len(post))
print("pre sum cohort:", df[df['week'].between('W30','W36')]['cohort_size'].sum())
print("post sum cohort:", df[df['week'].between('W37','W43')]['cohort_size'].sum())
# W37 vs W36 pct
w36=df[df['week']=='W36'][cols].iloc[0]; w37=df[df['week']=='W37'][cols].iloc[0]
print("W37 vs W36 pct:", ((w37-w36)/w36*100).round(3).to_dict())
# W37 vs pre mean
print("W37 vs pre-mean:", (w37-pre.mean()).round(6).to_dict())
print("W36 vs pre-mean:", (w36-pre.mean()).round(6).to_dict())

```
