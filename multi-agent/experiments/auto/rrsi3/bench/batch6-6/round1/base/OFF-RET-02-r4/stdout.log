import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
print(df.shape)
print(df.dtypes)
print(df['week'].min(), df['week'].max())
print(df.isna().sum().sum())

cols = ['retention_d7','churn_rate','arpu_usd']
pre = df[df['week'].between('W30','W36')]
post = df[df['week'].between('W37','W43')]
print(pre['week'].tolist(), post['week'].tolist())

for c in cols:
    a, b = pre[c].mean(), post[c].mean()
    print(c, round(a,6), round(b,6), round(b-a,6), round((b-a)/a*100,3))

# per-week values around boundary
print(df[df['week'].between('W34','W45')][['week']+cols].to_string(index=False))

# W36->W37 single-week deltas
w36 = df[df['week']=='W36'][cols].iloc[0]
w37 = df[df['week']=='W37'][cols].iloc[0]
print("W36->W37 deltas:", (w37-w36).round(6).to_dict())

# std within groups
print(pre[cols].std().round(4).to_dict())
print(post[cols].std().round(4).to_dict())

