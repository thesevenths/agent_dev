import pandas as pd, json, math

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
n = len(df)

def pearson(x, y):
    return float(pd.Series(x).corr(pd.Series(y)))  # Pearson by default

res = {}
for col in ['math_score','reading_score']:
    r = pearson(df['screen_hours_per_day'], df[col])
    # t-test for significance
    t = r * math.sqrt((n-2)/(1-r*r))
    res[col] = {'r': r, 't': t, 'n': n}
    print(col, 'r=', r, 't=', t)

out = {
    'source_file': 'offline_data/students.csv',
    'n': n,
    'method': 'Pearson correlation (pandas Series.corr, default method)',
    'correlations': {
        'screen_hours_per_day_vs_math_score': res['math_score'],
        'screen_hours_per_day_vs_reading_score': res['reading_score'],
    },
    'computed_at': '2026-10-26 13:19',
}
outpath = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json"
with open(outpath,'w',encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print('saved', outpath)

```
