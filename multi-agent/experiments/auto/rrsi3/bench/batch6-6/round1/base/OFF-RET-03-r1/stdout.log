import pandas as pd
import numpy as np
import json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r1\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)

# (a) Pearson: retention_d7 vs arpu_usd
corr_ret_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
# (b) Pearson: retention_d7 vs churn_rate
corr_ret_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# (c) median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] < med]
# check ties at median
ties = int((df["retention_d7"] == med).sum())

hi_arpu_mean = hi["arpu_usd"].mean()
hi_cohort_sum = int(hi["cohort_size"].sum())
lo_arpu_mean = lo["arpu_usd"].mean()
lo_cohort_sum = int(lo["cohort_size"].sum())

result = {
    "source_file": "offline_data/app_metrics.csv",
    "as_of": "2026-10-26 14:20",
    "n_rows": n,
    "corr_retention_d7_arpu_usd": round(float(corr_ret_arpu), 6),
    "corr_retention_d7_churn_rate": round(float(corr_ret_churn), 6),
    "retention_d7_median": float(med),
    "rows_tied_at_median": ties,
    "group_high": {
        "definition": "retention_d7 > median",
        "n_rows": len(hi),
        "arpu_usd_mean": round(float(hi_arpu_mean), 6),
        "cohort_size_sum": hi_cohort_sum,
    },
    "group_low": {
        "definition": "retention_d7 < median",
        "n_rows": len(lo),
        "arpu_usd_mean": round(float(lo_arpu_mean), 6),
        "cohort_size_sum": lo_cohort_sum,
    },
}

with open(f"{out_dir}\\step2_metrics.json", "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

print(json.dumps(result, ensure_ascii=False, indent=2))
print("\nhi weeks:", list(hi["week"]))
print("lo weeks:", list(lo["week"]))

```
