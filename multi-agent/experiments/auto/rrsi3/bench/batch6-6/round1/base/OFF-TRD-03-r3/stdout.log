```python
import pandas as pd, os, json

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r3\_sandbox\tmp"
os.makedirs(outdir, exist_ok=True)

n_months = df['month'].nunique()  # 24
grand_total = df['revenue'].sum()

# per-region aggregates
reg = df.groupby('region')['revenue'].agg(total='sum', rows='count').reset_index()
reg['share'] = reg['total'] / grand_total
reg['monthly_avg'] = reg['total'] / n_months
reg = reg.sort_values('total', ascending=False).reset_index(drop=True)

# per region-month
rm = df.groupby(['region','month'])['revenue'].sum().reset_index()
rm = rm.sort_values(['region','month'])

# peak month per region
peak = rm.loc[rm.groupby('region')['revenue'].idxmax()][['region','month','revenue']]

# top region
top_region = reg.iloc[0]['region']
top_peak = peak[peak['region']==top_region].iloc[0]

# overall peak month (any region) for context
overall_peak = rm.loc[rm['revenue'].idxmax()]

# monthly totals per region for the top region (for report context)
top_monthly = rm[rm['region']==top_region]

print(reg.to_string(index=False))
print()
print(peak.to_string(index=False))
print()
print("top region:", top_region, "peak month:", top_peak['month'], "peak revenue:", top_peak['revenue'])
print("grand total:", grand_total, "n_months:", n_months)
print()
print(top_monthly.to_string(index=False))

# save artifacts
reg_out = reg.copy()
reg_out['share_pct'] = reg_out['share']*100
reg_out.to_csv(os.path.join(outdir, "step2_region_aggregates.csv"), index=False, encoding='utf-8-sig')

rm.to_csv(os.path.join(outdir, "step2_region_month_revenue.csv"), index=False, encoding='utf-8-sig')

summary = {
    "source_file": os.path.abspath(path),
    "n_rows": int(len(df)),
    "n_months": int(n_months),
    "months_range": [df['month'].min(), df['month'].max()],
    "grand_total_revenue": float(grand_total),
    "regions": [
        {
            "region": r.region,
            "total_revenue": float(r.total),
            "share_of_grand_total": float(r.share),
            "share_pct": float(r.share*100),
            "monthly_avg_revenue": float(r.monthly_avg),
            "n_rows": int(r.rows),
            "peak_month": str(peak[peak['region']==r.region].iloc[0]['month']),
            "peak_month_revenue": float(peak[peak['region']==r.region].iloc[0]['revenue']),
        } for r in reg.itertuples()
    ],
    "top_region": str(top_region),
    "top_region_total": float(reg.iloc[0]['total']),
    "top_region_peak_month": str(top_peak['month']),
    "top_region_peak_revenue": float(top_peak['revenue']),
    "overall_peak": {"region": str(overall_peak['region']), "month": str(overall_peak['month']), "revenue": float(overall_peak['revenue'])},
}
with open(os.path.join(outdir, "step2_summary.json"), "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("\nsaved artifacts to", outdir)

