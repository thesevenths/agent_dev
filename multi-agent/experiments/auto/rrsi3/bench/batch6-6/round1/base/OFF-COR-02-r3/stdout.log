import pandas as pd

df = pd.read_csv("offline_data/students.csv")
sub = df[["screen_hours_per_day","math_score","reading_score"]]
n = len(sub)
r_math = sub["screen_hours_per_day"].corr(sub["math_score"])
r_read = sub["screen_hours_per_day"].corr(sub["reading_score"])
print("n =", n)
print("r(screen, math) =", r_math)
print("r(screen, reading) =", r_read)

out = pd.DataFrame({
    "pair": ["screen_hours_per_day ~ math_score", "screen_hours_per_day ~ reading_score"],
    "pearson_r": [r_math, r_read],
    "n": [n, n],
})
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-02-r3\_sandbox\tmp\step2_correlations.csv"
out.to_csv(out_path, index=False)
print(out)
print("saved:", out_path)

