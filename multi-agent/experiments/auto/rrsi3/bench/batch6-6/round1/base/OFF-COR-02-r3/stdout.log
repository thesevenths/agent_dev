import pandas as pd

df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "screen>5", False: "screen<=5"})

g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
).reindex(["screen<=5","screen>5"])
print(g)

low, high = g.loc["screen<=5"], g.loc["screen>5"]
diff_math = high["mean_math"] - low["mean_math"]
diff_reading = high["mean_reading"] - low["mean_reading"]
print("diff math (high-low):", diff_math)
print("diff reading (high-low):", diff_reading)

out = g.reset_index()
out["diff_math_high_minus_low"] = [None, diff_math]
out["diff_reading_high_minus_low"] = [None, diff_reading]
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-02-r3\_sandbox\tmp\step3_group_stats.csv"
out.to_csv(out_path, index=False)
print(out)
print("saved:", out_path)

