import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/students.csv')
cols = ['study_hours_per_week','sleep_hours_per_night','attendance_pct','screen_hours_per_day']
res = []
for c in cols:
    r = df[c].corr(df['math_score'])
    res.append((c, r, abs(r)))
res.sort(key=lambda x: -x[2])
for c, r, ar in res:
    print(c, r, ar)

# descriptive stats
print(df[cols + ['math_score']].describe().T)
print('n =', len(df))
print('nulls:', df[cols + ['math_score']].isna().sum().sum())
# t-stat for each
n = len(df)
for c, r, ar in res:
    t = r*np.sqrt((n-2)/(1-r*r))
    print(c, 't=', t)

```
