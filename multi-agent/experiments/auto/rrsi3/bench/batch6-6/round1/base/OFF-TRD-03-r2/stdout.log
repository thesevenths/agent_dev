import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")

# Per-region aggregates
reg = df.groupby("region")["revenue"].agg(["sum", "count"]).reset_index()
total = df["revenue"].sum()
reg["share_pct"] = reg["sum"] / total * 100
reg["monthly_avg"] = reg["sum"] / 24
reg = reg.rename(columns={"sum": "total_revenue", "count": "n_rows"})
reg = reg.sort_values("total_revenue", ascending=False).reset_index(drop=True)
print(reg.to_string(index=False))
print("total:", total)

# Per region+month
rm = df.groupby(["region", "month"])["revenue"].sum().reset_index()
top = rm.loc[rm["revenue"].idxmax()]
print("overall peak:", top.to_dict())

# Peak month for top region
top_region = reg.iloc[0]["region"]
rm_top = rm[rm["region"] == top_region].sort_values("revenue", ascending=False)
print(f"\nTop region {top_region} monthly ranking (top 5):")
print(rm_top.head(5).to_string(index=False))

# Save intermediate results
reg.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r2\_sandbox\tmp\step2_region_aggregates.csv", index=False)
rm.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r2\_sandbox\tmp\step2_region_month_revenue.csv", index=False)
print("\nSaved.")

