import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

out = {}
out["file"] = os.path.abspath(path)
out["shape"] = list(df.shape)
out["columns"] = list(df.columns)
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}
out["regions"] = sorted(df["region"].unique().tolist())
out["n_regions"] = df["region"].nunique()
out["months"] = [df["month"].min(), df["month"].max()]
out["n_months"] = df["month"].nunique()
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["nulls"] = df.isna().sum().to_dict()
out["dupes"] = int(df.duplicated().sum())
out["revenue_min_max"] = [float(df["revenue"].min()), float(df["revenue"].max())]
out["revenue_negative"] = int((df["revenue"] < 0).sum())

# rows per region
out["rows_per_region"] = df.groupby("region")["revenue"].count().to_dict()

# quick aggregates for downstream
tot = df.groupby("region")["revenue"].sum()
out["total_revenue_by_region"] = {k: float(v) for k, v in tot.items()}
out["grand_total"] = float(df["revenue"].sum())
out["share_by_region"] = {k: float(v / df["revenue"].sum()) for k, v in tot.items()}
out["monthly_avg_by_region"] = {k: float(v / 24) for k, v in tot.items()}

top_region = tot.idxmax()
sub = df[df["region"] == top_region].groupby("month")["revenue"].sum()
out["top_region"] = top_region
out["top_region_peak_month"] = sub.idxmax()
out["top_region_peak_value"] = float(sub.max())
out["monthly_by_region"] = {r: {m: float(v) for m, v in df[df["region"]==r].groupby("month")["revenue"].sum().items()} for r in df["region"].unique()}

os.makedirs("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch6-6/round1/base/OFF-TRD-03-r2/_sandbox/tmp", exist_ok=True)
with open("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch6-6/round1/base/OFF-TRD-03-r2/_sandbox/tmp/step1_validation.json", "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(json.dumps(out, ensure_ascii=False, indent=2))

```
