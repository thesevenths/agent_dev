import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
total = df["revenue"].sum()

# Region totals
reg = df.groupby("region")["revenue"].sum().sort_values(ascending=False)
print("region totals:")
for r, v in reg.items():
    print(f"  {r}: {v:,.2f}  share={v/total*100:.4f}%  avg={v/24:,.2f}")
print(f"total: {total:,.2f}")

# Region-month
rm = df.groupby(["region", "month"])["revenue"].sum().reset_index()
# E top 5
e = rm[rm["region"]=="E"].sort_values("revenue", ascending=False).head(5)
print("\nE top5:")
print(e.to_string(index=False))

# E 2025-12 vs 2024-12
e2512 = rm[(rm.region=="E")&(rm.month=="2025-12")]["revenue"].iloc[0]
e2412 = rm[(rm.region=="E")&(rm.month=="2024-12")]["revenue"].iloc[0]
print(f"\nE 2025-12: {e2512:,.2f}; E 2024-12: {e2412:,.2f}; YoY: {(e2512/e2412-1)*100:.2f}%")

# Global max check
g = rm.loc[rm["revenue"].idxmax()]
print("global max:", g.to_dict())

# E monthly min
emin = rm[rm.region=="E"].sort_values("revenue").head(3)
print("\nE lowest months:")
print(emin.to_string(index=False))

# E peak vs its own average
eavg = reg["E"]/24
print(f"\nE peak/avg ratio: {e2512/eavg:.2f}")

# spread between regions
print(f"\nmax-min region spread: {reg.max()-reg.min():,.2f}  ({(reg.max()/reg.min()-1)*100:.2f}%)")

# E 2025-12 share of E total
print(f"E 2025-12 share of E total: {e2512/reg['E']*100:.2f}%")

```
