import pandas as pd, json

# Consume upstream machine-readable validation data (step 1)
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r2\_sandbox\tmp\step1_validation.json", encoding="utf-8") as f:
    v = json.load(f)

monthly = v["monthly_by_region"]   # {region: {month: revenue}}
tot = v["total_revenue_by_region"]
grand = v["grand_total"]
n_months = v["n_months"]

rows = []
for r in ["N", "S", "E", "W"]:
    total = tot[r]
    share = total / grand
    mavg = total / n_months
    peak_month = max(monthly[r], key=lambda m: monthly[r][m])
    peak_val = monthly[r][peak_month]
    rows.append({
        "region": r,
        "total_revenue": round(total, 2),
        "share_of_grand_total": round(share, 6),
        "share_pct": f"{share*100:.2f}%",
        "monthly_avg_revenue": round(mavg, 2),
        "peak_month": peak_month,
        "peak_month_revenue": round(peak_val, 2),
        "n_rows": v["rows_per_region"][r],
    })

agg = pd.DataFrame(rows)
agg_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r2\_sandbox\tmp\step2_regional_aggregates.csv"
agg.to_csv(agg_path, index=False, encoding="utf-8-sig")

# grand total row for reference
gt = pd.DataFrame([{"region": "ALL", "total_revenue": round(grand,2), "share_of_grand_total": 1.0,
                    "share_pct": "100.00%", "monthly_avg_revenue": round(grand/n_months,2),
                    "peak_month": "", "peak_month_revenue": "", "n_rows": 288}])
gt.to_csv(agg_path, mode="a", index=False, header=False, encoding="utf-8-sig")

# top region detail
top = v["top_region"]
top_sub = pd.DataFrame([{"month": m, "revenue": round(val,2)} for m, val in sorted(monthly[top].items())])
top_sub_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r2\_sandbox\tmp\step2_top_region_monthly.csv"
top_sub.to_csv(top_sub_path, index=False, encoding="utf-8-sig")

print(agg.to_string(index=False))
print("\nTop region:", top, "peak:", v["top_region_peak_month"], v["top_region_peak_value"])
print("grand total:", grand)
print("saved:", agg_path)
print("saved:", top_sub_path)

