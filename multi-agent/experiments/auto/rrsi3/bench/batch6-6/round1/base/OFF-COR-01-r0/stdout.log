import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-01-r0\_sandbox\offline_data\students.csv")

vars_ = ["study_hours_per_week", "sleep_hours_per_night", "attendance_pct", "screen_hours_per_day"]
rows = []
for v in vars_:
    r, p = stats.pearsonr(df[v], df["math_score"])
    rows.append({"var": v, "r": r, "abs_r": abs(r), "p": p,
                 "mean_x": df[v].mean(), "std_x": df[v].std(ddof=1),
                 "mean_y": df["math_score"].mean(), "std_y": df["math_score"].std(ddof=1)})
res = pd.DataFrame(rows).sort_values("abs_r", ascending=False).reset_index(drop=True)
print(res.to_string())
print("n =", len(df))
print("math_score mean/std:", df["math_score"].mean(), df["math_score"].std(ddof=1))
print("math_score min/max:", df["math_score"].min(), df["math_score"].max())
# r^2
for _, row in res.iterrows():
    print(row["var"], "r2 =", row["r"]**2)

```
