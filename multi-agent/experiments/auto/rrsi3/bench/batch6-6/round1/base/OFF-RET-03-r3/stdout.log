import pandas as pd
import json

path = "offline_data/app_metrics.csv"
df = pd.read_csv(path)

info = {
    "shape": list(df.shape),
    "columns": list(df.columns),
    "dtypes": {c: str(t) for c, t in df.dtypes.items()},
    "missing": df.isna().sum().to_dict(),
    "duplicated_weeks": int(df["week"].duplicated().sum()),
    "describe": df.describe().to_dict(),
}

# key stats for downstream
r = df["retention_d7"]
a = df["arpu_usd"]
c = df["churn_rate"]
info["corr_ret_arpu"] = float(r.corr(a))
info["corr_ret_churn"] = float(r.corr(c))
med = float(r.median())
info["retention_median"] = med
hi = df[r > med]
lo = df[r <= med]
info["hi_n"] = len(hi); info["lo_n"] = len(lo)
info["hi_arpu_mean"] = float(hi["arpu_usd"].mean())
info["lo_arpu_mean"] = float(lo["arpu_usd"].mean())
info["hi_cohort_sum"] = int(hi["cohort_size"].sum())
info["lo_cohort_sum"] = int(lo["cohort_size"].sum())
info["hi_ret_mean"] = float(hi["retention_d7"].mean())
info["lo_ret_mean"] = float(lo["retention_d7"].mean())
info["hi_churn_mean"] = float(hi["churn_rate"].mean())
info["lo_churn_mean"] = float(lo["churn_rate"].mean())
info["total_cohort"] = int(df["cohort_size"].sum())
info["week_range"] = [df["week"].min(), df["week"].max()]

out = "tmp/step1_explore_summary.json"
import os
os.makedirs("tmp", exist_ok=True)
with open(out, "w") as f:
    json.dump(info, f, indent=2, ensure_ascii=False)

print(json.dumps(info, indent=2, ensure_ascii=False))
print("saved:", os.path.abspath(out))

```
