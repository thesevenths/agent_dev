```python
import pandas as pd, json, numpy as np

df = pd.read_csv("offline_data/students.csv")
g = df.groupby("tutoring")["math_score"].agg(n="count", mean="mean", std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,"n"]), int(g.loc[1,"n"])
m0, m1 = g.loc[0,"mean"], g.loc[1,"mean"]
s0, s1 = g.loc[0,"std"], g.loc[1,"std"]
diff = m1 - m0
pooled = np.sqrt(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2))
d = diff / pooled
print("diff", diff, "pooled", pooled, "d", d)

# sanity: overall mean check
print(df["math_score"].mean(), df["math_score"].std(ddof=1))

out = {
  "as_of": "2026-10-26 14:50",
  "source_file": "offline_data/students.csv",
  "groups": {
    "tutoring_0": {"n": n0, "mean": round(m0,4), "std": round(s0,4)},
    "tutoring_1": {"n": n1, "mean": round(m1,4), "std": round(s1,4)}
  },
  "mean_diff_t1_minus_t0": round(diff,4),
  "pooled_std": round(pooled,4),
  "cohens_d": round(d,4),
  "effect_size_classification": "large" if abs(d)>=0.8 else ("medium" if abs(d)>=0.5 else "small"),
  "notes": "std uses sample std (ddof=1); pooled std = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); Cohen's d = mean_diff/pooled_std; thresholds: small>=0.2, medium>=0.5, large>=0.8"
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-01-r3\_sandbox\tmp\step2_group_stats.json"
with open(path,"w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved", path)
print(json.dumps(out, ensure_ascii=False, indent=2))

