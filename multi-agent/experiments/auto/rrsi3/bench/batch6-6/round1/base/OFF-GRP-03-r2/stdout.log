import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-03-r2\_sandbox"
csv_path = os.path.join(base, "offline_data", "students.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv_path)
print(df.shape)
print(df[["study_hours_per_week","math_score"]].describe())
print("nulls:", df[["study_hours_per_week","math_score"]].isna().sum().to_dict())

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group")["math_score"].agg(["mean","count","std","min","max"])
print(g)

low_mean = g.loc["low","mean"]; high_mean = g.loc["high","mean"]
gain = high_mean - low_mean
rel = gain/low_mean*100

result = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "groups": {
    k: {"mean": float(v["mean"]), "n": int(v["count"]), "std": float(v["std"]),
        "min": float(v["min"]), "max": float(v["max"]),
        "hours_range": [float(df.loc[df["group"]==k,"study_hours_per_week"].min()),
                        float(df.loc[df["group"]==k,"study_hours_per_week"].max())]}
    for k,v in g.iterrows()
  },
  "low_to_high_gain": float(gain),
  "low_to_high_gain_pct": float(rel),
}
out_csv = os.path.join(out_dir, "group_stats.csv")
out_json = os.path.join(out_dir, "group_stats.json")
g.reset_index().to_csv(out_csv, index=False)
with open(out_json,"w",encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print("saved:", out_csv, out_json)
print(json.dumps(result, ensure_ascii=False, indent=2))

