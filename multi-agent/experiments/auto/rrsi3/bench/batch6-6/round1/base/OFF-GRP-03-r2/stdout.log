import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
df['group'] = pd.cut(df['study_hours_per_week'], bins=[-0.001, 2.5, 4.5, 100], labels=['low','mid','high'])
g = df.groupby('group', observed=True)['math_score'].agg(['count','mean','std','min','max','median'])
print(g)
low_mean = g.loc['low','mean']; high_mean = g.loc['high','mean']
gain = high_mean - low_mean
rel = gain/low_mean
print("gain:", gain, "rel:", rel)
# extra: study hours means per group for context
print(df.groupby('group', observed=True)['study_hours_per_week'].mean())
out = {
 'groups': {k: {c: (float(v) if isinstance(v,(int,float)) else v) for c,v in row.items()} for k,row in g.iterrows()},
 'gain_abs': float(gain), 'gain_rel_pct': float(rel*100),
 'study_hours_mean': {k: float(v) for k,v in df.groupby('group', observed=True)['study_hours_per_week'].mean().items()},
 'n_total': int(len(df))
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-03-r2\_sandbox\tmp\step2_group_stats.json","w") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved")

```
