import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.font_manager as fm

# Try to find a CJK font
cjk = None
for f in fm.findSystemFonts():
    name = fm.FontProperties(fname=f).get_name()
    if any(k in name for k in ['Microsoft YaHei','SimHei','SimSun','Noto Sans CJK','DengXian','PingFang']):
        cjk = f
        break
print("CJK font:", cjk)
if cjk:
    plt.rcParams['font.family'] = fm.FontProperties(fname=cjk).get_name()
plt.rcParams['axes.unicode_minus'] = False

rm = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step2_region_month_revenue.csv")
reg = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step2_regional_aggregates.csv")

fig, axes = plt.subplots(1, 2, figsize=(13, 4.8))

# Left: monthly revenue by region
piv = rm.pivot(index='month', columns='region', values='revenue').sort_index()
colors = {'E':'#d62728','S':'#1f77b4','N':'#2ca02c','W':'#ff7f0e'}
for r in ['E','S','N','W']:
    axes[0].plot(piv.index, piv[r]/1e6, label=r, color=colors[r], lw=1.8)
axes[0].set_title('Monthly Revenue by Region (2024-01 ~ 2025-12)')
axes[0].set_ylabel('Revenue (million)')
axes[0].legend(title='Region')
axes[0].grid(alpha=0.3)
axes[0].set_xticks(piv.index[::3])
axes[0].set_xticklabels(piv.index[::3], rotation=45, fontsize=8)

# Right: bar chart of totals + share
reg2 = reg.sort_values('total_revenue', ascending=True)
bars = axes[1].barh(reg2['region'], reg2['total_revenue']/1e6,
                    color=[colors[r] for r in reg2['region']])
for b, (t, s) in zip(bars, zip(reg2['total_revenue'], reg2['share_pct'])):
    axes[1].text(b.get_width()+0.15, b.get_y()+b.get_height()/2,
                 f"{t/1e6:.2f}M ({s:.2f}%)", va='center', fontsize=9)
axes[1].set_title('Total Revenue & Share by Region')
axes[1].set_xlabel('Total Revenue (million)')
axes[1].set_xlim(0, 36)
axes[1].grid(alpha=0.3, axis='x')

plt.tight_layout()
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r1\_sandbox\tmp\regional_sales_charts.png"
plt.savefig(out, dpi=130)
print("saved", out)

