import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
rm = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step2_region_month_revenue.csv")

# E region monthly series for chart
e = rm[rm.region=='E'].sort_values('month')
print(e.to_string(index=False))

# All-region monthly totals
tot = rm.groupby('month')['revenue'].sum().sort_index()
print("\nAll-region monthly totals (first/last):")
print(tot.head(3).to_string()); print(tot.tail(3).to_string())

# E 2025-12 product breakdown
print("\nE 2025-12:")
print(df[(df.region=='E')&(df.month=='2025-12')].to_string(index=False))

# E 2024-12 for comparison
print("\nE 2024-12:")
print(df[(df.region=='E')&(df.month=='2024-12')].to_string(index=False))

# E 2025-12 vs 2024-12 growth
e2412 = df[(df.region=='E')&(df.month=='2024-12')]['revenue'].sum()
e2512 = df[(df.region=='E')&(df.month=='2025-12')]['revenue'].sum()
print(f"\nE Dec YoY: {e2412:.2f} -> {e2512:.2f}, growth {(e2512/e2412-1)*100:.2f}%")

# E 2025-12 vs E 2025-11
e2511 = df[(df.region=='E')&(df.month=='2025-11')]['revenue'].sum()
print(f"E 2025-11: {e2511:.2f}, MoM growth {(e2512/e2511-1)*100:.2f}%")

# E 2025-12 units & returns
print("\nE 2025-12 units:", df[(df.region=='E')&(df.month=='2025-12')]['units'].sum(),
      "returns:", df[(df.region=='E')&(df.month=='2025-12')]['returns'].sum())

# E annual
df['year']=df['month'].str[:4]
print("\nE by year:", df[df.region=='E'].groupby('year')['revenue'].sum().round(2).to_dict())
print("All by year:", df.groupby('year')['revenue'].sum().round(2).to_dict())

# E peak/avg ratio
print("\nE peak/avg:", 2064410.16/1332364.8733333334)

