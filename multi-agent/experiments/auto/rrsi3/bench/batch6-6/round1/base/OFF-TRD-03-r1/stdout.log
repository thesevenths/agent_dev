```python
import pandas as pd

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

# Region-level aggregates
reg = df.groupby('region')['revenue'].agg(['sum', 'count']).reset_index()
reg.columns = ['region', 'total_revenue', 'n_rows']
grand = reg['total_revenue'].sum()
reg['share_pct'] = reg['total_revenue'] / grand * 100
reg['monthly_avg'] = reg['total_revenue'] / 24

# Region-month aggregates
rm = df.groupby(['region', 'month'])['revenue'].sum().reset_index()
rm.columns = ['region', 'month', 'revenue']

# Peak month per region
peak = rm.loc[rm.groupby('region')['revenue'].idxmax()]
# Overall top region
top_region = reg.loc[reg['total_revenue'].idxmax(), 'region']
top_peak = peak[peak['region'] == top_region].iloc[0]

# Also overall top region-month
overall_peak = rm.loc[rm['revenue'].idxmax()]

print(reg.to_string(index=False))
print("\nGrand total:", grand)
print("\nPeak month per region:")
print(peak.to_string(index=False))
print("\nTop region:", top_region, "| its peak month:", top_peak['month'], top_peak['revenue'])
print("Overall peak region-month:", overall_peak.to_dict())

# Save intermediate CSV
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step2_regional_aggregates.csv"
reg_out = reg.copy()
reg_out['total_revenue'] = reg_out['total_revenue'].round(2)
reg_out['share_pct'] = reg_out['share_pct'].round(4)
reg_out['monthly_avg'] = reg_out['monthly_avg'].round(2)
reg_out = reg_out.sort_values('total_revenue', ascending=False)
reg_out.to_csv(out, index=False)
print("\nSaved:", out)
print(reg_out.to_string(index=False))

# Also save region-month detail for step 3
out2 = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step2_region_month_revenue.csv"
rm['revenue'] = rm['revenue'].round(2)
rm.to_csv(out2, index=False)
print("Saved:", out2)

