import pandas as pd

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

# Verify revenue consistency
df['calc_rev'] = df['units'] * df['unit_price']
diff = (df['revenue'] - df['calc_rev']).abs()
print("max |revenue - units*unit_price|:", diff.max())
print("rows with diff > 0.01:", (diff > 0.01).sum())

# months
print("months:", sorted(df['month'].unique()))
print("rows per region:", df.groupby('region').size().to_dict())
print("rows per region-month:", df.groupby(['region','month']).size().describe())

