import pandas as pd, numpy as np, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-01-r1\_sandbox\tmp"
os.makedirs(base, exist_ok=True)

df = pd.read_csv(r"offline_data/app_metrics.csv")
r = df["retention_d7"].astype(float)
n = len(r)
first, last = r.iloc[:30], r.iloc[30:]

def stats(s):
    return dict(n=len(s), mean=s.mean(), std=s.std(ddof=1), min=s.min(), max=s.max())

f, l, o = stats(first), stats(last), stats(r)
threshold = o["mean"] - 2*o["std"]
below = r[r < threshold]

res = pd.DataFrame([
    {"segment":"first_30_weeks (W01-W30)","n":f["n"],"mean":f["mean"],"std":f["std"],"min":f["min"],"max":f["max"]},
    {"segment":"last_30_weeks (W31-W60)","n":l["n"],"mean":l["mean"],"std":l["std"],"min":l["min"],"max":l["max"]},
    {"segment":"all_60_weeks (W01-W60)","n":o["n"],"mean":o["mean"],"std":o["std"],"min":o["min"],"max":o["max"]},
])
res.to_csv(os.path.join(base,"retention_d7_stats.csv"), index=False)

print(res.to_string(index=False))
print("diff (first-last):", f["mean"]-l["mean"])
print("threshold (mean-2std):", threshold)
print("weeks below threshold:", len(below))
print(below.to_string())
print("overall mean-2std pct:", (o["mean"]-threshold)/o["mean"])

```
