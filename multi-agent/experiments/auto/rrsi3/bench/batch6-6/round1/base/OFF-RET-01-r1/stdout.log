              "std_ddof1": round(float(first30.std(ddof=1)), 6)},
  "last30": {"weeks": "W31-W60", "n": 30,
             "mean": round(float(last30.mean()), 6),
             "std_ddof1": round(float(last30.std(ddof=1)), 6)},
  "diff_last30_minus_first30_mean": round(float(last30.mean() - first30.mean()), 6),
  "overall": {"n": 60,
              "mean": round(float(overall_mean), 6),
              "std_ddof1": round(float(overall_std), 6)},
  "threshold_mean_minus_2std": round(float(threshold), 6),
  "weeks_below_threshold": {
      "count": int(len(below)),
      "weeks": below["week"].tolist(),
      "values": below["retention_d7"].tolist()
  }
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-01-r1\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

