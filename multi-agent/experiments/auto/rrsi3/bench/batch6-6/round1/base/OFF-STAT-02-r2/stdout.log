import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r2\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r2\_sandbox\tmp"

df = pd.read_csv(path)
m = df['math_score']; r = df['reading_score']
n = len(df)

def stats(s):
    return {
        'n': int(s.count()),
        'mean': float(s.mean()),
        'std_sample': float(s.std(ddof=1)),
        'std_pop': float(s.std(ddof=0)),
        'median': float(s.median()),
        'min': float(s.min()),
        'max': float(s.max()),
        'cv_sample': float(s.std(ddof=1)/s.mean()),
        'cv_pop': float(s.std(ddof=0)/s.mean()),
    }

res = {
    'source_file': 'offline_data/students.csv',
    'n_rows': n,
    'n_cols': df.shape[1],
    'columns': list(df.columns),
    'nulls': {'math_score': int(m.isna().sum()), 'reading_score': int(r.isna().sum())},
    'math_score': stats(m),
    'reading_score': stats(r),
    'pearson_r': float(m.corr(r, method='pearson')),
    'as_of': '2026-10-26 15:22',
}

with open(out_dir + r'\step1_statistics.json', 'w', encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print(json.dumps(res, ensure_ascii=False, indent=2))

