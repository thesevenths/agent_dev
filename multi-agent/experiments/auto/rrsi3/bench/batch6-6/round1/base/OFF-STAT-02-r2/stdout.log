import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
m, r = df["math_score"], df["reading_score"]

def stats(s):
    return {
        "n": int(s.count()),
        "mean": float(s.mean()),
        "std_sample": float(s.std(ddof=1)),
        "std_pop": float(s.std(ddof=0)),
        "median": float(s.median()),
        "min": float(s.min()),
        "max": float(s.max()),
        "cv_sample": float(s.std(ddof=1)/s.mean()),
        "cv_pop": float(s.std(ddof=0)/s.mean()),
    }

out = {
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-25 17:52",
    "math_score": stats(m),
    "reading_score": stats(r),
    "pearson_r": float(m.corr(r, method="pearson")),
    "n_pairs": int(len(df)),
}
print(json.dumps(out, indent=2, ensure_ascii=False))

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r2\_sandbox\tmp\stats_results.json","w",encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved")

```
