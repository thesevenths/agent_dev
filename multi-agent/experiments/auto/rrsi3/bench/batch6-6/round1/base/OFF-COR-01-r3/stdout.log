import pandas as pd
df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-COR-01-r3\_sandbox\offline_data\students.csv")
cols = ['study_hours_per_week','sleep_hours_per_night','attendance_pct','screen_hours_per_day','math_score']
d = df[cols]
print(d.describe().T.to_string())
print("n =", len(d))
# p-values
from scipy import stats
for c in cols[:-1]:
    r, p = stats.pearsonr(d[c], d['math_score'])
    print(c, r, p)
print("grade counts:", df['grade'].value_counts().to_dict())
print("region counts:", df['region'].value_counts().to_dict())

