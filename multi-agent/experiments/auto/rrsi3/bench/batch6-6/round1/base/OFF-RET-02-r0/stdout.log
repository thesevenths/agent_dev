import pandas as pd, numpy as np, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r0\_sandbox"
df = pd.read_csv(os.path.join(base, "offline_data", "app_metrics.csv"))
df["wk"] = df["week"].str.replace("W", "", regex=False).astype(int)

cols = ["retention_d7", "churn_rate", "arpu_usd"]
sub = df[(df["wk"] >= 30) & (df["wk"] <= 43)].copy()
sub["group"] = np.where(sub["wk"] <= 36, "W30-W36", "W37-W43")

# per-week table
rows = []
for _, r in sub.iterrows():
    rows.append({
        "week": r["week"], "group": r["group"],
        "retention_d7": r["retention_d7"], "churn_rate": r["churn_rate"], "arpu_usd": r["arpu_usd"],
        "retention_d7_wow": r["retention_d7"] - sub[sub["wk"] == r["wk"]-1]["retention_d7"].iloc[0] if r["wk"] > 30 else np.nan,
        "churn_rate_wow": r["churn_rate"] - sub[sub["wk"] == r["wk"]-1]["churn_rate"].iloc[0] if r["wk"] > 30 else np.nan,
        "arpu_usd_wow": r["arpu_usd"] - sub[sub["wk"] == r["wk"]-1]["arpu_usd"].iloc[0] if r["wk"] > 30 else np.nan,
    })
weekly = pd.DataFrame(rows)

# group means
g = sub.groupby("group")[cols].mean()
g["n"] = sub.groupby("group").size()
g["std_retention"] = sub.groupby("group")["retention_d7"].std()
g["std_churn"] = sub.groupby("group")["churn_rate"].std()
g["std_arpu"] = sub.groupby("group")["arpu_usd"].std()

# differences
diff = pd.DataFrame(index=cols)
for c in cols:
    a, b = g.loc["W30-W36", c], g.loc["W37-W43", c]
    diff.loc[c, "W30-W36_mean"] = a
    diff.loc[c, "W37-W43_mean"] = b
    diff.loc[c, "abs_diff"] = b - a
    diff.loc[c, "rel_diff_pct"] = (b - a) / a * 100

# breakpoint: week with max |z| of wow change vs W30-W36 std
out = []
for c in cols:
    s = sub[sub["wk"] <= 36][c].std()
    z = (weekly[c + "_wow"].dropna()) / s
    out.append((c, z.abs().idxmax(), z.abs().max()))
print("=== weekly ===")
print(weekly.to_string(index=False))
print("\n=== group means ===")
print(g.to_string())
print("\n=== diff ===")
print(diff.to_string())
print("\n=== breakpoint by max |WoW z| ===")
for c, idx, zv in out:
    print(c, "breakpoint week:", weekly.loc[idx, "week"], "z=", round(zv, 2))

# save intermediate
os.makedirs(os.path.join(base, "offline_data"), exist_ok=True)
out_path = os.path.join(base, "offline_data", "breakpoint_intermediate.csv")
with open(out_path, "w", encoding="utf-8") as f:
    f.write("# weekly\n")
    weekly.to_csv(f, index=False)
    f.write("\n# group_means\n")
    g.to_csv(f)
    f.write("\n# group_diff\n")
    diff.to_csv(f)
print("\nSaved:", out_path)

```
