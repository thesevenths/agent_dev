import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]
last = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

results = {
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {
        "weeks": [df["week"].iloc[0], df["week"].iloc[29]],
        "n": int(len(first)),
        "mean": first.mean(),
        "std_sample": first.std(ddof=1),
        "std_pop": first.std(ddof=0),
    },
    "last30": {
        "weeks": [df["week"].iloc[30], df["week"].iloc[59]],
        "n": int(len(last)),
        "mean": last.mean(),
        "std_sample": last.std(ddof=1),
        "std_pop": last.std(ddof=0),
    },
    "diff_mean_last_minus_first": last.mean() - first.mean(),
    "overall": {
        "n": int(len(r)),
        "mean": overall_mean,
        "std_sample": overall_std,
        "std_pop": r.std(ddof=0),
        "min": r.min(), "max": r.max(),
    },
    "threshold_mean_minus_2std": threshold,
    "weeks_below_threshold": {
        "count": int(len(below)),
        "weeks": below["week"].tolist(),
        "values": below["retention_d7"].tolist(),
    },
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-01-r4\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)
print(json.dumps(results, ensure_ascii=False, indent=2))

```
