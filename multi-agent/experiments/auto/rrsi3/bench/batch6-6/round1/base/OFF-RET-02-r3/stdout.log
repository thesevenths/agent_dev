    p = d / m30[m] * 100
    print(f"  {m}: {d:+.6f}  ({p:+.2f}%)")

# Per-week with WoW deltas
w = w30_43.copy()
for m in metrics:
    w[f'{m}_wow'] = w[m].diff()
print("\nPer-week with WoW deltas:")
print(w[['week','retention_d7','retention_d7_wow','churn_rate','churn_rate_wow','arpu_usd','arpu_usd_wow']].to_string(index=False))

# Save intermediate CSVs
out = w[['week','cohort_size','dau','retention_d7','churn_rate','arpu_usd','support_tickets',
         'retention_d7_wow','churn_rate_wow','arpu_usd_wow']].copy()
out.to_csv(f"{out_dir}\\step2_weekly_values.csv", index=False)

means_df = pd.DataFrame([
    {'group': 'W30-W36', 'n': len(w30_36), 'retention_d7_mean': m30['retention_d7'],
     'churn_rate_mean': m30['churn_rate'], 'arpu_usd_mean': m30['arpu_usd']},
    {'group': 'W37-W43', 'n': len(w37_43), 'retention_d7_mean': m37['retention_d7'],
     'churn_rate_mean': m37['churn_rate'], 'arpu_usd_mean': m37['arpu_usd']},
])
means_df.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)

summary = pd.DataFrame([
    {'metric': m, 'W30-W36_mean': m30[m], 'W37-W43_mean': m37[m],
     'delta_abs': m37[m]-m30[m], 'delta_pct': (m37[m]-m30[m])/m30[m]*100}
    for m in metrics
])
summary.to_csv(f"{out_dir}\\step2_summary.csv", index=False)
print("\nSaved: step2_weekly_values.csv, step2_group_means.csv, step2_summary.csv")

