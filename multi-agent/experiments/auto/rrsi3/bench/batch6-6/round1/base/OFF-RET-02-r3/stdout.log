import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r3\_sandbox\tmp"

df = pd.read_csv(src)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# W30-W43 window
w30_43 = df[df['week'].isin([f'W{i:02d}' for i in range(30, 44)])].copy()
w30_36 = w30_43[w30_43['week'].isin([f'W{i:02d}' for i in range(30, 37)])]
w37_43 = w30_43[w30_43['week'].isin([f'W{i:02d}' for i in range(37, 44)])]

print("W30-W36 rows:", len(w30_36), "| W37-W43 rows:", len(w37_43))

# Group means
means = pd.DataFrame({
    'group': ['W30-W36', 'W37-W43'],
    'n': [len(w30_36), len(w37_43)],
    'retention_d7_mean': [w30_36['retention_d7'].mean(), w37_43['retention_d7'].mean()],
    'churn_rate_mean': [w30_36['churn_rate'].mean(), w37_43['churn_rate'].mean()],
    'arpu_usd_mean': [w30_36['arpu_usd'].mean(), w37_43['arpu_usd'].mean()],
})
print(means.to_string(index=False))

# Deltas (after - before)
delta = means.iloc[1] - means.iloc[0]
print("\nDeltas (W37-W43 - W30-W36):")
print(f"  retention_d7: {delta['retention_d7_mean']:+.4f}  ({delta['retention_d7_mean']/means.iloc[0]['retention_d7_mean']*100:+.2f}%)")
print(f"  churn_rate:   {delta['churn_rate_mean']:+.4f}  ({delta['churn_rate_mean']/means.iloc[0]['churn_rate_mean']*100:+.2f}%)")
print(f"  arpu_usd:     {delta['arpu_usd_mean']:+.4f}  ({delta['arpu_usd_mean']/means.iloc[0]['arpu_usd_mean']*100:+.2f}%)")

# Per-week values with week-over-week deltas to pinpoint breakpoint
w = w30_43.copy()
w['retention_d7_wow'] = w['retention_d7'].diff()
w['churn_rate_wow'] = w['churn_rate'].diff()
w['arpu_usd_wow'] = w['arpu_usd'].diff()
print("\nPer-week with WoW deltas:")
print(w[['week','retention_d7','retention_d7_wow','churn_rate','churn_rate_wow','arpu_usd','arpu_usd_wow']].to_string(index=False))

# Save intermediate CSV
out = w[['week','cohort_size','dau','retention_d7','churn_rate','arpu_usd','support_tickets',
         'retention_d7_wow','churn_rate_wow','arpu_usd_wow']].copy()
out.to_csv(f"{out_dir}\\step2_weekly_values.csv", index=False)

# Save group means CSV
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)

# Also save a combined summary
summary = pd.DataFrame({
    'metric': ['retention_d7','churn_rate','arpu_usd'],
    'W30-W36_mean': [w30_36[m].mean() for m in metrics],
    'W37-W43_mean': [w37_43[m].mean() for m in metrics],
    'delta_abs': [w37_43[m].mean()-w30_36[m].mean() for m in metrics],
    'delta_pct': [(w37_43[m].mean()-w30_36[m].mean())/w30_36[m].mean()*100 for m in metrics],
})
summary.to_csv(f"{out_dir}\\step2_summary.csv", index=False)
print("\nSaved step2_weekly_values.csv, step2_group_means.csv, step2_summary.csv")

