import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
print(df.shape)
print(df.dtypes)
print("week range:", df.week.min(), df.week.max())

w = df.week.str[1:].astype(int)
pre = df[(w>=30)&(w<=36)]
post = df[(w>=37)&(w<=43)]
cols = ["retention_d7","churn_rate","arpu_usd"]
print(pre[["week"]+cols])
print(post[["week"]+cols])
print("\npre means:", pre[cols].mean().to_dict(), "n=", len(pre))
print("post means:", post[cols].mean().to_dict(), "n=", len(post))
print("\ndiff (post-pre):", (post[cols].mean()-pre[cols].mean()).to_dict())
print("rel diff %:", ((post[cols].mean()-pre[cols].mean())/pre[cols].mean()*100).to_dict())

# per-week deltas around boundary
seg = df[(w>=29)&(w<=44)].copy()
seg["delta_ret"] = seg.retention_d7.diff()
seg["delta_churn"] = seg.churn_rate.diff()
seg["delta_arpu"] = seg.arpu_usd.diff()
print(seg[["week","retention_d7","churn_rate","arpu_usd","delta_ret","delta_churn","delta_arpu"]].to_string(index=False))

# max single-week drop in retention
print("\nbiggest retention drop:", seg.loc[seg.delta_ret.idxmin(), ["week","delta_ret"]].to_dict())
print("biggest churn jump:", seg.loc[seg.delta_churn.idxmax(), ["week","delta_churn"]].to_dict())

