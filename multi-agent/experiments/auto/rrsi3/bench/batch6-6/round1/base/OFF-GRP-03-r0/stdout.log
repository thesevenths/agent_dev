```python
import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)

rows = []
for g in ["low","mid","high"]:
    sub = df[df["group"]==g]
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "mean_math_score": round(float(sub["math_score"].mean()), 4),
        "std_math_score": round(float(sub["math_score"].std(ddof=1)), 4),
        "min_math_score": int(sub["math_score"].min()),
        "max_math_score": int(sub["math_score"].max()),
        "mean_study_hours": round(float(sub["study_hours_per_week"].mean()), 4),
        "min_hours": float(sub["study_hours_per_week"].min()),
        "max_hours": float(sub["study_hours_per_week"].max()),
    })

res = pd.DataFrame(rows)
low = res[res.group=="low"].iloc[0]
high = res[res.group=="high"].iloc[0]
gain = high["mean_math_score"] - low["mean_math_score"]
gain_pct = gain / low["mean_math_score"] * 100

out = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "rows_used": int(len(df)),
    "nulls_excluded": 0,
    "grouping_rule": "low: study_hours_per_week < 2.5; mid: 2.5 <= h <= 4.5; high: h > 4.5",
    "groups": rows,
    "low_to_high_gain": round(float(gain), 4),
    "low_to_high_gain_pct": round(float(gain_pct), 4),
    "as_of": "2026-10-26 13:14",
}

outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-03-r0\_sandbox\tmp"
os.makedirs(outdir, exist_ok=True)
jpath = os.path.join(outdir, "grouping_results.json")
cpath = os.path.join(outdir, "grouping_results.csv")
with open(jpath, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
res.to_csv(cpath, index=False)

print(res.to_string(index=False))
print("gain:", out["low_to_high_gain"], "pct:", out["low_to_high_gain_pct"])
print(jpath, os.path.getsize(jpath))
print(cpath, os.path.getsize(cpath))

```
