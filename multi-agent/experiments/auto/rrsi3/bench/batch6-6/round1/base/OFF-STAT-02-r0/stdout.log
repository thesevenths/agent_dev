import pandas as pd, json, os

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(csv_path)
print(df.head())
print(df.shape)
print(df.dtypes)
print("nulls:", df[['math_score','reading_score']].isna().sum().to_dict())

m = df['math_score']; r = df['reading_score']
n = len(df)
stats = {
    "n_rows": n,
    "math_score": {
        "mean": float(m.mean()),
        "std_sample": float(m.std(ddof=1)),
        "std_pop": float(m.std(ddof=0)),
        "median": float(m.median()),
        "min": float(m.min()), "max": float(m.max()),
    },
    "reading_score": {
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_pop": float(r.std(ddof=0)),
        "median": float(r.median()),
        "min": float(r.min()), "max": float(r.max()),
    },
    "pearson_r": float(m.corr(r)),
}
stats["math_score"]["cv_sample"] = stats["math_score"]["std_sample"]/stats["math_score"]["mean"]
stats["reading_score"]["cv_sample"] = stats["reading_score"]["std_sample"]/stats["reading_score"]["mean"]
stats["math_score"]["cv_pop"] = stats["math_score"]["std_pop"]/stats["math_score"]["mean"]
stats["reading_score"]["cv_pop"] = stats["reading_score"]["std_pop"]/stats["reading_score"]["mean"]

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out = os.path.join(out_dir, "step1_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)
print(json.dumps(stats, ensure_ascii=False, indent=2))
print("saved:", out)

