import pandas as pd, numpy as np

df = pd.read_csv('offline_data/app_metrics.csv')
n = len(df)

# Pearson correlations
r_arpu = df['retention_d7'].corr(df['arpu_usd'])
r_churn = df['retention_d7'].corr(df['churn_rate'])

# median split
med = df['retention_d7'].median()
high = df[df['retention_d7'] > med]
low = df[df['retention_d7'] < med]
eq = df[df['retention_d7'] == med]

def gstats(g):
    return {
        'n': len(g),
        'arpu_mean': g['arpu_usd'].mean(),
        'cohort_sum': int(g['cohort_size'].sum()),
        'retention_mean': g['retention_d7'].mean(),
        'churn_mean': g['churn_rate'].mean(),
    }

res = {
    'n': n,
    'retention_median': med,
    'corr_retention_arpu': r_arpu,
    'corr_retention_churn': r_churn,
    'n_high': len(high), 'n_low': len(low), 'n_eq_median': len(eq),
    'high': gstats(high),
    'low': gstats(low),
}
# p-values via scipy if available
try:
    from scipy import stats
    p_arpu = stats.pearsonr(df['retention_d7'], df['arpu_usd'])[1]
    p_churn = stats.pearsonr(df['retention_d7'], df['churn_rate'])[1]
    res['p_arpu'] = p_arpu
    res['p_churn'] = p_churn
except Exception as e:
    print('scipy fail', e)

print(pd.DataFrame([res['high'], res['low']], index=['high','low']).T)
print({k: res[k] for k in ('n','retention_median','corr_retention_arpu','corr_retention_churn','n_high','n_low','n_eq_median')})
print(res.get('p_arpu'), res.get('p_churn'))

# save intermediate CSV
out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r5\_sandbox\tmp\step2_results.csv'
rows = [
    {'metric':'corr_retention_d7_arpu_usd','value':round(r_arpu,6),'p_value':round(res.get('p_arpu',float('nan')),6),'n':n},
    {'metric':'corr_retention_d7_churn_rate','value':round(r_churn,6),'p_value':round(res.get('p_churn',float('nan')),6),'n':n},
    {'metric':'retention_d7_median','value':round(med,6),'p_value':np.nan,'n':n},
    {'metric':'arpu_usd_mean_high_group','value':round(res['high']['arpu_mean'],6),'p_value':np.nan,'n':res['n_high']},
    {'metric':'arpu_usd_mean_low_group','value':round(res['low']['arpu_mean'],6),'p_value':np.nan,'n':res['n_low']},
    {'metric':'cohort_size_sum_high_group','value':res['high']['cohort_sum'],'p_value':np.nan,'n':res['n_high']},
    {'metric':'cohort_size_sum_low_group','value':res['low']['cohort_sum'],'p_value':np.nan,'n':res['n_low']},
    {'metric':'retention_d7_mean_high_group','value':round(res['high']['retention_mean'],6),'p_value':np.nan,'n':res['n_high']},
    {'metric':'retention_d7_mean_low_group','value':round(res['low']['retention_mean'],6),'p_value':np.nan,'n':res['n_low']},
    {'metric':'churn_rate_mean_high_group','value':round(res['high']['churn_mean'],6),'p_value':np.nan,'n':res['n_high']},
    {'metric':'churn_rate_mean_low_group','value':round(res['low']['churn_mean'],6),'p_value':np.nan,'n':res['n_low']},
]
pd.DataFrame(rows).to_csv(out, index=False)
print('saved', out)

