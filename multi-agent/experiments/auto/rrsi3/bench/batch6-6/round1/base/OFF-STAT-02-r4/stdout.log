import pandas as pd, json, os

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(csv_path)
print(df.shape)
print(df.head())
print(df.dtypes)
print("nulls:", df[['math_score','reading_score']].isna().sum().to_dict())

m = df['math_score']; r = df['reading_score']
res = {
  "n": int(len(df)),
  "math": {"mean": m.mean(), "std": m.std(ddof=1), "std_pop": m.std(ddof=0), "median": m.median(), "cv": m.std(ddof=1)/m.mean()},
  "reading": {"mean": r.mean(), "std": r.std(ddof=1), "std_pop": r.std(ddof=0), "median": r.median(), "cv": r.std(ddof=1)/r.mean()},
  "pearson_r": float(m.corr(r)),
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r4\_sandbox\tmp"
with open(os.path.join(out_dir, "stats_results.json"), "w", encoding="utf-8") as f:
