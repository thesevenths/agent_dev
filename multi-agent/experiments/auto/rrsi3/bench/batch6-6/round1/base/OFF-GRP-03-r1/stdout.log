```python
import pandas as pd, json

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-03-r1\_sandbox"
df = pd.read_csv(base + r"\offline_data\students.csv")

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(n=("math_score","size"),
                            mean_math=("math_score","mean"),
                            std_math=("math_score","std"),
                            min_math=("math_score","min"),
                            max_math=("math_score","max"),
                            mean_hours=("study_hours_per_week","mean"),
                            min_hours=("study_hours_per_week","min"),
                            max_hours=("study_hours_per_week","max"))
print(g)
print("boundary check:", df["study_hours_per_week"].isin([2.5,4.5]).sum())
gain = g.loc["high","mean_math"] - g.loc["low","mean_math"]
print("gain:", gain, "pct:", gain/g.loc["low","mean_math"]*100)

out = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "missing": {"study_hours_per_week": 0, "math_score": 0},
  "groups": {k: {kk: (int(vv) if isinstance(vv,(int,)) or (isinstance(vv,float) and vv.is_integer() and kk=="n") else float(vv)) for kk,vv in row.items()} for k,row in g.iterrows()},
  "low_to_high_gain": float(gain),
  "low_to_high_gain_pct": float(gain/g.loc["low","mean_math"]*100),
}
# fix n int
for k in out["groups"]:
    out["groups"][k]["n"] = int(out["groups"][k]["n"])
with open(base + r"\tmp\group_stats.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
g.round(4).to_csv(base + r"\tmp\group_stats.csv")
print(json.dumps(out, ensure_ascii=False, indent=2))

```
