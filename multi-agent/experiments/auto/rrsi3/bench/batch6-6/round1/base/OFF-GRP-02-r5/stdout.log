import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-GRP-02-r5\_sandbox\tmp"

df = pd.read_csv(path)
g = df.groupby(['grade', 'region'], sort=True).agg(
    row_count=('reading_score', 'size'),
    reading_score_mean=('reading_score', 'mean'),
).reset_index()
g['reading_score_mean'] = g['reading_score_mean'].round(4)

# order grades/regions nicely
g['grade'] = pd.Categorical(g['grade'], ['G10','G11','G12'], ordered=True)
g['region'] = pd.Categorical(g['region'], ['A','B','C','D'], ordered=True)
g = g.sort_values(['grade','region']).reset_index(drop=True)

print(g.to_string(index=False))
print("total rows:", g['row_count'].sum())

imax = g['reading_score_mean'].idxmax()
imin = g['reading_score_mean'].idxmin()
print("MAX:", g.loc[imax].to_dict())
print("MIN:", g.loc[imin].to_dict())
print("diff:", round(g.loc[imax,'reading_score_mean'] - g.loc[imin,'reading_score_mean'], 4))

out_csv = out_dir + r"\step2_crosstab_metrics.csv"
g.to_csv(out_csv, index=False)
print("saved:", out_csv)

```
