import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(path)
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy().reset_index(drop=True)

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# Group means
pre = sub[sub.week <= "W36"]
post = sub[sub.week >= "W37"]
means = pd.DataFrame({
    "group": ["W30-W36", "W37-W43"],
    "n": [len(pre), len(post)],
    "retention_d7_mean": [pre.retention_d7.mean(), post.retention_d7.mean()],
    "churn_rate_mean": [pre.churn_rate.mean(), post.churn_rate.mean()],
    "arpu_usd_mean": [pre.arpu_usd.mean(), post.arpu_usd.mean()],
})
diff = post.iloc[0] - pre.iloc[0]
pct = diff / pre.iloc[0] * 100
means.loc[2, ["group","n"]] = ["diff(post-pre)", ""]
means.loc[2, "retention_d7_mean"] = diff["retention_d7"]
means.loc[2, "churn_rate_mean"] = diff["churn_rate"]
means.loc[2, "arpu_usd_mean"] = diff["arpu_usd"]
means.loc[3, ["group","n"]] = ["diff_pct(%)", ""]
means.loc[3, "retention_d7_mean"] = pct["retention_d7"]
means.loc[3, "churn_rate_mean"] = pct["churn_rate"]
means.loc[3, "arpu_usd_mean"] = pct["arpu_usd"]
print(means.to_string())

# Per-week table with week-over-week deltas
per = sub[["week"] + metrics].copy()
for m in metrics:
    per[f"{m}_wow"] = per[m].diff()
print("\nPer-week:\n", per.to_string())

# Breakpoint detection: largest absolute week-over-week change in each metric
print("\nMax |WoW| per metric:")
for m in metrics:
    col = f"{m}_wow"
    idx = per[col].abs().idxmax()
    print(f"  {m}: max |WoW| = {per.loc[idx, col]:.4f} at {per.loc[idx, 'week']} (prev week {per.loc[idx-1,'week']})")

# Also check: for each candidate split week Wk (k=31..42), compute |mean diff| for each metric
print("\nCandidate split analysis (split before week Wk):")
rows = []
for k in range(31, 43):
    a = sub[sub.week <= f"W{k-1:02d}"]
    b = sub[sub.week >= f"W{k:02d}"]
    if len(a) < 2 or len(b) < 2:
        continue
    rows.append({
        "split_before": f"W{k:02d}",
        "n_pre": len(a), "n_post": len(b),
        "ret_d7_gap": b.retention_d7.mean() - a.retention_d7.mean(),
        "churn_gap": b.churn_rate.mean() - a.churn_rate.mean(),
        "arpu_gap": b.arpu_usd.mean() - a.arpu_usd.mean(),
    })
cand = pd.DataFrame(rows)
print(cand.to_string())

# Save intermediate CSVs
per.to_csv(f"{out_dir}\\step2_per_week_W30_W43.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
cand.to_csv(f"{out_dir}\\step2_candidate_splits.csv", index=False)
print("\nSaved 3 CSVs to", out_dir)

```
