```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week values W30-W43
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
sub["group"] = sub.week.apply(lambda w: "W30-W36" if w <= "W36" else "W37-W43")

# group means
g = sub.groupby("group")[metrics].mean().round(6)
print("GROUP MEANS:\n", g)

# absolute & relative diffs (after - before)
before = g.loc["W30-W36"]
after = g.loc["W37-W43"]
diff = pd.DataFrame({
    "before_W30_W36_mean": before,
    "after_W37_W43_mean": after,
    "abs_diff_after_minus_before": (after - before).round(6),
    "rel_diff_pct": ((after - before) / before * 100).round(4),
})
print("\nDIFF TABLE:\n", diff)

# breakpoint location: week-over-week change within W30-W43
sub["wow_retention"] = sub.retention_d7.diff()
sub["wow_churn"] = sub.churn_rate.diff()
sub["wow_arpu"] = sub.arpu_usd.diff()
print("\nWOW CHANGES:\n", sub[["week","group","retention_d7","churn_rate","arpu_usd","wow_retention","wow_churn","wow_arpu"]].to_string())

# save intermediate CSV
out = sub[["week","group","cohort_size","dau","retention_d7","churn_rate","arpu_usd","support_tickets",
           "wow_retention","wow_churn","wow_arpu"]].copy()
out.to_csv(f"{out_dir}\\step2_perweek_values.csv", index=False)

# save group means CSV
diff.to_csv(f"{out_dir}\\step2_group_means_diff.csv")
print("\nSaved step2_perweek_values.csv and step2_group_means_diff.csv")

