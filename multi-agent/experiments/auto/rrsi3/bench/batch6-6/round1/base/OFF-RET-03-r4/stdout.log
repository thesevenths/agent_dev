import pandas as pd, numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r4\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r4\_sandbox\tmp\step2_results.csv"

df = pd.read_csv(path)
n = len(df)

# Pearson correlations
r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")

# median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = [
    {"metric": "pearson_corr_retention_d7_vs_arpu_usd", "value": round(r_arpu, 6), "n": n, "note": "Pearson, all 60 rows"},
    {"metric": "pearson_corr_retention_d7_vs_churn_rate", "value": round(r_churn, 6), "n": n, "note": "Pearson, all 60 rows"},
    {"metric": "retention_d7_median", "value": round(med, 6), "n": n, "note": "median of retention_d7, 60 rows"},
    {"metric": "group_high_arpu_usd_mean", "value": round(hi["arpu_usd"].mean(), 6), "n": len(hi), "note": "mean arpu_usd where retention_d7 > median"},
    {"metric": "group_low_arpu_usd_mean", "value": round(lo["arpu_usd"].mean(), 6), "n": len(lo), "note": "mean arpu_usd where retention_d7 <= median"},
    {"metric": "group_high_cohort_size_sum", "value": int(hi["cohort_size"].sum()), "n": len(hi), "note": "sum cohort_size where retention_d7 > median"},
    {"metric": "group_low_cohort_size_sum", "value": int(lo["cohort_size"].sum()), "n": len(lo), "note": "sum cohort_size where retention_d7 <= median"},
    {"metric": "arpu_ratio_high_over_low", "value": round(hi["arpu_usd"].mean()/lo["arpu_usd"].mean(), 6), "n": len(hi)+len(lo), "note": "derived: high mean / low mean"},
]
res = pd.DataFrame(rows)
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

```
