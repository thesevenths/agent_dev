import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r4\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

# Pearson correlations
corr_arpu = df['retention_d7'].corr(df['arpu_usd'])
corr_churn = df['retention_d7'].corr(df['churn_rate'])
print("corr(retention_d7, arpu_usd) =", corr_arpu)
print("corr(retention_d7, churn_rate) =", corr_churn)

# Median split
med = df['retention_d7'].median()
print("median =", med)
hi = df[df['retention_d7'] > med]
lo = df[df['retention_d7'] < med]
print("hi rows:", len(hi), "lo rows:", len(lo))

stats = pd.DataFrame({
    'group': ['retention_d7 > median (high)', 'retention_d7 < median (low)'],
    'n_rows': [len(hi), len(lo)],
    'mean_arpu_usd': [hi['arpu_usd'].mean(), lo['arpu_usd'].mean()],
    'sum_cohort_size': [int(hi['cohort_size'].sum()), int(lo['cohort_size'].sum())],
    'mean_retention_d7': [hi['retention_d7'].mean(), lo['retention_d7'].mean()],
    'mean_churn_rate': [hi['churn_rate'].mean(), lo['churn_rate'].mean()],
})
print(stats.to_string(index=False))

# extra: arpu ratio hi/lo
print("arpu ratio hi/lo =", hi['arpu_usd'].mean() / lo['arpu_usd'].mean())

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-03-r4\_sandbox\tmp\step2_results.csv"
