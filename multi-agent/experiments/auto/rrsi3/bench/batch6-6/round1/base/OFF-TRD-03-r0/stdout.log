```python
import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("nulls:\n", df.isnull().sum())
print("dupes (month,region,product_line):", df.duplicated(subset=['month','region','product_line']).sum())
print("product_lines:", sorted(df['product_line'].unique()))
print("rows per region:\n", df.groupby('region').size())
print("revenue min/max:", df['revenue'].min(), df['revenue'].max())
print("revenue negative?", (df['revenue']<0).any())

# quick aggregates for downstream
g = df.groupby('region')['revenue'].sum()
print("\nregion totals:\n", g)
print("grand total:", g.sum())
print("share:\n", (g/g.sum()*100).round(2))
print("monthly avg (12+12=24 months):\n", (g/24).round(2))
print("\nmonthly totals:\n", df.groupby('month')['revenue'].sum().to_string())
top_region = g.idxmax()
print("\ntop region:", top_region)
mr = df[df.region==top_region].groupby('month')['revenue'].sum()
print("top region peak month:", mr.idxmax(), mr.max())

```
