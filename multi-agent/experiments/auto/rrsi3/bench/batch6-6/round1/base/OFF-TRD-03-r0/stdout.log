import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r0\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r0\_sandbox\tmp"

df = pd.read_csv(src)
assert df.shape == (288, 7)

grand_total = df['revenue'].sum()
n_months = df['month'].nunique()  # 24

# per-region aggregates
reg = df.groupby('region')['revenue'].agg(total='sum', rows='count')
reg['share_pct'] = reg['total'] / grand_total * 100
reg['monthly_avg'] = reg['total'] / n_months
reg = reg.reindex(['N','S','E','W'])
reg.to_csv(f"{out_dir}\\regional_aggregates.csv", float_format='%.2f')
print(reg)
print("grand_total:", grand_total, "n_months:", n_months)

# top region
top = reg['total'].idxmax()
print("top region:", top, reg.loc[top, 'total'])

# peak month within top region
sub = df[df['region'] == top].groupby('month')['revenue'].sum()
peak_month, peak_val = sub.idxmax(), sub.max()
print("peak month:", peak_month, peak_val)

# save peak info too
peak_df = pd.DataFrame({'region':[top], 'peak_month':[peak_month], 'peak_revenue':[peak_val]})
peak_df.to_csv(f"{out_dir}\\top_region_peak.csv", index=False, float_format='%.2f')

# also full monthly series for top region for verification
sub.to_csv(f"{out_dir}\\top_region_monthly.csv", float_format='%.2f')
print(sub)

