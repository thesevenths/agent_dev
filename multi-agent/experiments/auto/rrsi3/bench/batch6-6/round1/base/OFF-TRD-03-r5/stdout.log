import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

# Per-region aggregates
reg = df.groupby('region')['revenue'].agg(['sum','count'])
grand = reg['sum'].sum()
reg['share'] = reg['sum']/grand
reg['monthly_avg'] = reg['sum']/24
reg = reg.sort_values('sum', ascending=False)
print(reg)
print("grand total:", grand, "rows:", len(df))

# Peak month per region
pm = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak = pm.loc[pm.groupby('region')['revenue'].idxmax()]
print(peak)

# Overall peak month (any region)
overall_peak = pm.loc[pm['revenue'].idxmax()]
print("overall peak:", overall_peak)

# Top region's monthly series for context
top = reg.index[0]
print(pm[pm['region']==top].to_string(index=False))

# E 2025-03 anomaly check
print(df[(df['region']=='E')&(df['month']=='2025-03')])

# Save artifacts
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-TRD-03-r5\_sandbox\tmp"
reg_out = reg.reset_index()
reg_out.to_csv(os.path.join(outdir, "step2_region_aggregates.csv"), index=False)

result = {
    "source_file": "offline_data/regional_sales.csv",
    "as_of": "2026-10-25 17:48",
    "total_rows": int(len(df)),
    "months": 24,
    "month_range": [df['month'].min(), df['month'].max()],
    "grand_total_revenue": float(grand),
    "regions": [
        {
            "region": r,
            "total_revenue": float(reg.loc[r,'sum']),
            "share_of_grand_total": float(reg.loc[r,'share']),
            "monthly_avg_revenue": float(reg.loc[r,'monthly_avg']),
            "rows_used": int(reg.loc[r,'count']),
            "peak_month": peak[peak['region']==r]['month'].iloc[0],
            "peak_month_revenue": float(peak[peak['region']==r]['revenue'].iloc[0]),
        } for r in reg.index
    ],
    "top_region": reg.index[0],
    "top_region_peak_month": peak[peak['region']==reg.index[0]]['month'].iloc[0],
    "top_region_peak_month_revenue": float(peak[peak['region']==reg.index[0]]['revenue'].iloc[0]),
    "overall_peak": {"region": overall_peak['region'], "month": overall_peak['month'], "revenue": float(overall_peak['revenue'])},
}
with open(os.path.join(outdir, "step2_region_aggregates.json"), "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print("saved:", os.path.join(outdir, "step2_region_aggregates.csv"), os.path.join(outdir, "step2_region_aggregates.json"))

