import pandas as pd, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("nulls:\n", df.isna().sum())
print("dtypes:\n", df.dtypes)
# sanity: revenue vs units*unit_price
df['check'] = (df['units']*df['unit_price'] - df['revenue']).abs()
print("max |units*price - revenue|:", df['check'].max())
# rows per region
print(df.groupby('region').size())
# rows per month
print(df.groupby('month').size().describe())
# any duplicate (month,region,product_line)?
print("dup keys:", df.duplicated(subset=['month','region','product_line']).sum())
print("product lines:", sorted(df['product_line'].unique()))
print("abs path:", os.path.abspath(path))

