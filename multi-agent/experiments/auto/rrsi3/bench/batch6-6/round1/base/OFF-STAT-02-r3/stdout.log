```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r3\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
m, r = df["math_score"], df["reading_score"]
n = len(df)

def stats(s):
    mean = s.mean()
    std = s.std(ddof=1)  # sample std
    std_pop = s.std(ddof=0)
    return dict(mean=mean, std_sample=std, std_pop=std_pop,
                median=float(s.median()), min=int(s.min()), max=int(s.max()),
                cv_sample=std/mean*100, cv_pop=std_pop/mean*100)

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "n_missing_math": int(m.isna().sum()),
    "n_missing_reading": int(r.isna().sum()),
    "math_score": stats(m),
    "reading_score": stats(r),
    "pearson_r": float(m.corr(r)),
    "pearson_r_pop": float(m.corr(r, method="pearson")),
}
# correlation using population vs sample std is identical for pearson
with open(os.path.join(out_dir, "stats_results.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
