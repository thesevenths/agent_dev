import pandas as pd, json, os

path = "offline_data/app_metrics.csv"
df = pd.read_csv(path)

w30_36 = [f"W{i:02d}" for i in range(30, 37)]
w37_43 = [f"W{i:02d}" for i in range(37, 44)]
cols = ["retention_d7", "churn_rate", "arpu_usd"]

g1 = df[df["week"].isin(w30_36)]
g2 = df[df["week"].isin(w37_43)]
print("n1:", len(g1), "n2:", len(g2))

means1 = g1[cols].mean()
means2 = g2[cols].mean()
diff = means2 - means1
pct = diff / means1 * 100
print("means W30-36:\n", means1)
print("means W37-43:\n", means2)
print("diff (W37-43 - W30-36):\n", diff)
print("pct change:\n", pct)

# per-week W30-W43
sub = df[df["week"].isin(w30_36 + w37_43)].copy()
sub = sub.sort_values("week")
print(sub[["week"] + cols].to_string(index=False))

# largest week-over-week jump within W31..W43
sub["delta_ret"] = sub["retention_d7"].diff()
sub["delta_churn"] = sub["churn_rate"].diff()
sub["delta_arpu"] = sub["arpu_usd"].diff()
print(sub[["week", "delta_ret", "delta_churn", "delta_arpu"]].to_string(index=False))

# breakpoint: week with largest combined normalized jump
# normalize each delta by std of the column over W30-W43
norm = sub.set_index("week")
for c, d in [("retention_d7","delta_ret"), ("churn_rate","delta_churn"), ("arpu_usd","delta_arpu")]:
    std = sub[c].std()
    norm[d + "_z"] = norm[d] / std
norm["score"] = norm["delta_ret_z"].abs() + norm["delta_churn_z"].abs() + norm["delta_arpu_z"].abs()
print(norm[["delta_ret_z","delta_churn_z","delta_arpu_z","score"]].sort_values("score", ascending=False).head(5))

