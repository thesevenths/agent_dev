import pandas as pd

path = "offline_data/app_metrics.csv"
df = pd.read_csv(path)

# check week range and target windows
weeks = df["week"].tolist()
print("weeks:", weeks[:5], "...", weeks[-5:])

w30_36 = [f"W{i:02d}" for i in range(30, 37)]
w37_43 = [f"W{i:02d}" for i in range(37, 44)]
print("W30-W36 present:", all(w in weeks for w in w30_36))
print("W37-W43 present:", all(w in weeks for w in w37_43))

sub = df[df["week"].isin(w30_36 + w37_43)]
print(sub.to_string(index=False))

# check nulls in target columns
print("nulls:\n", df[["retention_d7","churn_rate","arpu_usd"]].isna().sum())

# save inspection summary
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r2\_sandbox\tmp"
import os
os.makedirs(out_dir, exist_ok=True)
summary = pd.DataFrame({
    "item": ["shape", "columns", "week_range", "target_cols_dtypes", "nulls_retention_d7", "nulls_churn_rate", "nulls_arpu_usd", "W30-W36_rows", "W37-W43_rows"],
    "value": [
        str(df.shape),
        ", ".join(df.columns),
        f"{weeks[0]} .. {weeks[-1]}",
        "retention_d7=float64, churn_rate=float64, arpu_usd=float64",
        int(df["retention_d7"].isna().sum()),
        int(df["churn_rate"].isna().sum()),
        int(df["arpu_usd"].isna().sum()),
        len(df[df["week"].isin(w30_36)]),
        len(df[df["week"].isin(w37_43)]),
    ]
})
out_path = os.path.join(out_dir, "inspection_summary.csv")
summary.to_csv(out_path, index=False)
print("saved:", out_path)

