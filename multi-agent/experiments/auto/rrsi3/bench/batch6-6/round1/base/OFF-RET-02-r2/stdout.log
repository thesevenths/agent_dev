```python
import pandas as pd

df = pd.read_csv(r"offline_data/app_metrics.csv")
df["wk"] = df["week"].str[1:].astype(int)
sub = df[df.wk.between(30, 43)].copy()
sub["group"] = sub.wk.apply(lambda w: "W30-W36" if w <= 36 else "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week series
weekly = sub[["week", "group"] + metrics].copy()

# group means
means = sub.groupby("group")[metrics].mean().reset_index()
means.columns = ["group"] + [f"mean_{c}" for c in metrics]

# differences: after - before
before = means[means.group == "W30-W36"].iloc[0]
after = means[means.group == "W37-W43"].iloc[0]
diff_rows = []
for c in metrics:
    b, a = before[f"mean_{c}"], after[f"mean_{c}"]
    diff_rows.append({
        "metric": c,
        "mean_W30_W36": round(b, 6),
        "mean_W37_W43": round(a, 6),
        "abs_diff_after_minus_before": round(a - b, 6),
        "rel_diff_pct": round((a - b) / b * 100, 4),
        "n_before": 7, "n_after": 7,
    })
diff = pd.DataFrame(diff_rows)

# breakpoint scan: week-over-week change in each metric, flag largest jump
wow = weekly.set_index("week")[metrics].diff()
wow.index = "W" + wow.index.astype(str).str.zfill(2)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-RET-02-r2\_sandbox\tmp"
weekly.to_csv(f"{out_dir}\\step2_weekly_series.csv", index=False, encoding="utf-8-sig")
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False, encoding="utf-8-sig")
diff.to_csv(f"{out_dir}\\step2_group_diff.csv", index=False, encoding="utf-8-sig")
wow.to_csv(f"{out_dir}\\step2_week_over_week.csv", encoding="utf-8-sig")

print("=== weekly ===")
print(weekly.to_string(index=False))
print("\n=== group means (full precision) ===")
print(means.to_string(index=False))
print("\n=== diff ===")
print(diff.to_string(index=False))
print("\n=== week-over-week (W36->W43) ===")
print(wow.loc[wow.index.isin(["W36","W37","W38","W39","W40","W41","W42","W43"])].round(6).to_string())

```
