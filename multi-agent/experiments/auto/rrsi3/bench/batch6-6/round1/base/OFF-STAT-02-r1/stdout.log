```python
import pandas as pd, json, numpy as np

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(csv)
print(df.head())
print(df.shape)
print(df.dtypes)
print(df[['math_score','reading_score']].isna().sum())

res = {}
for col in ['math_score','reading_score']:
    s = df[col].dropna()
    res[col] = {
        'n': int(s.count()),
        'mean': float(s.mean()),
        'std_sample': float(s.std(ddof=1)),
        'std_pop': float(s.std(ddof=0)),
        'median': float(s.median()),
        'min': float(s.min()),
        'max': float(s.max()),
    }
    res[col]['cv_sample'] = res[col]['std_sample']/res[col]['mean']
    res[col]['cv_pop'] = res[col]['std_pop']/res[col]['mean']

sub = df[['math_score','reading_score']].dropna()
res['pearson'] = float(sub['math_score'].corr(sub['reading_score'], method='pearson'))
res['n_pair'] = int(len(sub))
res['columns'] = list(df.columns)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-STAT-02-r1\_sandbox\tmp\stats_results.json"
with open(out,'w',encoding='utf-8') as f:
    json.dump(res,f,ensure_ascii=False,indent=2)
print(json.dumps(res,ensure_ascii=False,indent=2))
print("saved:", out)

