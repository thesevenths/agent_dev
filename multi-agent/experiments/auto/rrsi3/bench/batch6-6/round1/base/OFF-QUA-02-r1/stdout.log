```python
import pandas as pd
CSV = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round1\base\OFF-QUA-02-r1\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(CSV)
expected = df["units"] * df["unit_price"]
dev = (df["revenue"] - expected).abs() / expected * 100.0
print("rows:", len(df))
print("max dev pct:", dev.max(), "at idx", dev.idxmax())
print("top5 dev:")
print(dev.sort_values(ascending=False).head(5).round(6))
print("returns>units:", (df["returns"] > df["units"]).sum())
print("returns min/max:", df["returns"].min(), df["returns"].max())
print("units min/max:", df["units"].min(), df["units"].max())
print("months:", sorted(df["month"].unique()))
print("regions:", sorted(df["region"].unique()))
print("product_lines:", sorted(df["product_line"].unique()))
print("nulls:", int(df.isna().sum().sum()))
print("revenue sum:", round(df["revenue"].sum(),2), "units sum:", int(df["units"].sum()), "returns sum:", int(df["returns"].sum()))
print("revenue min/max:", df["revenue"].min(), df["revenue"].max())
print("unit_price min/max:", df["unit_price"].min(), df["unit_price"].max())
print("dup rows:", int(df.duplicated().sum()))
print("dup month-region-line:", int(df.duplicated(subset=["month","region","product_line"]).sum()))

