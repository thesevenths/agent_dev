import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\tmp"

df = pd.read_csv(path)
r = df["retention_d7"]

first = r.iloc[:30]
last = r.iloc[30:]

# population std (ddof=0) and sample std (ddof=1) both reported
stats = {
    "first30_mean": first.mean(),
    "first30_std_ddof1": first.std(ddof=1),
    "first30_std_ddof0": first.std(ddof=0),
    "last30_mean": last.mean(),
    "last30_std_ddof1": last.std(ddof=1),
    "last30_std_ddof0": last.std(ddof=0),
    "overall_mean": r.mean(),
    "overall_std_ddof1": r.std(ddof=1),
    "overall_std_ddof0": r.std(ddof=0),
}
stats["mean_diff_last_minus_first"] = stats["last30_mean"] - stats["first30_mean"]
stats["std_diff_last_minus_first_ddof1"] = stats["last30_std_ddof1"] - stats["first30_std_ddof1"]

thr1 = stats["overall_mean"] - 2*stats["overall_std_ddof1"]
thr0 = stats["overall_mean"] - 2*stats["overall_std_ddof0"]
below1 = (r < thr1).sum()
below0 = (r < thr0).sum()
weeks_below1 = df.loc[r < thr1, "week"].tolist()
weeks_below0 = df.loc[r < thr0, "week"].tolist()

for k, v in stats.items():
    print(f"{k}: {v:.6f}")
print("threshold(ddof1):", f"{thr1:.6f}", "weeks below:", below1, weeks_below1)
print("threshold(ddof0):", f"{thr0:.6f}", "weeks below:", below0, weeks_below0)

# save intermediate results CSV
rows = [
    {"metric": "first30_mean", "value": stats["first30_mean"], "n": 30, "note": "W01-W30 mean of retention_d7"},
    {"metric": "first30_std_ddof1", "value": stats["first30_std_ddof1"], "n": 30, "note": "sample std (ddof=1)"},
    {"metric": "first30_std_ddof0", "value": stats["first30_std_ddof0"], "n": 30, "note": "population std (ddof=0)"},
    {"metric": "last30_mean", "value": stats["last30_mean"], "n": 30, "note": "W31-W60 mean of retention_d7"},
    {"metric": "last30_std_ddof1", "value": stats["last30_std_ddof1"], "n": 30, "note": "sample std (ddof=1)"},
    {"metric": "last30_std_ddof0", "value": stats["last30_std_ddof0"], "n": 30, "note": "population std (ddof=0)"},
    {"metric": "overall_mean", "value": stats["overall_mean"], "n": 60, "note": "W01-W60 mean of retention_d7"},
    {"metric": "overall_std_ddof1", "value": stats["overall_std_ddof1"], "n": 60, "note": "sample std (ddof=1)"},
    {"metric": "overall_std_ddof0", "value": stats["overall_std_ddof0"], "n": 60, "note": "population std (ddof=0)"},
    {"metric": "mean_diff_last_minus_first", "value": stats["mean_diff_last_minus_first"], "n": 60, "note": "last30_mean - first30_mean"},
    {"metric": "std_diff_last_minus_first_ddof1", "value": stats["std_diff_last_minus_first_ddof1"], "n": 60, "note": "last30_std(ddof1) - first30_std(ddof1)"},
    {"metric": "threshold_mean_minus_2std_ddof1", "value": thr1, "n": 60, "note": "overall_mean - 2*overall_std(ddof1)"},
