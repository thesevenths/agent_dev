import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30, last30 = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = (r < threshold).sum()
below_weeks = df.loc[r < threshold, "week"].tolist()

res = {
  "n_total": int(len(r)),
  "first30": {"weeks": f"W01-W30", "n": 30, "mean": first30.mean(), "std": first30.std(ddof=1)},
  "last30": {"weeks": f"W31-W60", "n": 30, "mean": last30.mean(), "std": last30.std(ddof=1)},
  "diff_mean_last_minus_first": last30.mean() - first30.mean(),
  "overall": {"mean": overall_mean, "std": overall_std},
  "threshold_mean_minus_2std": threshold,
  "weeks_below_threshold": int(below),
  "weeks_below_list": below_weeks,
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\tmp\retention_d7_stats.json"
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
