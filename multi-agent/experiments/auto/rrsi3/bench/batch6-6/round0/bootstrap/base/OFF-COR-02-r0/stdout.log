out = {
    "n": n,
    "pearson_screen_math": r_math,
    "pearson_screen_reading": r_read,
    "mean_screen_hours_per_day": df["screen_hours_per_day"].mean(),
    "mean_math_score": df["math_score"].mean(),
    "mean_reading_score": df["reading_score"].mean(),
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json", "w") as f:
