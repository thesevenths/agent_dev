import pandas as pd, numpy as np, json

df = pd.read_csv("offline_data/students.csv")
s = df["screen_hours_per_day"]; m = df["math_score"]; r = df["reading_score"]

r_sm = s.corr(m, method="pearson")
r_sr = s.corr(r, method="pearson")

# p-values via t-statistic
from scipy import stats
t_sm = r_sm*np.sqrt(len(df)-2)/np.sqrt(1-r_sm**2)
t_sr = r_sr*np.sqrt(len(df)-2)/np.sqrt(1-r_sr**2)
p_sm = 2*stats.t.sf(abs(t_sm), len(df)-2)
p_sr = 2*stats.t.sf(abs(t_sr), len(df)-2)

hi = df[s>5]; lo = df[s<=5]
rows = []
for name, g in [("screen<=5", lo), ("screen>5", hi)]:
    rows.append({
        "group": name,
        "n": len(g),
        "mean_screen": g["screen_hours_per_day"].mean(),
        "mean_math": g["math_score"].mean(),
        "mean_reading": g["reading_score"].mean(),
        "std_math": g["math_score"].std(ddof=1),
        "std_reading": g["reading_score"].std(ddof=1),
    })
grp = pd.DataFrame(rows)
diff = {
    "n_hi_minus_lo": int(grp.loc[grp.group=="screen>5","n"].iloc[0] - grp.loc[grp.group=="screen<=5","n"].iloc[0]),
    "mean_math_hi_minus_lo": float(grp.loc[grp.group=="screen>5","mean_math"].iloc[0] - grp.loc[grp.group=="screen<=5","mean_math"].iloc[0]),
    "mean_reading_hi_minus_lo": float(grp.loc[grp.group=="screen>5","mean_reading"].iloc[0] - grp.loc[grp.group=="screen<=5","mean_reading"].iloc[0]),
}
# t-tests for group differences
tt_m = stats.ttest_ind(hi["math_score"], lo["math_score"], equal_var=False)
tt_r = stats.ttest_ind(hi["reading_score"], lo["reading_score"], equal_var=False)
diff["ttest_math_t"] = float(tt_m.statistic); diff["ttest_math_p"] = float(tt_m.pvalue)
