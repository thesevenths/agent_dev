r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
n = len(df)
print("n =", n)
print("pearson screen~math  =", repr(r_math))
print("pearson screen~read  =", repr(r_read))
print("mean screen =", df["screen_hours_per_day"].mean())
