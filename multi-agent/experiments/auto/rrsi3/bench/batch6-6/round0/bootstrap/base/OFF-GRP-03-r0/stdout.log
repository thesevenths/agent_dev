```python
import pandas as pd, json, os

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round0\bootstrap\base\OFF-GRP-03-r0\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch6-6\round0\bootstrap\base\OFF-GRP-03-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv_path)

def group(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(group)

res = df.groupby("group", observed=True).agg(
    n=("math_score","size"),
    mean_math=("math_score","mean"),
    std_math=("math_score","std"),
    min_math=("math_score","min"),
    max_math=("math_score","max"),
    mean_hours=("study_hours_per_week","mean"),
).reindex(["low","mid","high"])
print(res)

gain = res.loc["high","mean_math"] - res.loc["low","mean_math"]
print("gain:", gain)

res.to_csv(os.path.join(out_dir, "group_stats.csv"), encoding="utf-8-sig")

summary = {
    "source_csv": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "nulls": {"study_hours_per_week": 0, "math_score": 0},
    "groups": {g: {k: (None if pd.isna(v) else (int(v) if k=="n" else float(v))) for k,v in row.items()} for g,row in res.iterrows()},
    "low_to_high_gain": float(gain),
    "overall_mean_math": float(df["math_score"].mean()),
}
with open(os.path.join(out_dir, "group_stats.json"), "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("saved")

```
