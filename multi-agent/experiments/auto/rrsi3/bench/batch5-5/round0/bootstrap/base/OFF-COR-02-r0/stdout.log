```python
import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day","math_score","reading_score"]
sub = df[cols].dropna()
n = len(sub)

r_math = sub["screen_hours_per_day"].corr(sub["math_score"])
r_read = sub["screen_hours_per_day"].corr(sub["reading_score"])

# p-values via t-test
from scipy import stats
t_math = r_math * (n-2) / (1-r_math**2)**0.5
t_read = r_read * (n-2) / (1-r_read**2)**0.5
p_math = 2*stats.t.sf(abs(t_math), n-2)
p_read = 2*stats.t.sf(abs(t_read), n-2)

res = {
  "n": n,
  "pearson_screen_vs_math": round(r_math, 6),
  "pearson_screen_vs_reading": round(r_read, 6),
  "t_math": round(t_math,4), "p_math": p_math,
  "t_read": round(t_read,4), "p_read": p_read,
}
print(json.dumps(res, indent=2))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json"
with open(out,"w") as f: json.dump(res,f,indent=2)
print("saved:", out)

```
