import pandas as pd, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round0\bootstrap\base\OFF-COR-02-r0\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv("offline_data/students.csv")
n_total = len(df)
missing = df[["screen_hours_per_day","math_score","reading_score"]].isna().sum().to_dict()
df2 = df.dropna(subset=["screen_hours_per_day","math_score","reading_score"])
n = len(df2)

r_math = df2["screen_hours_per_day"].corr(df2["math_score"], method="pearson")
r_read = df2["screen_hours_per_day"].corr(df2["reading_score"], method="pearson")

hi = df2[df2["screen_hours_per_day"] > 5]
lo = df2[df2["screen_hours_per_day"] <= 5]

res = {
  "as_of": "2026-10-26 08:15",
  "source_file": "offline_data/students.csv",
  "n_total_rows": n_total,
  "missing_values": missing,
  "n_used": n,
  "pearson_screen_math": round(r_math, 4),
  "pearson_screen_reading": round(r_read, 4),
  "group_hi": {"n": len(hi), "math_mean": round(hi["math_score"].mean(),4), "reading_mean": round(hi["reading_score"].mean(),4)},
  "group_lo": {"n": len(lo), "math_mean": round(lo["math_score"].mean(),4), "reading_mean": round(lo["reading_score"].mean(),4)},
  "diff_math_hi_minus_lo": round(hi["math_score"].mean()-lo["math_score"].mean(),4),
  "diff_reading_hi_minus_lo": round(hi["reading_score"].mean()-lo["reading_score"].mean(),4),
}
with open(os.path.join(out_dir, "step1_correlations.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

