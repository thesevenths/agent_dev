import pandas as pd, json

df = pd.read_csv('offline_data/students.csv')
print("nulls:", df[['study_hours_per_week','math_score']].isna().sum().to_dict())

def grp(h):
    if h < 2.5: return 'low'
    elif h <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)
res = df.groupby('group')['math_score'].agg(n='count', mean='mean', std='std', min='min', max='max').reindex(['low','mid','high'])
print(res)

low_mean = res.loc['low','mean']; high_mean = res.loc['high','mean']
gain = high_mean - low_mean
gain_pct = gain / low_mean * 100
print("gain:", gain, "pct:", gain_pct)

out = {
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "groups": {g: {"n": int(res.loc[g,'n']), "mean_math_score": round(float(res.loc[g,'mean']),4),
                 "std": round(float(res.loc[g,'std']),4), "min": int(res.loc[g,'min']), "max": int(res.loc[g,'max'])}
             for g in ['low','mid','high']},
  "low_to_high_gain": round(float(gain),4),
  "low_to_high_gain_pct": round(float(gain_pct),4),
  "as_of": "2026-10-26 08:15"
}
import os
os.makedirs('E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch5-5/round0/bootstrap/base/OFF-GRP-03-r0/_sandbox/tmp', exist_ok=True)
with open('E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch5-5/round0/bootstrap/base/OFF-GRP-03-r0/_sandbox/tmp/group_stats.json','w',encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved")

