# first 30 / last 30 split
first30 = col.iloc[:30]
last30 = col.iloc[30:]
print("first30 rows:", len(first30), "last30 rows:", len(last30))

# overall stats (population vs sample std)
mean_all = col.mean()
std_pop = col.std(ddof=0)
std_smp = col.std(ddof=1)
print("overall mean:", mean_all)
print("overall std (ddof=0):", std_pop)
print("overall std (ddof=1):", std_smp)

