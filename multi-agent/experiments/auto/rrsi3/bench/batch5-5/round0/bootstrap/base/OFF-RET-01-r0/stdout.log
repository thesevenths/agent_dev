print(below2.to_string(index=False))

# diff
first30 = col.iloc[:30]; last30 = col.iloc[30:]
print("diff mean (first30 - last30):", first30.mean() - last30.mean())
print("diff std ddof=0:", first30.std(ddof=0) - last30.std(ddof=0))
print("diff std ddof=1:", first30.std(ddof=1) - last30.std(ddof=1))

