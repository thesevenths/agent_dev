print("weeks below mean-2*std(ddof=0):", below_pop)
print("weeks below mean-2*std(ddof=1):", below_smp)

# first/last 30 stats
for name, s in [("first30", first30), ("last30", last30)]:
    print(name, "mean:", s.mean(), "std(ddof=0):", s.std(ddof=0), "std(ddof=1):", s.std(ddof=1))

