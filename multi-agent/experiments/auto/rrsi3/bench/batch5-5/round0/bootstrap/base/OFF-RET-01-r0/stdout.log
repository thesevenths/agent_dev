import pandas as pd, json

path = r"offline_data/app_metrics.csv"
df = pd.read_csv(path)
col = df["retention_d7"]

first30 = col.iloc[:30]
last30 = col.iloc[30:]

def stats(s):
    return {
        "n": int(len(s)),
        "mean": s.mean(),
        "std_ddof0": s.std(ddof=0),
        "std_ddof1": s.std(ddof=1),
        "min": s.min(),
        "max": s.max(),
    }

overall = stats(col)
f = stats(first30)
l = stats(last30)

# threshold & count, both conventions
thr0 = overall["mean"] - 2*overall["std_ddof0"]
thr1 = overall["mean"] - 2*overall["std_ddof1"]
below0 = df[col < thr0][["week","retention_d7"]].values.tolist()
below1 = df[col < thr1][["week","retention_d7"]].values.tolist()

result = {
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "as_of": "2026-10-25 12:21",
    "data_file_mtime": "2026-10-23 10:11",
    "first30": {**f, "weeks": "W01-W30"},
    "last30": {**l, "weeks": "W31-W60"},
    "overall": {**overall, "weeks": "W01-W60"},
    "diff_mean_first_minus_last": f["mean"] - l["mean"],
    "diff_std_ddof0_first_minus_last": f["std_ddof0"] - l["std_ddof0"],
    "diff_std_ddof1_first_minus_last": f["std_ddof1"] - l["std_ddof1"],
    "threshold_mean_minus_2std_ddof0": thr0,
    "threshold_mean_minus_2std_ddof1": thr1,
    "count_below_mean_minus_2std_ddof0": len(below0),
    "count_below_mean_minus_2std_ddof1": len(below1),
    "weeks_below_ddof0": below0,
    "weeks_below_ddof1": below1,
}

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as fp:
    json.dump(result, fp, ensure_ascii=False, indent=2)

print(json.dumps(result, ensure_ascii=False, indent=2))

