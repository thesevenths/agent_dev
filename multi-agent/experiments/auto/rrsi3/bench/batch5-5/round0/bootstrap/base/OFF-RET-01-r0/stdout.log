import pandas as pd

path = r"offline_data/app_metrics.csv"
df = pd.read_csv(path)
col = df["retention_d7"]

mean_all = col.mean()
std_pop = col.std(ddof=0)
std_smp = col.std(ddof=1)

thr_pop = mean_all - 2*std_pop
thr_smp = mean_all - 2*std_smp
print("threshold (ddof=0):", thr_pop)
print("threshold (ddof=1):", thr_smp)

below = df[col < thr_pop][["week", "retention_d7"]]
