```python
import pandas as pd, json
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r1\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r1\_sandbox\tmp"
df = pd.read_csv(p)

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"
df["group"] = df["study_hours_per_week"].apply(grp)

rows = []
for g in ["low","mid","high"]:
    sub = df[df.group==g]
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "math_mean": round(float(sub.math_score.mean()),4),
        "math_std": round(float(sub.math_score.std(ddof=1)),4),
        "hours_min": float(sub.study_hours_per_week.min()),
        "hours_max": float(sub.study_hours_per_week.max()),
        "hours_mean": round(float(sub.study_hours_per_week.mean()),4),
    })
g = pd.DataFrame(rows)
low = g[g.group=="low"].iloc[0]; high = g[g.group=="high"].iloc[0]
gain = high.math_mean - low.math_mean
rel = gain/low.math_mean*100
summary = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "as_of": "2026-10-25 12:31",
    "groups": rows,
    "low_to_high_gain": round(float(gain),4),
    "low_to_high_rel_pct": round(float(rel),4),
    "overall_math_mean": round(float(df.math_score.mean()),4),
}
g.to_csv(out+r"\group_stats.csv", index=False)
with open(out+r"\group_stats.json","w",encoding="utf-8") as f:
    json.dump(summary,f,ensure_ascii=False,indent=2)
print(g.to_string(index=False))
print("gain:", round(gain,4), "rel%:", round(rel,4))
print("overall mean:", round(df.math_score.mean(),4))

