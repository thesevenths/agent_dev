import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")

grand = df['revenue'].sum()
reg = df.groupby('region')['revenue'].sum().sort_values(ascending=False)
monthly = df.groupby(['region','month'])['revenue'].sum().reset_index()

rows = []
for r in reg.index:
    total = reg[r]
    sub = monthly[monthly['region']==r]
    peak_month = sub.loc[sub['revenue'].idxmax(),'month']
    peak_val = sub['revenue'].max()
    rows.append({
        'region': r,
        'total_revenue': round(total,2),
        'share_pct': round(total/grand*100,4),
        'monthly_avg_revenue': round(total/24,2),
        'peak_month': peak_month,
        'peak_month_revenue': round(peak_val,2),
        'n_rows': int((df['region']==r).sum()),
    })

out = pd.DataFrame(rows)
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r4\_sandbox\tmp\step2_regional_aggregates.csv", index=False)

summary = {
    'source_file': 'offline_data/regional_sales.csv',
    'as_of': '2026-10-26 10:28',
    'grand_total_revenue': round(grand,2),
    'total_rows': len(df),
    'months': 24,
    'regions': out.to_dict('records'),
    'top_region': out.iloc[0]['region'],
    'top_region_peak_month': out.iloc[0]['peak_month'],
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r4\_sandbox\tmp\step2_regional_aggregates.json","w",encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)

print(out.to_string(index=False))
print("\ngrand total:", round(grand,2))
print("top region:", out.iloc[0]['region'], "peak month:", out.iloc[0]['peak_month'])

```
