import pandas as pd
import numpy as np

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-STAT-02-r1\_sandbox\offline_data\students.csv")
m = df['math_score']; r = df['reading_score']

res = {}
for name, s in [('math_score', m), ('reading_score', r)]:
    mean = s.mean(); std = s.std(ddof=1); med = s.median()
    res[name] = dict(n=len(s), mean=mean, std=std, median=med, cv=std/mean)

corr = m.corr(r)  # Pearson
print("n =", len(df))
for k, v in res.items():
    print(k, {kk: round(vv, 6) for kk, vv in v.items()})
print("pearson r =", round(corr, 6))
print("cv ratio math/reading =", round(res['math_score']['cv']/res['reading_score']['cv'], 6))

