```python
import pandas as pd, json, numpy as np

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-STAT-02-r5\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-STAT-02-r5\_sandbox\tmp"

df = pd.read_csv(csv_path)
m = df['math_score']; r = df['reading_score']
n = len(df)

def stats(s):
    mean = s.mean()
    std_sample = s.std(ddof=1)
    std_pop = s.std(ddof=0)
    med = s.median()
    cv_sample = std_sample/mean
    cv_pop = std_pop/mean
    return dict(mean=float(mean), std_sample=float(std_sample), std_pop=float(std_pop),
                median=float(med), cv_sample=float(cv_sample), cv_pop=float(cv_pop),
                min=int(s.min()), max=int(s.max()))

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": int(n),
    "n_missing": int(df[['math_score','reading_score']].isna().sum().sum()),
    "math_score": stats(m),
    "reading_score": stats(r),
    "pearson_r": float(np.corrcoef(m, r)[0,1]),
    "pearson_r_note": "numpy corrcoef (population-style, equivalent to pandas .corr('pearson'))",
    "pandas_pearson_r": float(df['math_score'].corr(df['reading_score'])),
}
# which has larger dispersion
res["larger_cv"] = "math_score" if res["math_score"]["cv_sample"] > res["reading_score"]["cv_sample"] else "reading_score"

out_path = out_dir + r"\stats_results.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out_path)

```
