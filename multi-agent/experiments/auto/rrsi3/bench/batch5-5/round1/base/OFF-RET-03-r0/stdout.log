import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r0\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)

# Correlations (Pearson)
corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] <= med]

stats = {
    "n_total": n,
    "retention_d7_median": med,
    "corr_retention_arpu": corr_arpu,
    "corr_retention_churn": corr_churn,
    "high_n": len(high),
    "high_arpu_mean": high["arpu_usd"].mean(),
    "high_cohort_sum": int(high["cohort_size"].sum()),
    "high_retention_mean": high["retention_d7"].mean(),
    "high_churn_mean": high["churn_rate"].mean(),
    "low_n": len(low),
    "low_arpu_mean": low["arpu_usd"].mean(),
    "low_cohort_sum": int(low["cohort_size"].sum()),
    "low_retention_mean": low["retention_d7"].mean(),
    "low_churn_mean": low["churn_rate"].mean(),
}
# derived
stats["arpu_ratio_high_over_low"] = stats["high_arpu_mean"] / stats["low_arpu_mean"]
stats["arpu_diff_high_minus_low"] = stats["high_arpu_mean"] - stats["low_arpu_mean"]
stats["cohort_share_high"] = stats["high_cohort_sum"] / (stats["high_cohort_sum"] + stats["low_cohort_sum"])

for k, v in stats.items():
    print(f"{k}: {v}")

# Save intermediate results CSV
rows = [
    {"metric": "n_total", "value": stats["n_total"], "source": "offline_data/app_metrics.csv 全表行数"},
    {"metric": "retention_d7_median", "value": stats["retention_d7_median"], "source": "retention_d7 列中位数, 60行"},
    {"metric": "corr_retention_d7_arpu_usd", "value": stats["corr_retention_arpu"], "source": "Pearson corr(retention_d7, arpu_usd), 60行"},
    {"metric": "corr_retention_d7_churn_rate", "value": stats["corr_retention_churn"], "source": "Pearson corr(retention_d7, churn_rate), 60行"},
    {"metric": "high_group_n", "value": stats["high_n"], "source": "retention_d7 > median 的行数"},
    {"metric": "high_group_arpu_usd_mean", "value": stats["high_arpu_mean"], "source": "高留存组 arpu_usd 均值"},
    {"metric": "high_group_cohort_size_sum", "value": stats["high_cohort_sum"], "source": "高留存组 cohort_size 求和"},
    {"metric": "high_group_retention_d7_mean", "value": stats["high_retention_mean"], "source": "高留存组 retention_d7 均值"},
    {"metric": "high_group_churn_rate_mean", "value": stats["high_churn_mean"], "source": "高留存组 churn_rate 均值"},
    {"metric": "low_group_n", "value": stats["low_n"], "source": "retention_d7 <= median 的行数"},
    {"metric": "low_group_arpu_usd_mean", "value": stats["low_arpu_mean"], "source": "低留存组 arpu_usd 均值"},
    {"metric": "low_group_cohort_size_sum", "value": stats["low_cohort_sum"], "source": "低留存组 cohort_size 求和"},
    {"metric": "low_group_retention_d7_mean", "value": stats["low_retention_mean"], "source": "低留存组 retention_d7 均值"},
    {"metric": "low_group_churn_rate_mean", "value": stats["low_churn_mean"], "source": "低留存组 churn_rate 均值"},
    {"metric": "arpu_ratio_high_over_low", "value": stats["arpu_ratio_high_over_low"], "source": "由前述两行计算: high_arpu_mean / low_arpu_mean"},
    {"metric": "arpu_diff_high_minus_low", "value": stats["arpu_diff_high_minus_low"], "source": "由前述两行计算: high_arpu_mean - low_arpu_mean"},
    {"metric": "cohort_share_high", "value": stats["cohort_share_high"], "source": "由前述两行计算: high_cohort_sum / (high+low)"},
]
res = pd.DataFrame(rows)
out_csv = out_dir + r"\step2_intermediate_results.csv"
res.to_csv(out_csv, index=False, encoding="utf-8-sig")
print("saved:", out_csv)

