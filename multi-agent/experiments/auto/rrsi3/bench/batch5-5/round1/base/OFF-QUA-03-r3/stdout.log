.read_csv(CTX)\nsrc = pd.read_csv(SRC)\nsrc["month"] = src["month"].astype(str)\nctx["month"] = ctx["month"].astype(str)\n\n# 24-month average return rate per (region, product_line) from the full source file\navg_rr = (src.groupby(["region", "product_line"])["return_rate"].mean()\n            .rename("avg_return_rate_24m").reset_index())\n\nrows = []\nfor (region, pl), g in ctx.groupby(["region", "product_line"]):\n    g = g.sort_values("month").reset_index(drop=True)\n    anom = g[g["is_anomaly_month"]].iloc[0]\n    before = g[g["month"] < anom["month"]].tail(3)\n    after = g[g["month"] > anom["month"]].head(3)\n\n    # (i) sustained uptrend check on the 3 months before the spike\n    b_units = before["units"].tolist()\n    monotonic = all(b_units[i] <= b_units[i + 1] for i in range(len(b_units) - 1))\n    prev_ratio = before["ratio"].iloc[-1] if len(before) and pd.notna(before["ratio"].iloc[-1]) else None\n    # fallback: if rolling mean is NaN in context (only last month has it), approximate\n    # baseline with the mean of the 3 pre-spike months\n    if prev_ratio is None:\n        prev_ratio = b_units[-1] / (sum(b_units) / len(b_units)) if b_units else None\n    sustained = monotonic and (prev_ratio is not None and prev_ratio >= 1.05)\n\n    # (ii) return-rate test vs 24-month average for this combo\n    base_rr = avg_rr[(avg_rr["region"] == region) & (avg_rr["product_line"] == pl)]["avg_return_rate_24m"].iloc[0]\n    spike_rr = anom["return_rate"]\n    rr_high = (spike_rr > 1.5 * base_rr) and ((spike_rr - base_rr) >= 0.005)\n\n    if sustained and not rr_high:\n        cls = "likely real demand"\n        reason = (f"前3个月销量单调爬升（{b_units[0]}→{b_units[1]}→{b_units[2]}）且异常月退货率 "\n                  f"{spike_rr:.2%} 低于/接近该组合24个月平均退货率 {base_rr:.2%}，"\n                  f"属持续上行趋势中的年末放量，符合真实需求特征。")\n    elif (not sustained) and rr_high:\n        cls = "likely channel stuffing"\n        reason = (f"放量孤立（前3个月未持续高于基线）且异常月退货率 {spike_rr:.2%} 显著高于 "\n                  f"24个月平均 {base_rr:.2%}，符合渠道压货特征。")\n    elif sustained and rr_high:\n        cls = "mixed (needs review)"\n        reason = (f"销量呈持续上行趋势，但异常月退货率 {spike_rr:.2%} 显著高于24个月平均 "\n                  f"{base_rr:.2%}，需进一步核查。")\n    else:\n        cls = "likely real demand"\n        reason = (f"放量非孤立脉冲（前3个月销量 {b_units}），且异常月退货率 {spike_rr:.2%} "\n                  f"未显著高于24个月平均 {base_rr:.2%}，更像真实需求。")\n\n    rows.append({\n        "region": region,\n        "product_line": pl,\n        "month": anom["month"],\n        "units": int(anom["units"]),\n        "ratio_vs_24m_mean": round(float(anom["ratio"]), 4),\n        "spike_return_rate": round(float(spike_rr), 6),\n        "avg_return_rate_24m": round(float(base_rr), 6),\n        "return_rate_above_baseline": bool(rr_high),\n        "sustained_uptrend_before_spike": bool(sustained),\n        "classification": cls,\n        "reasoning": reason,\n    })\n\nout = pd.DataFrame(rows).sort_values("ratio_vs_24m_mean", ascending=False).reset_index(drop=True)\nout.to_csv(OUT, index=False, encoding="utf-8-sig")\nprint(out.to_string(index=False))\nprint("\\nSAVED:", OUT)\n'} with error:
