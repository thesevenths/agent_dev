import pandas as pd, numpy as np, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-01-r0\_sandbox"
# find csv
cand = os.path.join(base, "offline_data", "students.csv")
print(os.path.exists(cand))
df = pd.read_csv(cand)
print(len(df))
print(df[["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day","math_score"]].describe().round(3))
print("nulls:", df.isna().sum().sum())

vars_ = ["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day"]
res = []
for v in vars_:
    r = df[v].corr(df["math_score"])  # pearson
    res.append((v, r))
res.sort(key=lambda x: -abs(x[1]))
for v, r in res:
    print(v, round(r, 4), round(abs(r),4))

# extra stats for report
print(df["math_score"].mean().round(2), df["math_score"].std().round(2))
for v in vars_:
    print(v, df[v].mean().round(2), df[v].std().round(2))
# r^2
for v, r in res:
    print(v, "r2=", round(r**2,4))
# t stat
n = len(df)
for v, r in res:
    t = r*np.sqrt((n-2)/(1-r**2))
    print(v, "t=", round(t,3))

