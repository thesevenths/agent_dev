import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high_gt5", False: "low_le5"})
g = df.groupby("group").agg(
    n=("math_score", "size"),
    math_mean=("math_score", "mean"),
    reading_mean=("reading_score", "mean"),
    screen_mean=("screen_hours_per_day", "mean"),
)
print(g)

low = g.loc["low_le5"]; high = g.loc["high_gt5"]
diff_math = high["math_mean"] - low["math_mean"]
diff_read = high["reading_mean"] - low["reading_mean"]

out = {
    "source_file": "offline_data/students.csv",
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "groups": {
        "low_le5": {"n": int(low["n"]), "math_mean": round(low["math_mean"],4), "reading_mean": round(low["reading_mean"],4), "screen_mean": round(low["screen_mean"],4)},
        "high_gt5": {"n": int(high["n"]), "math_mean": round(high["math_mean"],4), "reading_mean": round(high["reading_mean"],4), "screen_mean": round(high["screen_mean"],4)},
    },
    "mean_diff_high_minus_low": {
        "math_score": round(diff_math,4),
        "reading_score": round(diff_read,4),
    },
}
print(json.dumps(out, indent=2, ensure_ascii=False))

