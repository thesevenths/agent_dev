    d = sub[m].diff()
    i = d.abs().idxmax()
    print(f"{m}: max |WoW| = {d[i]:+.4f} at {sub.loc[i,'week']}")

# 2) first week each metric leaves pre-window [min,max] band and stays outside
for m in metrics:
    lo, hi = g1[m].min(), g1[m].max()
    outside = (sub[m] < lo) | (sub[m] > hi)
    # first week that is outside AND all subsequent weeks also outside
    for idx in sub.index[outside]:
        if outside.loc[idx:].all():
            print(f"{m}: pre-band [{lo:.4f},{hi:.4f}], first persistent break at {sub.loc[idx,'week']} (value {sub.loc[idx,m]:.4f})")
            break

# 3) t-test pre vs post
from scipy import stats
for m in metrics:
    t, p = stats.ttest_ind(g1[m], sub[sub.week >= "W37"][m])
    print(f"{m}: t={t:.3f}, p={p:.4f}")

