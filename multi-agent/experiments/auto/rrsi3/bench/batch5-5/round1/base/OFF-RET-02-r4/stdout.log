import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

# W30-W43 detail
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
print(sub.to_string(index=False))

# group means
g1 = sub[sub.week <= "W36"]
g2 = sub[sub.week >= "W37"]
for col in ["retention_d7", "churn_rate", "arpu_usd"]:
    m1, m2 = g1[col].mean(), g2[col].mean()
    print(f"{col}: W30-36 mean={m1:.6f} (n={len(g1)}), W37-43 mean={m2:.6f} (n={len(g2)}), diff={m2-m1:+.6f}, rel={ (m2-m1)/m1*100:+.2f}%")

# per-week deltas to locate breakpoint
sub["d_ret"] = sub.retention_d7.diff()
sub["d_churn"] = sub.churn_rate.diff()
sub["d_arpu"] = sub.arpu_usd.diff()
print("\nPer-week deltas W30-W43:")
print(sub[["week","retention_d7","churn_rate","arpu_usd","d_ret","d_churn","d_arpu"]].to_string(index=False))

