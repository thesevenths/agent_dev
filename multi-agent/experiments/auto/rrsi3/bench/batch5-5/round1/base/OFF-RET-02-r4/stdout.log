import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r4\_sandbox\tmp"

df = pd.read_csv(path)
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy().reset_index(drop=True)

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# ---- per-week table with deltas ----
per = sub[["week"] + metrics].copy()
for m in metrics:
    per[f"{m}_wow"] = per[m].diff()

# ---- group means ----
g1 = sub[sub.week <= "W36"]
g2 = sub[sub.week >= "W37"]
rows = []
for m in metrics:
    m1, m2 = g1[m].mean(), g2[m].mean()
    rows.append({
        "metric": m,
        "W30_W36_mean": m1, "n_pre": len(g1),
        "W37_W43_mean": m2, "n_post": len(g2),
        "delta_post_minus_pre": m2 - m1,
        "rel_change_pct": (m2 - m1) / m1 * 100,
        "ratio_post_over_pre": m2 / m1,
        "std_pre": g1[m].std(ddof=1), "std_post": g2[m].std(ddof=1),
    })
grp = pd.DataFrame(rows)

# ---- breakpoint scoring: z-score of each week's value vs pre-window (W30-W36) ----
bp = sub[["week"] + metrics].copy()
for m in metrics:
    mu, sd = g1[m].mean(), g1[m].std(ddof=1)
    bp[f"{m}_z_vs_pre"] = (bp[m] - mu) / sd
# composite: for retention, drop is bad (negative z); for churn, rise is bad (positive z); for arpu, drop is bad (negative z)
bp["badness"] = (-bp["retention_d7_z_vs_pre"]) + (bp["churn_rate_z_vs_pre"]) + (-bp["arpu_usd_z_vs_pre"])
bp = bp.sort_values("badness", ascending=False)

print("GROUP MEANS:")
print(grp.to_string(index=False))
print("\nPER-WEEK:")
print(per.to_string(index=False))
print("\nBREAKPOINT RANKING (top 5 by composite badness vs pre-window):")
print(bp.head(5).to_string(index=False))

# ---- save intermediate CSVs ----
per_path = f"{out_dir}\\step2_per_week_W30_W43.csv"
grp_path = f"{out_dir}\\step2_group_means.csv"
bp_path  = f"{out_dir}\\step2_breakpoint_ranking.csv"
per.to_csv(per_path, index=False)
grp.to_csv(grp_path, index=False)
bp.to_csv(bp_path, index=False)
print("\nSaved:", per_path, grp_path, bp_path)

