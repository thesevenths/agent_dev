import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r5\_sandbox\tmp\app_metrics_validated.csv"
df = pd.read_csv(path)
assert len(df) == 60 and df[["retention_d7","arpu_usd","churn_rate","cohort_size"]].isna().sum().sum() == 0

# Correlations (Pearson)
r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")
# also Spearman for robustness
s_arpu = df["retention_d7"].corr(df["arpu_usd"], method="spearman")
s_churn = df["retention_d7"].corr(df["churn_rate"], method="spearman")
print("pearson r(retention_d7, arpu_usd) =", r_arpu)
print("pearson r(retention_d7, churn_rate) =", r_churn)
print("spearman r(retention_d7, arpu_usd) =", s_arpu)
print("spearman r(retention_d7, churn_rate) =", s_churn)

# t-stat for pearson
n = len(df)
def t_stat(r, n):
    return r * np.sqrt((n-2)/(1-r**2))
print("t(r_arpu) =", t_stat(r_arpu, n), " t(r_churn) =", t_stat(r_churn, n))

# Median split
med = df["retention_d7"].median()
print("median retention_d7 =", med)
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] < med]
eq = df[df["retention_d7"] == med]
print("rows: high =", len(hi), " low =", len(lo), " equal-to-median =", len(eq))

res = pd.DataFrame({
    "group": ["high_retention_d7", "low_retention_d7"],
    "n_weeks": [len(hi), len(lo)],
    "retention_d7_min": [hi["retention_d7"].min(), lo["retention_d7"].min()],
    "retention_d7_max": [hi["retention_d7"].max(), lo["retention_d7"].max()],
    "arpu_usd_mean": [hi["arpu_usd"].mean(), lo["arpu_usd"].mean()],
    "arpu_usd_median": [hi["arpu_usd"].median(), lo["arpu_usd"].median()],
    "churn_rate_mean": [hi["churn_rate"].mean(), lo["churn_rate"].mean()],
    "cohort_size_sum": [hi["cohort_size"].sum(), lo["cohort_size"].sum()],
})
print(res.to_string(index=False))
print("arpu diff (hi-lo) =", hi["arpu_usd"].mean() - lo["arpu_usd"].mean())
print("arpu ratio hi/lo =", hi["arpu_usd"].mean() / lo["arpu_usd"].mean())
print("churn diff (hi-lo) =", hi["churn_rate"].mean() - lo["churn_rate"].mean())
print("cohort total =", df["cohort_size"].sum())

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r5\_sandbox\tmp\step2_results.csv"
with open(out, "w", encoding="utf-8") as f:
    f.write("metric,value,note\n")
    f.write(f"pearson_r_retention_d7_arpu_usd,{r_arpu:.6f},n=60\n")
    f.write(f"pearson_r_retention_d7_churn_rate,{r_churn:.6f},n=60\n")
    f.write(f"spearman_r_retention_d7_arpu_usd,{s_arpu:.6f},n=60\n")
    f.write(f"spearman_r_retention_d7_churn_rate,{s_churn:.6f},n=60\n")
    f.write(f"retention_d7_median,{med:.5f},n=60\n")
    f.write(f"t_stat_r_arpu,{t_stat(r_arpu,n):.4f},n=60\n")
    f.write(f"t_stat_r_churn,{t_stat(r_churn,n):.4f},n=60\n")
    res.to_csv(f, index=False, mode="a", header=False)
print("saved:", out)

