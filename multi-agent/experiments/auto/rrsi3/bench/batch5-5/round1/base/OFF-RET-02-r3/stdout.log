```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r3\_sandbox\tmp"

df = pd.read_csv(src)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# Group assignment
def grp(w):
    n = int(w[1:])
    if 30 <= n <= 36: return 'W30-W36'
    if 37 <= n <= 43: return 'W37-W43'
    return None

sub = df[(df['week'] >= 'W30') & (df['week'] <= 'W43')].copy()
sub['group'] = sub['week'].map(grp)
assert sub['group'].notna().all() and len(sub) == 14

# Per-week table with group labels
per_week = sub[['week', 'group'] + metrics].copy()

# Group means
means = sub.groupby('group')[metrics].mean().reset_index()
counts = sub.groupby('group').size().rename('n').reset_index()
means = means.merge(counts, on='group')

# Differences (after - before) and relative change
before = means[means['group'] == 'W30-W36'].iloc[0]
after  = means[means['group'] == 'W37-W43'].iloc[0]
diff_rows = []
for m in metrics:
    b, a = before[m], after[m]
    diff_rows.append({
        'metric': m,
        'mean_W30_W36': round(b, 6),
        'mean_W37_W43': round(a, 6),
        'abs_diff_after_minus_before': round(a - b, 6),
        'rel_change_pct': round((a - b) / b * 100, 4),
    })
diff = pd.DataFrame(diff_rows)

# Breakpoint pinpoint: week-over-week change within W30-W43
pw = per_week.copy()
for m in metrics:
    pw[f'{m}_wow'] = pw[m].diff()

print("=== GROUP MEANS ===")
print(means.to_string(index=False))
print("\n=== DIFFS ===")
print(diff.to_string(index=False))
print("\n=== PER-WEEK W30-W43 ===")
print(pw.to_string(index=False))

# Save intermediate CSVs
per_week.to_csv(f"{out_dir}\\step2_per_week_W30_W43.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
diff.to_csv(f"{out_dir}\\step2_group_diffs.csv", index=False)
print("\nSaved 3 CSVs to", out_dir)

```
