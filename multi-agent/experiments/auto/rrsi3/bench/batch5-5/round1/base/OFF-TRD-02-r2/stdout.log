import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
print(df.shape)
print(df.dtypes)

g = df.groupby("product_line").agg(
    total_units=("units", "sum"),
    total_revenue=("revenue", "sum"),
    rows=("revenue", "size"),
).reset_index()
g["avg_unit_price"] = g["total_revenue"] / g["total_units"]
g["revenue_share"] = g["total_revenue"] / g["total_revenue"].sum() * 100
g = g.sort_values("total_revenue", ascending=False)
print(g.to_string(index=False))
print("grand total revenue:", df["revenue"].sum())
print("grand total units:", df["units"].sum())
print("months:", df["month"].min(), df["month"].max(), "regions:", sorted(df["region"].unique()))

out = g.copy()
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-02-r2\_sandbox\tmp\product_line_summary.csv", index=False)
print("saved")

