import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r1\_sandbox"
# find the csv
cand = os.path.join(base, "offline_data", "students.csv")
print(os.path.exists(cand))
df = pd.read_csv(cand)
print(df.shape, df.columns.tolist())
print(df[['grade','region']].drop_duplicates().sort_values(['grade','region']).to_string())
print("nulls:", df[['grade','region','reading_score']].isna().sum().to_dict())

g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g['mean'] = g['mean'].round(2)
print(g.to_string())
imax = g['mean'].idxmax(); imin = g['mean'].idxmin()
print("MAX:", g.loc[imax].to_dict())
print("MIN:", g.loc[imin].to_dict())
print("total rows:", len(df))
# grade/region marginals
print(df['grade'].value_counts().to_dict())
print(df['region'].value_counts().to_dict())
print("overall mean:", round(df['reading_score'].mean(),2))
# save pivot tables for report
g.to_csv(os.path.join(base, "tmp", "crosstab.csv"), index=False)
print("saved crosstab")

