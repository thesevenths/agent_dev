piv_m = g.pivot(index='grade', columns='region', values='mean')
order = ['A','B','C','D']
piv_n = piv_n[order]; piv_m = piv_m[order]
print(piv_n.to_string()); print(piv_m.to_string())

# grade & region marginals
gm = df.groupby('grade')['reading_score'].agg(['count','mean'])
rm = df.groupby('region')['reading_score'].agg(['count','mean'])
gm['mean']=gm['mean'].round(2); rm['mean']=rm['mean'].round(2)
print(gm.to_string()); print(rm.to_string())

imax = g['mean'].idxmax(); imin = g['mean'].idxmin()
mx = g.loc[imax]; mn = g.loc[imin]
diff = round(mx['mean'] - mn['mean'], 2)
print("diff:", diff)

# build report
def src_count(cell_n):
