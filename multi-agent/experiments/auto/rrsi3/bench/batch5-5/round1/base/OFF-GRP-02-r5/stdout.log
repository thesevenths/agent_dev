```python
import pandas as pd
from pathlib import Path

df = pd.read_csv("offline_data/students.csv")

# Cross-tab counts
counts = df.groupby(["grade", "region"]).size().unstack(fill_value=0)
counts = counts.reindex(index=["G10","G11","G12"], columns=["A","B","C","D"])

# Means
means = df.groupby(["grade", "region"])["reading_score"].mean().unstack()
means = means.reindex(index=["G10","G11","G12"], columns=["A","B","C","D"])

print("COUNTS:\n", counts)
print("\nMEANS:\n", means.round(4))

# flat for max/min
flat = df.groupby(["grade","region"])["reading_score"].agg(["count","mean"]).reset_index()
print("\nFLAT:\n", flat)
mx = flat.loc[flat["mean"].idxmax()]
mn = flat.loc[flat["mean"].idxmin()]
print("MAX:", mx)
print("MIN:", mn)
print("overall mean:", df["reading_score"].mean())

# Save inspection summary
out_dir = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r5\_sandbox\tmp")
out_dir.mkdir(parents=True, exist_ok=True)
out = out_dir / "step1_inspection_summary.txt"
lines = []
lines.append("Step 1: Load & inspect offline_data/students.csv")
lines.append(f"AS_OF: 2026-10-25 15:00 (local file, static offline data)")
lines.append(f"shape: {df.shape[0]} rows x {df.shape[1]} columns")
lines.append(f"columns: {list(df.columns)}")
lines.append(f"missing values per column: {df.isna().sum().to_dict()}")
lines.append(f"grade values: {sorted(df['grade'].unique())}")
lines.append(f"region values: {sorted(df['region'].unique())}")
lines.append(f"reading_score overall: count={len(df)}, mean={df['reading_score'].mean():.4f}, min={df['reading_score'].min()}, max={df['reading_score'].max()}")
lines.append("")
lines.append("grade x region counts:\n" + counts.to_string())
lines.append("")
lines.append("grade x region reading_score means:\n" + means.round(4).to_string())
lines.append("")
lines.append(f"MAX mean combo: grade={mx['grade']}, region={mx['region']}, mean={mx['mean']:.4f}, n={int(mx['count'])}")
lines.append(f"MIN mean combo: grade={mn['grade']}, region={mn['region']}, mean={mn['mean']:.4f}, n={int(mn['count'])}")
out.write_text("\n".join(lines), encoding="utf-8")
print("\nSaved:", out.resolve())

```
