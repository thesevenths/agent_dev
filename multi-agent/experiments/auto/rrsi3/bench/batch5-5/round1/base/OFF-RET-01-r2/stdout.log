                "min": float(first30.min()), "max": float(first30.max())},
    "last30": {"weeks": "W31-W60", "n": int(len(last30)),
               "mean": float(last30.mean()), "std_sample": float(last30.std(ddof=1)),
               "std_pop": float(last30.std(ddof=0)),
               "min": float(last30.min()), "max": float(last30.max())},
    "overall": {"n": int(len(r)),
                "mean": float(r.mean()), "std_sample": float(r.std(ddof=1)),
                "std_pop": float(r.std(ddof=0)),
                "min": float(r.min()), "max": float(r.max())},
}
stats["diff_mean_last_minus_first"] = stats["last30"]["mean"] - stats["first30"]["mean"]
stats["diff_mean_first_minus_last"] = stats["first30"]["mean"] - stats["last30"]["mean"]

# threshold with sample std (ddof=1)
thr = stats["overall"]["mean"] - 2*stats["overall"]["std_sample"]
below = df[r < thr]
stats["threshold_mean_minus_2std_sample"] = float(thr)
stats["weeks_below_threshold"] = int(len(below))
stats["weeks_below_threshold_list"] = below["week"].tolist()
stats["weeks_below_threshold_values"] = {w: float(v) for w, v in zip(below["week"], below["retention_d7"])}

# also with population std for reference
thr_pop = stats["overall"]["mean"] - 2*stats["overall"]["std_pop"]
below_pop = df[r < thr_pop]
stats["threshold_mean_minus_2std_pop"] = float(thr_pop)
stats["weeks_below_threshold_pop"] = int(len(below_pop))
stats["weeks_below_threshold_pop_list"] = below_pop["week"].tolist()

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-01-r2\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)

print(json.dumps(stats, ensure_ascii=False, indent=2))
print("\nsaved:", out)

