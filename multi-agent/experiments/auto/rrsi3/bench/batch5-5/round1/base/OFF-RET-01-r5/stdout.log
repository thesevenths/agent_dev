import pandas as pd, json, os

df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
first = r.iloc[:30]; last = r.iloc[30:]
overall_mean = r.mean(); overall_std = r.std(ddof=1)
thr = overall_mean - 2*overall_std
below = (r < thr).sum()
below_weeks = df.loc[r < thr, 'week'].tolist()

res = {
  "source": "offline_data/app_metrics.csv",
  "column": "retention_d7",
  "n_total": len(r),
  "first30": {"weeks": "W01-W30", "mean": first.mean(), "std": first.std(ddof=1), "min": first.min(), "max": first.max()},
  "last30": {"weeks": "W31-W60", "mean": last.mean(), "std": last.std(ddof=1), "min": last.min(), "max": last.max()},
  "diff_mean_last_minus_first": last.mean() - first.mean(),
  "overall": {"mean": overall_mean, "std": overall_std, "min": r.min(), "max": r.max()},
  "threshold_mean_minus_2std": thr,
  "weeks_below_threshold": int(below),
  "weeks_below_list": below_weeks,
}
out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-01-r5\_sandbox\tmp\retention_d7_stats.json'
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, 'w', encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print('saved:', out)

