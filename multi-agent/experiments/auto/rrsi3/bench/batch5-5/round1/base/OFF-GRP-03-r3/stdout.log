```python
import pandas as pd, os, json

path = "offline_data/students.csv"
df = pd.read_csv(path)

def grp(h):
    if h < 2.5: return "low"
    if h <= 4.5: return "mid"
    return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(n=("math_score","size"),
                            mean_math=("math_score","mean"),
                            std_math=("math_score","std"),
                            min_math=("math_score","min"),
                            max_math=("math_score","max"),
                            mean_hours=("study_hours_per_week","mean"))
print(g)
print("boundary check: values in [2.5,4.5] count:", ((df.study_hours_per_week>=2.5)&(df.study_hours_per_week<=4.5)).sum())
print("dup student_id:", df.student_id.duplicated().sum())

out = {
  "file": path,
  "shape": list(df.shape),
  "columns": list(df.columns),
  "missing": {c:int(v) for c,v in df.isna().sum().items()},
  "study_hours": {"min":float(df.study_hours_per_week.min()),"max":float(df.study_hours_per_week.max()),"mean":float(df.study_hours_per_week.mean())},
  "math_score": {"min":int(df.math_score.min()),"max":int(df.math_score.max()),"mean":float(df.math_score.mean())},
  "groups": {k:{"n":int(r.n),"mean_math":round(r.mean_math,4),"std_math":round(r.std_math,4),"min_math":int(r.min_math),"max_math":int(r.max_math),"mean_hours":round(r.mean_hours,4)} for k,r in g.iterrows()},
  "gain_low_to_high": round(g.loc["high","mean_math"]-g.loc["low","mean_math"],4),
  "dup_student_id": int(df.student_id.duplicated().sum()),
}
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r3\_sandbox\tmp"
os.makedirs(outdir, exist_ok=True)
with open(os.path.join(outdir,"step1_validation.json"),"w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print("saved:", os.path.join(outdir,"step1_validation.json"))

