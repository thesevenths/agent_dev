    if h <= 4.5: return "mid"
    return "high"
df["group"] = df["study_hours_per_week"].apply(grp)

g = df.groupby("group").agg(
    n=("math_score","size"),
    math_score_mean=("math_score","mean"),
    math_score_std=("math_score","std"),
    math_score_min=("math_score","min"),
    math_score_max=("math_score","max"),
    study_hours_mean=("study_hours_per_week","mean"),
    study_hours_min=("study_hours_per_week","min"),
    study_hours_max=("study_hours_per_week","max"),
).reindex(["low","mid","high"])
g["math_score_mean"] = g["math_score_mean"].round(4)
g["math_score_std"] = g["math_score_std"].round(4)
g["study_hours_mean"] = g["study_hours_mean"].round(4)

gain = g.loc["high","math_score_mean"] - g.loc["low","math_score_mean"]
gain_pct = gain / g.loc["low","math_score_mean"] * 100

rows = g.reset_index().to_dict("records")
summary = {
  "as_of": "2026-10-26 09:06",
  "source_file": "offline_data/students.csv",
  "total_rows": int(len(df)),
  "groups": rows,
  "gain_low_to_high": {"points": round(gain,4), "pct_of_low_mean": round(gain_pct,4)},
  "gain_mid_to_high": {"points": round(g.loc["high","math_score_mean"]-g.loc["mid","math_score_mean"],4)},
  "gain_low_to_mid": {"points": round(g.loc["mid","math_score_mean"]-g.loc["low","math_score_mean"],4)},
}
out_csv = os.path.join(outdir,"step2_group_stats.csv")
g.reset_index().to_csv(out_csv, index=False, encoding="utf-8-sig")
with open(os.path.join(outdir,"step2_group_stats.json"),"w",encoding="utf-8") as f:
    json.dump(summary,f,ensure_ascii=False,indent=2)
print(g)
print("gain:", summary["gain_low_to_high"])
print("saved:", out_csv)

