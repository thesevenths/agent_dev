import pandas as pd, numpy as np, os

df = pd.read_csv('offline_data/students.csv')
cols = ['study_hours_per_week','sleep_hours_per_night','attendance_pct','screen_hours_per_day']
print(df[cols+['math_score']].describe())
print("nulls:", df[cols+['math_score']].isna().sum().sum())

rows=[]
for c in cols:
    r = df[c].corr(df['math_score'], method='pearson')
    rows.append((c, r))
rows.sort(key=lambda x: -abs(x[1]))
for c,r in rows: print(c, r)

# extra stats
print(df['math_score'].mean(), df['math_score'].std(ddof=1))
for c in cols:
    print(c, df[c].mean(), df[c].std(ddof=1), df[c].min(), df[c].max())
# r^2
for c,r in rows: print(c, r**2)
# n
print(len(df))
# t-stat for significance
n=len(df)
for c,r in rows:
    t = r*np.sqrt((n-2)/(1-r*r))
    print(c, t)

```
