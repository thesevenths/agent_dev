```python
import pandas as pd, numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)

r_d7 = df["retention_d7"]
arpu = df["arpu_usd"]
churn = df["churn_rate"]

corr_arpu = r_d7.corr(arpu, method="pearson")
corr_churn = r_d7.corr(churn, method="pearson")

med = r_d7.median()
high = df[r_d7 > med]
low = df[r_d7 <= med]

res = pd.DataFrame([
    {"metric": "n_rows", "value": n},
    {"metric": "retention_d7_median", "value": med},
    {"metric": "pearson_retention_d7_vs_arpu_usd", "value": corr_arpu},
    {"metric": "pearson_retention_d7_vs_churn_rate", "value": corr_churn},
    {"metric": "high_group_n", "value": len(high)},
    {"metric": "high_group_arpu_usd_mean", "value": high["arpu_usd"].mean()},
    {"metric": "high_group_cohort_size_sum", "value": int(high["cohort_size"].sum())},
    {"metric": "low_group_n", "value": len(low)},
    {"metric": "low_group_arpu_usd_mean", "value": low["arpu_usd"].mean()},
    {"metric": "low_group_cohort_size_sum", "value": int(low["cohort_size"].sum())},
])
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r3\_sandbox\tmp\step2_results.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

```
