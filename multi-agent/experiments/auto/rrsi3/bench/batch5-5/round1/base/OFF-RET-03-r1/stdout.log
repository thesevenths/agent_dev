    {"metric": "corr_retention_d7_churn_rate", "value": r_churn, "n": n, "note": "Pearson corr, n=60"},
    {"metric": "high_group_n", "value": len(hi), "n": len(hi), "note": "retention_d7 > median"},
    {"metric": "low_group_n", "value": len(lo), "n": len(lo), "note": "retention_d7 <= median"},
    {"metric": "high_group_arpu_mean", "value": hi["arpu_usd"].mean(), "n": len(hi), "note": "mean arpu_usd, retention_d7 > median"},
    {"metric": "low_group_arpu_mean", "value": lo["arpu_usd"].mean(), "n": len(lo), "note": "mean arpu_usd, retention_d7 <= median"},
    {"metric": "high_group_cohort_sum", "value": int(hi["cohort_size"].sum()), "n": len(hi), "note": "sum cohort_size, retention_d7 > median"},
    {"metric": "low_group_cohort_sum", "value": int(lo["cohort_size"].sum()), "n": len(lo), "note": "sum cohort_size, retention_d7 <= median"},
]
res = pd.DataFrame(rows)
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r1\_sandbox\tmp"
out = os.path.join(out_dir, "step2_results.csv")
