import pandas as pd, os

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)
med = df["retention_d7"].median()
r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]
hi_arpu, lo_arpu = hi["arpu_usd"].mean(), lo["arpu_usd"].mean()
hi_coh, lo_coh = int(hi["cohort_size"].sum()), int(lo["cohort_size"].sum())
total_coh = int(df["cohort_size"].sum())
arpu_diff = hi_arpu - lo_arpu
arpu_ratio = hi_arpu / lo_arpu
hi_share = hi_coh / total_coh

