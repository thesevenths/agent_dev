import pandas as pd, json

df = pd.read_csv('offline_data/students.csv')
g = df.groupby('tutoring')['math_score'].agg(n='count', mean='mean', std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,'n']), int(g.loc[1,'n'])
m0, m1 = g.loc[0,'mean'], g.loc[1,'mean']
s0, s1 = g.loc[0,'std'], g.loc[1,'std']
mean_diff = m1 - m0
pooled_std = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2) ** 0.5
d = mean_diff / pooled_std
print("mean_diff:", mean_diff)
print("pooled_std:", pooled_std)
print("cohen_d:", d)

out = {
  "as_of": "2026-10-26 09:51",
  "source_file": "offline_data/students.csv",
  "groups": {
    "tutoring_0": {"n": n0, "mean": round(m0,4), "std": round(s0,4)},
    "tutoring_1": {"n": n1, "mean": round(m1,4), "std": round(s1,4)}
  },
  "mean_diff_t1_minus_t0": round(mean_diff,4),
  "pooled_std": round(pooled_std,4),
  "cohens_d": round(d,4),
  "effect_size_classification": "small" if abs(d)<0.5 else ("medium" if abs(d)<0.8 else "large"),
  "notes": "std uses sample std (ddof=1); pooled_std = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); cohens_d = mean_diff/pooled_std; classification thresholds: |d|<0.5 small, 0.5<=|d|<0.8 medium, |d|>=0.8 large"
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-01-r0\_sandbox\tmp\step2_group_stats.json"
with open(path, "w", encoding="utf-8") as f:
