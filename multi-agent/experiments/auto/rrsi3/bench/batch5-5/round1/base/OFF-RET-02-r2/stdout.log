import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r2\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r2\_sandbox\tmp\step2_group_means.csv"

df = pd.read_csv(src)
w = df[df['week'].between('W30','W43')].copy()
w['group'] = w['week'].apply(lambda x: 'W30-W36' if x <= 'W36' else 'W37-W43')

metrics = ['retention_d7','churn_rate','arpu_usd']

# per-week table
perweek = w[['week','group'] + metrics].copy()

# group means
means = w.groupby('group')[metrics].mean().reset_index()
means.columns = ['group'] + [f'{m}_mean' for m in metrics]

# diff: post - pre
pre = means[means['group']=='W30-W36'].iloc[0]
post = means[means['group']=='W37-W43'].iloc[0]
diff = pd.DataFrame({
    'metric': metrics,
    'W30-W36_mean': [pre[f'{m}_mean'] for m in metrics],
    'W37-W43_mean': [post[f'{m}_mean'] for m in metrics],
    'abs_diff(post-pre)': [post[f'{m}_mean']-pre[f'{m}_mean'] for m in metrics],
    'pct_diff': [(post[f'{m}_mean']-pre[f'{m}_mean'])/pre[f'{m}_mean']*100 for m in metrics],
})

# breakpoint detection: week with largest |z| vs W30-W36 mean (using pre-group mean & pooled std)
bp = []
for m in metrics:
    pre_vals = w[w['group']=='W30-W36'][m]
    mu, sd = pre_vals.mean(), pre_vals.std(ddof=1)
    for _, r in w.iterrows():
        z = (r[m]-mu)/sd
        bp.append({'week': r['week'], 'metric': m, 'value': r[m], 'pre_mean': mu, 'pre_std': sd, 'z_score': z})
bp = pd.DataFrame(bp)

# breakpoint week per metric: first week in W37-W43 where |z|>=2 (or max |z|)
bp_summary = []
for m in metrics:
    sub = bp[(bp['metric']==m) & (bp['week']>='W37')]
    first_sig = sub[sub['z_score'].abs()>=2]['week'].iloc[0] if (sub['z_score'].abs()>=2).any() else None
    maxz = sub.loc[sub['z_score'].abs().idxmax()]
    bp_summary.append({'metric': m, 'first_week_|z|>=2': first_sig,
                       'max|z|_week': maxz['week'], 'max|z|': maxz['z_score'].abs()})
bp_summary = pd.DataFrame(bp_summary)

print(perweek.to_string(index=False))
print("\nGROUP MEANS:")
print(means.to_string(index=False))
print("\nDIFF:")
print(diff.to_string(index=False))
print("\nBREAKPOINT SUMMARY:")
print(bp_summary.to_string(index=False))

# save combined intermediate CSV
with pd.ExcelWriter(out.replace('.csv','.xlsx')) as xw:
    pass

