import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r2\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r2\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# W30-W43 window
win = df[df["week"].isin([f"W{i:02d}" for i in range(30, 44)])].copy()
assert len(win) == 14, len(win)
win["group"] = np.where(win["week"].isin([f"W{i:02d}" for i in range(30, 37)]), "W30-W36", "W37-W43")

# Group means
g = win.groupby("group")[metrics].agg(["mean", "std", "min", "max", "count"])
print(g.to_string())

# Per-week table with diffs
win["ret_d7_diff"] = win["retention_d7"].diff()
win["churn_diff"] = win["churn_rate"].diff()
win["arpu_diff"] = win["arpu_usd"].diff()
print("\nPer-week:")
print(win[["week","group","retention_d7","churn_rate","arpu_usd","ret_d7_diff","churn_diff","arpu_diff"]].to_string())

# Group means flat
means = win.groupby("group")[metrics].mean()
print("\nMeans:\n", means.to_string())

# Diffs (after - before)
diff = means.loc["W37-W43"] - means.loc["W30-W36"]
pct = diff / means.loc["W30-W36"] * 100
print("\nDiff (W37-W43 - W30-W36):\n", diff.to_string())
print("\nPct change:\n", pct.to_string())

# Ratios
ratios = means.loc["W37-W43"] / means.loc["W30-W36"]
print("\nRatios (after/before):\n", ratios.to_string())

# Save intermediate CSV
out = win[["week","group","cohort_size","dau","retention_d7","churn_rate","arpu_usd","support_tickets","ret_d7_diff","churn_diff","arpu_diff"]].copy()
out.to_csv(f"{out_dir}\\step2_perweek_window.csv", index=False)

# Save group means CSV
means_out = means.reset_index()
means_out.columns = ["group"] + [f"{m}_mean" for m in metrics]
diff_out = diff.reset_index()
diff_out.insert(0, "group", "W37-W43_minus_W30-W36")
diff_out.columns = ["group"] + [f"{m}_diff" for m in metrics]
pct_out = pct.reset_index()
pct_out.insert(0, "group", "pct_change")
pct_out.columns = ["group"] + [f"{m}_pct" for m in metrics]
ratio_out = ratios.reset_index()
ratio_out.insert(0, "group", "ratio_after_over_before")
ratio_out.columns = ["group"] + [f"{m}_ratio" for m in metrics]
combined = pd.concat([means_out, diff_out, pct_out, ratio_out], ignore_index=True)
combined.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
print("\nSaved:")
print(f"{out_dir}\\step2_perweek_window.csv")
