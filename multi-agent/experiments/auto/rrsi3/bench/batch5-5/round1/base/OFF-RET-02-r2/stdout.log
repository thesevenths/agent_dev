import pandas as pd
src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r2\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(src)
w = df[df['week'].between('W30','W43')].copy()
w['group'] = w['week'].apply(lambda x: 'W30-W36' if x <= 'W36' else 'W37-W43')
for m in ['retention_d7','churn_rate','arpu_usd']:
    pre = w[w['group']=='W30-W36'][m]
    post = w[w['group']=='W37-W43'][m]
    print(m, "pre mean %.6f sd %.6f | post mean %.6f sd %.6f" % (pre.mean(), pre.std(ddof=1), post.mean(), post.std(ddof=1)))
    # t-test
    from scipy import stats
    t, p = stats.ttest_ind(pre, post)
    print("   t=%.4f p=%.6f" % (t,p))

