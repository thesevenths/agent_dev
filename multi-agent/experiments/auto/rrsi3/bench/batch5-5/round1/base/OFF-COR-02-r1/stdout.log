import pandas as pd, json, math
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

res = {}
for col in ["math_score","reading_score"]:
    r, p = stats.pearsonr(df["screen_hours_per_day"], df[col])
    res[col] = {"pearson_r": r, "p_value": p, "n": len(df)}

out = {
  "source_file": "offline_data/students.csv",
  "n_rows": len(df),
  "missing_values": 0,
  "correlations": res,
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r1\_sandbox\tmp\step2_correlations.json"
with open(out_path,"w",encoding="utf-8") as f:
    json.dump(out,f,indent=2,ensure_ascii=False)
print(json.dumps(out,indent=2))
print("saved:", out_path)

