import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
df["group"] = (df["screen_hours_per_day"] > 5).map({True:"high_gt5", False:"low_le5"})

g = df.groupby("group").agg(
    n=("student_id","count"),
    screen_mean=("screen_hours_per_day","mean"),
    math_mean=("math_score","mean"),
    reading_mean=("reading_score","mean"),
    math_std=("math_score","std"),
    reading_std=("reading_score","std"),
)
hi, lo = g.loc["high_gt5"], g.loc["low_le5"]
out = {
  "source_file":"offline_data/students.csv",
  "split_rule":"screen_hours_per_day > 5 vs <= 5",
  "n_total": len(df),
  "groups": {
    "high_gt5": hi.to_dict(),
    "low_le5": lo.to_dict(),
  },
  "mean_diff_high_minus_low": {
    "math_score": hi["math_mean"] - lo["math_mean"],
    "reading_score": hi["reading_mean"] - lo["reading_mean"],
  },
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r1\_sandbox\tmp\step3_group_stats.json"
with open(out_path,"w",encoding="utf-8") as f:
