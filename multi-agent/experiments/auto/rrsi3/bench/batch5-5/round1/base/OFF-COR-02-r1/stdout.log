import pandas as pd, json, math

df = pd.read_csv("offline_data/students.csv")
n = len(df)
x = df["screen_hours_per_day"]; y1 = df["math_score"]; y2 = df["reading_score"]

def corr_stats(x, y):
    r = x.corr(y)  # pearson
    # p-value via t-test
    t = r * math.sqrt((n-2)/(1-r**2))
    # two-sided p using scipy if available
    try:
        from scipy import stats
        p = 2 * stats.t.sf(abs(t), n-2)
    except Exception:
        p = None
    return {"n": n, "pearson_r": r, "t_stat": t, "p_value": p}

res = {
    "screen_vs_math": corr_stats(x, y1),
    "screen_vs_reading": corr_stats(x, y2),
}
print(json.dumps(res, indent=2))

out = {
    "step": "2/4 Compute correlations",
    "source_file": "offline_data/students.csv",
