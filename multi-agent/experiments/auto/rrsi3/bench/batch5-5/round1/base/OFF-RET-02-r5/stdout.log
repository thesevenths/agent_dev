import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].str.match(r'W(3[0-9]|4[0-3])$')].copy()
sub['group'] = np.where(sub['week'] <= 'W36', 'W30-W36', 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# Group means
means = sub.groupby('group')[metrics].mean()
print("=== Group means ===")
print(means.to_string())

# Diffs (after - before) and relative change
diff = means.loc['W37-W43'] - means.loc['W30-W36']
rel = diff / means.loc['W30-W36']
print("\n=== Diff (W37-W43 - W30-W36) ===")
print(diff.to_string())
print("\n=== Relative change ===")
print(rel.to_string())

