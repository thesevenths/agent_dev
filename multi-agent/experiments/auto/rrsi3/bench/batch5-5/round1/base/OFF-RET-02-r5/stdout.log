import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r5\_sandbox\tmp\step2_group_means.csv"

df = pd.read_csv(src)
sub = df[(df.week >= 'W30') & (df.week <= 'W43')].copy()

pre  = sub[sub.week <= 'W36']
post = sub[sub.week >= 'W37']

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
rows = []
for m in metrics:
    a, b = pre[m].mean(), post[m].mean()
    rows.append({
        'metric': m,
        'pre_mean_W30_W36': round(a, 6),
        'post_mean_W37_W43': round(b, 6),
        'abs_diff_post_minus_pre': round(b - a, 6),
        'pct_change': round((b - a) / a * 100, 4),
        'pre_n': len(pre),
        'post_n': len(post),
    })
summary = pd.DataFrame(rows)
print(summary.to_string(index=False))

# per-week table with week-over-week deltas to pinpoint breakpoint
pw = sub[['week','retention_d7','churn_rate','arpu_usd']].copy()
for m in metrics:
    pw[m+'_wow'] = pw[m].diff()
print(pw.to_string(index=False))

# breakpoint detection: largest |WoW| jump in each metric
for m in metrics:
    idx = pw[m+'_wow'].abs().idxmax()
    print(f"{m}: largest |WoW| jump at {pw.loc[idx,'week']} = {pw.loc[idx, m+'_wow']:.4f}")

# save: per-week block + summary block into one CSV
with open(out, 'w', encoding='utf-8-sig') as f:
    f.write("# per-week values W30-W43\n")
    pw.to_csv(f, index=False)
    f.write("\n# group means W30-W36 vs W37-W43\n")
    summary.to_csv(f, index=False)
print("saved:", out)

