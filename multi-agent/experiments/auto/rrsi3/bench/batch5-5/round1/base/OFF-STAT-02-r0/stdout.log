import pandas as pd, json, os
from scipy import stats

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-STAT-02-r0\_sandbox"
out_dir = os.path.join(base, "tmp")
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))

m, r = df["math_score"], df["reading_score"]
n = len(df)

def stats(s):
    mean = s.mean()
    std = s.std(ddof=1)  # sample std
    return dict(mean=float(mean), std_sample=float(std), std_pop=float(s.std(ddof=0)),
                median=float(s.median()), min=int(s.min()), max=int(s.max()),
                cv_sample=float(std/mean), cv_pop=float(s.std(ddof=0)/mean))

ms, rs = stats(m), stats(r)
r_pearson, p = stats.pearsonr(m, r)
r_spearman, _ = stats.spearmanr(m, r)

result = {
    "source_file": "offline_data/students.csv",
    "n_rows": n,
    "n_used": int(df[["math_score","reading_score"]].dropna().shape[0]),
    "nulls": {"math_score": int(m.isna().sum()), "reading_score": int(r.isna().sum())},
    "math_score": ms,
    "reading_score": rs,
    "pearson_r": float(r_pearson),
    "pearson_p": float(p),
    "spearman_rho": float(r_spearman),
    "std_convention": "sample std (ddof=1); population std (ddof=0) also reported",
    "computed_at": "2026-10-26 10:33",
}
out = os.path.join(out_dir, "stats_results.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
