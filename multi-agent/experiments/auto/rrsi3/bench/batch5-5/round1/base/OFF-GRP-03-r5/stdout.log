import pandas as pd, json, os

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r5\_sandbox\tmp"
with open(os.path.join(out, "step1_validation_summary.json"), encoding="utf-8") as f:
    s = json.load(f)

g = s["groups"]
rows = []
for name, label, rng in [("low","低组","<2.5"), ("mid","中组","2.5-4.5"), ("high","高组",">4.5")]:
    d = g[name]
    rows.append({
        "group": name, "group_label": label, "hours_range": rng,
        "n": d["n"],
        "mean_math_score": d["mean_math"],
        "std_math_score": d["std_math"],
        "min_math_score": d["min_math"], "max_math_score": d["max_math"],
        "mean_hours": d["mean_hours"], "min_hours": d["min_hours"], "max_hours": d["max_hours"],
    })
df = pd.DataFrame(rows)

# gain rows
gain = s["gain_high_minus_low"]; ratio = s["ratio_high_over_low"]
df.loc[len(df)] = {"group":"gain_low_to_high","group_label":"低组→高组增益","hours_range":"-",
    "n": None, "mean_math_score": gain, "std_math_score": None,
    "min_math_score": None, "max_math_score": None,
    "mean_hours": ratio, "min_hours": s["welch_t_low_vs_high"], "max_hours": s["welch_p"]}
# rename semantics: put gain in mean_math_score, ratio in mean_hours, t in min_hours, p in max_hours — messy. Better: separate gain table.

# Instead: main table = 3 groups only; gain table separate.
main = df[df.group.isin(["low","mid","high"])].copy()
main_path = os.path.join(out, "step2_group_stats.csv")
main.to_csv(main_path, index=False, encoding="utf-8-sig")

gain_df = pd.DataFrame([{
    "metric": "gain_high_minus_low_points", "value": gain,
    "source": "high.mean_math_score - low.mean_math_score (由前述两行计算)"},
    {"metric": "ratio_high_over_low", "value": ratio,
     "source": "high.mean_math_score / low.mean_math_score (由前述两行计算)"},
    {"metric": "welch_t_high_vs_low", "value": s["welch_t_low_vs_high"],
     "source": "scipy.stats.ttest_ind(equal_var=False), 由前述两行计算"},
    {"metric": "welch_p_value", "value": s["welch_p"],
     "source": "scipy.stats.ttest_ind(equal_var=False), 由前述两行计算"},
    {"metric": "overall_mean_math_score", "value": s["overall_mean_math"],
     "source": "offline_data/students.csv 的 math_score, mean, 400 行"},
    {"metric": "boundary_eq_2.5_count", "value": s["boundary_counts"]["eq_2.5"],
     "source": "offline_data/students.csv 的 study_hours_per_week, ==2.5 计数, 400 行"},
    {"metric": "boundary_eq_4.5_count", "value": s["boundary_counts"]["eq_4.5"],
     "source": "offline_data/students.csv 的 study_hours_per_week, ==4.5 计数, 400 行"},
])
gain_path = os.path.join(out, "step2_gain_estimate.csv")
gain_df.to_csv(gain_path, index=False, encoding="utf-8-sig")

print(main.to_string(index=False))
print()
print(gain_df.to_string(index=False))
print("\nsaved:", main_path)
print("saved:", gain_path)

