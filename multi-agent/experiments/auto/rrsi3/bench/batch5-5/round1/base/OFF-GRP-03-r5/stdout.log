import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r5\_sandbox\tmp"
df = pd.read_csv(path)

def grp(x):
    if x < 2.5: return "low"
    if x <= 4.5: return "mid"
    return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group").agg(n=("math_score","size"),
                            mean_math=("math_score","mean"),
                            std_math=("math_score","std"),
                            min_math=("math_score","min"),
                            max_math=("math_score","max"),
                            mean_hours=("study_hours_per_week","mean"),
                            min_hours=("study_hours_per_week","min"),
                            max_hours=("study_hours_per_week","max"))
print(g.to_string())

# boundary check: values exactly at 2.5 / 4.5
print("count ==2.5:", (df.study_hours_per_week==2.5).sum(), " count ==4.5:", (df.study_hours_per_week==4.5).sum())

# overall
print("overall n:", len(df), "overall mean math:", round(df.math_score.mean(),4))

# t-test low vs high
from scipy import stats
lo = df.loc[df.group=="low","math_score"]; hi = df.loc[df.group=="high","math_score"]
t, p = stats.ttest_ind(hi, lo, equal_var=False)
print("welch t:", round(t,4), "p:", p)
print("gain hi-lo:", round(hi.mean()-lo.mean(),4), "ratio:", round(hi.mean()/lo.mean(),4))

summary = {
 "file": path,
 "n_rows": int(len(df)),
 "n_cols": int(df.shape[1]),
 "columns": list(df.columns),
 "missing_total": int(df.isna().sum().sum()),
 "duplicated_rows": int(df.duplicated().sum()),
 "study_hours": {"min": float(df.study_hours_per_week.min()), "max": float(df.study_hours_per_week.max()), "mean": round(float(df.study_hours_per_week.mean()),4), "nulls": 0},
 "math_score": {"min": int(df.math_score.min()), "max": int(df.math_score.max()), "mean": round(float(df.math_score.mean()),4), "nulls": 0},
 "groups": {k: {"n": int(r.n), "mean_math": round(float(r.mean_math),4), "std_math": round(float(r.std_math),4),
                "min_math": int(r.min_math), "max_math": int(r.max_math),
                "mean_hours": round(float(r.mean_hours),4), "min_hours": float(r.min_hours), "max_hours": float(r.max_hours)}
            for k, r in g.iterrows()},
 "overall_mean_math": round(float(df.math_score.mean()),4),
 "welch_t_low_vs_high": round(float(t),4), "welch_p": float(p),
 "gain_high_minus_low": round(float(hi.mean()-lo.mean()),4),
 "ratio_high_over_low": round(float(hi.mean()/lo.mean()),4),
 "boundary_counts": {"eq_2.5": int((df.study_hours_per_week==2.5).sum()), "eq_4.5": int((df.study_hours_per_week==4.5).sum())},
}
import os
os.makedirs(out, exist_ok=True)
with open(os.path.join(out, "step1_validation_summary.json"), "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("saved:", os.path.join(out, "step1_validation_summary.json"))

```
