```python
import pandas as pd, numpy as np, json

df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
first = r.iloc[:30]
last = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
first_mean, first_std = first.mean(), first.std(ddof=1)
last_mean, last_std = last.mean(), last.std(ddof=1)
diff = last_mean - first_mean
threshold = overall_mean - 2*overall_std
below = r[r < threshold]
res = dict(
    n=len(r),
    first_mean=first_mean, first_std=first_std,
    last_mean=last_mean, last_std=last_std,
    diff=diff,
    overall_mean=overall_mean, overall_std=overall_std,
    threshold=threshold,
    below_count=len(below),
    below_weeks=below.index.tolist(),
    below_vals=below.tolist(),
    first_min=first.min(), first_max=first.max(),
    last_min=last.min(), last_max=last.max(),
    overall_min=r.min(), overall_max=r.max(),
    overall_median=r.median(),
    first_last_ratio=last_mean/first_mean,
    diff_pct=diff/first_mean*100,
)
print(json.dumps(res, indent=2, default=str))

```
