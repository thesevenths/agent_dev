import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

res = {
  "n_total": int(len(r)),
  "first30": {"weeks": list(df["week"].iloc[:30]), "mean": float(first30.mean()), "std": float(first30.std(ddof=1)), "n": int(len(first30))},
  "last30": {"weeks": list(df["week"].iloc[30:]), "mean": float(last30.mean()), "std": float(last30.std(ddof=1)), "n": int(len(last30))},
  "diff_mean_last_minus_first": float(last30.mean() - first30.mean()),
  "overall_mean": float(overall_mean),
  "overall_std": float(overall_std),
  "threshold": float(threshold),
  "weeks_below_threshold": list(df["week"].iloc[below.index]),
  "values_below_threshold": [round(float(v),4) for v in below.values],
  "count_below_threshold": int(len(below)),
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-01-r3\_sandbox\tmp"
os.makedirs(out, exist_ok=True)
path = os.path.join(out, "retention_d7_stats.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", path)

```
