import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

res = {
  "n_total": len(r),
  "first30": {"weeks": list(df["week"].iloc[:30]), "mean": first30.mean(), "std": first30.std(ddof=1), "n": len(first30)},
  "last30": {"weeks": list(df["week"].iloc[30:]), "mean": last30.mean(), "std": last30.std(ddof=1), "n": len(last30)},
  "diff_mean_last_minus_first": last30.mean() - first30.mean(),
  "overall_mean": overall_mean,
  "overall_std": overall_std,
  "threshold": threshold,
  "weeks_below_threshold": list(below.index.map(lambda i: df["week"].iloc[i])),
  "values_below_threshold": [round(v,4) for v in below.values],
  "count_below_threshold": len(below),
}
