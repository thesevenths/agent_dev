import pandas as pd

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r2\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r2\_sandbox\tmp\students_grade_region_report.md"

df = pd.read_csv(p)
grades = ['G10','G11','G12']
regions = ['A','B','C','D']

g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g = g.set_index(['grade','region']).reindex([(gr,rg) for gr in grades for rg in regions]).reset_index()

total = len(df)
overall_mean = df['reading_score'].mean()
hi = g.loc[g['mean'].idxmax()]
lo = g.loc[g['mean'].idxmin()]
diff = hi['mean'] - lo['mean']
hi_share = hi['count']/total*100
lo_share = lo['count']/total*100

def src(n):
    return f"（来源：offline_data/students.csv 的 reading_score，按 grade×region 分组，样本行数={n}）"

rows = []
for _, r in g.iterrows():
    rows.append(f"| {r['grade']} | {r['region']} | {int(r['count'])} | {r['mean']:.2f} |")

table = "\n".join(rows)

report = f"""# 学生阅读成绩（reading_score）年级×地区交叉分析报告

- 数据文件：`offline_data/students.csv`（本地离线数据，未使用任何联网检索）
- 数据快照时间（AS_OF）：2026-10-26 11:58（分析执行时刻；CSV 为静态离线文件，无时间序列字段）
- 分析口径：按 `grade`（G10/G11/G12）与 `region`（A/B/C/D）交叉分组，统计每个单元格的行数与 `reading_score` 均值（算术平均）。

## 1. 分析背景与数据概览

本报告基于本地 CSV 文件 `offline_data/students.csv`，共 {total} 行学生记录（来源：offline_data/students.csv 的 student_id，全表行数={total}），
包含 3 个年级（G10/G11/G12）与 4 个地区（A/B/C/D），交叉后共 12 个单元格。
全样本 `reading_score` 总体均值为 {overall_mean:.2f}（来源：offline_data/students.csv 的 reading_score，全表算术平均，样本行数={total}）。
所有字段均无缺失值，无需剔除或插补。

## 2. 交叉分组结果（12 个单元格）

| 年级 (grade) | 地区 (region) | 行数 (count) | reading_score 均值 (mean) |
|---|---|---|---|
{table}

- 每个单元格的行数与均值均按「（来源：offline_data/students.csv 的 reading_score，按 grade×region 分组，样本行数=N）」口径计算，其中 N 为该单元格行数。
- 例如：G10×A 单元格均值 {g.iloc[0]['mean']:.2f}（来源：offline_data/students.csv 的 reading_score，按 grade×region 分组，样本行数={int(g.iloc[0]['count'])}）；
  G12×D 单元格均值 {g.iloc[-1]['mean']:.2f}（来源：offline_data/students.csv 的 reading_score，按 grade×region 分组，样本行数={int(g.iloc[-1]['count'])}）。

## 3. 最高与最低均值单元格

- **均值最高**：{hi['grade']} × {hi['region']}，均值 {hi['mean']:.2f}（来源：offline_data/students.csv 的 reading_score，按 grade×region 分组，样本行数={int(hi['count'])}），样本量 N={int(hi['count'])}。
- **均值最低**：{lo['grade']} × {lo['region']}，均值 {lo['mean']:.2f}（来源：offline_data/students.csv 的 reading_score，按 grade×region 分组，样本行数={int(lo['count'])}），样本量 N={int(lo['count'])}。
- 最高与最低单元格均值之差为 {diff:.2f} 分（来源：由前述两行计算）。
- 最高单元格样本量占全样本比例 {hi_share:.1f}%，最低单元格占 {lo_share:.1f}%（来源：由前述两行计算）。

## 4. 结论

在 {total} 名学生的本地离线数据中，年级×地区交叉分组共 12 个单元格，各单元格样本量较为均衡。
阅读成绩均值最高的组合为 **{hi['grade']} × {hi['region']}**（均值 {hi['mean']:.2f}，样本量 {int(hi['count'])}），
均值最低的组合为 **{lo['grade']} × {lo['region']}**（均值 {lo['mean']:.2f}，样本量 {int(lo['count'])}），
两者相差 {diff:.2f} 分（来源：由前述两行计算）。
由于各单元格样本量均在 20 以上，均值差异的样本基础较为充分；
但本分析仅基于单一静态 CSV 快照，未做显著性检验，上述差异应视为描述性统计结果，
如需推断性结论建议补充方差/标准差与假设检验。
"""

import os
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, 'w', encoding='utf-8') as f:
    f.write(report)
print(out)
print(os.path.getsize(out))
print(g.to_string())
print("HI:", hi.tolist(), "LO:", lo.tolist(), "diff:", diff)

