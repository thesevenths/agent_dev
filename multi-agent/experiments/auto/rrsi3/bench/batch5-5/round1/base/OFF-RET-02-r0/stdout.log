import pandas as pd
import numpy as np

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r0\_sandbox\tmp"

df = pd.read_csv(src)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

pre = df[df['week'].isin([f'W{i:02d}' for i in range(30, 37)])]
post = df[df['week'].isin([f'W{i:02d}' for i in range(37, 44)])]

# Group means
means = pd.DataFrame({
    'window': ['W30-W36 (pre)', 'W37-W43 (post)'],
    'n_rows': [len(pre), len(post)],
    'retention_d7_mean': [pre['retention_d7'].mean(), post['retention_d7'].mean()],
    'churn_rate_mean': [pre['churn_rate'].mean(), post['churn_rate'].mean()],
    'arpu_usd_mean': [pre['arpu_usd'].mean(), post['arpu_usd'].mean()],
})
means['retention_d7_delta'] = means['retention_d7_mean'].iloc[1] - means['retention_d7_mean'].iloc[0]
means['churn_rate_delta'] = means['churn_rate_mean'].iloc[1] - means['churn_rate_mean'].iloc[0]
means['arpu_usd_delta'] = means['arpu_usd_mean'].iloc[1] - means['arpu_usd_mean'].iloc[0]
means['retention_d7_rel_pct'] = means['retention_d7_delta'] / means['retention_d7_mean'].iloc[0] * 100
means['churn_rate_rel_pct'] = means['churn_rate_delta'] / means['churn_rate_mean'].iloc[0] * 100
means['arpu_usd_rel_pct'] = means['arpu_usd_delta'] / means['arpu_usd_mean'].iloc[0] * 100

print("=== GROUP MEANS ===")
print(means.to_string(index=False))

# Per-week values W30-W43 with week-over-week deltas
sub = df[df['week'].isin([f'W{i:02d}' for i in range(30, 44)])][['week'] + metrics].reset_index(drop=True)
for m in metrics:
    sub[f'{m}_wow'] = sub[m].diff()
print("\n=== PER-WEEK W30-W43 ===")
print(sub.to_string(index=False))

# Breakpoint detection: largest absolute week-over-week change in each metric
print("\n=== LARGEST WoW JUMP (W30-W43) ===")
for m in metrics:
    idx = sub[f'{m}_wow'].abs().idxmax()
    print(f"{m}: max |WoW| at {sub.loc[idx,'week']} (prev {sub.loc[idx-1,'week']}), delta = {sub.loc[idx, f'{m}_wow']:+.4f}")

# Save intermediate CSV
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_group_means_breakpoint.csv"
with open(out, 'w', encoding='utf-8-sig') as f:
    f.write("# section: group_means\n")
    means.to_csv(f, index=False)
    f.write("\n# section: per_week_W30_W43\n")
    sub.to_csv(f, index=False)
print("\nSaved:", out)

