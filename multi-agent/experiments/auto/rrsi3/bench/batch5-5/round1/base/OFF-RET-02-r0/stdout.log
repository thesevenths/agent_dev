import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(src)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
pre = df[df['week'].isin([f'W{i:02d}' for i in range(30, 37)])]
post = df[df['week'].isin([f'W{i:02d}' for i in range(37, 44)])]

rows = []
for m in metrics:
    p, q = pre[m].mean(), post[m].mean()
    rows.append(dict(metric=m, pre_mean=round(p,6), post_mean=round(q,6),
                     delta=round(q-p,6), rel_pct=round((q-p)/p*100,4),
                     pre_n=7, post_n=7))
means = pd.DataFrame(rows)

sub = df[df['week'].isin([f'W{i:02d}' for i in range(30, 44)])][['week'] + metrics].reset_index(drop=True)
for m in metrics:
    sub[f'{m}_wow'] = sub[m].diff().round(4)

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_group_means_breakpoint.csv"
