import pandas as pd, numpy as np

src = r"E:\agent_dev\multi-agent\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r4\_sandbox\offline_data\app_metrics.csv"
src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r4\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r4\_sandbox\tmp\step2_results.csv"

df = pd.read_csv(src)
n = len(df)

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
med = df["retention_d7"].median()

hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = [
    {"metric": "pearson_corr_retention_d7_vs_arpu_usd", "value": round(r_arpu, 6), "n": n, "note": "Pearson r, all 60 rows"},
    {"metric": "pearson_corr_retention_d7_vs_churn_rate", "value": round(r_churn, 6), "n": n, "note": "Pearson r, all 60 rows"},
    {"metric": "median_retention_d7", "value": round(med, 6), "n": n, "note": "median of retention_d7, 60 rows"},
    {"metric": "group_high_retention_n", "value": len(hi), "n": len(hi), "note": "rows with retention_d7 > median"},
    {"metric": "group_high_retention_mean_arpu_usd", "value": round(hi["arpu_usd"].mean(), 6), "n": len(hi), "note": "mean arpu_usd, retention_d7 > median"},
    {"metric": "group_high_retention_sum_cohort_size", "value": int(hi["cohort_size"].sum()), "n": len(hi), "note": "sum cohort_size, retention_d7 > median"},
    {"metric": "group_low_retention_n", "value": len(lo), "n": len(lo), "note": "rows with retention_d7 <= median"},
    {"metric": "group_low_retention_mean_arpu_usd", "value": round(lo["arpu_usd"].mean(), 6), "n": len(lo), "note": "mean arpu_usd, retention_d7 <= median"},
    {"metric": "group_low_retention_sum_cohort_size", "value": int(lo["cohort_size"].sum()), "n": len(lo), "note": "sum cohort_size, retention_d7 <= median"},
]
res = pd.DataFrame(rows)
