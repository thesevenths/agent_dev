```python
import pandas as pd, numpy as np, json

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r4\_sandbox\tmp"
df = pd.read_csv(p)

# validation
assert df[["retention_d7","arpu_usd","churn_rate","cohort_size"]].notna().all().all()
assert (df["retention_d7"]>0).all() and (df["retention_d7"]<1).all()
assert (df["churn_rate"]>0).all() and (df["churn_rate"]<1).all()
assert (df["arpu_usd"]>0).all()
assert (df["cohort_size"]>0).all()
assert df.duplicated().sum()==0

# correlations
r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
r_spearman_arpu = df["retention_d7"].corr(df["arpu_usd"], method="spearman")
r_spearman_churn = df["retention_d7"].corr(df["churn_rate"], method="spearman")

# median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

stats = {
  "n_rows": int(len(df)),
  "n_cols": int(df.shape[1]),
  "columns": list(df.columns),
  "dtypes": {c: str(t) for c,t in df.dtypes.items()},
  "week_range": [df["week"].min(), df["week"].max()],
  "nulls": int(df.isna().sum().sum()),
  "dups": int(df.duplicated().sum()),
  "retention_d7": {"mean": df["retention_d7"].mean(), "std": df["retention_d7"].std(),
                   "min": df["retention_d7"].min(), "max": df["retention_d7"].max(),
                   "median": med},
  "arpu_usd": {"mean": df["arpu_usd"].mean(), "std": df["arpu_usd"].std(),
               "min": df["arpu_usd"].min(), "max": df["arpu_usd"].max(), "median": df["arpu_usd"].median()},
  "churn_rate": {"mean": df["churn_rate"].mean(), "std": df["churn_rate"].std(),
                 "min": df["churn_rate"].min(), "max": df["churn_rate"].max(), "median": df["churn_rate"].median()},
  "cohort_size": {"mean": df["cohort_size"].mean(), "sum": int(df["cohort_size"].sum()),
                  "min": int(df["cohort_size"].min()), "max": int(df["cohort_size"].max())},
  "corr_retention_arpu_pearson": r_arpu,
  "corr_retention_churn_pearson": r_churn,
  "corr_retention_arpu_spearman": r_spearman_arpu,
  "corr_retention_churn_spearman": r_spearman_churn,
  "median_retention_d7": med,
  "group_high": {"n": int(len(hi)), "arpu_mean": hi["arpu_usd"].mean(), "cohort_sum": int(hi["cohort_size"].sum()),
                 "retention_mean": hi["retention_d7"].mean(), "churn_mean": hi["churn_rate"].mean(),
                 "weeks": [hi["week"].min(), hi["week"].max()]},
  "group_low": {"n": int(len(lo)), "arpu_mean": lo["arpu_usd"].mean(), "cohort_sum": int(lo["cohort_size"].sum()),
                "retention_mean": lo["retention_d7"].mean(), "churn_mean": lo["churn_rate"].mean(),
                "weeks": [lo["week"].min(), lo["week"].max()]},
}
stats["arpu_gap"] = stats["group_high"]["arpu_mean"] - stats["group_low"]["arpu_mean"]
stats["arpu_gap_pct"] = stats["arpu_gap"]/stats["group_low"]["arpu_mean"]

# save cleaned copy + stats
clean = df.copy()
clean.to_csv(out_dir + r"\app_metrics_clean.csv", index=False)
with open(out_dir + r"\exploration_stats.json","w",encoding="utf-8") as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)

print(json.dumps(stats, ensure_ascii=False, indent=2))

```
