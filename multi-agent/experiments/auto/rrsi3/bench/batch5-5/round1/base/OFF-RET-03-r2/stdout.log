import pandas as pd, numpy as np, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r2\_sandbox"
csv = os.path.join(base, "offline_data", "app_metrics.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv)
n = len(df)

r_arpu = df["retention_d7"].corr(df["arpu_usd"], method="pearson")
r_churn = df["retention_d7"].corr(df["churn_rate"], method="pearson")
med = df["retention_d7"].median()

hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = [
    {"metric": "pearson_corr_retention_d7_vs_arpu_usd", "value": round(r_arpu, 6), "n": n, "note": "60行周度数据, Pearson"},
    {"metric": "pearson_corr_retention_d7_vs_churn_rate", "value": round(r_churn, 6), "n": n, "note": "60行周度数据, Pearson"},
    {"metric": "retention_d7_median", "value": round(med, 6), "n": n, "note": "60行中位数, 分组阈值"},
    {"metric": "group_high_arpu_usd_mean", "value": round(hi["arpu_usd"].mean(), 6), "n": len(hi), "note": "retention_d7 > 中位数"},
    {"metric": "group_high_cohort_size_sum", "value": int(hi["cohort_size"].sum()), "n": len(hi), "note": "retention_d7 > 中位数"},
    {"metric": "group_low_arpu_usd_mean", "value": round(lo["arpu_usd"].mean(), 6), "n": len(lo), "note": "retention_d7 <= 中位数"},
    {"metric": "group_low_cohort_size_sum", "value": int(lo["cohort_size"].sum()), "n": len(lo), "note": "retention_d7 <= 中位数"},
]
res = pd.DataFrame(rows)
out = os.path.join(out_dir, "step2_results.csv")
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("SAVED:", out)

