import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
out  = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-03-r2\_sandbox\tmp\step2_results.csv"

df = pd.read_csv(path)
n = len(df)
med = df["retention_d7"].median()

r_arpu  = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])

df["group"] = df["retention_d7"].apply(lambda x: "high" if x > med else "low")
g = df.groupby("group").agg(
    n=("week","count"),
    arpu_usd_mean=("arpu_usd","mean"),
    cohort_size_sum=("cohort_size","sum"),
    retention_d7_min=("retention_d7","min"),
    retention_d7_max=("retention_d7","max"),
)
print("median:", med)
print("corr arpu:", r_arpu)
print("corr churn:", r_churn)
print(g)
