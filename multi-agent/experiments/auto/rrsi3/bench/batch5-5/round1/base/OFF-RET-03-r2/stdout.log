    rows.append({"metric":f"cohort_size_sum_{grp}_retention","value":int(row["cohort_size_sum"]),"n":int(row["n"]),"note":f"retention_d7 {'>' if grp=='high' else '<='} median {med}"})
res = pd.DataFrame(rows)
res.to_csv(out, index=False)
print(res.to_string())
print("saved:", out)

