import json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r1\_sandbox"
with open(os.path.join(base, "tmp", "step1_validation.json"), encoding="utf-8") as f:
    d = json.load(f)

grand = d["grand_total"]
rows = []
for r in ["N", "S", "E", "W"]:
    t = d[f"region_{r}"]["total_revenue"]
    share = t / grand * 100
    rows.append((r, t, share, d[f"region_{r}"]["monthly_avg"], d["peak"][r]["month"], d["peak"][r]["value"]))

def fmt(x): return f"{x:,.2f}"

table = """| 区域 | 营收合计（元） | 占总营收比例 | 月均营收（元，24 个月） | 峰值月份 | 峰值月营收（元） |
|---|---|---|---|---|---|"""
for r, t, share, avg, pm, pv in rows:
    table += f"\n| {r} | {fmt(t)}（来源：offline_data/regional_sales.csv 的 revenue 列，region={r} 的 72 行求和，月份 2024-01 至 2025-12） | {share:.2f}%（来源：由前述两行计算，{fmt(t)} ÷ {fmt(grand)}） | {fmt(avg)}（来源：由前述两行计算，{fmt(t)} ÷ 24 个月） | {pm}（来源：offline_data/regional_sales.csv 的 revenue 列，region={r} 按 month 求和后取最大值） | {fmt(pv)}（来源：offline_data/regional_sales.csv 的 revenue 列，region={r} 且 month={pm} 的 3 行求和） |"

report = f"""# 四区域（N/S/E/W）营收对比分析报告

> AS_OF: 2026-10-25 14:33（报告生成时间；数据为离线历史数据，覆盖 2024-01 至 2025-12，非实时数据）

## 一、分析背景与数据说明

本报告基于本地离线数据文件 `offline_data/regional_sales.csv`，对 N、S、E、W 四个区域在 2024-01 至 2025-12 共 24 个月内的营收进行对比分析。数据共 288 行 × 7 列（month、region、product_line、units、unit_price、revenue、returns），每个区域 72 行（24 个月 × 3 条产品线：Hardware、Service、Accessory），无缺失值、无零或负营收记录，且 revenue ≈ units × unit_price（最大偏差约 1e-10，来源：offline_data/regional_sales.csv 的 units、unit_price、revenue 三列，288 行逐行校验）。全部结论仅来自该本地 CSV 文件，未使用任何联网数据。

## 二、数据总览

四区域合计总营收为 {fmt(grand)} 元（来源：offline_data/regional_sales.csv 的 revenue 列，全部 288 行求和）。

## 三、各区域营收对比

{table}

### 3.1 关键观察

- **营收最高区域为 E**：合计 {fmt(rows[2][1])} 元，高于 S（{fmt(rows[1][1])} 元）、N（{fmt(rows[0][1])} 元）与 W（{fmt(rows[3][1])} 元）（来源：由前述各行计算，四区域合计值两两比较）。
- **区域间差异很小**：最高（E）与最低（W）合计营收相差 {fmt(rows[2][1]-rows[3][1])} 元，仅约 {(rows[2][1]-rows[3][1])/rows[3][1]*100:.2f}%（来源：由前述两行计算），四区域占比均在 24.6%~25.3% 区间，分布高度均衡。
- **E 区域峰值月份为 2025-12**，当月营收 {fmt(rows[2][5])} 元，为四区域所有区域-月份组合中的最高单月值（来源：offline_data/regional_sales.csv 的 revenue 列，region=E 且 month=2025-12 的 3 行求和；并与其余三区域峰值行比较）。
- 其余区域峰值：N 为 2025-12（{fmt(rows[0][5])} 元）、S 为 2025-11（{fmt(rows[1][5])} 元）、W 为 2025-12（{fmt(rows[3][5])} 元）（来源：offline_data/regional_sales.csv 的 revenue 列，各 region 按 month 求和后取最大值）。

### 3.2 月均营收

