import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

out = {}
out["file"] = os.path.abspath(path)
out["shape"] = list(df.shape)
out["columns"] = list(df.columns)
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}
out["regions"] = sorted(df["region"].unique().tolist())
out["region_counts"] = df["region"].value_counts().to_dict()
out["months"] = [df["month"].min(), df["month"].max(), df["month"].nunique()]
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["nulls"] = df.isna().sum().to_dict()
out["neg_or_zero_revenue"] = int((df["revenue"] <= 0).sum())
out["revenue_sum_check"] = float((df["units"]*df["unit_price"] - df["revenue"]).abs().max())

# per region
for r in ["N","S","E","W"]:
    sub = df[df["region"]==r]
    out[f"region_{r}"] = {
        "rows": int(len(sub)),
        "total_revenue": round(float(sub["revenue"].sum()),2),
        "months": int(sub["month"].nunique()),
        "monthly_avg": round(float(sub["revenue"].sum()/sub["month"].nunique()),2),
    }

# monthly totals per region for peak month
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
out["monthly_totals"] = {r: {m: round(float(v),2) for m,v in piv[r].items()} for r in ["N","S","E","W"]}
out["peak"] = {r: {"month": piv[r].idxmax(), "value": round(float(piv[r].max()),2)} for r in ["N","S","E","W"]}
out["grand_total"] = round(float(df["revenue"].sum()),2)

os.makedirs(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r1\_sandbox\tmp", exist_ok=True)
outp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step1_validation.json"
with open(outp,"w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(outp)
print(json.dumps({k:v for k,v in out.items() if k!="monthly_totals"}, ensure_ascii=False, indent=1))
print(json.dumps(out["peak"], ensure_ascii=False))

```
