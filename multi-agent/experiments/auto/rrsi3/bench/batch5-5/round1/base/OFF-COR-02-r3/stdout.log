import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"], method="pearson")
r_read = df["screen_hours_per_day"].corr(df["reading_score"], method="pearson")
# significance: t-test for correlation
import math
def corr_p(r, n):
    t = r * math.sqrt((n-2)/(1-r*r))
    return t
t_math = corr_p(r_math, n)
t_read = corr_p(r_read, n)
from scipy import stats
p_math = 2*stats.t.sf(abs(t_math), n-2)
p_read = 2*stats.t.sf(abs(t_read), n-2)
print(json.dumps({
  "n": n,
  "pearson_screen_vs_math": round(r_math, 4),
  "pearson_screen_vs_reading": round(r_read, 4),
  "t_math": round(t_math,3), "p_math": p_math,
  "t_read": round(t_read,3), "p_read": p_read
}, indent=2))

```
