# significance: t-test for correlation
import math
def corr_pvalue(r, n):
    t = r * math.sqrt((n-2)/(1-r*r))
    # two-sided p via scipy if available
    try:
        from scipy import stats
        p = 2 * stats.t.sf(abs(t), n-2)
    except ImportError:
        p = None
    return t, p

t1, p1 = corr_pvalue(corr_math, n)
t2, p2 = corr_pvalue(corr_read, n)

result = {
    "source_file": path,
    "n": n,
    "method": "Pearson",
    "screen_hours_per_day_vs_math_score": {"r": corr_math, "t": t1, "p_two_sided": p1},
