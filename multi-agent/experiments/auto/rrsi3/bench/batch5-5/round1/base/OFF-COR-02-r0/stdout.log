import pandas as pd, json
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
n = len(df)
assert df[["screen_hours_per_day","math_score","reading_score"]].isna().sum().sum() == 0

df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high_gt5", False: "low_le5"})
g = df.groupby("group").agg(
    n=("math_score","size"),
    screen_mean=("screen_hours_per_day","mean"),
    math_mean=("math_score","mean"),
    reading_mean=("reading_score","mean"),
    math_std=("math_score","std"),
    reading_std=("reading_score","std"),
)
print(g)

hi, lo = df[df.group=="high_gt5"], df[df.group=="low_le5"]

# mean differences (high - low)
diff_math = hi.math_score.mean() - lo.math_score.mean()
diff_read = hi.reading_score.mean() - lo.reading_score.mean()

# Welch t-tests
t_math, p_math = stats.ttest_ind(hi.math_score, lo.math_score, equal_var=False)
t_read, p_read = stats.ttest_ind(hi.reading_score, lo.reading_score, equal_var=False)

# Cohen's d (pooled sd)
def cohens_d(a, b):
    na, nb = len(a), len(b)
    va, vb = a.var(ddof=1), b.var(ddof=1)
    sp = math.sqrt(((na-1)*va + (nb-1)*vb) / (na+nb-2))
    return (a.mean()-b.mean())/sp
import math
d_math = cohens_d(hi.math_score, lo.math_score)
d_read = cohens_d(hi.reading_score, lo.reading_score)

result = {
    "source_file": path,
    "n_total": n,
    "split_rule": "high_gt5: screen_hours_per_day > 5; low_le5: screen_hours_per_day <= 5",
    "groups": {
        "high_gt5": {"n": int(g.loc["high_gt5","n"]), "screen_mean": g.loc["high_gt5","screen_mean"],
                     "math_mean": g.loc["high_gt5","math_mean"], "reading_mean": g.loc["high_gt5","reading_mean"],
                     "math_std": g.loc["high_gt5","math_std"], "reading_std": g.loc["high_gt5","reading_std"]},
        "low_le5": {"n": int(g.loc["low_le5","n"]), "screen_mean": g.loc["low_le5","screen_mean"],
                    "math_mean": g.loc["low_le5","math_mean"], "reading_mean": g.loc["low_le5","reading_mean"],
                    "math_std": g.loc["low_le5","math_std"], "reading_std": g.loc["low_le5","reading_std"]},
    },
    "mean_diff_high_minus_low": {
        "math_score": {"diff": diff_math, "welch_t": t_math, "p_two_sided": p_math, "cohens_d": d_math},
        "reading_score": {"diff": diff_read, "welch_t": t_read, "p_two_sided": p_read, "cohens_d": d_read},
    },
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.json"
with open(out,"w",encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

pd.DataFrame([
    {"group":k, "n":result["groups"][k]["n"], "screen_mean":result["groups"][k]["screen_mean"],
     "math_mean":result["groups"][k]["math_mean"], "reading_mean":result["groups"][k]["reading_mean"]}
    for k in ["high_gt5","low_le5"]
]).to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.csv", index=False, encoding="utf-8-sig")

print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

