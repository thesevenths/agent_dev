import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv(src)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]
win = df[df["week"].isin([f"W{i:02d}" for i in range(30, 44)])].copy()
assert len(win) == 14

# group means
pre = win[win["week"].isin([f"W{i:02d}" for i in range(30, 37)])]   # W30-W36
post = win[win["week"].isin([f"W{i:02d}" for i in range(37, 44)])]  # W37-W43

means = pd.DataFrame({
    "group": ["W30-W36 (pre)", "W37-W43 (post)"],
    "n_rows": [len(pre), len(post)],
    "retention_d7_mean": [pre["retention_d7"].mean(), post["retention_d7"].mean()],
    "churn_rate_mean": [pre["churn_rate"].mean(), post["churn_rate"].mean()],
    "arpu_usd_mean": [pre["arpu_usd"].mean(), post["arpu_usd"].mean()],
})
print(means.to_string(index=False))

# deltas
d_ret = post["retention_d7"].mean() - pre["retention_d7"].mean()
d_churn = post["churn_rate"].mean() - pre["churn_rate"].mean()
d_arpu = post["arpu_usd"].mean() - pre["arpu_usd"].mean()
print(f"delta retention_d7: {d_ret:+.4f}  ({d_ret/pre['retention_d7'].mean()*100:+.2f}%)")
print(f"delta churn_rate:   {d_churn:+.4f}  ({d_churn/pre['churn_rate'].mean()*100:+.2f}%)")
print(f"delta arpu_usd:     {d_arpu:+.4f}  ({d_arpu/pre['arpu_usd'].mean()*100:+.2f}%)")

# per-week table with week-over-week deltas
w = win.copy()
for m in metrics:
    w[f"{m}_wow"] = w[m].diff()
print(w.to_string(index=False))

# breakpoint detection: largest single-week drop in retention_d7 / jump in churn_rate
print("\nLargest WoW retention_d7 drop in window:", w.loc[w["retention_d7_wow"].idxmin(), ["week","retention_d7","retention_d7_wow"]].tolist())
print("Largest WoW churn_rate jump in window:", w.loc[w["churn_rate_wow"].idxmax(), ["week","churn_rate","churn_rate_wow"]].tolist())
print("Largest WoW arpu_usd drop in window:", w.loc[w["arpu_usd_wow"].idxmin(), ["week","arpu_usd","arpu_usd_wow"]].tolist())

# save intermediate CSV
out = pd.concat([
    means,
], ignore_index=True)
# also save per-week detail
detail = win[["week"] + metrics].copy()
for m in metrics:
    detail[f"{m}_wow"] = detail[m].diff()

means_path = f"{out_dir}\\step2_group_means.csv"
detail_path = f"{out_dir}\\step2_per_week_detail.csv"
means.to_csv(means_path, index=False)
detail.to_csv(detail_path, index=False)
print("\nsaved:", means_path)
print("saved:", detail_path)

