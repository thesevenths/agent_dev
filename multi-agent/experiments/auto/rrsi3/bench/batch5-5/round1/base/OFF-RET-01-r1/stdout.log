import pandas as pd, json

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-01-r1\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(p)
r = df["retention_d7"]

first = r.iloc[:30]
last = r.iloc[30:]
overall = r

res = {
    "source_file": p,
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {
        "weeks": [df["week"].iloc[0], df["week"].iloc[29]],
        "n": int(len(first)),
        "mean": float(first.mean()),
        "std_ddof1": float(first.std(ddof=1)),
        "std_ddof0": float(first.std(ddof=0)),
        "min": float(first.min()),
        "max": float(first.max()),
    },
    "last30": {
        "weeks": [df["week"].iloc[30], df["week"].iloc[59]],
        "n": int(len(last)),
        "mean": float(last.mean()),
        "std_ddof1": float(last.std(ddof=1)),
        "std_ddof0": float(last.std(ddof=0)),
        "min": float(last.min()),
        "max": float(last.max()),
    },
    "overall60": {
        "n": int(len(overall)),
        "mean": float(overall.mean()),
        "std_ddof1": float(overall.std(ddof=1)),
        "std_ddof0": float(overall.std(ddof=0)),
        "min": float(overall.min()),
        "max": float(overall.max()),
    },
}
res["diff_mean_last_minus_first"] = res["last30"]["mean"] - res["first30"]["mean"]
res["diff_mean_first_minus_last"] = res["first30"]["mean"] - res["last30"]["mean"]
res["threshold_mean_minus_2std_ddof1"] = res["overall60"]["mean"] - 2*res["overall60"]["std_ddof1"]
res["threshold_mean_minus_2std_ddof0"] = res["overall60"]["mean"] - 2*res["overall60"]["std_ddof0"]
res["count_below_mean_minus_2std_ddof1"] = int((overall < res["threshold_mean_minus_2std_ddof1"]).sum())
res["count_below_mean_minus_2std_ddof0"] = int((overall < res["threshold_mean_minus_2std_ddof0"]).sum())
res["weeks_below_ddof1"] = df.loc[overall < res["threshold_mean_minus_2std_ddof1"], "week"].tolist()
res["weeks_below_ddof0"] = df.loc[overall < res["threshold_mean_minus_2std_ddof0"], "week"].tolist()

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-RET-01-r1\_sandbox\tmp\step2_statistics.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

