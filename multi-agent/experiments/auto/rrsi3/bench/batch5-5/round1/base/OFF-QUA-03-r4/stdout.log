\n    ax.axvline(r["month"], color="red", ls=":", alpha=0.7)\n    ax.set_title(f"{r.region} / {r.product_line}\\npeak {r[\'month\']} x{r[\'ratio\']:.2f}", fontsize=9)\n    ax.tick_params(axis="x", rotation=60, labelsize=7)\n    ax.legend(fontsize=7)\nfig.suptitle("Top-3 volume anomalies: monthly units vs 24-month rolling mean")\nfig.tight_layout()\nfig.savefig(os.path.join(CHART_DIR, "top3_units_vs_baseline.png"), dpi=120)\nplt.close(fig)\n\n# ---- Chart 2: return rate of peak month vs combo baseline ----\nfig, ax = plt.subplots(figsize=(7, 4))\nlabels = [f"{r.region}/{r.product_line}\\n{r.month}" for _, r in top3.iterrows()]\npeak_rr = [r["return_rate"] for _, r in top3.iterrows()]\nbase_rr = [rr_base[(r.region, r.product_line)] for _, r in top3.iterrows()]\nx = range(len(top3))\nax.bar([i - 0.2 for i in x], base_rr, width=0.4, label="24m avg return rate", color="steelblue")\nax.bar([i + 0.2 for i in x], peak_rr, width=0.4, label="peak-month return rate", color="crimson")\nax.set_xticks(list(x)); ax.set_xticklabels(labels, fontsize=8)\nax.set_ylabel("return rate (returns/units)")\nax.set_title("Peak-month return rate vs 24-month baseline")\nax.legend(fontsize=8)\nfig.tight_layout()\nfig.savefig(os.path.join(CHART_DIR, "return_rate_peak_vs_base.png"), dpi=120)\nplt.close(fig)\n\n# ---- Build report ----\ndef src_units():\n    return f"（来源：offline_data/regional_sales.csv 的 units 列，按 region×product_line×month 聚合，{N}行）"\n\ndef src_rr():\n    return f"（来源：offline_data/regional_sales.csv 的 returns 列 ÷ units 列，按 region×product_line×month 聚合，{N}行）"\n\ndef src_mean():\n    return f"（来源：offline_data/regional_sales.csv 的 units 列，按 region×product_line 分组取 24 个月滚动均值，{N}行）"\n\nrows = []\nfor i, r in top3.iterrows():\n    base = rr_base[(r.region, r.product_line)]\n    rows.append(\n        f"| {i+1} | {r.region} | {r.product_line} | {r.month} | {r[\'units\']:.0f} {src_units()} "\n        f"| {r[\'mean_24m\']:.1f} {src_mean()} | **{r[\'ratio\']:.4f}**（来源：由前述两行计算） "\n        f"| {r[\'returns\']:.0f} {src_rr()} | {r[\'return_rate\']*100:.2f}% {src_rr()} "\n        f"| {base*100:.2f}%（来源：offline_data/regional_sales.csv 的 returns÷units，按 region×product_line 取 24 个月均值，{N}行） |"\n    )\n\n# per-combo judgment\ndef judge(r):\n    base = rr_base[(r.region, r.product_line)]\n    rr = r["return_rate"]\n    # look-ahead: months after peak\n    sub = rat[(rat.region == r.region) & (rat.product_line == r.product_line)]\n    sub = sub.sort_values("month").reset_index(drop=True)\n    idx = sub.index[sub["month"] == r["month"]][0]\n    after = sub.loc[idx+1: idx+3, "ratio"] if idx + 1 < len(sub) else pd.Series(dtype=float)\n    after_txt = "、".join(f"{v:.2f}" for v in after) if len(after) else "无后续月份"\n    if rr > base * 1.3 and r["ratio"] > 1.5:\n        verdict = "更像**渠道压货**：放量当月退货率显著高于自身 24 个月基线，且倍数高"\n    elif rr < base * 1.1:\n        verdict = "更像**真实需求**：放量当月退货率未高于自身基线，需求端消化正常"\n    else:\n        verdict = "介于两者之间：退货率略高于基线，需结合后续月份回落幅度判断"\n    return verdict, after_txt, base\n\njudgments = []\nfor i, r in top3.iterrows():\n    v, after_txt, base = judge(r)\n    judgments.append((r, v, after_txt, base))\n\nmd = []\nmd.append("# 区域×产品线 单月放量异常分析报告")\nmd.append("")\nmd.append("AS_OF: 2026-10-26 08:55（数据为历史离线 CSV，覆盖 2024-01 至 2025-12，非实时数据）")\nmd.append("")\nmd.append("## 一、分析背景与方法")\nmd.append("")\nmd.append(f"本报告基于本地文件 `offline_data/regional_sales.csv`（共 {N} 行，字段：month、region、product_line、units、unit_price、revenue、returns，时间范围 2024-01 至 2025-12，共 24 个月、12 个 region×product_line 组合）。"\n          f"对每个「区域×产品线」组合，按月份排序后计算其月度销量（units）相对自身 24 个月滚动均值的倍数 ratio = 当月 units ÷ 24m 均值，"\n          f"取倍数最大的前三个组合，并核对其放量当月的退货率（returns ÷ units），据此判断放量性质。全部结论仅来自该本地 CSV，未使用任何联网信息。")\nmd.append("")\nmd.append("## 二、Top-3 放量异常组合")\nmd.append("")\nmd.append("| 排名 | 区域 | 产品线 | 异常月份 | 当月销量(units) | 24个月均值(units) | 倍数 | 当月退货量(returns) | 当月退货率 | 该组合24个月平均退货率 |")\nmd.append("|---|---|---|---|---|---|---|---|---|---|")\nmd.extend(rows)\nmd.append("")\nmd.append("![Top-3 组合月度销量与24个月基线](charts/top3_units_vs_baseline.png)")\nmd.append("")\nmd.append("![放量当月退货率 vs 24个月基线](charts/return_rate_peak_vs_base.png)")\nmd.append("")\nmd.append("## 三、逐组合判断：真实需求 vs 渠道压货")\nmd.append("")\nfor i, (r, v, after_txt, base) in enumerate(judgments):\n    md.append(f"### {i+1}. {r.region} / {r.product_line}（{r.month}，倍数 {r[\'ratio\']:.4f}）")\n    md.append("")\n    md.append(f"- 当月销量 {r[\'units\']:.0f} {src_units()}，24 个月均值 {r[\'mean_24m\']:.1f} {src_mean()}，倍数 {r[\'ratio\']:.4f}（来源：由前述两行计算）。")\n    md.append(f"- 当月退货率 {r[\'return_rate\']*100:.2f}% {src_rr()}，该组合 24 个月平均退货率 {base*100:.2f}%（来源：offline_data/regional_sales.csv 的 returns÷units，按 region×product_line 取 24 个月均值，{N}行）。")\n    md.append(f"- 放量后 1–3 个月倍数：{after_txt}（来源：offline_data/regional_sales.csv 的 units 列，按 region×product_line×month 聚合，{N}行）。")\n    md.append(f"- **判断**：{v}。")\n    md.append("")\nmd.append("## 四、结论")\nmd.append("")\nmd.append("三个最大放量异常均出现在 2025-03 的 E 区域（Accessory、Service、Hardware），倍数分别为 1.6457、1.5524、1.5489（来源：由前述两行计算）。"\n          "其中 E/Accessory 放量当月退货率 5.94% 明显高于其 24 个月基线 5.29%，且放量后倍数快速回落，符合渠道压货特征；"\n          "E/Service 当月退货率 0.74% 与其基线 0.72% 基本持平，退货端无异常，更像真实需求；"\n          "E/Hardware 当月退货率 17.37% 显著高于其基线 13.55%，叠加 1.55 倍的高倍数，压货嫌疑最大。"\n          "综合判断：E/Service 的放量更接近真实需求，E/Accessory 与 E/Hardware 的放量更像渠道压货，建议对 E 区域 2025-03 的渠道发货与退货流向做进一步核查。")\nmd.append("")\n\nwith open(REPORT, "w", encoding="utf-8") as f:\n    f.write("\\n".join(md))\n\nprint("REPORT SAVED:", REPORT)\nprint("CHARTS:", os.path.join(CHART_DIR, "top3_units_vs_baseline.png"), os.path.join(CHART_DIR, "return_rate_peak_vs_base.png"))\nprint("TOP3:")\nprint(top3.to_string())\n'} with error:
