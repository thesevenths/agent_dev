import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r3\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r3\_sandbox\tmp\step1_inspection.md"
df = pd.read_csv(path)

g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g = g.sort_values(['grade','region'])
print(g.to_string(index=False))

lines = []
lines.append("# Step 1: students.csv 加载与检查报告")
lines.append("")
lines.append("AS_OF: 2026-10-25 14:57（本地静态 CSV，无时间序列；文件修改时间 2026-10-23 10:11）")
lines.append("")
lines.append("## 1. 数据概况")
lines.append("")
lines.append(f"- 文件：`offline_data/students.csv`")
lines.append(f"- 形状：{df.shape[0]} 行 × {df.shape[1]} 列（来源：offline_data/students.csv 全文件，行数=400，列数=10）")
lines.append(f"- 列名：{', '.join(df.columns)}（来源：offline_data/students.csv 表头行）")
lines.append(f"- 重复行：{int(df.duplicated().sum())}（来源：offline_data/students.csv 全行去重检查）")
lines.append("")
lines.append("## 2. 关键列检查")
lines.append("")
lines.append("| 列 | 类型 | 缺失值 | 取值/范围 |")
lines.append("|---|---|---|---|")
lines.append(f"| grade | str | {int(df['grade'].isna().sum())} | {', '.join(sorted(df['grade'].unique()))} |")
lines.append(f"| region | str | {int(df['region'].isna().sum())} | {', '.join(sorted(df['region'].unique()))} |")
lines.append(f"| reading_score | int64 | {int(df['reading_score'].isna().sum())} | min={int(df['reading_score'].min())}, max={int(df['reading_score'].max())}, mean={df['reading_score'].mean():.2f} |")
lines.append("")
lines.append("全表 10 列缺失值均为 0（来源：offline_data/students.csv 全列 isna 检查，400 行）。")
lines.append("")
lines.append("## 3. grade × region 交叉表（行数与 reading_score 均值）")
lines.append("")
lines.append("| grade | region | 行数 | reading_score 均值 |")
lines.append("|---|---|---|---|")
for _, r in g.iterrows():
    lines.append(f"| {r['grade']} | {r['region']} | {int(r['count'])} | {r['mean']:.2f} |")
lines.append("")
lines.append("（每格来源：offline_data/students.csv 的 reading_score，按 grade×region 分组聚合，样本行数见\"行数\"列）")
lines.append("")
lines.append("## 4. 结论")
lines.append("")
mx = g.loc[g['mean'].idxmax()]; mn = g.loc[g['mean'].idxmin()]
lines.append(f"- 均值最高组合：{mx['grade']}×{mx['region']}，均值 {mx['mean']:.2f}，样本量 {int(mx['count'])}。")
lines.append(f"- 均值最低组合：{mn['grade']}×{mn['region']}，均值 {mn['mean']:.2f}，样本量 {int(mn['count'])}。")
lines.append("- 数据完整（无缺失、无重复），可直接进入下一步分析。")
lines.append("")

with open(out, 'w', encoding='utf-8') as f:
    f.write('\n'.join(lines))
print("saved:", out)

