import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv('offline_data/students.csv')
cols = ['study_hours_per_week','sleep_hours_per_night','attendance_pct','screen_hours_per_day']
n = len(df)

rows = []
for c in cols:
    r = df[c].corr(df['math_score'])
    t = r*np.sqrt(n-2)/np.sqrt(1-r**2)
    p = 2*stats.t.sf(abs(t), n-2)
    rows.append((c, r, abs(r), t, p))
rows.sort(key=lambda x: -x[2])

def src(col, agg):
    return f"（来源：offline_data/students.csv 的 {col}，{agg}）"

mean_line = df[cols+['math_score']].mean()
std_line = df[cols+['math_score']].std()

table = ["| 排名 | 变量 | 皮尔逊 r | \\|r\\| | t 值 | p 值 | 关系方向 |",
         "|---|---|---|---|---|---|---|"]
for i,(c,r,ar,t,p) in enumerate(rows,1):
    direction = "正相关" if r>0 else "负相关"
    table.append(f"| {i} | {c} | {r:.4f} | {ar:.4f} | {t:.3f} | {p:.3e} | {direction} |")
table_md = "\n".join(table)

desc = {
 'study_hours_per_week': '每周学习时长（小时）',
 'sleep_hours_per_night': '每晚睡眠时长（小时）',
 'attendance_pct': '出勤率（%）',
 'screen_hours_per_day': '每日屏幕使用时长（小时）',
 'math_score': '数学成绩（分）',
}

c1,r1,ar1,t1,p1 = rows[0]
c4,r4,ar4,t4,p4 = rows[3]

report = f"""# 学生行为变量与数学成绩（math_score）的皮尔逊相关分析报告

- 报告生成日期：2026-10-26（周一）
- 数据文件：`offline_data/students.csv`（本地离线数据，未使用任何联网检索）
- 样本量：n = {n} 名学生，五个分析变量均无缺失值（来源：offline_data/students.csv 的 student_id，按行计数，共 {n} 行）

## 1. 分析背景

本报告基于本地离线数据集 `offline_data/students.csv`，考察四个学生行为变量——每周学习时长（study_hours_per_week）、每晚睡眠时长（sleep_hours_per_night）、出勤率（attendance_pct）、每日屏幕使用时长（screen_hours_per_day）——与数学成绩（math_score）之间的线性相关强度。采用皮尔逊相关系数（Pearson r）度量，并按 |r| 从大到小排序，以识别与数学成绩关系最强的变量。

## 2. 数据概览

样本共 {n} 行（来源：offline_data/students.csv 的 student_id，按行计数，共 {n} 行）。五个变量的描述性统计如下：

| 变量 | 均值 | 标准差 |
|---|---|---|
| study_hours_per_week（每周学习时长，小时） | {mean_line['study_hours_per_week']:.4f} {src('study_hours_per_week','全样本 n=400 的均值')} | {std_line['study_hours_per_week']:.4f} {src('study_hours_per_week','全样本 n=400 的标准差')} |
| sleep_hours_per_night（每晚睡眠时长，小时） | {mean_line['sleep_hours_per_night']:.4f} {src('sleep_hours_per_night','全样本 n=400 的均值')} | {std_line['sleep_hours_per_night']:.4f} {src('sleep_hours_per_night','全样本 n=400 的标准差')} |
| attendance_pct（出勤率，%） | {mean_line['attendance_pct']:.4f} {src('attendance_pct','全样本 n=400 的均值')} | {std_line['attendance_pct']:.4f} {src('attendance_pct','全样本 n=400 的标准差')} |
| screen_hours_per_day（每日屏幕使用时长，小时） | {mean_line['screen_hours_per_day']:.4f} {src('screen_hours_per_day','全样本 n=400 的均值')} | {std_line['screen_hours_per_day']:.4f} {src('screen_hours_per_day','全样本 n=400 的标准差')} |
| math_score（数学成绩，分） | {mean_line['math_score']:.4f} {src('math_score','全样本 n=400 的均值')} | {std_line['math_score']:.4f} {src('math_score','全样本 n=400 的标准差')} |

## 3. 皮尔逊相关系数计算与排序

对每个变量 X 与 math_score 计算皮尔逊相关系数 r = cov(X, math_score) / (σ_X · σ_math_score)，样本量 n = {n}（来源：offline_data/students.csv 的 math_score，全样本 n=400 参与计算）。按 |r| 降序排列：

