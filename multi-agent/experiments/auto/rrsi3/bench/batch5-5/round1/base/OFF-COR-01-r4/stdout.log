```python
import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/students.csv')
cols = ['study_hours_per_week','sleep_hours_per_night','attendance_pct','screen_hours_per_day']
n = len(df)

rows = []
for c in cols:
    r = df[c].corr(df['math_score'])
    rows.append((c, r, abs(r)))
rows.sort(key=lambda x: -x[2])
for c, r, ar in rows:
    print(f"{c}: r={r:.6f} |r|={ar:.6f}")

# extra stats for report
print("\nmeans:")
print(df[cols+['math_score']].mean().round(4))
print("\nstd:")
print(df[cols+['math_score']].std().round(4))

# significance: t = r*sqrt(n-2)/sqrt(1-r^2)
from scipy import stats
for c, r, ar in rows:
    t = r*np.sqrt(n-2)/np.sqrt(1-r**2)
    p = 2*stats.t.sf(abs(t), n-2)
    print(c, "t=%.3f p=%.3e" % (t, p))
```
