import pandas as pd, json, os

csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r2\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(csv)

grand_total = float(df['revenue'].sum())
n_months = df['month'].nunique()  # 24

per_region = []
for r in ['N','S','E','W']:
    sub = df[df['region']==r]
    total = float(sub['revenue'].sum())
    monthly = sub.groupby('month')['revenue'].sum()
    peak_month = monthly.idxmax()
    per_region.append({
        "region": r,
        "total_revenue": round(total,2),
        "share": round(total/grand_total,6),
        "monthly_avg": round(total/n_months,2),
        "peak_month": peak_month,
        "peak_month_revenue": round(float(monthly.max()),2),
        "n_rows": int(len(sub)),
    })

top = max(per_region, key=lambda x: x["total_revenue"])
out = {
    "source_file": csv,
    "as_of": "2026-10-25 14:34",
    "month_range": [df['month'].min(), df['month'].max()],
    "n_months": int(n_months),
    "n_rows": int(len(df)),
    "grand_total": round(grand_total,2),
    "per_region": per_region,
    "top_region": top["region"],
    "top_region_peak_month": top["peak_month"],
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r2\_sandbox\tmp\step2_regional_aggregates.json"
with open(out_path,"w",encoding="utf-8") as f:
    json.dump(out,f,indent=2,ensure_ascii=False)
print(json.dumps(out,indent=2,ensure_ascii=False))
print("saved:", os.path.abspath(out_path))

