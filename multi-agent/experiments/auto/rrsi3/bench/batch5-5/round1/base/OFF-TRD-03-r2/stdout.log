import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dupes (month,region,product_line):", df.duplicated(subset=['month','region','product_line']).sum())
print("revenue<=0:", (df['revenue']<=0).sum())
print("rows per region:\n", df.groupby('region').size())
print("rows per month-region combo consistent:", (df.groupby(['month','region']).size()==3).all())

# sanity: revenue vs units*unit_price
df['calc'] = df['units']*df['unit_price']
print("max |revenue - units*price|:", (df['revenue']-df['calc']).abs().max())

out = {
  "file": os.path.abspath(path),
  "n_rows": int(len(df)),
  "columns": list(df.columns),
  "regions": sorted(df['region'].unique()),
  "month_range": [df['month'].min(), df['month'].max()],
  "n_months": int(df['month'].nunique()),
  "product_lines": sorted(df['product_line'].unique()),
  "null_cells": int(df.isna().sum().sum()),
  "duplicate_keys": int(df.duplicated(subset=['month','region','product_line']).sum()),
  "nonpositive_revenue": int((df['revenue']<=0).sum()),
  "rows_per_region": {k:int(v) for k,v in df.groupby('region').size().items()},
  "revenue_matches_units_x_price_max_abs_diff": float((df['revenue']-df['units']*df['unit_price']).abs().max()),
}
os.makedirs(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r2\_sandbox\tmp", exist_ok=True)
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-TRD-03-r2\_sandbox\tmp\step1_csv_validation.json","w") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved validation json")

