import pandas as pd
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(p)
g = df.groupby(["grade","region"], observed=True)["reading_score"].agg(["count","mean"]).reset_index()
g = g.sort_values(["grade","region"]).reset_index(drop=True)
g["mean"] = g["mean"].round(4)
print(g.to_string(index=False))
print("total rows:", g["count"].sum())
mx = g.loc[g["mean"].idxmax()]; mn = g.loc[g["mean"].idxmin()]
print("MAX:", mx.tolist())
print("MIN:", mn.tolist())
print("diff:", round(mx["mean"]-mn["mean"],4))
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r0\_sandbox\tmp\step2_crosstab_results.csv"
g.to_csv(out, index=False)
print("saved:", out)

