import pandas as pd
from pathlib import Path

base = Path(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-02-r0\_sandbox")
df = pd.read_csv(base / "offline_data" / "students.csv")

g = df.groupby(["grade", "region"], observed=True)["reading_score"].agg(["count", "mean"])
g = g.reindex(pd.MultiIndex.from_product([["G10","G11","G12"],["A","B","C","D"]], names=["grade","region"]))
print(g)
print("overall rows:", len(df), "overall mean:", df["reading_score"].mean())
mx = g["mean"].idxmax(); mn = g["mean"].idxmin()
print("max:", mx, g.loc[mx].tolist())
print("mn:", mn, g.loc[mn].tolist())
print("ratio:", g.loc[mx,"mean"]/g.loc[mn,"mean"])
print("diff:", g.loc[mx,"mean"]-g.loc[mn,"mean"])
print("max share:", g.loc[mx,"count"]/len(df))
print("mn share:", g.loc[mn,"count"]/len(df))

