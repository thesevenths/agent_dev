 'read_mean': r.mean(), 'read_std': r.std(ddof=1), 'read_median': r.median(),
 'pearson': m.corr(r),
 'math_cv': m.std(ddof=1)/m.mean(), 'read_cv': r.std(ddof=1)/r.mean(),
 'math_min': m.min(), 'math_max': m.max(), 'read_min': r.min(), 'read_max': r.max(),
 'math_q25': m.quantile(.25), 'math_q75': m.quantile(.75),
