```python
import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-STAT-02-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
m = df['math_score']; r = df['reading_score']
n = len(df)

stats = {}
for name, s in [('math_score', m), ('reading_score', r)]:
    mean = s.mean()
    std = s.std(ddof=1)  # sample std
    med = s.median()
    cv = std / mean
    stats[name] = dict(mean=mean, std=std, median=med, cv=cv)

pearson = m.corr(r)  # pandas uses ddof=1, equivalent to pearson

for k, v in stats.items():
    print(k, {kk: round(vv, 6) for kk, vv in v.items()})
print("pearson r =", round(pearson, 6))
print("n =", n)
print("cv ratio math/reading =", round(stats['math_score']['cv']/stats['reading_score']['cv'], 6))

```
