import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
res = {}
for x,y in pairs:
    sub = df[[x,y]].dropna()
    r = sub[x].corr(sub[y], method="pearson")
    res[f"{x}_vs_{y}"] = {"pearson_r": r, "n": len(sub)}
    print(x, y, "r =", r, "n =", len(sub))

# also spearman for robustness context
for x,y in pairs:
    rs = df[x].corr(df[y], method="spearman")
    print("spearman", x, y, rs)

out = {
  "step": "2/4 Compute correlations",
  "source_file": "offline_data/students.csv",
  "as_of": "2026-10-25 13:23",
  "method": "Pearson (pandas .corr, default; no missing values so n=400 for both pairs)",
  "results": res,
  "spearman_reference": {
    "screen_hours_per_day_vs_math_score": float(df["screen_hours_per_day"].corr(df["math_score"], method="spearman")),
    "screen_hours_per_day_vs_reading_score": float(df["screen_hours_per_day"].corr(df["reading_score"], method="spearman")),
