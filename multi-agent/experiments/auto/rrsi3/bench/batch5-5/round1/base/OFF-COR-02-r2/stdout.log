import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day", "math_score", "reading_score"]
sub = df[cols].dropna()
n = len(sub)

r_math = sub["screen_hours_per_day"].corr(sub["math_score"], method="pearson")
r_read = sub["screen_hours_per_day"].corr(sub["reading_score"], method="pearson")

# significance: t-test for correlation
import math
def corr_p(r, n):
    t = r * math.sqrt((n-2)/(1-r*r))
    return t

info = {
    "file": "offline_data/students.csv",
    "n_used": n,
    "n_missing_excluded": len(df) - n,
    "pearson_screen_vs_math": float(r_math),
    "pearson_screen_vs_reading": float(r_read),
    "t_stat_math": float(corr_p(r_math, n)),
    "t_stat_reading": float(corr_p(r_read, n)),
    "df": n - 2,
}
print(json.dumps(info, indent=2))

out = "E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch5-5/round1/base/OFF-COR-02-r2/_sandbox/tmp/step2_correlations.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(info, f, indent=2, ensure_ascii=False)
print("saved:", out)

