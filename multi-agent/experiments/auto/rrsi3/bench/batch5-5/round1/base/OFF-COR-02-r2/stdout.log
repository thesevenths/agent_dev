```python
import pandas as pd, json, math as m

# Recompute exact values to 4 decimals for the report
df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
t_math = r_math * m.sqrt((n-2)/(1-r_math**2))
t_read = r_read * m.sqrt((n-2)/(1-r_read**2))

df["grp"] = (df["screen_hours_per_day"] > 5).map({True: "high", False: "low"})
g = df.groupby("grp").agg(n=("student_id","size"), ms=("screen_hours_per_day","mean"),
                          mm=("math_score","mean"), mr=("reading_score","mean"))
print(g.round(4))
print("r_math", round(r_math,4), "t", round(t_math,4))
print("r_read", round(r_read,4), "t", round(t_read,4))
print("diff math", round(g.loc["high","mm"]-g.loc["low","mm"],4))
print("diff read", round(g.loc["high","mr"]-g.loc["low","mr"],4))
print("mean screen all", round(df["screen_hours_per_day"].mean(),4))
print("mean math all", round(df["math_score"].mean(),4))
print("mean read all", round(df["reading_score"].mean(),4))

```
