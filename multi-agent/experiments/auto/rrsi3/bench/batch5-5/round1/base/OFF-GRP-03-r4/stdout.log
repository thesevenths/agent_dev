import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

def grp(h):
    if h < 2.5: return 'low'
    elif h <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)
g = df.groupby('group').agg(n=('math_score','size'),
                            mean_math=('math_score','mean'),
                            min_h=('study_hours_per_week','min'),
                            max_h=('study_hours_per_week','max'),
                            mean_h=('study_hours_per_week','mean'))
print(g)
print("boundary check: rows with h==2.5:", (df.study_hours_per_week==2.5).sum(), " h==4.5:", (df.study_hours_per_week==4.5).sum())
print("gain high-low:", g.loc['high','mean_math'] - g.loc['low','mean_math'])
print("ratio high/low:", g.loc['high','mean_math']/g.loc['low','mean_math'])

```
