import pandas as pd
import json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

def grp(h):
    if h < 2.5: return 'low'
    elif h <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)

stats = {}
for g in ['low','mid','high']:
    sub = df[df['group']==g]
    stats[g] = {
        'n': int(len(sub)),
        'mean_math': float(sub['math_score'].mean()),
        'std_math': float(sub['math_score'].std(ddof=1)),
        'min_math': int(sub['math_score'].min()),
        'max_math': int(sub['math_score'].max()),
        'median_math': float(sub['math_score'].median()),
        'min_h': float(sub['study_hours_per_week'].min()),
        'max_h': float(sub['study_hours_per_week'].max()),
        'mean_h': float(sub['study_hours_per_week'].mean()),
    }

gain = stats['high']['mean_math'] - stats['low']['mean_math']
ratio = stats['high']['mean_math'] / stats['low']['mean_math']
mid_gain = stats['mid']['mean_math'] - stats['low']['mean_math']
high_mid_gain = stats['high']['mean_math'] - stats['mid']['mean_math']

out = {
    'total_rows': int(len(df)),
    'groups': stats,
    'gain_high_minus_low': gain,
    'ratio_high_over_low': ratio,
    'gain_mid_minus_low': mid_gain,
    'gain_high_minus_mid': high_mid_gain,
    'boundary_counts': {'h_eq_2.5': int((df.study_hours_per_week==2.5).sum()),
                        'h_eq_4.5': int((df.study_hours_per_week==4.5).sum())},
}
print(json.dumps(out, indent=2, ensure_ascii=False))

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r4\_sandbox\tmp\step2_group_stats.json","w",encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved")

