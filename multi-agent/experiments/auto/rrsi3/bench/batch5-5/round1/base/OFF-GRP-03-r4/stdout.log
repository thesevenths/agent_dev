import pandas as pd, json, os

path = "offline_data/students.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("missing study_hours_per_week:", df["study_hours_per_week"].isna().sum())
print("missing math_score:", df["math_score"].isna().sum())
print("total missing:", df.isna().sum().sum())
print("dtypes:\n", df[["study_hours_per_week","math_score"]].dtypes)
print("study range:", df["study_hours_per_week"].min(), df["study_hours_per_week"].max())
print("math range:", df["math_score"].min(), df["math_score"].max())
print("dup student_id:", df["student_id"].duplicated().sum())

# boundary check: values exactly at 2.5 / 4.5
print("count ==2.5:", (df["study_hours_per_week"]==2.5).sum(), "==4.5:", (df["study_hours_per_week"]==4.5).sum())

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"
df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group")["math_score"].agg(["count","mean","std","min","max"])
print(g)
low_mean = g.loc["low","mean"]; high_mean = g.loc["high","mean"]
print("gain high-low:", high_mean-low_mean)
print("ratio:", high_mean/low_mean)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r4\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
summary = {
  "file": path,
  "rows": int(len(df)),
  "columns": list(df.columns),
  "missing": {"study_hours_per_week": int(df["study_hours_per_week"].isna().sum()),
              "math_score": int(df["math_score"].isna().sum()),
              "total": int(df.isna().sum().sum())},
  "study_range": [float(df["study_hours_per_week"].min()), float(df["study_hours_per_week"].max())],
  "math_range": [int(df["math_score"].min()), int(df["math_score"].max())],
  "dup_ids": int(df["student_id"].duplicated().sum()),
  "boundary_2_5": int((df["study_hours_per_week"]==2.5).sum()),
  "boundary_4_5": int((df["study_hours_per_week"]==4.5).sum()),
