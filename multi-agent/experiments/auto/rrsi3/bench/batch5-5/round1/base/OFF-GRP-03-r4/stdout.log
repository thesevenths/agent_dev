import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"
df["group"] = df["study_hours_per_week"].apply(grp)

stats = {}
for name in ["low","mid","high"]:
    sub = df.loc[df["group"]==name]
    stats[name] = {
        "n": int(len(sub)),
        "mean": round(float(sub["math_score"].mean()), 4),
        "std": round(float(sub["math_score"].std()), 4),
        "min": int(sub["math_score"].min()),
        "max": int(sub["math_score"].max()),
        "study_min": float(sub["study_hours_per_week"].min()),
        "study_max": float(sub["study_hours_per_week"].max()),
    }
gain = round(stats["high"]["mean"] - stats["low"]["mean"], 4)
ratio = round(stats["high"]["mean"] / stats["low"]["mean"], 4)
mid_gain = round(stats["mid"]["mean"] - stats["low"]["mean"], 4)
high_mid_gain = round(stats["high"]["mean"] - stats["mid"]["mean"], 4)

result = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "grouping_rule": "low: study_hours_per_week < 2.5; mid: 2.5 <= x <= 4.5; high: x > 4.5",
    "groups": stats,
    "n_sum_check": sum(stats[g]["n"] for g in stats),
    "gain_high_minus_low": gain,
    "ratio_high_over_low": ratio,
    "gain_mid_minus_low": mid_gain,
    "gain_high_minus_mid": high_mid_gain,
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-GRP-03-r4\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out_path = os.path.join(out_dir, "step2_group_stats.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out_path)

```
