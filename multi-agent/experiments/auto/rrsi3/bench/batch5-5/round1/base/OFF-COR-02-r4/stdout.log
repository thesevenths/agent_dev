g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
)
print(g)
n_low, n_high = int(g.loc["low_le5","n"]), int(g.loc["high_gt5","n"])
dm = g.loc["high_gt5","mean_math"] - g.loc["low_le5","mean_math"]
dr = g.loc["high_gt5","mean_reading"] - g.loc["low_le5","mean_reading"]
out = {
  "split_rule": "screen_hours_per_day > 5 (high) vs <= 5 (low)",
  "as_of": "2026-10-26 09:17",
  "groups": {
    "low_le5": {"n": n_low, "mean_screen": round(float(g.loc["low_le5","mean_screen"]),4),
