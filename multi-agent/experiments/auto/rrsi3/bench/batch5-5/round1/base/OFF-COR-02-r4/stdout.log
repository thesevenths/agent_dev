import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df.screen_hours_per_day.corr(df.math_score, method="pearson")
r_read = df.screen_hours_per_day.corr(df.reading_score, method="pearson")
out = {
  "n": n,
  "pearson_screen_vs_math": round(r_math, 6),
  "pearson_screen_vs_reading": round(r_read, 6),
  "method": "pearson",
  "as_of": "2026-10-26 09:16",
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r4\_sandbox\tmp\step2_correlations.json","w") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print(out)
# also p-values for context
from scipy import stats
print(stats.pearsonr(df.screen_hours_per_day, df.math_score))
print(stats.pearsonr(df.screen_hours_per_day, df.reading_score))

