import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r4\_sandbox"
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
cols = ["screen_hours_per_day", "math_score", "reading_score"]
assert df[cols].notna().all().all()

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
n = len(df)

# p-values via t-test
from scipy import stats
t_math = r_math * (n-2) / (1 - r_math**2)
t_read = r_read * (n-2) / (1 - r_read**2)
p_math = 2 * stats.t.sf(abs(t_math), n-2)
p_read = 2 * stats.t.sf(abs(t_read), n-2)

print("r_math:", r_math, "p:", p_math)
print("r_read:", r_read, "p:", p_read)

out = {
    "source_file": "offline_data/students.csv",
    "n": int(n),
    "method": "Pearson correlation (pandas .corr, default pearson)",
    "screen_hours_per_day_vs_math_score": {
        "r": float(r_math), "t": float(t_math), "p_value": float(p_math), "n": int(n)
    },
    "screen_hours_per_day_vs_reading_score": {
        "r": float(r_read), "t": float(t_read), "p_value": float(p_read), "n": int(n)
    },
}
outdir = os.path.join(base, "tmp")
os.makedirs(outdir, exist_ok=True)
p = os.path.join(outdir, "step2_correlations.json")
with open(p, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved:", p, os.path.getsize(p), "bytes")

