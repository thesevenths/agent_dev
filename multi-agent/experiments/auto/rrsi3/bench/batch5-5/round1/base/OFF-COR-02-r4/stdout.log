import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\base\OFF-COR-02-r4\_sandbox"
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high_gt5", False: "low_le5"})

g = df.groupby("group").agg(
    n=("math_score", "size"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
    mean_screen=("screen_hours_per_day", "mean"),
)
print(g.to_string())

low = g.loc["low_le5"]; high = g.loc["high_gt5"]
out = {
    "source_file": "offline_data/students.csv",
    "split_rule": "high_gt5: screen_hours_per_day > 5; low_le5: screen_hours_per_day <= 5",
    "groups": {
        "low_le5": {
            "n": int(low["n"]),
            "mean_math_score": float(low["mean_math"]),
            "mean_reading_score": float(low["mean_reading"]),
            "mean_screen_hours_per_day": float(low["mean_screen"]),
        },
        "high_gt5": {
            "n": int(high["n"]),
            "mean_math_score": float(high["mean_math"]),
            "mean_reading_score": float(high["mean_reading"]),
            "mean_screen_hours_per_day": float(high["mean_screen"]),
        },
    },
    "mean_difference_high_minus_low": {
        "math_score": float(high["mean_math"] - low["mean_math"]),
        "reading_score": float(high["mean_reading"] - low["mean_reading"]),
    },
}
outdir = os.path.join(base, "tmp")
os.makedirs(outdir, exist_ok=True)
p = os.path.join(outdir, "step3_group_stats.json")
with open(p, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved:", p, os.path.getsize(p), "bytes")
print(json.dumps(out, indent=2))

