import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

out = {}
out["columns"] = list(df.columns)
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}
out["n_rows"] = int(len(df))
out["n_cols"] = int(df.shape[1])
out["regions"] = sorted(df["region"].unique().tolist())
out["regions_present"] = all(r in set(df["region"].unique()) for r in ["N","S","E","W"])
out["months"] = sorted(df["month"].unique().tolist())
out["n_months"] = int(df["month"].nunique())
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["nulls"] = {c: int(df[c].isna().sum()) for c in df.columns}
out["dup_rows"] = int(df.duplicated().sum())
out["revenue_min"] = float(df["revenue"].min())
out["revenue_max"] = float(df["revenue"].max())
out["revenue_sum"] = float(df["revenue"].sum())
out["rows_per_region"] = df.groupby("region")["revenue"].count().to_dict()
out["rows_per_month"] = df.groupby("month")["revenue"].count().to_dict()
out["revenue_by_region"] = df.groupby("region")["revenue"].sum().to_dict()
out["revenue_by_region_month"] = df.groupby(["region","month"])["revenue"].sum().to_dict()

# sanity: revenue == units*unit_price?
df["calc"] = df["units"]*df["unit_price"]
out["max_abs_diff_units_price"] = float((df["revenue"]-df["calc"]).abs().max())

os.makedirs("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch5-5\\round1\\cand\\OFF-TRD-03-r5\\_sandbox\\tmp", exist_ok=True)
outp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r5\_sandbox\tmp\step1_validation.json"
with open(outp, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", outp)

