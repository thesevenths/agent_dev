import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30, last30 = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_weeks": int(len(r)),
    "first30": {"weeks": "W01-W30", "n": 30, "mean": float(first30.mean()), "std": float(first30.std(ddof=1))},
    "last30": {"weeks": "W31-W60", "n": 30, "mean": float(last30.mean()), "std": float(last30.std(ddof=1))},
    "diff_mean_last_minus_first": float(last30.mean() - first30.mean()),
    "overall": {"mean": float(overall_mean), "std": float(overall_std)},
    "threshold_mean_minus_2std": float(threshold),
    "weeks_below_threshold": {
        "count": int(len(below)),
        "weeks": below["week"].tolist(),
        "values": below["retention_d7"].tolist(),
    },
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-01-r5\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out = os.path.join(out_dir, "retention_d7_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("SAVED:", out)

