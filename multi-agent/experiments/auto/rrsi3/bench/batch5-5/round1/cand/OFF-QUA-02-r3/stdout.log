import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-QUA-02-r3\_sandbox"
csv_path = os.path.join(base, "offline_data", "regional_sales.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(csv_path)
print("COLUMNS:", list(df.columns))
print("DTYPES:\n", df.dtypes)
print("ROWS:", len(df))
print("HEAD:\n", df.head(5).to_string())

exp = df["units"] * df["unit_price"]
abs_dev = (df["revenue"] - exp).abs()
rel_dev = abs_dev / exp
df["expected_revenue"] = exp
df["abs_dev"] = abs_dev
df["rel_dev"] = rel_dev

n_bad = int((rel_dev > 0.005).sum())
i_max_abs = abs_dev.idxmax()
i_max_rel = rel_dev.idxmax()
print("N_REL_DEV_GT_0.5PCT:", n_bad)
print("MAX_ABS_DEV:", abs_dev.max(), "at index", i_max_abs)
print("MAX_REL_DEV:", rel_dev.max(), "at index", i_max_rel)
print("TOTAL_REVENUE:", df["revenue"].sum())
print("TOTAL_EXPECTED:", exp.sum())
print("TOTAL_UNITS:", df["units"].sum())
print("TOTAL_RETURNS:", df["returns"].sum())

bad_rel = df[rel_dev > 0.005]
print("BAD_REL_ROWS:\n", bad_rel.to_string())

n_ret = int((df["returns"] > df["units"]).sum())
print("N_RETURNS_GT_UNITS:", n_ret)
ret_bad = df[df["returns"] > df["units"]]
print("RETURNS_BAD_ROWS:\n", ret_bad.to_string())

out_csv = os.path.join(out_dir, "revenue_deviation.csv")
df.to_csv(out_csv, index=False)
print("SAVED:", out_csv)

```
