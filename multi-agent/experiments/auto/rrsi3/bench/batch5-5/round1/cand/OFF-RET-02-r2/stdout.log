means = pd.DataFrame({
    "metric": cols,
    "mean_W30_W36": [before[c].mean() for c in cols],
    "mean_W37_W43": [after[c].mean() for c in cols],
})
means["abs_diff_after_minus_before"] = means["mean_W37_W43"] - means["mean_W30_W36"]
means["pct_change"] = means["abs_diff_after_minus_before"] / means["mean_W30_W36"] * 100
print(means.to_string(index=False))

# per-week table for breakpoint pinpointing
per = sub[["week"] + cols].copy()
per.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r2\_sandbox\tmp\step2_perweek.csv", index=False)

# breakpoint: week with max |z| vs W30-W36 baseline, or simply W36->W37 jump
base = before[cols].mean()
std = before[cols].std(ddof=1)
per["z_retention"] = (per["retention_d7"] - base["retention_d7"]) / std["retention_d7"]
per["z_churn"] = (per["churn_rate"] - base["churn_rate"]) / std["churn_rate"]
per["z_arpu"] = (per["arpu_usd"] - base["arpu_usd"]) / std["arpu_usd"]
print(per.to_string(index=False))

out = pd.concat([
    per,
    means.assign(week="GROUP_MEAN"),
], ignore_index=True)
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r2\_sandbox\tmp\step2_results.csv", index=False)
print("saved")

