```python
import pandas as pd
import numpy as np

df = pd.read_csv(r"offline_data/app_metrics.csv")
cols = ['retention_d7','churn_rate','arpu_usd']
weeks = [f'W{i:02d}' for i in range(30,44)]
sub = df[df['week'].isin(weeks)].copy()
sub['group'] = np.where(sub['week'].isin([f'W{i:02d}' for i in range(30,37)]), 'W30-W36', 'W37-W43')

# group means
means = sub.groupby('group')[cols].mean()
print("GROUP MEANS:\n", means)

# per-week with week-over-week deltas
sub['ret_d7_wow'] = sub['retention_d7'].diff()
sub['churn_wow']  = sub['churn_rate'].diff()
sub['arpu_wow']   = sub['arpu_usd'].diff()

# breakpoint scoring: for each week W31..W43, compare that week to the mean of the 6 preceding weeks
rows = []
for i in range(1, len(sub)):
    w = sub.iloc[i]
    prev = sub.iloc[:i]
    for c in cols:
        prev_mean = prev[c].mean()
        delta = w[c] - prev_mean
        # z-score against std of preceding window
        z = (w[c] - prev_mean) / prev[c].std(ddof=1) if prev[c].std(ddof=1) > 0 else np.nan
        rows.append({'week': w['week'], 'metric': c, 'value': w[c],
                     'prev_mean': prev_mean, 'delta_vs_prev_mean': delta, 'z': z})
score = pd.DataFrame(rows)
print("\nWOW DELTAS (W36->W37 etc):")
print(sub[['week','ret_d7_wow','churn_wow','arpu_wow']].to_string(index=False))

# breakpoint week = week with max |z| across metrics (first occurrence)
score['abs_z'] = score['z'].abs()
top = score.sort_values('abs_z', ascending=False).head(10)
print("\nTOP |z| rows:\n", top.to_string(index=False))

# save intermediate CSV
out = sub[['week','group','retention_d7','churn_rate','arpu_usd','ret_d7_wow','churn_wow','arpu_wow']]
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r0\_sandbox\tmp\step2_breakpoint_data.csv"
out.to_csv(out_path, index=False)
means.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r0\_sandbox\tmp\step2_group_means.csv")
print("\nSaved:", out_path)
print(means)

```
