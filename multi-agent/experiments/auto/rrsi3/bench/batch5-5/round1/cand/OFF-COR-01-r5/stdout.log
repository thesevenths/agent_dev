```python
import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/students.csv")
cols = ["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day"]
n = len(df)

res = []
for c in cols:
    r = df[c].corr(df["math_score"], method="pearson")
    # p-value via t-test
    t = r * np.sqrt((n-2)/(1-r**2))
    from scipy import stats
    p = 2*stats.t.sf(abs(t), n-2)
    res.append((c, r, abs(r), p))
res.sort(key=lambda x: -x[2])
for row in res:
    print(row)

# descriptive stats
print(df[cols+["math_score"]].describe().T)
print("n =", n)

```
