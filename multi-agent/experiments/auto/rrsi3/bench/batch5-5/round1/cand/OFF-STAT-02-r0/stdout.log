import pandas as pd, numpy as np, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-STAT-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
