import pandas as pd, json, math
df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r2\_sandbox\offline_data\students.csv")
hi = df[df.screen_hours_per_day > 5]
lo = df[df.screen_hours_per_day <= 5]
res = {}
for name, g in [("gt5", hi), ("le5", lo)]:
    res[name] = {
        "n": int(len(g)),
        "screen_mean": float(g.screen_hours_per_day.mean()),
        "math_mean": float(g.math_score.mean()),
        "reading_mean": float(g.reading_score.mean()),
        "math_std": float(g.math_score.std(ddof=1)),
        "reading_std": float(g.reading_score.std(ddof=1)),
    }
res["diff_math_gt5_minus_le5"] = res["gt5"]["math_mean"] - res["le5"]["math_mean"]
res["diff_reading_gt5_minus_le5"] = res["gt5"]["reading_mean"] - res["le5"]["reading_mean"]
# Welch t-tests for the mean differences
from scipy import stats
t_m, p_m = stats.ttest_ind(hi.math_score, lo.math_score, equal_var=False)
t_r, p_r = stats.ttest_ind(hi.reading_score, lo.reading_score, equal_var=False)
res["welch_t_math"] = float(t_m); res["welch_p_math"] = float(p_m)
res["welch_t_reading"] = float(t_r); res["welch_p_reading"] = float(p_r)
print(json.dumps(res, indent=2))
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r2\_sandbox\tmp\step3_group_stats.json"
json.dump(res, open(out, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
pd.DataFrame([
 {"group":"screen>5","n":res["gt5"]["n"],"math_mean":round(res["gt5"]["math_mean"],4),"reading_mean":round(res["gt5"]["reading_mean"],4)},
 {"group":"screen<=5","n":res["le5"]["n"],"math_mean":round(res["le5"]["math_mean"],4),"reading_mean":round(res["le5"]["reading_mean"],4)},
 {"group":"diff(gt5-le5)","n":None,"math_mean":round(res["diff_math_gt5_minus_le5"],4),"reading_mean":round(res["diff_reading_gt5_minus_le5"],4)},
]).to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r2\_sandbox\tmp\step3_group_stats.csv", index=False)
print("saved")

