# significance: t = r*sqrt(n-2)/sqrt(1-r^2)
import math
def tstat(r, n):
    return r*math.sqrt(n-2)/math.sqrt(1-r*r)
out = {
  "n": n,
  "pearson_screen_math": float(r_math),
  "pearson_screen_reading": float(r_read),
  "t_screen_math": float(tstat(r_math, n)),
  "t_screen_reading": float(tstat(r_read, n)),
  "df": n-2,
  "means": {"screen": float(df.screen_hours_per_day.mean()), "math": float(df.math_score.mean()), "reading": float(df.reading_score.mean())},
