import json, os, pandas as pd

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-01-r2\_sandbox"
stats = json.load(open(os.path.join(base, "tmp", "group_stats.json"), encoding="utf-8"))

# locate the CSV
cand = os.path.join(base, "offline_data", "students.csv")
if not os.path.exists(cand):
    cand = os.path.join(base, "tmp", "offline_data", "students.csv")
print("csv:", cand, os.path.exists(cand))
df = pd.read_csv(cand)
print(df.shape, list(df.columns))
print(df["tutoring"].value_counts(dropna=False))
print(df["math_score"].isna().sum())
g = df.groupby("tutoring")["math_score"].agg(["count","mean","std"])
print(g)
m0, m1 = g.loc[0,"mean"], g.loc[1,"mean"]
s0, s1 = g.loc[0,"std"], g.loc[1,"std"]
n0, n1 = int(g.loc[0,"count"]), int(g.loc[1,"count"])
n = n0+n1
# correct pooled std (within-group)
sp = ((n0-1)*s0**2 + (n1-1)*s1**2)/(n-2) ** 0.5
d = (m1-m0)/sp
print("diff:", m1-m0, "pooled_std(within):", sp, "d:", d)
# overall std for reference
print("overall std:", df["math_score"].std())

```
