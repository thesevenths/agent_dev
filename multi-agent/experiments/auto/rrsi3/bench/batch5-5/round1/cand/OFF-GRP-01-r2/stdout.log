import pandas as pd

df = pd.read_csv('offline_data/students.csv')

# duplicate check
print("duplicate student_id:", df['student_id'].duplicated().sum())

# tutoring only 0/1?
print("tutoring unique:", sorted(df['tutoring'].unique()))

# math_score range
print("math_score min/max:", df['math_score'].min(), df['math_score'].max())

# group stats
g = df.groupby('tutoring')['math_score'].agg(['count','mean','std'])
print(g)

# pooled std (n-1)
n0, n1 = 261, 139
m0, m1 = g.loc[0,'mean'], g.loc[1,'mean']
s0, s1 = g.loc[0,'std'], g.loc[1,'std']
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2)/(n0+n1-2)
print("pooled std:", pooled**0.5)
print("mean diff (1-0):", m1-m0)
print("effect size (diff/pooled):", (m1-m0)/pooled**0.5)

```
