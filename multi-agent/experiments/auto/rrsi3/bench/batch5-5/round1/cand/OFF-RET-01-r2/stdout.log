import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
low = r[r < overall_mean - 2*overall_std]

res = {
  "n_total": len(r),
  "first30": {"weeks": list(df["week"].iloc[:30]), "mean": float(first.mean()), "std": float(first.std(ddof=1)), "min": float(first.min()), "max": float(first.max())},
  "last30": {"weeks": list(df["week"].iloc[30:]), "mean": float(last.mean()), "std": float(last.std(ddof=1)), "min": float(last.min()), "max": float(last.max())},
  "diff_mean": float(last.mean() - first.mean()),
  "overall": {"mean": float(overall_mean), "std": float(overall_std), "threshold": float(overall_mean - 2*overall_std)},
  "below_2sigma": {"count": int(len(low)), "weeks": [df["week"].iloc[i] for i in low.index], "values": [float(v) for v in low.tolist()]},
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-01-r2\_sandbox\tmp"
os.makedirs(out, exist_ok=True)
with open(os.path.join(out, "retention_d7_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

