csv = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-01-r2\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(csv)
r = df['retention_d7']
first = r.iloc[:30]
last = r.iloc[30:]

res = {
    "as_of": "2026-10-25 13:33",
    "source_file": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {"weeks": "W01-W30", "n": int(len(first)),
                "mean": float(first.mean()), "std_ddof1": float(first.std(ddof=1)),
                "std_ddof0": float(first.std(ddof=0)), "min": float(first.min()), "max": float(first.max())},
    "last30": {"weeks": "W31-W60", "n": int(len(last)),
               "mean": float(last.mean()), "std_ddof1": float(last.std(ddof=1)),
               "std_ddof0": float(last.std(ddof=0)), "min": float(last.min()), "max": float(last.max())},
    "overall60": {"n": int(len(r)), "mean": float(r.mean()),
                  "std_ddof1": float(r.std(ddof=1)), "std_ddof0": float(r.std(ddof=0)),
                  "min": float(r.min()), "max": float(r.max())},
}
res["diff_mean_last_minus_first"] = res["last30"]["mean"] - res["first30"]["mean"]
res["diff_mean_first_minus_last"] = res["first30"]["mean"] - res["last30"]["mean"]
res["diff_std_last_minus_first"] = res["last30"]["std_ddof1"] - res["first30"]["std_ddof1"]
thr = res["overall60"]["mean"] - 2*res["overall60"]["std_ddof1"]
res["threshold_mean_minus_2std_ddof1"] = thr
below = df[r < thr]
res["weeks_below_mean_minus_2std_ddof1"] = {
    "count": int(len(below)),
    "weeks": below['week'].tolist(),
    "values": below['retention_d7'].tolist(),
}
thr0 = res["overall60"]["mean"] - 2*res["overall60"]["std_ddof0"]
res["threshold_mean_minus_2std_ddof0"] = thr0
res["weeks_below_mean_minus_2std_ddof0_count"] = int((r < thr0).sum())

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-01-r2\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

