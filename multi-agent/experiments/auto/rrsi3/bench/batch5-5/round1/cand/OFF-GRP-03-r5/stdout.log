import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-03-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-03-r5\_sandbox\tmp"
df = pd.read_csv(path)

# boundary counts
print("study==2.5:", (df.study_hours_per_week==2.5).sum(), " study==4.5:", (df.study_hours_per_week==4.5).sum())

def grp(x):
    if x < 2.5: return "低(<2.5)"
    elif x <= 4.5: return "中(2.5-4.5)"
    else: return "高(>4.5)"
df["group"] = df.study_hours_per_week.map(grp)
g = df.groupby("group").agg(n=("math_score","size"), math_mean=("math_score","mean"),
                            math_std=("math_score","std"),
                            hours_min=("study_hours_per_week","min"),
                            hours_max=("study_hours_per_week","max"),
                            hours_mean=("study_hours_per_week","mean"))
print(g.to_string())
gain = g.loc["高(>4.5)","math_mean"] - g.loc["低(<2.5)","math_mean"]
print("gain low->high:", gain)

summary = {
  "file": path,
  "rows": int(df.shape[0]), "cols": int(df.shape[1]),
  "columns": list(df.columns),
  "missing": {c:int(v) for c,v in df.isna().sum().items()},
  "duplicated_rows": int(df.duplicated().sum()),
  "study_hours_per_week": {"min":float(df.study_hours_per_week.min()),"max":float(df.study_hours_per_week.max()),"mean":float(df.study_hours_per_week.mean()),"std":float(df.study_hours_per_week.std())},
  "math_score": {"min":int(df.math_score.min()),"max":int(df.math_score.max()),"mean":float(df.math_score.mean()),"std":float(df.math_score.std())},
  "boundary_counts": {"study==2.5":int((df.study_hours_per_week==2.5).sum()),"study==4.5":int((df.study_hours_per_week==4.5).sum())},
  "groups": {k:{"n":int(v.n),"math_mean":float(v.math_mean),"math_std":float(v.math_std),"hours_min":float(v.hours_min),"hours_max":float(v.hours_max),"hours_mean":float(v.hours_mean)} for k,v in g.iterrows()},
  "gain_low_to_high": float(gain),
}
with open(out+r"\step1_validation_summary.json","w",encoding="utf-8") as f:
    json.dump(summary,f,ensure_ascii=False,indent=2)
print("saved")

