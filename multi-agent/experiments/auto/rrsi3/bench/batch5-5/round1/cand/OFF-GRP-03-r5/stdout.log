```python
import pandas as pd, json

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-03-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-03-r5\_sandbox\tmp"
df = pd.read_csv(src)

def grp(x):
    if x < 2.5: return "low"
    elif x <= 4.5: return "mid"
    else: return "high"
df["group"] = df.study_hours_per_week.map(grp)

g = df.groupby("group").agg(
    n=("math_score","size"),
    math_mean=("math_score","mean"),
    math_std=("math_score","std"),
    math_min=("math_score","min"),
    math_max=("math_score","max"),
    hours_min=("study_hours_per_week","min"),
    hours_max=("study_hours_per_week","max"),
    hours_mean=("study_hours_per_week","mean"),
).reindex(["low","mid","high"])
g["math_mean"] = g.math_mean.round(4)
g["math_std"] = g.math_std.round(4)
g["hours_mean"] = g.hours_mean.round(4)

gain = g.loc["high","math_mean"] - g.loc["low","math_mean"]
gain_pct = gain / g.loc["low","math_mean"] * 100

# extra context: overall mean, mid-low and high-mid gains
overall_mean = df.math_score.mean()
rows = {
  "low":  {"n":int(g.loc["low","n"]),  "math_mean":float(g.loc["low","math_mean"]),  "math_std":float(g.loc["low","math_std"]),  "math_min":int(g.loc["low","math_min"]),  "math_max":int(g.loc["low","math_max"]),  "hours_min":float(g.loc["low","hours_min"]),  "hours_max":float(g.loc["low","hours_max"]),  "hours_mean":float(g.loc["low","hours_mean"])},
  "mid":  {"n":int(g.loc["mid","n"]),  "math_mean":float(g.loc["mid","math_mean"]),  "math_std":float(g.loc["mid","math_std"]),  "math_min":int(g.loc["mid","math_min"]),  "math_max":int(g.loc["mid","math_max"]),  "hours_min":float(g.loc["mid","hours_min"]),  "hours_max":float(g.loc["mid","hours_max"]),  "hours_mean":float(g.loc["mid","hours_mean"])},
  "high": {"n":int(g.loc["high","n"]), "math_mean":float(g.loc["high","math_mean"]), "math_std":float(g.loc["high","math_std"]), "math_min":int(g.loc["high","math_min"]), "math_max":int(g.loc["high","math_max"]), "hours_min":float(g.loc["high","hours_min"]), "hours_max":float(g.loc["high","hours_max"]), "hours_mean":float(g.loc["high","hours_mean"])},
}
summary = {
  "source_csv": src,
  "total_rows": int(len(df)),
  "groups": rows,
  "overall_math_mean": float(round(overall_mean,4)),
  "gain_low_to_high": float(round(gain,4)),
  "gain_low_to_high_pct_of_low": float(round(gain_pct,4)),
  "gain_low_to_mid": float(round(g.loc["mid","math_mean"]-g.loc["low","math_mean"],4)),
  "gain_mid_to_high": float(round(g.loc["high","math_mean"]-g.loc["mid","math_mean"],4)),
  "as_of": "2026-10-26 09:11",
}
g.to_csv(out + r"\step2_group_stats.csv", encoding="utf-8-sig")
with open(out + r"\step2_group_stats.json","w",encoding="utf-8") as f:
    json.dump(summary,f,ensure_ascii=False,indent=2)
print(g.to_string())
print("gain:", gain, "pct:", gain_pct)
print("saved step2_group_stats.csv / .json")

