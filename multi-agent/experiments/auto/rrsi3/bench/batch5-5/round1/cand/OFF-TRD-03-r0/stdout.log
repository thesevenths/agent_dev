import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

OUT = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r0\_sandbox\tmp"

piv = pd.read_csv(f"{OUT}\\region_monthly_revenue.csv", index_col=0)
piv.columns = [str(c) for c in piv.columns]
piv = piv[["N","S","E","W"]]

fig, axes = plt.subplots(1, 2, figsize=(13, 5))

# Line chart: monthly revenue by region
ax = axes[0]
for col in ["N","S","E","W"]:
    ax.plot(piv.index, piv[col], marker='o', markersize=3, label=col)
ax.set_title("Monthly Revenue by Region (2024-01 to 2025-12)")
ax.set_xlabel("Month"); ax.set_ylabel("Revenue")
ax.legend(); ax.grid(alpha=0.3)

# Bar chart: totals
ax = axes[1]
totals = piv.sum().sort_values(ascending=False)
bars = ax.bar(totals.index, totals.values, color=["#4C72B0","#55A868","#C44E52","#8172B2"])
for b, v in zip(bars, totals.values):
    ax.text(b.get_x()+b.get_width()/2, v, f"{v:,.0f}", ha='center', va='bottom', fontsize=9)
ax.set_title("Total Revenue by Region")
ax.set_ylabel("Revenue"); ax.grid(axis='y', alpha=0.3)

plt.tight_layout()
plt.savefig(f"{OUT}\\regional_sales_chart.png", dpi=110)
print("chart saved")

# extra derived numbers for the report
e = piv["E"]
