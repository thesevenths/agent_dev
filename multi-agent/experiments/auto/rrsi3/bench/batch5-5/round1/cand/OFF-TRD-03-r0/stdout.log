```python
import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
print(df.shape)
print(df['month'].nunique(), sorted(df['month'].unique())[:3], sorted(df['month'].unique())[-1])
print(df.groupby('region')['revenue'].count())

# per region
g = df.groupby('region')['revenue'].sum()
total = g.sum()
n_months = df['month'].nunique()
res = pd.DataFrame({'total_revenue': g})
res['share_pct'] = res['total_revenue']/total*100
res['monthly_avg'] = res['total_revenue']/n_months
res = res.sort_values('total_revenue', ascending=False)
print(res)
print('grand total:', total, 'months:', n_months)

# peak month of top region
top = res.index[0]
sub = df[df['region']==top].groupby('month')['revenue'].sum()
print(top, 'peak month:', sub.idxmax(), sub.max())
print(sub)

# monthly totals per region for table
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
print(piv)

# save intermediate
out = res.reset_index()
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r0\_sandbox\tmp\region_summary.csv', index=False)
piv.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r0\_sandbox\tmp\region_monthly_revenue.csv')
sub.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r0\_sandbox\tmp\top_region_monthly.csv')
print('saved')

```
