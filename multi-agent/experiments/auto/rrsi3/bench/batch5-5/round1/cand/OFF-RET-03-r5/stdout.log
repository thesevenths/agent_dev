import pandas as pd, json
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r5\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r5\_sandbox\tmp"
df = pd.read_csv(p)

# validation
assert df.isna().sum().sum() == 0
assert df.duplicated().sum() == 0
assert (df["cohort_size"] > 0).all() and (df["dau"] > 0).all()
assert df["retention_d7"].between(0,1).all() and df["churn_rate"].between(0,1).all()
assert (df["arpu_usd"] > 0).all()
# data is clean; save validated copy
df.to_csv(out + r"\app_metrics_clean.csv", index=False)

# key stats for downstream
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]
stats = {
  "n_rows": len(df),
  "retention_median": med,
  "corr_ret_arpu": df["retention_d7"].corr(df["arpu_usd"]),
  "corr_ret_churn": df["retention_d7"].corr(df["churn_rate"]),
  "hi": {"n": len(hi), "arpu_mean": hi["arpu_usd"].mean(), "cohort_total": int(hi["cohort_size"].sum())},
  "lo": {"n": len(lo), "arpu_mean": lo["arpu_usd"].mean(), "cohort_total": int(lo["cohort_size"].sum())},
  "retention_mean": df["retention_d7"].mean(),
  "arpu_mean": df["arpu_usd"].mean(),
  "churn_mean": df["churn_rate"].mean(),
  "cohort_total_all": int(df["cohort_size"].sum()),
}
with open(out + r"\step1_stats.json", "w") as f:
    json.dump(stats, f, indent=2)
print(json.dumps(stats, indent=2))
print("saved:", out + r"\app_metrics_clean.csv", out + r"\step1_stats.json")

