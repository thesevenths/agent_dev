import pandas as pd, json

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r5\_sandbox\tmp"
df = pd.read_csv(base + r"\app_metrics_clean.csv")

# Recompute from validated CSV (single source of truth), cross-check with step1_stats.json
with open(base + r"\step1_stats.json") as f:
    s1 = json.load(f)

med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

res = {
  "as_of": "2026-10-26 09:36",
  "source_file": "offline_data/app_metrics.csv",
  "n_rows": int(len(df)),
  "retention_d7_median": float(med),
  "correlations": {
    "retention_d7_vs_arpu_usd": float(df["retention_d7"].corr(df["arpu_usd"])),
    "retention_d7_vs_churn_rate": float(df["retention_d7"].corr(df["churn_rate"])),
  },
  "groups": {
    "high_retention": {
      "definition": "retention_d7 > median (0.39575)",
      "n_rows": int(len(hi)),
      "arpu_usd_mean": float(hi["arpu_usd"].mean()),
      "cohort_size_total": int(hi["cohort_size"].sum()),
      "retention_d7_range": [float(hi["retention_d7"].min()), float(hi["retention_d7"].max())],
    },
    "low_retention": {
      "definition": "retention_d7 <= median (0.39575)",
      "n_rows": int(len(lo)),
      "arpu_usd_mean": float(lo["arpu_usd"].mean()),
      "cohort_size_total": int(lo["cohort_size"].sum()),
      "retention_d7_range": [float(lo["retention_d7"].min()), float(lo["retention_d7"].max())],
    },
  },
  "overall": {
    "arpu_usd_mean": float(df["arpu_usd"].mean()),
    "churn_rate_mean": float(df["churn_rate"].mean()),
    "retention_d7_mean": float(df["retention_d7"].mean()),
    "cohort_size_total": int(df["cohort_size"].sum()),
  },
  "derived": {
    "arpu_gap_high_minus_low": float(hi["arpu_usd"].mean() - lo["arpu_usd"].mean()),
    "arpu_gap_pct": float((hi["arpu_usd"].mean() / lo["arpu_usd"].mean() - 1) * 100),
    "cohort_share_high_pct": float(hi["cohort_size"].sum() / df["cohort_size"].sum() * 100),
  },
  "cross_check_with_step1": {
    "median_match": abs(med - s1["retention_median"]) < 1e-9,
    "corr_arpu_match": abs(df["retention_d7"].corr(df["arpu_usd"]) - s1["corr_ret_arpu"]) < 1e-9,
    "corr_churn_match": abs(df["retention_d7"].corr(df["churn_rate"]) - s1["corr_ret_churn"]) < 1e-9,
    "hi_arpu_match": abs(hi["arpu_usd"].mean() - s1["hi"]["arpu_mean"]) < 1e-9,
    "lo_arpu_match": abs(lo["arpu_usd"].mean() - s1["lo"]["arpu_mean"]) < 1e-9,
  },
}

out = base + r"\step2_results.json"
with open(out, "w") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print(json.dumps(res, indent=2, ensure_ascii=False))
print("saved:", out)

