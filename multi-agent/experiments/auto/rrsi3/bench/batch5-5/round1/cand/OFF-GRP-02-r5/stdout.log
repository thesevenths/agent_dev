imin = ct['mean_reading_score'].idxmin()
ct['is_max_mean'] = ct.index == imax
ct['is_min_mean'] = ct.index == imin

ct.to_csv(out, index=False)
print(ct.to_string(index=False))
print("\nMAX:", ct.loc[imax].to_dict())
print("MIN:", ct.loc[imin].to_dict())
print("saved:", out)

