import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out  = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r5\_sandbox\tmp\step1_inspection.json"
df = pd.read_csv(path)

ct = df.groupby(['grade','region']).agg(n=('reading_score','size'), mean_reading=('reading_score','mean')).reset_index()
ct = ct.sort_values(['grade','region'])

info = {
  "file": path,
  "shape": list(df.shape),
  "columns": list(df.columns),
  "nulls": {c:int(v) for c,v in df.isnull().sum().items()},
  "grade_values": sorted(df['grade'].unique().tolist()),
  "region_values": sorted(df['region'].unique().tolist()),
  "reading_score": {k: float(v) for k,v in df['reading_score'].describe().items()},
  "cross_tab": ct.to_dict('records'),
}
with open(out,'w',encoding='utf-8') as f:
    json.dump(info,f,ensure_ascii=False,indent=2)
print(ct.to_string(index=False))
print("saved:", out)

