import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r5\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r5\_sandbox\tmp\step2_crosstab.csv"

df = pd.read_csv(src)
ct = (df.groupby(['grade','region'])
          .agg(row_count=('reading_score','size'),
               mean_reading_score=('reading_score','mean'))
          .reset_index()
          .sort_values(['grade','region']))
ct['mean_reading_score'] = ct['mean_reading_score'].round(6)

imax = ct['mean_reading_score'].idxmax()
imin = ct['mean_reading_score'].idxmin()
ct['is_max_mean'] = ct.index == imax
ct['is_min_mean'] = ct.index == imin

ct.to_csv(out, index=False)
print(ct.to_string(index=False))
print("\nMAX:", ct.loc[imax].to_dict())
print("MIN:", ct.loc[imin].to_dict())
print("saved:", out)

