 "2025-03"]\ne_other_units_avg = e_other.groupby("month")["units"].sum().mean()\ne_other_ret_avg = e_other.groupby("month")["returns"].sum().mean()\ne_mar_units_ratio = e_mar_units / e_other_units_avg\ne_mar_ret_ratio = e_mar_ret / e_other_ret_avg\n\n# E Accessory: 2025-03 vs its other 23 months\ne_acc = raw[(raw["region"] == "E") & (raw["product_line"] == "Accessory")]\ne_acc_mar = e_acc[e_acc["month"] == "2025-03"].iloc[0]\ne_acc_other = e_acc[e_acc["month"] != "2025-03"]\ne_acc_other_units_avg = e_acc_other["units"].mean()\ne_acc_other_ret_avg = e_acc_other["returns"].mean()\ne_acc_units_ratio = e_acc_mar["units"] / e_acc_other_units_avg\ne_acc_ret_ratio = e_acc_mar["returns"] / e_acc_other_ret_avg\n\n# E Service / Hardware same-month context\ndef ctx(region, pl):\n    d = raw[(raw["region"] == region) & (raw["product_line"] == pl)]\n    m = d[d["month"] == "2025-03"].iloc[0]\n    o = d[d["month"] != "2025-03"]\n    return m, o["units"].mean(), o["returns"].mean()\n\ne_svc_mar, e_svc_units_avg, e_svc_ret_avg = ctx("E", "Service")\ne_hw_mar, e_hw_units_avg, e_hw_ret_avg = ctx("E", "Hardware")\n\n# return rates\ndef rr(row):\n    return row["returns"] / row["units"]\n\nrows = []\nfor _, r in top3.iterrows():\n    rows.append({\n        "month": r["month"], "region": r["region"], "product_line": r["product_line"],\n        "units": int(r["units"]), "mean_24m": round(r["mean_24m"], 2),\n        "ratio": round(r["ratio"], 4), "returns": int(r["returns"]),\n        "return_rate": f"{rr(r)*100:.2f}%",\n    })\ntab = pd.DataFrame(rows)\n\n# ---- build markdown ----\nmd = []\nmd.append("# 区域×产品线单月放量异常分析报告")\nmd.append("")\nmd.append("AS_OF: 2026-10-25 12:29（本地离线数据，非实时；数据区间 2024-01 至 2025-12，来源：offline_data/regional_sales.csv 的 month，min/max 聚合，样本 288 行）")\nmd.append("")\nmd.append("## 一、分析背景与方法")\nmd.append("")\nmd.append(f"本报告基于本地文件 offline_data/regional_sales.csv（样本 {n_raw} 行，覆盖 4 个区域 × 3 条产品线 × 24 个月）"\n          f"（来源：offline_data/regional_sales.csv 的 month/region/product_line，去重计数，样本 {n_raw} 行）。"\n          "对每个「区域×产品线」组合，计算其月度销量（units）相对自身 24 个月滚动均值（trailing，min_periods=1）的倍数 ratio = units / mean_24m，"\n          "取倍数最大的前三个组合，并结合对应月份的退货率（returns/units）判断放量性质。"\n          "全部结论仅来自上述本地 CSV，未使用任何外部数据。")\nmd.append("")\nmd.append("## 二、Top-3 放量异常一览")\nmd.append("")\nmd.append("| 月份 | 区域 | 产品线 | 当月销量 units | 24 个月均值 mean_24m | 倍数 ratio | 当月退货数 returns | 当月退货率 |")\nmd.append("|---|---|---|---|---|---|---|---|")\nfor _, r in tab.iterrows():\n    md.append(f"| {r[\'month\']} | {r[\'region\']} | {r[\'product_line\']} | {r[\'units\']:,} | {r[\'mean_24m\']:,.2f} | {r[\'ratio\']:.4f} | {r[\'returns\']:,} | {r[\'return_rate\']} |")\nmd.append("")\nmd.append(f"- 当月销量 units：（来源：offline_data/regional_sales.csv 的 units，按 month×region×product_line 单行取值，样本 {n_raw} 行）")\nmd.append(f"- 24 个月均值 mean_24m：（来源：offline_data/regional_sales.csv 的 units，按 region×product_line 分组做 24 个月滚动均值 min_periods=1，样本 {n_raw} 行；计算结果存于 offline_data/ratio_analysis.csv 的 mean_24m 列）")\nmd.append("- 倍数 ratio：（来源：由前述两行计算，ratio = units / mean_24m）")\nmd.append(f"- 当月退货数 returns：（来源：offline_data/regional_sales.csv 的 returns，按 month×region×product_line 单行取值，样本 {n_raw} 行）")\nmd.append("- 当月退货率：（来源：由前述两行计算，return_rate = returns / units）")\nmd.append("")\nmd.append("## 三、异常背景与信号分析")\nmd.append("")\nmd.append("### 3.1 三条异常同月同区集中出现")\nmd.append("")\nmd.append(f"Top-3 异常全部落在 2025-03、区域 E，且覆盖 E 区全部三条产品线"\n          f"（来源：offline_data/ratio_analysis.csv 的 month/region/product_line，ratio 降序取前 3，样本 288 行）。"\n          f"区域 E 当月三条产品线合计销量 {e_mar_units:,} 件，为 E 区其余 23 个月月均合计 {e_other_units_avg:,.1f} 件的 {e_mar_units_ratio:.2f} 倍"\n          f"（来源：offline_data/regional_sales.csv 的 units，region=E 且 month=2025-03 求和 vs region=E 且 month≠2025-03 按月求和后取均值，样本 {n_e} 行）；"\n          f"当月退货合计 {e_mar_ret} 件，为其余月份月均 {e_other_ret_avg:.1f} 件的 {e_mar_ret_ratio:.2f} 倍"\n          f"（来源：offline_data/regional_sales.csv 的 returns，同上口径，样本 {n_e} 行）。")\nmd.append("")\nmd.append("### 3.2 逐条判断")\nmd.append("")\nmd.append(f"**① E × Accessory（2025-03）**：当月销量 {int(e_acc_mar[\'units\']):,} 件，为其自身其余 23 个月均值 {e_acc_other_units_avg:,.1f} 件的 {e_acc_units_ratio:.2f} 倍"\n          f"（来源：offline_data/regional_sales.csv 的 units，region=E 且 product_line=Accessory，样本 {n_e_acc} 行）；"\n          f"当月退货 {int(e_acc_mar[\'returns\'])} 件，为其余月份均值 {e_acc_other_ret_avg:.1f} 件的 {e_acc_ret_ratio:.2f} 倍，"\n          f"当月退货率 {rr(e_acc_mar)*100:.2f}%（来源：offline_data/regional_sales.csv 的 returns/units，同上口径）。"\n          "销量与退货同步放大、退货率未显著抬升，且为 E 区三线同步放量的一部分——更像**渠道压货**：经销商集中进货推高账面销量，"\n          "部分商品随后以退货形式回流，而非终端需求自然增长。")\nmd.append("")\nmd.append(f"**② E × Service（2025-03）**：当月销量 {int(e_svc_mar[\'units\']):,} 件，为其余 23 个月均值 {e_svc_units_avg:,.1f} 件的 {e_svc_mar[\'units\']/e_svc_units_avg:.2f} 倍"\n          f"（来源：offline_data/regional_sales.csv 的 units，region=E 且 product_line=Service，样本 {n_e_svc} 行）；"\n          f"当月退货 {int(e_svc_mar[\'returns\'])} 件，退货率 {rr(e_svc_mar)*100:.2f}%，与其余月份均值 {e_svc_ret_avg:.1f} 件基本持平"\n          f"（来源：offline_data/regional_sales.csv 的 returns，同上口径）。"\n          "服务类商品几乎无退货、退货率极低，单看退货信号无法区分；但其与 E 区另外两条产品线在同一月份同步放量，"\n          "更符合区域级渠道行为（如季度冲量/压货带动服务打包销售），判断为**偏渠道压货**，证据强度中等。")\nmd.append("")\nmd.append(f"**③ E × Hardware（2025-03）**：当月销量 {int(e_hw_mar[\'units\']):,} 件，为其余 23 个月均值 {e_hw_units_avg:,.1f} 件的 {e_hw_mar[\'units\']/e_hw_units_avg:.2f} 倍"\n          f"（来源：offline_data/regional_sales.csv 的 units，region=E 且 product_line=Hardware，样本 {n_e_hw} 行）；"\n          f"当月退货 {int(e_hw_mar[\'returns\'])} 件，为其余月份均值 {e_hw_ret_avg:.1f} 件的 {e_hw_mar[\'returns\']/e_hw_ret_avg:.2f} 倍，"\n          f"当月退货率 {rr(e_hw_mar)*100:.2f}%（来源：offline_data/regional_sales.csv 的 returns/units，同上口径）。"\n          "硬件退货绝对量与退货率同步明显抬升，是三条产品线中退货信号最强的一条——压货后商品滞销、退货回流的特征明显，判断为**渠道压货**。")\nmd.append("")\nmd.append("## 四、结论")\nmd.append("")\nmd.append("2025-03 区域 E 的三条产品线（Accessory、Service、Hardware）在同一月份同步出现 1.55–1.65 倍的单月放量，"\n          "且 E 区当月退货合计放大至其余月份月均的约 2 倍、其中 Hardware 与 Accessory 的退货率明显抬升。"\n          "三