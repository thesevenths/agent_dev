```python

import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-STAT-02-r1\_sandbox"
out_dir = os.path.join(base, "tmp")
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))

m = df["math_score"]; r = df["reading_score"]
n = len(df)
missing = int(df[["math_score","reading_score"]].isna().sum().sum())

def stats(s):
    mean = s.mean(); std = s.std(ddof=1); med = s.median()
    return dict(mean=float(mean), std_sample=float(std), std_pop=float(s.std(ddof=0)),
                median=float(med), cv_sample=float(std/mean), cv_pop=float(s.std(ddof=0)/mean),
                min=int(s.min()), max=int(s.max()))

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": n, "missing_values": missing,
    "math_score": stats(m),
    "reading_score": stats(r),
    "pearson_corr": float(m.corr(r, method="pearson")),
    "std_convention": "std_sample = sample std (ddof=1); std_pop = population std (ddof=0)",
}
with open(os.path.join(out_dir, "step1_stats.json"), "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
