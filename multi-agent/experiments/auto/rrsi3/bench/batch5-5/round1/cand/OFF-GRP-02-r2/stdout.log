import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r2\_sandbox\offline_data\students.csv"
out  = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r2\_sandbox\tmp\step2_crosstab.csv"

df = pd.read_csv(path)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g.columns = ['grade','region','row_count','mean_reading_score']
g['mean_reading_score'] = g['mean_reading_score'].round(4)
g = g.sort_values(['grade','region']).reset_index(drop=True)
g.to_csv(out, index=False)
print(g.to_string(index=False))

mx = g.loc[g['mean_reading_score'].idxmax()]
mn = g.loc[g['mean_reading_score'].idxmin()]
print("\nMAX:", mx.to_dict())
print("MIN:", mn.to_dict())
print("diff:", round(mx['mean_reading_score']-mn['mean_reading_score'],4))
print("total rows:", g['row_count'].sum())

```
