import pandas as json
import json

df = pd.read_csv("offline_data/students.csv")
print(df.shape)
print(df[["study_hours_per_week","math_score"]].describe())
print("nulls:", df[["study_hours_per_week","math_score"]].isna().sum().to_dict())

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)
g = df.groupby("group")["math_score"].agg(n="count", mean="mean", std="std", min="min", max="max")
print(g)

low_mean = g.loc["low","mean"]; high_mean = g.loc["high","mean"]
gain = high_mean - low_mean
print("gain:", gain, "ratio:", gain/low_mean)

out = {
  "total_rows": int(len(df)),
  "groups": {k: {"n": int(v["n"]), "mean": round(v["mean"],4), "std": round(v["std"],4), "min": float(v["min"]), "max": float(v["max"])} for k,v in g.iterrows()},
  "low_to_high_gain": round(gain,4),
  "low_to_high_gain_pct_of_low": round(gain/low_mean*100,4),
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-03-r2\_sandbox\tmp\group_stats.json","w") as f:
    json.dump(out, f, indent=2)
print(json.dumps(out, indent=2))

