import pandas as pd
import json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]

first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std, pandas default

results = {
    "first30_mean": first30.mean(),
    "first30_std": first30.std(ddof=1),
    "last30_mean": last30.mean(),
    "last30_std": last30.std(ddof=1),
    "diff_last30_minus_first30": last30.mean() - first30.mean(),
    "overall_mean": overall_mean,
    "overall_std": overall_std,
    "threshold_mean_minus_2std": overall_mean - 2 * overall_std,
    "weeks_below_threshold": int((r < overall_mean - 2 * overall_std).sum()),
    "n_first30": len(first30),
    "n_last30": len(last30),
    "n_total": len(r),
}

# also list which weeks are below threshold
below = df[r < overall_mean - 2 * overall_std][["week", "retention_d7"]]
print(json.dumps(results, indent=2))
print("\nWeeks below threshold:")
print(below.to_string(index=False))

# save to CSV
