import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

g = df.groupby(['grade', 'region'], observed=True).agg(
    row_count=('reading_score', 'size'),
    mean_reading_score=('reading_score', 'mean')
).reset_index()

# order rows nicely
grade_order = ['G10', 'G11', 'G12']
region_order = ['A', 'B', 'C', 'D']
g['_go'] = g['grade'].map({v: i for i, v in enumerate(grade_order)})
g['_ro'] = g['region'].map({v: i for i, v in enumerate(region_order)})
g = g.sort_values(['_go', '_ro']).drop(columns=['_go', '_ro'])
g['mean_reading_score'] = g['mean_reading_score'].round(4)

print(g.to_string(index=False))
print("total rows:", g['row_count'].sum())

imax = g['mean_reading_score'].idxmax()
imin = g['mean_reading_score'].idxmin()
