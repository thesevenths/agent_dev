import pandas as pd, os

df = pd.read_csv('offline_data/students.csv')
g = df.groupby(['grade','region'], observed=True).agg(n=('reading_score','size'), mean=('reading_score','mean')).reset_index()
g = g.set_index(['grade','region']).reindex([(gr,rg) for gr in ['G10','G11','G12'] for rg in ['A','B','C','D']]).reset_index()

overall_n = len(df)
overall_mean = df['reading_score'].mean()
mx = g.loc[g['mean'].idxmax()]
mn = g.loc[g['mean'].idxmin()]
ratio = mx['mean']/mn['mean']
diff = mx['mean']-mn['mean']

gm = df.groupby('grade')['reading_score'].agg(['count','mean'])
rm = df.groupby('region')['reading_score'].agg(['count','mean'])

def f2(x): return f"{x:.2f}"

rows = []
for _, r in g.iterrows():
    rows.append(f"| {r['grade']} | {r['region']} | {int(r['n'])}（来源：offline_data/students.csv 的 grade & region，grade={r['grade']} & region={r['region']} 的行数，样本行数={int(r['n'])}） | {f2(r['mean'])}（来源：offline_data/students.csv 的 reading_score，grade={r['grade']} & region={r['region']} 的均值，样本行数={int(r['n'])}） |")

gm_rows = []
for gr in ['G10','G11','G12']:
    gm_rows.append(f"| {gr} | {int(gm.loc[gr,'count'])}（来源：offline_data/students.csv 的 grade，grade={gr} 的行数，样本行数={int(gm.loc[gr,'count'])}） | {f2(gm.loc[gr,'mean'])}（来源：offline_data/students.csv 的 reading_score，grade={gr} 的均值，样本行数={int(gm.loc[gr,'count'])}） |")

rm_rows = []
for rg in ['A','B','C','D']:
    rm_rows.append(f"| {rg} | {int(rm.loc[rg,'count'])}（来源：offline_data/students.csv 的 region，region={rg} 的行数，样本行数={int(rm.loc[rg,'count'])}） | {f2(rm.loc[rg,'mean'])}（来源：offline_data/students.csv 的 reading_score，region={rg} 的均值，样本行数={int(rm.loc[rg,'count'])}） |")

report = f"""# 学生成绩交叉分析报告：grade × region 对 reading_score 的影响

