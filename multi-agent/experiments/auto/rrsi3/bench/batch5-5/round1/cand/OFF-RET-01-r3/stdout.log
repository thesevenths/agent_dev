import pandas as pd, numpy as np, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-01-r3\_sandbox\tmp"
os.makedirs(base, exist_ok=True)

df = pd.read_csv(r"offline_data/app_metrics.csv")
r = df["retention_d7"]
assert len(df) == 60

first30 = r.iloc[:30]
last30 = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
below = (r < overall_mean - 2*overall_std).sum()

res = pd.DataFrame({
    "metric": ["first30_mean","first30_std","last30_mean","last30_std","diff_mean_last_minus_first",
               "overall_mean","overall_std","threshold_mean_minus_2std","weeks_below_threshold"],
    "value": [first30.mean(), first30.std(ddof=1), last30.mean(), last30.std(ddof=1),
              last30.mean()-first30.mean(), overall_mean, overall_std,
              overall_mean-2*overall_std, below]
})
out = os.path.join(base, "retention_d7_stats.csv")
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)
# also list weeks below threshold
below_weeks = df.loc[r < overall_mean - 2*overall_std, ["week","retention_d7"]]
print(below_weeks.to_string(index=False))

