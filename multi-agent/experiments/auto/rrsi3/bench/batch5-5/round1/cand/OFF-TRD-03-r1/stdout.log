import pandas as pd

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

# per-region totals
reg = df.groupby("region")["revenue"].sum()
grand = reg.sum()

# months per region
months_per_region = df.groupby("region")["month"].nunique()

# monthly revenue per region -> peak month
monthly = df.groupby(["region", "month"])["revenue"].sum().reset_index()
peak = monthly.loc[monthly.groupby("region")["revenue"].idxmax()]
peak = peak.set_index("region")

summary = pd.DataFrame({
    "total_revenue": reg,
    "share_pct": reg / grand * 100,
    "monthly_avg_revenue": reg / months_per_region,
    "peak_month": peak["month"],
    "peak_month_revenue": peak["revenue"],
})
summary = summary.loc[["N", "S", "E", "W"]]
print(summary)
print("grand total:", grand)
print("months per region:", months_per_region.to_dict())

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r1\_sandbox\tmp\regional_summary.csv"
summary.to_csv(out, encoding="utf-8")
print("saved:", out)

