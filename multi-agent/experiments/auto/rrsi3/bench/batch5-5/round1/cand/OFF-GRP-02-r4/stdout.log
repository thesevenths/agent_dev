import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r4\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r4\_sandbox\tmp\step2_crosstab_metrics.csv"

df = pd.read_csv(src)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(
    row_count='count', mean_reading_score='mean').reset_index()
g['mean_reading_score'] = g['mean_reading_score'].round(4)
g = g.sort_values(['grade','region']).reset_index(drop=True)
g.to_csv(out, index=False)
print(g.to_string(index=False))

maxc = g.loc[g['mean_reading_score'].idxmax()]
minc = g.loc[g['mean_reading_score'].idxmin()]
print("MAX:", maxc.tolist())
print("MIN:", minc.tolist())
print("diff:", round(maxc['mean_reading_score']-minc['mean_reading_score'],4))
print("overall mean:", round(df['reading_score'].mean(),4), "n=", len(df))
print("saved:", out)

```
