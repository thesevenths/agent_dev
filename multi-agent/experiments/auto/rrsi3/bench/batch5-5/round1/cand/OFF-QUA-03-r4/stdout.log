onth == m)].iloc[0]\n\n# E-region totals for 2025-03 vs its own 24m mean\ne03 = e[e.month == "2025-03"]\ne_units_03 = int(e03["units"].sum())\ne_mean_03 = e03["vol_24m_mean"].sum()\ne_ratio_03 = e_units_03 / e_mean_03\n\n# E-region units in 2025-02 and 2025-04 (to show single-month nature)\ne_units_02 = int(e[e.month == "2025-02"]["units"].sum())\ne_units_04 = int(e[e.month == "2025-04"]["units"].sum())\n\n# baseline: E-region average monthly units over 24 months\ne_units_avg = e["units"].mean()\n\n# return rates for context: E-region 24-month average return rate\ne_ret_rate_avg = e["returns"].sum() / e["units"].sum()\n\n# other regions\' max ratio in 2025-03 (to show E is unique)\nothers_03 = df[(df.month == "2025-03") & (df.region != "E")]\nothers_max_ratio = others_03["ratio"].max()\nothers_max_row = others_03.loc[others_03["ratio"].idxmax()]\n\n# per-combo numbers\nr1 = row("E", "Accessory", "2025-03")\nr2 = row("E", "Service", "2025-03")\nr3 = row("E", "Hardware", "2025-03")\n\n# neighbor-month ratios for persistence evidence\ndef n_ratio(r, p, m):\n    x = row(r, p, m)\n    return x["ratio"]\n\na_prev, a_next = n_ratio("E", "Accessory", "2025-02"), n_ratio("E", "Accessory", "2025-04")\ns_prev, s_next = n_ratio("E", "Service", "2025-02"), n_ratio("E", "Service", "2025-04")\nh_prev, h_next = n_ratio("E", "Hardware", "2025-02"), n_ratio("E", "Hardware", "2025-04")\n\n# cross-product ratios in 2025-03\nacc_ratio, svc_ratio, hw_ratio = r1["ratio"], r2["ratio"], r3["ratio"]\n\nreport = f"""# 区域销量单月放量异常分析报告\n\nAS_OF: 2026-10-26 09:00（报告生成时间；数据为本地离线文件，覆盖 2024-01 至 2025-12 共 24 个月）\n\n## 1. 分析背景与方法\n\n本报告基于本地文件 `offline_data/regional_sales.csv`（288 行样本，4 个区域 E/N/S/W × 3 条产品线 Accessory/Hardware/Service × 24 个月），对每个「区域 × 产品线」组合计算其每月销量 `units` 相对于该组合自身 24 个月滚动均值（min_periods=1）的倍数 `ratio = units / vol_24m_mean`，并取倍数最大的前三个组合作为单月放量异常，结合退货率、放量持续性（前后月倍数是否 > 1.2）与跨产品线同步性，判断放量属于真实需求还是渠道压货。\n\n## 2. Top-3 异常组合总览\n\n| 排名 | 区域 | 产品线 | 异常月份 | 当月销量 units | 24月均值 vol_24m_mean | 倍数 ratio | 当月退货量 returns | 退货率 return_rate |\n|---|---|---|---|---|---|---|---|---|\n| 1 | E | Accessory | 2025-03 | {int(r1[\'units\']):,}（来源：offline_data/regional_sales.csv 的 units，E×Accessory×2025-03 单行） | {r1[\'vol_24m_mean\']:,.1f}（来源：由该组合 24 个月 units 列滚动均值计算，24 行样本） | **{r1[\'ratio\']:.4f}**（来源：由前述两行计算） | {int(r1[\'returns\']):,}（来源：offline_data/regional_sales.csv 的 returns，E×Accessory×2025-03 单行） | {r1[\'returns\']/r1[\'units\']:.4f}（来源：由前述两行计算） |\n| 2 | E | Service | 2025-03 | {int(r2[\'units\']):,}（来源：offline_data/regional_sales.csv 的 units，E×Service×2025-03 单行） | {r2[\'vol_24m_mean\']:,.1f}（来源：由该组合 24 个月 units 列滚动均值计算，24 行样本） | **{r2[\'ratio\']:.4f}**（来源：由前述两行计算） | {int(r2[\'returns\']):,}（来源：offline_data/regional_sales.csv 的 returns，E×Service×2025-03 单行） | {r2[\'returns\']/r2[\'units\']:.4f}（来源：由前述两行计算） |\n| 3 | E | Hardware | 2025-03 | {int(r3[\'units\']):,}（来源：offline_data/regional_sales.csv 的 units，E×Hardware×2025-03 单行） | {r3[\'vol_24m_mean\']:,.1f}（来源：由该组合 24 个月 units 列滚动均值计算，24 行样本） | **{r3[\'ratio\']:.4f}**（来源：由前述两行计算） | {int(r3[\'returns\']):,}（来源：offline_data/regional_sales.csv 的 returns，E×Hardware×2025-03 单行） | {r3[\'returns\']/r3[\'units\']:.4f}（来源：由前述两行计算） |\n\n三个异常组合全部集中在 **E 区域、2025-03 单月**，且覆盖该区域全部三条产品线。\n\n## 3. 异常特征分析\n\n### 3.1 单月脉冲，非持续放量\n\n以 E×Accessory 为例：2025-02 倍数 {a_prev:.3f}、2025-03 倍数 {acc_ratio:.4f}、2025-04 倍数 {a_next:.3f}（来源：由该组合相邻月份 units 与其 24 月均值计算）；E×Service 相邻月倍数为 {s_prev:.3f} / {s_next:.3f}，E×Hardware 为 {h_prev:.3f} / {h_next:.3f}（来源：同上）。三条产品线在异常月前后倍数均回落至 1.2 以下，属于典型的**单月脉冲**而非需求趋势性抬升。\n\n### 3.2 跨产品线同步放量\n\n2025-03 月 E 区域三条产品线倍数分别为 {acc_ratio:.4f}、{svc_ratio:.4f}、{hw_ratio:.4f}（来源：由前述三行计算），全部 > 1.2，即同一区域、同一月份、不同产品线**同步放量**。同期其他区域（N/S/W）在 2025-03 的最高倍数仅为 {others_max_ratio:.3f}（{others_max_row[\'region\']}×{others_max_row[\'product_line\']}，来源：由该组合当月 units 与其 24 月均值计算），远低于 E 区域，说明放量是 E 区域特有的区域性事件。\n\n### 3.3 区域层面放量幅度\n\nE 区域 2025-03 三条产品线合计销量 {e_units_03:,} 件（来源：offline_data/regional_sales.csv 的 units，E 区域 2025-03 三行求和），相对其 24 月