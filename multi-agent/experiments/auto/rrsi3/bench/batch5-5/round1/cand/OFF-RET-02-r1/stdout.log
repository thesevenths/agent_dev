```python
import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].between('W30','W43')].copy().reset_index(drop=True)
metrics = ['retention_d7','churn_rate','arpu_usd']

# week-over-week absolute changes (W31..W43)
wow = sub[['week']].copy()
for m in metrics:
    wow[f'{m}_wow_abs'] = sub[m].diff().abs()
wow['max_wow_abs'] = wow[[f'{m}_wow_abs' for m in metrics]].max(axis=1)
wow['argmax_metric'] = wow[[f'{m}_wow_abs' for m in metrics]].idxmax(axis=1).str.replace('_wow_abs','',regex=False)

print(wow.to_string(index=False))

# breakpoint week = week with largest max week-over-week absolute change
bp_row = wow.loc[wow['max_wow_abs'].idxmax()]
bp_week = bp_row['week']
print("\nbreakpoint week:", bp_week)

# before/after means
before = sub[sub['week'] <= 'W36'][metrics].mean()
after  = sub[sub['week'] >= 'W37'][metrics].mean()
n_b, n_a = (sub['week'] <= 'W36').sum(), (sub['week'] >= 'W37').sum()

rows = []
for m in metrics:
    b, a = before[m], after[m]
    rows.append({
        'metric': m,
        'before_mean_W30_W36': round(b,6),
        'after_mean_W37_W43': round(a,6),
        'abs_delta_after_minus_before': round(a-b,6),
        'rel_delta_pct': round((a-b)/b*100,4),
        'n_before': int(n_b), 'n_after': int(n_a),
    })
res = pd.DataFrame(rows)
print(res.to_string(index=False))

# breakpoint week detail (W36 -> W37)
w36 = sub[sub['week']=='W36'].iloc[0]
w37 = sub[sub['week']=='W37'].iloc[0]
detail = pd.DataFrame([
    {'metric': m, 'W36': w36[m], 'W37': w37[m], 'wow_abs_change': abs(w37[m]-w36[m])}
    for m in metrics
])
print(detail.to_string(index=False))

out = pd.concat([
    pd.DataFrame([{'item':'breakpoint_week','value':bp_week}]),
    pd.DataFrame([{'item':'breakpoint_wow_metric','value':bp_row['argmax_metric']}]),
    pd.DataFrame([{'item':'breakpoint_wow_abs_change','value':round(bp_row['max_wow_abs'],6)}]),
    res.assign(item=res['metric']),
], ignore_index=True)
outpath = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r1\_sandbox\tmp\breakpoint_result.csv"
out.to_csv(outpath, index=False)
print("\nsaved:", outpath)

