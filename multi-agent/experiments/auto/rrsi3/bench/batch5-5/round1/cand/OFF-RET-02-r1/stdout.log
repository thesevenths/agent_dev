import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].between('W30','W43')].copy().reset_index(drop=True)
metrics = ['retention_d7','churn_rate','arpu_usd']
sub['group'] = sub['week'].apply(lambda w: 'W30–W36' if w <= 'W36' else 'W37–W43')

before = sub[sub['week'] <= 'W36'][metrics].mean()
after  = sub[sub['week'] >= 'W37'][metrics].mean()

# build per-week table rows
rows = []
for _, r in sub.iterrows():
    rows.append(f"| {r['week']} | {r['group']} | {r['retention_d7']:.4f} | {r['churn_rate']:.4f} | {r['arpu_usd']:.3f} |")
weekly_table = "\n".join(rows)

# group mean rows with diffs
mean_rows = []
for m in metrics:
    b, a = before[m], after[m]
    d = a - b
    rel = d / b * 100
    mean_rows.append(f"| {m} | {b:.6f} | {a:.6f} | {d:+.6f} | {rel:+.2f}% |")
mean_table = "\n".join(mean_rows)

# W36 -> W37 jump rows
w36 = sub[sub['week']=='W36'].iloc[0]
w37 = sub[sub['week']=='W37'].iloc[0]
jump_rows = []
for m in metrics:
    jump_rows.append(f"| {m} | {w36[m]:.4f} | {w37[m]:.4f} | {abs(w37[m]-w36[m]):.4f} |")
jump_table = "\n".join(jump_rows)

report = f"""# App 留存断点分析报告（W30–W43）

