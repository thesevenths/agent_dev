import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker

OUT = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r1\_sandbox\tmp"

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].between('W30','W43')].copy().reset_index(drop=True)
metrics = ['retention_d7','churn_rate','arpu_usd']
labels = {'retention_d7':'retention_d7','churn_rate':'churn_rate','arpu_usd':'arpu_usd'}

# ---------- Chart 1: per-week lines, 3 subplots, breakpoint W37 annotated ----------
fig, axes = plt.subplots(3, 1, figsize=(10, 10), sharex=True)
for ax, m in zip(axes, metrics):
    ax.plot(sub['week'], sub[m], marker='o', lw=1.8, color='#1f77b4')
    # shade after-breakpoint region
    ax.axvspan(6.5, 13.5, color='#d62728', alpha=0.08)
    ax.axvline(6.5, color='#d62728', ls='--', lw=1.2)
    # annotate W37 point
    w37_val = sub.loc[sub['week']=='W37', m].iloc[0]
    w36_val = sub.loc[sub['week']=='W36', m].iloc[0]
    ax.annotate(f'W37: {w37_val:.4g}\n(W36: {w36_val:.4g})',
                xy=(6, w37_val), xytext=(7.5, w37_val + (w37_val-w36_val)*0.9),
                fontsize=8, color='#d62728',
                arrowprops=dict(arrowstyle='->', color='#d62728', lw=0.8))
    ax.set_ylabel(m, fontsize=10)
    ax.grid(alpha=0.3)
    ax.set_title(f'{m} — W30–W43 (breakpoint: W37)', fontsize=11, loc='left')
axes[-1].set_xlabel('week')
fig.suptitle('Per-week metrics W30–W43 with breakpoint week W37 annotated', fontsize=13)
fig.tight_layout(rect=[0, 0, 1, 0.97])
p1 = f"{OUT}\\chart_weekly_breakpoint.png"
fig.savefig(p1, dpi=130)
plt.close(fig)

# ---------- Chart 2: grouped bar of group means ----------
before = sub[sub['week'] <= 'W36'][metrics].mean()
after  = sub[sub['week'] >= 'W37'][metrics].mean()

fig, axes = plt.subplots(1, 3, figsize=(12, 4.5))
for ax, m in zip(axes, metrics):
    bars = ax.bar(['W30–W36\n(n=7)', 'W37–W43\n(n=7)'], [before[m], after[m]],
                  color=['#2ca02c', '#d62728'], width=0.5)
    for b, v in zip(bars, [before[m], after[m]]):
        ax.text(b.get_x()+b.get_width()/2, v, f'{v:.4g}', ha='center', va='bottom', fontsize=10)
    delta = after[m]-before[m]
    rel = delta/before[m]*100
    ax.set_title(f'{m}\nΔ = {delta:+.4g} ({rel:+.2f}%)', fontsize=10)
    ax.grid(axis='y', alpha=0.3)
    ax.set_ylim(0, max(before[m], after[m])*1.18)
fig.suptitle('Group means: W30–W36 vs W37–W43', fontsize=13)
fig.tight_layout(rect=[0, 0, 1, 0.93])
p2 = f"{OUT}\\chart_group_means.png"
fig.savefig(p2, dpi=130)
plt.close(fig)

