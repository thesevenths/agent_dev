import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].between('W30','W43')].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if w <= 'W36' else 'W37-W43')

metrics = ['retention_d7','churn_rate','arpu_usd']

# per-week series
weekly = sub[['week','group'] + metrics].copy()

# group means
means = sub.groupby('group')[metrics].mean().reset_index()
means.columns = ['group'] + [f'{m}_mean' for m in metrics]

# diff (after - before) and relative change
before = means[means['group']=='W30-W36'].iloc[0]
after  = means[means['group']=='W37-W43'].iloc[0]
diff_rows = []
for m in metrics:
    b, a = before[f'{m}_mean'], after[f'{m}_mean']
    diff_rows.append({'metric': m, 'W30-W36_mean': b, 'W37-W43_mean': a,
                      'diff_after_minus_before': a-b, 'rel_change_pct': (a-b)/b*100})
diff = pd.DataFrame(diff_rows)

# save combined CSV
out = pd.concat([
    weekly.assign(**{f'{m}_mean': None for m in metrics}),
], ignore_index=True)
# simpler: write two sections into one CSV with a 'section' column
weekly_out = weekly.copy(); weekly_out.insert(0,'section','weekly')
means_out = means.copy(); means_out.insert(0,'section','group_mean')
diff_out = diff.copy(); diff_out.insert(0,'section','diff')

# unify columns
cols = ['section','week','group','metric','retention_d7','churn_rate','arpu_usd',
        'retention_d7_mean','churn_rate_mean','arpu_usd_mean',
        'W30-W36_mean','W37-W43_mean','diff_after_minus_before','rel_change_pct']
weekly_out = weekly_out.reindex(columns=cols)
means_out = means_out.reindex(columns=cols)
diff_out = diff_out.reindex(columns=cols)
combined = pd.concat([weekly_out, means_out, diff_out], ignore_index=True)

outpath = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r1\_sandbox\tmp\breakpoint_summary.csv"
combined.to_csv(outpath, index=False)

print(weekly.to_string(index=False))
print()
print(means.to_string(index=False))
print()
print(diff.to_string(index=False))
print("\nsaved:", outpath)

```
