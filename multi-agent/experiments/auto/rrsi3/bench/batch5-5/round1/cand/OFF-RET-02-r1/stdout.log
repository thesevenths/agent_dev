```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r1\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r1\_sandbox\tmp"
df = pd.read_csv(path)
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

sub = df[df['week'].isin([f'W{i:02d}' for i in range(30,44)])].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')

# per-week table with week-over-week deltas
per = sub[['week','group'] + metrics].copy()
for m in metrics:
    per[f'{m}_wow_delta'] = per[m].diff()
per.to_csv(f"{out}\\step2_per_week.csv", index=False)

# group means
means = sub.groupby('group')[metrics].mean().round(6)
counts = sub.groupby('group').size()
print("counts:\n", counts)
print("\nmeans:\n", means)

# absolute & relative diffs (after - before)
after = means.loc['W37-W43']; before = means.loc['W30-W36']
diff = pd.DataFrame({
    'before_W30_W36': before,
    'after_W37_W43': after,
    'abs_diff_after_minus_before': after - before,
    'rel_diff_pct': (after - before) / before * 100,
})
print("\ndiff table:\n", diff.round(4))

# breakpoint scan: largest week-over-week absolute change in each metric within W30-W43
print("\nWoW deltas:")
print(per[['week'] + [f'{m}_wow_delta' for m in metrics]].round(4).to_string(index=False))

# save summary CSV
summary = diff.reset_index().rename(columns={'index':'metric'})
summary.to_csv(f"{out}\\step2_group_means_diff.csv", index=False)
print("\nsaved files")

```
