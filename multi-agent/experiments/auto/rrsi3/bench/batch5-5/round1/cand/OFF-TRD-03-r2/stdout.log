import pandas as pd

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r2\_sandbox"
df = pd.read_csv(f"{base}\\offline_data\\regional_sales.csv")

region_total = df.groupby('region')['revenue'].sum()
grand_total = df['revenue'].sum()
print("grand total:", grand_total)

# peak month per region
peak = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak_idx = peak.loc[peak.groupby('region')['revenue'].idxmax()]
print(peak_idx.to_string())

rows = []
for r in ['N','S','E','W']:
    t = region_total[r]
    pm = peak_idx[peak_idx['region']==r].iloc[0]
    rows.append({
        'region': r,
        'total_revenue': round(t,2),
        'share_pct': round(t/grand_total*100,4),
        'monthly_avg_revenue': round(t/24,2),
        'peak_month': pm['month'],
        'peak_month_revenue': round(pm['revenue'],2),
    })
out = pd.DataFrame(rows)
print(out.to_string(index=False))

out_path = f"{base}\\tmp\\regional_summary.csv"
out.to_csv(out_path, index=False)
print("saved:", out_path)

```
