import pandas as pd, json

# Verify against raw CSV (allowed: "verify against the raw CSV if needed")
df = pd.read_csv("offline_data/students.csv")
hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

def stats(g):
    return {"n": int(len(g)),
            "math_mean": round(float(g["math_score"].mean()), 2),
            "reading_mean": round(float(g["reading_score"].mean()), 2)}

hi_s, lo_s = stats(hi), stats(lo)
print("hi:", hi_s)
print("lo:", lo_s)
print("diff_math:", round(hi_s["math_mean"] - lo_s["math_mean"], 2))
print("diff_reading:", round(hi_s["reading_mean"] - lo_s["reading_mean"], 2))

out = {
    "source_file": "offline_data/students.csv",
    "split_rule": "screen_hours_per_day > 5 (high) vs screen_hours_per_day <= 5 (low)",
    "total_rows": int(len(df)),
    "high_screen": {
        **hi_s,
        "source": "offline_data/students.csv 的 screen_hours_per_day / math_score / reading_score，筛选 screen_hours_per_day > 5，n=173 行，均值口径为算术平均"
    },
    "low_screen": {
        **lo_s,
        "source": "offline_data/students.csv 的 screen_hours_per_day / math_score / reading_score，筛选 screen_hours_per_day <= 5，n=227 行，均值口径为算术平均"
    },
    "mean_diff_high_minus_low": {
        "math": round(hi_s["math_mean"] - lo_s["math_mean"], 2),
        "reading": round(hi_s["reading_mean"] - lo_s["reading_mean"], 2),
        "source": "由前述两行计算（高组均值 − 低组均值）"
    },
    "verified_against_raw_csv": True
}

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r3\_sandbox\tmp\step2_group_comparison.json"
with open(path, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved:", path)
print(json.dumps(out, indent=2, ensure_ascii=False))

