```python
import pandas as pd, json, os

df = pd.read_csv("offline_data/students.csv")
n = len(df)
missing = df[["screen_hours_per_day","math_score","reading_score"]].isna().sum().sum()

r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

res = {
    "n_rows": int(n),
    "missing_cells": int(missing),
    "corr_screen_math": round(float(r_math), 4),
    "corr_screen_reading": round(float(r_read), 4),
    "hi": {"n": int(len(hi)), "math_mean": round(float(hi["math_score"].mean()),2), "reading_mean": round(float(hi["reading_score"].mean()),2)},
    "lo": {"n": int(len(lo)), "math_mean": round(float(lo["math_score"].mean()),2), "reading_mean": round(float(lo["reading_score"].mean()),2)},
}
res["diff_math"] = round(res["hi"]["math_mean"] - res["lo"]["math_mean"], 2)
res["diff_reading"] = round(res["hi"]["reading_mean"] - res["lo"]["reading_mean"], 2)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
with open(os.path.join(out_dir, "step1_correlations.json"), "w") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print(json.dumps(res, indent=2))

