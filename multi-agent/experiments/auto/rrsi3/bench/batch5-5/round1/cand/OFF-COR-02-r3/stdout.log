r_read = df["screen_hours_per_day"].corr(df["reading_score"])
# significance: t-test for correlation
import math
def corr_p(r, n):
    t = r * math.sqrt((n-2)/(1-r*r))
    return t
t_math = corr_p(r_math, n)
t_read = corr_p(r_read, n)
