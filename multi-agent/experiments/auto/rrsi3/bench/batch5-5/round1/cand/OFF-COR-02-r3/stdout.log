import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
# significance: t-test for correlation
import math
def corr_p(r, n):
    t = r * math.sqrt((n-2)/(1-r*r))
    return t
t_math = corr_p(r_math, n)
t_read = corr_p(r_read, n)
from scipy import stats
p_math = 2*stats.t.sf(abs(t_math), n-2)
p_read = 2*stats.t.sf(abs(t_read), n-2)
out = {
  "n": n,
  "pearson_screen_math": round(r_math, 6),
  "pearson_screen_reading": round(r_read, 6),
  "t_screen_math": round(t_math, 4), "p_screen_math": float(f"{p_math:.3e}"),
  "t_screen_reading": round(t_read, 4), "p_screen_reading": float(f"{p_read:.3e}"),
}
print(json.dumps(out, indent=2))
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r3\_sandbox\tmp\step2_correlations.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

```
