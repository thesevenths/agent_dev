import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df.screen_hours_per_day > 5).map({True:"screen>5", False:"screen<=5"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    screen_mean=("screen_hours_per_day","mean"),
    math_mean=("math_score","mean"),
    reading_mean=("reading_score","mean"),
    math_std=("math_score","std"),
    reading_std=("reading_score","std"),
)
print(g)
hi, lo = g.loc["screen>5"], g.loc["screen<=5"]
out = {
  "groups": {
    "screen>5":  {"n": int(hi.n), "screen_mean": round(hi.screen_mean,4), "math_mean": round(hi.math_mean,4), "reading_mean": round(hi.reading_mean,4), "math_std": round(hi.math_std,4), "reading_std": round(hi.reading_std,4)},
    "screen<=5": {"n": int(lo.n), "screen_mean": round(lo.screen_mean,4), "math_mean": round(lo.math_mean,4), "reading_mean": round(lo.reading_mean,4), "math_std": round(lo.math_std,4), "reading_std": round(lo.reading_std,4)},
  },
  "diff_high_minus_low": {
    "math": round(hi.math_mean - lo.math_mean, 4),
    "reading": round(hi.reading_mean - lo.reading_mean, 4),
  }
}
print(json.dumps(out, indent=2))
