import pandas as pd, os, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

df["group"] = df["screen_hours_per_day"].apply(lambda x: "high(>5)" if x > 5 else "low(<=5)")
g = df.groupby("group").agg(
    n=("student_id", "count"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
    mean_screen=("screen_hours_per_day", "mean"),
).reindex(["low(<=5)", "high(>5)"])
print(g)

low, high = g.loc["low(<=5)"], g.loc["high(>5)"]
diff_math = high["mean_math"] - low["mean_math"]
diff_reading = high["mean_reading"] - low["mean_reading"]

out = {
    "source_file": path,
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "groups": {
        "low(<=5)": {
            "n": int(low["n"]),
            "mean_math_score": round(float(low["mean_math"]), 4),
