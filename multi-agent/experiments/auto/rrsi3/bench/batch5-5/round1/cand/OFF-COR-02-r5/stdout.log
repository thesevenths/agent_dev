import pandas as pd, os, json
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
n = len(df)

results = []
for col in ["math_score", "reading_score"]:
    r, p = stats.pearsonr(df["screen_hours_per_day"], df[col])
    results.append({
        "pair": f"screen_hours_per_day vs {col}",
        "pearson_r": round(r, 6),
        "p_value": float(p),
        "n": n,
    })

out = {
    "source_file": path,
    "n_rows": n,
    "method": "Pearson correlation (scipy.stats.pearsonr)",
    "correlations": results,
}
print(json.dumps(out, indent=2))

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r5\_sandbox\tmp"
jpath = os.path.join(out_dir, "step2_correlations.json")
with open(jpath, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)

cpath = os.path.join(out_dir, "step2_correlations.csv")
pd.DataFrame(results).to_csv(cpath, index=False)
print("saved:", jpath)
print("saved:", cpath)

```
