    json.dump(out, f, indent=2, ensure_ascii=False)
cpath = os.path.join(out_dir, "step3_group_stats.csv")
g.round(4).reset_index().to_csv(cpath, index=False)
print("saved:", jpath)
print("saved:", cpath)

