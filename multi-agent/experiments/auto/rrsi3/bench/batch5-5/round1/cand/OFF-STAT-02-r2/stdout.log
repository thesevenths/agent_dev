import pandas as pd, json, numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-STAT-02-r2\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-STAT-02-r2\_sandbox\tmp"

df = pd.read_csv(path)
m = df['math_score']; r = df['reading_score']

def stats(s):
    return {
        'n': int(s.count()),
        'mean': float(s.mean()),
        'std_sample': float(s.std(ddof=1)),
        'std_pop': float(s.std(ddof=0)),
        'median': float(s.median()),
        'min': float(s.min()),
        'max': float(s.max()),
        'cv_sample': float(s.std(ddof=1)/s.mean()),
        'cv_pop': float(s.std(ddof=0)/s.mean()),
    }

res = {
    'source_file': 'offline_data/students.csv',
    'n_rows': int(len(df)),
    'n_missing_math': int(df['math_score'].isna().sum()),
    'n_missing_reading': int(df['reading_score'].isna().sum()),
    'math_score': stats(m),
    'reading_score': stats(r),
    'pearson_corr': float(np.corrcoef(m, r)[0,1]),
    'pearson_corr_pandas': float(m.corr(r)),
}
with open(out_dir + r'\stats_results.json','w',encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
