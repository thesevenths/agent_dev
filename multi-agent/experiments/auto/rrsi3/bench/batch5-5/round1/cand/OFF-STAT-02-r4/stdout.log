import pandas as pd, json, numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-STAT-02-r4\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-STAT-02-r4\_sandbox\tmp\stats_results.json"

df = pd.read_csv(path)
m, r = df['math_score'], df['reading_score']

res = {
    "source_file": "offline_data/students.csv",
    "n_rows": int(len(df)),
    "n_math": int(m.notna().sum()),
    "n_reading": int(r.notna().sum()),
    "math_score": {
        "mean": float(m.mean()),
        "std_sample": float(m.std(ddof=1)),
        "std_pop": float(m.std(ddof=0)),
        "median": float(m.median()),
        "min": int(m.min()), "max": int(m.max()),
        "cv_sample": float(m.std(ddof=1)/m.mean()),
        "cv_pop": float(m.std(ddof=0)/m.mean()),
    },
    "reading_score": {
        "mean": float(r.mean()),
        "std_sample": float(r.std(ddof=1)),
        "std_pop": float(r.std(ddof=0)),
        "median": float(r.median()),
        "min": int(r.min()), "max": int(r.max()),
        "cv_sample": float(r.std(ddof=1)/r.mean()),
        "cv_pop": float(r.std(ddof=0)/r.mean()),
    },
    "pearson_r": float(m.corr(r, method='pearson')),
}
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
