sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# rolling 7-week mean of retention_d7, breakpoint = week where rolling mean drops most
sub['ret_rolling7'] = sub['retention_d7'].rolling(7).mean()
sub['ret_rolling7_wow'] = sub['ret_rolling7'].diff()
print(sub[['week','group','retention_d7','ret_rolling7','ret_rolling7_wow']].to_string(index=False))

# W36->W37 jump magnitude vs typical within-group weekly variation
import numpy as np
g1 = sub[sub['group']=='W30-W36']['retention_d7'].diff().dropna()
g2 = sub[sub['group']=='W37-W43']['retention_d7'].diff().dropna()
jump = sub.loc[sub['week']=='W37','retention_d7'].iloc[0] - sub.loc[sub['week']=='W36','retention_d7'].iloc[0]
print("\nW36->W37 jump:", round(jump,4))
print("W30-W36 weekly std:", round(g1.std(),4), "mean abs:", round(g1.abs().mean(),4))
print("W37-W43 weekly std:", round(g2.std(),4), "mean abs:", round(g2.abs().mean(),4))
print("jump / within-group mean abs weekly change (W30-W36):", round(jump/g1.abs().mean(),2))

# churn jump
jump_c = sub.loc[sub['week']=='W37','churn_rate'].iloc[0] - sub.loc[sub['week']=='W36','churn_rate'].iloc[0]
g1c = sub[sub['group']=='W30-W36']['churn_rate'].diff().dropna()
print("\nW36->W37 churn jump:", round(jump_c,4), "vs W30-W36 mean abs weekly change:", round(g1c.abs().mean(),4))

# arpu jump
jump_a = sub.loc[sub['week']=='W37','arpu_usd'].iloc[0] - sub.loc[sub['week']=='W36','arpu_usd'].iloc[0]
g1a = sub[sub['group']=='W30-W36']['arpu_usd'].diff().dropna()
print("W36->W37 arpu jump:", round(jump_a,4), "vs W30-W36 mean abs weekly change:", round(g1a.abs().mean(),4))

