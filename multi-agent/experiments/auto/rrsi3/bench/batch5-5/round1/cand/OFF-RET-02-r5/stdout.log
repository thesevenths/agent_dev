import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r5\_sandbox\tmp"

df = pd.read_csv(path)
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df['week'].isin(weeks)].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# per-week table
per_week = sub[['week', 'group'] + metrics].copy()
per_week['retention_d7_wow'] = per_week['retention_d7'].diff()
per_week['churn_rate_wow'] = per_week['churn_rate'].diff()
per_week['arpu_usd_wow'] = per_week['arpu_usd'].diff()

# group means
means = sub.groupby('group')[metrics].mean().reset_index()
counts = sub.groupby('group').size().rename('n_rows').reset_index()
means = means.merge(counts, on='group')

# deltas: W37-W43 minus W30-W36
m1 = means[means['group'] == 'W30-W36'].iloc[0]
m2 = means[means['group'] == 'W37-W43'].iloc[0]
delta = pd.DataFrame({
    'metric': metrics,
    'W30-W36_mean': [m1[m] for m in metrics],
    'W37-W43_mean': [m2[m] for m in metrics],
    'abs_diff': [m2[m] - m1[m] for m in metrics],
    'rel_diff_pct': [(m2[m] - m1[m]) / m1[m] * 100 for m in metrics],
})

# breakpoint detection: largest single-week drop in retention_d7 within W30-W43
per_week['ret_drop'] = -per_week['retention_d7_wow']
bp_row = per_week.loc[per_week['ret_drop'].idxmax()]
print("Breakpoint week (largest 1-week retention_d7 drop):", bp_row['week'])
print("  retention_d7:", per_week.loc[per_week['week']==bp_row['week'],'retention_d7'].iloc[0],
      "prev:", per_week.loc[per_week['week']==bp_row['week'],'retention_d7_wow'].iloc[0])

# also check: which week's value first falls below the W30-W36 mean and stays below
base_mean = m1['retention_d7']
below = per_week[per_week['retention_d7'] < base_mean]
print("First week below W30-W36 mean retention_d7:", below['week'].iloc[0] if len(below) else None)

print("\nPer-week:\n", per_week.to_string(index=False))
print("\nGroup means:\n", means.to_string(index=False))
print("\nDelta:\n", delta.to_string(index=False))

# save intermediate CSVs
per_week.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
delta.to_csv(f"{out_dir}\\step2_delta.csv", index=False)
print("\nSaved: step2_per_week.csv, step2_group_means.csv, step2_delta.csv")

