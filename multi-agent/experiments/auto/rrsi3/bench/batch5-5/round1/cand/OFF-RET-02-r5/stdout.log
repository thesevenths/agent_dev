import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r5\_sandbox\tmp\step2_breakpoint_summary.csv"
df = pd.read_csv(path)
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df['week'].isin(weeks)].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

rows = []
for m in metrics:
    g1 = sub[sub['group']=='W30-W36'][m].diff().dropna()
    g2 = sub[sub['group']=='W37-W43'][m].diff().dropna()
    jump = sub.loc[sub['week']=='W37', m].iloc[0] - sub.loc[sub['week']=='W36', m].iloc[0]
    rows.append({
        'metric': m,
        'W36_value': sub.loc[sub['week']=='W36', m].iloc[0],
        'W37_value': sub.loc[sub['week']=='W37', m].iloc[0],
        'W36_to_W37_jump': round(jump, 4),
        'W30-W36_mean_abs_weekly_change': round(g1.abs().mean(), 4),
        'W37-W43_mean_abs_weekly_change': round(g2.abs().mean(), 4),
        'jump_over_prior_weekly_vol': round(jump / g1.abs().mean(), 2),
    })
summary = pd.DataFrame(rows)
summary.to_csv(out, index=False)
print(summary.to_string(index=False))
print("saved:", out)

