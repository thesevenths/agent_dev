import pandas as pd
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high(>5)", False: "low(<=5)"})

g = df.groupby("group").agg(
    n=("student_id","count"),
    screen_mean=("screen_hours_per_day","mean"),
    math_mean=("math_score","mean"),
    reading_mean=("reading_score","mean"),
    math_std=("math_score","std"),
    reading_std=("reading_score","std"),
)
print(g.round(4).to_string())

low = df[df["screen_hours_per_day"] <= 5]
high = df[df["screen_hours_per_day"] > 5]
print("\nn_low:", len(low), "n_high:", len(high))
print("math diff (high-low):", round(high.math_score.mean()-low.math_score.mean(),4))
print("reading diff (high-low):", round(high.reading_score.mean()-low.reading_score.mean(),4))

# t-tests for context
t_m, p_m = stats.ttest_ind(high.math_score, low.math_score)
t_r, p_r = stats.ttest_ind(high.reading_score, low.reading_score)
print(f"ttest math: t={t_m:.4f}, p={p_m:.6g}")
print(f"ttest reading: t={t_r:.4f}, p={p_r:.6g}")

