import pandas as pd
import numpy as np
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
results = {}
for x, y in pairs:
    sub = df[[x, y]].dropna()
    n = len(sub)
    r, p = stats.pearsonr(sub[x], sub[y])
    results[(x,y)] = dict(n=n, r=r, p=p)
    print(f"{x} vs {y}: n={n}, r={r:.6f}, p={p:.6g}")

# also Spearman for robustness (extra context)
for x, y in pairs:
    rs, ps = stats.spearmanr(df[x], df[y])
    print(f"Spearman {x} vs {y}: rho={rs:.6f}, p={ps:.6g}")

```
