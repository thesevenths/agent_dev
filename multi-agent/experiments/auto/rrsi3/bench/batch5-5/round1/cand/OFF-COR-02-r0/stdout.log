r_math = df.screen_hours_per_day.corr(df.math_score, method="pearson")
r_read = df.screen_hours_per_day.corr(df.reading_score, method="pearson")
out = {
  "source_file": "offline_data/students.csv",
  "n_rows": n,
  "method": "pearson",
  "corr_screen_math": round(r_math, 6),
  "corr_screen_reading": round(r_read, 6),
  "as_of": "2026-10-25 12:34"
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r0\_sandbox\tmp\step2_correlations.json","w") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print(out)

