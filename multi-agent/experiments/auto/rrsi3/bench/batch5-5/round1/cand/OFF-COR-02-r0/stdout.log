import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True:"high(>5)", False:"low(<=5)"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    mean_screen=("screen_hours_per_day","mean"),
    mean_math=("math_score","mean"),
    mean_reading=("reading_score","mean"),
    std_math=("math_score","std"),
    std_reading=("reading_score","std"),
)
g = g.reindex(["low(<=5)","high(>5)"])
low, high = g.loc["low(<=5)"], g.loc["high(>5)"]
out = {
    "as_of": "2026-10-26 08:36",
    "source_file": "offline_data/students.csv",
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "groups": {
        "low(<=5)": {k: (round(v,6) if isinstance(v,float) else int(v)) for k,v in low.items()},
        "high(>5)": {k: (round(v,6) if isinstance(v,float) else int(v)) for k,v in high.items()},
    },
    "mean_diff_high_minus_low": {
        "math_score": round(high["mean_math"]-low["mean_math"],6),
        "reading_score": round(high["mean_reading"]-low["mean_reading"],6),
    },
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.json","w") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print(json.dumps(out, indent=2, ensure_ascii=False))
g.reset_index().to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r0\_sandbox\tmp\step3_group_stats.csv", index=False)
print("done")

