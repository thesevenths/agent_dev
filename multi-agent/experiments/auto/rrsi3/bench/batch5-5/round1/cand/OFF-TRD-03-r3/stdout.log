```python
import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

grand_total = float(df['revenue'].sum())
n_months = int(df['month'].nunique())
assert n_months == 24

tot = df.groupby('region')['revenue'].sum()
monthly = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak = monthly.loc[monthly.groupby('region')['revenue'].idxmax()]

regions = {}
for r in ['N','S','E','W']:
    t = float(tot[r])
    pk = peak[peak['region']==r].iloc[0]
    regions[r] = {
        "total_revenue": round(t, 2),
        "share_of_grand_total": round(t/grand_total, 6),
        "share_pct": round(100*t/grand_total, 4),
        "monthly_avg_revenue": round(t/n_months, 2),
        "n_months": n_months,
        "n_rows": int((df['region']==r).sum()),
        "peak_month": str(pk['month']),
        "peak_month_revenue": round(float(pk['revenue']), 2),
    }

result = {
    "source_file": "offline_data/regional_sales.csv",
    "as_of": "2026-10-25 14:37",
    "n_rows": int(df.shape[0]),
    "n_months": n_months,
    "month_range": [df['month'].min(), df['month'].max()],
    "grand_total_revenue": round(grand_total, 2),
    "top_region": str(tot.idxmax()),
    "regions": regions,
    "share_sum_check": round(sum(v['share_of_grand_total'] for v in regions.values()), 6),
}

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
out_path = os.path.join(out_dir, "regional_aggregates.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out_path)

```
