import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dupes:", df.duplicated(subset=['month','region','product_line']).sum())
print("revenue min/max:", df['revenue'].min(), df['revenue'].max())
print("revenue negative/zero:", (df['revenue']<=0).sum())

# consistency check revenue vs units*unit_price
calc = df['units']*df['unit_price']
diff = (calc - df['revenue']).abs()
print("max |units*price - revenue|:", diff.max())

# per-region aggregates
g = df.groupby('region')['revenue'].agg(['sum','count','mean'])
print(g)
# monthly totals per region
m = df.groupby(['region','month'])['revenue'].sum().reset_index()
top = m.loc[m.groupby('region')['revenue'].idxmax()]
print(top)
# overall top region
tot = df.groupby('region')['revenue'].sum().sort_values(ascending=False)
print(tot)
print("grand total:", df['revenue'].sum())
print("months per region:", df.groupby('region')['month'].nunique().to_dict())

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
summary = {
    "file": path,
    "rows": int(df.shape[0]),
    "columns": list(df.columns),
    "regions": sorted(df['region'].unique()),
    "month_range": [df['month'].min(), df['month'].max()],
    "n_months": int(df['month'].nunique()),
    "product_lines": sorted(df['product_line'].unique()),
    "null_cells": int(df.isna().sum().sum()),
    "duplicate_keys": int(df.duplicated(subset=['month','region','product_line']).sum()),
    "revenue_min": float(df['revenue'].min()),
    "revenue_max": float(df['revenue'].max()),
    "nonpositive_revenue_rows": int((df['revenue']<=0).sum()),
    "max_abs_units_price_vs_revenue": float(diff.max()),
    "region_totals": {k: float(v) for k,v in tot.items()},
    "grand_total": float(df['revenue'].sum()),
    "months_per_region": df.groupby('region')['month'].nunique().to_dict(),
    "region_peak_month": {r: {"month": mm, "revenue": float(v)} for r, mm, v in zip(top['region'], top['month'], top['revenue'])},
}
out_path = os.path.join(out_dir, "step1_csv_validation.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("saved:", out_path)

