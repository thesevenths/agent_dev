import pandas as pd
df = pd.read_csv("offline_data/students.csv")
ct = df.groupby(['grade','region']).agg(
    n=('reading_score','size'),
    mean_reading_score=('reading_score','mean')
).reset_index()
ct['mean_reading_score'] = ct['mean_reading_score'].round(6)
ct = ct.sort_values(['grade','region']).reset_index(drop=True)
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-02-r3\_sandbox\tmp\step2_crosstab_metrics.csv"
ct.to_csv(out, index=False)
print(ct.to_string(index=False))
print("saved:", out)
mx = ct.loc[ct['mean_reading_score'].idxmax()]
mn = ct.loc[ct['mean_reading_score'].idxmin()]
print("max:", mx.tolist(), "min:", mn.tolist(), "range:", round(mx['mean_reading_score']-mn['mean_reading_score'],6))
print("total n:", ct['n'].sum())

