import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
cols = ["screen_hours_per_day","math_score","reading_score"]
d = df[cols].dropna()
n = len(d)
r_math = d["screen_hours_per_day"].corr(d["math_score"], method="pearson")
r_read = d["screen_hours_per_day"].corr(d["reading_score"], method="pearson")
# also spearman for robustness
from scipy import stats
p_math, pv_math = stats.pearsonr(d["screen_hours_per_day"], d["math_score"])
p_read, pv_read = stats.pearsonr(d["screen_hours_per_day"], d["reading_score"])
s_math, sv_math = stats.spearmanr(d["screen_hours_per_day"], d["math_score"])
s_read, sv_read = stats.spearmanr(d["screen_hours_per_day"], d["reading_score"])
print(n, r_math, r_read, pv_math, pv_read, s_math, s_read)

out = {
  "step": "2/4 Compute correlations",
  "source_file": "offline_data/students.csv",
  "n_used": n,
  "pearson": {
    "screen_hours_per_day_vs_math_score": {"r": round(r_math,4), "p_value": pv_math},
    "screen_hours_per_day_vs_reading_score": {"r": round(r_read,4), "p_value": pv_read}
  },
