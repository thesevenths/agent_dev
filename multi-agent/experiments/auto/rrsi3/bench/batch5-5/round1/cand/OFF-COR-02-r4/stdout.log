import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
df["group"] = (df["screen_hours_per_day"] > 5).map({True:"high(>5)", False:"low(<=5)"})
g = df.groupby("group").agg(
    n=("student_id","count"),
    screen_mean=("screen_hours_per_day","mean"),
    math_mean=("math_score","mean"),
    reading_mean=("reading_score","mean"),
    math_std=("math_score","std"),
    reading_std=("reading_score","std"),
)
print(g)
low = g.loc["low(<=5)"]; high = g.loc["high(>5)"]
out = {
  "threshold": 5,
  "low(<=5)": {k: (round(v,6) if isinstance(v,float) else int(v)) for k,v in low.items()},
  "high(>5)": {k: (round(v,6) if isinstance(v,float) else int(v)) for k,v in high.items()},
  "diff_high_minus_low": {
     "math": round(high["math_mean"]-low["math_mean"],6),
     "reading": round(high["reading_mean"]-low["reading_mean"],6),
  }
}
print(json.dumps(out, indent=2))
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r4\_sandbox\tmp\step3_group_stats.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

