import pandas as pd, json
df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
# also spearman for robustness
from scipy.stats import pearsonr, spearmanr
pm, pm_p = pearsonr(df["screen_hours_per_day"], df["math_score"])
pr, pr_p = pearsonr(df["screen_hours_per_day"], df["reading_score"])
sm, sm_p = spearmanr(df["screen_hours_per_day"], df["math_score"])
sr, sr_p = spearmanr(df["screen_hours_per_day"], df["reading_score"])
out = {
  "n": n,
  "pearson_screen_math": {"r": round(pm,6), "p_value": pm_p},
  "pearson_screen_reading": {"r": round(pr,6), "p_value": pr_p},
  "spearman_screen_math": {"rho": round(sm,6), "p_value": sm_p},
  "spearman_screen_reading": {"rho": round(sr,6), "p_value": sr_p},
}
print(json.dumps(out, indent=2))
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-COR-02-r4\_sandbox\tmp\step2_correlations.json","w") as f:
    json.dump(out, f, indent=2)
print("saved")

