import pandas as pd, numpy as np, os, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r4\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
n = len(df)

# Pearson correlations
r_arpu = df['retention_d7'].corr(df['arpu_usd'], method='pearson')
r_churn = df['retention_d7'].corr(df['churn_rate'], method='pearson')

# p-values via t-statistic
from scipy import stats
t_arpu, p_arpu = stats.pearsonr(df['retention_d7'], df['arpu_usd'])
t_churn, p_churn = stats.pearsonr(df['retention_d7'], df['churn_rate'])

# median split
med = df['retention_d7'].median()
high = df[df['retention_d7'] > med]
low = df[df['retention_d7'] < med]
eq = df[df['retention_d7'] == med]

def grp(g):
    return {
        'n_rows': int(len(g)),
        'arpu_mean': float(g['arpu_usd'].mean()),
        'cohort_size_sum': int(g['cohort_size'].sum()),
        'retention_d7_min': float(g['retention_d7'].min()),
        'retention_d7_max': float(g['retention_d7'].max()),
        'churn_rate_mean': float(g['churn_rate'].mean()),
    }

res = {
    'n_rows': n,
    'retention_d7_median': float(med),
    'corr_retention_arpu': float(r_arpu),
    'p_retention_arpu': float(p_arpu),
    'corr_retention_churn': float(r_churn),
    'p_retention_churn': float(p_churn),
    'group_high': grp(high),
    'group_low': grp(low),
    'rows_equal_to_median': int(len(eq)),
}
# derived ratios
res['arpu_ratio_high_over_low'] = res['group_high']['arpu_mean'] / res['group_low']['arpu_mean']
res['cohort_ratio_high_over_low'] = res['group_high']['cohort_size_sum'] / res['group_low']['cohort_size_sum']

print(json.dumps(res, indent=2, ensure_ascii=False))

outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r4\_sandbox\tmp"

# intermediate CSV: one row per metric
rows = [
    ('retention_d7_median', med, 'median of retention_d7, n=60'),
    ('corr_retention_d7_arpu_usd', r_arpu, f'Pearson r, n=60, p={p_arpu:.3e}'),
    ('corr_retention_d7_churn_rate', r_churn, f'Pearson r, n=60, p={p_churn:.3e}'),
    ('group_high_arpu_usd_mean', res['group_high']['arpu_mean'], f"mean arpu_usd where retention_d7 > {med}, n={res['group_high']['n_rows']}"),
    ('group_high_cohort_size_sum', res['group_high']['cohort_size_sum'], f"sum cohort_size where retention_d7 > {med}, n={res['group_high']['n_rows']}"),
    ('group_low_arpu_usd_mean', res['group_low']['arpu_mean'], f"mean arpu_usd where retention_d7 < {med}, n={res['group_low']['n_rows']}"),
    ('group_low_cohort_size_sum', res['group_low']['cohort_size_sum'], f"sum cohort_size where retention_d7 < {med}, n={res['group_low']['n_rows']}"),
    ('arpu_ratio_high_over_low', res['arpu_ratio_high_over_low'], 'derived: high-group mean / low-group mean'),
    ('cohort_ratio_high_over_low', res['cohort_ratio_high_over_low'], 'derived: high-group sum / low-group sum'),
]
out_df = pd.DataFrame(rows, columns=['metric', 'value', 'aggregation_note'])
csv_path = os.path.join(outdir, 'step2_results.csv')
out_df.to_csv(csv_path, index=False, encoding='utf-8-sig')

json_path = os.path.join(outdir, 'step2_results.json')
with open(json_path, 'w', encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

print('\nsaved:', csv_path)
print('saved:', json_path)
print(out_df.to_string(index=False))

