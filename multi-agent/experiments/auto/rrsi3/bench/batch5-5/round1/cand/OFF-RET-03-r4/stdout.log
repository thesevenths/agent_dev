import pandas as pd, json

OUT = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r4\_sandbox\tmp"
df = pd.read_csv(OUT + r"\app_metrics_clean.csv")
n = len(df)

r_ret_arpu = df.retention_d7.corr(df.arpu_usd)
r_ret_churn = df.retention_d7.corr(df.churn_rate)
# spearman for robustness
s_ret_arpu = df.retention_d7.corr(df.arpu_usd, method="spearman")
s_ret_churn = df.retention_d7.corr(df.churn_rate, method="spearman")

med = df.retention_d7.median()
hi = df[df.retention_d7 > med]
lo = df[df[df.retention_d7 <= med].index]  # below-or-equal
# check ties at median
ties = (df.retention_d7 == med).sum()

groups = {}
for name, g in [("above_median", hi), ("below_or_equal_median", lo)]:
    groups[name] = {
        "n": int(len(g)),
        "retention_d7_mean": g.retention_d7.mean(),
        "retention_d7_min": g.retention_d7.min(),
        "retention_d7_max": g.retention_d7.max(),
        "arpu_usd_mean": g.arpu_usd.mean(),
        "arpu_usd_median": g.arpu_usd.median(),
        "churn_rate_mean": g.churn_rate.mean(),
        "cohort_size_sum": int(g.cohort_size.sum()),
        "weeks": [g.week.min(), g.week.max()],
    }

res = {
    "source": "offline_data/app_metrics.csv (via tmp/app_metrics_clean.csv)",
    "n_rows": n,
    "correlations": {
        "pearson_retention_d7_vs_arpu_usd": r_ret_arpu,
        "pearson_retention_d7_vs_churn_rate": r_ret_churn,
        "spearman_retention_d7_vs_arpu_usd": s_ret_arpu,
        "spearman_retention_d7_vs_churn_rate": s_ret_churn,
    },
    "retention_d7_median": med,
    "ties_at_median": int(ties),
    "groups": groups,
    "derived": {
        "arpu_gap_hi_minus_lo": groups["above_median"]["arpu_usd_mean"] - groups["below_or_equal_median"]["arpu_usd_mean"],
        "arpu_ratio_hi_over_lo": groups["above_median"]["arpu_usd_mean"] / groups["below_or_equal_median"]["arpu_usd_mean"],
        "churn_gap_hi_minus_lo": groups["above_median"]["churn_rate_mean"] - groups["below_or_equal_median"]["churn_rate_mean"],
    },
}
with open(OUT + r"\step2_results.json", "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

