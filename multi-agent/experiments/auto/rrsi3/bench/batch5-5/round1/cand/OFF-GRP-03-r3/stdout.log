matplotlib.use("Agg")
import matplotlib.pyplot as plt
import json

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-03-r3\_sandbox\tmp"
with open(base + r"\group_stats.json", encoding="utf-8") as f:
