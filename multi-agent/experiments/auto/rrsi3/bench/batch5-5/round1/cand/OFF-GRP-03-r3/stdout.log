```python
import pandas as pd, json

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-GRP-03-r3\_sandbox"
df = pd.read_csv(base + r"\offline_data\students.csv")

def grp(h):
    if h < 2.5: return "low"
    elif h <= 4.5: return "mid"
    else: return "high"

df["group"] = df["study_hours_per_week"].apply(grp)

rows = []
for g in ["low","mid","high"]:
    sub = df[df["group"]==g]
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "math_mean": round(sub["math_score"].mean(), 4),
        "math_std": round(sub["math_score"].std(ddof=1), 4),
        "math_min": int(sub["math_score"].min()),
        "math_max": int(sub["math_score"].max()),
        "hours_min": float(sub["study_hours_per_week"].min()),
        "hours_max": float(sub["study_hours_per_week"].max()),
        "hours_mean": round(sub["study_hours_per_week"].mean(),4),
    })

res = pd.DataFrame(rows)
low_mean = res.loc[res.group=="low","math_mean"].iloc[0]
high_mean = res.loc[res.group=="high","math_mean"].iloc[0]
gain = round(high_mean - low_mean, 4)
gain_pct = round(gain/low_mean*100, 4)

out = {
    "source_file": "offline_data/students.csv",
    "total_rows": int(len(df)),
    "rows_used": int(len(df)),
    "rows_dropped": 0,
    "grouping_rule": "low: study_hours_per_week < 2.5; mid: 2.5 <= study_hours_per_week <= 4.5; high: study_hours_per_week > 4.5",
    "groups": rows,
    "low_to_high_gain": gain,
    "low_to_high_gain_pct_of_low": gain_pct,
    "low_mean": low_mean,
    "high_mean": high_mean,
}
with open(base + r"\tmp\group_stats.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
res.to_csv(base + r"\tmp\group_stats.csv", index=False)
print(res.to_string(index=False))
print("gain:", gain, "pct:", gain_pct)
print("total:", len(df))

```
