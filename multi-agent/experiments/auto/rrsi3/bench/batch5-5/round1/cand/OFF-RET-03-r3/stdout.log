print("cohort_diff:", vals['high_cohort'] - vals['low_cohort'])
print("cohort_pct:", (vals['high_cohort'] / vals['low_cohort'] - 1) * 100)
print("churn_diff:", vals['low_churn'] - vals['high_churn'])
print("churn_pct:", (vals['low_churn'] / vals['high_churn'] - 1) * 100)

