import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

# Correlations (Pearson)
r_ret_arpu = df['retention_d7'].corr(df['arpu_usd'], method='pearson')
r_ret_churn = df['retention_d7'].corr(df['churn_rate'], method='pearson')
# also spearman for robustness
r_ret_arpu_s = df['retention_d7'].corr(df['arpu_usd'], method='spearman')
r_ret_churn_s = df['retention_d7'].corr(df['churn_rate'], method='spearman')
print("pearson ret-arpu:", r_ret_arpu)
print("pearson ret-churn:", r_ret_churn)
print("spearman ret-arpu:", r_ret_arpu_s)
print("spearman ret-churn:", r_ret_churn_s)

# p-values via t-test
from scipy import stats
t1 = r_ret_arpu * np.sqrt(58) / np.sqrt(1 - r_ret_arpu**2)
t2 = r_ret_churn * np.sqrt(58) / np.sqrt(1 - r_ret_churn**2)
p1 = 2 * (1 - stats.t.cdf(abs(t1), 58))
p2 = 2 * (1 - stats.t.cdf(abs(t2), 58))
print("p1:", p1, "p2:", p2)

# Median split
med = df['retention_d7'].median()
print("median:", med)
high = df[df['retention_d7'] > med]
low = df[df['retention_d7'] < med]
print("high n:", len(high), "low n:", len(low))
print("high arpu mean:", high['arpu_usd'].mean(), "high cohort sum:", high['cohort_size'].sum())
print("low arpu mean:", low['arpu_usd'].mean(), "low cohort sum:", low['cohort_size'].sum())
print("high ret mean:", high['retention_d7'].mean(), "low ret mean:", low['retention_d7'].mean())
print("high churn mean:", high['churn_rate'].mean(), "low churn mean:", low['churn_rate'].mean())

# Save intermediate results CSV
out = pd.DataFrame({
    'metric': [
        'pearson_corr_retention_d7_arpu_usd',
        'pearson_corr_retention_d7_churn_rate',
        'spearman_corr_retention_d7_arpu_usd',
        'spearman_corr_retention_d7_churn_rate',
        'p_value_retention_d7_arpu_usd',
        'p_value_retention_d7_churn_rate',
        'retention_d7_median',
        'high_group_n',
        'high_group_arpu_usd_mean',
        'high_group_cohort_size_sum',
        'high_group_retention_d7_mean',
        'high_group_churn_rate_mean',
        'low_group_n',
        'low_group_arpu_usd_mean',
        'low_group_cohort_size_sum',
        'low_group_retention_d7_mean',
        'low_group_churn_rate_mean',
    ],
    'value': [
        r_ret_arpu, r_ret_churn, r_ret_arpu_s, r_ret_churn_s,
        p1, p2, med,
        len(high), high['arpu_usd'].mean(), high['cohort_size'].sum(),
        high['retention_d7'].mean(), high['churn_rate'].mean(),
        len(low), low['arpu_usd'].mean(), low['cohort_size'].sum(),
        low['retention_d7'].mean(), low['churn_rate'].mean(),
    ],
})
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r3\_sandbox\tmp\step2_intermediate_results.csv"
out.to_csv(out_path, index=False)
print("saved:", out_path)
print(out.to_string(index=False))

