import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-03-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

# Exact values for the report
r_arpu = df['retention_d7'].corr(df['arpu_usd'])
r_churn = df['retention_d7'].corr(df['churn_rate'])
med = df['retention_d7'].median()
high = df[df['retention_d7'] > med]
low = df[df['retention_d7'] < med]

vals = {
    'r_arpu': r_arpu, 'r_churn': r_churn, 'med': med,
    'high_n': len(high), 'low_n': len(low),
    'high_arpu': high['arpu_usd'].mean(), 'low_arpu': low['arpu_usd'].mean(),
    'high_cohort': high['cohort_size'].sum(), 'low_cohort': low['cohort_size'].sum(),
    'high_ret': high['retention_d7'].mean(), 'low_ret': low['retention_d7'].mean(),
    'high_churn': high['churn_rate'].mean(), 'low_churn': low['churn_rate'].mean(),
    'total_cohort': df['cohort_size'].sum(),
}
for k, v in vals.items():
    print(f"{k}: {v!r}")

# derived
print("arpu_diff:", vals['high_arpu'] - vals['low_arpu'])
print("arpu_ratio:", vals['high_arpu'] / vals['low_arpu'])
