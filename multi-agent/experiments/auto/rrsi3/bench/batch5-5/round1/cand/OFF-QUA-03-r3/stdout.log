f \"units\" in df.columns else df.columns[-1])\n\nprint(\"\\nDetected columns -> region:\", col_region, \"| product_line:\", col_line,\n      \"| month:\", col_month, \"| sales:\", col_sales)\n\n# Normalize month to YYYY-MM string\nm = df[col_month].astype(str)\nif m.str.match(r\"^\\d{4}[-/]\\d{1,2}([-/]\\d{1,2})?$\").all():\n    month_norm = m.str.replace(\"/\", \"-\").str[:7]\nelse:\n    month_norm = m  # keep as-is if not parseable\n\nprint(\"Month min:\", month_norm.min(), \"| Month max:\", month_norm.max(),\n      \"| Unique months:\", month_norm.nunique())\nprint(\"Unique regions:\", sorted(df[col_region].astype(str).unique()))\nprint(\"Unique product_lines:\", sorted(df[col_line].astype(str).unique()))\n\n# ---------- (c) 24-month trailing mean & ratio ----------\nwork = df[[col_region, col_line, col_month, col_sales]].copy()\nwork.columns = [\"region\", \"product_line\", \"month_raw\", \"sales\"]\nwork[\"month\"] = month_norm\nwork[\"sales\"] = pd.to_numeric(work[\"sales\"], errors=\"coerce\")\nwork = work.dropna(subset=[\"sales\"])\n\n# Sort chronologically per group (month string YYYY-MM sorts correctly)\nwork = work.sort_values([\"region\", \"product_line\", \"month\"])\n\n# Trailing 24-month mean INCLUDING current month (rolling window of 24)\nwork[\"mean_24m\"] = (\n    work.groupby([\"region\", \"product_line\"])[\"sales\"]\n    .transform(lambda s: s.rolling(window=24, min_periods=1).mean())\n)\nwork[\"multiple\"] = work[\"sales\"] / work[\"mean_24m\"]\n\n# ---------- (d) save full result table ----------\nout_path = os.path.abspath(os.path.join(BASE, \"offline_data\", \"anomaly_multiples.csv\"))\nos.makedirs(os.path.dirname(out_path), exist_ok=True)\nwork.to_csv(out_path, index=False, encoding=\"utf-8-sig\")\n\n# Top-10 preview for downstream steps\ntop = work.dropna(subset=[\"multiple\"]).nlargest(10, \"multiple\")\nprint(\"\\nTop-10 (region x product_line x month) by multiple:\")\nprint(top.to_string(index=False))\n\nprint(\"\\nSaved full result ta