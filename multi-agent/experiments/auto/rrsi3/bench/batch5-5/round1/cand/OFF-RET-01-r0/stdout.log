```python
import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
first_mean, first_std = first30.mean(), first30.std(ddof=1)
last_mean, last_std = last30.mean(), last30.std(ddof=1)
diff_mean = last_mean - first_mean
diff_std = last_std - first_std

threshold = overall_mean - 2*overall_std
below = df[r < threshold]
n_below = len(below)

res = {
    "n_total": int(len(r)),
    "overall_mean": overall_mean,
    "overall_std": overall_std,
    "first30": {"weeks": "W01-W30", "n": 30, "mean": first_mean, "std": first_std},
    "last30": {"weeks": "W31-W60", "n": 30, "mean": last_mean, "std": last_std},
    "diff_mean_last_minus_first": diff_mean,
    "diff_std_last_minus_first": diff_std,
    "threshold_mean_minus_2std": threshold,
    "n_weeks_below_threshold": n_below,
    "weeks_below_threshold": below["week"].tolist(),
    "retention_below_threshold": below["retention_d7"].tolist(),
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-01-r0\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("saved:", out)

```
