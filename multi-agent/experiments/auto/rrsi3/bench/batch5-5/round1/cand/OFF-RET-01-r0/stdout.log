import pandas as pd
import numpy as np

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-01-r0\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-01-r0\_sandbox\tmp\step2_stats.csv"

df = pd.read_csv(src)
r = df["retention_d7"]
first = r.iloc[:30]   # W01-W30
last  = r.iloc[30:]   # W31-W60

overall_mean = r.mean()
overall_std  = r.std(ddof=1)
threshold    = overall_mean - 2*overall_std
below = df[r < threshold]

rows = [
    ("overall_mean",        r.mean(),        60),
    ("overall_std_ddof1",   r.std(ddof=1),   60),
    ("overall_std_ddof0",   r.std(ddof=0),   60),
    ("first30_mean",        first.mean(),    30),
    ("first30_std_ddof1",   first.std(ddof=1), 30),
    ("last30_mean",         last.mean(),     30),
    ("last30_std_ddof1",    last.std(ddof=1), 30),
    ("mean_diff_last_minus_first", last.mean()-first.mean(), 30),
    ("std_diff_last_minus_first",  last.std(ddof=1)-first.std(ddof=1), 30),
    ("threshold_mean_minus_2std",  threshold, 60),
    ("weeks_below_threshold",      int((r < threshold).sum()), 60),
]
out_df = pd.DataFrame(rows, columns=["metric","value","n_rows"])
out_df.to_csv(out, index=False)
print(out_df.to_string(index=False))
print("\nweeks below threshold:", below["week"].tolist())
print("below values:", below["retention_d7"].tolist())
print("\nsaved:", out)

