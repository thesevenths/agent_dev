```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r3\_sandbox\tmp"

df = pd.read_csv(src)
sub = df[(df['week'] >= 'W30') & (df['week'] <= 'W43')].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# per-week table with group labels
weekly = sub[['week', 'group'] + metrics].copy()

# group means
means = sub.groupby('group')[metrics].mean().reset_index()
means.columns = ['group'] + [f'{m}_mean' for m in metrics]

# diff (after - before) and relative change
before = means[means['group'] == 'W30-W36'].iloc[0]
after = means[means['group'] == 'W37-W43'].iloc[0]
rows = []
for m in metrics:
    b, a = before[f'{m}_mean'], after[f'{m}_mean']
    rows.append({'metric': m, 'W30-W36_mean': round(b, 6), 'W37-W43_mean': round(a, 6),
                 'diff_after_minus_before': round(a - b, 6),
                 'relative_change_pct': round((a - b) / b * 100, 4)})
diff = pd.DataFrame(rows)

# breakpoint localization: week-over-week deltas
weekly['retention_d7_wow'] = weekly['retention_d7'].diff()
weekly['churn_rate_wow'] = weekly['churn_rate'].diff()
weekly['arpu_usd_wow'] = weekly['arpu_usd'].diff()

# max |relative| week-over-week jump per metric
for m in metrics:
    col = f'{m}_wow'
    rel = (weekly[col] / weekly[m].shift(1)).abs()
    idx = rel.idxmax()
    print(f"{m}: largest WoW jump at {weekly.loc[idx,'week']} (from {weekly.loc[idx-1,'week']}), "
          f"delta={weekly.loc[idx,col]:.4f}, rel={rel[idx]*100:.2f}%")

# save weekly CSV
weekly_path = f"{out_dir}\\step2_weekly_breakpoint.csv"
weekly.to_csv(weekly_path, index=False)

# save summary CSV
summary = pd.concat([means, diff], axis=None)
summary_path = f"{out_dir}\\step2_group_means_summary.csv"
summary.to_csv(summary_path, index=False)

print("\n--- weekly ---")
print(weekly.to_string(index=False))
print("\n--- means ---")
print(means.to_string(index=False))
print("\n--- diff ---")
print(diff.to_string(index=False))
print("\nsaved:", weekly_path)
print("saved:", summary_path)

```
