import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

# Per-region aggregates
g = df.groupby("region")["revenue"].agg(total_revenue="sum", n_rows="count")
grand_total = float(df["revenue"].sum())
n_months = int(df["month"].nunique())

g["share_of_total"] = g["total_revenue"] / grand_total
g["monthly_avg_revenue"] = g["total_revenue"] / n_months
g = g.sort_values("total_revenue", ascending=False)

agg = g.reset_index()
agg.to_csv("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch5-5/round1/cand/OFF-TRD-03-r4/_sandbox/tmp/step2_region_aggregates.csv", index=False)

# Monthly revenue per region (for peak month)
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
piv.to_csv("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch5-5/round1/cand/OFF-TRD-03-r4/_sandbox/tmp/step2_monthly_by_region.csv")

top_region = agg.iloc[0]["region"]
peak_month = piv[top_region].idxmax()
peak_value = float(piv.loc[peak_month, top_region])

# E region monthly detail
e_monthly = piv[top_region].to_dict()

out = {
    "as_of": "2026-10-26 10:29",
    "source_file": "offline_data/regional_sales.csv",
    "n_months": n_months,
    "month_range": [df["month"].min(), df["month"].max()],
    "grand_total_revenue": grand_total,
    "grand_total_rows": int(len(df)),
    "regions": {
        r: {
            "total_revenue": float(row["total_revenue"]),
            "share_of_total": float(row["share_of_total"]),
            "monthly_avg_revenue": float(row["monthly_avg_revenue"]),
            "n_rows": int(row["n_rows"]),
        } for r, row in agg.set_index("region").iterrows()
    },
    "top_region": top_region,
    "top_region_peak_month": peak_month,
    "top_region_peak_revenue": peak_value,
    "top_region_monthly": {m: float(v) for m, v in e_monthly.items()},
    "monthly_totals_all_regions": {m: float(v) for m, v in piv.sum(axis=1).items()},
}

with open("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch5-5/round1/cand/OFF-TRD-03-r4/_sandbox/tmp/step2_region_aggregates.json", "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(json.dumps(out, ensure_ascii=False, indent=2))

