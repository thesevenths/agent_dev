import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

out = {}
out["file"] = os.path.abspath(path)
out["columns"] = list(df.columns)
out["n_rows"] = int(len(df))
out["regions"] = sorted(df["region"].unique().tolist())
out["n_regions"] = df["region"].nunique()
out["months"] = [df["month"].min(), df["month"].max()]
out["n_months"] = int(df["month"].nunique())
out["product_lines"] = sorted(df["product_line"].unique().tolist())
out["nulls"] = df.isna().sum().to_dict()
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}

# rows per region
out["rows_per_region"] = df.groupby("region").size().to_dict()
# rows per month
out["rows_per_month"] = df.groupby("month").size().to_dict()

# revenue sanity: revenue vs units*unit_price
df["calc"] = df["units"] * df["unit_price"]
out["max_abs_diff_rev"] = float((df["revenue"] - df["calc"]).abs().max())

# aggregates
g = df.groupby("region")["revenue"].agg(["sum", "count"])
total = df["revenue"].sum()
out["total_revenue"] = float(total)
out["region_sum"] = {k: float(v) for k, v in g["sum"].items()}
out["region_share"] = {k: float(v/total) for k, v in g["sum"].items()}
out["region_monthly_avg"] = {k: float(v/12) for k, v in g["sum"].items()}

# monthly totals per region
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
out["monthly_by_region"] = piv.to_dict()
top_region = g["sum"].idxmax()
out["top_region"] = top_region
peak_month = piv[top_region].idxmax()
out["top_region_peak_month"] = peak_month
out["top_region_peak_value"] = float(piv.loc[peak_month, top_region])
out["top_region_monthly"] = {m: float(v) for m, v in piv[top_region].items()}

# grand monthly totals
out["monthly_total"] = {m: float(v) for m, v in piv.sum(axis=1).items()}

os.makedirs("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch5-5/round1/cand/OFF-TRD-03-r4/_sandbox/tmp", exist_ok=True)
with open("E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch5-5/round1/cand/OFF-TRD-03-r4/_sandbox/tmp/step1_validation.json", "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print(json.dumps(out, ensure_ascii=False, indent=2))

