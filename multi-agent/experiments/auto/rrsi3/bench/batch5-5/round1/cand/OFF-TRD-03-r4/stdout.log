path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "n_months:", df['month'].nunique())
print("nulls:\n", df.isna().sum())
print("dupes (month,region,product_line):", df.duplicated(subset=['month','region','product_line']).sum())
print("product_lines:", sorted(df['product_line'].unique()))
print("rows per region:\n", df.groupby('region').size())
print("rows per month-region combo complete:", df.groupby(['month','region']).size().value_counts().to_dict())
print("revenue negative/zero:", (df['revenue']<=0).sum())
# sanity: revenue vs units*unit_price
df['calc'] = df['units']*df['unit_price']
print("max |revenue - units*price|:", (df['revenue']-df['calc']).abs().max())

out = {
  "file": os.path.abspath(path),
  "n_rows": int(len(df)),
  "n_cols": int(df.shape[1]),
  "columns": list(df.columns),
  "regions": sorted(df['region'].unique()),
  "month_range": [df['month'].min(), df['month'].max()],
  "n_months": int(df['month'].nunique()),
  "product_lines": sorted(df['product_line'].unique()),
  "rows_per_region": df.groupby('region').size().to_dict(),
  "null_cells": int(df.isna().sum().sum()),
  "dupes": int(df.duplicated(subset=['month','region','product_line']).sum()),
  "revenue_nonpositive": int((df['revenue']<=0).sum()),
  "max_revenue_price_mismatch": float((df['revenue']-df['units']*df['unit_price']).abs().max()),
}
os.makedirs("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch5-5\\round1\\cand\\OFF-TRD-03-r4\\_sandbox\\tmp", exist_ok=True)
with open("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch5-5\\round1\\cand\\OFF-TRD-03-r4\\_sandbox\\tmp\\step1_csv_validation.json","w") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved validation json")

