```python
import pandas as pd, json, os

src = "E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch5-5\\round1\\cand\\OFF-TRD-03-r4\\_sandbox\\offline_data\\regional_sales.csv"
df = pd.read_csv(src)
n_months = df['month'].nunique()  # 24
grand_total = df['revenue'].sum()

rows = []
for region in ['N','S','E','W']:
    sub = df[df['region']==region]
    total = sub['revenue'].sum()
    monthly = sub.groupby('month')['revenue'].sum().sort_index()
    peak_month, peak_val = monthly.idxmax(), monthly.max()
    rows.append({
        "region": region,
        "n_rows": int(len(sub)),
        "total_revenue": round(total, 2),
        "share": round(total/grand_total, 6),
        "monthly_avg": round(total/n_months, 2),
        "peak_month": peak_month,
        "peak_month_revenue": round(float(peak_val), 2),
        "monthly_revenue": {m: round(float(v),2) for m,v in monthly.items()},
    })

top = max(rows, key=lambda r: r["total_revenue"])
out = {
    "source": "offline_data/regional_sales.csv",
    "source_abs_path": src,
    "n_rows_total": int(len(df)),
    "n_months": int(n_months),
    "month_range": [df['month'].min(), df['month'].max()],
    "grand_total_revenue": round(float(grand_total), 2),
    "regions": rows,
    "top_region": {
        "region": top["region"],
        "total_revenue": top["total_revenue"],
        "peak_month": top["peak_month"],
        "peak_month_revenue": top["peak_month_revenue"],
    },
    "aggregation": {
        "total_revenue": "sum(revenue) per region, 72 rows each",
        "share": "region total / grand total (288 rows)",
        "monthly_avg": "region total / 24 months",
        "peak_month": "max of groupby(month).sum(revenue) within top region",
    },
}
tmp = "E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch5-5\\round1\\cand\\OFF-TRD-03-r4\\_sandbox\\tmp"
with open(os.path.join(tmp,"regional_aggregates.json"),"w") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
summary = pd.DataFrame([{k:v for k,v in r.items() if k!='monthly_revenue'} for r in rows])
summary.to_csv(os.path.join(tmp,"regional_aggregates.csv"), index=False)
print(summary.to_string(index=False))
print("grand total:", out["grand_total_revenue"])
print("top:", out["top_region"])
print("saved json + csv")

```
