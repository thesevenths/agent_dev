import pandas as pd

# Recompute exact values from the source CSV to ensure report numbers are precise
df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].isin([f'W{i:02d}' for i in range(30,44)])].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')
metrics = ['retention_d7','churn_rate','arpu_usd']

pre = sub[sub['group']=='W30-W36'][metrics].mean()
post = sub[sub['group']=='W37-W43'][metrics].mean()
print("pre:", pre.to_dict())
print("post:", post.to_dict())
for m in metrics:
    d = post[m]-pre[m]; p = d/pre[m]*100
    print(f"{m}: diff={d:+.6f} pct={p:+.4f}%")

# per-week table
sub['ret_d7_delta']=sub['retention_d7'].diff()
sub['churn_delta']=sub['churn_rate'].diff()
sub['arpu_delta']=sub['arpu_usd'].diff()
print(sub[['week','retention_d7','churn_rate','arpu_usd','ret_d7_delta','churn_delta','arpu_delta']].to_string(index=False))

# post-breakpoint extremes
postsub = sub[sub['group']=='W37-W43']
print("post max retention_d7:", postsub['retention_d7'].max(), "at", postsub.loc[postsub['retention_d7'].idxmax(),'week'])
print("post min churn_rate:", postsub['churn_rate'].min(), "at", postsub.loc[postsub['churn_rate'].idxmin(),'week'])
print("post max arpu:", postsub['arpu_usd'].max(), "at", postsub.loc[postsub['arpu_usd'].idxmax(),'week'])
print("pre min retention_d7:", sub[sub['group']=='W30-W36']['retention_d7'].min())
print("pre max churn:", sub[sub['group']=='W30-W36']['churn_rate'].max())
print("pre min arpu:", sub[sub['group']=='W30-W36']['arpu_usd'].min())

```
