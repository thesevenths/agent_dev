import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df['week'].isin([f'W{i:02d}' for i in range(30,44)])].copy()
sub['group'] = sub['week'].apply(lambda w: 'W30-W36' if int(w[1:]) <= 36 else 'W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']
g = sub.groupby('group')[metrics].mean().round(6)
print(g)

# per-week deltas
sub['ret_d7_delta'] = sub['retention_d7'].diff()
sub['churn_delta'] = sub['churn_rate'].diff()
sub['arpu_delta'] = sub['arpu_usd'].diff()
print(sub[['week','retention_d7','churn_rate','arpu_usd','ret_d7_delta','churn_delta','arpu_delta']].to_string(index=False))

# group means with n
print("\nGroup sizes:", sub.groupby('group')['week'].count().to_dict())

# save intermediate CSV
out = sub[['week','group','cohort_size','dau','retention_d7','churn_rate','arpu_usd','support_tickets',
           'ret_d7_delta','churn_delta','arpu_delta']].copy()
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r4\_sandbox\tmp\step2_weekly_values.csv", index=False)

means = sub.groupby('group')[metrics].mean().reset_index()
means['n_weeks'] = sub.groupby('group')['week'].count().values
means.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\cand\OFF-RET-02-r4\_sandbox\tmp\step2_group_means.csv", index=False)
print("\n", means)

# differences
pre = g.loc['W30-W36']; post = g.loc['W37-W43']
for m in metrics:
    diff = post[m] - pre[m]
    pct = diff / pre[m] * 100
    print(f"{m}: pre={pre[m]:.6f} post={post[m]:.6f} diff={diff:+.6f} ({pct:+.2f}%)")

```
