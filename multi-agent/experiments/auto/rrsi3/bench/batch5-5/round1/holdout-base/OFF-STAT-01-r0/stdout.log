import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-STAT-01-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
print(df.shape)
print(df.dtypes)
print(df.head())

s = df["math_score"]
print("nulls:", s.isna().sum())
q1 = s.quantile(0.25)
q3 = s.quantile(0.75)
iqr = q3 - q1
lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
out = s[(s < lo) | (s > hi)]
res = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "n_rows": int(len(df)),
    "n_valid": int(s.notna().sum()),
    "n_missing": int(s.isna().sum()),
    "mean": float(s.mean()),
    "std": float(s.std(ddof=1)),
    "std_population": float(s.std(ddof=0)),
    "median": float(s.median()),
    "q1": float(q1),
    "q3": float(q3),
    "iqr": float(iqr),
    "min": float(s.min()),
    "max": float(s.max()),
    "iqr_lower": float(lo),
    "iqr_upper": float(hi),
    "n_outliers": int(len(out)),
    "outlier_pct": float(len(out)/len(s)*100),
    "outlier_values": out.tolist(),
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-STAT-01-r0\_sandbox\tmp\math_score_stats.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out_path)

