```python
import pandas as pd
df = pd.read_csv("offline_data/students.csv")
bins = [0, 20, 40, 60, 80, 100]
labels = ["0-20", "20-40", "40-60", "60-80", "80-100"]
df['bin'] = pd.cut(df['attendance_pct'], bins=bins, labels=labels, right=True)
g = df.groupby('bin', observed=False).agg(n=('math_score','size'), mean_math=('math_score','mean'))
print(g.to_string())
print("80-100 mean:", round(g.loc['80-100','mean_math'],2), "60-80 mean:", round(g.loc['60-80','mean_math'],2))
print("jump:", round(g.loc['80-100','mean_math']-g.loc['60-80','mean_math'],2))
print("40-60 mean:", round(g.loc['40-60','mean_math'],2))
print("80-100 vs 40-60:", round(g.loc['80-100','mean_math']-g.loc['40-60','mean_math'],2))
print("80-100 vs overall:", round(g.loc['80-100','mean_math']-df['math_score'].mean(),2))
print("60-80 vs overall:", round(g.loc['60-80','mean_math']-df['math_score'].mean(),2))
print("40-60 vs overall:", round(g.loc['40-60','mean_math']-df['math_score'].mean(),2))
print("pct 80-100:", round(177/400*100,1), "60-80:", round(178/400*100,1), "40-60:", round(45/400*100,1))

```
