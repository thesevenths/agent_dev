import pandas as pd

df = pd.read_csv("offline_data/students.csv")
print(len(df))
print(df['attendance_pct'].min(), df['attendance_pct'].max())
print(df['math_score'].isna().sum(), df['attendance_pct'].isna().sum())

bins = [0, 20, 40, 60, 80, 100]
labels = ["0-20", "20-40", "40-60", "60-80", "80-100"]
df['bin'] = pd.cut(df['attendance_pct'], bins=bins, labels=labels, right=True)
g = df.groupby('bin', observed=False).agg(n=('math_score','size'), mean_math=('math_score','mean'))
print(g)
print(g['mean_math'].diff())
print("overall mean:", df['math_score'].mean())

