import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)
df['year'] = df['month'].str[:4]
df['mm'] = df['month'].str[5:]

rows = []
for y in ['2024', '2025']:
    sub = df[df['year'] == y]
    nd = sub[sub['mm'].isin(['11','12'])]
    jo = sub[~sub['mm'].isin(['11','12'])]
    nd_total = int(nd['units'].sum())
    jo_total = int(jo['units'].sum())
    nd_avg = nd_total / 2   # per-month avg over Nov, Dec
    jo_avg = jo_total / 10  # per-month avg over Jan..Oct
    rows.append({
        'year': y,
        'nov_dec_rows': len(nd),
        'jan_oct_rows': len(jo),
        'nov_dec_units_total': nd_total,
        'jan_oct_units_total': jo_total,
        'nov_dec_avg_monthly_units': round(nd_avg, 4),
        'jan_oct_avg_monthly_units': round(jo_avg, 4),
        'amplification_multiplier': round(nd_avg / jo_avg, 6),
    })

res = pd.DataFrame(rows)
print(res.to_string(index=False))

# cross-check vs step1 pre-aggregates (2024+2025 combined)
print("\nCross-check combined Nov units:", int(df[df['mm']=='11']['units'].sum()), "(step1: 99,364)")
print("Cross-check combined Dec units:", int(df[df['mm']=='12']['units'].sum()), "(step1: 97,302)")

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step3_novdec_amplification.csv"
res.to_csv(out, index=False)
print("\nsaved:", out)

