df = pd.read_csv(path)
df["year"] = df["month"].str[:4]

rows = []
for y in ["2024", "2025"]:
    sub = df[df["year"] == y]
    rows.append({
        "year": y,
        "row_count": len(sub),
        "revenue_total": round(sub["revenue"].sum(), 2),
        "units_total": int(sub["units"].sum()),
        "months_covered": f"{sub['month'].min()}..{sub['month'].max()} ({sub['month'].nunique()})",
    })

annual = pd.DataFrame(rows)
r24 = annual.loc[annual.year=="2024","revenue_total"].iloc[0]
r25 = annual.loc[annual.year=="2025","revenue_total"].iloc[0]
yoy = (r25 - r24) / r24
annual.loc[annual.year=="2025","yoy_growth_rate"] = round(yoy, 6)
annual.loc[annual.year=="2024","yoy_growth_rate"] = ""

annual.to_csv(out, index=False)
print(annual.to_string(index=False))
print("\nYoY exact:", yoy)
print("Saved:", out)

