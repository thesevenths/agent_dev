import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
out  = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step3_novdec_amplification.csv"

df = pd.read_csv(path)
df["year"] = df["month"].str[:4]
df["m"] = df["month"].str[5:7].astype(int)
df["is_novdec"] = df["m"].isin([11, 12])

rows = []
for y in ["2024", "2025"]:
    sub = df[df["year"] == y]
    nd = sub[sub["is_novdec"]]
    jo = sub[~sub["is_novdec"]]
    nd_total = int(nd["units"].sum())
    jo_total = int(jo["units"].sum())
    nd_avg = nd_total / 2      # 2 months
    jo_avg = jo_total / 10     # 10 months
    rows.append({
        "year": y,
        "novdec_row_count": len(nd),
        "janoct_row_count": len(jo),
        "novdec_units_total": nd_total,
        "janoct_units_total": jo_total,
        "novdec_avg_monthly_units": round(nd_avg, 2),
        "janoct_avg_monthly_units": round(jo_avg, 2),
        "amplification_multiplier": round(nd_avg / jo_avg, 6),
    })

res = pd.DataFrame(rows)
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("\nSaved:", out)

