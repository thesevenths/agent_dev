import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

# consistency checks
months = sorted(df["month"].unique())
print("months:", months[0], "->", months[-1], "| count:", len(months))
print("rows per month:", df.groupby("month").size().unique())
print("rows per region:", df.groupby("region").size().unique())
print("rows per product_line:", df.groupby("product_line").size().unique())

# revenue vs units*unit_price consistency
diff = (df["revenue"] - df["units"]*df["unit_price"]).abs()
print("max |revenue - units*unit_price|:", diff.max())

# quick aggregates for downstream step
df["year"] = df["month"].str[:4]
print("\nAnnual revenue:\n", df.groupby("year")["revenue"].sum())
print("\nAnnual units:\n", df.groupby("year")["units"].sum())
df["m"] = df["month"].str[5:7].astype(int)
df["is_q4"] = df["m"].isin([11,12])
for y in ["2024","2025"]:
    sub = df[df.year==y]
    q4 = sub[sub.is_q4]["units"].sum(); rest = sub[~sub.is_q4]["units"].sum()
    print(f"{y}: Q4 units={q4}, rest units={rest}, ratio={q4/rest:.4f}, per-month avg Q4={q4/2:.1f}, per-month avg rest={rest/10:.1f}, per-month ratio={(q4/2)/(rest/10):.4f}")

```
