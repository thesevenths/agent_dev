rows = []
for y in ['2024', '2025']:
    sub = df[df['year'] == y]
    nd = sub[sub['mm'].isin(['11','12'])]
    jo = sub[~sub['mm'].isin(['11','12'])]
    nd_total = int(nd['units'].sum())
    jo_total = int(jo['units'].sum())
    nd_avg = nd_total / 2   # per-month avg over Nov, Dec
    jo_avg = jo_total / 10  # per-month avg over Jan..Oct
    rows.append({
        'year': y,
        'nov_dec_rows': len(nd),
        'jan_oct_rows': len(jo),
        'nov_dec_units_total': nd_total,
        'jan_oct_units_total': jo_total,
        'nov_dec_avg_monthly_units': round(nd_avg, 4),
        'jan_oct_avg_monthly_units': round(jo_avg, 4),
        'amplification_multiplier': round(nd_avg / jo_avg, 6),
    })


