import pandas as pd, numpy as np, json
from scipy import stats

df = pd.read_csv("offline_data/students.csv")
y = df["math_score"]
Xs = ["study_hours_per_week","attendance_pct","tutoring","screen_hours_per_day"]
n = len(df)

# Pearson correlation matrix (5x5)
corr = df[["math_score"]+Xs].corr()
print(corr.round(4))

# pairwise p-values with math_score
pw = {x: stats.pearsonr(y, df[x]) for x in Xs}
for x,(r,p) in pw.items():
    print(x, round(r,4), p)

# simple OLS
res = []
for x in Xs:
    r, p, r2, se, _ = stats.linregress(df[x], y)
    res.append({"variable": x, "slope": r, "intercept": float(np.mean(y)-r*np.mean(df[x])),
                "r_squared": r2, "p_value": p, "n": n})
    print(res[-1])

out = {"n": n,
       "correlation_matrix": corr.round(6).to_dict(),
       "pearson_with_math_score": {x: {"r": round(pw[x][0],6), "p_value": pw[x][1]} for x in Xs},
       "simple_ols": res}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp\step2_stats.json"
with open(path,"w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
