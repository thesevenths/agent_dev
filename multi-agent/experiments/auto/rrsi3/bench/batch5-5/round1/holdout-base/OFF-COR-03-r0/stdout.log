import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-COR-03-r0\_sandbox\offline_data\students.csv")
cols = ["math_score", "study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
n = len(df)

# Compute everything needed for the report
corr = df[cols].corr(method="pearson")
print("Corr with math_score:")
for c in cols[1:]:
    print(f"  {c}: {corr.loc['math_score', c]:.4f}")

print("\nMeans:")
for c in cols:
    print(f"  {c}: {df[c].mean():.4f}")

print("\nMin/Max:")
for c in cols:
    print(f"  {c}: min={df[c].min()}, max={df[c].max()}")

print("\nOLS:")
for x in cols[1:]:
    slope, intercept, r, p, se = stats.linregress(df[x], df["math_score"])
    print(f"  {x}: slope={slope:.4f}, intercept={intercept:.4f}, r2={r**2:.4f}, p={p:.2e}")

# tutoring group means
t1 = df[df["tutoring"]==1]["math_score"].mean()
t0 = df[df["tutoring"]==0]["math_score"].mean()
print(f"\ntutoring=1 mean math: {t1:.4f} (n={(df['tutoring']==1).sum()})")
print(f"tutoring=0 mean math: {t0:.4f} (n={(df['tutoring']==0).sum()})")
print(f"diff: {t1-t0:.4f}")

# attendance: per 10pp
print(f"attendance per 10pp: {0.2651*10:.4f}")

