import pandas as pd
import numpy as np
import json
from scipy import stats

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-COR-03-r0\_sandbox\offline_data\students.csv")

cols = ["math_score", "study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
n = len(df)

# (a) Pearson correlation matrix
corr = df[cols].corr(method="pearson")
print("Correlation matrix:")
print(corr.round(4).to_string())

# (b) Simple OLS slopes: math_score ~ each predictor
results = []
for x in cols[1:]:
    slope, intercept, r, p, se = stats.linregress(df[x], df["math_score"])
    r2 = r**2
    results.append({
        "predictor": x,
        "slope": round(slope, 4),
        "intercept": round(intercept, 4),
        "r": round(r, 4),
        "r_squared": round(r2, 4),
        "p_value": p,
        "se_slope": round(se, 4),
        "n": n,
    })
    print(f"{x}: slope={slope:.4f}, intercept={intercept:.4f}, r={r:.4f}, r2={r2:.4f}, p={p:.2e}")

res_df = pd.DataFrame(results)
print(res_df.to_string(index=False))

# Save correlation matrix
corr.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp\correlation_matrix.csv")

# Save regression results
res_df.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp\regression_slopes.csv", index=False)

# Also save as JSON for convenience
json_out = {
    "n": n,
    "correlation_matrix": corr.round(4).to_dict(),
    "regression": results,
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch5-5\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp\analysis_results.json", "w") as f:
    json.dump(json_out, f, indent=2)

print("\nAll artifacts saved.")

