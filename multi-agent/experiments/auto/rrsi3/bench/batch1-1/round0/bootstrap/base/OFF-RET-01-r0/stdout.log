import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]
last = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
thr = overall_mean - 2*overall_std
below = df[r < thr]

res = {
    "n_total": int(len(r)),
    "first30": {"weeks": f"{df['week'].iloc[0]}-{df['week'].iloc[29]}", "n": 30,
                "mean": float(first.mean()), "std_sample": float(first.std(ddof=1)),
                "std_pop": float(first.std(ddof=0)), "min": float(first.min()), "max": float(first.max())},
    "last30": {"weeks": f"{df['week'].iloc[30]}-{df['week'].iloc[59]}", "n": 30,
               "mean": float(last.mean()), "std_sample": float(last.std(ddof=1)),
               "std_pop": float(last.std(ddof=0)), "min": float(last.min()), "max": float(last.max())},
    "diff_mean_last_minus_first": float(last.mean() - first.mean()),
    "overall": {"n": 60, "mean": float(overall_mean), "std_sample": float(overall_std),
                "std_pop": float(r.std(ddof=0)), "min": float(r.min()), "max": float(r.max())},
    "threshold_mean_minus_2std": float(thr),
    "weeks_below_threshold": int(len(below)),
    "weeks_below_threshold_list": below["week"].tolist(),
    "values_below_threshold": below["retention_d7"].tolist(),
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round0\bootstrap\base\OFF-RET-01-r0\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

```
