```python
import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r5\_sandbox\tmp"

tot = df.groupby('region')['revenue'].sum()
grand = tot.sum()
n_months = df['month'].nunique()
summary = pd.DataFrame({
    'total_revenue': tot,
    'share_pct': tot/grand*100,
    'monthly_avg_revenue': tot/n_months,
    'rows': df.groupby('region')['revenue'].count(),
})
summary = summary.round(2)
summary.to_csv(f"{out_dir}\\region_summary.csv")
print(summary)

piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum').round(2)
piv.to_csv(f"{out_dir}\\region_monthly_revenue.csv")
print(piv)

# E region peak month detail
e = df[df['region']=='E'].groupby('month')['revenue'].sum().sort_values(ascending=False)
print(e.head(3))
print("E peak:", e.idxmax(), round(e.max(),2))
# E 2025-12 by product line
print(df[(df['region']=='E')&(df['month']=='2025-12')][['product_line','units','revenue']])
# E 2025-03 anomaly
print(df[(df['region']=='E')&(df['month']=='2025-03')][['product_line','units','revenue']])
# overall top months
print(piv.max(axis=1).sort_values(ascending=False).head(3))

