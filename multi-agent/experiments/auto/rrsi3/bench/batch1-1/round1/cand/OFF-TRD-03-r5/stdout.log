import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
print(df.shape)
print(df['month'].nunique(), df['month'].min(), df['month'].max())
print(df['region'].unique())

# per region totals
tot = df.groupby('region')['revenue'].sum()
print(tot)
grand = tot.sum()
print("grand:", grand)
share = tot/grand*100
print(share)
n_months = df['month'].nunique()
avg = tot/n_months
print(avg)

# monthly per region
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
print(piv)
top_region = tot.idxmax()
print("top region:", top_region)
peak_month = piv[top_region].idxmax()
print("peak month:", peak_month, piv.loc[peak_month, top_region])
# also global peak month
print(piv.idxmax(axis=1))

