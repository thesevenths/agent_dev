```python

import pandas as pd, json, os

path = r"offline_data/app_metrics.csv"
df = pd.read_csv(path)

out = {}
out["file"] = os.path.abspath(path)
out["shape"] = list(df.shape)
out["columns"] = list(df.columns)
out["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}
out["missing"] = {c: int(df[c].isna().sum()) for c in df.columns}
out["duplicated_weeks"] = int(df["week"].duplicated().sum())

for c in ["retention_d7","arpu_usd","churn_rate","cohort_size"]:
    s = df[c]
    out[c] = {"min": float(s.min()), "max": float(s.max()), "mean": float(s.mean()),
              "median": float(s.median()), "std": float(s.std(ddof=1))}

# correlations
out["corr_ret_arpu"] = float(df["retention_d7"].corr(df["arpu_usd"]))
out["corr_ret_churn"] = float(df["retention_d7"].corr(df["churn_rate"]))
out["corr_ret_arpu_spearman"] = float(df["retention_d7"].corr(df["arpu_usd"], method="spearman"))
out["corr_ret_churn_spearman"] = float(df["retention_d7"].corr(df["churn_rate"], method="spearman"))

med = df["retention_d7"].median()
out["retention_median"] = float(med)
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]
out["hi"] = {"n": int(len(hi)), "arpu_mean": float(hi["arpu_usd"].mean()),
             "cohort_total": int(hi["cohort_size"].sum()),
             "churn_mean": float(hi["churn_rate"].mean()),
             "retention_mean": float(hi["retention_d7"].mean()),
             "weeks": hi["week"].tolist()}
out["lo"] = {"n": int(len(lo)), "arpu_mean": float(lo["arpu_usd"].mean()),
             "cohort_total": int(lo["cohort_size"].sum()),
             "churn_mean": float(lo["churn_rate"].mean()),
             "retention_mean": float(lo["retention_d7"].mean()),
             "weeks": lo["week"].tolist()}
out["arpu_gap"] = out["hi"]["arpu_mean"] - out["lo"]["arpu_mean"]
out["arpu_gap_pct"] = out["arpu_gap"] / out["lo"]["arpu_mean"] * 100
out["total_cohort"] = int(df["cohort_size"].sum())

# check any week exactly at median
out["at_median"] = df.loc[df["retention_d7"] == med, "week"].tolist()

print(json.dumps(out, indent=2, ensure_ascii=False))

```
