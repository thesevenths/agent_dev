     "source": "offline_data/app_metrics.csv 的 retention_d7，retention_d7 > 0.39575 的周数"},
    {"metric": "high_group_arpu_usd_mean", "value": round(hi["arpu_usd"].mean(), 6),
     "source": "offline_data/app_metrics.csv 的 arpu_usd，retention_d7 > 中位数组均值，n=30 周"},
    {"metric": "high_group_cohort_size_sum", "value": int(hi["cohort_size"].sum()),
     "source": "offline_data/app_metrics.csv 的 cohort_size，retention_d7 > 中位数组求和，n=30 周"},
    {"metric": "high_group_churn_rate_mean", "value": round(hi["churn_rate"].mean(), 6),
     "source": "offline_data/app_metrics.csv 的 churn_rate，retention_d7 > 中位数组均值，n=30 周"},
    {"metric": "low_group_n_weeks", "value": len(lo),
     "source": "offline_data/app_metrics.csv 的 retention_d7，retention_d7 <= 0.39575 的周数"},
    {"metric": "low_group_arpu_usd_mean", "value": round(lo["arpu_usd"].mean(), 6),
     "source": "offline_data/app_metrics.csv 的 arpu_usd，retention_d7 <= 中位数组均值，n=30 周"},
    {"metric": "low_group_cohort_size_sum", "value": int(lo["cohort_size"].sum()),
