df = pd.read_csv(path)
med = df["retention_d7"].median()

rows = [
    {"metric": "retention_d7_median", "value": med, "n_rows": 60, "source": "offline_data/app_metrics.csv 的 retention_d7，60 行中位数"},
    {"metric": "pearson_corr_retention_d7_vs_arpu_usd", "value": df["retention_d7"].corr(df["arpu_usd"]), "n_rows": 60, "source": "offline_data/app_metrics.csv 的 retention_d7 与 arpu_usd，60 行 Pearson"},
    {"metric": "pearson_corr_retention_d7_vs_churn_rate", "value": df["retention_d7"].corr(df["churn_rate"]), "n_rows": 60, "source": "offline_data/app_metrics.csv 的 retention_d7 与 churn_rate，60 行 Pearson"},
]
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]
for name, g in [("high_retention_gt_median", hi), ("low_retention_le_median", lo)]:
    rows.append({"metric": f"{name}_n_rows", "value": len(g), "n_rows": len(g), "source": "offline_data/app_metrics.csv 的 retention_d7，按中位数 0.395750 分组"})
    rows.append({"metric": f"{name}_arpu_usd_mean", "value": g["arpu_usd"].mean(), "n_rows": len(g), "source": "offline_data/app_metrics.csv 的 arpu_usd，组内均值"})
    rows.append({"metric": f"{name}_cohort_size_sum", "value": int(g["cohort_size"].sum()), "n_rows": len(g), "source": "offline_data/app_metrics.csv 的 cohort_size，组内求和"})
    rows.append({"metric": f"{name}_churn_rate_mean", "value": g["churn_rate"].mean(), "n_rows": len(g), "source": "offline_data/app_metrics.csv 的 churn_rate，组内均值"})
    rows.append({"metric": f"{name}_retention_d7_range", "value": f"{g['retention_d7'].min()} ~ {g['retention_d7'].max()}", "n_rows": len(g), "source": "offline_data/app_metrics.csv 的 retention_d7，组内 min~max"})

res = pd.DataFrame(rows)
res.to_csv(out, index=False, encoding="utf-8-sig")
print(res.to_string())
print("saved:", out)

