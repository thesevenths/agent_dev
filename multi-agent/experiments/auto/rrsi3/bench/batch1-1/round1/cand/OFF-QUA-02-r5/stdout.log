5):\")\nprint(df.head(5).to_string())\nprint(\"=\" * 70)\n\n# --- 1) revenue consistency ---\nexpected = df[\"units\"] * df[\"unit_price\"]\ndev = (df[\"revenue\"] - expected).abs()\ndev_pct = dev / expected * 100.0\n\nn_bad = int((dev_pct > 0.5).sum())\nmax_dev_pct = float(dev_pct.max())\nmax_dev_idx = int(dev_pct.idxmax())\nmax_dev_row = df.loc[max_dev_idx]\n\nprint(\"expected_revenue = units * unit_price\")\nprint(\"rows with deviation_pct > 0.5% :\", n_bad)\nprint(\"max deviation_pct              :\", round(max_dev_pct, 6), \"%\")\nprint(\"max deviation row index        :\", max_dev_idx)\nprint(\"max deviation row              :\", max_dev_row.to_dict())\n\n# --- 2) returns > units ---\nn_ret_bad = int((df[\"returns\"] > df[\"units\"]).sum())\nprint(\"rows with returns > units      :\", n_ret_bad)\n\n# --- 3) per-row detail CSV ---\ndetail = df.copy()\ndetail[\"expected_revenue\"] = expected\ndetail[\"deviation_pct\"] = dev_pct.round(6)\ndetail[\"flag_dev_gt_0.5pct\"] = (dev_pct > 0.5).map({True: \"Y\", False: \"N\"})\ndetail[\"flag_returns_gt_units\"] = (df[\"returns\"] > df[\"units\"]).map({True: \"Y\", False: \"N\"})\ndetail.to_csv(CSV_OUT, index=False, encoding=\"utf-8-sig\")\n\nprint(\"=\" * 70)\nprint(\"FINAL SUMMARY\")\nprint(\"total_rows            :\", len(df))\nprint(\"rows_dev_gt_0.5pct    :\", n_bad)\nprint(\"max_deviation_pct     :\", round(max_dev_pct, 6))\nprint(\"max_deviation_row_idx :\", max_dev_idx)\nprint(\"rows_returns_gt_units :\", n_ret_bad)\nprint(\"detail_csv            :\", os.path.abspath(CSV_OUT))\nprint(\"=\" * 70)\n"}{"message": {"stdout": "======================================================================\nFILE: E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch1-1\\round1\\cand\\OFF-QUA-02-r5\\_sandbox\\offline_data\\regional_sales.csv\nCOLUMNS: ['month', 'region', 'product_line', 'units', 'unit_price', 'revenue', 'returns']\nDTYPES:\nmonth            object\nregion           object\nproduct_line     object\nun