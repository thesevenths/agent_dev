import pandas as pd

df = pd.read_csv('offline_data/students.csv')
df['group'] = (df['screen_hours_per_day'] > 5).map({True: 'high(>5)', False: 'low(<=5)'})

g = df.groupby('group').agg(
    n=('student_id', 'count'),
    screen_mean=('screen_hours_per_day', 'mean'),
    math_mean=('math_score', 'mean'),
    reading_mean=('reading_score', 'mean'),
).reindex(['low(<=5)', 'high(>5)'])
print(g.to_string())

diff_math = g.loc['high(>5)','math_mean'] - g.loc['low(<=5)','math_mean']
diff_read = g.loc['high(>5)','reading_mean'] - g.loc['low(<=5)','reading_mean']
print("diff math (high-low):", diff_math)
print("diff reading (high-low):", diff_read)

# t-tests for context
from scipy import stats
lo, hi = df[df['group']=='low(<=5)'], df[df['group']=='high(>5)']
t_m, p_m = stats.ttest_ind(hi['math_score'], lo['math_score'])
t_r, p_r = stats.ttest_ind(hi['reading_score'], lo['reading_score'])
print("math t-test p:", p_m, "reading t-test p:", p_r)

out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r5\_sandbox\tmp\step3_group_stats.csv'
g.reset_index().to_csv(out, index=False)
print("saved:", out)

