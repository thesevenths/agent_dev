```python
import pandas as pd

df = pd.read_csv('offline_data/students.csv')
n = len(df)

corr_math = df['screen_hours_per_day'].corr(df['math_score'])
corr_read = df['screen_hours_per_day'].corr(df['reading_score'])

# also p-values for context
from scipy import stats
t1, p1 = stats.pearsonr(df['screen_hours_per_day'], df['math_score'])
t2, p2 = stats.pearsonr(df['screen_hours_per_day'], df['reading_score'])

res = pd.DataFrame({
    'pair': ['screen_hours_per_day ~ math_score', 'screen_hours_per_day ~ reading_score'],
    'pearson_r': [corr_math, corr_read],
    'p_value': [p1, p2],
    'n': [n, n],
})
out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r5\_sandbox\tmp\step2_correlations.csv'
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

```
