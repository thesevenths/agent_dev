import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
cols = ["screen_hours_per_day","math_score","reading_score"]
n = len(df)

corr_math = df["screen_hours_per_day"].corr(df["math_score"])
corr_read = df["screen_hours_per_day"].corr(df["reading_score"])

df["group"] = df["screen_hours_per_day"].apply(lambda x: "high(>5)" if x > 5 else "low(<=5)")
g = df.groupby("group")[["math_score","reading_score"]].agg(["count","mean"])
print(g)

hi = df[df["screen_hours_per_day"]>5]
lo = df[df["screen_hours_per_day"]<=5]
res = {
  "n_total": int(n),
  "corr_screen_math": corr_math,
  "corr_screen_reading": corr_read,
  "groups": {
    "high_gt5": {"n": int(len(hi)), "math_mean": hi["math_score"].mean(), "reading_mean": hi["reading_score"].mean()},
    "low_le5":  {"n": int(len(lo)), "math_mean": lo["math_score"].mean(), "reading_mean": lo["reading_score"].mean()},
  },
  "mean_diff_high_minus_low": {
    "math": hi["math_score"].mean() - lo["math_score"].mean(),
    "reading": hi["reading_score"].mean() - lo["reading_score"].mean(),
  }
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r5\_sandbox\tmp\step2_stats.json"
with open(out,"w",encoding="utf-8") as f:
    json.dump(res,f,indent=2,ensure_ascii=False)
print(json.dumps(res,indent=2))
import os; print(os.path.exists(out), os.path.getsize(out))

