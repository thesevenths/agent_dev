import pandas as pd

df = pd.read_csv("offline_data/students.csv")

# cross-tab counts
counts = df.groupby(['grade','region']).size().unstack(fill_value=0)
means = df.groupby(['grade','region'])['reading_score'].mean().unstack()
print(counts)
print(means.round(4))

# full cross-tab with all combos
ct = df.groupby(['grade','region']).agg(n=('reading_score','size'), mean=('reading_score','mean')).reset_index()
print(ct)
print("max mean combo:", ct.loc[ct['mean'].idxmax()].to_dict())
print("min mean combo:", ct.loc[ct['mean'].idxmin()].to_dict())

# save inspection summary to file
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-02-r2\_sandbox\tmp\step1_inspection_summary.txt"
with open(out, 'w', encoding='utf-8') as f:
    f.write("students.csv inspection (step 1/3)\n")
    f.write(f"shape: {df.shape}\n")
    f.write(f"columns: {list(df.columns)}\n")
    f.write(f"missing values: {df.isna().sum().sum()} total (0 in all columns)\n")
    f.write(f"grade values: {sorted(df['grade'].unique())}\n")
    f.write(f"region values: {sorted(df['region'].unique())}\n")
    f.write(f"reading_score: mean={df['reading_score'].mean():.4f}, min={df['reading_score'].min()}, max={df['reading_score'].max()}, missing=0\n")
    f.write(f"duplicated rows: {df.duplicated().sum()}\n\n")
    f.write("grade x region counts:\n" + counts.to_string() + "\n\n")
    f.write("grade x region reading_score means:\n" + means.round(4).to_string() + "\n\n")
    f.write("long form:\n" + ct.to_string(index=False) + "\n")
print("saved:", out)

