import pandas as pd, json
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r2\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

df["group"] = (df["screen_hours_per_day"] > 5).map({True: "gt5", False: "le5"})

g = df.groupby("group").agg(
    n=("student_id", "count"),
    screen_mean=("screen_hours_per_day", "mean"),
    math_mean=("math_score", "mean"),
    reading_mean=("reading_score", "mean"),
    math_std=("math_score", "std"),
    reading_std=("reading_score", "std"),
)
print(g)

hi, lo = g.loc["gt5"], g.loc["le5"]
diff_math = hi["math_mean"] - lo["math_mean"]
diff_read = hi["reading_mean"] - lo["reading_mean"]

# Welch t-tests
t_math, p_math = stats.ttest_ind(df.loc[df.group=="gt5","math_score"], df.loc[df.group=="le5","math_score"], equal_var=False)
t_read, p_read = stats.ttest_ind(df.loc[df.group=="gt5","reading_score"], df.loc[df.group=="le5","reading_score"], equal_var=False)

res = {
    "source_file": path,
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "groups": {
        "gt5": {k: (int(v) if k=="n" else float(v)) for k,v in hi.items()},
        "le5": {k: (int(v) if k=="n" else float(v)) for k,v in lo.items()},
    },
    "mean_diff_gt5_minus_le5": {
        "math_score": {"diff": float(diff_math), "t_welch": float(t_math), "p_welch": float(p_math)},
        "reading_score": {"diff": float(diff_read), "t_welch": float(t_read), "p_welch": float(p_read)},
    },
}
print(json.dumps(res, indent=2))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r2\_sandbox\tmp\step3_group_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("saved:", out)

