import pandas as pd, json

df = pd.read_csv("offline_data/students.csv")
n = len(df)
r_math = df["screen_hours_per_day"].corr(df["math_score"])
r_read = df["screen_hours_per_day"].corr(df["reading_score"])
# also p-values via scipy
from scipy import stats
p_math = stats.pearsonr(df["screen_hours_per_day"], df["math_score"])[1]
p_read = stats.pearsonr(df["screen_hours_per_day"], df["reading_score"])[1]

out = {
    "n": n,
    "pearson": {
        "screen_hours_per_day_vs_math_score": {"r": round(r_math, 6), "p_value": p_math},
        "screen_hours_per_day_vs_reading_score": {"r": round(r_read, 6), "p_value": p_read},
    },
    "method": "Pearson correlation, n=400, no missing values",
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r2\_sandbox\tmp\step2_correlations.json", "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, indent=2))

