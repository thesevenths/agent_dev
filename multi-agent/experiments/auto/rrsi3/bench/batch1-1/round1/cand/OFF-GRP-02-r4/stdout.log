import pandas as pd

df = pd.read_csv("offline_data/students.csv")
print("duplicate student_id:", df['student_id'].duplicated().sum())

ct = df.groupby(['grade','region'], observed=True).agg(
    n=('reading_score','size'),
    mean_reading=('reading_score','mean')
).reset_index()
ct['mean_reading'] = ct['mean_reading'].round(4)
print(ct.to_string(index=False))

# also overall cross-tab of counts
print("\ncount crosstab:")
print(pd.crosstab(df['grade'], df['region']))
print("\nmean crosstab:")
print(df.pivot_table(index='grade', columns='region', values='reading_score', aggfunc='mean').round(4))

```
