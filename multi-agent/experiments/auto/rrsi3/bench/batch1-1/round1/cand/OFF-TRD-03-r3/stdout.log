```python
import pandas as pd, json, os

csv_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r3\_sandbox\offline_data\regional_sales.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r3\_sandbox\tmp"

df = pd.read_csv(csv_path)
assert len(df) == 288 and set(df["region"]) == {"N","S","E","W"}

n_months = df["month"].nunique()  # 24

# per-region aggregates
g = df.groupby("region")["revenue"].agg(total="sum", rows="count")
grand = df["revenue"].sum()
g["share"] = g["total"] / grand
g["monthly_avg"] = g["total"] / n_months
g = g.reindex(["N","S","E","W"])

# per-region monthly totals to find peak month
monthly = df.groupby(["region","month"])["revenue"].sum().reset_index()
top_region = g["total"].idxmax()
top_row = g.loc[top_region]
peak = monthly[monthly["region"] == top_region].sort_values("revenue", ascending=False).iloc[0]

result = {
    "source_csv": csv_path,
    "n_rows": int(len(df)),
    "n_months": int(n_months),
    "month_range": [df["month"].min(), df["month"].max()],
    "grand_total_revenue": float(grand),
    "regions": {
        r: {
            "total_revenue": float(g.loc[r, "total"]),
            "share_of_grand_total": float(g.loc[r, "share"]),
            "monthly_avg_revenue": float(g.loc[r, "monthly_avg"]),
            "rows_used": int(g.loc[r, "rows"]),
        } for r in ["N","S","E","W"]
    },
    "top_region": top_region,
    "top_region_total": float(top_row["total"]),
    "top_region_share": float(top_row["share"]),
    "top_region_peak_month": peak["month"],
    "top_region_peak_month_revenue": float(peak["revenue"]),
}

# save JSON
json_path = os.path.join(out_dir, "regional_aggregates.json")
with open(json_path, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

# save CSV artifact
rows = []
for r in ["N","S","E","W"]:
    d = result["regions"][r]
    rows.append({
        "region": r,
        "total_revenue": round(d["total_revenue"], 2),
        "share_of_grand_total": round(d["share_of_grand_total"], 6),
        "monthly_avg_revenue": round(d["monthly_avg_revenue"], 2),
        "rows_used": d["rows_used"],
        "is_top_region": r == top_region,
        "peak_month": peak["month"] if r == top_region else "",
        "peak_month_revenue": round(peak["revenue"], 2) if r == top_region else "",
    })
csv_out = os.path.join(out_dir, "regional_aggregates.csv")
pd.DataFrame(rows).to_csv(csv_out, index=False)

print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", json_path)
print("saved:", csv_out)

```
