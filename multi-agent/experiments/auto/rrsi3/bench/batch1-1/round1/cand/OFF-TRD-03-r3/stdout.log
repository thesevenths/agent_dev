import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

info = {}
info["file"] = os.path.abspath(path)
info["columns"] = list(df.columns)
info["dtypes"] = {c: str(t) for c, t in df.dtypes.items()}
info["n_rows"] = int(len(df))
info["n_cols"] = int(df.shape[1])
info["regions"] = sorted(df["region"].unique().tolist())
info["regions_expected"] = ["N","S","E","W"]
info["regions_ok"] = set(df["region"].unique()) == {"N","S","E","W"}
info["months"] = [df["month"].min(), df["month"].max()]
info["n_months"] = int(df["month"].nunique())
info["product_lines"] = sorted(df["product_line"].unique().tolist())
info["nulls"] = {c: int(df[c].isna().sum()) for c in df.columns}
info["dup_rows"] = int(df.duplicated().sum())
info["revenue_min"] = float(df["revenue"].min())
info["revenue_max"] = float(df["revenue"].max())
info["revenue_negative"] = int((df["revenue"] < 0).sum())
info["rows_per_region"] = df.groupby("region")["revenue"].count().to_dict()
info["rows_per_month"] = int(df.groupby("month")["revenue"].count().min())

# quick sanity: revenue ≈ units*unit_price?
df["calc"] = df["units"]*df["unit_price"]
info["revenue_mismatch_rows"] = int((abs(df["calc"]-df["revenue"])>0.01).sum())

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r3\_sandbox\tmp\csv_validation.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(info, f, ensure_ascii=False, indent=2)
print(json.dumps(info, ensure_ascii=False, indent=2))
print("saved:", out)

