import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)

# Correlations (Pearson)
corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] <= med]

rows = []
rows.append({"metric": "n_total", "value": n})
rows.append({"metric": "retention_d7_median", "value": med})
rows.append({"metric": "corr_retention_d7_arpu_usd", "value": corr_arpu})
rows.append({"metric": "corr_retention_d7_churn_rate", "value": corr_churn})
rows.append({"metric": "high_group_n", "value": len(high)})
rows.append({"metric": "high_group_arpu_usd_mean", "value": high["arpu_usd"].mean()})
rows.append({"metric": "high_group_cohort_size_sum", "value": int(high["cohort_size"].sum())})
rows.append({"metric": "low_group_n", "value": len(low)})
rows.append({"metric": "low_group_arpu_usd_mean", "value": low["arpu_usd"].mean()})
rows.append({"metric": "low_group_cohort_size_sum", "value": int(low["cohort_size"].sum())})
rows.append({"metric": "arpu_gap_high_minus_low", "value": high["arpu_usd"].mean() - low["arpu_usd"].mean()})
rows.append({"metric": "arpu_ratio_high_over_low", "value": high["arpu_usd"].mean() / low["arpu_usd"].mean()})

out = pd.DataFrame(rows)
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-03-r1\_sandbox\tmp\step2_results.csv"
out.to_csv(out_path, index=False)
print(out.to_string(index=False))
print("\nSaved to:", out_path)

