import pandas as pd, json
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r3\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
df["group"] = (df["screen_hours_per_day"] > 5).map({True: "gt5", False: "le5"})

rows = []
for g, sub in df.groupby("group"):
    rows.append({
        "group": g,
        "n": int(len(sub)),
        "screen_mean": float(sub["screen_hours_per_day"].mean()),
        "math_mean": float(sub["math_score"].mean()),
        "reading_mean": float(sub["reading_score"].mean()),
        "math_std": float(sub["math_score"].std(ddof=1)),
        "reading_std": float(sub["reading_score"].std(ddof=1)),
    })
    print(rows[-1])

hi = [r for r in rows if r["group"]=="gt5"][0]
lo = [r for r in rows if r["group"]=="le5"][0]

# t-tests (Welch)
t_math, p_math = stats.ttest_ind(df.loc[df.group=="gt5","math_score"], df.loc[df.group=="le5","math_score"], equal_var=False)
t_read, p_read = stats.ttest_ind(df.loc[df.group=="gt5","reading_score"], df.loc[df.group=="le5","reading_score"], equal_var=False)
print("t math:", t_math, p_math, " t read:", t_read, p_read)

out = {
    "source_file": path,
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "groups": rows,
    "mean_diff_gt5_minus_le5": {
        "math_score": float(hi["math_mean"] - lo["math_mean"]),
        "reading_score": float(hi["reading_mean"] - lo["reading_mean"]),
    },
    "welch_ttest": {
        "math_score": {"t": float(t_math), "p": float(p_math)},
        "reading_score": {"t": float(t_read), "p": float(p_read)},
    },
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r3\_sandbox\tmp\step3_group_stats.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved", out_path)

