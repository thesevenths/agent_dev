import pandas as pd, json
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r3\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
results = {}
for x, y in pairs:
    sub = df[[x, y]].dropna()
    r, p = stats.pearsonr(sub[x], sub[y])
    results[f"{x}_vs_{y}"] = {
        "n": int(len(sub)),
        "pearson_r": float(r),
        "p_value": float(p),
        "r_squared": float(r**2),
    }
    print(x, y, "n=", len(sub), "r=", r, "p=", p, "r2=", r**2)

out = {"source_file": path, "method": "Pearson correlation (scipy.stats.pearsonr)", "results": results}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r3\_sandbox\tmp\step2_correlations.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved", out_path)

```
