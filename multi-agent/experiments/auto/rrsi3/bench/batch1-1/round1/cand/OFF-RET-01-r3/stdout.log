import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
thr = overall_mean - 2*overall_std
below = df[r < thr]

res = {
  "n_weeks": int(len(r)),
  "first30": {"weeks": f"W01-W30", "mean": first.mean(), "std": first.std(ddof=1), "n": 30},
  "last30": {"weeks": f"W31-W60", "mean": last.mean(), "std": last.std(ddof=1), "n": 30},
  "diff_mean_last_minus_first": last.mean() - first.mean(),
  "overall": {"mean": overall_mean, "std": overall_std, "n": 60},
  "threshold_mean_minus_2std": thr,
  "weeks_below_threshold": int((r < thr).sum()),
  "weeks_below_threshold_list": below["week"].tolist(),
  "min_week": {"week": df.loc[r.idxmin(),"week"], "value": r.min()},
  "max_week": {"week": df.loc[r.idxmax(),"week"], "value": r.max()},
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-01-r3\_sandbox\tmp\retention_d7_stats.json"
os.makedirs(os.path.dirname(out), exist_ok=True)
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
