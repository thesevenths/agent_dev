import pandas as pd
df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
first, last = r.iloc[:30], r.iloc[30:]
om, osd = r.mean(), r.std(ddof=1)
thr = om - 2*osd
below = df.loc[r < thr]
print(len(below), below['week'].tolist(), below['retention_d7'].tolist())
print(f"first mean {first.mean():.4f} std {first.std(ddof=1):.4f}")
print(f"last mean {last.mean():.4f} std {last.std(ddof=1):.4f}")
print(f"diff mean {first.mean()-last.mean():.4f} diff std {first.std(ddof=1)-last.std(ddof=1):.4f}")
print(f"overall mean {om:.4f} std {osd:.4f} thr {thr:.4f}")
print(f"rel drop {(first.mean()-last.mean())/first.mean()*100:.2f}%")

```
