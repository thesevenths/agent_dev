import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/app_metrics.csv')
r = df['retention_d7']
first = r.iloc[:30]
last = r.iloc[30:]
overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
below = (r < threshold).sum()

stats = {
    'n': len(r),
    'first_mean': first.mean(), 'first_std': first.std(ddof=1),
    'last_mean': last.mean(), 'last_std': last.std(ddof=1),
    'diff_mean': first.mean() - last.mean(),
    'diff_std': first.std(ddof=1) - last.std(ddof=1),
    'overall_mean': overall_mean, 'overall_std': overall_std,
    'threshold': threshold, 'below_count': int(below),
    'min': r.min(), 'max': r.max(),
    'first_min': first.min(), 'first_max': first.max(),
    'last_min': last.min(), 'last_max': last.max(),
}
for k,v in stats.items():
    print(k, v)
print('weeks below threshold:', df.loc[r < threshold, 'week'].tolist())
# also population std for reference
print('overall_std_pop', r.std(ddof=0))

```
