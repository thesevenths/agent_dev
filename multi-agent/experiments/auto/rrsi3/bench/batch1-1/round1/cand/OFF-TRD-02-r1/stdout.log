import pandas as pd, os

df = pd.read_csv(r"offline_data/regional_sales.csv")
n = len(df)
months = sorted(df['month'].unique())
regions = sorted(df['region'].unique())

g = df.groupby('product_line').agg(
    units=('units','sum'),
    revenue=('revenue','sum'),
    avg_price=('unit_price','mean'),
    rows=('units','size')
).reset_index()
g['share'] = g['revenue']/g['revenue'].sum()*100
g = g.sort_values('revenue', ascending=False).reset_index(drop=True)
print(g.to_string())
print("total revenue:", df['revenue'].sum(), "total units:", df['units'].sum())
print("months:", months[0], "->", months[-1], "count", len(months))
print("regions:", regions)
top = g.iloc[0]
print("top:", top['product_line'], top['share'])

# extra: monthly trend of top line
top_line = top['product_line']
mt = df[df['product_line']==top_line].groupby('month')['revenue'].sum()
print(mt.head(3).to_string(), "...", mt.tail(3).to_string())
print("first/last month rev:", mt.iloc[0], mt.iloc[-1])

# returns by line
rt = df.groupby('product_line')['returns'].sum()
print(rt.to_string())

```
