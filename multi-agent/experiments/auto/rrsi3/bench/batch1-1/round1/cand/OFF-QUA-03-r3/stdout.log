import pandas as pd
SRC = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-QUA-03-r3\_sandbox\offline_data\regional_sales.csv"
src = pd.read_csv(SRC)
src["month"] = pd.to_datetime(src["month"], errors="coerce")
src["return_rate"] = src["returns"]/src["units"]
for (reg, pl) in [("E","Service"),("S","Service"),("E","Hardware")]:
    sub = src[(src.region==reg)&(src.product_line==pl)].sort_values("month")
    print(reg, pl, "mean_rr:", round(sub.return_rate.mean()*100,2), "n:", len(sub))
    print(sub.tail(4)[["month","units","returns","return_rate"]].to_string(index=False))
    print()

```
