import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df["week"].str.match(r"^W(3[0-9]|4[0-3])$")].copy()
sub["x"] = np.arange(len(sub))

fig, axes = plt.subplots(3, 1, figsize=(10, 9), sharex=True)

# retention_d7
axes[0].plot(sub["x"], sub["retention_d7"], "o-", color="#2196F3", label="retention_d7")
axes[0].axvline(x=6, color="red", linestyle="--", alpha=0.7, label="W36→W37 breakpoint")
axes[0].set_ylabel("retention_d7")
axes[0].legend(loc="upper right")
axes[0].set_title("Weekly Metrics W30–W43: Retention / Churn / ARPU")
axes[0].grid(True, alpha=0.3)

# churn_rate
axes[1].plot(sub["x"], sub["churn_rate"], "s-", color="#FF5722", label="churn_rate")
