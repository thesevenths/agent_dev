import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df["week"].str.match(r"^W(3[0-9]|4[0-3])$")].copy()
cols = ["retention_d7", "churn_rate", "arpu_usd"]

# 逐周环比，看断点在哪一周
sub["ret_d7_wow"] = sub["retention_d7"].diff()
sub["churn_wow"] = sub["churn_rate"].diff()
sub["arpu_wow"] = sub["arpu_usd"].diff()
print(sub[["week","ret_d7_wow","churn_wow","arpu_wow"]].to_string(index=False))

# 前后均值
pre = sub[sub["week"] <= "W36"][cols].mean()
post = sub[sub["week"] >= "W37"][cols].mean()
print("\npre:\n", pre.round(6))
print("post:\n", post.round(6))
print("diff:\n", (post-pre).round(6))
print("rel%:\n", ((post-pre)/pre*100).round(4))

# 断点周 W37 相对 W36 的单周变化
w36 = sub[sub["week"]=="W36"][cols].iloc[0]
w37 = sub[sub["week"]=="W37"][cols].iloc[0]
print("\nW36:\n", w36)
print("W37:\n", w37)
print("W37-W36:\n", (w37-w36).round(6))
print("rel%:\n", ((w37-w36)/w36*100).round(4))

# 断点周变化占前后段总变化的比例
print("\nshare of total shift captured at W37:")
for c in cols:
    total = post[c]-pre[c]
    step = w37[c]-w36[c]
    print(c, round(step/total*100,2), "%")

```
