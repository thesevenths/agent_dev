import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df["week"].str.match(r"^W(3[0-9]|4[0-3])$")].copy()
cols = ["retention_d7", "churn_rate", "arpu_usd"]

# 逐周环比
sub["ret_d7_wow"] = sub["retention_d7"].diff()
sub["churn_wow"] = sub["churn_rate"].diff()
sub["arpu_wow"] = sub["arpu_usd"].diff()

# 前后段均值
pre = sub[sub["week"] <= "W36"][cols].mean()
post = sub[sub["week"] >= "W37"][cols].mean()
diff = post - pre
rel = (diff / pre * 100)

# 断点周 W37 相对 W36 的单周变化
w36 = sub[sub["week"] == "W36"][cols].iloc[0]
w37 = sub[sub["week"] == "W37"][cols].iloc[0]
step = w37 - w36
step_rel = (step / w36 * 100)

# 断点周变化占前后段总变化的比例
share = (step / diff * 100)

# 前后段极值
pre_min_ret = sub[sub["week"] <= "W36"]["retention_d7"].min()
pre_max_ret = sub[sub["week"] <= "W36"]["retention_d7"].max()
post_min_ret = sub[sub["week"] >= "W37"]["retention_d7"].min()
post_max_ret = sub[sub["week"] >= "W37"]["retention_d7"].max()

pre_min_churn = sub[sub["week"] <= "W36"]["churn_rate"].min()
pre_max_churn = sub[sub["week"] <= "W36"]["churn_rate"].max()
post_min_churn = sub[sub["week"] >= "W37"]["churn_rate"].min()
post_max_churn = sub[sub["week"] >= "W37"]["churn_rate"].max()

pre_min_arpu = sub[sub["week"] <= "W36"]["arpu_usd"].min()
pre_max_arpu = sub[sub["week"] <= "W36"]["arpu_usd"].max()
post_min_arpu = sub[sub["week"] >= "W37"]["arpu_usd"].min()
post_max_arpu = sub[sub["week"] >= "W37"]["arpu_usd"].max()

print("=== 前后段均值 ===")
print(pre.round(6))
print(post.round(6))
print("diff:", diff.round(6))
print("rel%:", rel.round(4))

print("\n=== W37 vs W36 单周变化 ===")
print(step.round(6))
print("rel%:", step_rel.round(4))
print("share of total shift:", share.round(2))

print("\n=== 极值 ===")
print(f"retention_d7: pre [{pre_min_ret}, {pre_max_ret}], post [{post_min_ret}, {post_max_ret}]")
print(f"churn_rate:   pre [{pre_min_churn}, {pre_max_churn}], post [{post_min_churn}, {post_max_churn}]")
