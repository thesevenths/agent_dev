import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-02-r3\_sandbox"
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))

g = df.groupby(["grade","region"], observed=True)["reading_score"].agg(["count","mean"]).reset_index()
g = g.sort_values(["grade","region"]).reset_index(drop=True)
print(g.to_string(index=False))
print("overall mean:", df["reading_score"].mean())
print("dup student_id:", df["student_id"].duplicated().sum())

out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)
out = os.path.join(out_dir, "step1_inspection_summary.txt")
with open(out, "w", encoding="utf-8") as f:
    f.write("students.csv inspection summary\n")
    f.write(f"shape: {df.shape}\n")
    f.write(f"columns: {list(df.columns)}\n")
    f.write(f"nulls: 0 in all columns\n")
    f.write(f"grade values: {sorted(df['grade'].unique())}\n")
    f.write(f"region values: {sorted(df['region'].unique())}\n")
    f.write(f"reading_score: mean={df['reading_score'].mean():.4f}, min={df['reading_score'].min()}, max={df['reading_score'].max()}\n")
    f.write("grade x region count/mean:\n")
    f.write(g.to_string(index=False) + "\n")
print("saved:", out)

```
