```python

import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')

# region totals
tot = df.groupby('region')['revenue'].sum()
grand = df['revenue'].sum()
print("grand total:", round(grand,2))
print(tot.round(2))
print((tot/grand*100).round(2))
print("monthly avg:", (tot/24).round(2))

# monthly by region
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
print(piv.round(2))

# top region & its peak month
top_region = tot.idxmax()
peak_month = piv.loc[:, top_region].idxmax()
print("top region:", top_region, "peak month:", peak_month, "peak value:", round(piv.loc[peak_month, top_region],2))

# overall peak month per region
for r in ['N','S','E','W']:
    m = piv[r].idxmax()
    print(r, "peak:", m, round(piv[r].max(),2))

# save validation summary
summary = {
    "file": "offline_data/regional_sales.csv",
    "rows": int(df.shape[0]),
    "columns": list(df.columns),
    "regions": sorted(df['region'].unique()),
    "months": [df['month'].min(), df['month'].max(), int(df['month'].nunique())],
    "product_lines": sorted(df['product_line'].unique()),
    "null_cells": int(df.isnull().sum().sum()),
    "duplicate_keys": int(df.duplicated(subset=['month','region','product_line']).sum()),
    "nonpositive_revenue": int((df['revenue']<=0).sum()),
    "rows_per_region": df['region'].value_counts().to_dict(),
    "rows_per_month": int(df.groupby('month').size().iloc[0]),
    "grand_total_revenue": round(float(grand),2),
    "region_totals": {k: round(float(v),2) for k,v in tot.items()},
    "region_share_pct": {k: round(float(v/grand*100),2) for k,v in tot.items()},
    "region_monthly_avg": {k: round(float(v/24),2) for k,v in tot.items()},
    "top_region": top_region,
    "top_region_peak_month": peak_month,
    "top_region_peak_value": round(float(piv.loc[peak_month, top_region]),2),
    "per_region_peak": {r: {"month": piv[r].idxmax(), "value": round(float(piv[r].max()),2)} for r in ['N','S','E','W']},
}
import json
with open(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r1\_sandbox\tmp\step1_validation_summary.json','w',encoding='utf-8') as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("saved")

