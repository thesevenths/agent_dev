import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')

# Per-region aggregates
tot = df.groupby('region')['revenue'].sum()
grand = df['revenue'].sum()
n_months = df['month'].nunique()

agg = pd.DataFrame({
    'total_revenue': tot,
    'share_pct': tot / grand * 100,
    'monthly_avg_revenue': tot / n_months,
})
agg = agg.round(2)

# Peak month per region
piv = df.pivot_table(index='month', columns='region', values='revenue', aggfunc='sum')
peak = pd.DataFrame({
    'peak_month': piv.idxmax(),
    'peak_month_revenue': piv.max().round(2),
})

out = agg.join(peak)
out = out.loc[['N','S','E','W']]
print(out)

# Top region
top = out['total_revenue'].idxmax()
print("top region:", top, "peak:", out.loc[top,'peak_month'], out.loc[top,'peak_month_revenue'])

# Save intermediate CSV
out_path = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r1\_sandbox\tmp\step2_regional_aggregates.csv'
out.to_csv(out_path, encoding='utf-8-sig')
print("saved:", out_path)

# Also save monthly pivot for step 3
piv_path = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r1\_sandbox\tmp\step2_monthly_revenue_by_region.csv'
piv.round(2).to_csv(piv_path, encoding='utf-8-sig')
print("saved:", piv_path)

