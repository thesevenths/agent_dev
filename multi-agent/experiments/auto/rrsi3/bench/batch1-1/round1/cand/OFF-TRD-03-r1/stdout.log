import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')

# Per-region aggregates
tot = df.groupby('region')['revenue'].sum()
grand = df['revenue'].sum()
n_months = df['month'].nunique()

agg = pd.DataFrame({
    'total_revenue': tot,
    'share_pct': tot / grand * 100,
    'monthly_avg_revenue': tot / n_months,
})
agg = agg.round(2)

# Peak month per region
