    "le5": {"n": int(lo.n), "mean_math": round(lo.mean_math,4), "mean_reading": round(lo.mean_reading,4), "mean_screen": round(lo.mean_screen,4)},
  },
  "diff_gt5_minus_le5": {
    "mean_math": round(hi.mean_math - lo.mean_math, 4),
    "mean_reading": round(hi.mean_reading - lo.mean_reading, 4),
  }
}
