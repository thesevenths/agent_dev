```python
import pandas as pd
import json
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

def grp(g):
    return {
        "n": int(len(g)),
        "screen_mean": float(g["screen_hours_per_day"].mean()),
        "math_mean": float(g["math_score"].mean()),
        "reading_mean": float(g["reading_score"].mean()),
        "math_std": float(g["math_score"].std(ddof=1)),
        "reading_std": float(g["reading_score"].std(ddof=1)),
    }

g_hi, g_lo = grp(hi), grp(lo)

# t-tests (Welch) for mean differences
t_math, p_math = stats.ttest_ind(hi["math_score"], lo["math_score"], equal_var=False)
t_read, p_read = stats.ttest_ind(hi["reading_score"], lo["reading_score"], equal_var=False)

out = {
    "source_file": path,
    "split_rule": "screen_hours_per_day > 5 (high) vs <= 5 (low)",
    "n_total": int(len(df)),
    "group_high_gt5": g_hi,
    "group_low_le5": g_lo,
    "mean_diff_high_minus_low": {
        "math": float(g_hi["math_mean"] - g_lo["math_mean"]),
        "reading": float(g_hi["reading_mean"] - g_lo["reading_mean"]),
        "screen": float(g_hi["screen_mean"] - g_lo["screen_mean"]),
    },
    "welch_ttest": {
        "math": {"t": float(t_math), "p": float(p_math)},
        "reading": {"t": float(t_read), "p": float(p_read)},
    },
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r1\_sandbox\tmp\step3_group_stats.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)

print(json.dumps(out, indent=2, ensure_ascii=False))
print("saved:", out_path)

