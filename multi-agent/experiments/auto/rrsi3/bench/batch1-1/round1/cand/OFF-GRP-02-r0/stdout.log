import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-02-r0\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-02-r0\_sandbox\tmp\step2_crosstab.csv"

df = pd.read_csv(src)
g = df.groupby(['grade', 'region'], observed=True).agg(
    row_count=('reading_score', 'size'),
    mean_reading_score=('reading_score', 'mean'),
).reset_index()

# order grades G10..G12, regions A..D
g['grade'] = pd.Categorical(g['grade'], categories=['G10','G11','G12'], ordered=True)
g['region'] = pd.Categorical(g['region'], categories=['A','B','C','D'], ordered=True)
g = g.sort_values(['grade','region']).reset_index(drop=True)
