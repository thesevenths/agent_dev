print("n cells:", len(g))

hi = g.loc[g['mean_reading_score'].idxmax()]
lo = g.loc[g['mean_reading_score'].idxmin()]
print("MAX:", hi['grade'], hi['region'], hi['mean_reading_score'], "n=", hi['row_count'])
print("MIN:", lo['grade'], lo['region'], lo['mean_reading_score'], "n=", lo['row_count'])
print("diff:", round(hi['mean_reading_score']-lo['mean_reading_score'],4))

g.to_csv(out, index=False)
print("saved:", out)

