import pandas as pd, json, os

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-STAT-02-r1\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-STAT-02-r1\_sandbox\tmp"

df = pd.read_csv(src)
print(df.shape)
print(df.head())
print(df.dtypes)
print("nulls:", df[['math_score','reading_score']].isna().sum().to_dict())

cols = ['math_score','reading_score']
res = {}
for c in cols:
    s = df[c].dropna()
    res[c] = {
        'n': int(s.count()),
        'mean': float(s.mean()),
        'std_sample': float(s.std(ddof=1)),
        'std_pop': float(s.std(ddof=0)),
        'median': float(s.median()),
        'min': float(s.min()),
        'max': float(s.max()),
    }
    res[c]['cv_sample'] = res[c]['std_sample']/res[c]['mean']
    res[c]['cv_pop'] = res[c]['std_pop']/res[c]['mean']

corr = float(df[cols].corr(method='pearson').iloc[0,1])
res['pearson_corr'] = corr
res['n_pairs'] = int(df[cols].dropna().shape[0])
res['source_file'] = 'offline_data/students.csv'

out = os.path.join(out_dir, 'stats_results.json')
with open(out,'w',encoding='utf-8') as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

