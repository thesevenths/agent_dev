import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)  # sample std
threshold = overall_mean - 2*overall_std
below = df[r < threshold]

stats = {
    "as_of": "2026-10-25 22:48",
    "n_total": len(r),
    "first30": {"weeks": f"{df['week'].iloc[0]}-{df['week'].iloc[29]}", "n": len(first30),
                "mean": first30.mean(), "std": first30.std(ddof=1)},
    "last30": {"weeks": f"{df['week'].iloc[30]}-{df['week'].iloc[59]}", "n": len(last30),
               "mean": last30.mean(), "std": last30.std(ddof=1)},
    "overall": {"mean": overall_mean, "std": overall_std, "threshold": threshold},
    "diff_mean_last_minus_first": last30.mean() - first30.mean(),
    "diff_std_last_minus_first": last30.std(ddof=1) - first30.std(ddof=1),
    "weeks_below_2sigma": {"count": len(below), "weeks": below["week"].tolist(),
                           "values": below["retention_d7"].tolist()},
}
print(json.dumps(stats, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-01-r5\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(stats, f, indent=2, ensure_ascii=False)
print("saved:", out)

