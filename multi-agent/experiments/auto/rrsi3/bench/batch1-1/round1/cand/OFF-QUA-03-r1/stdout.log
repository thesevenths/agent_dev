```python
import pandas as pd, os
base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-QUA-03-r1\_sandbox"
src = os.path.join(base, "offline_data", "regional_sales.csv")
out = os.path.join(base, "offline_data", "anomaly_ratios.csv")

df = pd.read_csv(src)
df = df.sort_values(["region", "product_line", "month"]).reset_index(drop=True)

# 24-month rolling mean of units per (region x product_line), min_periods=24
g = df.groupby(["region", "product_line"], sort=False)["units"]
df["mean_24m"] = g.transform(lambda s: s.rolling(24, min_periods=24).mean())
df["ratio_vs_24m_mean"] = df["units"] / df["mean_24m"]

res = df[["region", "product_line", "month", "units", "mean_24m", "ratio_vs_24m_mean"]].copy()
res.to_csv(out, index=False)

print("SAVED:", os.path.abspath(out))
print("rows:", len(res), "cols:", list(res.columns))
print("non-null ratio rows:", res["ratio_vs_24m_mean"].notna().sum())
print(res.dropna(subset=["ratio_vs_24m_mean"]).sort_values("ratio_vs_24m_mean", ascending=False).head(5).to_string())

```
