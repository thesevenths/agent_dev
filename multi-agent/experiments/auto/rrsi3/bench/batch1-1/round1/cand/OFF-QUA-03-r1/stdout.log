import pandas as pd, os
base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-QUA-03-r1\_sandbox"
src = os.path.join(base, "offline_data", "regional_sales.csv")
df = pd.read_csv(src)

# full-period (24-month) mean per series as baseline
mean = df.groupby(["region","product_line"])["units"].mean().rename("full_period_mean")
df = df.merge(mean, on=["region","product_line"])
df["ratio"] = df["units"] / df["full_period_mean"]
df["return_rate"] = df["returns"] / df["units"]

top3 = df.sort_values("ratio", ascending=False).head(3)
top3.to_csv(os.path.join(base, "offline_data", "top3_anomalies.csv"), index=False)

# stuffing assessment: compare spike-month return rate vs series avg return rate,
# and check whether the spike month is followed by a drop (reversal)
rows = []
for (r, pl), sub in df.groupby(["region","product_line"]):
    sub = sub.sort_values("month")
    peak = sub.loc[sub["ratio"].idxmax()]
    avg_rr = sub["return_rate"].mean()
    # next month units if exists
    idx = sub.index.get_loc(peak.name)
    next_units = sub["units"].iloc[idx+1] if idx+1 < len(sub) else None
    prev_units = sub["units"].iloc[idx-1] if idx-1 >= 0 else None
    rows.append(dict(region=r, product_line=pl, peak_month=peak["month"],
                     peak_units=int(peak["units"]), ratio=peak["ratio"],
                     peak_return_rate=peak["return_rate"], series_avg_return_rate=avg_rr,
                     rr_excess=peak["return_rate"]-avg_rr,
                     next_month_units=next_units, prev_month_units=prev_units,
                     next_vs_peak=(next_units/peak["units"]) if next_units else None))
assess = pd.DataFrame(rows)
assess.to_csv(os.path.join(base, "offline_data", "stuffing_assessment.csv"), index=False)

print(top3[["region","product_line","month","units","full_period_mean","ratio","returns","return_rate"]].to_string())
print()
print(assess.to_string())
print()
# context: overall stats
print("total rows:", len(df), "series:", df.groupby(["region","product_line"]).ngroups)
print("overall return rate:", df["returns"].sum()/df["units"].sum())

