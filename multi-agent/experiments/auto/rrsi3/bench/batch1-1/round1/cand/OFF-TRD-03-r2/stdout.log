import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")

grand_total = df['revenue'].sum()
n_months = df['month'].nunique()

region_total = df.groupby('region')['revenue'].sum().round(2)
region_monthly = df.groupby(['region','month'])['revenue'].sum().round(2).reset_index()

result = {
    "as_of": "2026-10-26 00:05",
    "source": "offline_data/regional_sales.csv",
    "n_rows": len(df),
    "n_months": int(n_months),
    "grand_total_revenue": round(float(grand_total), 2),
    "regions": {}
}

for r in ['N','S','E','W']:
    total = float(region_total[r])
    monthly_avg = total / n_months
    peak = region_monthly[region_monthly['region']==r].sort_values('revenue', ascending=False).iloc[0]
    result["regions"][r] = {
        "total_revenue": round(total,2),
        "share_of_grand_total_pct": round(total/grand_total*100, 4),
        "monthly_avg_revenue": round(monthly_avg,2),
        "peak_month": peak['month'],
        "peak_month_revenue": round(float(peak['revenue']),2),
        "n_rows": int((df['region']==r).sum()),
    }

top = max(result["regions"], key=lambda k: result["regions"][k]["total_revenue"])
result["top_region"] = top
result["top_region_peak_month"] = result["regions"][top]["peak_month"]

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r2\_sandbox\tmp\regional_aggregates.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)

print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", out)

```
