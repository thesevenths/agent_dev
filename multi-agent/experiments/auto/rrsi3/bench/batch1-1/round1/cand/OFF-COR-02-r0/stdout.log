```python
import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
df["group"] = (df["screen_hours_per_day"] > 5).map({True:"gt5", False:"le5"})

g = df.groupby("group").agg(
    n=("student_id","count"),
    screen_mean=("screen_hours_per_day","mean"),
    math_mean=("math_score","mean"),
    reading_mean=("reading_score","mean"),
).to_dict("index")

diff_math = g["gt5"]["math_mean"] - g["le5"]["math_mean"]
diff_reading = g["gt5"]["reading_mean"] - g["le5"]["reading_mean"]

out = {
  "source_file": path,
  "split_rule": "screen_hours_per_day > 5 vs <= 5",
  "groups": g,
  "diff_gt5_minus_le5": {"math_score": float(diff_math), "reading_score": float(diff_reading)},
}
outdir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r0\_sandbox\tmp"
with open(outdir + r"\step3_group_stats.json","w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print(json.dumps(out,ensure_ascii=False,indent=2))

```
