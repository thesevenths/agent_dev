import pandas as pd, json

# 复核上游数字（直接读本地 CSV，不联网）
df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = df.iloc[:30]["retention_d7"], df.iloc[30:]["retention_d7"]
om, osd = r.mean(), r.std(ddof=1)
thr = om - 2*osd
below = df[r < thr]

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-01-r2\_sandbox\tmp\step2_stats.json", encoding="utf-8") as f:
    s2 = json.load(f)

# 交叉校验
assert abs(s2["first30"]["mean"] - first.mean()) < 1e-12
assert abs(s2["last30"]["mean"] - last.mean()) < 1e-12
assert s2["two_sigma"]["count_below"] == int((r < thr).sum())
print("cross-check OK")
print("first mean/std:", first.mean(), first.std(ddof=1))
print("last  mean/std:", last.mean(), last.std(ddof=1))
print("overall mean/std:", om, osd, "threshold:", thr)
print("below weeks:", below[["week","retention_d7"]].to_dict("records"))
print("first min/max:", first.min(), first.max(), "last min/max:", last.min(), last.max())
print("mean diff:", last.mean()-first.mean(), "pct:", (last.mean()-first.mean())/first.mean())
print("std diff:", last.std(ddof=1)-first.std(ddof=1))

