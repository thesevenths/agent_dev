```python
import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]

first = df.iloc[:30]["retention_d7"]
last  = df.iloc[30:]["retention_d7"]

overall_mean = r.mean()
overall_std  = r.std(ddof=1)
threshold    = overall_mean - 2*overall_std
below = df[r < threshold]

res = {
    "first30": {"weeks": [first.index[0], first.index[-1]], "n": len(first),
                "mean": first.mean(), "std": first.std(ddof=1),
                "min": first.min(), "max": first.max()},
    "last30":  {"weeks": [last.index[0], last.index[-1]], "n": len(last),
                "mean": last.mean(), "std": last.std(ddof=1),
                "min": last.min(), "max": last.max()},
    "overall": {"n": len(r), "mean": overall_mean, "std": overall_std,
                "min": r.min(), "max": r.max()},
    "diff": {"mean_diff_last_minus_first": last.mean()-first.mean(),
             "std_diff_last_minus_first": last.std(ddof=1)-first.std(ddof=1),
             "mean_diff_pct": (last.mean()-first.mean())/first.mean()},
    "two_sigma": {"threshold": threshold,
                  "count_below": int((r < threshold).sum()),
                  "weeks_below": below["week"].tolist(),
                  "values_below": below["retention_d7"].tolist()},
}
print(json.dumps(res, indent=2, ensure_ascii=False))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-01-r2\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, indent=2, ensure_ascii=False)
print("saved:", out)

```
