import pandas as pd, json, os

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first, last = r.iloc[:30], r.iloc[30:]
overall_mean, overall_std = r.mean(), r.std(ddof=1)
thr = overall_mean - 2*overall_std
below = df[r < thr]

res = {
    "n_total": len(r),
    "first30": {"weeks": list(df["week"].iloc[:30]), "mean": first.mean(), "std": first.std(ddof=1), "min": first.min(), "max": first.max()},
    "last30": {"weeks": list(df["week"].iloc[30:]), "mean": last.mean(), "std": last.std(ddof=1), "min": last.min(), "max": last.max()},
    "diff_mean": last.mean() - first.mean(),
    "overall": {"mean": overall_mean, "std": overall_std, "threshold": thr},
    "below_count": int((r < thr).sum()),
    "below_weeks": list(below["week"]),
    "below_values": {w: v for w, v in zip(below["week"], below["retention_d7"])},
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-01-r2\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)
path = os.path.join(out_dir, "retention_d7_stats.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("SAVED:", path)

