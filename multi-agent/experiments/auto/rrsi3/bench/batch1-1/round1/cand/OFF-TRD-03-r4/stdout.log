import json, os
import pandas as pd

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r4\_sandbox\tmp"
with open(os.path.join(base, "step1_validation.json"), encoding="utf-8") as f:
    d = json.load(f)

n_months = d["n_months"]
grand = d["revenue_sum"]

# 1) per-region aggregate table
agg = pd.DataFrame(d["region_agg"])
agg = agg.sort_values("sum", ascending=False).reset_index(drop=True)
agg["rank"] = agg.index + 1
agg["share_pct"] = (agg["sum"] / grand * 100).round(2)
agg["monthly_avg"] = (agg["sum"] / n_months).round(2)
agg["sum"] = agg["sum"].round(2)
agg = agg[["region", "rank", "sum", "share_pct", "monthly_avg"]]
agg.to_csv(os.path.join(base, "step2_region_aggregates.csv"), index=False)

# 2) monthly matrix (rounded to 2dp)
m = pd.DataFrame(d["monthly_by_region"]).set_index("month")
m = m.round(2)
m["TOTAL"] = m.sum(axis=1).round(2)
m.to_csv(os.path.join(base, "step2_monthly_by_region.csv"))

# 3) peak info
top = agg.iloc[0]
peak_row = m.loc[top["region"]]
peak_month = m.loc[:, top["region"]].idxmax()
