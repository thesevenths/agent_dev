import pandas as pd, json, os

path = "offline_data/regional_sales.csv"
df = pd.read_csv(path)

info = {
    "file": os.path.abspath(path),
    "columns": list(df.columns),
    "dtypes": {c: str(t) for c, t in df.dtypes.items()},
    "total_rows": len(df),
    "regions": sorted(df["region"].unique().tolist()),
    "region_counts": df["region"].value_counts().to_dict(),
    "months": sorted(df["month"].unique().tolist()),
    "n_months": df["month"].nunique(),
    "product_lines": sorted(df["product_line"].unique().tolist()),
    "nulls": df.isna().sum().to_dict(),
    "revenue_min": float(df["revenue"].min()),
    "revenue_max": float(df["revenue"].max()),
    "revenue_negative": int((df["revenue"] < 0).sum()),
    "revenue_sum": float(df["revenue"].sum()),
}

# per-region aggregates
g = df.groupby("region")["revenue"].agg(["sum", "count"])
g["share"] = g["sum"] / g["sum"].sum()
g["monthly_avg"] = g["sum"] / info["n_months"]
info["region_agg"] = g.reset_index().to_dict("records")

# monthly totals per region
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
info["monthly_by_region"] = piv.reset_index().to_dict("records")

top_region = g["sum"].idxmax()
top_region_month = piv.loc[:, top_region].idxmax()
info["top_region"] = top_region
info["top_region_total"] = float(g.loc[top_region, "sum"])
info["top_region_peak_month"] = top_region_month
info["top_region_peak_value"] = float(piv.loc[top_region_month, top_region])

# global peak month (all regions)
info["global_peak_month"] = piv.sum(axis=1).idxmax()
info["global_peak_value"] = float(piv.sum(axis=1).max())

out = os.path.join("E:\\agent_dev\\multi-agent\\experiments\\auto\\rrsi3\\bench\\batch1-1\\round1\\cand\\OFF-TRD-03-r4\\_sandbox\\tmp", "step1_validation.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(info, f, ensure_ascii=False, indent=2)
print(json.dumps(info, ensure_ascii=False, indent=2))
print("SAVED:", out)

```
