import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r4\_sandbox\tmp"

df = pd.read_csv(path)
weeks = [f"W{i:02d}" for i in range(30, 44)]
sub = df[df['week'].isin(weeks)].copy()
sub['group'] = sub['week'].apply(lambda w: 'pre_W30-W36' if int(w[1:]) <= 36 else 'post_W37-W43')

metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

# per-week table with deltas
sub['ret_delta'] = sub['retention_d7'].diff()
sub['churn_delta'] = sub['churn_rate'].diff()
sub['arpu_delta'] = sub['arpu_usd'].diff()

per_week = sub[['week', 'group'] + metrics + ['ret_delta', 'churn_delta', 'arpu_delta']].copy()

# group means
means = sub.groupby('group')[metrics].mean().unstack()
# order columns
means = means[[('pre_W30-W36', m) for m in metrics] + [('post_W37-W43', m) for m in metrics]]
means.columns = [f"{m}_pre" if g == 'pre_W30-W36' else f"{m}_post" for (g, m) in means.columns]
means['n_pre'] = 7
means['n_post'] = 7

# differences
for m in metrics:
    means[f'{m}_diff'] = means[f'{m}_post'] - means[f'{m}_pre']
    means[f'{m}_rel_pct'] = (means[f'{m}_diff'] / means[f'{m}_pre'] * 100)

print("=== PER WEEK ===")
print(per_week.to_string(index=False))
print("\n=== GROUP MEANS ===")
print(means.to_string())

# also min/max per group for context
for g in ['pre_W30-W36', 'post_W37-W43']:
    gsub = sub[sub['group'] == g]
    for m in metrics:
        print(f"{g} {m}: min={gsub[m].min():.4f} max={gsub[m].max():.4f}")

# save per-week CSV
per_week.to_csv(f"{out_dir}\\step2_per_week_W30_W43.csv", index=False, float_format='%.6f')
# save group means CSV
means.reset_index().to_csv(f"{out_dir}\\step2_group_means.csv", index=False, float_format='%.6f')
print("\nSaved CSVs.")

