```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
sub = df[df['week'].isin([f"W{i:02d}" for i in range(30, 44)])].copy()

pre = sub[sub['week'].isin([f"W{i:02d}" for i in range(30, 37)])]
post = sub[sub['week'].isin([f"W{i:02d}" for i in range(37, 44)])]

for col in ['retention_d7', 'churn_rate', 'arpu_usd']:
    a, b = pre[col].mean(), post[col].mean()
    print(f"{col}: pre={a:.6f} post={b:.6f} diff={b-a:+.6f} rel={(b-a)/a*100:+.2f}%")

# per-week deltas to locate breakpoint
sub['ret_delta'] = sub['retention_d7'].diff()
sub['churn_delta'] = sub['churn_rate'].diff()
sub['arpu_delta'] = sub['arpu_usd'].diff()
print(sub[['week','retention_d7','ret_delta','churn_rate','churn_delta','arpu_usd','arpu_delta']].to_string())

# min/max in each window
for col in ['retention_d7','churn_rate','arpu_usd']:
    print(col, "pre min/max:", pre[col].min(), pre[col].max(), "| post min/max:", post[col].min(), post[col].max())

