```python
import pandas as pd
import os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r4\_sandbox\tmp"
sub = pd.read_csv(os.path.join(out_dir, "app_metrics_W30_W43.csv"))
print(sub.to_string(index=False))

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
sub["group"] = sub["week"].apply(lambda w: "W30-W36" if w <= "W36" else "W37-W43")

# group means
g = sub.groupby("group")[metrics].agg(["mean", "count"])
print("\nGroup means:\n", g)

# deltas
pre = sub[sub.group=="W30-W36"][metrics].mean()
post = sub[sub.group=="W37-W43"][metrics].mean()
delta = post - pre
pct = delta / pre * 100
summary = pd.DataFrame({"pre_mean": pre, "post_mean": post, "delta": delta, "delta_pct": pct})
print("\nSummary:\n", summary)

# per-week deltas to locate breakpoint week
sub["ret_d7_wow"] = sub["retention_d7"].diff()
sub["churn_wow"] = sub["churn_rate"].diff()
sub["arpu_wow"] = sub["arpu_usd"].diff()
print("\nPer-week WoW changes:\n", sub[["week","ret_d7_wow","churn_wow","arpu_wow"]].to_string(index=False))

# save intermediate results CSV
out_csv = os.path.join(out_dir, "step2_breakpoint_results.csv")
with open(out_csv, "w", encoding="utf-8") as f:
    f.write("# Part A: group means (W30-W36 vs W37-W43)\n")
    summary.to_csv(f)
    f.write("\n# Part B: per-week values with WoW deltas\n")
    sub.to_csv(f, index=False)
print("\nsaved:", out_csv)

