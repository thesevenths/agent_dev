import pandas as pd

df = pd.read_csv('offline_data/students.csv')
g = df.groupby(['grade','region'])['reading_score'].agg(['count','mean'])
g = g.reindex(pd.MultiIndex.from_product([['G10','G11','G12'],['A','B','C','D']]))

def src(n):
    return f"（来源：offline_data/students.csv 的 reading_score，按 grade×region 分组，N={n} 行）"

rows = []
for (gr, rg), r in g.iterrows():
    rows.append(f"| {gr} | {rg} | {int(r['count'])} | {r['mean']:.2f} | {src(int(r['count']))} |")

hi = g['mean'].idxmax(); lo = g['mean'].idxmin()
hi_n, hi_m = int(g.loc[hi,'count']), g.loc[hi,'mean']
lo_n, lo_m = int(g.loc[lo,'count']), g.loc[lo,'mean']
diff = hi_m - lo_m
ratio = hi_m / lo_m

