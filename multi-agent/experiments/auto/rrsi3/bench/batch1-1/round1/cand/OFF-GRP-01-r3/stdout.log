import pandas as pd, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-01-r3\_sandbox\tmp"
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(r"offline_data/students.csv")
print(df.shape)
print(df['tutoring'].value_counts())
print(df['math_score'].isna().sum())

g = df.groupby('tutoring')['math_score']
stats = {}
for t in [0,1]:
    s = df.loc[df['tutoring']==t, 'math_score']
    stats[t] = dict(n=int(s.count()), mean=float(s.mean()), std=float(s.std(ddof=1)))

n0,n1 = stats[0]['n'], stats[1]['n']
m0,m1 = stats[0]['mean'], stats[1]['mean']
s0,s1 = stats[0]['std'], stats[1]['std']
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2)/(n0+n1-2)**0.5
pooled = float(((n0-1)*s0**2 + (n1-1)*s1**2)/(n0+n1-2))**0.5
diff = m1 - m0
d = diff/pooled
# t-test for reference
import math
se = pooled*math.sqrt(1/n0+1/n1)
t = diff/se
dfree = n0+n1-2
result = dict(
    group0=stats[0], group1=stats[1],
    pooled_std=pooled, mean_diff=m1-m0, cohens_d=d,
    t_stat=t, df=dfree,
    n_total=len(df)
)
print(json.dumps(result, indent=2))

with open(os.path.join(out_dir, "group_stats.json"), "w", encoding="utf-8") as f:
    json.dump(result, f, indent=2, ensure_ascii=False)
print("saved")

