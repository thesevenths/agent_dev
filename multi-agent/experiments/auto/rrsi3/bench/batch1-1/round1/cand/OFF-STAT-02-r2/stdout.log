```python
import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-STAT-02-r2\_sandbox"
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)

df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
m = df["math_score"]; r = df["reading_score"]
n = len(df)

def stats(s):
    mean = s.mean(); std = s.std(ddof=1)
    return {
        "n": int(s.count()),
        "mean": float(mean),
        "std_sample": float(std),
        "std_population": float(s.std(ddof=0)),
        "median": float(s.median()),
        "min": float(s.min()),
        "max": float(s.max()),
        "q25": float(s.quantile(0.25)),
        "q75": float(s.quantile(0.75)),
        "cv": float(std/mean),
    }

sm, sr = stats(m), stats(r)
pearson = float(m.corr(r, method="pearson"))

result = {
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-26 00:13 (local, file mtime 2026-10-23 10:11)",
    "rows_total": n,
    "rows_used": n,
    "nulls": {"math_score": 0, "reading_score": 0},
    "math_score": sm,
    "reading_score": sr,
    "pearson_correlation": pearson,
    "cv_ratio_math_over_reading": float(sm["cv"]/sr["cv"]),
    "more_dispersed": "math_score" if sm["cv"] > sr["cv"] else "reading_score",
    "notes": "std uses sample std (ddof=1); cv = std_sample/mean",
}
out = os.path.join(out_dir, "score_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(result, f, ensure_ascii=False, indent=2)
print(json.dumps(result, ensure_ascii=False, indent=2))
print("saved:", os.path.abspath(out))

```
