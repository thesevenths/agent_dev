```python
import pandas as pd
import numpy as np

path = "offline_data/students.csv"
df = pd.read_csv(path)

m = df["math_score"]
r = df["reading_score"]

stats = {}
for name, s in [("math_score", m), ("reading_score", r)]:
    mean = s.mean()
    std = s.std(ddof=1)  # sample std
    std_pop = s.std(ddof=0)
    med = s.median()
    cv = std / mean
    stats[name] = dict(n=s.count(), mean=mean, std=std, std_pop=std_pop, median=med, cv=cv,
                        min=s.min(), max=s.max())

pearson = m.corr(r)  # pearson
pearson_np = np.corrcoef(m, r)[0,1]

for k, v in stats.items():
    print(k, v)
print("pearson (pandas):", pearson)
print("pearson (numpy):", pearson_np)
print("missing math:", m.isna().sum(), "missing reading:", r.isna().sum())

```
