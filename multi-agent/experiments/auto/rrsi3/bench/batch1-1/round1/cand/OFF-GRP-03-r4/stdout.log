lines.append("")
lines.append("（来源：offline_data/students.csv 的 study_hours_per_week 与 math_score，400 行全量统计，无缺失）")
lines.append("")
lines.append("## 3. 分组边界预检（Low <2.5 ≤ Mid ≤4.5 < High）")
lines.append("")
lines.append("| 组 | 定义 | 样本量 | math_score 均值 |")
lines.append("|---|---|---|---|")
for name, g in [('低组', low), ('中组', mid), ('高组', high)]:
    lines.append(f"| {name} | {'<2.5' if name=='低组' else ('2.5–4.5' if name=='中组' else '>4.5')} | {len(g)} | {g['math_score'].mean():.4f} |")
lines.append("")
lines.append("（来源：offline_data/students.csv 的 study_hours_per_week 与 math_score，按分组定义对 400 行划分后聚合）")
lines.append("")
lines.append("## 4. 校验结论")
lines.append("")
lines.append(f"- 两列必需列（study_hours_per_week、math_score）均存在且为数值型，缺失值为 0，重复整行为 {int(df.duplicated().sum())}（来源：offline_data/students.csv 全文件校验，400 行）。")
lines.append(f"- 三组样本量之和 = {len(low)+len(mid)+len(high)}，与总行数 {len(df)} 一致，分组无遗漏（来源：由前述分组表三行计算）。")
lines.append("- 数据可用于 Step 2 的分组均值与增益估算分析。")
lines.append("")

with open(out, 'w', encoding='utf-8') as f:
    f.write('\n'.join(lines))
print("written:", out)
print(len(low), len(mid), len(high))

