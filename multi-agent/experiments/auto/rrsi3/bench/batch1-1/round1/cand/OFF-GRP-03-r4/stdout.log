import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-03-r4\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-03-r4\_sandbox\tmp\step2_group_stats.json"
df = pd.read_csv(path)

def grp(h):
    if h < 2.5: return 'Low'
    if h <= 4.5: return 'Mid'
    return 'High'

df['group'] = df['study_hours_per_week'].apply(grp)
stats = {}
for g in ['Low','Mid','High']:
    s = df[df['group']==g]
    stats[g] = {
        'n': int(len(s)),
        'math_mean': float(s['math_score'].mean()),
        'math_std': float(s['math_score'].std(ddof=1)),
        'hours_min': float(s['study_hours_per_week'].min()),
        'hours_max': float(s['study_hours_per_week'].max()),
        'hours_mean': float(s['study_hours_per_week'].mean()),
    }
low_mean = stats['Low']['math_mean']; high_mean = stats['High']['math_mean']
stats['gain_high_minus_low'] = float(high_mean - low_mean)
stats['gain_pct'] = float((high_mean - low_mean)/low_mean*100)
stats['total_n'] = int(len(df))

with open(out,'w',encoding='utf-8') as f:
    json.dump(stats, f, ensure_ascii=False, indent=2)
print(json.dumps(stats, ensure_ascii=False, indent=2))

