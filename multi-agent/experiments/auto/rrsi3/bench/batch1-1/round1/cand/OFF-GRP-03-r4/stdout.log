import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-03-r4\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-GRP-03-r4\_sandbox\tmp\step1_validation.md"
df = pd.read_csv(path)

# group boundaries
low = df[df['study_hours_per_week'] < 2.5]
mid = df[(df['study_hours_per_week'] >= 2.5) & (df['study_hours_per_week'] <= 4.5)]
high = df[df['study_hours_per_week'] > 4.5]

lines = []
lines.append("# Step 1 数据校验报告：offline_data/students.csv")
lines.append("")
lines.append("AS_OF: 2026-10-25 01:10（本地静态 CSV 文件，非实时数据；文件最后修改时间 2026-10-23 10:11）")
lines.append("")
lines.append("## 1. 文件与结构")
lines.append("")
lines.append(f"- 文件路径：`offline_data/students.csv`")
lines.append(f"- 数据规模：{df.shape[0]} 行 × {df.shape[1]} 列（来源：offline_data/students.csv 全文件读取，400 行 × 10 列）")
lines.append(f"- 列名：{', '.join(df.columns)}（来源：offline_data/students.csv 表头行）")
lines.append("")
lines.append("## 2. 关键列校验")
lines.append("")
