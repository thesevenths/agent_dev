import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-03-r2\_sandbox\tmp"

df = pd.read_csv(path)
n = len(df)

# Correlations (Pearson)
r_ret_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_ret_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] <= med]

stats = {
    "n_total": n,
    "retention_d7_median": med,
    "r_retention_arpu": r_ret_arpu,
    "r_retention_churn": r_ret_churn,
    "high_n": len(high),
    "high_arpu_mean": high["arpu_usd"].mean(),
    "high_cohort_sum": int(high["cohort_size"].sum()),
    "low_n": len(low),
    "low_arpu_mean": low["arpu_usd"].mean(),
    "low_cohort_sum": int(low["cohort_size"].sum()),
}
for k, v in stats.items():
    print(k, "=", v)

# Save intermediate results CSV
rows = [
    {"metric": "n_total", "value": n, "source": "offline_data/app_metrics.csv, 行数, 60行"},
    {"metric": "retention_d7_median", "value": round(med, 6), "source": "offline_data/app_metrics.csv 的 retention_d7, median, 60行"},
    {"metric": "pearson_r_retention_d7_arpu_usd", "value": round(r_ret_arpu, 6), "source": "offline_data/app_metrics.csv 的 retention_d7 与 arpu_usd, Pearson corr, 60行"},
    {"metric": "pearson_r_retention_d7_churn_rate", "value": round(r_ret_churn, 6), "source": "offline_data/app_metrics.csv 的 retention_d7 与 churn_rate, Pearson corr, 60行"},
    {"metric": "high_group_n", "value": len(high), "source": "offline_data/app_metrics.csv 的 retention_d7 > median, 计数"},
    {"metric": "high_group_arpu_usd_mean", "value": round(high["arpu_usd"].mean(), 6), "source": "offline_data/app_metrics.csv 的 arpu_usd, mean, retention_d7>median 组"},
    {"metric": "high_group_cohort_size_sum", "value": int(high["cohort_size"].sum()), "source": "offline_data/app_metrics.csv 的 cohort_size, sum, retention_d7>median 组"},
