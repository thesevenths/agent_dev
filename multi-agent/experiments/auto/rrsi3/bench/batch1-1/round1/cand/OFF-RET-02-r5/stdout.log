```python
import pandas as pd
import numpy as np

p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r5\_sandbox\tmp\step2_breakpoint_results.csv"

df = pd.read_csv(p)
metrics = ["retention_d7","churn_rate","arpu_usd"]

# per-week values W30-W43
win = df[(df.week>="W30")&(df.week<="W43")].copy()
win["segment"] = np.where(win.week<="W36","W30-W36","W37-W43")

# group means
g = win.groupby("segment")[metrics].agg(["mean","std","min","max","count"]).round(6)
print(g.to_string())

# per-week deltas (WoW) to pinpoint breakpoint
win["delta_retention_d7"] = win.retention_d7.diff()
win["delta_churn_rate"] = win.churn_rate.diff()
win["delta_arpu_usd"] = win.arpu_usd.diff()
print(win[["week","segment","retention_d7","churn_rate","arpu_usd","delta_retention_d7","delta_churn_rate","delta_arpu_usd"]].to_string(index=False))

# breakpoint detection: largest |WoW| change in each metric within W30-W43
for m in metrics:
    d = win.set_index("week")["delta_"+m]
    w = d.abs().idxmax()
    print(f"{m}: max |WoW delta| at {w} = {d[w]:.6f}")

# combined score: z-scored |delta| across the 3 metrics, averaged per week
z = pd.DataFrame({m: (win["delta_"+m]-win["delta_"+m].mean())/win["delta_"+m].std() for m in metrics})
win["breakpoint_score"] = z.abs().mean()
print(win[["week","breakpoint_score"]].to_string(index=False))
print("top breakpoint week:", win.loc[win.breakpoint_score.idxmax(),"week"])

# save intermediate CSV: per-week rows + group means appended
rows = win[["week","segment","cohort_size","dau","retention_d7","churn_rate","arpu_usd",
            "delta_retention_d7","delta_churn_rate","delta_arpu_usd","breakpoint_score"]].round(6)
rows.to_csv(out, index=False)
print("saved", out)

```
