```python
import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r5\_sandbox\tmp"

df = pd.read_csv(path)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

wk = df["week"].astype(str)
sub = df[wk.str.match(r"W(3[0-9]|4[0-3])$")].copy()
sub["week_num"] = sub["week"].str[1:].astype(int)

pre = sub[sub["week_num"] <= 36]   # W30-W36, 7 rows
post = sub[sub["week_num"] >= 37]  # W37-W43, 7 rows

# Group means
means = pd.DataFrame({
    "group": ["W30-W36", "W37-W43"],
    "n": [len(pre), len(post)],
    "retention_d7_mean": [pre["retention_d7"].mean(), post["retention_d7"].mean()],
    "churn_rate_mean": [pre["churn_rate"].mean(), post["churn_rate"].mean()],
    "arpu_usd_mean": [pre["arpu_usd"].mean(), post["arpu_usd"].mean()],
})
# std for context
means["retention_d7_std"] = [pre["retention_d7"].std(ddof=1), post["retention_d7"].std(ddof=1)]
means["churn_rate_std"] = [pre["churn_rate"].std(ddof=1), post["churn_rate"].std(ddof=1)]
means["arpu_usd_std"] = [pre["arpu_usd"].std(ddof=1), post["arpu_usd"].std(ddof=1)]

# Deltas (post - pre) and relative change
delta = pd.DataFrame({
    "metric": metrics,
    "pre_mean": [pre[m].mean() for m in metrics],
    "post_mean": [post[m].mean() for m in metrics],
    "abs_delta": [post[m].mean() - pre[m].mean() for m in metrics],
    "rel_change_pct": [(post[m].mean() - pre[m].mean()) / pre[m].mean() * 100 for m in metrics],
})

# Per-week table with week-over-week change to pinpoint breakpoint
per = sub[["week", "week_num"] + metrics].copy()
for m in metrics:
    per[f"{m}_wow"] = per[m].diff()

# Breakpoint detection: for each metric, find the week with the largest |WoW change| within W30-W43
bp = {}
for m in metrics:
    s = per.set_index("week_num")[f"{m}_wow"].dropna()
    bp[m] = (int(s.abs().idxmax()), float(s.abs().max()))

print("=== GROUP MEANS ===")
print(means.to_string(index=False))
print("\n=== DELTAS ===")
print(delta.to_string(index=False))
print("\n=== BREAKPOINT (max |WoW|) ===")
for m, (w, v) in bp.items():
    print(f"{m}: W{w:02d}, |WoW|={v:.4f}")

print("\n=== PER-WEEK ===")
print(per.to_string(index=False))

# Save intermediate CSVs
per.to_csv(f"{out_dir}\\step2_per_week_metrics.csv", index=False, float_format="%.6f")
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False, float_format="%.6f")
delta.to_csv(f"{out_dir}\\step2_deltas.csv", index=False, float_format="%.6f")
print("\nSaved 3 CSVs to", out_dir)

