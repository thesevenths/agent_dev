```python
import pandas as pd, json
p = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-03-r3\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(p)
out = {}
out['n_rows'] = len(df)
out['corr_r7_arpu'] = df['retention_d7'].corr(df['arpu_usd'])
out['corr_r7_churn'] = df['retention_d7'].corr(df['churn_rate'])
out['median_r7'] = df['retention_d7'].median()
hi = df[df['retention_d7'] > df['retention_d7'].median()]
lo = df[df['retention_d7'] <= df['retention_d7'].median()]
out['hi_n'] = len(hi); out['lo_n'] = len(lo)
out['hi_arpu_mean'] = hi['arpu_usd'].mean(); out['lo_arpu_mean'] = lo['arpu_usd'].mean()
out['hi_cohort_sum'] = int(hi['cohort_size'].sum()); out['lo_cohort_sum'] = int(lo['cohort_size'].sum())
out['hi_r7_mean'] = hi['retention_d7'].mean(); out['lo_r7_mean'] = lo['retention_d7'].mean()
out['hi_churn_mean'] = hi['churn_rate'].mean(); out['lo_churn_mean'] = lo['churn_rate'].mean()
out['hi_cohort_mean'] = hi['cohort_size'].mean(); out['lo_cohort_mean'] = lo['cohort_size'].mean()
out['hi_arpu_min'] = hi['arpu_usd'].min(); out['hi_arpu_max'] = hi['arpu_usd'].max()
out['lo_arpu_min'] = lo['arpu_usd'].min(); out['lo_arpu_max'] = lo['arpu_usd'].max()
out['hi_r7_min'] = hi['retention_d7'].min(); out['hi_r7_max'] = hi['retention_d7'].max()
out['lo_r7_min'] = lo['retention_d7'].min(); out['lo_r7_max'] = lo['retention_d7'].max()
out['arpu_mean_all'] = df['arpu_usd'].mean()
out['churn_mean_all'] = df['churn_rate'].mean()
out['r7_mean_all'] = df['retention_d7'].mean()
out['cohort_sum_all'] = int(df['cohort_size'].sum())
out['hi_weeks'] = list(hi['week']); out['lo_weeks'] = list(lo['week'])
# pearson also with scipy for p-value
from scipy import stats
r1,p1 = stats.pearsonr(df['retention_d7'], df['arpu_usd'])
r2,p2 = stats.pearsonr(df['retention_d7'], df['churn_rate'])
out['p_r7_arpu']=p1; out['p_r7_churn']=p2
out['spear_r7_arpu'] = stats.spearmanr(df['retention_d7'], df['arpu_usd'])[0]
out['spear_r7_churn'] = stats.spearmanr(df['retention_d7'], df['churn_rate'])[0]
print(json.dumps(out, indent=2, ensure_ascii=False))
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-03-r3\_sandbox\tmp\explore_stats.json","w") as f:
    json.dump(out,f,indent=2,ensure_ascii=False)

