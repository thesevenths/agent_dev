print('2025-12 Service:', m.loc['2025-12','Service'])
print('2025-12 Accessory:', m.loc['2025-12','Accessory'])

# returns
print('returns by line:', df.groupby('product_line')['returns'].sum())
print('total returns:', df['returns'].sum())

# region
print('revenue by region:', df.groupby('region')['revenue'].sum())

# unit_price simple mean vs weighted
print('simple mean unit_price by line:', df.groupby('product_line')['unit_price'].mean())

