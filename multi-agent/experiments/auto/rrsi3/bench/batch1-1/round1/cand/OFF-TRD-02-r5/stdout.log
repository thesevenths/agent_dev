```python
import pandas as pd
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

df = pd.read_csv('offline_data/regional_sales.csv')
df['year'] = df['month'].str[:4]

g = df.groupby('product_line').agg(total_units=('units','sum'), total_revenue=('revenue','sum'), rows=('revenue','size'))
g['avg_unit_price'] = g['total_revenue']/g['total_units']
g['revenue_share'] = g['total_revenue']/g['total_revenue'].sum()
g = g.sort_values('total_revenue', ascending=False)

m = df.groupby(['month','product_line'])['revenue'].sum().unstack()

fig, axes = plt.subplots(1, 2, figsize=(12, 4.5))
ax = axes[0]
x = range(len(m))
ax.plot(m.index, m['Hardware'], label='Hardware')
ax.plot(m.index, m['Service'], label='Service')
ax.plot(m.index, m['Accessory'], label='Accessory')
ax.set_title('Monthly revenue by product line (2024-01 ~ 2025-12)')
ax.set_ylabel('Revenue (CNY)')
ax.legend()
ax.tick_params(axis='x', rotation=60, labelsize=7)
ax.grid(alpha=0.3)

ax = axes[1]
y = ['2024','2025']
yr = df.groupby(['year','product_line'])['revenue'].sum().unstack()
w = 0.25
for i, pl in enumerate(['Hardware','Service','Accessory']):
    ax.bar([j+i*w for j in range(2)], yr[pl], width=w, label=pl)
ax.set_title('Annual revenue by product line')
ax.set_ylabel('Revenue (CNY)')
ax.legend()
ax.grid(alpha=0.3, axis='y')

plt.tight_layout()
plt.savefig(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-02-r5\_sandbox\tmp\product_line_revenue.png', dpi=150)
print('saved')

