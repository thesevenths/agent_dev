import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')
print(df.shape)
print(df.dtypes)
print(df['product_line'].unique())

# check revenue consistency
df['calc_rev'] = df['units']*df['unit_price']
print((df['calc_rev']-df['revenue']).abs().max())

g = df.groupby('product_line').agg(
    total_units=('units','sum'),
    total_revenue=('revenue','sum'),
    rows=('revenue','size'),
)
g['avg_unit_price'] = g['total_revenue']/g['total_units']
g['revenue_share'] = g['total_revenue']/g['total_revenue'].sum()
g = g.sort_values('total_revenue', ascending=False)
print(g)
print('total revenue', df['revenue'].sum())
print('total units', df['units'].sum())
print('months', df['month'].min(), df['month'].max(), df['month'].nunique())
print('regions', sorted(df['region'].unique()))

out = g.reset_index()
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-02-r5\_sandbox\tmp\product_line_summary.csv', index=False)
print(out)

