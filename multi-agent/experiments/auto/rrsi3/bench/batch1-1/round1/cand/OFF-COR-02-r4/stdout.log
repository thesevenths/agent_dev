out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r4\_sandbox\tmp\step2_correlations.csv"
res.to_csv(out, index=False)
print("saved:", out)

