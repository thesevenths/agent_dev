    "corr_screen_reading": float(r_read),
    "spearman_screen_math": float(s_math),
    "spearman_screen_reading": float(s_read),
}
print(json.dumps(res, indent=2))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r4\_sandbox\tmp\step2_correlations.json"
