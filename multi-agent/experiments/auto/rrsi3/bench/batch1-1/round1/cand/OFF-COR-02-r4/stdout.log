```python
import pandas as pd
import numpy as np
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

df["group"] = np.where(df["screen_hours_per_day"] > 5, "high (>5)", "low (<=5)")

rows = []
for g in ["low (<=5)", "high (>5)"]:
    sub = df[df["group"] == g]
    rows.append({
        "group": g,
        "n": len(sub),
        "screen_mean": sub["screen_hours_per_day"].mean(),
        "math_mean": sub["math_score"].mean(),
        "math_std": sub["math_score"].std(),
        "reading_mean": sub["reading_score"].mean(),
        "reading_std": sub["reading_score"].std(),
    })
g = pd.DataFrame(rows)
print(g.to_string(index=False))

# mean differences (high - low)
low = g[g.group=="low (<=5)"].iloc[0]; high = g[g.group=="high (>5)"].iloc[0]
diff_math = high.math_mean - low.math_mean
diff_read = high.reading_mean - low.reading_mean
print("\nmean diff (high - low): math =", round(diff_math,4), " reading =", round(diff_read,4))

# t-tests for context
t_math, p_math = stats.ttest_ind(df[df.group=="high (>5)"].math_score, df[df.group=="low (<=5)"].math_score)
t_read, p_read = stats.ttest_ind(df[df.group=="high (>5)"].reading_score, df[df.group=="low (<=5)"].reading_score)
print("ttest math: t=%.4f p=%.6f" % (t_math, p_math))
print("ttest reading: t=%.4f p=%.6f" % (t_read, p_read))

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-02-r4\_sandbox\tmp\step3_group_stats.csv"
g.to_csv(out, index=False)
print("saved:", out)

