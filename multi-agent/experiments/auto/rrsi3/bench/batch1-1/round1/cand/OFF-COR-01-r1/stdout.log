import pandas as pd, numpy as np, os, json

path = r"offline_data/students.csv"
df = pd.read_csv(path)
print(len(df), df.isna().sum().sum())

vars_ = ["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day"]
