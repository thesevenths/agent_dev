vars_ = ["study_hours_per_week","sleep_hours_per_night","attendance_pct","screen_hours_per_day"]
n = len(df)

rows = []
for v in vars_:
    r = df[v].corr(df["math_score"])
    rows.append((v, r))
rows_sorted = sorted(rows, key=lambda x: -abs(x[1]))

def tval(r, n):
    return r*np.sqrt(n-2)/np.sqrt(1-r*r)

desc = df[vars_+["math_score"]].describe().round(3)

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-COR-01-r1\_sandbox\tmp"
