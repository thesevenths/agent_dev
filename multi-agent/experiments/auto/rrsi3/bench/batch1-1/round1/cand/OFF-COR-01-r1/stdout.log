table = ["| 排名 | 变量 | 皮尔逊相关系数 r | \\|r\\| | 方向 | 显著性 t 值（df=398） |",
         "|---:|---|---:|---:|---|---:|"]
for i,(v,r) in enumerate(rows_sorted,1):
