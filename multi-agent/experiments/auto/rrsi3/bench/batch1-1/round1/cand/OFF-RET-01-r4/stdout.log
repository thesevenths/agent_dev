import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-01-r4\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
r = df["retention_d7"]

first30 = r.iloc[:30]
last30 = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2 * overall_std

below = df[r < threshold]

stats = pd.DataFrame({
    "metric": ["first30_mean", "first30_std", "last30_mean", "last30_std",
               "diff_mean_last_minus_first", "diff_std_last_minus_first",
               "overall_mean", "overall_std", "threshold_mean_minus_2std",
               "weeks_below_threshold", "weeks_below_pct"],
    "value": [first30.mean(), first30.std(ddof=1), last30.mean(), last30.std(ddof=1),
              last30.mean() - first30.mean(), last30.std(ddof=1) - first30.std(ddof=1),
              overall_mean, overall_std, threshold,
              len(below), len(below) / len(r)],
    "n": [30, 30, 30, 30, 30, 30, 60, 60, 60, 60, 60],
})
print(stats.to_string(index=False))
print("\nweeks below threshold:")
print(below.to_string(index=False))
print("\nfirst30 range:", first30.min(), first30.max())
print("last30 range:", last30.min(), last30.max())
print("first30 weeks:", df.iloc[:30]["week"].iloc[0], "-", df.iloc[:30]["week"].iloc[-1])
print("last30 weeks:", df.iloc[30:]["week"].iloc[0], "-", df.iloc[30:]["week"].iloc[-1])

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-01-r4\_sandbox\tmp\step2_stats.csv"
stats.to_csv(out, index=False)
print("\nsaved:", out)

