import pandas as pd, os
base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-QUA-03-r2\_sandbox"
p = os.path.join(base, "offline_data", "regional_sales.csv")
out = os.path.join(base, "tmp", "anomaly_ratios.csv")
os.makedirs(os.path.dirname(out), exist_ok=True)

df = pd.read_csv(p)
df = df.sort_values(["region","product_line","month"]).reset_index(drop=True)

# 24-month rolling mean of units within each group (min_periods=1 so early months get a ratio too)
df["units_24m_mean"] = df.groupby(["region","product_line"])["units"].transform(
    lambda s: s.rolling(24, min_periods=1).mean())
df["ratio"] = df["units"] / df["units_24m_mean"]
df["return_rate"] = df["returns"] / df["units"]

df.to_csv(out, index=False)
print("saved:", out, df.shape)

top = df.nlargest(10, "ratio")[["month","region","product_line","units","units_24m_mean","ratio","returns","return_rate"]]
print(top.to_string(index=False))

# context around top-3 spikes: prior 3 months and next 3 months for each
for (r, pl, m) in top.head(3).itertuples(index=False, name=None):
    g = df[(df.region==r)&(df.product_line==pl)].reset_index(drop=True)
    i = g.index[g.month==m][0]
    print(f"\n=== {r} / {pl} spike at {m} ===")
    print(g.iloc[max(0,i-3):i+4][["month","units","units_24m_mean","ratio","returns","return_rate"]].to_string(index=False))

```
