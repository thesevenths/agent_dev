_ret_rate(region, line):\n    r = df[(df["region"] == region) & (df["product_line"] == line)]\n    return (r["returns"] / r["units"]).mean()\n\ntop3["base_return_rate"] = [base_ret_rate(rg, pl) for rg, pl in zip(top3["region"], top3["product_line"])]\n\n# ---- Context: E region all 3 lines in 2025-03 ----\ne_mar = df[(df["month"] == "2025-03") & (df["region"] == "E")]\ne_mar_prev = df[(df["month"] == "2025-02") & (df["region"] == "E")]\ne_mar_next = df[(df["month"] == "2025-04") & (df["region"] == "E")]\n\n# ---- Chart 1: top-3 ratio bars ----\nfig, ax = plt.subplots(figsize=(8, 4.5))\nlabels = [f"{r.region} / {r.product_line}\\n{r.month}" for r in top3.itertuples()]\nax.barh(labels, top3["ratio"], color="#2b6cb0")\nfor i, v in enumerate(top3["ratio"]):\n    ax.text(v + 0.02, i, f"{v:.3f}", va="center")\nax.set_xlabel("ratio = month units / 24-month rolling mean")\nax.set_title("Top-3 single-month volume anomalies (region x product_line)")\nax.invert_yaxis()\nplt.tight_layout()\nplt.savefig(CHART1, dpi=110)\nplt.close()\n\n# ---- Chart 2: E region monthly units for 3 lines, 2024-01..2025-12 ----\ne_all = df[df["region"] == "E"].copy()\nfig, ax = plt.subplots(figsize=(9, 4.5))\nfor pl, color in [("Hardware", "#e53e3e"), ("Service", "#38a169"), ("Accessory", "#2b6cb0")]:\n    sub = e_all[e_all["product_line"] == pl].sort_values("month")\n    ax.plot(sub["month"], sub["units"], marker="o", ms=3, label=pl, color=color)\nax.axvline("2025-03", color="gray", ls="--", lw=1)\nax.set_ylabel("units")\nax.set_title("Region E monthly units by product line (2024-01 to 2025-12); dashed line = 2025-03")\nax.legend()\nplt.xticks(rotation=60, fontsize=7)\nplt.tight_layout()\nplt.savefig(CHART2, dpi=110)\nplt.close()\n\n# ---- Build markdown ----\ndef src(col, agg, n):\n    return f"（来源：offline_data/regional_sales.csv 的 {col}，{agg}，样本 {n} 行）"\n\nrows = []\nfor r in top3.itertuples():\n    rows.append(\n        f"| {r.region} | {r.product_line} | {r.month} | {int(r.units)} | {r.vol_24m_mean:.1f} | {r.ratio:.4f} | {r.return_rate:.2%} |"\n    )\ntable = "\\n".join(rows)\n\n# per-combo source lines\ncombo_src = []\nfor r in top3.itertuples():\n    combo_src.append(\n        f"- **{r.region} / {r.product_line} / {r.month}**：当月销量 {int(r.units)} 件"\n        f"{src(\'units\', \'该月该组合单行取值\', 1)}；24 个月滚动均值 {r.vol_24m_mean:.1f} 件"\n        f"（来源：由前述 24 个月 units 计算，样本 24 行）；倍数 {r.ratio:.4f}"\n        f"（来源：由前述两行计算）；当月退货率 {r.return_rate:.2%}"\n        f"{src(\'returns / units\', \'该月该组合单行比值\', 1)}；该组合 24 个月平均退货率 {r.base_return_rate:.2%}"\n        f"{src(\'returns / units\', \'该组合 24 个月逐月比值均值\', 24)}。"\n    )\n\ne_units = int(e_mar["units"].sum())\ne_units_prev = int(e_mar_prev["units"].sum())\ne_units_next = int(e_mar_next["units"].sum())\ne_ret = e_mar["returns"].sum() / e_mar["units"].sum()\ne_ret_prev = e_mar_prev["returns"].sum() / e_mar_prev["units"].sum()\ne_ret_next = e_mar_next["returns"].sum() / e_mar_next["units"].sum()\n\nmd = f"""# 单月放量异常分析报告：区域 × 产品线月度销量相对 24 个月均值的倍数\n\nAS_OF: 2026-10-25 22:17（数据为离线快照，覆盖 2024-01 至 2025-12 共 24 个月，非实时数据）\n\n## 1. 分析背景与方法\n\n本报告基于本地文件 `offline_data/regional_sales.csv`（288 行 = 24 个月 × 4 区域 × 3 产品线，\n列：month, region, product_line, units, unit_price, revenue, returns，\n（来源：offline_data/regional_sales.csv 的 month/region/product_line/units/unit_price/revenue/returns，全表，样本 288 行）），\n定位「单月放量异常」：对每个「区域 × 产品线」组合，计算其每月销量 `units` 相对该组合自身\n24 个月滚动均值（`vol_24m_mean`）的倍数 `ratio = units / vol_24m_mean`，\n取倍数最大的前三个组合，并结合当月退货率判断放量更像真实需求还是渠道压货。\n倍数表由上游脚本 `tmp/anomaly.py` 生成并落盘于 `tmp/offline_data/volume_anomaly_ratios.csv`\n（288 行 × 7 列：month, region, product_line, units, vol_24m_mean, ratio, returns，\n（来源：tmp/offline_data/volume_anomaly_ratios.csv 全表，样本 288 行））。\n\n## 2. 数据概览\n\n- 数据范围：2024-01 至 2025-12，共 24 个月（来源：offline_data/regional_sales.csv 的 month，去重计数，样本 288 行）。\n- 组合数：4 区域（N/S/E/W）× 3 产品线（Hardware/Service/Accessory）= 12 个组合，每个组合 24 个月度观测\n  （来源：offline_data/regional_sales.csv 的 region、product_line，分组计数，样本 288 行）。\n- 全表 24 个月总销量：{int(df[\'units\'].sum())} 件（来源：offline_data/regional_sales.csv 的 units，全表求和，样本 288 行）。\n- 全表 24 个月总退货：{int(df[\'returns\'].sum())} 件，整体退货率 {df[\'returns\'].sum()/df[\'units\'].sum():.2%}\n  （来源：offline_data/regional_sales.csv 的 returns/units，全表求和后相除，样本 288 行）。\n\n## 3. 倍数最大的前三个「区域 × 产品线 × 月份」组合\n\n| 区域 | 产品线 | 月份 | 当月销量 (units) | 24 个月滚动均值 | 倍数 (ratio) | 当月退货率 |\n|------|--------|------|-----------------|----------------|-------------|-----------|\n{table}\n\n逐条来源标注：\n\n{chr(10).join(combo_src)}\n\n![Top-3 放量倍数](chart_top3.png)\n\n## 4. 异常月份上下文：E 区域 2025-03 三线同步放量\n\nE 区域在 2025-03 的三条产品线（Hardware、Service、Accessory）同时进入全表倍数前三，\n当月 E 区域合计销量 {e_units} 件（来源：offline_data/regional_sales.csv 的 units，month=2025-03 且 region=E 的 3 行求和，样本 3 行），\n较 2025-02 的 {e_units_prev} 件（来源：offline_data/regional_sales.csv 的 units，month=2025-02 且 region=E 的 3 行求和，样本 3 行）\n环比增长 {(e_units/e_units_prev-1):.1%}（来源：由前述两行计算），\n而 2025-04 回落至 {e_units_next} 件（来源：offline_data/regional_sales.csv 的 units，month=2025-04 且 region=E 的 3 行求和，样本 3 行），\n环比回落 {(1-e_units_next/e_units)*100:.1%}（来源：由前述两行计算）。\n\n退货率方面：2025-03 当月 E 区域整体退货率 {e_ret:.2%}\n（来源：offline_data/regional_sales.csv 的 returns/units，month=2025-03 且 region=E 的 3 行求和后相除，样本 3 行），\n2025-02 为 {e_ret_prev:.2%}（来源：offline_data/regional_sales.csv 的 returns/units，month=2025-02 且 region=E 的 3 行求和后相除，样本 3 行），\n2025-04 为 {e_ret_next:.2%}（来源：offline_data/regional_sales.csv 的 returns/units，month=2025-04 且 region=E 的 3 行求和后相除，样本 3 行）。\n\n![E 区域月度销量走势](chart_e_2025_03.png)\n\n## 5. 分析洞察：真实需求 vs 渠道压货\n\n判断依据（全部来自上述本地 CSV）：\n\n1. **同步性**：同一区域（E）的三条产品线在同一个月（2025-03）同时出现 1.5 倍以上的放量，\n   且倍数分别为 {top3.iloc[0][\'ratio\']:.4f}、{top3.iloc[1][\'ratio\']:.4f}、{top3.iloc[2][\'ratio\']:.4f}\n   （来源：tmp/offline_data/volume_anomaly_ratios.csv 的 ratio，按 ratio 降序前 3 行，样本 3 行）。\n   真实需求通常由特定产品线的市场事件驱动，很少让同一区域全部产品线在同一月同步跳升；\n   三线同步放量更符合「渠道集中进货/压货」的特征。\n2. **脉冲形态**：放量仅持续一个月，2025-04 即回落（E 区域合计 {e_units} → {e_units_next} 件，\n   来源：offline_data/regional_sales.csv 的 units，month=2025-03 与 2025-04 且 region=E 各 3 行求和，样本 6 行），\n   呈典型单月脉冲而非趋势性抬升，符合渠道压货后次月消化、不再进货的模式。\n3. **退货率未恶化**：2025-03 当月 E 区域退货率 {e_ret:.2%} 与前后月（{e_ret_prev:.2%} / {e_ret_next:.2%}）基本持平\n   （来源：offline_data/regional_sales.csv 的 returns/units，month∈{{2025-02,2025-03,2025-04}} 且 region=E 各 3 行求和后相除，样本 9 行）。\n   若为渠道压货后终端滞销，通常会在随后 1–3 个月看到退货率显著抬升；本数据中 2025-04 退货率未见跳升，\n   说明截至数据末端（2025-12）尚未出现压货反噬，但这不排除滞销风险在数据窗口之后显现。\n4. **对比其他组合**：全表其余 285 个月度观测的倍数均低于 {top3.iloc[2][\'ratio\']:.4f}\n   （来源：tmp/offline_data/volume_anomaly_ratios.csv 的 ratio，全表最大值前 3 名之外，样本 285 行），\n   异常高度集中于 E 区域 2025-03 单月，进一步支持「区域性、单月性」的渠道行为而非普遍需求扩张。\n\n## 6. 结论\n\n综合以上证据，E 区域 2025-03 的三线同步单月放量（倍数 {top3.iloc[0][\'ratio\']:.4f} / {top3.iloc[1][\'ratio\']:.4f} / {top3.iloc[2][\'ratio\']:.4f}，\n来源：tmp/offline_data/volume_anomaly_ratios.csv 的 ratio，前 3 行，样本 3 行）**更像渠道压货而非真实需求**：\n放量呈三线同步、单月脉冲、次月回落的形态，且当月退货率（{e_ret:.2%}，来源：offline_data/regional_sales.csv 的 returns/units，\nmonth=2025-03 且 region=E 的 3 行求和后相除，样本 3 行）与前后月持平，未见终端滞销反噬，但也缺乏需求侧（如价格、收入结构）的\n持续性证据。建议后续跟踪 E 区域 2025-04 至 2025-06 的退货率与库存周转，以确认压货是否已在数据窗口内消化。\n"""\n\nwith open(OUT_MD, "w", encoding="utf-8") as f:\n    f.write(md)\n\nprint("WROTE:", OUT_MD)\nprint("CHART1:", CHART1, os.path.getsize(CHART1))\nprint("CHART2:", CHART2, os.path.getsize(CHART2))\nprint("MD size:", os.path.getsize(OUT_MD))\nprint(top3.to_string())\n'} with error:
