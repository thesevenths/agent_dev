import pandas as pd, os
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-QUA-03-r2\_sandbox"
df = pd.read_csv(os.path.join(base,"tmp","anomaly_ratios.csv"))
e = df[df.region=="E"].sort_values(["product_line","month"])

fig, axes = plt.subplots(3,1, figsize=(11,10), sharex=True)
for ax, pl in zip(axes, ["Accessory","Hardware","Service"]):
    g = e[e.product_line==pl]
    ax.plot(g.month, g.units, marker="o", ms=4)
    ax.axvline("2025-03", color="red", ls="--", lw=1)
    ax.set_ylabel(f"E / {pl}\nunits")
    ax.grid(alpha=0.3)
    ax.tick_params(axis="x", rotation=60, labelsize=7)
fig.suptitle("E region monthly units by product line (red dashed = 2025-03 spike)")
plt.tight_layout()
p1 = os.path.join(base,"tmp","e_region_units.png")
plt.savefig(p1, dpi=110)
print("saved", p1)

# return rate chart for E Hardware
fig2, ax = plt.subplots(figsize=(11,4))
gh = e[e.product_line=="Hardware"]
ax.bar(gh.month, gh.return_rate*100, color="steelblue")
ax.axvline("2025-03", color="red", ls="--", lw=1)
ax.set_ylabel("return rate %")
ax.tick_params(axis="x", rotation=60, labelsize=7)
ax.grid(alpha=0.3, axis="y")
fig2.suptitle("E / Hardware monthly return rate (%)")
plt.tight_layout()
p2 = os.path.join(base,"tmp","e_hardware_return_rate.png")
plt.savefig(p2, dpi=110)
print("saved", p2)

