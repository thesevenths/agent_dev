import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

pre = df[df["week"].isin([f"W{i:02d}" for i in range(30, 37)])].copy()
post = df[df["week"].isin([f"W{i:02d}" for i in range(37, 44)])].copy()
pre["group"] = "W30-W36"
post["group"] = "W37-W43"

# group means
means = pd.DataFrame({
    "group": ["W30-W36", "W37-W43"],
    "n": [len(pre), len(post)],
    "retention_d7_mean": [pre["retention_d7"].mean(), post["retention_d7"].mean()],
    "churn_rate_mean": [pre["churn_rate"].mean(), post["churn_rate"].mean()],
    "arpu_usd_mean": [pre["arpu_usd"].mean(), post["arpu_usd"].mean()],
})
means["retention_d7_diff"] = means.loc[1, "retention_d7_mean"] - means.loc[0, "retention_d7_mean"]
means["churn_rate_diff"] = means.loc[1, "churn_rate_mean"] - means.loc[0, "churn_rate_mean"]
means["arpu_usd_diff"] = means.loc[1, "arpu_usd_mean"] - means.loc[0, "arpu_usd_mean"]
for c in ["retention_d7", "churn_rate", "arpu_usd"]:
    means[f"{c}_diff_pct"] = means[f"{c}_diff"] / means.loc[0, f"{c}_mean"] * 100

print(means.to_string(index=False))

# per-week table with group labels
sub = pd.concat([pre, post])[["week", "group"] + metrics].reset_index(drop=True)
print("\n", sub.to_string(index=False))

# breakpoint scan: for each candidate split week k (pre=W30..Wk, post=Wk+1..W43),
# compute mean gap in churn_rate (and others) to see where the shift is sharpest
rows = []
for k in range(30, 43):
    a = df[df["week"].isin([f"W{i:02d}" for i in range(30, k+1)])]
    b = df[df["week"].isin([f"W{i:02d}" for i in range(k+1, 44)])]
    rows.append({
        "split_after": f"W{k:02d}",
        "n_pre": len(a), "n_post": len(b),
        "churn_gap": b["churn_rate"].mean() - a["churn_rate"].mean(),
        "ret_gap": a["retention_d7"].mean() - b["retention_d7"].mean(),
        "arpu_gap": a["arpu_usd"].mean() - b["arpu_usd"].mean(),
    })
scan = pd.DataFrame(rows)
print("\n", scan.to_string(index=False))

# save intermediate CSVs
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r2\_sandbox\tmp"
sub.to_csv(f"{out_dir}\\step2_per_week_values.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
scan.to_csv(f"{out_dir}\\step2_breakpoint_scan.csv", index=False)
print("\nsaved 3 CSVs to", out_dir)

```
