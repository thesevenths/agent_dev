import pandas as pd
import numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[df["week"].str[1:].astype(int).between(30,43)].copy()
sub["group"] = np.where(sub["week"].str[1:].astype(int) <= 36, "W30-W36", "W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]
means = sub.groupby("group")[metrics].mean()
print(means)

# per-week shift: compare each week to previous week
sub = sub.sort_values("week").reset_index(drop=True)
shifts = sub[metrics].diff()
# breakpoint: week with largest combined normalized shift vs previous week
# normalize by std of full W30-W43 series
norm = shifts.div(sub[metrics].std())
score = norm.loc[3:].abs().sum(axis=1)  # from W31 onward
print(score.sort_values(ascending=False).head(5))

# also compute group-level deltas
d = means.loc["W37-W43"] - means.loc["W30-W36"]
print(d)
pct = d / means.loc["W30-W36"] * 100
print(pct)

# save intermediate CSV
out = pd.DataFrame({
    "metric": metrics,
    "mean_W30_W36": [means.loc["W30-W36", m] for m in metrics],
