import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("\nhead:\n", df.head(3))
print("\ntail:\n", df.tail(3))

sub = df[(df.week >= "W30") & (df.week <= "W43")]
print("\nW30-W43 rows:", len(sub))
print(sub.to_string(index=False))

pre = sub[sub.week <= "W36"]
post = sub[sub.week >= "W37"]
print("\npre W30-W36 n =", len(pre), " post W37-W43 n =", len(post))

for col in ["retention_d7", "churn_rate", "arpu_usd"]:
    a, b = pre[col].mean(), post[col].mean()
    print(f"{col}: pre={a:.6f} post={b:.6f} diff={b-a:+.6f} rel={(b-a)/a*100:+.2f}%")

# per-week detail for W36->W37
print("\nW36 row:", sub[sub.week=="W36"].to_dict("records"))
print("W37 row:", sub[sub.week=="W37"].to_dict("records"))

```
