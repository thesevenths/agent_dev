import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
sub["group"] = sub.week.map(lambda w: "pre_W30-W36" if w <= "W36" else "post_W37-W43")

metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week table
per_week = sub[["week"] + metrics].copy()
per_week["group"] = per_week.week.map(lambda w: "pre_W30-W36" if w <= "W36" else "post_W37-W43")

# group means
means = sub.groupby("group")[metrics].mean().reset_index()
means.columns = ["group"] + [f"mean_{c}" for c in metrics]

# diff & relative change
pre = means[means.group == "pre_W30-W36"].iloc[0]
post = means[means.group == "post_W37-W43"].iloc[0]
diff_rows = []
for c in metrics:
    a, b = pre[f"mean_{c}"], post[f"mean_{c}"]
    diff_rows.append({
        "metric": c,
        "pre_mean_W30-W36": round(a, 6),
        "post_mean_W37-W43": round(b, 6),
        "diff_post_minus_pre": round(b - a, 6),
        "rel_change_pct": round((b - a) / a * 100, 4),
        "pre_n": 7, "post_n": 7,
    })
diff_df = pd.DataFrame(diff_rows)

# breakpoint: week with max |z| vs pre-mean, or largest single-week drop in retention_d7
# compute week-over-week deltas
sub2 = sub.sort_values("week").reset_index(drop=True)
wow = sub2[metrics].diff().dropna()
# breakpoint score: for each week w in W31..W43, |retention_d7 drop| + |churn_rate rise| normalized
# simpler: find week where cumulative shift vs pre-mean is largest
pre_mean = sub[sub.week <= "W36"][metrics].mean()
sub2["shift_score"] = (
    (pre_mean["retention_d7"] - sub2["retention_d7"]) / pre_mean["retention_d7"]
    + (sub2["churn_rate"] - pre_mean["churn_rate"]) / pre_mean["churn_rate"]
    + (pre_mean["arpu_usd"] - sub2["arpu_usd"]) / pre_mean["arpu_usd"]
)
bp = sub2.loc[sub2.shift_score.idxmax()]
print("Breakpoint week:", bp.week, "shift_score:", round(bp.shift_score, 4))

# W36->W37 single-week deltas
w36 = sub2[sub2.week == "W36"].iloc[0]
w37 = sub2[sub2.week == "W37"].iloc[0]
print("\nW36->W37 single-week deltas:")
for c in metrics:
    print(f"  {c}: {w36[c]:.4f} -> {w37[c]:.4f}  delta={w37[c]-w36[c]:+.4f}")

# save per-week CSV
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r0\_sandbox\tmp"
per_week.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)
diff_df.to_csv(f"{out_dir}\\step2_group_diff.csv", index=False)

print("\nper_week:\n", per_week.to_string(index=False))
print("\ndiff_df:\n", diff_df.to_string(index=False))
print("\nshift_score by week:\n", sub2[["week","shift_score"]].to_string(index=False))

