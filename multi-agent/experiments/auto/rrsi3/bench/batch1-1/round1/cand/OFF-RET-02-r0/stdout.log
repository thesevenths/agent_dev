import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sub = df[(df.week >= "W30") & (df.week <= "W43")].copy()
sub["group"] = sub.week.map(lambda w: "pre_W30-W36" if w <= "W36" else "post_W37-W43")
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# per-week with group
per_week = sub[["week"] + metrics].copy()
per_week["group"] = per_week.week.map(lambda w: "pre_W30-W36" if w <= "W36" else "post_W37-W43")

# group means
means = sub.groupby("group")[metrics].mean().reset_index()
means.columns = ["group"] + [f"mean_{c}" for c in metrics]
pre = means[means.group == "pre_W30-W36"].iloc[0]
post = means[means.group == "post_W37-W43"].iloc[0]

diff_rows = []
for c in metrics:
    a, b = pre[f"mean_{c}"], post[f"mean_{c}"]
    diff_rows.append({
        "metric": c,
        "pre_mean_W30-W36": round(a, 6),
        "post_mean_W37-W43": round(b, 6),
        "diff_post_minus_pre": round(b - a, 6),
        "rel_change_pct": round((b - a) / a * 100, 4),
        "pre_n": 7, "post_n": 7,
    })
diff_df = pd.DataFrame(diff_rows)

# breakpoint: first week where ALL three metrics simultaneously deviate from pre-mean
# and never return to pre-range for the rest of the window
pre_mean = sub[sub.week <= "W36"][metrics].mean()
pre_std = sub[sub.week <= "W36"][metrics].std()

sub2 = sub.sort_values("week").reset_index(drop=True)
# for each week, check if it's "outside" pre-range (mean ± 1 std) on all 3 metrics
def is_outside(row):
    flags = []
    for c in metrics:
        m, s = pre_mean[c], pre_std[c]
        if c == "retention_d7":
            flags.append(row[c] < m - 0.5*s)  # below
        elif c == "churn_rate":
            flags.append(row[c] > m + 0.5*s)  # above
        else:
            flags.append(row[c] < m - 0.5*s)  # below
    return all(flags)

sub2["all_outside"] = sub2.apply(is_outside, axis=1)
# find first week where all_outside=True AND all subsequent weeks also all_outside=True
first_bp = None
for i in range(len(sub2)):
    if sub2.loc[i, "all_outside"]:
        # check all subsequent
        if sub2.loc[i:, "all_outside"].all():
            first_bp = sub2.loc[i, "week"]
            break
print("Breakpoint (first sustained deviation):", first_bp)
print("\nall_outside by week:\n", sub2[["week","all_outside"]].to_string(index=False))

# W36->W37 single-week deltas
w36 = sub2[sub2.week == "W36"].iloc[0]
w37 = sub2[sub2.week == "W37"].iloc[0]
wow_rows = []
for c in metrics:
    wow_rows.append({
        "metric": c,
        "W36_value": w36[c],
        "W37_value": w37[c],
        "delta_W37_minus_W36": round(w37[c] - w36[c], 6),
        "rel_change_pct": round((w37[c] - w36[c]) / w36[c] * 100, 4),
    })
wow_df = pd.DataFrame(wow_rows)
print("\nW36->W37:\n", wow_df.to_string(index=False))

# save
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-RET-02-r0\_sandbox\tmp"
per_week.to_csv(f"{out_dir}\\step2_per_week.csv", index=False)
diff_df.to_csv(f"{out_dir}\\step2_group_diff.csv", index=False)
wow_df.to_csv(f"{out_dir}\\step2_w36_w37_delta.csv", index=False)
print("\nSaved 3 CSVs.")

