    "revenue_by_region_rowcount": {r: int(v) for r, v in df.groupby('region')['revenue'].count().items()},
    "revenue_by_region_mean": {r: float(v) for r, v in df.groupby('region')['revenue'].mean().items()},
    "total_revenue_all": float(df['revenue'].sum()),
}

print(json.dumps(validation, indent=2, ensure_ascii=False))

# Save validation summary to file
