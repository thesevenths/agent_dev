import pandas as pd

df = pd.read_csv(r"offline_data/regional_sales.csv")
n_months = df['month'].nunique()
grand = df['revenue'].sum()

g = df.groupby('region')['revenue'].agg(total_revenue='sum', rows='count').reset_index()
g['share_pct'] = g['total_revenue'] / grand * 100
g['monthly_avg_revenue'] = g['total_revenue'] / n_months
g = g.sort_values('total_revenue', ascending=False).reset_index(drop=True)

# monthly totals per region
m = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak = m.loc[m.groupby('region')['revenue'].idxmax()][['region','month','revenue']]
peak.columns = ['region','peak_month','peak_month_revenue']
g = g.merge(peak, on='region')

# add grand total row
total_row = pd.DataFrame([{
    'region':'ALL','total_revenue':grand,'rows':len(df),
    'share_pct':100.0,'monthly_avg_revenue':grand/n_months,
    'peak_month':'-','peak_month_revenue':None}])
out = pd.concat([g, total_row], ignore_index=True)

out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r0\_sandbox\tmp\step2_regional_aggregates.csv"
out.to_csv(out_path, index=False, float_format='%.2f')
print(out.to_string(index=False))
print("saved:", out_path)

# also save monthly detail for step 3
m_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r0\_sandbox\tmp\step2_monthly_revenue.csv"
m.to_csv(m_path, index=False, float_format='%.2f')
print("saved:", m_path)

