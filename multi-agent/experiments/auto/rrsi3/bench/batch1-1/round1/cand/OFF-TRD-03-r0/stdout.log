import pandas as pd

path = r"offline_data/regional_sales.csv"
df = pd.read_csv(path)

print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dupes (month,region,product_line):", df.duplicated(subset=['month','region','product_line']).sum())

# consistency check: revenue vs units*unit_price
df['calc_rev'] = df['units']*df['unit_price']
diff = (df['calc_rev'] - df['revenue']).abs()
print("max |revenue - units*unit_price|:", diff.max())

# rows per region
print(df.groupby('region').size())

# quick aggregates for downstream
g = df.groupby('region')['revenue'].agg(['sum','count'])
g['share'] = g['sum']/g['sum'].sum()*100
g['monthly_avg'] = g['sum']/df['month'].nunique()
print(g)

# monthly totals per region
m = df.groupby(['region','month'])['revenue'].sum().reset_index()
top = m.loc[m.groupby('region')['revenue'].idxmax()]
print(top)
print("overall top region:", g['sum'].idxmax())

