import pandas as pd
import json

df = pd.read_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r0\_sandbox\offline_data\regional_sales.csv")

# --- Per-region aggregates ---
region_agg = df.groupby('region').agg(
    total_revenue=('revenue', 'sum'),
    row_count=('revenue', 'count'),
).reset_index()

grand_total = df['revenue'].sum()
region_agg['share_pct'] = region_agg['total_revenue'] / grand_total * 100

# Monthly average revenue per region (sum revenue per region-month, then average over 24 months)
region_month = df.groupby(['region', 'month'])['revenue'].sum().reset_index()
monthly_avg = region_month.groupby('region')['revenue'].mean().reset_index()
monthly_avg.columns = ['region', 'monthly_avg_revenue']

region_agg = region_agg.merge(monthly_avg, on='region')
region_agg = region_agg.sort_values('total_revenue', ascending=False).reset_index(drop=True)

print("=== Region Aggregates ===")
print(region_agg.to_string(index=False))
print(f"\nGrand total: {grand_total:,.2f}")

# --- Top region & its peak month ---
top_region = region_agg.iloc[0]['region']
top_region_months = region_month[region_month['region'] == top_region].sort_values('revenue', ascending=False)
peak_month_row = top_region_months.iloc[0]
print(f"\nTop region: {top_region}")
print(f"Peak month: {peak_month_row['month']}, revenue = {peak_month_row['revenue']:,.2f}")

# Also get peak month for ALL regions (useful for report)
peak_by_region = region_month.loc[region_month.groupby('region')['revenue'].idxmax()]
print("\n=== Peak month per region ===")
print(peak_by_region.to_string(index=False))

# --- Monthly revenue by region (full 24-month series for chart) ---
monthly_pivot = region_month.pivot(index='month', columns='region', values='revenue')
monthly_pivot = monthly_pivot[['N','S','E','W']]
print("\n=== Monthly revenue pivot (first/last 3) ===")
print(monthly_pivot.head(3).to_string())
print("...")
print(monthly_pivot.tail(3).to_string())

# --- Save intermediate results ---
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r0\_sandbox\tmp"

# 1. Region aggregates CSV
agg_path = f"{out_dir}\\regional_aggregates.csv"
region_agg.to_csv(agg_path, index=False)
print(f"\nSaved: {agg_path}")

# 2. Monthly revenue by region CSV (for chart step)
monthly_path = f"{out_dir}\\monthly_revenue_by_region.csv"
monthly_pivot.to_csv(monthly_path)
print(f"Saved: {monthly_path}")

# 3. JSON summary for report step
summary = {
    "grand_total_revenue": round(float(grand_total), 2),
    "regions": [],
    "top_region": top_region,
    "top_region_peak_month": str(peak_month_row['month']),
    "top_region_peak_revenue": round(float(peak_month_row['revenue']), 2),
    "peak_month_by_region": {r: {"month": str(m), "revenue": round(float(v), 2)} 
                              for r, m, v in zip(peak_by_region['region'], peak_by_region['month'], peak_by_region['revenue'])},
    "month_range": [df['month'].min(), df['month'].max()],
    "month_count": int(df['month'].nunique()),
    "rows_per_region": int(len(df) // 4),
}
for _, row in region_agg.iterrows():
    summary["regions"].append({
        "region": row['region'],
        "total_revenue": round(float(row['total_revenue']), 2),
        "share_pct": round(float(row['share_pct']), 4),
        "monthly_avg_revenue": round(float(row['monthly_avg_revenue']), 2),
        "row_count": int(row['row_count']),
    })

json_path = f"{out_dir}\\regional_summary.json"
with open(json_path, 'w', encoding='utf-8') as f:
    json.dump(summary, f, indent=2, ensure_ascii=False)
print(f"Saved: {json_path}")

