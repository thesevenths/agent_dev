matplotlib.use('Agg')
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker
import numpy as np
import os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-TRD-03-r0\_sandbox\tmp"

# Load data
monthly = pd.read_csv(f"{out_dir}\\monthly_revenue_by_region.csv", index_col='month')

# --- Chart 1: Bar chart of regional totals ---
totals = {'E': 31976756.96, 'S': 31868486.94, 'N': 31384803.17, 'W': 31214392.50}
shares = {'E': 25.29, 'S': 25.20, 'N': 24.82, 'W': 24.69}

fig, axes = plt.subplots(1, 2, figsize=(14, 5.5))
fig.suptitle('Regional Sales Analysis (2024-01 to 2025-12)', fontsize=14, fontweight='bold')

# Bar chart
ax1 = axes[0]
regions = list(totals.keys())
vals = [totals[r] for r in regions]
colors = ['#2196F3', '#4CAF50', '#FF9800', '#9C27B0']
bars = ax1.bar(regions, vals, color=colors, edgecolor='white', linewidth=0.8, width=0.6)
ax1.set_ylabel('Total Revenue (¥)', fontsize=11)
ax1.set_title('Total Revenue by Region', fontsize=12, fontweight='bold')
ax1.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, p: f'{x/1e6:.1f}M'))
ax1.set_ylim(0, max(vals) * 1.15)
for bar, r in zip(bars, regions):
    ax1.text(bar.get_x() + bar.get_width()/2., bar.get_height() + 200000,
             f'{totals[r]/1e6:.2f}M\n({shares[r]}%)',
             ha='center', va='bottom', fontsize=9, fontweight='bold')
ax1.spines['top'].set_visible(False)
ax1.spines['right'].set_visible(False)
ax1.grid(axis='y', alpha=0.3, linestyle='--')

# Line chart: monthly revenue trend
ax2 = axes[1]
for col, color in zip(['N','S','E','W'], ['#FF9800', '#4CAF50', '#2196F3', '#9C27B0']):
    ax2.plot(monthly.index, monthly[col], marker='o', markersize=3, linewidth=1.5, label=col, color=color)
ax2.set_xlabel('Month', fontsize=11)
ax2.set_ylabel('Monthly Revenue (¥)', fontsize=11)
ax2.set_title('Monthly Revenue Trend by Region', fontsize=12, fontweight='bold')
ax2.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, p: f'{x/1e6:.1f}M'))
ax2.legend(loc='upper left', fontsize=9)
ax2.spines['top'].set_visible(False)
ax2.spines['right'].set_visible(False)
ax2.grid(alpha=0.3, linestyle='--')
# Rotate x labels
ax2.set_xticks(monthly.index[::2])
ax2.set_xticklabels(monthly.index[::2], rotation=45, ha='right', fontsize=8)

plt.tight_layout()
chart_path = f"{out_dir}\\regional_sales_chart.png"
plt.savefig(chart_path, dpi=150, bbox_inches='tight')
plt.close()
print(f"Chart saved: {chart_path}")
print(f"Chart exists: {os.path.exists(chart_path)}, size: {os.path.getsize(chart_path)} bytes")

