    "all_4_regions_present": sorted(df['region'].unique().tolist()) == ['E','N','S','W'],
    "product_lines": sorted(df['product_line'].unique().tolist()),
    "month_range": [df['month'].min(), df['month'].max()],
    "month_count": int(df['month'].nunique()),
    "rows_per_region": {r: int(n) for r, n in df['region'].value_counts().sort_index().items()},
    "duplicates": int(df.duplicated(subset=['month','region','product_line']).sum()),
    "revenue_consistency": "revenue == units * unit_price (max diff < 1e-9)",
