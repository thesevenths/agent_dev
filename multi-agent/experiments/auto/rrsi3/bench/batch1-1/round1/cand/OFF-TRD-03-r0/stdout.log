import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")

# Check month range and completeness
months = sorted(df['month'].unique())
print("Month range:", months[0], "to", months[-1], "| count:", len(months))

# Check region x month completeness
expected = 4 * len(months) * 3  # 4 regions * months * 3 product lines
print("Expected rows (4 regions x", len(months), "months x 3 product lines):", expected)
print("Actual rows:", len(df))

# Check duplicates
dup = df.duplicated(subset=['month','region','product_line']).sum()
print("Duplicate (month, region, product_line) rows:", dup)

# Check revenue consistency: revenue ≈ units * unit_price
df['calc_rev'] = df['units'] * df['unit_price']
df['rev_diff'] = (df['revenue'] - df['calc_rev']).abs()
print("Max |revenue - units*unit_price|:", df['rev_diff'].max())
print("Rows with diff > 0.01:", (df['rev_diff'] > 0.01).sum())

# Product lines
print("\nProduct lines:", sorted(df['product_line'].unique()))

# Revenue stats per region (quick preview)
print("\nRevenue by region (sum):")
print(df.groupby('region')['revenue'].agg(['sum','count','mean']))

