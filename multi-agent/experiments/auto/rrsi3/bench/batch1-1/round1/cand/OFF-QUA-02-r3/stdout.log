import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\cand\OFF-QUA-02-r3\_sandbox"
csv_path = os.path.join(base, "offline_data", "regional_sales.csv")
out_dir = os.path.join(base, "tmp")
os.makedirs(out_dir, exist_ok=True)
out_csv = os.path.join(out_dir, "revenue_check.csv")

df = pd.read_csv(csv_path)
print("COLUMNS:", list(df.columns))
print("DTYPES:\n", df.dtypes)
print("TOTAL ROWS:", len(df))
print("HEAD:\n", df.head(5).to_string())

exp = df["units"] * df["unit_price"]
dev = (df["revenue"] - exp).abs() / exp * 100
res = df.copy()
res["expected_revenue"] = exp
res["deviation_pct"] = dev
res["dev_gt_0.5"] = dev > 0.5
res["returns_gt_units"] = df["returns"] > df["units"]

n_bad = int(res["dev_gt_0.5"].sum())
i_max = res["deviation_pct"].idxmax()
max_dev = float(res.loc[i_max, "deviation_pct"])
n_ret = int(res["returns_gt_units"].sum())
print("ROWS_DEV_GT_0.5:", n_bad)
print("MAX_DEV_PCT:", max_dev, "at index", i_max)
print("RETURNS_GT_UNITS:", n_ret)
print("MAX_DEV_ROW:\n", res.loc[i_max].to_string())
print("RET_BAD_ROWS:\n", res.loc[res["returns_gt_units"]].to_string())
print("TOP10_DEV:\n", res.nlargest(10, "deviation_pct")[["revenue","units","unit_price","expected_revenue","deviation_pct"]].to_string())

res.to_csv(out_csv, index=False)
print("SAVED:", out_csv)

```
