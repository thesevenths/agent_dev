```python
import pandas as pd, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-QUA-02-r5\_sandbox"
csv_path = os.path.join(base, "offline_data", "regional_sales.csv")
out_path = os.path.join(base, "tmp", "revenue_check.csv")

df = pd.read_csv(csv_path)
print("COLUMNS:", list(df.columns))
print("DTYPES:\n", df.dtypes)
print("ROWS:", len(df))
print("SAMPLE:\n", df.head())

units = df["units"].astype(float)
price = df["unit_price"].astype(float)
rev = df["revenue"].astype(float)
expected = units * price
dev_pct = (rev - expected).abs() / expected * 100

n_bad = int((dev_pct > 0.5).sum())
max_dev = float(dev_pct.max())
max_idx = int(dev_pct.idxmax())
max_row = df.loc[max_idx]

# illegal returns > units
ret = df["returns"].astype(float)
n_illegal = int((ret > units).sum())
illegal_idx = df.index[ret > units].tolist()

res = pd.DataFrame({
    "total_rows": [len(df)],
    "rows_dev_gt_0.5pct": [n_bad],
    "max_deviation_pct": [max_dev],
    "max_deviation_row_index": [max_idx],
    "max_deviation_row": [max_row.to_dict()],
    "illegal_returns_gt_units": [n_illegal],
    "illegal_row_indices": [illegal_idx],
})
os.makedirs(os.path.dirname(out_path), exist_ok=True)
res.to_csv(out_path, index=False)
print("SAVED:", out_path)
print("N_BAD(>0.5%):", n_bad)
print("MAX_DEV_PCT:", max_dev, "at index", max_idx)
print("MAX_ROW:", max_row.to_dict())
print("ILLEGAL_RETURNS:", n_illegal, "indices:", illegal_idx)
print("DEV_STATS:\n", dev_pct.describe())
print("SUM_REVENUE:", rev.sum(), "SUM_EXPECTED:", expected.sum())
print("SUM_UNITS:", units.sum(), "SUM_RETURNS:", ret.sum())
print("DEVIATION_ROWS_DETAIL:\n", df.assign(dev_pct=dev_pct).query("dev_pct > 0.5").to_string())

