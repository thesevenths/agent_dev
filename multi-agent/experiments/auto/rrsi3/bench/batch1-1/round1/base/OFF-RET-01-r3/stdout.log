               "std_pop": float(last30.std(ddof=0))},
    "diff_mean_last30_minus_first30": float(last30.mean() - first30.mean()),
    "overall": {"n": 60, "mean": float(overall_mean), "std_sample": float(overall_std),
                "std_pop": float(r.std(ddof=0))},
    "threshold_mean_minus_2std": float(threshold),
    "weeks_below_threshold": {
        "count": int(len(below)),
        "weeks": below["week"].tolist(),
        "values": below["retention_d7"].tolist(),
    },
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-01-r3\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))

