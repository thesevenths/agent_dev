import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-STAT-02-r1\_sandbox"
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))
print(df.head())
print(df.shape)
print(df.dtypes)
print("nulls:", df[["math_score","reading_score"]].isna().sum().to_dict())

cols = ["math_score", "reading_score"]
sub = df[cols].dropna()
n = len(sub)
res = {"n_rows_total": len(df), "n_rows_used": n, "columns": cols}
for c in cols:
    s = sub[c]
    res[c] = {
        "mean": float(s.mean()),
        "std_sample": float(s.std(ddof=1)),
        "std_pop": float(s.std(ddof=0)),
        "median": float(s.median()),
        "min": float(s.min()),
        "max": float(s.max()),
    }
    res[c]["cv_sample"] = res[c]["std_sample"] / res[c]["mean"]
    res[c]["cv_pop"] = res[c]["std_pop"] / res[c]["mean"]
res["pearson_r"] = float(sub["math_score"].corr(sub["reading_score"], method="pearson"))
res["pearson_r_pop"] = float(sub["math_score"].corr(sub["reading_score"], method="pearson"))

out = os.path.join(base, "tmp", "stats_results.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

