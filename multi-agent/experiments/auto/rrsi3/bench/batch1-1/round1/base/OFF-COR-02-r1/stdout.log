path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-COR-02-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

df["group"] = (df["screen_hours_per_day"] > 5).map({True: "high(>5)", False: "low(<=5)"})
g = df.groupby("group").agg(
    n=("student_id", "size"),
    mean_screen=("screen_hours_per_day", "mean"),
    mean_math=("math_score", "mean"),
    mean_reading=("reading_score", "mean"),
)
print(g)

low = g.loc["low(<=5)"]; high = g.loc["high(>5)"]
diff_math = float(high["mean_math"] - low["mean_math"])
diff_reading = float(high["mean_reading"] - low["mean_reading"])

out = {
    "source_file": os.path.abspath(path),
    "split_rule": "screen_hours_per_day > 5 vs <= 5",
    "groups": {
        "low(<=5)": {k: (int(v) if k=="n" else round(float(v),6)) for k,v in low.items()},
        "high(>5)": {k: (int(v) if k=="n" else round(float(v),6)) for k,v in high.items()},
    },
    "mean_diff_high_minus_low": {
        "math_score": round(diff_math, 6),
        "reading_score": round(diff_reading, 6),
    },
}
outp = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-COR-02-r1\_sandbox\tmp\step3_group_stats.json"
with open(outp, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print(json.dumps(out, ensure_ascii=False, indent=2))
print("saved:", outp)

