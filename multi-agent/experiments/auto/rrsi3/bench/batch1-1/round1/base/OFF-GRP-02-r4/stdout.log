import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r4\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

# duplicate check
dup = df['student_id'].duplicated().sum()

# cross-tab counts
ct = df.groupby(['grade','region']).size().unstack(fill_value=0)
ct = ct.reindex(index=['G10','G11','G12'], columns=['A','B','C','D'])

# means
mt = df.groupby(['grade','region'])['reading_score'].mean().unstack().reindex(index=['G10','G11','G12'], columns=['A','B','C','D'])

out = {
    "file": path,
    "rows": int(df.shape[0]),
    "cols": list(df.columns),
    "required_columns_present": all(c in df.columns for c in ['grade','region','reading_score']),
    "missing_values": {c: int(df[c].isna().sum()) for c in df.columns},
    "duplicate_student_ids": int(dup),
    "grade_counts": df['grade'].value_counts().to_dict(),
    "region_counts": df['region'].value_counts().to_dict(),
    "reading_score": {"min": int(df['reading_score'].min()), "max": int(df['reading_score'].max()),
                       "mean": round(float(df['reading_score'].mean()),4), "std": round(float(df['reading_score'].std()),4)},
    "cross_tab_counts": ct.to_dict(),
    "cross_tab_means": {g: {r: round(float(v),4) for r,v in row.items()} for g,row in mt.iterrows()},
}
print(json.dumps(out, ensure_ascii=False, indent=2))

with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r4\_sandbox\tmp\step1_validation.json","w",encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved step1_validation.json")

