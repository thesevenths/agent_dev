import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r1\_sandbox\offline_data\students.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r1\_sandbox\tmp"

df = pd.read_csv(src)
g = df.groupby(['grade', 'region'], observed=True).agg(
    row_count=('reading_score', 'size'),
    mean_reading_score=('reading_score', 'mean'),
).reset_index()
g['mean_reading_score'] = g['mean_reading_score'].round(4)

# order grades/regions nicely
g['grade'] = pd.Categorical(g['grade'], ['G10','G11','G12'], ordered=True)
g['region'] = pd.Categorical(g['region'], ['A','B','C','D'], ordered=True)
g = g.sort_values(['grade','region']).reset_index(drop=True)

print(g.to_string(index=False))
print("\ntotal rows:", g['row_count'].sum())

hi = g.loc[g['mean_reading_score'].idxmax()]
lo = g.loc[g['mean_reading_score'].idxmin()]
print("\nHIGHEST:", hi.to_dict())
print("LOWEST:", lo.to_dict())
print("diff:", round(hi['mean_reading_score'] - lo['mean_reading_score'], 4))
print("ratio:", round(hi['mean_reading_score'] / lo['mean_reading_score'], 4))

out = rf"{out_dir}\step2_crosstab_metrics.csv"
g.to_csv(out, index=False)
print("\nsaved:", out)

```
