import pandas as pd, numpy as np

df = pd.read_csv('E:/agent_dev/multi-agent/experiments/auto/rrsi3/bench/batch1-1/round1/base/OFF-COR-01-r3/_sandbox/offline_data/students.csv')
n = len(df)
cols = ['study_hours_per_week','sleep_hours_per_night','attendance_pct','screen_hours_per_day']

rows = []
for c in cols:
    r = df[c].corr(df['math_score'])  # pearson
    rows.append((c, r, abs(r)))
rows.sort(key=lambda x: -x[2])

for c, r, ar in rows:
    print(c, f"{r:.6f}", f"{ar:.6f}", f"{ar*100:.2f}%")

# descriptive stats
print(df[cols + ['math_score']].describe().T[['mean','std','min','max']])
print("n =", n)

# t-statistic for each r
from scipy import stats
for c, r, ar in rows:
    t = r*np.sqrt(n-2)/np.sqrt(1-r*r)
    p = 2*stats.t.sf(abs(t), n-2)
    print(c, f"t={t:.3f}", f"p={p:.3e}")

```
