```python
import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r0\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)
sub = df[df['week'].isin([f'W{i:02d}' for i in range(30,44)])].copy()
sub = sub.sort_values('week').reset_index(drop=True)

pre  = sub[sub['week'].isin([f'W{i:02d}' for i in range(30,37)])]
post = sub[sub['week'].isin([f'W{i:02d}' for i in range(37,44)])]

cols = ['retention_d7','churn_rate','arpu_usd']
for c in cols:
    a, b = pre[c].mean(), post[c].mean()
    print(f"{c}: pre={a:.6f} post={b:.6f} diff={b-a:+.6f} rel={(b-a)/a*100:+.2f}%")

# W36 -> W37 single-step
w36, w37 = sub[sub['week']=='W36'].iloc[0], sub[sub['week']=='W37'].iloc[0]
for c in cols:
    d = w37[c]-w36[c]
    print(f"W36->W37 {c}: {w36[c]} -> {w37[c]}  delta={d:+.4f}  rel={d/w36[c]*100:+.2f}%")

# largest single-week delta in W37-W43 window
sub2 = sub.copy()
for c in cols:
    sub2[f'{c}_d'] = sub2[c].diff()
print("\nmax |delta| in W37-W43:")
for c in cols:
    w = sub2[(sub2['week']>='W37') & (sub2['week']<='W43')]
    i = w[f'{c}_d'].abs().idxmax()
    print(c, sub2.loc[i,'week'], sub2.loc[i,f'{c}_d'])

# cohort-weighted means for reference
for c in cols:
    wp = (pre[c]*pre['cohort_size']).sum()/pre['cohort_size'].sum()
    wq = (post[c]*post['cohort_size']).sum()/post['cohort_size'].sum()
    print(f"cohort-weighted {c}: pre={wp:.6f} post={wq:.6f} diff={wq-wp:+.6f}")

```
