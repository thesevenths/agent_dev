```python
import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/app_metrics.csv')
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

pre  = df[(df.week >= 'W30') & (df.week <= 'W36')].copy()
post = df[(df.week >= 'W37') & (df.week <= 'W43')].copy()

# Group means
means = pd.DataFrame({
    'group': ['W30-W36', 'W37-W43'],
    'n': [len(pre), len(post)],
    'retention_d7_mean': [pre.retention_d7.mean(), post.retention_d7.mean()],
    'churn_rate_mean': [pre.churn_rate.mean(), post.churn_rate.mean()],
    'arpu_usd_mean': [pre.arpu_usd.mean(), post.arpu_usd.mean()],
})
print(means.to_string(index=False))

# Per-week detail
detail = df[(df.week >= 'W29') & (df.week <= 'W44')][['week'] + metrics].copy()
detail['group'] = np.where(detail.week.isin(pre.week), 'W30-W36', np.where(detail.week.isin(post.week), 'W37-W43', 'outside'))
print("\nPer-week detail:")
print(detail.to_string(index=False))

# Differences
diff = pd.DataFrame({
    'metric': metrics,
    'pre_mean': [pre[m].mean() for m in metrics],
    'post_mean': [post[m].mean() for m in metrics],
    'abs_diff': [post[m].mean() - pre[m].mean() for m in metrics],
    'rel_diff_pct': [(post[m].mean() - pre[m].mean()) / pre[m].mean() * 100 for m in metrics],
})
print("\nDifferences:")
print(diff.to_string(index=False))

# Std for context
print("\nStd pre :", pre[metrics].std().to_dict())
print("Std post:", post[metrics].std().to_dict())

# Save intermediate CSV
out = pd.DataFrame({
    'week': detail.week,
    'group': detail.group,
    'retention_d7': detail.retention_d7,
    'churn_rate': detail.churn_rate,
    'arpu_usd': detail.arpu_usd,
})
out_path = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_perweek_detail.csv'
out.to_csv(out_path, index=False)

summary = pd.DataFrame({
    'group': ['W30-W36', 'W37-W43', 'diff(post-pre)', 'rel_diff_pct'],
    'n': [len(pre), len(post), '', ''],
    'retention_d7': [pre.retention_d7.mean(), post.retention_d7.mean(),
                     post.retention_d7.mean()-pre.retention_d7.mean(),
                     (post.retention_d7.mean()-pre.retention_d7.mean())/pre.retention_d7.mean()*100],
    'churn_rate': [pre.churn_rate.mean(), post.churn_rate.mean(),
                   post.churn_rate.mean()-pre.churn_rate.mean(),
                   (post.churn_rate.mean()-pre.churn_rate.mean())/pre.churn_rate.mean()*100],
    'arpu_usd': [pre.arpu_usd.mean(), post.arpu_usd.mean(),
                 post.arpu_usd.mean()-pre.arpu_usd.mean(),
                 (post.arpu_usd.mean()-pre.arpu_usd.mean())/pre.arpu_usd.mean()*100],
})
summary_path = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r0\_sandbox\tmp\step2_group_means.csv'
summary.to_csv(summary_path, index=False)
print("\nSaved:", out_path)
print("Saved:", summary_path)
print(summary.to_string(index=False))

