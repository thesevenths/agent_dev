import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r5\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r5\_sandbox\tmp"

df = pd.read_csv(path)
sl = df[(df.week >= "W30") & (df.week <= "W43")].copy().reset_index(drop=True)
metrics = ["retention_d7", "churn_rate", "arpu_usd"]

# 1) per-week table with week-over-week deltas
per = sl[["week"] + metrics].copy()
for m in metrics:
    per[f"{m}_wow"] = per[m].diff()
per["group"] = per.week.apply(lambda w: "W30-W36" if w <= "W36" else "W37-W43")

# 2) group means
g = sl.assign(group=sl.week.apply(lambda w: "W30-W36" if w <= "W36" else "W37-W43"))
gm = g.groupby("group")[metrics].agg(["mean", "std", "count"]).T
gm.columns = ["W30-W36_mean", "W30-W36_std", "W30-W36_n", "W37-W43_mean", "W37-W43_std", "W37-W43_n"]
gm = gm.reset_index().rename(columns={"index": "metric"})
gm["abs_diff"] = gm["W37-W43_mean"] - gm["W30-W36_mean"]
gm["rel_diff_pct"] = gm["abs_diff"] / gm["W30-W36_mean"] * 100

# 3) breakpoint detection: largest single-week drop in retention_d7 within W30-W43
drop = per["retention_d7_wow"].idxmin()
bp_row = per.loc[drop]
print("Largest WoW retention drop at:", bp_row["week"], "delta =", round(bp_row["retention_d7_wow"], 4))

# also check churn jump
jump = per["churn_rate_wow"].idxmax()
print("Largest WoW churn jump at:", per.loc[jump, "week"], "delta =", round(per.loc[jump, "churn_rate_wow"], 4))

# 4) t-test (Welch) per metric
from scipy import stats
a = sl[sl.week <= "W36"][metrics].values
b = sl[sl.week > "W36"][metrics].values
tt = {}
for i, m in enumerate(metrics):
    t, p = stats.ttest_ind(a[:, i], b[:, i], equal_var=False)
    tt[m] = (t, p)
    print(m, "t =", round(t, 4), "p =", p)

# save CSVs
per.to_csv(f"{out_dir}\\step2_per_week.csv", index=False, encoding="utf-8-sig")
gm.to_csv(f"{out_dir}\\step2_group_means.csv", index=False, encoding="utf-8-sig")

# t-test summary csv
tt_df = pd.DataFrame([{"metric": m, "t_stat": round(v[0], 4), "p_value": v[1]} for m, v in tt.items()])
tt_df.to_csv(f"{out_dir}\\step2_ttest.csv", index=False, encoding="utf-8-sig")

print("\nPER-WEEK:\n", per.to_string(index=False))
print("\nGROUP MEANS:\n", gm.to_string(index=False))
print("\nT-TEST:\n", tt_df.to_string(index=False))

