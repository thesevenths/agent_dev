import pandas as pd
import numpy as np

path = r"offline_data/app_metrics.csv"
df = pd.read_csv(path)

r = df["retention_d7"]
first30 = r.iloc[:30]
last30 = r.iloc[30:]

# Use sample std (ddof=1) as the standard convention
stats = {
    "first30_mean": first30.mean(),
    "first30_std": first30.std(ddof=1),
    "last30_mean": last30.mean(),
    "last30_std": last30.std(ddof=1),
    "mean_diff": last30.mean() - first30.mean(),
    "std_diff": last30.std(ddof=1) - first30.std(ddof=1),
    "overall_mean": r.mean(),
    "overall_std": r.std(ddof=1),
    "threshold": r.mean() - 2 * r.std(ddof=1),
}
below = df[r < stats["threshold"]]
stats["weeks_below_2sigma"] = len(below)
stats["weeks_below_list"] = list(below["week"])

for k, v in stats.items():
    print(k, "=", v)

# Save intermediate results CSV
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-01-r1\_sandbox\tmp\step2_stats.csv"
pd.DataFrame([
    {"metric": "first30_mean", "value": stats["first30_mean"], "n": 30, "note": "weeks W01-W30, ddof=1"},
