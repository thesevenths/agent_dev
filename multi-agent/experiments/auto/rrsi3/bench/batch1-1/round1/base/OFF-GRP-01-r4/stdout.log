import pandas as pd, json

df = pd.read_csv('offline_data/students.csv')

g = df.groupby('tutoring')['math_score'].agg(n='count', mean='mean', std=lambda s: s.std(ddof=1))
print(g)

n0, n1 = int(g.loc[0,'n']), int(g.loc[1,'n'])
m0, m1 = g.loc[0,'mean'], g.loc[1,'mean']
s0, s1 = g.loc[0,'std'], g.loc[1,'std']

mean_diff = m1 - m0
pooled_std = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
d = mean_diff / pooled_std

# classification
def classify(d):
    a = abs(d)
    if a < 0.2: return "可忽略 (negligible, |d|<0.2)"
    if a < 0.5: return "小 (small, 0.2<=|d|<0.5)"
    if a < 0.8: return "中 (medium, 0.5<=|d|<0.8)"
    return "大 (large, |d|>=0.8)"

result = {
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-25 02:21",
    "group_0": {"tutoring": 0, "n": n0, "mean": m0, "std_ddof1": s0},
    "group_1": {"tutoring": 1, "n": n1, "mean": m1, "std_ddof1": s1},
    "mean_diff_group1_minus_group0": mean_diff,
    "pooled_std": pooled_std,
    "cohens_d": d,
    "effect_size_classification": classify(d),
    "notes": "std uses sample std (ddof=1); pooled_std = sqrt(((n0-1)s0^2+(n1-1)s1^2)/(n0+n1-2)); d = mean_diff/pooled_std; Cohen thresholds: small 0.2, medium 0.5, large 0.8"
}
print(json.dumps(result, indent=2, ensure_ascii=False))

out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-01-r4\_sandbox\tmp\step2_group_stats.json'
with open(out, 'w', encoding='utf-8') as f:
    json.dump(result, f, indent=2, ensure_ascii=False)
print("saved:", out)

