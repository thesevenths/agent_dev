import pandas as pd, numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)

# Correlations (Pearson)
corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])

# Median split
med = df["retention_d7"].median()
hi = df[df["retention_d7"] > med]
lo = df[df["retention_d7"] <= med]

rows = {
    "median_retention_d7": med,
    "corr_retention_arpu": corr_arpu,
    "corr_retention_churn": corr_churn,
    "n_total": n,
    "n_high": len(hi), "n_low": len(lo),
    "high_arpu_mean": hi["arpu_usd"].mean(),
    "low_arpu_mean": lo["arpu_usd"].mean(),
    "high_cohort_sum": int(hi["cohort_size"].sum()),
    "low_cohort_sum": int(lo["cohort_size"].sum()),
    "high_retention_mean": hi["retention_d7"].mean(),
    "low_retention_mean": lo["retention_d7"].mean(),
    "high_churn_mean": hi["churn_rate"].mean(),
    "low_churn_mean": lo["churn_rate"].mean(),
}

out = pd.DataFrame([
    {"metric":"corr_retention_d7_arpu_usd","value":round(corr_arpu,6),"n":n,"note":"Pearson, all 60 rows"},
    {"metric":"corr_retention_d7_churn_rate","value":round(corr_churn,6),"n":n,"note":"Pearson, all 60 rows"},
    {"metric":"median_retention_d7","value":med,"n":n,"note":"median of retention_d7, 60 rows"},
    {"metric":"group_high_arpu_usd_mean","value":round(rows["high_arpu_mean"],6),"n":len(hi),"note":"mean arpu_usd where retention_d7 > median"},
    {"metric":"group_low_arpu_usd_mean","value":round(rows["low_arpu_mean"],6),"n":len(lo),"note":"mean arpu_usd where retention_d7 <= median"},
    {"metric":"group_high_cohort_size_sum","value":rows["high_cohort_sum"],"n":len(hi),"note":"sum cohort_size where retention_d7 > median"},
    {"metric":"group_low_cohort_size_sum","value":rows["low_cohort_sum"],"n":len(lo),"note":"sum cohort_size where retention_d7 <= median"},
    {"metric":"group_high_retention_d7_mean","value":round(rows["high_retention_mean"],6),"n":len(hi),"note":""},
    {"metric":"group_low_retention_d7_mean","value":round(rows["low_retention_mean"],6),"n":len(lo),"note":""},
    {"metric":"group_high_churn_rate_mean","value":round(rows["high_churn_mean"],6),"n":len(hi),"note":""},
    {"metric":"group_low_churn_rate_mean","value":round(rows["low_churn_mean"],6),"n":len(lo),"note":""},
])
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-03-r4\_sandbox\tmp\step2_stats.csv"
out.to_csv(path, index=False)
print(out.to_string(index=False))
print("saved:", path)

