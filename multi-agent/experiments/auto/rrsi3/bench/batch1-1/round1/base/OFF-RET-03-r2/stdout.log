import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-03-r2\_sandbox\offline_data\app_metrics.csv"
df = pd.read_csv(path)

med = df["retention_d7"].median()
print("median:", med)

corr_arpu = df["retention_d7"].corr(df["arpu_usd"])
corr_churn = df["retention_d7"].corr(df["churn_rate"])
print("corr retention_d7 vs arpu_usd:", corr_arpu)
print("corr retention_d7 vs churn_rate:", corr_churn)

df["group"] = df["retention_d7"].apply(lambda x: "above_median" if x > med else "below_median")
g = df.groupby("group").agg(
    n=("week","count"),
    arpu_mean=("arpu_usd","mean"),
    cohort_sum=("cohort_size","sum"),
    retention_mean=("retention_d7","mean"),
    churn_mean=("churn_rate","mean"),
)
print(g)

# save intermediate results
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-03-r2\_sandbox\tmp\step2_results.csv"
rows = [
    {"metric":"median_retention_d7","value":med,"note":"median of retention_d7, n=60"},
    {"metric":"corr_retention_d7_arpu_usd","value":corr_arpu,"note":"Pearson, n=60"},
    {"metric":"corr_retention_d7_churn_rate","value":corr_churn,"note":"Pearson, n=60"},
    {"metric":"group_above_median_n","value":int(g.loc["above_median","n"])},
    {"metric":"group_above_median_arpu_mean","value":g.loc["above_median","arpu_mean"]},
    {"metric":"group_above_median_cohort_sum","value":int(g.loc["above_median","cohort_sum"])},
    {"metric":"group_below_median_n","value":int(g.loc["below_median","n"])},
    {"metric":"group_below_median_arpu_mean","value":g.loc["below_median","arpu_mean"]},
    {"metric":"group_below_median_cohort_sum","value":int(g.loc["below_median","cohort_sum"])},
    {"metric":"group_above_median_retention_mean","value":g.loc["above_median","retention_mean"]},
    {"metric":"group_below_median_retention_mean","value":g.loc["below_median","retention_mean"]},
    {"metric":"group_above_median_churn_mean","value":g.loc["above_median","churn_mean"]},
    {"metric":"group_below_median_churn_mean","value":g.loc["below_median","churn_mean"]},
]
pd.DataFrame(rows).to_csv(out, index=False)
print("saved:", out)
print(pd.read_csv(out).to_string())

