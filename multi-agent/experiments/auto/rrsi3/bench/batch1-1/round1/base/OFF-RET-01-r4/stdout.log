import pandas as pd, json

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first30, last30 = r.iloc[:30], r.iloc[30:]

res = {
    "as_of": "2026-10-25 23:17",
    "source": "offline_data/app_metrics.csv",
    "column": "retention_d7",
    "n_total": int(len(r)),
    "first30": {
        "weeks": [df['week'].iloc[0], df['week'].iloc[29]],
        "n": int(len(first30)),
        "mean": float(first30.mean()),
        "std": float(first30.std(ddof=1)),
        "std_pop": float(first30.std(ddof=0)),
        "min": float(first30.min()), "max": float(first30.max()),
    },
    "last30": {
        "weeks": [df['week'].iloc[30], df['week'].iloc[59]],
        "n": int(len(last30)),
        "mean": float(last30.mean()),
        "std": float(last30.std(ddof=1)),
        "std_pop": float(last30.std(ddof=0)),
        "min": float(last30.min()), "max": float(last30.max()),
    },
    "overall": {
        "n": int(len(r)),
        "mean": float(r.mean()),
        "std": float(r.std(ddof=1)),
        "std_pop": float(r.std(ddof=0)),
        "min": float(r.min()), "max": float(r.max()),
    },
}
res["diff_mean"] = res["first30"]["mean"] - res["last30"]["mean"]
res["diff_std"] = res["first30"]["std"] - res["last30"]["std"]
thr = res["overall"]["mean"] - 2*res["overall"]["std"]
res["threshold_mean_minus_2std"] = float(thr)
low = df[r < thr]
res["n_below_mean_minus_2std"] = int(len(low))
res["weeks_below"] = low["week"].tolist()
res["values_below"] = low["retention_d7"].tolist()

out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-01-r4\_sandbox\tmp\step2_stats.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

