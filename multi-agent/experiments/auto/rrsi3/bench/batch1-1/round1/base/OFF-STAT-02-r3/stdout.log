n = len(df)

def stats(s):
    mean = float(s.mean()); std = float(s.std(ddof=1)); med = float(s.median())
    return dict(mean=mean, std=std, median=med, cv=float(std/mean),
                min=float(s.min()), max=float(s.max()))

res = {
  "source_file": "offline_data/students.csv",
  "n_rows": int(n),
  "n_math": int(m.notna().sum()),
  "n_reading": int(r.notna().sum()),
  "math_score": stats(m),
  "reading_score": stats(r),
  "pearson_r": float(m.corr(r)),
  "std_note": "std uses sample standard deviation (ddof=1)",
  "cv_note": "CV = std / mean",
}
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-STAT-02-r3\_sandbox\tmp\stats_results.json"
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, indent=2))
print("saved:", out)

