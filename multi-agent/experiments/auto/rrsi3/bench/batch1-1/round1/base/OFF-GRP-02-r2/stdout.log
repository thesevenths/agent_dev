import pandas as pd, os

df = pd.read_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r2\_sandbox\offline_data\students.csv')

g = (
    df.groupby(['grade','region'], observed=True)
    .agg(n=('student_id','count'),
         mean_reading_score=('reading_score','mean'))
    .reset_index()
    .sort_values(['grade','region'])
    .reset_index(drop=True)
)
g['mean_reading_score'] = g['mean_reading_score'].round(4)

imax = g['mean_reading_score'].idxmax()
imin = g['mean_reading_score'].idxmin()
mx = g.loc[imax]; mn = g.loc[imin]
print(g.to_string(index=False))
print('MAX:', mx['grade'], mx['region'], mx['mean_reading_score'], 'n=', mx['n'])
print('MIN:', mn['grade'], mn['region'], mn['mean_reading_score'], 'n=', mn['n'])
print('diff:', round(mx['mean_reading_score']-mn['mean_reading_score'],4))
print('ratio:', round(mx['mean_reading_score']/mn['mean_reading_score'],4))

out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r2\_sandbox\tmp\step2_crosstab.csv'
g.to_csv(out, index=False)
print('saved', out)

