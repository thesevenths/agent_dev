import pandas as pd, json, os

df = pd.read_csv('offline_data/students.csv')
g = df.groupby(['grade','region'], observed=True).agg(
    n=('student_id','count'),
    mean_reading=('reading_score','mean'),
    min_reading=('reading_score','min'),
    max_reading=('reading_score','max'),
    mean_math=('math_score','mean'),
).reset_index()
g = g.sort_values(['grade','region'])
print(g.to_string(index=False))

# duplicates check
print('dup student_id:', df['student_id'].duplicated().sum())
print('reading_score range:', df['reading_score'].min(), df['reading_score'].max())
print('overall mean:', df['reading_score'].mean())

out_dir = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r2\_sandbox\tmp'
os.makedirs(out_dir, exist_ok=True)
summary = {
    'shape': list(df.shape),
    'columns': list(df.columns),
    'missing': {k:int(v) for k,v in df.isna().sum().items()},
    'grade_values': sorted(df['grade'].unique().tolist()),
    'region_values': sorted(df['region'].unique().tolist()),
    'dup_student_id': int(df['student_id'].duplicated().sum()),
    'reading_score_min': int(df['reading_score'].min()),
    'reading_score_max': int(df['reading_score'].max()),
    'reading_score_overall_mean': float(df['reading_score'].mean()),
    'crosstab': g.to_dict('records'),
}
with open(os.path.join(out_dir,'step1_inspection.json'),'w',encoding='utf-8') as f:
    json.dump(summary,f,ensure_ascii=False,indent=2)
print('saved', os.path.join(out_dir,'step1_inspection.json'))

