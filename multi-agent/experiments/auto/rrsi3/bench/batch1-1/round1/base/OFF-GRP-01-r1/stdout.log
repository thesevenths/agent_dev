import pandas as pd, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-01-r1\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

g = df.groupby('tutoring')['math_score'].agg(['count','mean','std'])
print(g)

n0, n1 = int(g.loc[0,'count']), int(g.loc[1,'count'])
m0, m1 = g.loc[0,'mean'], g.loc[1,'mean']
s0, s1 = g.loc[0,'std'], g.loc[1,'std']
diff = m1 - m0
pooled = ((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)
pooled_std = pooled**0.5
d = diff / pooled_std
print("diff:", diff)
print("pooled var:", pooled, "pooled std:", pooled_std)
print("cohen d:", d)

# also t-test for reference
import scipy.stats as st
t, p = st.ttest_ind(df.loc[df.tutoring==1,'math_score'], df.loc[df.tutoring==0,'math_score'], equal_var=True)
print("t:", t, "p:", p)

out = {
  "group0": {"n": n0, "mean": round(m0,4), "std": round(s0,4)},
  "group1": {"n": n1, "mean": round(m1,4), "std": round(s1,4)},
  "mean_diff_g1_minus_g0": round(diff,4),
  "pooled_std": round(pooled_std,4),
  "cohens_d": round(d,4),
