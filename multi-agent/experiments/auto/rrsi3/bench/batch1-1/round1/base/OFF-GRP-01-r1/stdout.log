import pandas as pd, json, os

base = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-01-r1\_sandbox"
out_dir = os.path.join(base, "tmp")
df = pd.read_csv(os.path.join(base, "offline_data", "students.csv"))

g = df.groupby("tutoring")["math_score"]
n0, n1 = int(g.count()[0]), int(g.count()[1])
m0, m1 = float(g.mean()[0]), float(g.mean()[1])
s0, s1 = float(g.std(ddof=1)[0]), float(g.std(ddof=1)[1])

# pooled std (equal-variance, df = n0+n1-2)
sp = float(((n0-1)*s0**2 + (n1-1)*s1**2) / (n0+n1-2)) ** 0.5
diff = m1 - m0
d = diff / sp

# t-test for reference
import math
se = sp * math.sqrt(1/n0 + 1/n1)
t = diff / se
dfree = n0 + n1 - 2

res = {
    "source_file": "offline_data/students.csv",
    "as_of": "2026-10-25 23:28",
    "total_rows": int(len(df)),
    "nulls": {"tutoring": 0, "math_score": 0},
    "groups": {
        "tutoring_0": {"n": n0, "mean": round(m0,4), "std_sample": round(s0,4)},
        "tutoring_1": {"n": n1, "mean": round(m1,4), "std_sample": round(s1,4)},
    },
    "pooled_std": round(sp,4),
    "mean_diff_t1_minus_t0": round(diff,4),
    "cohens_d_pooled": round(d,4),
    "t_stat": round(t,4),
    "df": dfree,
    "effect_size_label": "small" if abs(d)<0.2 else "medium" if abs(d)<0.8 else "large",
    "note": "std uses sample std (ddof=1); Cohen's d uses pooled std (df=n0+n1-2)",
}
out = os.path.join(out_dir, "group_stats.json")
with open(out, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)
print(json.dumps(res, ensure_ascii=False, indent=2))
print("saved:", out)

```
