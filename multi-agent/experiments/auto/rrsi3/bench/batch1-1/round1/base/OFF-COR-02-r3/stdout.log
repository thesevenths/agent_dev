def stats(g):
    return {
        "n": int(len(g)),
        "mean_math": round(float(g["math_score"].mean()), 4),
        "mean_reading": round(float(g["reading_score"].mean()), 4),
        "mean_screen": round(float(g["screen_hours_per_day"].mean()), 4),
