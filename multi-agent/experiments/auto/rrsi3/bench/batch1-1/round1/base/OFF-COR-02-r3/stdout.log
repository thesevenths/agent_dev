import pandas as pd, json, math

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-COR-02-r3\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
results = []
for x, y in pairs:
    r = df[[x,y]].corr().iloc[0,1]
    n = int(df[[x,y]].dropna().shape[0])
    # t-statistic for significance
    t = r * math.sqrt((n-2)/(1-r**2))
    results.append({"x": x, "y": y, "pearson_r": round(float(r), 6), "n": n, "t_stat": round(float(t),4)})
    print(results[-1])

out = {
    "source_file": path,
    "method": "Pearson correlation (pandas .corr(), method='pearson')",
    "n_total": int(len(df)),
    "correlations": results,
}
out_path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-COR-02-r3\_sandbox\tmp\step2_correlations.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved:", out_path)

