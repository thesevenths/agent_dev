import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
n = len(df)

r_arpu = df["retention_d7"].corr(df["arpu_usd"])
r_churn = df["retention_d7"].corr(df["churn_rate"])
med = df["retention_d7"].median()

high = df[df["retention_d7"] > med]
low = df[df["retention_d7"] <= med]

rows = [
    ("pearson_r_retention_d7_vs_arpu_usd", round(r_arpu, 6), n, "Pearson correlation, all 60 weekly rows"),
    ("pearson_r_retention_d7_vs_churn_rate", round(r_churn, 6), n, "Pearson correlation, all 60 weekly rows"),
    ("median_retention_d7", round(med, 6), n, "median of retention_d7, all 60 rows"),
    ("n_rows_high_group", len(high), len(high), "rows with retention_d7 > median"),
    ("n_rows_low_group", len(low), len(low), "rows with retention_d7 <= median"),
    ("mean_arpu_usd_high_group", round(high["arpu_usd"].mean(), 6), len(high), "mean arpu_usd where retention_d7 > median"),
    ("mean_arpu_usd_low_group", round(low["arpu_usd"].mean(), 6), len(low), "mean arpu_usd where retention_d7 <= median"),
    ("sum_cohort_size_high_group", int(high["cohort_size"].sum()), len(high), "sum cohort_size where retention_d7 > median"),
    ("sum_cohort_size_low_group", int(low["cohort_size"].sum()), len(low), "sum cohort_size where retention_d7 <= median"),
