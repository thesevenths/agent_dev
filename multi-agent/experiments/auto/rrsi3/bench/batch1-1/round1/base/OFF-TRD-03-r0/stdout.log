import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")

# Per-region aggregates
reg = df.groupby("region")["revenue"].agg(total="sum", n_rows="count").reset_index()
grand = reg["total"].sum()
reg["share_pct"] = reg["total"] / grand * 100
reg["monthly_avg"] = reg["total"] / 24  # 24 months
reg = reg.sort_values("total", ascending=False).reset_index(drop=True)
print(reg)
print("grand total:", grand)

# Peak month per region
monthly = df.groupby(["region", "month"])["revenue"].sum().reset_index()
top = reg.iloc[0]["region"]
top_monthly = monthly[monthly.region == top].sort_values("revenue", ascending=False)
