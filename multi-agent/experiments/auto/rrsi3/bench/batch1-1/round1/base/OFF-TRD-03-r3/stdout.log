```python
import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dup month/region/pl rows:", df.duplicated(subset=['month','region','product_line']).sum())

# validation: revenue == units * unit_price?
df['calc'] = (df['units']*df['unit_price']).round(2)
diff = (df['calc'] - df['revenue']).abs()
print("max |units*price - revenue|:", diff.max())

# per region
g = df.groupby('region')['revenue'].agg(['sum','count'])
g['share'] = g['sum']/g['sum'].sum()
g['monthly_avg'] = g['sum']/df['month'].nunique()
print(g)

# per region-month
rm = df.groupby(['region','month'])['revenue'].sum().reset_index()
top = rm.loc[rm.groupby('region')['revenue'].idxmax()]
print(top)
overall = rm.loc[rm['revenue'].idxmax()]
print("overall peak:", overall)
print("grand total:", df['revenue'].sum())

```
