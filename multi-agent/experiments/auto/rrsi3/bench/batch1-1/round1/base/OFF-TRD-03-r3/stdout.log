```python
import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
grand = df['revenue'].sum()
n_months = df['month'].nunique()

rm = df.groupby(['region','month'])['revenue'].sum().reset_index()
peak = rm.loc[rm.groupby('region')['revenue'].idxmax()][['region','month','revenue']]

rows = []
for r in ['N','S','E','W']:
    tot = df.loc[df.region==r,'revenue'].sum()
    pm = peak[peak.region==r].iloc[0]
    rows.append({
        "region": r,
        "total_revenue": round(tot,2),
        "share_pct": round(tot/grand*100,2),
        "monthly_avg": round(tot/n_months,2),
        "peak_month": pm['month'],
        "peak_month_revenue": round(pm['revenue'],2),
    })

out = {
    "source_file": "offline_data/regional_sales.csv",
    "as_of": "2026-10-26 00:06",
    "rows_total": int(len(df)),
    "months": [df['month'].min(), df['month'].max()],
    "n_months": int(n_months),
    "grand_total_revenue": round(grand,2),
    "regions": rows,
    "top_region": max(rows, key=lambda x: x['total_revenue'])['region'],
}
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r3\_sandbox\tmp\regional_aggregates.json"
with open(path,'w',encoding='utf-8') as f:
    json.dump(out,f,ensure_ascii=False,indent=2)
print(json.dumps(out,ensure_ascii=False,indent=2))
print("saved:", path)

```
