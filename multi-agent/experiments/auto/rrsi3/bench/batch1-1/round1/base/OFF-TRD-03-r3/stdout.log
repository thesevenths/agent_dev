import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
rm = df.groupby(['region','month'])['revenue'].sum().reset_index()
# E monthly series
e = rm[rm['region']=='E'].sort_values('month')
print(e.to_string(index=False))
print("E peak:", e.loc[e['revenue'].idxmax()].to_dict())
# S peak check
s = rm[rm['region']=='S'].sort_values('month')
print("S peak:", s.loc[s['revenue'].idxmax()].to_dict())
# top region by total
g = df.groupby('region')['revenue'].sum().sort_values(ascending=False)
print(g)
# E 2025-12 components
print(df[(df.region=='E')&(df.month=='2025-12')][['product_line','revenue']].to_string(index=False))

