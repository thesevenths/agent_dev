```python
import pandas as pd
df = pd.read_csv("offline_data/app_metrics.csv")
s = df["retention_d7"]
first30, last30 = s.iloc[:30], s.iloc[30:]
stats = {
    "first30_mean": first30.mean(), "first30_std": first30.std(ddof=1),
    "last30_mean": last30.mean(), "last30_std": last30.std(ddof=1),
    "overall_mean": s.mean(), "overall_std": s.std(ddof=1),
}
stats["diff_mean"] = stats["last30_mean"] - stats["first30_mean"]
stats["diff_std"] = stats["last30_std"] - stats["first30_std"]
thr = stats["overall_mean"] - 2*stats["overall_std"]
stats["threshold"] = thr
stats["weeks_below"] = int((s < thr).sum())
below_weeks = df.loc[s < thr, "week"].tolist()
stats["below_weeks_list"] = below_weeks
for k,v in stats.items():
    print(k, "=", v)

```
