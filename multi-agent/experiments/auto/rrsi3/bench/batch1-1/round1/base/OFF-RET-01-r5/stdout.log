import pandas as pd, numpy as np

df = pd.read_csv("offline_data/app_metrics.csv")
r = df["retention_d7"]
first = r.iloc[:30]
last = r.iloc[30:]

overall_mean = r.mean()
overall_std = r.std(ddof=1)
threshold = overall_mean - 2*overall_std
below = r[r < threshold]

res = pd.DataFrame({
    "metric": ["first30_mean","first30_std","last30_mean","last30_std",
               "mean_diff_last_minus_first","std_diff_last_minus_first",
               "overall_mean","overall_std","threshold_mean_minus_2std",
               "weeks_below_threshold","below_weeks_list"],
    "value": [first.mean(), first.std(ddof=1), last.mean(), last.std(ddof=1),
              last.mean()-first.mean(), last.std(ddof=1)-first.std(ddof=1),
              overall_mean, overall_std, threshold, len(below),
              ",".join(below.index)]
})
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-01-r5\_sandbox\tmp\step2_stats.csv"
res.to_csv(out, index=False)
print(res.to_string(index=False))
print("saved:", out)

