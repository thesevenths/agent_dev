import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
n_months = df['month'].nunique()  # 24

# per-region aggregates
reg = df.groupby('region')['revenue'].agg(['sum','count']).reset_index()
reg['share'] = reg['sum'] / reg['sum'].sum()
reg['monthly_avg'] = reg['sum'] / n_months
reg = reg.rename(columns={'sum':'total_revenue','count':'n_rows'})
reg = reg.sort_values('total_revenue', ascending=False).reset_index(drop=True)
print(reg.to_string(index=False))

# per-region monthly totals
rm = df.groupby(['region','month'])['revenue'].sum().reset_index()
top_region = reg.iloc[0]['region']
peak = rm[rm['region']==top_region].sort_values('revenue', ascending=False).head(3)
print("\nTop region:", top_region)
print(peak.to_string(index=False))

# overall peak month (all regions) for context
print("\nGrand total:", reg['total_revenue'].sum())
print("Monthly grand totals top3:\n", rm.groupby('month')['revenue'].sum().sort_values(ascending=False).head(3))

# save artifacts
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r2\_sandbox\tmp"
reg.to_csv(f"{out_dir}\\step2_region_aggregates.csv", index=False)
rm.to_csv(f"{out_dir}\\step2_region_month_revenue.csv", index=False)

summary = {
  "as_of": "2026-10-25 02:49",
  "source": "offline_data/regional_sales.csv",
  "n_rows": int(len(df)),
  "n_months": int(n_months),
  "grand_total_revenue": float(reg['total_revenue'].sum()),
  "regions": reg.to_dict('records'),
  "top_region": top_region,
  "top_region_peak_month": peak.iloc[0]['month'],
  "top_region_peak_revenue": float(peak.iloc[0]['revenue']),
  "top_region_peak_month_runners_up": peak.iloc[1:].to_dict('records'),
}
with open(f"{out_dir}\\step2_summary.json","w",encoding="utf-8") as f:
    json.dump(summary, f, ensure_ascii=False, indent=2)
print("\nsaved.")

