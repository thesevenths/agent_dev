```python
import pandas as pd, json, os
from scipy import stats

path = "offline_data/students.csv"
df = pd.read_csv(path)
hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

def grp(g):
    return {
        "n": int(len(g)),
        "mean_screen": float(g["screen_hours_per_day"].mean()),
        "mean_math": float(g["math_score"].mean()),
        "mean_reading": float(g["reading_score"].mean()),
        "std_math": float(g["math_score"].std(ddof=1)),
        "std_reading": float(g["reading_score"].std(ddof=1)),
    }

g_hi, g_lo = grp(hi), grp(lo)

# t-tests (Welch) for mean differences
t_math, p_math = stats.ttest_ind(hi["math_score"], lo["math_score"], equal_var=False)
t_read, p_read = stats.ttest_ind(hi["reading_score"], lo["reading_score"], equal_var=False)

out = {
    "source_file": os.path.abspath(path),
    "split_rule": "screen_hours_per_day > 5 vs <= 5 (exactly 5 assigned to <=5 group)",
    "group_gt5": g_hi,
    "group_le5": g_lo,
    "mean_diff": {
        "math": float(g_hi["mean_math"] - g_lo["mean_math"]),
        "reading": float(g_hi["mean_reading"] - g_lo["mean_reading"]),
    },
    "welch_ttest": {
        "math": {"t": float(t_math), "p": float(p_math)},
        "reading": {"t": float(t_read), "p": float(p_read)},
    },
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-COR-02-r4\_sandbox\tmp"
out_path = os.path.join(out_dir, "step3_group_stats.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved:", out_path)
print(json.dumps(out, ensure_ascii=False, indent=2))

```
