```python
import pandas as pd, json, os
from scipy import stats

path = "offline_data/students.csv"
df = pd.read_csv(path)
n = len(df)

pairs = [("screen_hours_per_day","math_score"), ("screen_hours_per_day","reading_score")]
results = []
for x, y in pairs:
    r, p = stats.pearsonr(df[x], df[y])
    results.append({
        "x": x, "y": y,
        "n": n,
        "pearson_r": float(r),
        "p_value": float(p),
        "r_squared": float(r**2),
        "mean_x": float(df[x].mean()),
        "mean_y": float(df[y].mean()),
        "std_x": float(df[x].std(ddof=1)),
        "std_y": float(df[y].std(ddof=1)),
    })

out = {
    "source_file": os.path.abspath(path),
    "n_rows": n,
    "method": "Pearson correlation (scipy.stats.pearsonr), n=400, no missing values",
    "correlations": results,
}
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-COR-02-r4\_sandbox\tmp"
out_path = os.path.join(out_dir, "step2_correlations.json")
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(out, f, ensure_ascii=False, indent=2)
print("saved:", out_path)
print(json.dumps(out, ensure_ascii=False, indent=2))

```
