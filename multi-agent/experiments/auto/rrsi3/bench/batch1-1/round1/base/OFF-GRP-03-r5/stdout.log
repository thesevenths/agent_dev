```python
import pandas as pd

df = pd.read_csv('offline_data/students.csv')
print(len(df))

def grp(h):
    if h < 2.5: return 'low'
    elif h <= 4.5: return 'mid'
    else: return 'high'

df['group'] = df['study_hours_per_week'].apply(grp)
g = df.groupby('group')['math_score'].agg(['mean','count','std','min','max'])
print(g)
print('overall mean:', df['math_score'].mean(), 'n=', len(df))
print('gain high-low:', g.loc['high','mean'] - g.loc['low','mean'])
print('ratio:', g.loc['high','mean']/g.loc['low','mean'])
print('hours range per group:')
print(df.groupby('group')['study_hours_per_week'].agg(['min','max','mean']))

out = g.reset_index()
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-03-r5\_sandbox\tmp\group_stats.csv', index=False)
print(out)

