```python
import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r3\_sandbox\offline_data\app_metrics.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r3\_sandbox\tmp\step2_group_means_breakpoint.csv"

df = pd.read_csv(src)
weeks = [f"W{i}" for i in range(30, 44)]
sub = df[df['week'].isin(weeks)].copy()
sub['group'] = sub['week'].apply(lambda w: 'A' if int(w[1:]) <= 36 else 'B')
sub = sub.sort_values('week')

cols = ['week', 'group', 'retention_d7', 'churn_rate', 'arpu_usd']
out_df = sub[cols].copy()

# breakpoint: largest single-week drop in retention_d7 / largest jump in churn_rate (W30->W43 sequence)
sub['ret_delta'] = sub['retention_d7'].diff()
sub['churn_delta'] = sub['churn_rate'].diff()
bp_ret = sub.loc[sub['ret_delta'].idxmin(), 'week']
bp_churn = sub.loc[sub['churn_delta'].idxmax(), 'week']
print("breakpoint by retention_d7 drop:", bp_ret, "delta:", sub.loc[sub['ret_delta'].idxmin(), 'ret_delta'])
print("breakpoint by churn_rate jump:", bp_churn, "delta:", sub.loc[sub['churn_delta'].idxmax(), 'churn_delta'])

# group means
means = sub.groupby('group')[['retention_d7', 'churn_rate', 'arpu_usd']].mean()
print("\nGroup means:\n", means)

# summary rows
summary = pd.DataFrame([
    {'week': 'MEAN_A_W30-W36', 'group': 'A',
     'retention_d7': means.loc['A', 'retention_d7'],
     'churn_rate': means.loc['A', 'churn_rate'],
     'arpu_usd': means.loc['A', 'arpu_usd']},
    {'week': 'MEAN_B_W37-W43', 'group': 'B',
     'retention_d7': means.loc['B', 'retention_d7'],
     'churn_rate': means.loc['B', 'churn_rate'],
     'arpu_usd': means.loc['B', 'arpu_usd']},
])
final = pd.concat([out_df, summary], ignore_index=True)
final.to_csv(out, index=False)
print("\nSaved:", out)
print(final.to_string(index=False))

# extra deltas for report
a, b = means.loc['A'], means.loc['B']
print("\nDeltas (B - A):")
print("retention_d7:", b['retention_d7'] - a['retention_d7'], f"({(b['retention_d7']-a['retention_d7'])/a['retention_d7']*100:.2f}%)")
print("churn_rate:", b['churn_rate'] - a['churn_rate'], f"({(b['churn_rate']-a['churn_rate'])/a['churn_rate']*100:.2f}%)")
print("arpu_usd:", b['arpu_usd'] - a['arpu_usd'], f"({(b['arpu_usd']-a['arpu_usd'])/a['arpu_usd']*100:.2f}%)")

