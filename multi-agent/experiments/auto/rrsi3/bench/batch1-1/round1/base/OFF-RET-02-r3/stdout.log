import pandas as pd
import numpy as np

df = pd.read_csv('offline_data/app_metrics.csv')
metrics = ['retention_d7', 'churn_rate', 'arpu_usd']

pre = df[df['week'].isin([f'W{i:02d}' for i in range(30, 37)])].copy()   # W30-W36
post = df[df['week'].isin([f'W{i:02d}' for i in range(37, 44)])].copy()  # W37-W43

print("pre rows:", len(pre), "post rows:", len(post))

means = pd.DataFrame({
    'group': ['W30-W36 (pre)', 'W37-W43 (post)'],
    'n': [len(pre), len(post)],
    'retention_d7_mean': [pre['retention_d7'].mean(), post['retention_d7'].mean()],
    'churn_rate_mean': [pre['churn_rate'].mean(), post['churn_rate'].mean()],
    'arpu_usd_mean': [pre['arpu_usd'].mean(), post['arpu_usd'].mean()],
})
print(means.to_string(index=False))

# absolute & relative diffs
for m in metrics:
    a, b = pre[m].mean(), post[m].mean()
    print(f"{m}: pre={a:.6f} post={b:.6f} abs_diff={b-a:+.6f} rel_diff={(b-a)/a*100:+.4f}%")

# per-week table for W30-W43
win = df[df['week'].isin([f'W{i:02d}' for i in range(30, 44)])].copy()
win['group'] = np.where(win['week'].isin(pre['week']), 'pre', 'post')
print(win[['week','group','retention_d7','churn_rate','arpu_usd']].to_string(index=False))

# save intermediate CSV
out = win[['week','group','retention_d7','churn_rate','arpu_usd']].copy()
out.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r3\_sandbox\tmp\step2_perweek_W30_W43.csv', index=False)
means.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r3\_sandbox\tmp\step2_group_means.csv', index=False)

# diff table
diff = pd.DataFrame({
    'metric': metrics,
    'pre_mean': [pre[m].mean() for m in metrics],
    'post_mean': [post[m].mean() for m in metrics],
    'abs_diff': [post[m].mean()-pre[m].mean() for m in metrics],
    'rel_diff_pct': [(post[m].mean()-pre[m].mean())/pre[m].mean()*100 for m in metrics],
})
print(diff.to_string(index=False))
diff.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r3\_sandbox\tmp\step2_diffs.csv', index=False)

