import pandas as pd
import numpy as np
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

n = len(df)
for col in ['math_score','reading_score']:
    r, p = stats.pearsonr(df['screen_hours_per_day'], df[col])
    print(f"{col}: pearson r = {r:.6f}, p = {p:.6e}, n = {n}")
    # also spearman for reference
    rs, ps = stats.spearmanr(df['screen_hours_per_day'], df[col])
    print(f"  spearman rho = {rs:.6f}, p = {ps:.6e}")

# group split
