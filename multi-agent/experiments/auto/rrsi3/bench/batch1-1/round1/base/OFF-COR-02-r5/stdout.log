import pandas as pd
import numpy as np
from scipy import stats

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-COR-02-r5\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

hi = df[df["screen_hours_per_day"] > 5]
lo = df[df["screen_hours_per_day"] <= 5]

print("n_hi =", len(hi), " n_lo =", len(lo), " total =", len(hi)+len(lo))

for name, g in [("hi(>5)", hi), ("lo(<=5)", lo)]:
    print(name,
          "screen mean=%.4f" % g["screen_hours_per_day"].mean(),
          "math mean=%.4f std=%.4f" % (g["math_score"].mean(), g["math_score"].std()),
          "read mean=%.4f std=%.4f" % (g["reading_score"].mean(), g["reading_score"].std()))

dm = hi["math_score"].mean() - lo["math_score"].mean()
dr = hi["reading_score"].mean() - lo["reading_score"].mean()
print("mean diff math (hi-lo) = %.4f" % dm)
print("mean diff reading (hi-lo) = %.4f" % dr)

# t-tests
t_m, p_m = stats.ttest_ind(hi["math_score"], lo["math_score"])
t_r, p_r = stats.ttest_ind(hi["reading_score"], lo["reading_score"])
print("math t=%.4f p=%.4f" % (t_m, p_m))
print("reading t=%.4f p=%.4f" % (t_r, p_r))

# Welch
t_mw, p_mw = stats.ttest_ind(hi["math_score"], lo["math_score"], equal_var=False)
t_rw, p_rw = stats.ttest_ind(hi["reading_score"], lo["reading_score"], equal_var=False)
print("welch math t=%.4f p=%.4f" % (t_mw, p_mw))
print("welch reading t=%.4f p=%.4f" % (t_rw, p_rw))

# screen means per group
print("hi screen mean=%.4f, lo screen mean=%.4f" % (hi["screen_hours_per_day"].mean(), lo["screen_hours_per_day"].mean()))

