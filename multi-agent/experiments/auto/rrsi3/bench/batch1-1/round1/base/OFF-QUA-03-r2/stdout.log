   - **脚本逻辑**:
     ```python
     import pandas as pd
     import os

     base_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-QUA-03-r2\_sandbox\tmp"
     input_file = os.path.join(base_dir, "offline_data", "regional_sales.csv")
     output_file = os.path.join(base_dir, "offline_data", "top3_anomaly_summary.csv")

     # 1. Read data
     df = pd.read_csv(input_file)

     # 2. Calculate mean units per group (Region + Product_Line)
     # The instruction says "relative to its own 24-month mean".
     # Since the data spans exactly 24 months (2024-01 to 2025-12), the mean is the average of all available months for that group.
     group_means = df.groupby(['region', 'product_line'])['units'].transform('mean')
     df['mean_units'] = group_means
     df['ratio'] = df['units'] / df['mean_units']

     # 3. Find top 3 ratios
     top3 = df.nlargest(3, 'ratio')[['region', 'product_line', 'month', 'units', 'mean_units', 'ratio', 'returns']]

     # 4. Calculate return rate for these rows
     # Return rate = returns / units
     top3['return_rate'] = top3['returns'] / top3['units']

     # 5. Save to CSV
     top3.to_csv(output_file, index=False)
     print(f"Saved to: {output_file}")
     print(top3.to_string())
     ```
