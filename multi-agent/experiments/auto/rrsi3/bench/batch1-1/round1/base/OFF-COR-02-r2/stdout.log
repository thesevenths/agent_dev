import pandas as pd
from scipy import stats
df = pd.read_csv("offline_data/students.csv")
df["grp"] = (df["screen_hours_per_day"] > 5).map({True:"high(>5)", False:"low(<=5)"})
g = df.groupby("grp")[["screen_hours_per_day","math_score","reading_score"]].agg(["count","mean","std"])
print(g)
# mean differences (high - low)
hi = df[df.screen_hours_per_day>5]; lo = df[df.screen_hours_per_day<=5]
for c in ["math_score","reading_score"]:
    d = hi[c].mean()-lo[c].mean()
    t,p = stats.ttest_ind(hi[c], lo[c], equal_var=False)
    print(c, "diff=%.4f"%d, "t=%.4f"%t, "p=%.6f"%p)
print("n high", len(hi), "n low", len(lo))
# screen hours means
print("screen mean hi %.4f lo %.4f"%(hi.screen_hours_per_day.mean(), lo.screen_hours_per_day.mean()))

```
