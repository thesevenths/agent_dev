```python
import pandas as pd
from scipy import stats
df = pd.read_csv("offline_data/students.csv")
n = len(df)
for col in ["math_score","reading_score"]:
    r = df["screen_hours_per_day"].corr(df[col])
    t = r * (n-2)**0.5 / (1-r*r)**0.5
    p = 2*stats.t.sf(abs(t), n-2)
    print(col, "r=%.6f"%r, "t=%.4f"%t, "p=%.6f"%p)

```
