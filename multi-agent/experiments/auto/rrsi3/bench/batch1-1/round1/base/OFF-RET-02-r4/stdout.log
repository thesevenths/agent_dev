import pandas as pd
import numpy as np

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r4\_sandbox\offline_data\app_metrics.csv"
out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r4\_sandbox\tmp"

df = pd.read_csv(path)
w = df[df['week'].between('W30','W43')].copy().reset_index(drop=True)

metrics = ['retention_d7','churn_rate','arpu_usd']

# per-week table with group labels
w['group'] = np.where(w['week'].between('W30','W36'), 'W30-W36', 'W37-W43')

# group means
pre = w[w['group']=='W30-W36']
post = w[w['group']=='W37-W43']
means = pd.DataFrame({
    'metric': metrics,
    'mean_W30_W36': [pre[m].mean() for m in metrics],
    'mean_W37_W43': [post[m].mean() for m in metrics],
})
means['abs_diff'] = means['mean_W37_W43'] - means['mean_W30_W36']
means['rel_diff_pct'] = means['abs_diff'] / means['mean_W30_W36'] * 100
print(means.to_string(index=False))

# breakpoint detection: for each metric, find the week with the largest week-over-week change within W30-W43
w['wow'] = {m: w[m].diff() for m in metrics}
for m in metrics:
    idx = w[m].diff().abs().idxmax()
    print(f"{m}: max |WoW change| at {w.loc[idx,'week']} (delta={w.loc[idx,m]-w.loc[idx-1,m]:+.4f})")

# also check: is W37 the single largest drop for all three?
for m in metrics:
    d = w[m].diff()
    print(m, "WoW deltas W31..W43:", {w.loc[i,'week']: round(d[i],4) for i in range(1,len(w))})

# save intermediate CSVs
perweek = w[['week','group','retention_d7','churn_rate','arpu_usd']].copy()
perweek.to_csv(f"{out_dir}\\step2_perweek_W30_W43.csv", index=False)
means.to_csv(f"{out_dir}\\step2_group_means.csv", index=False)
print("saved")

