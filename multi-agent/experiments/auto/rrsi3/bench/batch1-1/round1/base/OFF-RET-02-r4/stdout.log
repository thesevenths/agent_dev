import pandas as pd

df = pd.read_csv("offline_data/app_metrics.csv")
sl = df[df["week"].between("W30","W43")].copy()
sl["group"] = sl["week"].apply(lambda w: "W30-W36" if int(w[1:])<=36 else "W37-W43")

metrics = ["retention_d7","churn_rate","arpu_usd"]
means = sl.groupby("group")[metrics].mean()
print(means.to_string())

# per-week deltas
sl["ret_d7_delta"] = sl["retention_d7"].diff()
sl["churn_delta"] = sl["churn_rate"].diff()
sl["arpu_delta"] = sl["arpu_usd"].diff()
print(sl[["week","retention_d7","churn_rate","arpu_usd","ret_d7_delta","churn_delta","arpu_delta"]].to_string(index=False))

# group means
g1 = sl[sl.group=="W30-W36"]; g2 = sl[sl.group=="W37-W43"]
for m in metrics:
    m1, m2 = g1[m].mean(), g2[m].mean()
    print(m, m1, m2, m2-m1, (m2-m1)/m1*100)

# save intermediate CSV
out = sl[["week","group","cohort_size","dau","retention_d7","churn_rate","arpu_usd","support_tickets","ret_d7_delta","churn_delta","arpu_delta"]].copy()
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r4\_sandbox\tmp\step2_perweek.csv", index=False)

summary = pd.DataFrame({
    "group": ["W30-W36","W37-W43"],
    "n": [len(g1), len(g2)],
    "retention_d7_mean": [g1.retention_d7.mean(), g2.retention_d7.mean()],
    "churn_rate_mean": [g1.churn_rate.mean(), g2.churn_rate.mean()],
    "arpu_usd_mean": [g1.arpu_usd.mean(), g2.arpu_usd.mean()],
})
summary.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-RET-02-r4\_sandbox\tmp\step2_group_means.csv", index=False)
print(summary.to_string(index=False))

