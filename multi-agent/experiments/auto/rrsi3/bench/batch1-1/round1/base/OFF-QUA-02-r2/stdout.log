print("DTYPES:\n", df.dtypes)
print("ROW_COUNT:", len(df))
print("HEAD:\n", df.head(5).to_string())

# normalize case of column names for robustness
cols = {c.lower(): c for c in df.columns}
rev = df[cols['revenue']]
units = df[cols['units']]
price = df[cols['unit_price']]

expected = units * price
dev = (rev - expected).abs()
