import pandas as pd

src = r'F:\agent\multi-agent\offline_data\regional_sales.csv'
out = r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-QUA-02-r2\_sandbox\tmp\revenue_flags.csv'

df = pd.read_csv(src)
