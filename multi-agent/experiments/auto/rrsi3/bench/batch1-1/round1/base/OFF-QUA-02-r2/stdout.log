flagged['expected_revenue'] = expected[flag]
flagged['abs_deviation'] = dev[flag]
flagged['rel_deviation'] = rel[flag]
flagged.to_csv(out, index=False)
print("SAVED:", out)
print("FLAGGED_HEAD:\n", flagged.head(10).to_string())

