```python
import pandas as pd

df = pd.read_csv('offline_data/regional_sales.csv')

# Per-region aggregates
region_agg = df.groupby('region')['revenue'].agg(['sum', 'count']).reset_index()
grand_total = df['revenue'].sum()
region_agg['share'] = region_agg['sum'] / grand_total
region_agg['monthly_avg'] = region_agg['sum'] / 24  # 24 months per region
region_agg = region_agg.rename(columns={'sum': 'total_revenue', 'count': 'n_rows'})
region_agg = region_agg[['region', 'total_revenue', 'share', 'monthly_avg', 'n_rows']]
print(region_agg.to_string(index=False))
print("\ngrand_total:", grand_total)

# Monthly revenue per region
monthly = df.groupby(['region', 'month'])['revenue'].sum().reset_index()
monthly.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r5\_sandbox\tmp\step2_monthly_revenue.csv', index=False)

# Top region
top_region = region_agg.loc[region_agg['total_revenue'].idxmax(), 'region']
print("\ntop region:", top_region)

# Peak month for top region
top_monthly = monthly[monthly['region'] == top_region].sort_values('revenue', ascending=False)
print(top_monthly.head(5).to_string(index=False))

# Peak month for ALL regions (for context)
peak = monthly.loc[monthly.groupby('region')['revenue'].idxmax()]
print("\npeak month per region:\n", peak.to_string(index=False))

region_agg.to_csv(r'E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r5\_sandbox\tmp\step2_region_agg.csv', index=False)
print("\nsaved step2_region_agg.csv and step2_monthly_revenue.csv")

