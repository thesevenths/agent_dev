```python
import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")

# per-region totals
reg = df.groupby("region")["revenue"].agg(["sum", "count"])
total = df["revenue"].sum()
reg["share"] = reg["sum"] / total
reg["monthly_avg"] = reg["sum"] / 24
print(reg.round(2))

# per-region monthly totals -> peak month
piv = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
top_region = reg["sum"].idxmax()
peak_month = piv[top_region].idxmax()
print("top region:", top_region, "peak month:", peak_month, "peak value:", piv.loc[peak_month, top_region])
print("top region monthly max check:", piv[top_region].max())

# save aggregates for downstream step
out = {
    "total_revenue_all_regions": float(total),
    "regions": {r: {"total": float(reg.loc[r,"sum"]), "share": float(reg.loc[r,"share"]),
                    "monthly_avg": float(reg.loc[r,"monthly_avg"]), "rows": int(reg.loc[r,"count"])}
                for r in reg.index},
    "top_region": top_region,
    "top_region_peak_month": peak_month,
    "top_region_peak_revenue": float(piv.loc[peak_month, top_region]),
    "monthly_by_region": {m: {c: float(v) for c, v in piv.loc[m].items()} for m in piv.index},
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step1_aggregates.json", "w", encoding="utf-8") as f:
    json.dump(out, f, indent=2, ensure_ascii=False)
print("saved aggregates")

