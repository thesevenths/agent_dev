import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
print("shape:", df.shape)
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df.region.unique()))
print("months:", df.month.min(), "->", df.month.max(), "count:", df.month.nunique())
print("product_lines:", sorted(df.product_line.unique()))
print("nulls:\n", df.isna().sum())
print("dupes (month,region,product_line):", df.duplicated(subset=["month","region","product_line"]).sum())
# consistency check revenue vs units*unit_price
df["calc"] = (df.units*df.unit_price).round(2)
print("max |revenue - units*unit_price|:", (df.revenue - df.calc).abs().max())
# rows per region
print(df.groupby("region").size())
# quick aggregates
g = df.groupby("region").revenue.sum()
print(g)
print("share:", (g/g.sum()*100).round(2))
print("monthly avg:", (g/df.month.nunique()).round(2))
top = g.idxmax()
sub = df[df.region==top].groupby("month").revenue.sum()
print("top region:", top, "peak month:", sub.idxmax(), sub.max())
print("grand total:", df.revenue.sum())

