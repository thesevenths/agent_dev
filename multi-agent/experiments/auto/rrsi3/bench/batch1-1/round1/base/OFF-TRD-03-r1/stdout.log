```python
import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
n_months = df.month.nunique()

# Per-region aggregates
g = df.groupby("region").revenue.sum().sort_values(ascending=False)
grand = df.revenue.sum()
rows = []
for r in ["N","S","E","W"]:
    tot = g[r]
    rows.append({
        "region": r,
        "total_revenue": round(tot,2),
        "share_pct": round(tot/grand*100,2),
        "monthly_avg_revenue": round(tot/n_months,2),
        "n_rows": int((df.region==r).sum()),
        "n_months": n_months,
    })
summary = pd.DataFrame(rows)

# Peak month per region
peak = df.groupby(["region","month"]).revenue.sum().reset_index()
peak_top = peak.loc[peak.groupby("region").revenue.idxmax()]

# Top region
top_region = g.idxmax()
top_peak = peak_top[peak_top.region==top_region].iloc[0]

# Monthly totals per region (for chart step)
monthly = df.pivot_table(index="month", columns="region", values="revenue", aggfunc="sum")
monthly.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step2_monthly_revenue.csv")

summary.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step2_region_summary.csv", index=False)

out = {
  "as_of": "2026-10-25 02:47",
  "source": "offline_data/regional_sales.csv",
  "n_months": n_months,
  "grand_total_revenue": round(grand,2),
  "region_summary": rows,
  "peak_month_by_region": peak_top.to_dict("records"),
  "top_region": top_region,
  "top_region_peak_month": top_peak["month"],
  "top_region_peak_revenue": round(float(top_peak["revenue"]),2),
}
with open(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r1\_sandbox\tmp\step2_aggregates.json","w",encoding="utf-8") as f:
    json.dump(out,f,ensure_ascii=False,indent=2)

print(summary.to_string(index=False))
print("\nGrand total:", round(grand,2))
print("\nPeak by region:")
