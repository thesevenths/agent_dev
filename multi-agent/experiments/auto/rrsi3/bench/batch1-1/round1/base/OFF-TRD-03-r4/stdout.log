import pandas as pd, json

df = pd.read_csv("offline_data/regional_sales.csv")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("dtypes:\n", df.dtypes)
print("regions:", sorted(df['region'].unique()))
print("months:", df['month'].min(), "->", df['month'].max(), "count:", df['month'].nunique())
print("product_lines:", sorted(df['product_line'].unique()))
print("nulls:\n", df.isna().sum())
print("dupes (month,region,product_line):", df.duplicated(subset=['month','region','product_line']).sum())

# consistency check: revenue vs units*unit_price
df['calc'] = (df['units']*df['unit_price']).round(2)
bad = (df['calc'] - df['revenue']).abs() > 0.05
print("rows where revenue != units*unit_price (tol 0.05):", bad.sum())

# per region x month revenue
piv = df.groupby(['month','region'])['revenue'].sum().unstack()
print(piv.round(2))
tot = df.groupby('region')['revenue'].sum()
print(tot.round(2))
print("grand total:", df['revenue'].sum().round(2)
