import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import os

OUT = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-TRD-03-r4\_sandbox\tmp"
os.makedirs(OUT, exist_ok=True)

df = pd.read_csv("offline_data/regional_sales.csv")

# per-region totals
tot = df.groupby('region')['revenue'].sum().reindex(['N','S','E','W'])
grand = df['revenue'].sum()
share = tot / grand * 100
avg = tot / 24

# monthly trend for E
e_month = df[df['region']=='E'].groupby('month')['revenue'].sum()

fig, axes = plt.subplots(1, 2, figsize=(13, 5))

# bar chart: per-region total revenue
colors = {'N':'#4C72B0','S':'#DD8452','E':'#55A868','W':'#C44E52'}
bars = axes[0].bar(tot.index, tot.values/1e6, color=[colors[i] for i in tot.index])
axes[0].set_title("Total Revenue by Region (2024-01 to 2025-12)")
axes[0].set_ylabel("Revenue (M)")
for b, v in zip(bars, tot.values):
    axes[0].text(b.get_x()+b.get_width()/2, v/1e6+0.3, f"{v/1e6:.2f}M\n({share[b.get_x()]:.2f}%)",
                 ha='center', fontsize=9)
axes[0].set_ylim(0, tot.max()/1e6*1.18)

# line chart: E monthly trend
axes[1].plot(e_month.index, e_month.values/1e6, marker='o', color='#55A868', linewidth=2)
peak_m = e_month.idxmax()
axes[1].axvline(peak_m, color='red', linestyle='--', alpha=0.6)
axes[1].annotate(f"Peak: {peak_m}\n{e_month.max()/1e6:.2f}M", xy=(peak_m, e_month.max()/1e6),
                 xytext=(peak_m, e_month.max()/1e6*1.08), ha='center', fontsize=9, color='red')
axes[1].set_title("Monthly Revenue Trend — Region E")
axes[1].set_ylabel("Revenue (M)")
plt.xticks(rotation=60, fontsize=8)
plt.tight_layout()
png = os.path.join(OUT, "regional_sales_chart.png")
plt.savefig(png, dpi=130)
print("saved", png)
print(tot.round(2)); print(share.round(2)); print(avg.round(2))
print("grand:", round(grand,2))
print("E peak:", peak_m, round(e_month.max(),2))
print("E monthly:\n", e_month.round(2).to_string())

