import pandas as pd

src = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r0\_sandbox\offline_data\students.csv"
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\base\OFF-GRP-02-r0\_sandbox\tmp\step2_crosstab_metrics.csv"

df = pd.read_csv(src)
g = df.groupby(['grade','region'], observed=True)['reading_score'].agg(['count','mean']).reset_index()
g.columns = ['grade','region','row_count','mean_reading_score']
g['mean_reading_score'] = g['mean_reading_score'].round(4)
# order rows G10..G12, A..D
g['grade'] = pd.Categorical(g['grade'], ['G10','G11','G12'], ordered=True)
g['region'] = pd.Categorical(g['region'], ['A','B','C','D'], ordered=True)
g = g.sort_values(['grade','region']).reset_index(drop=True)
print(g.to_string(index=False))
