print("overall mean:", df["math_score"].mean())
print("gain high-low:", g.loc["high","mean"]-g.loc["low","mean"])
print("ratio:", g.loc["high","mean"]/g.loc["low","mean"])
print("gain per hour (high-low)/(mean hours diff):")
print(df.groupby("group", observed=True)["study_hours_per_week"].mean())

