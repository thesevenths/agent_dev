import pandas as pd

df = pd.read_csv("offline_data/students.csv")
print(len(df))
df["group"] = pd.cut(df["study_hours_per_week"], bins=[-0.01, 2.5, 4.5, 100], labels=["low","mid","high"])
g = df.groupby("group", observed=True)["math_score"].agg(["mean","count","std","min","max"])
