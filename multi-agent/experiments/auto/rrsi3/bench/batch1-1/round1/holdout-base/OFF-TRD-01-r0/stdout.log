import pandas as pd

# Re-verify all numbers directly from source CSV (single source of truth)
df = pd.read_csv("offline_data/regional_sales.csv")
df['year'] = df['month'].str[:4]
df['mon'] = df['month'].str[5:7].astype(int)

annual = df.groupby('year').agg(revenue=('revenue','sum'), units=('units','sum'), n=('revenue','size'))
print(annual)

r24, r25 = annual.loc['2024','revenue'], annual.loc['2025','revenue']
print(f"YoY: {(r25-r24)/r24*100:.4f}%")

for y in ['2024','2025']:
    sub = df[df.year==y]
    q4 = sub[sub.mon.isin([11,12])]; rest = sub[~sub.mon.isin([11,12])]
    q4_avg = q4['units'].sum()/2; rest_avg = rest['units'].sum()/10
    print(y, "q4_total:", q4['units'].sum(), "q4_avg:", q4_avg, "rest_total:", rest['units'].sum(), "rest_avg:", rest_avg, "mult:", q4_avg/rest_avg)

# monthly table for report
monthly = df.groupby('month').agg(revenue=('revenue','sum'), units=('units','sum')).reset_index()
print(monthly.to_string(index=False))

