    'amplification_multiplier': round(nd_avg / ot_avg, 6),
    'novdec_row_count': len(nd),
    'other_row_count': len(ot),
})

out_df = pd.DataFrame(rows)
out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step3_novdec_multiplier.csv"
out_df.to_csv(out, index=False)
print(out_df.to_string(index=False))
print("\nsaved:", out)

