import pandas as pd

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-TRD-01-r0\_sandbox\offline_data\regional_sales.csv"
df = pd.read_csv(path)

print("MONTHS:", sorted(df['month'].unique()))
print("rows per month:", df.groupby('month').size().to_dict())

# consistency check: revenue vs units*unit_price
df['calc'] = (df['units']*df['unit_price']).round(2)
diff = (df['calc'] - df['revenue']).abs()
print("max |units*unit_price - revenue|:", diff.max())

# quick sanity aggregates
df['year'] = df['month'].str[:4]
print("\nAnnual revenue:\n", df.groupby('year')['revenue'].sum())
print("\nAnnual units:\n", df.groupby('year')['units'].sum())
df['mon'] = df['month'].str[5:6].astype(int)
df['is_novdec'] = df['mon'].isin([11,12])
for y in ['2024','2025']:
    sub = df[df.year==y]
    nd = sub[sub.is_novdec]['units'].sum()
    ot = sub[~sub.is_novdec]['units'].sum()
    print(y, "NovDec units:", nd, "other units:", ot, "avg-per-month ratio:", (nd/2)/(ot/10))

