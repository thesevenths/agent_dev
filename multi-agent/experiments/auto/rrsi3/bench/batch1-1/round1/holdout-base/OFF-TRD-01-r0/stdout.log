import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
df['year'] = df['month'].str[:4]
df['mon'] = df['month'].str[5:7].astype(int)

# Monthly revenue
monthly = df.groupby('month').agg(revenue=('revenue','sum'), units=('units','sum'), n=('revenue','size')).reset_index()
print(monthly.to_string(index=False))

# Annual totals
annual = df.groupby('year').agg(revenue=('revenue','sum'), units=('units','sum'), n=('revenue','size')).reset_index()
print("\nAnnual:\n", annual.to_string(index=False))

r24, r25 = annual.loc[annual.year=='2024','revenue'].iloc[0], annual.loc[annual.year=='2025','revenue'].iloc[0]
yoy = (r25 - r24) / r24
print(f"\n2024 revenue: {r24:.2f}")
print(f"2025 revenue: {r25:.2f}")
print(f"YoY growth: {yoy*100:.4f}%")

# Save intermediate CSV
out = pd.DataFrame({
    'year': ['2024','2025'],
    'revenue_total': [r24, r25],
    'units_total': [annual.loc[annual.year=='2024','units'].iloc[0], annual.loc[annual.year=='2025','units'].iloc[0]],
    'n_rows': [144, 144],
})
out['yoy_growth_pct'] = [None, round(yoy*100, 4)]
out.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step2_annual_revenue.csv", index=False)
print("\nsaved step2_annual_revenue.csv")

