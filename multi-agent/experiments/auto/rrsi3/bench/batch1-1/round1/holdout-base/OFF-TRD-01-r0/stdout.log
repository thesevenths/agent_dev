```python
import pandas as pd

df = pd.read_csv("offline_data/regional_sales.csv")
df['year'] = df['month'].str[:4]
df['mon'] = df['month'].str[5:7].astype(int)
df['is_q4'] = df['mon'].isin([11,12])

rows = []
for y in ['2024','2025']:
    sub = df[df.year==y]
    q4 = sub[sub.is_q4]; rest = sub[~sub.is_q4]
    q4_units_avg = q4['units'].sum()/2      # avg per month, 2 months
    rest_units_avg = rest['units'].sum()/10 # avg per month, 10 months
    mult = q4_units_avg / rest_units_avg
    rows.append({
        'year': y,
        'nov_dec_units_total': int(q4['units'].sum()),
        'nov_dec_units_avg_per_month': round(q4_units_avg,2),
        'other_months_units_total': int(rest['units'].sum()),
        'other_months_units_avg_per_month': round(rest_units_avg,2),
        'amplification_multiplier': round(mult,4),
        'n_rows_q4': len(q4), 'n_rows_rest': len(rest),
    })
res = pd.DataFrame(rows)
print(res.to_string(index=False))
res.to_csv(r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-TRD-01-r0\_sandbox\tmp\step3_novdec_multiplier.csv", index=False)
print("saved step3_novdec_multiplier.csv")

