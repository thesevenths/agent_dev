df['mon'] = df['month'].str[5:7].astype(int)
df['is_novdec'] = df['mon'].isin([11, 12])

rows = []
for y in ['2024', '2025']:
    sub = df[df.year == y]
    nd = sub[sub.is_novdec]
    ot = sub[~sub.is_novdec]
    nd_sum, ot_sum = nd['units'].sum(), ot['units'].sum()
    nd_avg, ot_avg = nd_sum / 2, ot_sum / 10
    rows.append({
        'year': y,
        'novdec_units_total': nd_sum,
        'novdec_months': 2,
        'novdec_units_avg_per_month': round(nd_avg, 2),
        'other_units_total': ot_sum,
        'other_months': 10,
        'other_units_avg_per_month': round(ot_avg, 2),
        'amplification_multiplier': round(nd_avg / ot_avg, 6),
        'novdec_row_count': len(nd),
        'other_row_count': len(ot),
    })

# pooled (2024+2025 combined)
nd = df[df.is_novdec]; ot = df[~df.is_novdec]
nd_sum, ot_sum = nd['units'].sum(), ot['units'].sum()
