df['mon'] = df['month'].str[5:7].astype(int)
df['is_novdec'] = df['mon'].isin([11,12])

for y in ['2024','2025']:
    sub = df[df.year==y]
    nd = sub[sub.is_novdec]['units'].sum()
    ot = sub[~sub.is_novdec]['units'].sum()
    print(y, "NovDec units:", nd, "other units:", ot, "per-month ratio:", (nd/2)/(ot/10))

# also revenue-based
for y in ['2024','2025']:
    sub = df[df.year==y]
    nd = sub[sub.is_novdec]['revenue'].sum()
    ot = sub[~sub.is_novdec]['revenue'].sum()
    print(y, "NovDec rev:", round(nd,2), "other rev:", round(ot,2), "per-month ratio:", (nd/2)/(ot/10))

# monthly units for context
print("\nMonthly units:\n", df.groupby('month')['units'].sum().to_string())

