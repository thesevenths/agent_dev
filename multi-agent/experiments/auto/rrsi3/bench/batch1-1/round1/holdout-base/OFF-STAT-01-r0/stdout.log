```python
import pandas as pd, json, os

out_dir = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-STAT-01-r0\_sandbox\tmp"
df = pd.read_csv("offline_data/students.csv")
s = df["math_score"].dropna()
n = len(s)
q1, q3 = s.quantile(0.25), s.quantile(0.75)
iqr = q3 - q1
lo, hi = q1 - 1.5*iqr, q3 + 1.5*iqr
out_mask = (s < lo) | (s > hi)
out_n = int(out_mask.sum())

res = {
    "source_file": "offline_data/students.csv",
    "column": "math_score",
    "n_rows": n,
    "n_valid": int(s.count()),
    "n_missing": int(df["math_score"].isna().sum()),
    "mean": float(s.mean()),
    "std_sample": float(s.std(ddof=1)),
    "std_pop": float(s.std(ddof=0)),
    "median": float(s.median()),
    "q1": float(q1),
    "q3": float(q3),
    "iqr": float(iqr),
    "min": float(s.min()),
    "max": float(s.max()),
    "iqr_lower_fence": float(lo),
    "iqr_upper_fence": float(hi),
    "outlier_count": out_n,
    "outlier_ratio": float(out_n / n),
    "outlier_rows": df.loc[out_mask.index, ["student_id","grade","region","math_score"]].to_dict("records"),
}
path = os.path.join(out_dir, "math_score_stats.json")
with open(path, "w", encoding="utf-8") as f:
    json.dump(res, f, ensure_ascii=False, indent=2)

# verify
with open(path, encoding="utf-8") as f:
    check = json.load(f)
print("file size:", os.path.getsize(path))
print({k: check[k] for k in check if k != "outlier_rows"})
print("outlier_rows count:", len(check["outlier_rows"]))

