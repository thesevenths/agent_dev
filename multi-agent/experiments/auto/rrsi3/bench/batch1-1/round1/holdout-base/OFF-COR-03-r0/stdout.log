import pandas as pd, numpy as np, json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-COR-03-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)
cols = ["math_score","study_hours_per_week","attendance_pct","tutoring","screen_hours_per_day"]
sub = df[cols]
corr = sub.corr()
y = sub["math_score"].astype(float)

rows = []
for xcol in cols[1:]:
    x = sub[xcol].astype(float)
    slope = np.cov(x,y,ddof=1)[0,1]/x.var(ddof=1)
    r = corr.loc["math_score", xcol]
    rows.append(dict(col=xcol, mean=x.mean(), r=r, r2=r**2, slope=slope))

# extra derived numbers
mean_study = sub["study_hours_per_week"].mean()
mean_screen = sub["screen_hours_per_day"].mean()
mean_att = sub["attendance_pct"].mean()
tut_rate = sub["tutoring"].mean()
# max pairwise predictor correlation
preds = cols[1:]
pm = corr.loc[preds, preds]
np.fill_diagonal(pm.values, 0)
maxpair = pm.abs().stack().idxmax()
maxpair_val = pm.abs().stack().max()
# tutoring group means
g = sub.groupby("tutoring")["math_score"].mean()

print(json.dumps(rows, indent=1))
print("mean_study", mean_study, "mean_screen", mean_screen, "mean_att", mean_att, "tut_rate", tut_rate)
print("maxpair", maxpair, maxpair_val)
print(g)
print("math mean", sub["math_score"].mean(), "std", sub["math_score"].std(ddof=1))
print("study range", sub["study_hours_per_week"].min(), sub["study_hours_per_week"].max())
print("screen range", sub["screen_hours_per_day"].min(), sub["screen_hours_per_day"].max())
print("att range", sub["attendance_pct"].min(), sub["attendance_pct"].max())

