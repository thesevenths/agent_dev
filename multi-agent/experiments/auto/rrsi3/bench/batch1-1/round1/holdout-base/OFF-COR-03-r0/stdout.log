import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv("offline_data/students.csv")
cols = ["math_score","study_hours_per_week","attendance_pct","tutoring","screen_hours_per_day"]
n = len(df)

# Correlation matrix
corr = df[cols].corr()
print(corr.round(4).to_string())

# Simple OLS regressions
rows = []
for x in cols[1:]:
    r = stats.pearsonr(df[x], df["math_score"])
    res = stats.linregress(df[x], df["math_score"])
    rows.append({
        "metric": "regression",
        "predictor": x,
        "slope": res.slope,
        "intercept": res.intercept,
        "r_squared": res.rvalue**2,
        "p_value": res.pvalue,
        "n": n,
    })

reg = pd.DataFrame(rows)
print(reg.to_string())

# Save results: one row per metric
out_rows = []
# correlation rows
for x in cols[1:]:
    out_rows.append({"metric":"correlation","variable":x,"value":corr.loc["math_score",x],
                     "n":n,"note":"Pearson corr with math_score"})
# predictor-predictor correlations (for matrix highlights)
for a in cols[1:]:
    for b in cols[1:]:
        if a < b:
            out_rows.append({"metric":"correlation","variable":f"{a} vs {b}","value":corr.loc[a,b],
                             "n":n,"note":"Pearson corr between predictors"})
# regression rows
for r in rows:
    out_rows.append({"metric":"regression","variable":r["predictor"],
                     "slope":r["slope"],"intercept":r["intercept"],
                     "r_squared":r["r_squared"],"p_value":r["p_value"],"n":n,
                     "note":"OLS math_score ~ predictor"})

out = pd.DataFrame(out_rows)
path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp\students_analysis_results.csv"
out.to_csv(path, index=False)
print("SAVED:", path)
print(out.to_string())

