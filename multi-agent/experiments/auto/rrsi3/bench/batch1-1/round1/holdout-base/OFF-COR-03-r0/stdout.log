```python
import pandas as pd
import numpy as np
import json

path = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-COR-03-r0\_sandbox\offline_data\students.csv"
df = pd.read_csv(path)

cols = ["math_score", "study_hours_per_week", "attendance_pct", "tutoring", "screen_hours_per_day"]
sub = df[cols]

# (a) Pearson correlation matrix
corr = sub.corr(method="pearson")

# (b) Simple OLS slope for each predictor vs math_score
# slope = cov(x,y)/var(x)
y = sub["math_score"].astype(float)
slopes = {}
for xcol in cols[1:]:
    x = sub[xcol].astype(float)
    slope = np.cov(x, y, ddof=1)[0,1] / x.var(ddof=1)
    intercept = y.mean() - slope * x.mean()
    # r^2 from correlation
    r = corr.loc["math_score", xcol]
    slopes[xcol] = {"slope_per_unit": slope, "intercept": intercept, "r": r, "r2": r**2}

# Save correlation matrix to CSV
corr_out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp\correlation_matrix.csv"
corr.round(6).to_csv(corr_out, encoding="utf-8-sig")

# Save slopes to JSON
slopes_out = r"E:\agent_dev\multi-agent\experiments\auto\rrsi3\bench\batch1-1\round1\holdout-base\OFF-COR-03-r0\_sandbox\tmp\regression_slopes.json"
with open(slopes_out, "w", encoding="utf-8") as f:
    json.dump({"n": len(df), "target": "math_score", "slopes": slopes}, f, indent=2, ensure_ascii=False)

print("Correlation matrix:")
print(corr.round(4).to_string())
print()
print("Slopes:")
for k, v in slopes.items():
    print(f"  {k}: slope={v['slope_per_unit']:.4f}, intercept={v['intercept']:.4f}, r={v['r']:.4f}, r2={v['r2']:.4f}")
print()
print("Saved:", corr_out)
print("Saved:", slopes_out)

